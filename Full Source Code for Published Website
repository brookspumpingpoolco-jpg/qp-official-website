      messageDiv.style.display = 'none';
    }
  }
}

// Close modal when clicking outside
const contactModal = document.getElementById('contactModal');
if (contactModal) {
  contactModal.addEventListener('click', function(e) {
    if (e.target === this) {
      closeContactModal();
    }
  });
}

// Handle form submission
const contactForm = document.getElementById('contactForm');
if (contactForm) {
  contactForm.addEventListener('submit', async function(e) {
    e.preventDefault();
    
    const submitBtn = document.getElementById('contactSubmitBtn');
    const messageDiv = document.getElementById('contactFormMessage');
    
    // Disable submit button
    if (submitBtn) {
      submitBtn.disabled = true;
      submitBtn.textContent = 'Sending...';
    }
    
    // Get form data
    const formData = {
      name: document.getElementById('contactName').value,
      email: document.getElementById('contactEmail').value,
      phone: document.getElementById('contactPhone').value,
      service: document.getElementById('contactService').value,
      message: document.getElementById('contactMessage').value,
      images: []
    };
    
    // Convert image files to base64 if any
    const imageFiles = document.getElementById('contactImages').files;
    if (imageFiles.length > 0) {
      const imagePromises = [];
      for (let i = 0; i < imageFiles.length; i++) {
        const file = imageFiles[i];
        if (file.type.startsWith('image/')) {
          const promise = new Promise((resolve) => {
            const reader = new FileReader();
            reader.onload = function(e) {
              // Get base64 string (remove data:image/...;base64, prefix)
              const base64String = e.target.result.split(',')[1];
              resolve({
                filename: file.name,
                data: base64String,
                contentType: file.type
              });
            };
            reader.readAsDataURL(file);
          });
          imagePromises.push(promise);
        }
      }
      
      // Wait for all images to be converted
      formData.images = await Promise.all(imagePromises);
    }
    
    try {
      // Check if webapp URL is configured
      if (!GOOGLE_SCRIPT_URL || GOOGLE_SCRIPT_URL === 'YOUR_WEB_APP_URL_HERE') {
        throw new Error('Web app URL not configured. Please update GOOGLE_SCRIPT_URL in the script.');
      }
      
      console.log('Submitting form data:', formData);
      console.log('Sending to:', GOOGLE_SCRIPT_URL);
      
      // Send form data to Google Apps Script webapp
      // Use no-cors mode for Google Apps Script compatibility
      // Note: With no-cors, we can't read the response, but the request will go through
      await fetch(GOOGLE_SCRIPT_URL, {
        method: 'POST',
        mode: 'no-cors', // Required for Google Apps Script - allows request but hides response
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify(formData)
      });
      
      console.log('Form submitted successfully');
      
      // Show success message
      if (messageDiv) {
        messageDiv.className = 'contact-form-message success';
        messageDiv.textContent = '✓ Thank you! Your message has been sent. We\'ll get back to you soon!';
        messageDiv.style.display = 'block';
      }
      
      // Reset form
      if (contactForm) {
        contactForm.reset();
        // Clear image previews
        const filePreview = document.getElementById('contactFilePreview');
        const fileLabel = document.getElementById('contactFileLabel');
        if (filePreview) {
          filePreview.innerHTML = '';
          filePreview.classList.remove('show');
        }
        if (fileLabel) {
          fileLabel.innerHTML = '<span>📷</span><span>Click to upload images or drag and drop</span>';
        }
      }
      
      // Close modal after 2 seconds
      setTimeout(() => {
        closeContactModal();
      }, 2000);
      
    } catch (error) {
      // Show error message
      console.error('Form submission error:', error);
      console.error('Error details:', {
        message: error.message,
        stack: error.stack,
        name: error.name
      });
      
      if (messageDiv) {
        messageDiv.className = 'contact-form-message error';
        messageDiv.textContent = '✗ Oops! Something went wrong. Please try again or call us directly. Error: ' + (error.message || 'Unknown error');
        messageDiv.style.display = 'block';
      }
    } finally {
      // Re-enable submit button
      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.textContent = 'Send Message';
      }
    }
  });
}

// Image Upload Handling
let uploadedImages = [];

function handleImageUpload(event) {
  const files = event.target.files;
  const preview = document.getElementById('contactFilePreview');
  const label = document.getElementById('contactFileLabel');
  
  if (!preview || !label) return;
  
  // Clear previous previews
  preview.innerHTML = '';
  uploadedImages = [];
  
  if (files.length > 0) {
    preview.classList.add('show');
    label.innerHTML = `<span>📷</span><span>${files.length} image(s) selected</span>`;
    label.classList.add('has-file');
    
    Array.from(files).forEach((file, index) => {
      if (file.type.startsWith('image/')) {
        const reader = new FileReader();
        reader.onload = function(e) {
          uploadedImages.push({
            file: file,
            preview: e.target.result
          });
          
          const previewItem = document.createElement('div');
          previewItem.className = 'contact-file-preview-item';
          previewItem.innerHTML = `
            <img src="${e.target.result}" alt="Preview ${index + 1}">
            <button type="button" class="remove-image" onclick="removeImage(${index})" title="Remove image">×</button>
          `;
          preview.appendChild(previewItem);
        };
        reader.readAsDataURL(file);
      }
    });
  } else {
    preview.classList.remove('show');
    label.innerHTML = '<span>📷</span><span>Click to upload images or drag and drop</span>';
    label.classList.remove('has-file');
  }
}

function removeImage(index) {
  uploadedImages.splice(index, 1);
  const fileInput = document.getElementById('contactImages');
  const dt = new DataTransfer();
  
  // Rebuild file list without removed image
  Array.from(fileInput.files).forEach((file, i) => {
    if (i !== index) {
      dt.items.add(file);
    }
  });
  
  fileInput.files = dt.files;
  handleImageUpload({ target: fileInput });
}

// Drag and drop for images
const fileLabel = document.getElementById('contactFileLabel');
if (fileLabel) {
  fileLabel.addEventListener('dragover', (e) => {
    e.preventDefault();
    fileLabel.style.borderColor = '#0284c7';
    fileLabel.style.background = '#eff6ff';
  });
  
  fileLabel.addEventListener('dragleave', () => {
    fileLabel.style.borderColor = '#cbd5e1';
    fileLabel.style.background = '#f8fafc';
  });
  
  fileLabel.addEventListener('drop', (e) => {
    e.preventDefault();
    fileLabel.style.borderColor = '#cbd5e1';
    fileLabel.style.background = '#f8fafc';
    
    const fileInput = document.getElementById('contactImages');
    if (fileInput && e.dataTransfer.files.length > 0) {
      fileInput.files = e.dataTransfer.files;
      handleImageUpload({ target: fileInput });
    }
  });
}
