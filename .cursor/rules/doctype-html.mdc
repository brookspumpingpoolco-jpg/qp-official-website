            <div id="termsDisplayBlock_${project.projectId}">
              ${projectData.terms 
                ? `<div style="background: #f8fafc; border-radius: 8px; padding: 16px; font-size: 14px; color: #374151; white-space: pre-wrap; line-height: 1.7; border: 1px solid #e2e8f0;">${escapeHtml(projectData.terms)}</div>`
                : `<div style="text-align: center; padding: 24px; color: #94a3b8; background: #f8fafc; border-radius: 8px; border: 1px dashed #cbd5e1;"><i class="fas fa-file-alt" style="font-size: 28px; margin-bottom: 8px;"></i><p style="margin: 0; font-size: 14px;">No terms &amp; conditions set for this project.</p><p style="margin: 6px 0 0 0; font-size: 12px;">Click Edit to add terms that will appear on all invoices for this project.</p></div>`
              }
            </div>
            <div id="termsEditBlock_${project.projectId}" style="display: none;">
              <textarea id="termsTextarea_${project.projectId}" style="width: 100%; min-height: 180px; padding: 12px; border: 2px solid #0284c7; border-radius: 8px; font-size: 14px; font-family: inherit; line-height: 1.6; resize: vertical; box-sizing: border-box;">${escapeHtml(projectData.terms || '')}</textarea>
              <div style="display: flex; gap: 10px; margin-top: 10px;">
                <button type="button" onclick="saveProjectTerms('${project.projectId}')" style="padding: 8px 20px; background: #0369a1; color: white; border: none; border-radius: 6px; font-weight: 600; font-size: 14px; cursor: pointer;">
