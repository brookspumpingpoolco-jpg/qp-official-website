    /**
     * Render profit overview: total project cost, total expense, profit/loss, margin.
     * Shows a clear run-down and colors loss in red, profit in green.
     */
    function renderProfitOverview(profit) {
      const block = document.getElementById('profitOverview');
      if (!block) return;
      block.style.display = 'block';
      const revenue = parseFloat(profit.totalRevenue || 0);
      const expenses = parseFloat(profit.totalExpenses || 0);
      const profitVal = parseFloat(profit.profit || 0);
      const margin = parseFloat(profit.profitMargin || 0);
      const isLoss = profitVal < 0;
      // Project label from dropdown
      const sel = document.getElementById('expenseProjectFilter');
      const projectLabel = (sel && sel.options[sel.selectedIndex]) ? sel.options[sel.selectedIndex].textContent : 'Project';
      const nameEl = document.getElementById('profitOverviewProjectName');
      if (nameEl) nameEl.textContent = projectLabel;
      // Run-down line
      const runDownEl = document.getElementById('profitRunDownText');
      if (runDownEl) {
        runDownEl.textContent = '$' + revenue.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' project value − $' + expenses.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' spent = ' + (isLoss ? '−$' : '$') + Math.abs(profitVal).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + (isLoss ? ' loss' : ' profit') + ' (' + margin.toFixed(1) + '% margin).';
      }
      const runDownBox = document.getElementById('profitRunDown');
      if (runDownBox) runDownBox.style.borderLeftColor = isLoss ? '#dc2626' : '#059669';
      document.getElementById('profitTotalRevenue').textContent = '$' + revenue.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      document.getElementById('profitTotalExpenses').textContent = '$' + expenses.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      const amountEl = document.getElementById('profitAmount');
      const lossLabelEl = document.getElementById('profitLossLabel');
      const cardEl = document.getElementById('profitLossCard');
      if (amountEl) {
        amountEl.textContent = (isLoss ? '−$' : '$') + Math.abs(profitVal).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        amountEl.style.color = isLoss ? '#b91c1c' : '#059669';
      }
      if (lossLabelEl) lossLabelEl.textContent = isLoss ? 'Loss (expenses exceed value)' : 'Value minus expenses';
      if (cardEl) {
        cardEl.style.background = isLoss ? '#fef2f2' : '#ecfdf5';
        cardEl.style.borderColor = isLoss ? '#dc2626' : '#10b981';
      }
      document.getElementById('profitMargin').textContent = margin.toFixed(1) + '%';
    }

    /**
     * Export expenses for the selected project to CSV (uses current filters).
     */
    async function exportExpenses() {
      const projectId = document.getElementById('expenseProjectFilter') && document.getElementById('expenseProjectFilter').value;
      if (!projectId) {
        showError('Select a project to export expenses.');
        return;
      }
      const startDate = document.getElementById('expenseStartDate') && document.getElementById('expenseStartDate').value;
      const endDate = document.getElementById('expenseEndDate') && document.getElementById('expenseEndDate').value;
      const category = document.getElementById('expenseCategoryFilter') && document.getElementById('expenseCategoryFilter').value;
      try {
        showLoading(true);
        const response = await fetch(SCRIPT_URL, {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: new URLSearchParams({
            action: 'exportProjectExpenses',
            projectId: projectId,
            startDate: startDate || '',
            endDate: endDate || '',
            category: category || ''
          })
        });
        const result = await response.json();
        if (result && result.success && result.csv) {
          const blob = new Blob([result.csv], { type: 'text/csv;charset=utf-8;' });
          const a = document.createElement('a');
          a.href = URL.createObjectURL(blob);
          a.download = result.filename || 'Expenses_' + projectId + '.csv';
          a.click();
          URL.revokeObjectURL(a.href);
          showSuccess('Exported ' + (result.count || 0) + ' expenses.');
        } else {
          showError(result && result.error ? result.error : 'Export failed.');
        }
      } catch (err) {
        console.error('Export expenses error:', err);
        showError('Export failed: ' + (err.message || err));
      } finally {
        showLoading(false);
      }
    }

