    async function loadTemplateById(id) {
      try {
        const response = await fetch(API_URL, {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: new URLSearchParams({ action: 'loadTemplate', id: id })
        });
        const result = await response.json();
        
        if (result.success && result.template) {
          const template = result.template;
          lineItems = JSON.parse(template.items || '[]');
          document.getElementById('notes').value = template.notes || '';
          document.getElementById('terms').value = template.terms || '';
          document.getElementById('taxRate').value = template.taxRate || 0;
          setType(template.type);
          renderItems();
          calculateTotals();
          closeTemplatesModal();
          showSuccess('Template loaded successfully');
        } else {
          showError('Failed to load template');
        }
      } catch (error) {
        showError('Error loading template: ' + error.message);
      }
    }

