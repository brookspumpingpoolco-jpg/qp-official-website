    function selectCustomer() {
      const select = document.getElementById('customerSelect');
      const selectedOption = select.options[select.selectedIndex];
      
      if (selectedOption.value && selectedOption.dataset.customer) {
        try {
          const customer = JSON.parse(selectedOption.dataset.customer);
          
          // Debug: Log the customer object to see what fields we have
          console.log('Customer object:', customer);
          
          // Validate and extract customer data (handle different field name variations)
          const customerName = customer.name || customer.Name || customer.customerName || '';
          const customerEmail = customer.email || customer.Email || customer.customerEmail || '';
          const customerPhone = customer.phone || customer.Phone || customer.customerPhone || '';
          const customerAddress = customer.address || customer.Address || customer.customerAddress || '';
          
          console.log('Extracted fields:', {
            name: customerName,
            email: customerEmail,
            phone: customerPhone,
            address: customerAddress
          });
          
          // Fix mixed up fields: If phone contains name-like text, try to extract phone from address
          let actualPhone = customerPhone;
          let actualAddress = customerAddress;
          
          if (customerAddress && customerAddress.match(/^\d{6,}/)) {
            // Address starts with a phone number (e.g., "502731-9217, 111 VESCIO...")
            const parts = customerAddress.split(',');
            actualPhone = parts[0].trim(); // First part is the phone
            actualAddress = parts.slice(1).join(',').trim(); // Rest is the address
            console.log('Fixed phone from address:', actualPhone);
            console.log('Fixed address:', actualAddress);
          } else if (customerPhone && !customerPhone.match(/\d{3,}/)) {
            // Phone field doesn't look like a phone number (has no 3+ consecutive digits)
            actualPhone = ''; // Clear it
          }
          
          // Validate email format before setting
          const emailField = document.getElementById('customerEmail');
          const phoneField = document.getElementById('customerPhone');
          const nameField = document.getElementById('customerName');
          
          // Set name field - use the text from the dropdown option (which shows the actual name), not the ID
          const displayName = selectedOption.text || '';
          
          if (displayName && !displayName.includes('@') && displayName !== 'Select or enter manually') {
            // Use the display name from the dropdown (e.g., "CUST-2026-0001 (Joell Matteson)")
            // Extract just the name part if it contains the customer ID
            if (displayName.includes('(') && displayName.includes(')')) {
              const nameMatch = displayName.match(/\(([^)]+)\)/);
              nameField.value = nameMatch ? nameMatch[1] : displayName;
            } else {
              nameField.value = displayName;
            }
          } else if (customerName && !customerName.includes('@') && !customerName.match(/^CUST-/)) {
            // Fallback to customerName from data if it's not an ID
            nameField.value = customerName;
          } else {
            nameField.value = '';
          }
          
          // Set email field - validate it's actually an email
          if (customerEmail && customerEmail.includes('@')) {
            emailField.value = customerEmail;
          } else {
            // If email field doesn't contain @, it might be in the wrong field
            // Check if phone field has an email
            if (customerPhone && customerPhone.includes('@')) {
              emailField.value = customerPhone;
              phoneField.value = customerPhone.includes('@') ? '' : customerPhone;
            } else {
              emailField.value = customerEmail || '';
            }
          }
          
          // Set phone field - use the corrected phone value
          phoneField.value = actualPhone || '';
          
          // Set address - use the corrected address value
          document.getElementById('customerAddress').value = actualAddress || '';
          document.getElementById('customerDetails').style.display = 'block';
          
          // Show saved quotes button if customer email exists
          const finalEmail = emailField.value;
          if (finalEmail && finalEmail.includes('@')) {
            document.getElementById('savedQuotesGroup').style.display = 'block';
          } else {
            document.getElementById('savedQuotesGroup').style.display = 'none';
          }
          
          console.log('Customer selected:', {
            name: nameField.value,
            email: emailField.value,
            phone: phoneField.value,
            originalCustomer: customer
          });
        } catch (e) {
          console.error('Error parsing customer data:', e);
          showError('Error loading customer data');
        }
      } else {
        document.getElementById('customerDetails').style.display = 'block';
        // Check if email is manually entered
        const email = document.getElementById('customerEmail').value;
        if (email && email.includes('@')) {
          document.getElementById('savedQuotesGroup').style.display = 'block';
        } else {
          document.getElementById('savedQuotesGroup').style.display = 'none';
        }
      }
      updateData();
    }
    
    // Also check when email is manually entered
    document.addEventListener('DOMContentLoaded', function() {
      const emailInput = document.getElementById('customerEmail');
      if (emailInput) {
        emailInput.addEventListener('blur', function() {
          if (this.value) {
            document.getElementById('savedQuotesGroup').style.display = 'block';
          } else {
            document.getElementById('savedQuotesGroup').style.display = 'none';
          }
        });
      }
      
      // Event delegation for saved quotes modal
      document.body.addEventListener('click', function(e) {
        const target = e.target.closest('[data-action]');
        if (!target) return;
        
        const action = target.getAttribute('data-action');
        if (action && action.startsWith('loadSavedQuote-')) {
          e.preventDefault();
          e.stopPropagation();
          const quoteId = action.replace('loadSavedQuote-', '');
          loadSavedQuote(quoteId);
        } else if (action && action.startsWith('deleteSavedQuote-')) {
          e.preventDefault();
          e.stopPropagation();
          const quoteId = action.replace('deleteSavedQuote-', '');
          deleteSavedQuote(quoteId);
        }
      });
    });

