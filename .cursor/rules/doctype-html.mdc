    function searchQuotes() {
      const query = document.getElementById('quoteSearch').value.toLowerCase();
      const filtered = savedQuotes.filter(quote =>
        (quote.quoteNumber && quote.quoteNumber.toLowerCase().includes(query)) ||
        (quote.customerName && quote.customerName.toLowerCase().includes(query)) ||
        (quote.date && quote.date.toLowerCase().includes(query))
      );
      renderSavedQuotesList(filtered);
    }
    
    function renderSavedQuotesList(quotesToShow = null) {
      const container = document.getElementById('savedQuotesList');
      const quotes = quotesToShow !== null ? quotesToShow : savedQuotes;
      
      if (quotes.length === 0) {
        container.innerHTML = '<div style="padding: 40px; text-align: center; color: #9ca3af;">No saved quotes found for this customer.</div>';
        return;
      }
      
      console.log('Rendering', quotes.length, 'quotes');
      container.innerHTML = quotes.map(function(quote) {
        console.log('Quote:', quote.id, 'Items:', quote.items ? (typeof quote.items === 'string' ? quote.items.length + ' chars' : quote.items.length + ' items') : 'none', 'Total:', quote.total);
        
        // Parse items safely
        var items = [];
        var itemCount = 0;
        try {
          if (quote.items) {
            if (typeof quote.items === 'string') {
              items = JSON.parse(quote.items);
            } else if (Array.isArray(quote.items)) {
              items = quote.items;
            }
          }
          itemCount = items.length;
        } catch (e) {
          console.error('Error parsing items for quote:', quote.id, e);
          itemCount = 0;
        }
        
        // Get total - ensure it's a number
        var total = 0;
        try {
          total = parseFloat(quote.total || quote.subtotal || 0) || 0;
        } catch (e) {
          console.error('Error parsing total for quote:', quote.id, e);
          total = 0;
        }
        
        // Format date - ensure it's actually a date, not Customer ID
        var date = 'N/A';
        if (quote.date) {
          // Check if it's a valid date format (yyyy-MM-dd) and not a Customer ID
          if (typeof quote.date === 'string') {
            if (/^\d{4}-\d{2}-\d{2}$/.test(quote.date) && !quote.date.includes('CUST-')) {
              // Format date nicely
              try {
                var dateObj = new Date(quote.date);
                if (!isNaN(dateObj.getTime())) {
                  date = dateObj.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
                } else {
                  date = quote.date;
                }
              } catch (e) {
                date = quote.date;
              }
            } else if (!quote.date.includes('CUST-')) {
              // Try to parse as date
              try {
                var dateObj2 = new Date(quote.date);
                if (!isNaN(dateObj2.getTime())) {
                  date = dateObj2.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
                }
              } catch (e) {
                // Not a valid date
              }
            }
          } else if (quote.date instanceof Date) {
            date = quote.date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
          }
        }
        
        // Fallback to savedDate if date is still N/A
        if (date === 'N/A' && quote.savedDate) {
          try {
            var dateObj3 = new Date(quote.savedDate);
            if (!isNaN(dateObj3.getTime())) {
              date = dateObj3.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
            }
          } catch (e) {
            // Ignore
          }
        }
        
        var status = quote.status || 'Draft';
        var statusClass = status === 'Released' ? 'status-complete' : (status === 'Draft' ? 'status-planning' : 'status-ordering');
        
        var quoteCard = '<div class="item-card" style="cursor: default;">';
        quoteCard += '<div style="flex: 1;">';
        quoteCard += '<div style="font-weight: 600; margin-bottom: 4px; color: #111827;">';
        quoteCard += escapeHtml(quote.quoteNumber || quote.invoiceNumber || quote.id || 'Quote');
        quoteCard += '</div>';
        quoteCard += '<div style="font-size: 13px; color: #6b7280; margin-bottom: 8px;">';
        quoteCard += 'Date: ' + escapeHtml(date) + ' | Items: ' + itemCount + ' | Total: $' + total.toFixed(2);
        quoteCard += '</div>';
        quoteCard += '<div style="font-size: 11px; color: #9ca3af; margin-bottom: 8px; font-family: monospace;">';
        quoteCard += 'ID: ' + escapeHtml(quote.id);
        quoteCard += '</div>';
        quoteCard += '<div style="display: inline-block; padding: 4px 8px; background: #f3f4f6; border-radius: 4px; font-size: 12px; font-weight: 600; color: #374151;">';
        quoteCard += escapeHtml(status);
        quoteCard += '</div>';
        quoteCard += '</div>';
        quoteCard += '<div style="display: flex; flex-direction: column; gap: 8px; margin-left: 12px;">';
        quoteCard += '<button class="btn btn-primary" data-action="loadSavedQuote-' + escapeHtml(quote.id) + '">';
        quoteCard += '<i class="fas fa-arrow-right"></i> Resume';
        quoteCard += '</button>';
        
        // Show contract button if approved and has contract PDF
        if (quote.approvalStatus === 'Approved' && quote.contractPdfUrl) {
          quoteCard += '<a href="' + escapeHtml(quote.contractPdfUrl) + '" target="_blank" class="btn btn-success" style="padding: 8px 16px; text-decoration: none; text-align: center;" title="View signed contract PDF">';
          quoteCard += '<i class="fas fa-file-contract"></i> View Contract';
          quoteCard += '</a>';
        } else if (quote.approvalStatus === 'Approved') {
          quoteCard += '<button class="btn btn-secondary" style="padding: 8px 16px;" disabled title="Contract PDF being generated">';
          quoteCard += '<i class="fas fa-file-contract"></i> Contract Pending';
          quoteCard += '</button>';
        }
        
        quoteCard += '<button class="btn btn-danger" data-action="deleteSavedQuote-' + escapeHtml(quote.id) + '" style="padding: 8px 16px;" title="Delete this quote">';
        quoteCard += '<i class="fas fa-trash"></i> Delete';
        quoteCard += '</button>';
        quoteCard += '</div>';
        quoteCard += '</div>';
        return quoteCard;
      }).join('');
    }
    
