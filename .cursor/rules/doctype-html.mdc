    async function updateQuoteStatus(quoteId, currentStatus) {
      const statuses = ['Draft', 'Sent', 'Pending', 'Approved', 'Approved & Signed', 'Job Complete'];
      const newStatus = prompt(`Update status for ${quoteId}:\n\nAvailable statuses:\n${statuses.join('\n')}\n\nCurrent: ${currentStatus}\nEnter new status:`, currentStatus);
      
      if (!newStatus || !statuses.includes(newStatus)) {
        return;
      }

      try {
        const result = await apiCall('updateQuoteStatus', {
          id: quoteId,
          status: newStatus
        });

        if (result.success) {
          showSuccess('Status updated successfully!');
          loadDashboard(); // Reload to show changes
        } else {
          showError('Error updating status: ' + result.error);
        }
      } catch (error) {
        showError('Error: ' + error.message);
      }
    }

    async function sendForSignature(quoteId, customerEmail) {
      if (!customerEmail) {
        customerEmail = prompt('Enter customer email address:');
        if (!customerEmail) return;
      }

      if (confirm(`Send signature request to ${customerEmail}?`)) {
        try {
          const result = await apiCall('requestCustomerSignature', {
            quoteId: quoteId,
            customerEmail: customerEmail
          });

          if (result.success) {
            showSuccess('Signature request sent to customer!');
            loadDashboard(); // Refresh to show status change
          } else {
            showError('Error sending signature request: ' + result.error);
          }
        } catch (error) {
          showError('Error sending signature request: ' + error.message);
        }
      }
    }

