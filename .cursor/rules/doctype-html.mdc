     */
    function openSendPaymentLinkModal(invoiceId, customerEmail, customerName, invoiceTotal) {
      currentPaymentLinkInvoiceId = invoiceId;
      currentPaymentLinkInvoiceTotal = parseFloat(invoiceTotal) || 0;
      
      document.getElementById('paymentLinkCustomerName').textContent = customerName || 'N/A';
      document.getElementById('paymentLinkCustomerEmail').textContent = customerEmail || 'N/A';
      document.getElementById('paymentLinkInvoiceTotal').textContent = currentPaymentLinkInvoiceTotal.toFixed(2);
