    function quickSplit(numPayments) {
      const total = getGrandTotal();
      if (total <= 0) {
        showError('Please add items with amounts first');
        return;
      }
      
      paymentScheduleMilestones = [];
      const percentPerPayment = 100 / numPayments;
      const amountPerPayment = total / numPayments;
      
      if (numPayments === 1) {
        // Full payment - single payment for entire amount
        paymentScheduleMilestones = [
          { id: Date.now(), name: 'Full Payment', percent: 100, amount: total, dueTrigger: 'date', dueDate: '', duePhase: '' }
        ];
      } else if (numPayments === 2) {
        paymentScheduleMilestones = [
          { id: Date.now(), name: 'Deposit', percent: percentPerPayment, amount: amountPerPayment, dueTrigger: 'date', dueDate: '', duePhase: '' },
          { id: Date.now() + 1, name: 'Final Payment', percent: percentPerPayment, amount: amountPerPayment, dueTrigger: 'phase', dueDate: '', duePhase: 'Complete' }
        ];
      } else if (numPayments === 4) {
        paymentScheduleMilestones = [
          { id: Date.now(), name: 'Deposit', percent: percentPerPayment, amount: amountPerPayment, dueTrigger: 'date', dueDate: '', duePhase: '' },
          { id: Date.now() + 1, name: 'Milestone 1', percent: percentPerPayment, amount: amountPerPayment, dueTrigger: 'phase', dueDate: '', duePhase: 'Phase 1' },
          { id: Date.now() + 2, name: 'Milestone 2', percent: percentPerPayment, amount: amountPerPayment, dueTrigger: 'phase', dueDate: '', duePhase: 'Phase 2' },
          { id: Date.now() + 3, name: 'Final Payment', percent: percentPerPayment, amount: amountPerPayment, dueTrigger: 'phase', dueDate: '', duePhase: 'Complete' }
        ];
      }
      
      renderPaymentSchedulePreview();
      updatePaymentScheduleTotals();
      
      if (numPayments === 1) {
        showSuccess('Full payment schedule created');
      } else {
        showSuccess(`Payment schedule split into ${numPayments} equal payments`);
      }
    }

    function addPaymentMilestone() {
      addPaymentEntry();
    }

    function removePaymentMilestone(id) {
      paymentScheduleMilestones = paymentScheduleMilestones.filter(m => m.id !== id);
      renderPaymentScheduleBuilder();
      updatePaymentScheduleTotals();
    }

    function updatePaymentMilestone(id, field, value) {
      const milestone = paymentScheduleMilestones.find(m => m.id === id);
      if (!milestone) return;
      
      milestone[field] = value;
      
      // If percent changed, recalculate amount
      if (field === 'percent') {
        const total = getGrandTotal();
        milestone.amount = (total * parseFloat(value)) / 100;
      }
      
      updatePaymentScheduleTotals();
    }

    function updatePaymentScheduleTotals() {
      console.log('🔵 [PAYMENT TOTALS] updatePaymentScheduleTotals() called');
      
      const total = getGrandTotal();
      console.log('🔵 [PAYMENT TOTALS] Grand total:', total);
      
      const totalAmountEl = document.getElementById('totalContractAmount');
      if (totalAmountEl) {
        totalAmountEl.textContent = '$' + total.toFixed(2);
        console.log('✅ [PAYMENT TOTALS] Total contract amount updated');
      }
      
      // Calculate total payments
      const totalPayments = paymentScheduleMilestones.reduce((sum, m) => sum + parseFloat(m.amount || 0), 0);
      console.log('🔵 [PAYMENT TOTALS] Total payments:', totalPayments);
      
      const totalPaymentsEl = document.getElementById('totalPayments');
      if (totalPaymentsEl) {
        totalPaymentsEl.textContent = '$' + totalPayments.toFixed(2);
      }
      
      // Calculate remaining
      const remaining = total - totalPayments;
      console.log('🔵 [PAYMENT TOTALS] Remaining:', remaining);
      
      const remainingEl = document.getElementById('remainingAmount');
      if (remainingEl) {
        remainingEl.textContent = '$' + remaining.toFixed(2);
        remainingEl.style.color = remaining < 0 ? '#ef4444' : '#10b981';
      }
      
      // Recalculate amounts/percentages based on mode
      console.log('🔵 [PAYMENT TOTALS] Mode:', paymentScheduleMode);
      if (paymentScheduleMode === 'percent') {
        console.log('🔵 [PAYMENT TOTALS] Recalculating amounts from percentages');
        paymentScheduleMilestones.forEach(milestone => {
          milestone.amount = (total * parseFloat(milestone.percent || 0)) / 100;
        });
      } else {
        console.log('🔵 [PAYMENT TOTALS] Recalculating percentages from amounts');
        paymentScheduleMilestones.forEach(milestone => {
          milestone.percent = total > 0 ? (parseFloat(milestone.amount || 0) / total) * 100 : 0;
        });
      }
      
      // Update legacy elements if they exist
      const totalPercent = paymentScheduleMilestones.reduce((sum, m) => sum + parseFloat(m.percent || 0), 0);
      console.log('🔵 [PAYMENT TOTALS] Total percent:', totalPercent);
      
      const totalPercentEl = document.getElementById('totalPercentage');
      if (totalPercentEl) totalPercentEl.textContent = totalPercent.toFixed(2) + '%';
      
      const remainingPercentEl = document.getElementById('remainingPercentage');
      if (remainingPercentEl) {
        remainingPercentEl.textContent = (100 - totalPercent).toFixed(2) + '%';
        remainingPercentEl.style.color = (100 - totalPercent) < 0 ? '#ef4444' : '#10b981';
      }
      
      // Validate schedule
      console.log('🔵 [PAYMENT TOTALS] Validating schedule...');
      validatePaymentSchedule();
      console.log('✅ [PAYMENT TOTALS] Update complete');
    }

    function validatePaymentSchedule() {
      const validationDiv = document.getElementById('scheduleValidation');
      if (!validationDiv) return true;
      
      const totalPercent = paymentScheduleMilestones.reduce((sum, m) => sum + parseFloat(m.percent || 0), 0);
      
      let errors = [];
      let warnings = [];
      
      // Use tolerance for floating point precision (allow 0.01% variance)
      if (totalPercent > 100.01) {
        errors.push(`Total percentage cannot exceed 100% (currently ${totalPercent.toFixed(2)}%)`);
      } else if (totalPercent < 99.9) {
        warnings.push(`Total percentage is ${totalPercent.toFixed(2)}%. Remaining: ${(100 - totalPercent).toFixed(2)}%`);
      }
      
      if (paymentScheduleMilestones.some(m => !m.name.trim())) {
        errors.push('All milestones must have a name');
      }
      
      if (errors.length > 0) {
        validationDiv.style.display = 'block';
        validationDiv.style.background = '#fee2e2';
        validationDiv.style.border = '2px solid #ef4444';
        validationDiv.style.color = '#991b1b';
        validationDiv.innerHTML = '<strong><i class="fas fa-exclamation-triangle"></i> Validation Errors:</strong><ul style="margin: 8px 0 0 20px; padding: 0;">' + 
          errors.map(e => '<li>' + escapeHtml(e) + '</li>').join('') + '</ul>';
        return false;
      } else if (warnings.length > 0) {
        validationDiv.style.display = 'block';
        validationDiv.style.background = '#fef3c7';
        validationDiv.style.border = '2px solid #f59e0b';
        validationDiv.style.color = '#78350f';
        validationDiv.innerHTML = '<strong><i class="fas fa-info-circle"></i> Info:</strong><ul style="margin: 8px 0 0 20px; padding: 0;">' + 
          warnings.map(w => '<li>' + escapeHtml(w) + '</li>').join('') + '</ul>';
        return true;
      } else {
        validationDiv.style.display = 'block';
        validationDiv.style.background = '#d1fae5';
        validationDiv.style.border = '2px solid #10b981';
        validationDiv.style.color = '#065f46';
        validationDiv.innerHTML = '<strong><i class="fas fa-check-circle"></i> Payment schedule is valid!</strong>';
        return true;
      }
    }

    // Payment schedule mode: 'percent' or 'dollar'
    let paymentScheduleMode = 'dollar';

    // Pool installation steps
    const POOL_INSTALLATION_STEPS = [
      { id: 'deposit', name: 'Deposit', defaultPercent: 30, description: 'Initial deposit to secure project' },
