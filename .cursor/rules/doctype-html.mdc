    function generateSmartPaymentSchedule(total, items, projectInfo) {
      // Smart payment schedule generator
      const schedule = [];
      let remainingPercent = 100;
      
      // Deposit (always first)
      const depositPercent = 30;
      schedule.push({
        name: 'Deposit',
        percent: depositPercent,
        amount: (total * depositPercent) / 100,
        description: 'Initial deposit to secure project start'
      });
      remainingPercent -= depositPercent;
      
      // Based on project components, add relevant steps
      if (projectInfo.hasWalls) {
        const wallsPercent = 10.78;
        schedule.push({
          name: 'Wall System Installation',
          percent: wallsPercent,
          amount: (total * wallsPercent) / 100,
          description: 'Due upon wall system completion'
        });
        remainingPercent -= wallsPercent;
      }
      
      if (projectInfo.hasPlumbing) {
        const plumbingPercent = 8.26;
        schedule.push({
          name: 'Plumbing & Equipment Pad Install',
          percent: plumbingPercent,
          amount: (total * plumbingPercent) / 100,
          description: 'Due upon plumbing completion'
        });
        remainingPercent -= plumbingPercent;
      }
      
      if (projectInfo.hasConcrete) {
        const concreteMaterialsPercent = 5.39;
        schedule.push({
          name: 'Stamped Concrete MATERIALS (Morning of Pour)',
          percent: concreteMaterialsPercent,
          amount: (total * concreteMaterialsPercent) / 100,
          description: 'Due morning of concrete pour'
        });
        remainingPercent -= concreteMaterialsPercent;
        
        const concreteLaborPercent = 9.88;
        schedule.push({
          name: 'Stamped Concrete LABOR (After Completion)',
          percent: concreteLaborPercent,
          amount: (total * concreteLaborPercent) / 100,
          description: 'Due after concrete completion'
        });
        remainingPercent -= concreteLaborPercent;
      }
      
      if (projectInfo.hasLiner) {
        const linerPercent = 9.88;
        schedule.push({
          name: 'Backfill + Liner Installation',
          percent: linerPercent,
          amount: (total * linerPercent) / 100,
          description: 'Due upon liner installation'
        });
        remainingPercent -= linerPercent;
      }
      
      // Add excavation if there's significant work
      if (total > 20000) {
        const excavationPercent = 7.19;
        schedule.push({
          name: 'Excavation & Site Prep',
          percent: excavationPercent,
          amount: (total * excavationPercent) / 100,
          description: 'Due upon excavation completion'
        });
        remainingPercent -= excavationPercent;
      }
      
      // Final payment (must be at least 3%, use remaining if more)
      const finalPercent = Math.max(3, remainingPercent);
      schedule.push({
        name: 'Final Payment',
        percent: finalPercent,
        amount: (total * finalPercent) / 100,
        description: 'Final payment upon project completion',
        isFinal: true
      });
      
      return schedule;
    }

