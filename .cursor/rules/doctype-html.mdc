      document.getElementById('paymentLinkNotes').value = '';
      document.getElementById('paymentLinkRemainingBalance').style.display = 'none';
      
      // Update remaining balance when amount changes
      const amountInput = document.getElementById('paymentLinkAmount');
      const oldOnInput = amountInput.oninput;
      amountInput.oninput = function() {
        const amount = parseFloat(this.value) || 0;
        const remaining = currentPaymentLinkInvoiceTotal - amount;
        
        if (amount > 0 && amount < currentPaymentLinkInvoiceTotal) {
          document.getElementById('paymentLinkRemainingBalance').style.display = 'block';
          document.getElementById('paymentLinkRemainingAmount').textContent = remaining.toFixed(2);
        } else {
          document.getElementById('paymentLinkRemainingBalance').style.display = 'none';
        }
      };
      
      document.getElementById('sendPaymentLinkModal').style.display = 'flex';
