    // Markup Toggle Function
    // Global profit tracking
    let profitModeActive = false;
    let profitModeItems = new Set();

    function toggleItemProfit(id) {
      const item = lineItems.find(i => i.id === id);
      if (item) {
        if (!item.isProfit) {
          // Mark item for profit tracking
          if (!profitModeActive) {
            profitModeActive = true;
            showProfitModeWarning();
          }
          item.isProfit = true;
          item.isProfitTracked = true;
          profitModeItems.add(id);
          
          // Initialize actualCost if not set
          if (!item.actualCost && !item.cost) {
            item.actualCost = 0;
            item.cost = 0;
          } else if (item.cost && !item.actualCost) {
            item.actualCost = item.cost;
          }
          
          showSuccess(`"${item.name}" marked for profit tracking`);
        } else {
          // Unmark item for profit tracking
          item.isProfit = false;
          item.isProfitTracked = false;
          profitModeItems.delete(id);
          showSuccess(`"${item.name}" unmarked from profit tracking`);
          
          // Check if any items still marked for profit
          if (profitModeItems.size === 0) {
            profitModeActive = false;
            hideProfitModeWarning();
          }
        }
        renderItems();
        updateProfitModeIndicator();
        
        // Auto-update profit calculation
        if (lineItems.length > 0) {
          calculateProfitSilently();
        }
      }
    }

