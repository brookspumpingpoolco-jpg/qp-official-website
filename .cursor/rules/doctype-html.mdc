    function removePayment(transactionId) {
      if (!confirm('Remove this payment record?')) return;
      
      const payment = paymentHistory.find(p => p.transactionId === transactionId);
      if (payment && payment.milestone) {
        // Unmark milestone if this was the payment for it
        const milestoneObj = paymentScheduleMilestones.find(m => m.name === payment.milestone);
        if (milestoneObj) {
          milestoneObj.isPaid = false;
        }
      }

      paymentHistory = paymentHistory.filter(p => p.transactionId !== transactionId);
      displayPaymentHistory();
      updatePaymentSummary();
      renderPaymentScheduleBuilder();
    }

    function updatePaymentSummary() {
      const totalPaid = paymentHistory.reduce((sum, p) => sum + parseFloat(p.amount || 0), 0);
      const invoiceTotal = getGrandTotal();
      const balanceDue = invoiceTotal - totalPaid;

      document.getElementById('totalPaidDisplay').textContent = '$' + totalPaid.toFixed(2);
      document.getElementById('balanceDueDisplay').textContent = '$' + balanceDue.toFixed(2);
      
      // Update color based on status
      const balanceEl = document.getElementById('balanceDueDisplay');
      if (balanceDue <= 0.01) {
        balanceEl.style.color = '#10b981'; // Green - fully paid
      } else if (totalPaid > 0) {
        balanceEl.style.color = '#f59e0b'; // Orange - partial
      } else {
        balanceEl.style.color = '#ef4444'; // Red - unpaid
      }
    }

