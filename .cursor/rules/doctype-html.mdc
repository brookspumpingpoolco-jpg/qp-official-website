    /**
     * View project details
     */
    // Alias for consistency - both names work
    async function viewProjectDetail(projectId) {
      return viewProjectDetails(projectId);
    }
    
    async function viewProjectDetails(projectId) {
      const modal = document.getElementById('projectDetailModal');
      const content = document.getElementById('projectDetailContent');
      
      // Show loading
      content.innerHTML = `
        <div style="text-align: center; padding: 40px;">
          <i class="fas fa-spinner fa-spin" style="font-size: 32px; color: #64748b;"></i>
          <p style="margin-top: 16px; color: #64748b;">Loading project details...</p>
        </div>
      `;
      
      modal.style.display = 'flex';
      
      try {
        // Fetch project details
        const response = await fetch(appendGasQuery(SCRIPT_URL, 'action=getProjectDetails&id=' + encodeURIComponent(projectId)));
        const result = await response.json();
        
        if (result.success && result.project) {
          // Log items from response
          console.log('📋 Project data received:', result.project);
          console.log('📋 Items in response:', result.project.items);
          console.log('📋 Items type:', typeof result.project.items);
          console.log('📋 Items length:', Array.isArray(result.project.items) ? result.project.items.length : 'Not an array');
          
          // ALWAYS fetch payment history for projects to ensure it's up-to-date
          if (result.project.projectId) {
            try {
              // Pass estimateId so the backend can match Payment History column B directly
              const linkedEstimateId = result.project.estimateId || result.project.invoiceId || '';
              console.log('📊 Fetching payment history for project:', result.project.projectId, '| linkedId:', linkedEstimateId);
              const phUrl = appendGasQuery(SCRIPT_URL, 'action=getProjectPaymentHistory&projectId=' + encodeURIComponent(result.project.projectId) + (linkedEstimateId ? '&estimateId=' + encodeURIComponent(linkedEstimateId) : ''));
              const paymentHistoryResponse = await fetch(phUrl);
              const paymentHistoryResult = await paymentHistoryResponse.json();
              console.log('📊 Payment history result:', paymentHistoryResult);
              if (paymentHistoryResult.success && paymentHistoryResult.payments) {
                result.project.payments = paymentHistoryResult.payments;
                console.log('✅ Loaded ' + paymentHistoryResult.payments.length + ' payments');
              } else {
                result.project.payments = [];
                console.log('⚠️ No payments found or error:', paymentHistoryResult.error || 'No payments');
              }
            } catch (e) {
              console.error('❌ Could not fetch payment history:', e);
              result.project.payments = result.project.payments || [];
            }
          } else {
            result.project.payments = result.project.payments || [];
            console.log('⚠️ No project ID found');
          }
          console.log('📋 Rendering project details with payments:', result.project.payments ? result.project.payments.length : 0);
          renderProjectDetails(result.project);
        } else {
          content.innerHTML = `
            <div style="text-align: center; padding: 40px; color: #ef4444;">
              <i class="fas fa-exclamation-triangle" style="font-size: 32px;"></i>
              <p style="margin-top: 16px;">Error loading project: ${result.error || 'Unknown error'}</p>
            </div>
          `;
        }
      } catch (error) {
        console.error('Error loading project details:', error);
        content.innerHTML = `
          <div style="text-align: center; padding: 40px; color: #ef4444;">
            <i class="fas fa-exclamation-triangle" style="font-size: 32px;"></i>
            <p style="margin-top: 16px;">Error: ${error.message}</p>
          </div>
        `;
      }
    }
    
