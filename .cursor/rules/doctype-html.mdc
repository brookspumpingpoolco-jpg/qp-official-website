    }

    /**
     * Select an AI variation from card click
     */
    function selectAIVariationFromCard(cardElement) {
      const index = parseInt(cardElement.getAttribute('data-index'));
      const variation = cardElement.getAttribute('data-variation').replace(/&#39;/g, "'").replace(/&quot;/g, '"');
      selectAIVariation(index, variation);
    }
    
    /**
     * Select an AI variation
     */
    function selectAIVariation(index, variation) {
      currentAiEnhancedText = variation;
      
      // Update visual selection
      document.querySelectorAll('.ai-variation-card').forEach((card, i) => {
        const isSelected = i === index;
        card.style.background = isSelected ? '#d1fae5' : 'white';
        card.style.borderColor = isSelected ? '#10b981' : '#e5e7eb';
        
        // Update badge color
        const badge = card.querySelector('span[style*="VARIATION"]');
        if (badge) {
          badge.style.background = isSelected ? '#10b981' : '#64748b';
        }
        
        // Update or add selected indicator
        let selectedSpan = card.querySelector('span[style*="Selected"]');
        if (isSelected && !selectedSpan) {
          const badgeContainer = card.querySelector('div[style*="display: flex; align-items: center"]');
          if (badgeContainer) {
            selectedSpan = document.createElement('span');
            selectedSpan.style.cssText = 'color: #059669; font-size: 12px; font-weight: 600; margin-left: 8px;';
            selectedSpan.innerHTML = '<i class="fas fa-check-circle"></i> Selected';
            badgeContainer.appendChild(selectedSpan);
          }
        } else if (!isSelected && selectedSpan) {
          selectedSpan.remove();
        }
      });
      
      // Update TinyMCE editor with selected variation (if editor is open)
      const tinymceEditor = tinymce.get('dailyUpdateEmailMessage');
      if (tinymceEditor) {
        tinymceEditor.setContent(variation);
        updateEmailPreview();
      }
    }
    
