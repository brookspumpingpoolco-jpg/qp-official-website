    }

    /**
     * Load project expenses
     */
    /**
     * Load upcoming/planned items from Shopping List for the selected project
     * and show them in the expenses tab as context.
     */
    async function loadUpcomingExpensesPanel(projectId) {
      const panel   = document.getElementById('upcomingExpensesPanel');
      const listEl  = document.getElementById('upcomingExpensesList');
      const totalEl = document.getElementById('upcomingExpensesTotal');
      if (!panel || !listEl) return;
      try {
        const r = await acctGet('getShoppingList');
        if (!r.success) { panel.style.display = 'none'; return; }
        const items = (r.items || []).filter(i => i.projectId === projectId && i.status !== 'Purchased' && i.status !== 'Cancelled');
        if (items.length === 0) { panel.style.display = 'none'; return; }
        panel.style.display = 'block';
        const total = items.reduce((s,i) => s + i.estCost, 0);
        if (totalEl) totalEl.textContent = items.length + ' item' + (items.length!==1?'s':'') + ' — Est. ' + new Intl.NumberFormat('en-US',{style:'currency',currency:'USD'}).format(total);
        const priColor = { High:'#dc2626', Normal:'#d97706', Low:'#64748b' };
        const stBg     = { Planned:'#ede9fe', Ordered:'#dbeafe' };
        const stColor  = { Planned:'#5b21b6', Ordered:'#1e40af' };
        listEl.innerHTML = items.map(i => `
          <div style="display:flex;align-items:center;gap:10px;padding:8px 12px;background:#fff;border-radius:8px;border:1px solid #fde68a;">
            <div style="flex:1;">
              <span style="font-weight:700;font-size:13px;">${i.name.replace(/&/g,'&amp;').replace(/</g,'&lt;')}</span>
              <span style="margin-left:8px;font-size:11px;color:${priColor[i.priority]||'#374151'};font-weight:600;">${i.priority}</span>
            </div>
            <span style="font-weight:800;color:#dc2626;white-space:nowrap;">$${parseFloat(i.estCost||0).toFixed(2)}</span>
            <span style="background:${stBg[i.status]||'#f1f5f9'};color:${stColor[i.status]||'#374151'};padding:2px 8px;border-radius:4px;font-size:11px;font-weight:700;">${i.status}</span>
            <button onclick="convertShopItemToExpense('${i.itemId}','${i.name.replace(/'/g,"\\'")}',${i.estCost},'${projectId}')" style="padding:3px 8px;font-size:11px;background:#16a34a;color:#fff;border:none;border-radius:4px;cursor:pointer;white-space:nowrap;">→ Log Expense</button>
          </div>`).join('');
      } catch (e) { if (panel) panel.style.display = 'none'; }
    }

    /** Pre-fill expense modal from a shopping list item */
    function convertShopItemToExpense(itemId, name, cost, projectId) {
      document.getElementById('newExpenseProject').value     = projectId;
      document.getElementById('newExpenseCategory').value   = 'Materials';
      document.getElementById('newExpenseDescription').value= name;
      document.getElementById('newExpenseAmount').value     = parseFloat(cost||0).toFixed(2);
      document.getElementById('newExpenseDate').value       = new Date().toISOString().split('T')[0];
      // Pre-check "also add" to mark it purchased when saved
      const chk = document.getElementById('alsoAddToShoppingList');
      if (chk) chk.checked = false; // don't duplicate
      openAddExpenseModal();
    }

    async function loadProjectExpenses() {
      const projectId = document.getElementById('expenseProjectFilter').value;
      
      if (!projectId) {
        document.getElementById('expensesList').innerHTML = `
          <div style="text-align: center; padding: 60px 20px; color: #6b7280;">
            <i class="fas fa-receipt" style="font-size: 64px; margin-bottom: 20px; opacity: 0.3;"></i>
            <p>Select a project above to view expenses and profit (revenue vs spent).</p>
          </div>
        `;
        document.getElementById('profitOverview').style.display = 'none';
        const upPanel = document.getElementById('upcomingExpensesPanel');
        if (upPanel) upPanel.style.display = 'none';
        return;
      }
      // Load upcoming shopping-list items for this project (non-blocking)
      loadUpcomingExpensesPanel(projectId);
      
      try {
        showLoading(true);
        
        // Use fetch API instead of google.script.run
        const [expensesResponse, profitResponse] = await Promise.all([
          fetch(SCRIPT_URL, {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: new URLSearchParams({ action: 'getProjectExpenses', projectId: projectId })
          }),
          fetch(SCRIPT_URL, {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: new URLSearchParams({ action: 'calculateProjectProfit', projectId: projectId })
          })
        ]);
        
        const expenses = expensesResponse.ok ? await expensesResponse.json() : { success: false, error: 'Failed to load expenses' };
        const profit = profitResponse.ok ? await profitResponse.json() : { success: false, error: 'Failed to load profit' };
        
        if (expenses && expenses.success) {
          renderExpensesList(expenses.expenses || []);
        }
        
        if (profit && profit.success) {
          renderProfitOverview(profit);
        }
        
      } catch (error) {
        console.error('Error loading expenses:', error);
        showError('Error loading expenses');
      } finally {
        showLoading(false);
      }
    }

