    function extractPoolSizeFromItems() {
      // Try to find pool size in line items
      for (let item of lineItems) {
        const name = (item.name || '').toLowerCase();
        const desc = (item.description || '').toLowerCase();
        
        // Look for patterns like "16x32", "16' x 32'", "16 × 32", etc.
        const poolSizePattern = /(\d+)\s*['']?\s*[x×]\s*(\d+)\s*['']?/i;
        const nameMatch = name.match(poolSizePattern);
        const descMatch = desc.match(poolSizePattern);
        
        if (nameMatch) {
          return `${nameMatch[1]}' × ${nameMatch[2]}'`;
        }
        if (descMatch) {
          return `${descMatch[1]}' × ${descMatch[2]}'`;
        }
      }
      return null;
    }

