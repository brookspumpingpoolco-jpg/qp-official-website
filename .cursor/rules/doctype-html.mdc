    /**
     * Open admin signature modal
     */
    function openAdminSignatureModal(estimateId, customerName) {
      currentSigningEstimateId = estimateId;
      const modal = document.getElementById('adminSignatureModal');
      modal.style.display = 'flex';
      document.getElementById('adminSigningFor').textContent = customerName;
      
      // Resize canvas to its rendered display size so mouse/touch coords align
      const canvas = document.getElementById('adminSignaturePad');
      // Use a short delay so the modal is visible before reading layout dimensions
      setTimeout(() => {
        const rect = canvas.getBoundingClientRect();
        canvas.width  = rect.width  || canvas.offsetWidth  || 560;
        canvas.height = rect.height || canvas.offsetHeight || 200;
        if (!adminSignaturePad) {
          adminSignaturePad = new SignaturePad(canvas, {
            backgroundColor: 'rgb(255, 255, 255)',
            penColor: 'rgb(0, 0, 0)'
          });
        } else {
          adminSignaturePad.clear();
          // Re-attach to resized canvas
          adminSignaturePad._canvas = canvas;
          adminSignaturePad._ctx    = canvas.getContext('2d');
          adminSignaturePad.clear();
        }
      }, 50);
    }

