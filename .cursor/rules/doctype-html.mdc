    /**
     * Load all projects from backend
     */
    async function loadAllProjects() {
      try {
        showLoading(true);
        
        // Use POST with form-encoded data for better CORS compatibility
        const response = await fetch(SCRIPT_URL, {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: new URLSearchParams({ action: 'getAllProjects' })
        });
        
        // Check if response is ok
        if (!response.ok) {
          throw new Error(`HTTP error! status: ${response.status}`);
        }
        
        // Try to parse as JSON
        let result;
        const text = await response.text();
        try {
          result = JSON.parse(text);
        } catch (parseError) {
          console.error('Failed to parse JSON response:', text);
          throw new Error('Invalid JSON response from server. Make sure the web app is deployed with "Anyone" access.');
        }
        
        if (result && result.success) {
          allProjects = result.projects || [];
          
          // Only render projects list if we're on the projects tab
          const projectsTab = document.getElementById('projectsTab');
          if (projectsTab && projectsTab.classList.contains('active')) {
          renderProjectsList();
          }
          
          // Populate project selectors (for Daily Updates, Expenses, etc.)
          populateProjectSelectors();
          
          // If on Expenses tab and a project is selected, load its expenses and profit
          const expensesTabActive = document.getElementById('expensesTab') && document.getElementById('expensesTab').classList.contains('active');
          if (expensesTabActive && document.getElementById('expenseProjectFilter') && document.getElementById('expenseProjectFilter').value && typeof loadProjectExpenses === 'function') {
            loadProjectExpenses();
          }
          
          // Don't show success message if called automatically
          if (projectsTab && projectsTab.classList.contains('active')) {
          showSuccess(`Loaded ${allProjects.length} projects`);
          }
        } else {
          showError('Failed to load projects: ' + (result.error || 'Unknown error'));
        }
      } catch (error) {
        console.error('Error loading projects:', error);
        
        // Provide more helpful error messages
        let errorMessage = 'Error loading projects: ' + error.toString();
        
        if (error.message && error.message.includes('Failed to fetch')) {
          errorMessage = 'Failed to connect to server. Please check:\n' +
            '1. The web app is deployed with "Anyone" access\n' +
            '2. The API_URL is correct\n' +
            '3. Your internet connection is working';
        } else if (error.message && error.message.includes('CORS')) {
          errorMessage = 'CORS error: The web app must be deployed with "Anyone" access. ' +
            'Go to Apps Script → Deploy → Manage deployments → Edit → Set "Who has access" to "Anyone"';
        }
        
        showError(errorMessage);
      } finally {
        showLoading(false);
      }
    }

