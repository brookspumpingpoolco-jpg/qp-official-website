    // Save item to price book (calls ItemList.gs web app)
    async function saveItemToPriceBook(item) {
      try {
        const itemData = {
          name: item.name,
          price: item.price,
          category: item.category || 'Custom',
          unit: item.unit || 'Each',
          description: item.description || '',
          code: item.code || ('CUSTOM-' + Date.now()),
          brand: '',
          imageUrl: item.imageUrl || '',
          active: true
        };
        
        // Call ItemList.gs web app directly since it manages the price book
        const ITEM_LIST_URL = 'https://script.google.com/macros/s/AKfycbwip6F2jTdpwSpsv824dHEdbvDDU4i-4INr9G5oOE8E3xblcOVsucT17dsq9Z1xL91M/exec';
        
        console.log('Saving item to price book - Item object:', item);
        console.log('Saving item to price book - ItemData:', itemData);
        console.log('Saving item to price book - JSON string:', JSON.stringify(itemData));
        
        const params = new URLSearchParams({
          action: 'addItemToPriceBook',
          itemData: JSON.stringify(itemData)
        });
        
        console.log('Sending POST request to:', ITEM_LIST_URL);
        console.log('Request body:', params.toString());
        
        const response = await fetch(ITEM_LIST_URL, {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: params
        });
        
        console.log('Response status:', response.status, response.statusText);
        console.log('Response ok:', response.ok);
        
        const responseText = await response.text();
        console.log('Response text:', responseText);
        
        if (!response.ok) {
          console.error('Response error text:', responseText);
          throw new Error(`HTTP error! status: ${response.status}, message: ${responseText.substring(0, 200)}`);
        }
        
        let result;
        try {
          result = JSON.parse(responseText);
        } catch (parseError) {
          console.error('JSON parse error:', parseError);
          throw new Error(`Failed to parse response as JSON: ${parseError.message}. Response: ${responseText.substring(0, 200)}`);
        }
        
        console.log('Save to price book result:', result);
        
        if (result.success) {
          // Mark the item as saved to price book
          item.savedToPriceBook = true;
          
          // Add item to local array immediately for instant UI update
          priceBookItems.push({
            code: item.code,
            name: item.name,
            price: item.price,
            category: item.category,
            unit: item.unit,
            description: item.description,
            imageUrl: item.imageUrl || ''
          });
          console.log('Item added to price book and local cache updated');
          
          // Also refresh from server to ensure consistency
          setTimeout(() => refreshPriceBookData(), 1000);
        } else {
          console.error('Failed to save item to price book:', result.error);
          throw new Error(result.error || 'Failed to save item to price book');
        }
      } catch (error) {
        console.error('Error saving item to price book:', error);
        throw error;
      }
    }

    // Save labor to price book (calls ItemList.gs web app)
    async function saveLaborToPriceBook(laborItem) {
      try {
        const laborData = {
          name: laborItem.name,
          rate: laborItem.price,
          category: laborItem.category,
          unit: laborItem.unit,
          description: laborItem.description,
          code: laborItem.code,
