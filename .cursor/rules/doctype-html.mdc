    // ==========================================================================
    //  EVENT LISTENER BINDING (Replace all inline onclick handlers)
    // ==========================================================================
    // This ensures all functions are available before event listeners are attached
    document.addEventListener('DOMContentLoaded', function() {
      // Bind critical send button directly (avoid fragile inline onclick scope issues)
      const sendToCustomerBtn = document.getElementById('sendToCustomerBtn');
      if (sendToCustomerBtn) {
        sendToCustomerBtn.removeAttribute('onclick');
        sendToCustomerBtn.addEventListener('click', function(event) {
          event.preventDefault();
          const handler = window.__showEmailEditorModalImpl || window.showEmailEditorModal;
          if (typeof handler === 'function') {
            handler.call(window, event);
          } else {
            console.error('showEmailEditorModal handler not available');
          }
        });
      }
      
      // Tab navigation buttons - bind to data-tab attribute
      document.querySelectorAll('.tab-btn[data-tab]').forEach(btn => {
        btn.addEventListener('click', function() {
          const tab = this.getAttribute('data-tab');
          if (typeof switchTab === 'function') {
            switchTab(tab);
          }
        });
      });
      
      // Type selector buttons
      document.querySelectorAll('.type-btn[data-type]').forEach(btn => {
        btn.addEventListener('click', function() {
          const type = this.getAttribute('data-type');
          if (typeof setType === 'function') {
            setType(type);
          }
        });
      });
      
      // Migrate any remaining inline onclick handlers to event listeners (safety net)
      document.querySelectorAll('[onclick]').forEach(el => {
        const inline = el.getAttribute('onclick');
        if (!inline) return;
        // Keep critical legacy handler as native inline onclick (avoids scope race with eval wrapper)
        if (inline.indexOf('showEmailEditorModal(') !== -1) return;
        el.removeAttribute('onclick');
        el.addEventListener('click', function(event) {
          try {
            // Execute inline handler in window scope so window-bound functions resolve reliably
            const fn = new Function('event', 'window', 'with (window) { ' + inline + ' }');
            fn.call(window, event, window);
          } catch (err) {
            // Fallback for simple function calls like "showEmailEditorModal()"
            const simpleCall = inline.match(/^\s*([A-Za-z_$][A-Za-z0-9_$]*)\s*\((.*)\)\s*;?\s*$/);
            if (simpleCall && typeof window[simpleCall[1]] === 'function') {
              try {
                window[simpleCall[1]](event);
                return;
              } catch (fallbackErr) {
                console.error('Inline onclick fallback failed:', inline, fallbackErr);
              }
            }
            console.error('Inline onclick handler failed:', inline, err);
          }
        });
      });
      
      // Note: Functions are made global below to ensure availability in Apps Script sandbox
      
      // ==========================================================================
      // AUTO-SAVE FUNCTIONALITY
      // ==========================================================================
      let autoSaveInterval = null;
      let autoSaveTimeout = null;
      
      // Auto-save every 30 seconds
      function startAutoSave() {
        if (autoSaveInterval) {
          clearInterval(autoSaveInterval);
        }
        autoSaveInterval = setInterval(function() {
          if (typeof saveDraft === 'function') {
            saveDraft(true); // Silent save
          }
        }, 30000); // 30 seconds
        console.log('Auto-save started (every 30 seconds)');
      }
      
      // Stop auto-save
      function stopAutoSave() {
        if (autoSaveInterval) {
          clearInterval(autoSaveInterval);
          autoSaveInterval = null;
        }
        if (autoSaveTimeout) {
          clearTimeout(autoSaveTimeout);
          autoSaveTimeout = null;
        }
        console.log('Auto-save stopped');
      }
      
      // Debounced auto-save on form changes (saves 2 seconds after last change)
      function triggerAutoSave() {
        if (autoSaveTimeout) {
          clearTimeout(autoSaveTimeout);
        }
        autoSaveTimeout = setTimeout(function() {
          if (typeof saveDraft === 'function') {
            saveDraft(true); // Silent save
          }
        }, 2000); // 2 seconds after last change
      }
      
      // Listen for form field changes
      const formFields = [
        'customerName', 'customerEmail', 'customerPhone', 'customerAddress',
        'date', 'dueDate', 'taxRate', 'discount', 'notes', 'terms'
      ];
      
      formFields.forEach(function(fieldId) {
        const field = document.getElementById(fieldId);
        if (field) {
          field.addEventListener('input', triggerAutoSave);
          field.addEventListener('change', triggerAutoSave);
        }
      });
      
      // Listen for line item changes (items are added/removed/updated)
      // We'll hook into the existing functions that modify lineItems
      const originalAddItem = window.addItemFromPriceBook;
      const originalRemoveItem = window.removeItem;
      const originalUpdateItem = window.updateItemQuantity;
      
      if (originalAddItem) {
        window.addItemFromPriceBook = function() {
          const result = originalAddItem.apply(this, arguments);
          triggerAutoSave();
          return result;
        };
      }
      
      if (originalRemoveItem) {
        window.removeItem = function() {
          const result = originalRemoveItem.apply(this, arguments);
          triggerAutoSave();
          return result;
        };
      }
      
      if (originalUpdateItem) {
        window.updateItemQuantity = function() {
          const result = originalUpdateItem.apply(this, arguments);
          triggerAutoSave();
          return result;
        };
      }
      
      // AUTO-SAVE DISABLED - Start auto-save when page loads
      // startAutoSave(); // DISABLED - user requested to turn off auto-save
      
      // Stop auto-save when form is cleared
      const originalClearForm = window.clearForm;
      if (originalClearForm) {
        window.clearForm = function() {
          stopAutoSave();
          const result = originalClearForm.apply(this, arguments);
          // Restart auto-save after clearing (in case user starts new quote)
          setTimeout(startAutoSave, 1000);
          return result;
        };
      }
      
      // Restart auto-save when a saved quote is loaded
      const originalLoadSavedQuote = window.loadSavedQuote;
      if (originalLoadSavedQuote) {
        window.loadSavedQuote = function() {
          const result = originalLoadSavedQuote.apply(this, arguments);
          startAutoSave();
          return result;
        };
      }
    });

