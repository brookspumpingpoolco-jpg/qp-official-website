          if (tbody) {
            var rowsHtml = itemsWithoutFee.map(function(item) {
              var qty = parseFloat(item.quantity || 0);
              var price = parseFloat(item.price || 0);
              var line = qty * price;
              return '<tr><td style="padding:8px 12px;border-top:1px solid #e2e8f0;">' + escapeHtml(String(item.name || '')) + '</td>' +
                '<td style="padding:8px 12px;border-top:1px solid #e2e8f0;text-align:right">' + qty + '</td>' +
