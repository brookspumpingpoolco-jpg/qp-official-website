    async function sendMilestoneInvoice(projectId, milestoneId) {
      if (!confirm('Send invoice for this milestone to the customer?')) return;
      
      try {
        showLoading(true);
        const resolvedProjectId = (projectId || (currentProject && currentProject.projectId) || (currentProject && currentProject.id) || '').toString().trim();
        const linkedId = (
          (currentProject && currentProject.projectData && (currentProject.projectData.estimateId || currentProject.projectData.invoiceId || currentProject.projectData.linkedEstimateId)) ||
          ''
        ).toString().trim();
        if (!resolvedProjectId) {
          showError('Could not determine project ID for this milestone.');
          return;
        }
        
        // Use fetch API instead of google.script.run
        const response = await fetch(API_URL, {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: new URLSearchParams({
            action: 'generateInvoice',
            projectId: resolvedProjectId,
            milestoneId: milestoneId,
            linkedId: linkedId
          })
        });
        
        if (!response.ok) {
          throw new Error(`HTTP error! status: ${response.status}`);
        }
        
        const result = await response.json();
        
        if (result && result.success) {
          const invoiceLink = result.shareLink || (result.invoiceId ? `https://www.aqualitypoolcompanyusa.com/invoice-viewer?id=${encodeURIComponent(result.invoiceId)}` : '');
          if (invoiceLink) {
            showSuccess('Invoice sent successfully! Use the milestone row buttons to open/copy the link.');
          } else {
            showSuccess('Invoice sent successfully!');
          }
          // Refresh project detail
          viewProjectDetail(resolvedProjectId);
        } else {
          const debugInfo = result && result.debug ? ('\nDebug: ' + JSON.stringify(result.debug)) : '';
          showError('Failed to send invoice: ' + (result.error || 'Unknown error') + debugInfo);
        }
      } catch (error) {
        console.error('Error sending invoice:', error);
        showError('Error sending invoice: ' + error.toString());
      } finally {
        showLoading(false);
      }
    }

    /**
     * Send payment reminder email
     */
    async function sendPaymentReminder(projectId, milestoneId) {
      try {
        showLoading(true);
        
        const response = await fetch(API_URL, {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: new URLSearchParams({
            action: 'sendPaymentReminder',
            projectId: projectId,
            milestoneId: milestoneId
          })
        });
        
        // Check if response is OK
        if (!response.ok) {
          throw new Error(`HTTP error! status: ${response.status}`);
        }
        
        // Get response text first to check if it's valid JSON
        const responseText = await response.text();
        let result;
        try {
          result = JSON.parse(responseText);
        } catch (parseError) {
          console.error('Failed to parse JSON response:', responseText);
          throw new Error('Invalid JSON response from server: ' + responseText.substring(0, 200));
        }
        
        if (result && result.success) {
          showSuccess('Payment reminder sent successfully!');
          viewProjectDetail(projectId);
        } else {
          showError('Failed to send reminder: ' + (result.error || 'Unknown error'));
        }
      } catch (error) {
        console.error('Error sending reminder:', error);
        showError('Error sending reminder: ' + error.toString());
      } finally {
        showLoading(false);
      }
    }

