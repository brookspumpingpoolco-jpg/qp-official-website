    /**
     * Select work date using bubbles
     */
    function selectWorkDate(option) {
      const dateInput = document.getElementById('dailyWorkDate');
      const today = new Date();
      let selectedDate = new Date();
      let dateText = '';
      
      // Calculate date based on option
      switch(option) {
        case 'yesterday':
          selectedDate.setDate(today.getDate() - 1);
          dateText = 'Yesterday (' + selectedDate.toLocaleDateString() + ')';
          break;
        case 'today':
          selectedDate = today;
          dateText = 'Today (' + selectedDate.toLocaleDateString() + ')';
          break;
        case 'tomorrow':
          selectedDate.setDate(today.getDate() + 1);
          dateText = 'Tomorrow (' + selectedDate.toLocaleDateString() + ')';
          break;
        case 'custom':
          dateInput.style.display = 'block';
          dateInput.focus();
          dateInput.click();
          return; // Don't update bubbles yet, wait for date picker
        default:
          selectedDate = today;
          dateText = 'Today (' + selectedDate.toLocaleDateString() + ')';
      }
      
      // Set date input value
      dateInput.value = selectedDate.toISOString().split('T')[0];
      dateInput.style.display = 'none';
      
      // Update display text
      document.getElementById('selectedDateText').textContent = dateText;
      
      // Update bubble active states
      const bubbles = ['yesterday', 'today', 'tomorrow', 'custom'];
      bubbles.forEach(bubble => {
        const bubbleEl = document.getElementById('dateBubble' + bubble.charAt(0).toUpperCase() + bubble.slice(1));
        if (bubbleEl) {
          if (bubble === option) {
            bubbleEl.classList.add('active');
            bubbleEl.style.background = '#0369a1';
            bubbleEl.style.borderColor = '#0369a1';
            bubbleEl.style.color = 'white';
          } else {
            bubbleEl.classList.remove('active');
            bubbleEl.style.background = 'white';
            bubbleEl.style.borderColor = '#e5e7eb';
            bubbleEl.style.color = '#6b7280';
          }
        }
      });
    }

    /**
     * Update custom date display when date picker changes
     */
    function updateCustomDateDisplay() {
      const dateInput = document.getElementById('dailyWorkDate');
      const selectedDate = new Date(dateInput.value);
      const today = new Date();
      today.setHours(0, 0, 0, 0);
      selectedDate.setHours(0, 0, 0, 0);
      
      const diffDays = Math.round((selectedDate - today) / (1000 * 60 * 60 * 24));
      let dateText = '';
      
      if (diffDays === -1) {
        dateText = 'Yesterday (' + selectedDate.toLocaleDateString() + ')';
        selectWorkDate('yesterday');
      } else if (diffDays === 0) {
        dateText = 'Today (' + selectedDate.toLocaleDateString() + ')';
        selectWorkDate('today');
      } else if (diffDays === 1) {
        dateText = 'Tomorrow (' + selectedDate.toLocaleDateString() + ')';
        selectWorkDate('tomorrow');
      } else {
        dateText = selectedDate.toLocaleDateString('en-US', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' });
        // Update custom bubble
        const customBubble = document.getElementById('dateBubbleCustom');
        if (customBubble) {
          customBubble.classList.add('active');
          customBubble.style.background = '#0369a1';
          customBubble.style.borderColor = '#0369a1';
          customBubble.style.color = 'white';
        }
        // Remove active from others
        ['yesterday', 'today', 'tomorrow'].forEach(bubble => {
          const bubbleEl = document.getElementById('dateBubble' + bubble.charAt(0).toUpperCase() + bubble.slice(1));
          if (bubbleEl) {
            bubbleEl.classList.remove('active');
            bubbleEl.style.background = 'white';
            bubbleEl.style.borderColor = '#e5e7eb';
            bubbleEl.style.color = '#6b7280';
          }
        });
      }
      
      document.getElementById('selectedDateText').textContent = dateText;
    }

    /**
     * Enhance with AI
     */
    async function enhanceWithAI() {
      const projectId = document.getElementById('dailyUpdateProject').value;
      const rawNotes = document.getElementById('dailyWorkNotes').value;
      const workDate = document.getElementById('dailyWorkDate').value || new Date().toISOString().split('T')[0];
      
      if (!projectId) {
        showError('Please select a project first');
        return;
      }
      
      if (!rawNotes.trim()) {
        showError('Please enter work notes first');
        return;
      }
      
      try {
        showLoading(true);
        
        // Use API endpoint instead of google.script.run for compatibility
        let result;
        if (typeof google !== 'undefined' && google.script && google.script.run) {
          // Try google.script.run first (if available)
          try {
            result = await new Promise((resolve, reject) => {
          google.script.run
            .withSuccessHandler(resolve)
            .withFailureHandler(reject)
                .generateDailySummaryWithAI(projectId, rawNotes, [], workDate);
            });
          } catch (e) {
            // Fallback to API if google.script.run fails
            const response = await fetch(API_URL, {
              method: 'POST',
              headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
              body: new URLSearchParams({
                action: 'enhanceDailyUpdate',
                projectId: projectId,
                notes: rawNotes,
                photoUrls: JSON.stringify([]),
                workDate: workDate
              })
            });
            result = await response.json();
          }
        } else {
          // Use API endpoint directly
          const response = await fetch(API_URL, {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: new URLSearchParams({
              action: 'enhanceDailyUpdate',
              projectId: projectId,
              notes: rawNotes,
              photoUrls: JSON.stringify([]),
              workDate: workDate
            })
          });
          result = await response.json();
        }
        
        if (result && result.success) {
          currentOriginalText = rawNotes;
          
          // Get variations (3 options)
          const variations = result.variations || [result.enhancedSummary];
          const selectedVariation = variations[0]; // Default to first
          currentAiEnhancedText = selectedVariation;
          
          // Display all 3 variations with selection buttons
          const container = document.getElementById('aiVariationsContainer');
          container.innerHTML = variations.map((variation, index) => {
            const isSelected = index === 0;
            // Store variation in a data attribute to avoid escaping issues
            const variationEscaped = variation.replace(/"/g, '&quot;').replace(/'/g, '&#39;');
            return `
              <div class="ai-variation-card" data-index="${index}" data-variation="${variationEscaped}" style="margin-bottom: 12px; padding: 16px; background: ${isSelected ? '#d1fae5' : 'white'}; border: 2px solid ${isSelected ? '#10b981' : '#e5e7eb'}; border-radius: 8px; cursor: pointer; transition: all 0.2s;" onclick="selectAIVariationFromCard(this)">
                <div style="display: flex; justify-content: space-between; align-items: start; gap: 12px;">
                  <div style="flex: 1;">
                    <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 8px;">
                      <span style="background: ${isSelected ? '#10b981' : '#64748b'}; color: white; padding: 2px 8px; border-radius: 12px; font-size: 11px; font-weight: 600;">VARIATION ${index + 1}</span>
                      ${isSelected ? '<span style="color: #059669; font-size: 12px; font-weight: 600;"><i class="fas fa-check-circle"></i> Selected</span>' : ''}
                    </div>
                    <div style="color: #065f46; line-height: 1.6; white-space: pre-wrap; font-size: 14px;">${variation.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/\n/g, '<br>')}</div>
                  </div>
                </div>
              </div>
            `;
          }).join('');
          
          document.getElementById('enhancedPreview').style.display = 'block';
          
          // Auto-select first variation
          const firstCard = container.querySelector('.ai-variation-card[data-index="0"]');
          if (firstCard) {
            selectAIVariationFromCard(firstCard);
          }
          
          if (result.aiUsed) {
            showSuccess('AI generated 3 variations! Select your preferred option.');
          } else {
            showSuccess('Using original text (AI not available)');
          }
        } else {
          showError('Failed to enhance: ' + (result.error || 'Unknown error'));
        }
      } catch (error) {
        console.error('Error enhancing with AI:', error);
        showError('Error enhancing with AI: ' + error.toString());
      } finally {
        showLoading(false);
      }
    }

