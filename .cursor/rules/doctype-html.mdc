      console.log('🔵 [FORM DATA] User email:', userEmail || 'Not set');
      
      // Calculate payment totals
      const totalPaid = paymentHistory.reduce((sum, p) => sum + parseFloat(p.amount || 0), 0);
      const invoiceTotal = getGrandTotal();
      const remainingBalance = invoiceTotal - totalPaid;
      
      // Determine payment status
      let paymentStatus = 'Pending';
      if (totalPaid >= invoiceTotal - 0.01) {
        paymentStatus = 'Paid';
      } else if (totalPaid > 0) {
        paymentStatus = 'Partial';
      }

      // Filter out processing fee from items - backend will add it separately to Stripe
      const itemsToSend = lineItems.filter(item => !item.isProcessingFee);

      const data = {
        type: type,
        projectType: document.getElementById('projectType')?.value || '',
        customerName: document.getElementById('customerName').value,
        customerEmail: document.getElementById('customerEmail').value,
        customerPhone: document.getElementById('customerPhone').value,
        customerAddress: document.getElementById('customerAddress').value,
        date: document.getElementById('date').value,
        dueDate: document.getElementById('dueDate').value || '',
        invoiceNumber: document.getElementById('invoiceNumber').value || '',
        quoteNumber: document.getElementById('quoteNumber').value || '',
        items: JSON.stringify(itemsToSend),
        notes: document.getElementById('notes').value,
        terms: document.getElementById('terms').value,
        taxRate: parseFloat(document.getElementById('taxRate').value) || 0,
        discount: parseFloat(document.getElementById('discount').value) || 0,
        addProcessingFee: document.getElementById('addProcessingFee')?.checked || false,
        requestApproval: document.getElementById('requestApproval')?.checked || false,
        paymentSchedule: paymentScheduleMilestones.length > 0 ? JSON.stringify(paymentScheduleMilestones) : null,
        paymentHistory: paymentHistory.length > 0 ? JSON.stringify(paymentHistory) : null,
        totalPaid: totalPaid,
        remainingBalance: remainingBalance,
        paymentStatus: paymentStatus,
        milestonesPaid: paymentScheduleMilestones.filter(m => m.isPaid).map(m => m.name),
        createdBy: userEmail || '', // Add user email for company filtering
        userEmail: userEmail || '', // Also add as userEmail for backend compatibility
        photos: (typeof invoicePhotoUrls !== 'undefined' && Array.isArray(invoicePhotoUrls)) ? invoicePhotoUrls : []
      };
      
      if (data.paymentSchedule) {
        console.log('✅ [FORM DATA] Payment schedule INCLUDED in form data');
        console.log('🔵 [FORM DATA] Payment schedule JSON:', data.paymentSchedule);
      } else {
        console.log('⚠️ [FORM DATA] Payment schedule NOT included (no milestones)');
      }
      
      // Add ID if we're editing an existing quote/invoice (prioritize currentEditingQuoteId)
      if (currentEditingQuoteId) {
        data.id = currentEditingQuoteId;
      } else if (currentInvoiceId) {
        data.id = currentInvoiceId;
      } else if (currentQuoteId) {
        data.id = currentQuoteId;
      }
      
      // Add recurring invoice data if checked
      if (document.getElementById('makeRecurring')?.checked) {
        data.recurring = {
          frequency: document.getElementById('recurringFrequency').value,
          name: document.getElementById('recurringName').value || 'Recurring Invoice'
        };
      }
      
      return data;
    }

