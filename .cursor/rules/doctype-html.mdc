    /**
     * Record manual payment (check/cash)
     */
    // Store current payment context
    let currentPaymentContext = {
      projectId: null,
      milestoneId: null,
      milestoneName: null,
      milestoneAmount: null
    };
    
    /**
     * Open manual payment modal
     * Can be called with projectId (for projects) or invoiceId (for invoices)
     */
    async function openManualPaymentModal(projectId, milestoneId, milestoneName, milestoneAmount, invoiceId) {
      // Always set context - don't rely on existing context
      // Explicitly set invoiceId to null if not provided (to avoid using stale currentInvoiceId)
      currentPaymentContext = {
        projectId: projectId || null,
        milestoneId: milestoneId || null,
        milestoneName: milestoneName || null,
        milestoneAmount: milestoneAmount || null,
        invoiceId: invoiceId !== undefined ? invoiceId : null  // Only use provided invoiceId, not currentInvoiceId
      };
      
      // Debug log
      console.log('📝 Opening manual payment modal with context:', {
        projectId: currentPaymentContext.projectId,
        invoiceId: currentPaymentContext.invoiceId,
        milestoneId: currentPaymentContext.milestoneId,
        currentInvoiceId: currentInvoiceId
      });
      
      // Get customer info - from project or invoice
      let customerName = 'N/A';
      let displayId = '';
      
      if (projectId) {
        // Project context
      const project = allProjects.find(p => p.projectId === projectId) || currentProject;
      const projectData = project ? (project.projectData || project.project || {}) : {};
        customerName = projectData.customerName || 'N/A';
        displayId = projectId;
      } else if (invoiceId || currentInvoiceId) {
        // Invoice context
        const invoiceIdToUse = invoiceId || currentInvoiceId;
        displayId = invoiceIdToUse;
        // Get customer name from current invoice data
        const customerNameEl = document.getElementById('customerName');
        if (customerNameEl) {
          customerName = customerNameEl.value || 'N/A';
        }
      }
      
      // Populate modal
      const projectIdEl = document.getElementById('manualPaymentProjectId');
      const labelEl = document.getElementById('manualPaymentIdLabel');
      if (projectIdEl) {
        projectIdEl.textContent = displayId || 'N/A';
        // Update label based on context
        if (labelEl) {
          labelEl.textContent = projectId ? 'Project:' : 'Invoice ID:';
        }
      }
      
      const customerNameEl = document.getElementById('manualPaymentCustomerName');
      if (customerNameEl) {
        customerNameEl.textContent = customerName;
      }
      
      // Show milestone info if provided (only for projects)
      const milestoneInfo = document.getElementById('manualPaymentMilestoneInfo');
      if (milestoneInfo) {
        if (milestoneId && milestoneName && projectId) {
        milestoneInfo.style.display = 'block';
        milestoneInfo.innerHTML = `<strong>Milestone:</strong> ${milestoneName} ($${parseFloat(milestoneAmount || 0).toFixed(2)})`;
      } else {
        milestoneInfo.style.display = 'none';
        }
      }
      
      // Set default amount if milestone amount provided
      if (milestoneAmount) {
        document.getElementById('manualPaymentAmount').value = parseFloat(milestoneAmount).toFixed(2);
      } else {
        document.getElementById('manualPaymentAmount').value = '';
      }
      
      // Reset other fields
      document.getElementById('manualPaymentMethod').value = '';
      document.getElementById('manualPaymentDate').value = new Date().toISOString().split('T')[0];
      document.getElementById('manualPaymentNotes').value = '';

      // Show modal immediately, then populate milestone dropdown asynchronously
      document.getElementById('manualPaymentModal').style.display = 'flex';

      // Populate milestone dropdown — fetch paid status LIVE from Payment History (never use JSON)
      const milestoneRow = document.getElementById('manualPaymentMilestoneRow');
      const milestoneSelect = document.getElementById('manualPaymentMilestoneSelect');
      if (milestoneRow && milestoneSelect && projectId) {
        milestoneSelect.innerHTML = '<option value="" disabled>Loading milestones…</option>';
        milestoneRow.style.display = 'block';

        try {
          const proj = (typeof allProjects !== 'undefined' ? allProjects : []).find(p => p.projectId === projectId) || currentProject;
          const projData = proj ? (proj.projectData || proj.project || {}) : {};
          const sched = projData.paymentSchedule || [];
          const parsedSched = typeof sched === 'string' ? JSON.parse(sched) : sched;

          // Fetch milestone paid status live from Payment History sheet
          const linkedId = projData.estimateId || projData.invoiceId || proj?.estimateId || proj?.invoiceId || '';
          const msUrl = appendGasQuery(SCRIPT_URL, 'action=getMilestoneStatusFromHistory&projectId='
            + encodeURIComponent(projectId)
            + (linkedId ? '&estimateId=' + encodeURIComponent(linkedId) : ''));
          const msResp = await fetch(msUrl);
          const msResult = await msResp.json();
          const histStatus = (msResult.success && msResult.milestones) ? msResult.milestones : {};

          // Also update currentProject so the detail view stays in sync
          if (currentProject && currentProject.projectId === projectId) {
            currentProject.milestoneStatusFromHistory = histStatus;
            currentProject.totalPaid = msResult.totalPaid || 0;
            currentProject.payments  = msResult.payments  || [];
          }

          milestoneSelect.innerHTML = '<option value="">— General payment (no specific milestone) —</option>';
          let unpaidCount = 0;
          parsedSched.forEach(function(ms) {
            const fromHistory = histStatus[String(ms.id)];
            const alreadyPaid = fromHistory && fromHistory.paid === true;
            if (alreadyPaid) return; // paid milestones don't appear — no re-recording needed
            const opt = document.createElement('option');
            opt.value = ms.id;
            opt.textContent = ms.name + ' ($' + parseFloat(ms.amount || 0).toFixed(2) + ')';
            if (milestoneId && String(ms.id) === String(milestoneId)) opt.selected = true;
            milestoneSelect.appendChild(opt);
            unpaidCount++;
          });
          milestoneRow.style.display = unpaidCount > 0 ? 'block' : 'none';
        } catch (msErr) {
          console.error('Failed to load milestone status:', msErr);
          // Fallback: show all milestones without paid filtering
          const proj = (typeof allProjects !== 'undefined' ? allProjects : []).find(p => p.projectId === projectId) || currentProject;
          const projData = proj ? (proj.projectData || proj.project || {}) : {};
          const sched = projData.paymentSchedule || [];
          const parsedSched = typeof sched === 'string' ? JSON.parse(sched) : sched;
          milestoneSelect.innerHTML = '<option value="">— General payment (no specific milestone) —</option>';
          parsedSched.forEach(function(ms) {
            const opt = document.createElement('option');
            opt.value = ms.id;
            opt.textContent = ms.name + ' ($' + parseFloat(ms.amount || 0).toFixed(2) + ')';
            if (milestoneId && String(ms.id) === String(milestoneId)) opt.selected = true;
            milestoneSelect.appendChild(opt);
          });
          milestoneRow.style.display = parsedSched.length > 0 ? 'block' : 'none';
        }
      } else if (milestoneRow) {
        milestoneRow.style.display = 'none';
      }
    }
    
