    function filterQuotes() {
      const statusFilter = document.getElementById('statusFilter').value.toLowerCase();
      const customerSearch = document.getElementById('customerSearch').value.toLowerCase();

      filteredQuotes = allQuotes.filter(quote => {
        // Status filter
        if (statusFilter && !quote.status.toLowerCase().includes(statusFilter)) {
          return false;
        }

        // Customer search
        if (customerSearch && !quote.customerName.toLowerCase().includes(customerSearch) && 
            !quote.customerEmail.toLowerCase().includes(customerSearch)) {
          return false;
        }

        return true;
      });

      renderQuotes();
