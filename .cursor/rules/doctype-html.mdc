            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
              <h3 style="margin: 0;"><i class="fas fa-file-contract"></i> Contracts</h3>
              <button type="button" class="btn btn-primary" onclick="openCreateContractForProject('${project.projectId}')" style="font-size: 13px; padding: 6px 12px;">
                <i class="fas fa-plus"></i> New Contract
              </button>
            </div>
            <div id="projectContractsContent">
              <div style="text-align: center; padding: 20px; color: #64748b;">
                <i class="fas fa-spinner fa-spin" style="font-size: 24px; margin-bottom: 10px;"></i>
                <p style="margin: 0;">Loading contracts...</p>
              </div>
            </div>
          </div>
          
          <!-- Purchase Orders -->
          <div id="projectPOSection" style="background: white; padding: 20px; border-radius: 12px; border: 2px solid #e5e7eb; margin-bottom: 16px;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
              <h3 style="margin: 0;"><i class="fas fa-shopping-cart"></i> Purchase Orders</h3>
              <div style="display: flex; gap: 8px; align-items: center;">
                <span id="projectPOBadge" style="display: none; background: #dbeafe; color: #1e40af; font-size: 12px; font-weight: 700; padding: 3px 10px; border-radius: 10px;"></span>
                <button type="button" onclick="openQuickPOModal('${project.projectId}')" style="padding:5px 10px;font-size:12px;font-weight:600;background:#2563eb;color:#fff;border:none;border-radius:6px;cursor:pointer;"><i class="fas fa-plus"></i> Create PO</button>
              </div>
