      document.getElementById('paperContractModal').style.display = 'none';
      _paperContractFile = null;
    }

    function handlePaperContractDrop(event) {
      event.preventDefault();
      const dz = document.getElementById('paperContractDropZone');
      dz.style.borderColor = '#d1d5db';
      dz.style.background = '#f9fafb';
      const file = event.dataTransfer.files[0];
      if (file) setPaperContractFile(file);
    }

    function handlePaperContractFileSelect(event) {
      const file = event.target.files[0];
      if (file) setPaperContractFile(file);
    }

    function setPaperContractFile(file) {
      const errEl = document.getElementById('paperContractError');
      const allowedTypes = ['application/pdf', 'image/jpeg', 'image/jpg', 'image/png'];
      if (!allowedTypes.includes(file.type)) {
        errEl.textContent = 'Please upload a PDF, JPG, or PNG file.';
        errEl.style.display = 'block';
        return;
      }
      if (file.size > 10 * 1024 * 1024) {
        errEl.textContent = 'File must be under 10 MB.';
        errEl.style.display = 'block';
        return;
      }
      errEl.style.display = 'none';
      _paperContractFile = file;
      document.getElementById('paperContractFileName').textContent = file.name;
      document.getElementById('paperContractFileSize').textContent = (file.size / 1024).toFixed(1) + ' KB';
      const preview = document.getElementById('paperContractFilePreview');
      preview.style.display = 'flex';
      document.getElementById('paperContractUploadBtn').disabled = false;
    }

    function clearPaperContractFile() {
      _paperContractFile = null;
      document.getElementById('paperContractFileInput').value = '';
      document.getElementById('paperContractFilePreview').style.display = 'none';
      document.getElementById('paperContractUploadBtn').disabled = true;
    }

    async function submitPaperContract() {
      if (!_paperContractFile) return;
      const projectId = document.getElementById('paperContractProjectId').value;
      if (!projectId) { showMessage('error', 'No project ID found.'); return; }

      const btn = document.getElementById('paperContractUploadBtn');
      const errEl = document.getElementById('paperContractError');
      const progress = document.getElementById('paperContractProgress');
      const bar = document.getElementById('paperContractProgressBar');

      btn.disabled = true;
      errEl.style.display = 'none';
      progress.style.display = 'block';

      // Animate progress bar
      let pct = 0;
      const ticker = setInterval(() => { pct = Math.min(pct + 5, 85); bar.style.width = pct + '%'; }, 300);

      try {
        // Read file as base64
        const base64 = await new Promise((resolve, reject) => {
          const reader = new FileReader();
          reader.onload = e => resolve(e.target.result.split(',')[1]);
          reader.onerror = reject;
          reader.readAsDataURL(_paperContractFile);
        });

        const payload = {
          action: 'uploadPaperContract',
          projectId: projectId,
          fileData: base64,
          fileName: _paperContractFile.name,
          mimeType: _paperContractFile.type
        };

        const response = await fetch(SCRIPT_URL, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });
        const result = await response.json();

        clearInterval(ticker);
        bar.style.width = '100%';

        if (result.success) {
          setTimeout(() => {
            closePaperContractModal();
            showMessage('success', 'Paper contract uploaded! Saved to: ' + result.folderName);
            // Reload project details to reflect the new contract status
            if (projectId) viewProjectDetails(projectId);
          }, 400);
        } else {
          progress.style.display = 'none';
          btn.disabled = false;
          errEl.textContent = result.error || 'Upload failed. Please try again.';
          errEl.style.display = 'block';
        }
      } catch (err) {
        clearInterval(ticker);
        progress.style.display = 'none';
        btn.disabled = false;
        errEl.textContent = 'Error: ' + err.message;
        errEl.style.display = 'block';
      }
    }
    
