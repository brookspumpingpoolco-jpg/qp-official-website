      { id: 'plumbing', name: 'Plumbing & Equipment Pad Install', defaultPercent: 8.26, description: 'Plumbing and equipment pad setup' },
      { id: 'pool_bottom', name: 'Pool Bottom', defaultPercent: 5.39, description: 'Pool bottom preparation' },
      { id: 'backfill_liner', name: 'Backfill + Liner Installation', defaultPercent: 9.88, description: 'Backfill and liner installation' },
      { id: 'electrical', name: 'Electrical Hookup', defaultPercent: 1.62, description: 'Electrical connections' },
      { id: 'concrete_materials', name: 'Stamped Concrete MATERIALS (Morning of Pour)', defaultPercent: 5.39, description: 'Concrete materials delivery' },
      { id: 'concrete_labor', name: 'Stamped Concrete LABOR (After Completion)', defaultPercent: 9.88, description: 'Concrete labor and finishing' },
