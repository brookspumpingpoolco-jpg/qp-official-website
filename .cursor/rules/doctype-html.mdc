                `}
              </div>
            </div>
          </div>
        `;
      }).join('');
      
      // Update totals after rendering
      updatePaymentScheduleTotals();
    }

    function updatePaymentAmount(id, value) {
      const payment = paymentScheduleMilestones.find(p => p.id === id);
      if (!payment) return;
      
      const total = getGrandTotal();
      const isFinalPayment = payment.name.toLowerCase().includes('final');
      
      if (paymentScheduleMode === 'percent') {
        payment.percent = parseFloat(value) || 0;
        payment.amount = (total * payment.percent) / 100;
      } else {
        payment.amount = parseFloat(value) || 0;
        payment.percent = total > 0 ? (payment.amount / total) * 100 : 0;
      }
      
      // Auto-adjust final payment to make total 100% (only if this is NOT the final payment)
      if (!isFinalPayment) {
        autoAdjustFinalPayment();
      }
      
      updatePaymentScheduleTotals();
      renderPaymentScheduleBuilder();
    }

    function autoAdjustFinalPayment() {
      // Find final payment milestone
      const finalPaymentIndex = paymentScheduleMilestones.findIndex(m => 
        m.name.toLowerCase().includes('final')
      );
      
      if (finalPaymentIndex === -1) return; // No final payment found
      
      const total = getGrandTotal();
      
      // Calculate total of all payments EXCEPT final
      const nonFinalTotal = paymentScheduleMilestones.reduce((sum, m, idx) => {
        if (idx !== finalPaymentIndex) {
          return sum + parseFloat(m.percent || 0);
        }
        return sum;
      }, 0);
      
      // Set final payment to whatever is left
      const remainingPercent = 100 - nonFinalTotal;
      
      // Only update if it's a reasonable value (between 0 and 100)
      if (remainingPercent >= 0 && remainingPercent <= 100) {
        paymentScheduleMilestones[finalPaymentIndex].percent = remainingPercent;
        paymentScheduleMilestones[finalPaymentIndex].amount = (total * remainingPercent) / 100;
      }
    }

    // Drag and Drop functionality
    let draggedPaymentIndex = null;

    function handlePaymentDragStart(event, index) {
      draggedPaymentIndex = index;
      event.target.style.opacity = '0.4';
      event.dataTransfer.effectAllowed = 'move';
      event.dataTransfer.setData('text/html', event.target.innerHTML);
    }

    function handlePaymentDragOver(event) {
      if (event.preventDefault) {
        event.preventDefault();
      }
      event.dataTransfer.dropEffect = 'move';
      
      // Add visual feedback
      event.currentTarget.style.borderTop = '3px solid #06b6d4';
      return false;
    }

    function handlePaymentDrop(event, dropIndex) {
      if (event.stopPropagation) {
        event.stopPropagation();
      }
      
      // Remove visual feedback
      event.currentTarget.style.borderTop = '';
      
      if (draggedPaymentIndex !== null && draggedPaymentIndex !== dropIndex) {
        // Reorder the array
        const draggedItem = paymentScheduleMilestones[draggedPaymentIndex];
        paymentScheduleMilestones.splice(draggedPaymentIndex, 1);
        paymentScheduleMilestones.splice(dropIndex, 0, draggedItem);
        
        // Re-render
        renderPaymentScheduleBuilder();
      }
      
      return false;
    }

    function handlePaymentDragEnd(event) {
      event.target.style.opacity = '1';
      draggedPaymentIndex = null;
      
      // Remove visual feedback from all items
      const items = document.querySelectorAll('[data-payment-id]');
      items.forEach(item => {
        item.style.borderTop = '';
      });
    }

    function addPaymentEntry() {
      const payment = {
        id: Date.now() + Math.random(),
        name: '',
        percent: 0,
        amount: 0,
        dueTrigger: 'date',
        dueDate: '',
        duePhase: ''
      };
      paymentScheduleMilestones.push(payment);
      renderPaymentScheduleBuilder();
      updatePaymentScheduleTotals();
    }

    function addFinalPayment() {
      console.log('🔵 [FINAL PAYMENT] Add Final Payment clicked');
      
      const total = getGrandTotal();
      
      // Check if final payment already exists
      const hasFinalPayment = paymentScheduleMilestones.some(m => 
        m.name && m.name.toLowerCase().includes('final')
      );
      
      if (hasFinalPayment) {
        showError('A final payment already exists. Please edit the existing one.');
        console.log('⚠️ [FINAL PAYMENT] Final payment already exists');
        return;
      }
      
      // Calculate remaining amount
      const totalPaid = paymentScheduleMilestones.reduce((sum, m) => sum + (parseFloat(m.amount) || 0), 0);
      const remainingAmount = total - totalPaid;
      const remainingPercent = total > 0 ? (remainingAmount / total) * 100 : 0;
      
      console.log('🔵 [FINAL PAYMENT] Total:', total);
      console.log('🔵 [FINAL PAYMENT] Total Paid:', totalPaid);
      console.log('🔵 [FINAL PAYMENT] Remaining:', remainingAmount);
      console.log('🔵 [FINAL PAYMENT] Remaining %:', remainingPercent);
      
      // Create final payment
      const finalPayment = {
        id: Date.now() + Math.random(),
        name: 'Final Payment',
        percent: Math.max(0, remainingPercent),
        amount: Math.max(0, remainingAmount),
        dueTrigger: 'phase',
        dueDate: '',
        duePhase: 'Complete'
      };
      
      paymentScheduleMilestones.push(finalPayment);
      renderPaymentScheduleBuilder();
      updatePaymentScheduleTotals();
      
      showSuccess(`Final payment added: $${remainingAmount.toFixed(2)} (${remainingPercent.toFixed(2)}%)`);
      console.log('✅ [FINAL PAYMENT] Final payment added successfully');
    }

    async function getAIRecommendations() {
      try {
        showLoading(true);
        const total = getGrandTotal();
        const items = lineItems.map(item => ({
          name: item.name,
          description: item.description,
          quantity: item.quantity,
          price: item.price,
          category: item.category
        }));
        
        // Analyze items to determine project type
        const hasWalls = items.some(i => i.name.toLowerCase().includes('wall'));
        const hasConcrete = items.some(i => i.name.toLowerCase().includes('concrete'));
        const hasLiner = items.some(i => i.name.toLowerCase().includes('liner'));
        const hasPlumbing = items.some(i => i.name.toLowerCase().includes('plumb') || i.name.toLowerCase().includes('pump'));
        
        // Generate AI recommendations based on project analysis
