    function getStatusClass(status) {
      const statusMap = {
        'Draft': 'draft',
        'Sent': 'sent', 
        'Pending': 'pending',
        'Approved': 'approved',
        'Approved & Signed': 'signed',
        'Job Complete': 'complete'
      };
      return statusMap[status] || 'draft';
