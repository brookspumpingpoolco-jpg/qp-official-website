      const overridePrice = parseFloat(document.getElementById('concreteOverridePriceValue').value) || 0;
      const useOverride = document.getElementById('concreteOverridePrice').checked;
      
      if (useOverride && overridePrice > 0) {
        concreteFinalPrice = overridePrice;
        updateConcreteFinalPriceDisplay();
