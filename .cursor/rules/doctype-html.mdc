    /**
     * Send email with customization
     */
    async function sendEmailWithCustomization() {
      if (!currentEmailData) {
        showError('No invoice data available');
        return;
      }
      
      // Always use Customer details section as source of truth at send time
      var emailEl = document.getElementById('customerEmail');
      var nameEl = document.getElementById('customerName');
      var sendEmail = emailEl ? emailEl.value.trim() : '';
      var sendName = nameEl ? nameEl.value.trim() : '';
      if (sendEmail) {
        currentEmailData.customerEmail = sendEmail;
        console.log('📧 Using customer email from form:', sendEmail);
      }
      if (sendName) currentEmailData.customerName = sendName;
      
      if (!sendEmail || sendEmail.indexOf('@') === -1) {
        showError('Please enter a valid customer email in the Customer details section (Invoice Maker) before sending.');
        if (emailEl) {
          emailEl.focus();
          emailEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
        return;
      }
      
      // Stop auto-save
      if (typeof stopAutoSave === 'function') {
        stopAutoSave();
      }
      
      // Get customization — capture ALL checkbox values NOW, before modal closes
      const customMessage = document.getElementById('customEmailMessage').value;
      const includeReview = document.getElementById('includeReviewRequest').checked;
      const includeSnowRemoval = document.getElementById('includeSnowRemoval').checked;
      const cashPaymentReceived = document.getElementById('cashPaymentReceived').checked;
      const cashAmount = parseFloat(document.getElementById('cashAmount').value) || 0;
      const cashNotes = document.getElementById('cashPaymentNotes').value;
      // Capture Brooks flag immediately while modal is still open
      const sendToBrooksFlag = !!(document.getElementById('sendTextToBrooks') && document.getElementById('sendTextToBrooks').checked);
      const brooksDocType = (currentEmailData && currentEmailData.type) || 'Invoice';
      const brooksCustomerName = (currentEmailData && currentEmailData.customerName) || '';
      const brooksCustomerPhone = (currentEmailData && currentEmailData.customerPhone) || (document.getElementById('customerPhone') ? document.getElementById('customerPhone').value.trim() : '');
      
      // Add customization to data
      currentEmailData.customEmailMessage = customMessage;
      currentEmailData.includeReviewRequest = includeReview;
      // Auto-include snow removal message if project type is Snow Removal OR checkbox is checked
      currentEmailData.includeSnowRemoval = includeSnowRemoval || (currentType === 'Snow Removal');
      // Filter out any invalid attachment URLs
      currentEmailData.attachments = emailAttachments
        .filter(att => att && att.url && typeof att.url === 'string' && att.url.trim() !== '')
        .map(att => att.url.trim());
      currentEmailData.status = 'Sent';
      
      // Add cash/check payment info
      if (cashPaymentReceived && cashAmount > 0) {
        const paymentMethod = document.getElementById('paymentMethod') ? document.getElementById('paymentMethod').value : 'Cash';
        currentEmailData.cashPayment = {
          received: true,
          method: paymentMethod,
          amount: cashAmount,
          notes: cashNotes
        };
      }
      
      // Ensure we're updating existing quote if we have an ID
      if (currentEditingQuoteId) {
        currentEmailData.id = currentEditingQuoteId;
      } else if (currentInvoiceId) {
        currentEmailData.id = currentInvoiceId;
      } else if (currentQuoteId) {
        currentEmailData.id = currentQuoteId;
      }
      
      // CLOSE THE MODAL FIRST, then show loading
      closeEmailEditorModal();
      
      // Small delay to let modal close animation complete
      await new Promise(resolve => setTimeout(resolve, 100));
      
      try {
        // Show loading overlay with custom message
        showLoadingOverlay('Sending invoice...');
        
        // Log request details
        console.log('📤 Sending invoice email request...');
        console.log('📤 API URL:', API_URL);
        console.log('📤 Customer Email:', currentEmailData.customerEmail);
        console.log('📤 Customer Name:', currentEmailData.customerName);
        console.log('📤 Invoice Type:', currentEmailData.type);
        console.log('📤 Invoice ID:', currentEmailData.id || 'New');
        console.log('📤 Processing Fee Enabled:', currentEmailData.addProcessingFee || false);
        console.log('📤 Data being sent:', {
          type: currentEmailData.type,
          customerEmail: currentEmailData.customerEmail,
          customerName: currentEmailData.customerName,
          itemsCount: currentEmailData.items ? JSON.parse(currentEmailData.items).length : 0,
          hasAttachments: emailAttachments.length > 0,
          addProcessingFee: currentEmailData.addProcessingFee
        });
        
        const requestBody = new URLSearchParams({
          action: 'sendInvoiceEstimate',
          data: JSON.stringify(currentEmailData)
        });
        
        console.log('📤 Request body size:', requestBody.toString().length, 'characters');
        
        var lastError = null;
        var response = null;
        var maxTries = 3;
        for (var tryNum = 1; tryNum <= maxTries; tryNum++) {
          try {
            if (tryNum > 1) {
              console.log('📤 Retry ' + tryNum + '/' + maxTries + ' in 2s...');
              await new Promise(function(r) { setTimeout(r, 2000); });
            }
            response = await fetch(API_URL, {
              method: 'POST',
              headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
              body: requestBody
            });
            break;
          } catch (fetchErr) {
            lastError = fetchErr;
            console.warn('📤 Attempt ' + tryNum + ' failed:', fetchErr.message);
            if (tryNum === maxTries) throw fetchErr;
          }
        }
        
        console.log('📥 Response received - Status:', response.status, response.statusText);
        console.log('📥 Response headers:', Object.fromEntries(response.headers.entries()));
        
        // Update loading message
        updateLoadingMessage('Generating PDF and attachments...');
        
        const responseText = await response.text();
        console.log('📥 Raw response text length:', responseText.length, 'characters');
        console.log('📥 Raw response preview:', responseText.substring(0, 500));
        
        let result;
        try {
          result = JSON.parse(responseText);
          console.log('✅ Response parsed successfully');
        } catch (parseError) {
          console.error('❌ Failed to parse response as JSON:', parseError);
          console.error('❌ Response text:', responseText);
          hideLoadingOverlay();
          showError('❌ Server returned invalid response. Check console for details.\n\nResponse: ' + responseText.substring(0, 200));
          return;
        }
        
        // Log the full result for debugging
        console.log('📧 Email send result:', result);
        console.log('📧 Success:', result.success);
        console.log('📧 Email Sent:', result.emailSent);
        console.log('📧 Error:', result.error);
        console.log('📧 Error Type:', result.errorType);
        
        if (result.success) {
          // Check if email was actually sent
          if (result.emailSent === false) {
            // Invoice was saved but email failed
            hideLoadingOverlay();
            const errorMsg = result.error || 'Email failed to send';
            const errorType = result.errorType || 'unknown';
            console.error('❌ Email sending failed:', errorMsg, 'Type:', errorType);
            showError('⚠️ Invoice saved but email failed to send!\n\n' + 
                     'Error: ' + errorMsg + '\n\n' +
                     'The invoice was saved successfully, but the email could not be sent. ' +
                     'Please check the customer email address and try sending again, or send manually.',
                     { error: errorMsg, errorType: errorType, result: result });
            // Clear email data on error
            currentEmailData = null;
            return;
          }
          
          // Update tracking IDs
          if (result.id) {
            currentEditingQuoteId = result.id;
            currentInvoiceId = result.id;
            currentQuoteId = result.id;
          }

          // Send link to Brooks if checkbox was checked (value captured before modal closed)
          if (sendToBrooksFlag) {
            const brooksShareLink = result.shareLink || '';
            const brooksDocId = result.id || '';
            console.log('📱 Sending Brooks notification — link:', brooksShareLink, 'id:', brooksDocId);
            try {
              const brooksBody = new URLSearchParams({
                action: 'notifyBrooks',
                shareLink: brooksShareLink,
                documentId: brooksDocId,
                documentType: brooksDocType,
                customerName: brooksCustomerName,
                customerPhone: brooksCustomerPhone
              });
              fetch(API_URL, {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: brooksBody.toString()
              }).then(function(r) { return r.json(); }).then(function(br) {
                if (br && br.success) {
                  console.log('✅ Brooks notification sent successfully');
                } else {
                  console.warn('⚠️ Brooks notification failed:', br && br.error);
                }
              }).catch(function(e) { console.warn('📱 Brooks notify error:', e); });
            } catch(e) { console.warn('Brooks notification error:', e); }
          }
          
          // Show success message on loading overlay
          updateLoadingMessage('✅ Invoice sent successfully!');
          
          setTimeout(() => {
            hideLoadingOverlay();
            const successMsg = '✅ Invoice sent successfully and tracked.\n\n' +
                              'Share link: ' + (result.shareLink || 'N/A') + '\n' +
                              (result.paymentLink ? 'Payment link: ' + result.paymentLink : '');
            showSuccess(successMsg);
            // Clear email data after successful send
            currentEmailData = null;
            emailAttachments = [];
          }, 1500);
          
          // Restart auto-save
          if (typeof startAutoSave === 'function') {
            setTimeout(startAutoSave, 2500);
          }
        } else {
          // Invoice save or send completely failed
          hideLoadingOverlay();
          const errorMsg = result.error || 'Unknown error';
          const errorType = result.errorType || 'general';
          console.error('❌ Invoice send failed:', errorMsg, 'Type:', errorType);
          console.error('❌ Full error result:', JSON.stringify(result, null, 2));
          
          let displayError = 'Failed to send invoice: ' + errorMsg;
          if (errorType === 'email') {
            displayError = '❌ Email sending failed!\n\n' +
                          'Error: ' + errorMsg + '\n\n' +
                          'Please check:\n' +
                          '• Customer email address is valid\n' +
                          '• You have email sending permissions\n' +
                          '• Google Apps Script email quota not exceeded\n\n' +
                          '📋 Full error details logged to browser console (F12)';
          } else {
            displayError = '❌ Failed to send invoice!\n\n' +
                          'Error: ' + errorMsg + '\n\n' +
                          '📋 Full error details logged to browser console (F12)';
          }
          
          showError(displayError, { error: errorMsg, errorType: errorType, result: result });
          // Clear email data on error too
          currentEmailData = null;
        }
      } catch (error) {
        console.error('❌ Exception during email send:', error);
        console.error('❌ Error stack:', error.stack);
        console.error('❌ Error name:', error.name);
        console.error('❌ Error message:', error.message);
        hideLoadingOverlay();
        var isNetworkError = !error.message || error.message === 'Failed to fetch' || error.message.indexOf('fetch') !== -1;
        var msg = isNetworkError
          ? '❌ Connection failed (network error or server not reachable).\n\n' +
            '• Check your internet connection and try again.\n' +
            '• If you use the app on Netlify, ensure the Google Apps Script web app is deployed with "Who has access: Anyone".\n' +
            '• Try again in a few seconds (transient failures were retried automatically).'
          : '❌ Error sending invoice!\n\nError: ' + error.message + '\n\n📋 See browser console (F12) for details.';
        showError(msg, {
          error: error.message,
          errorName: error.name,
          errorStack: error.stack,
          errorType: 'exception'
        });
        // Clear email data on exception
        currentEmailData = null;
      } finally {
        // Restart auto-save on error
        if (typeof startAutoSave === 'function') {
          setTimeout(startAutoSave, 1000);
        }
      }
    }
    
