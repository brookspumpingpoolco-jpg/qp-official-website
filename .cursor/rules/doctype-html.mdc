     */
    function openQuickInvoiceModal(estimateId) {
      currentProjectEstimateId = estimateId;
      
      // Set default dates
      const today = new Date().toISOString().split('T')[0];
      const dueDate = new Date(Date.now() + 30 * 24 * 60 * 60 * 1000).toISOString().split('T')[0];
      
      document.getElementById('quickInvoiceDate').value = today;
      document.getElementById('quickInvoiceDueDate').value = dueDate;
      document.getElementById('quickInvoiceDescription').value = '';
      document.getElementById('quickInvoiceNotes').value = '';
      document.getElementById('quickInvoiceNumber').value = 'INV-' + Date.now();
      
      document.getElementById('quickInvoiceModal').style.display = 'flex';
    }
    
    /**
     * Close quick invoice modal
     */
    function closeQuickInvoiceModal() {
      document.getElementById('quickInvoiceModal').style.display = 'none';
      currentProjectEstimateId = null;
    }
    
    /**
     * Create quick invoice from project
     */
    async function createQuickInvoice() {
      if (!currentProjectEstimateId) {
        showMessage('error', 'No project selected');
        return;
      }
      
      const invoiceData = {
        invoiceNumber: document.getElementById('quickInvoiceNumber').value,
        date: document.getElementById('quickInvoiceDate').value,
        dueDate: document.getElementById('quickInvoiceDueDate').value,
        description: document.getElementById('quickInvoiceDescription').value,
        notes: document.getElementById('quickInvoiceNotes').value
      };
      
      try {
        showMessage('info', 'Creating invoice...');
        
        const response = await fetch(SCRIPT_URL, {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: new URLSearchParams({
            action: 'createInvoiceFromEstimate',
            estimateId: currentProjectEstimateId,
            invoiceData: JSON.stringify(invoiceData)
          })
        });
        
        const result = await response.json();
        
        if (result.success) {
          showMessage('success', 'Invoice created successfully!');
          closeQuickInvoiceModal();
          closeProjectDetailModal();
          
          // Reload projects
          await loadApprovedProjects();
          
          // Switch to create tab and load the invoice
          switchTab('create');
          if (result.id) {
            loadInvoiceEstimate(result.id);
          }
        } else {
          showMessage('error', 'Error creating invoice: ' + (result.error || 'Unknown error'));
        }
      } catch (error) {
        console.error('Error creating invoice:', error);
        showMessage('error', 'Error creating invoice: ' + error.message);
      }
    }
    
