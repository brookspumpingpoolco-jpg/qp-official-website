    function addItemFromPriceBook(code, name, price, category, unit, description, imageUrl) {
      const item = {
        id: Date.now(),
        code: code,
        name: name,
        price: parseFloat(price) || 0,
        quantity: 1,
        category: category,
        unit: unit,
        description: description || '',
        imageUrl: imageUrl || '',
        fromPriceBook: true,
        actualCost: 0,
        cost: 0,
        isStock: false,
        onHand: false
      };
      lineItems.push(item);
      closeAddItemModal();
      renderItems();
      calculateTotals();
      
      // Auto-update profit calculation if any items are marked for profit
      if (profitModeItems.size > 0) {
        calculateProfitSilently();
      }
    }

