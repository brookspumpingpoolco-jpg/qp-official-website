    async function applyDiscountCode() {
      const code = document.getElementById('discountCode').value.trim();
      if (!code) {
        showError('Please enter a discount code');
        return;
      }

      // Exclude processing fee from subtotal (it's added after tax and discount)
      const subtotal = lineItems
        .filter(item => !item.isProcessingFee)
        .reduce((sum, item) => sum + (parseFloat(item.quantity || 0) * parseFloat(item.price || 0)), 0);

      try {
        const response = await fetch(API_URL, {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: new URLSearchParams({
            action: 'applyDiscountCode',
            code: code,
            amount: subtotal
          })
        });
        const result = await response.json();
        
        if (result.success) {
          document.getElementById('discount').value = result.discount;
          calculateTotals();
          showSuccess(`Discount applied: $${result.discount.toFixed(2)}`);
        } else {
          showError(result.error || 'Invalid discount code');
        }
      } catch (error) {
        showError('Error applying discount: ' + error.message);
      }
    }

