    async function sendDailyUpdate() {
      openDailyUpdateEmailEditor();
    }

    /**
     * Load pending actions for Invoices tab
     */
    async function loadPendingActions() {
      try {
        showLoading(true);
        
        // Use fetch instead of google.script.run (works in all environments)
        let result;
        if (typeof google !== 'undefined' && google.script && google.script.run) {
          // If in Apps Script environment, use google.script.run
          result = await new Promise((resolve, reject) => {
          google.script.run
            .withSuccessHandler(resolve)
            .withFailureHandler(reject)
            .getPendingActions();
        });
        } else {
          // Use fetch API (works in all environments)
          const response = await fetch(API_URL, {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: new URLSearchParams({
              action: 'getPendingActions',
              email: userEmail || ''
            })
          });
          result = await response.json();
        }
        
        if (result && result.success) {
          displayPendingSignatures(result.pendingSignatures || []);
        } else {
          showError('Failed to load pending actions: ' + (result.error || 'Unknown error'));
        }
      } catch (error) {
        console.error('Error loading pending actions:', error);
        showError('Error loading pending actions: ' + error.toString());
      } finally {
        showLoading(false);
      }
    }

    /**
     * Display pending signatures
     */
    function displayPendingSignatures(signatures) {
      const container = document.getElementById('pendingSignaturesList');
      const countEl = document.getElementById('pendingSignaturesCount');
      const section = document.getElementById('pendingSignaturesSection');
      
      if (countEl) countEl.textContent = signatures.length;
      
      // Always show the section, even if empty
      if (section) section.style.display = 'block';
      
      if (signatures.length === 0) {
        container.innerHTML = '<p style="text-align: center; color: #6b7280; padding: 20px;">No estimates awaiting your signature</p>';
        return;
      }
      
      let html = '';
      signatures.forEach(sig => {
        const isContract = sig.source === 'contract';
        const escapedName = (sig.customerName || '').replace(/'/g, "\\'");
        const signButton = isContract
          ? `<button class="btn btn-primary" onclick="openSignContractModal('${sig.id}')">
               <i class="fas fa-signature"></i> Sign Estimate
             </button>`
          : `<button class="btn btn-primary" onclick="openAdminSignatureModal('${sig.id}', '${escapedName}')">
               <i class="fas fa-signature"></i> Sign Estimate
             </button>
             <button class="btn btn-secondary" onclick="openUploadContractImageModal('${sig.id}', '${escapedName}')">
               <i class="fas fa-upload"></i> Upload Image
             </button>`;
        html += `
          <div class="card" style="margin-bottom: 15px; border-left: 4px solid #f59e0b;">
            <div style="display: flex; justify-content: space-between; align-items: start;">
              <div style="flex: 1;">
                <h4 style="margin: 0 0 8px 0; color: #111827;">${sig.customerName}</h4>
                <p style="margin: 0 0 4px 0; color: #6b7280; font-size: 14px;">${sig.customerEmail}</p>
                <p style="margin: 0 0 4px 0; color: #6b7280; font-size: 14px;">Estimate Amount: <strong>$${parseFloat(sig.total || 0).toFixed(2)}</strong></p>
                <p style="margin: 0; color: #6b7280; font-size: 13px;">Customer signed: ${sig.approvalDate ? new Date(sig.approvalDate).toLocaleDateString() : 'N/A'}</p>
              </div>
              <div style="display: flex; gap: 10px;">
                ${signButton}
              </div>
            </div>
          </div>
        `;
      });
      
      container.innerHTML = html;
