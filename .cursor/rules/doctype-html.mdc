      document.getElementById('emailInvoiceDate').textContent = data.date ? new Date(data.date).toLocaleDateString() : new Date().toLocaleDateString();
      document.getElementById('emailDueDate').textContent = data.dueDate ? new Date(data.dueDate).toLocaleDateString() : 'Upon Receipt';
