    function getUserEmail() {
      // Try URL parameter first
      const urlParams = new URLSearchParams(window.location.search);
      let email = urlParams.get('email');
      
      if (email) {
        console.log('📧 Email from URL parameter:', email);
        return email;
      }
      
      // Try localStorage
      email = localStorage.getItem('userEmail') || localStorage.getItem('email');
      if (email) {
        console.log('📧 Email from localStorage:', email);
        return email;
      }
      
      // Try sessionStorage
      email = sessionStorage.getItem('userEmail') || sessionStorage.getItem('email');
      if (email) {
        console.log('📧 Email from sessionStorage:', email);
        return email;
      }
      
      // Try window.serverUserData (if set by parent)
      if (window.serverUserData && window.serverUserData.email) {
        console.log('📧 Email from window.serverUserData:', window.serverUserData.email);
        return window.serverUserData.email;
      }
      
      // Try postMessage from parent window (for iframe scenarios)
      if (window.parent && window.parent !== window) {
        try {
          window.parent.postMessage({ type: 'requestEmail' }, '*');
        } catch (e) {
          console.log('Could not request email from parent:', e);
        }
      }
      
      // Normal when opened from Netlify or standalone; company filtering uses admin fallback
      console.log('👤 User email not set (OK when using from Netlify or as admin).');
      return '';
    }

