    function updateDashboardStats() {
      // Calculate metrics
      const totalRevenue = quotes.filter(q => q.status === 'complete' || q.status === 'signed')
                               .reduce((sum, q) => sum + (q.total || 0), 0);
      const activeQuotes = quotes.filter(q => ['draft', 'sent', 'pending', 'approved'].includes(q.status)).length;
      const completedJobs = quotes.filter(q => q.status === 'complete').length;
      const sentQuotes = quotes.filter(q => ['sent', 'pending', 'approved', 'signed', 'complete'].length);
      const winRate = sentQuotes.length > 0 ? Math.round((quotes.filter(q => ['approved', 'signed', 'complete'].includes(q.status)).length / sentQuotes.length) * 100) : 0;
      
      // Update dashboard display
      document.getElementById('totalRevenue').textContent = '$' + totalRevenue.toLocaleString('en-US', {
        minimumFractionDigits: 2,
        maximumFractionDigits: 2
      });
      document.getElementById('activeQuotes').textContent = activeQuotes;
      document.getElementById('completedJobs').textContent = completedJobs;
      document.getElementById('winRate').textContent = winRate + '%';
      
      // Update global dashboard data
      dashboardData = { totalRevenue, activeQuotes, completedJobs, winRate };
    }
    
    function renderQuotesList() {
      const container = document.getElementById('quotesContainer');
      if (!container) return;
      
      if (quotes.length === 0) {
        container.innerHTML = [
          '<div class="empty-state">',
          '<i class="fas fa-file-invoice"></i>',
          '<h3>No quotes yet</h3>',
          '<p>Create your first quote to get started with quote management.</p>',
          '</div>'
        ].join('');
        return;
      }
      
      const filteredQuotes = getFilteredQuotes();
      
      if (filteredQuotes.length === 0) {
        container.innerHTML = [
          '<div class="empty-state">',
          '<i class="fas fa-search"></i>',
          '<h3>No matches found</h3>',
          '<p>Try adjusting your filters to see more quotes.</p>',
          '</div>'
        ].join('');
        return;
      }
      
      container.innerHTML = filteredQuotes.map(quote => createQuoteCard(quote)).join('');
    }
    
    function createQuoteCard(quote) {
      const formattedDate = new Date(quote.createdAt).toLocaleDateString('en-US', {
        year: 'numeric',
        month: 'short',
        day: 'numeric'
      });
      
      const formattedAmount = '$' + (quote.total || 0).toLocaleString('en-US', {
        minimumFractionDigits: 2,
        maximumFractionDigits: 2
      });
      
      // Use array join to avoid template literal issues in Apps Script
      const cardParts = [
        '<div class="quote-card status-' + escapeHtml(quote.status || 'draft') + '">',
        '<div class="quote-header">',
        '<div>',
        '<div class="quote-id">' + escapeHtml(quote.id || '') + '</div>',
        '<div class="quote-customer">' + escapeHtml(quote.customerName || '') + '</div>',
        '<span class="quote-status-badge status-' + escapeHtml(quote.status || 'draft') + '">' + escapeHtml(quote.status || 'draft') + '</span>',
        '</div>',
        '<div class="quote-amount">' + formattedAmount + '</div>',
        '</div>',
        '<div class="quote-details">',
        '<div class="quote-detail">',
        '<strong>Service:</strong> ' + escapeHtml(getServiceDisplayName(quote.serviceType) || ''),
        '</div>',
        '<div class="quote-detail">',
        '<strong>Date:</strong> ' + escapeHtml(formattedDate || ''),
        '</div>',
        '<div class="quote-detail">',
        '<strong>Phone:</strong> ' + escapeHtml(quote.customerPhone || 'N/A'),
        '</div>',
        '<div class="quote-detail">',
        '<strong>Priority:</strong> ' + escapeHtml(quote.priority || 'Normal'),
        '</div>',
        '</div>',
        '<div class="quote-actions">',
        '<button class="btn btn-secondary btn-sm" onclick="viewQuote(\'' + escapeJS(quote.id) + '\')">',
        '<i class="fas fa-eye"></i> View',
        '</button>',
        '<button class="btn btn-primary btn-sm" onclick="editQuote(\'' + escapeJS(quote.id) + '\')">',
        '<i class="fas fa-edit"></i> Edit',
        '</button>'
      ];
      
      if (quote.status === 'draft') {
        cardParts.push('<button class="btn btn-success btn-sm" onclick="sendQuoteById(\'' + escapeJS(quote.id) + '\')">');
        cardParts.push('<i class="fas fa-paper-plane"></i> Send');
        cardParts.push('</button>');
      }
      
      cardParts.push('<button class="btn btn-secondary btn-sm" onclick="duplicateQuote(\'' + escapeJS(quote.id) + '\')">');
      cardParts.push('<i class="fas fa-copy"></i> Duplicate');
      cardParts.push('</button>');
      cardParts.push('</div>');
      cardParts.push('</div>');
      
      return cardParts.join('');
    }

