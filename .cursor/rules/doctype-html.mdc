    function showSuccess(message) {
      console.log('✅ Success:', message);
      const messages = document.getElementById('messages');
      if (messages) {
        messages.innerHTML = `<div class="success-message" style="position: relative; z-index: 1;">${escapeHtml(message)}</div>`;
        setTimeout(() => {
          if (messages.innerHTML.includes(message)) {
            messages.innerHTML = '';
          }
        }, 5000);
      }
      // Also show as floating notification
      showNotification(message, 'success');
    }

    function showError(message, details = null) {
      console.error('❌ Error:', message);
      if (details) {
        console.error('❌ Error details:', details);
        console.error('❌ Error details (JSON):', JSON.stringify(details, null, 2));
      }
      
      const messages = document.getElementById('messages');
      if (messages) {
        // Keep error messages visible longer (15 seconds) for debugging
        const timeout = 15000;
        let errorHtml = `<div class="error-message" style="position: relative; z-index: 1;">${escapeHtml(message)}</div>`;
        
        // Add details if provided
        if (details) {
          errorHtml += `<div class="error-message" style="margin-top: 8px; font-size: 12px; background: #fef2f2; color: #7f1d1d; position: relative; z-index: 1;">
            <strong>Debug Details:</strong><br>
            <pre style="white-space: pre-wrap; font-size: 11px; margin: 4px 0;">${escapeHtml(JSON.stringify(details, null, 2))}</pre>
            <small>Check browser console (F12) for more details</small>
          </div>`;
        }
        
        messages.innerHTML = errorHtml;
        setTimeout(() => {
          if (messages.innerHTML.includes(message)) {
            messages.innerHTML = '';
          }
        }, timeout);
      }
      
      // Always show as floating notification (appears above everything)
      let errorMessage = message;
      if (details) {
        errorMessage += ' (Check console for details)';
      }
      showNotification(errorMessage, 'error');
    }

