        showError('Error deleting expense: ' + error.toString());
      } finally {
        showLoading(false);
      }
    }

    /**
     * Submit expense
     */
    async function submitExpense(event) {
      event.preventDefault();
      
      // Check if this is an update (has expense ID)
      const expenseIdInput = document.getElementById('newExpenseId');
      const isUpdate = expenseIdInput && expenseIdInput.value;
      
      const expenseData = {
        projectId: document.getElementById('newExpenseProject').value,
        category: document.getElementById('newExpenseCategory').value,
        description: document.getElementById('newExpenseDescription').value,
        amount: parseFloat(document.getElementById('newExpenseAmount').value),
        paidFromAccount: document.getElementById('newExpensePaidFrom').value,
        notes: document.getElementById('newExpenseNotes').value,
        date: document.getElementById('newExpenseDate').value || new Date().toISOString()
      };
      
      // Add expense ID if updating
      if (isUpdate) {
        expenseData.expenseId = expenseIdInput.value;
      }
      
      try {
        showLoading(true);
        
        const action = isUpdate ? 'updateExpense' : 'addExpense';
        // Add optional receipt fields so backend gets them
        var receiptVendor = document.getElementById('newExpenseVendor');
        var receiptInv = document.getElementById('newExpenseInvoiceNumber');
        var receiptUrl = document.getElementById('newExpenseReceiptUrl');
        if (receiptVendor && receiptVendor.value) expenseData.vendor = receiptVendor.value;
        if (receiptInv && receiptInv.value) expenseData.invoiceNumber = receiptInv.value;
        if (receiptUrl && receiptUrl.value) expenseData.receiptUrl = receiptUrl.value;
        var payload = {
          action: action,
          data: JSON.stringify(expenseData)
        };

        var controller = new AbortController();
        var timeoutId = setTimeout(function() { controller.abort(); }, 45000);
        
        var response = await fetch(API_URL, {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: new URLSearchParams(payload),
          signal: controller.signal
        });
        clearTimeout(timeoutId);
        
        var contentType = response.headers.get('content-type') || '';
        if (contentType.indexOf('application/json') === -1) {
          var text = await response.text();
          console.error('Non-JSON response:', response.status, text.substring(0, 300));
          showError('Server returned an error page (not JSON). Make sure the Google Apps Script web app is deployed with "Who has access: Anyone" and try again.');
          return;
        }
        
        var result = await response.json();
        
        if (result && result.success) {
          // Also create a Shopping List entry if checkbox is checked
          const shopChk = document.getElementById('alsoAddToShoppingList');
          if (shopChk && shopChk.checked) {
            acctPost('upsertShoppingItem', {
              name:      expenseData.description,
              estCost:   expenseData.amount,
              category:  expenseData.category || 'General',
              priority:  document.getElementById('shopPriorityFromExpense')?.value || 'Normal',
              dueBy:     document.getElementById('shopDueByFromExpense')?.value || '',
              projectId: expenseData.projectId,
              status:    'Planned',
              notes:     'Added from expense: ' + expenseData.description
            }).catch(() => {}); // non-blocking
          }
          showSuccess(isUpdate ? 'Expense updated successfully!' : 'Expense added successfully!');
          closeAddExpenseModal();
          
          if (document.getElementById('expenseProjectFilter').value === expenseData.projectId) {
            loadProjectExpenses();
          }
          // Refresh project detail PO/shopping section if open
          if (typeof refreshProjectDetailSections === 'function') refreshProjectDetailSections(expenseData.projectId);
        } else {
          showError('Failed to ' + (isUpdate ? 'update' : 'add') + ' expense: ' + (result.error || 'Unknown error'));
        }
      } catch (error) {
        console.error('Error ' + (isUpdate ? 'updating' : 'adding') + ' expense:', error);
        var msg = error.name === 'AbortError'
          ? 'Request timed out. Check your connection and that the web app URL is correct, then try again.'
          : 'Error ' + (isUpdate ? 'updating' : 'adding') + ' expense: ' + (error.message || error.toString());
        if (error.message && error.message.indexOf('fetch') !== -1) {
          msg = 'Connection failed (ERR_CONNECTION_CLOSED or network error). Deploy the Google Apps Script web app with "Who has access: Anyone" and ensure the script URL in this page matches the deployed URL.';
        }
        showError(msg);
      } finally {
        showLoading(false);
      }
    }

    /**
     * Clear expense filters and refresh the list
     */
    function clearExpenseFilters() {
      const projectEl = document.getElementById('expenseProjectFilter');
      const categoryEl = document.getElementById('expenseCategoryFilter');
      const startEl = document.getElementById('expenseStartDate');
      const endEl = document.getElementById('expenseEndDate');
      const searchEl = document.getElementById('expenseSearch');
      if (projectEl) projectEl.value = '';
      if (categoryEl) categoryEl.value = '';
