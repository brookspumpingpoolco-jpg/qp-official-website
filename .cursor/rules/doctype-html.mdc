    /**
     * Send daily update via email editor
     */
    async function sendDailyUpdateFromEditor() {
      // Get project ID from the displayed element (set when modal opens)
      const projectIdElement = document.getElementById('dailyUpdateEmailProjectId');
      const projectId = projectIdElement ? projectIdElement.textContent.trim() : document.getElementById('dailyUpdateProject').value;
      
      if (!projectId) {
        showError('Project ID not found. Please close and reopen the email editor.');
        return;
      }
      
      // Get work date from the daily update form or use today
      const workDateInput = document.getElementById('dailyWorkDate');
      const workDate = workDateInput ? (workDateInput.value || new Date().toISOString().split('T')[0]) : new Date().toISOString().split('T')[0];
      
      // Get the update message from TinyMCE editor (this is the body text)
      const tinymceEditor = tinymce.get('dailyUpdateEmailMessage');
      const updateMessage = tinymceEditor ? tinymceEditor.getContent({ format: 'text' }).trim() : '';
      
      // Get opening message (for fancy box) - only if first visit is checked
      let openingMessage = '';
      const isFirstVisit = document.getElementById('dailyUpdateFirstVisit').checked;
      if (isFirstVisit) {
        const firstVisitCustom = document.getElementById('firstVisitCustomMessage').value.trim();
        const customTextarea = document.getElementById('firstVisitCustomMessage');
        
        // If custom message is visible and filled, use it
        if (customTextarea && customTextarea.style.display !== 'none' && firstVisitCustom) {
          openingMessage = firstVisitCustom;
        } else {
          // Use the stored opening message from selection
          openingMessage = currentOpeningMessage || '';
        }
      }
      
      // For backward compatibility, combine for customMessage parameter
      // But we'll also send openingMessage and updateMessage separately
      const customMessage = updateMessage; // This is what goes in the body
      
      if (!customMessage) {
        showError('Please enter a message');
        return;
      }
      
      try {
        showLoading(true);
        
        // Prepare images for upload
        let imagesData = [];
        if (dailyUpdateImages && dailyUpdateImages.length > 0) {
          // Convert images to base64 for sending
          for (let img of dailyUpdateImages) {
            imagesData.push({
              data: img.dataUrl,
              caption: img.caption || '',
              filename: img.file.name
            });
          }
        }
        
        const response = await fetch(API_URL, {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: new URLSearchParams({
            action: 'sendDailyUpdate',
            projectId: projectId,
            summary: updateMessage, // Update message (body text)
            openingMessage: openingMessage, // Opening message (for fancy box)
            photoUrls: JSON.stringify([]),
            images: JSON.stringify(imagesData),
            workDate: workDate
          })
        });
        
        if (!response.ok) {
          throw new Error(`HTTP error! status: ${response.status}`);
        }
        
        const result = await response.json();
        
        if (result && result.success) {
          showSuccess('Daily update sent successfully!');
          
          // Close modal
          closeDailyUpdateEmailEditor();
          
          // Clear form
          document.getElementById('dailyWorkNotes').value = '';
          document.getElementById('dailyWorkDate').value = '';
          document.getElementById('enhancedPreview').style.display = 'none';
          currentAiEnhancedText = '';
          currentOriginalText = '';
          dailyUpdateImages = [];
          document.getElementById('dailyUpdateImagesContainer').innerHTML = '';
          document.getElementById('dailyUpdateImageInput').value = '';
          selectWorkDate('today');
        } else {
          const errorMsg = result?.error || result?.message || 'Unknown error';
          console.error('Send update error:', result);
          showError('Failed to send update: ' + errorMsg);
        }
      } catch (error) {
        console.error('Error sending update:', error);
        showError('Error sending update: ' + (error.message || error.toString()));
      } finally {
        showLoading(false);
      }
    }

