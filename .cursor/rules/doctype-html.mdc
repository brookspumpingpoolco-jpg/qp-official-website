    function addPaymentRecord() {
      const amount = parseFloat(document.getElementById('paymentAmount').value || 0);
      const method = document.getElementById('paymentMethod').value;
      const date = document.getElementById('paymentDate').value;
      const milestone = document.getElementById('paymentMilestone').value;
      const notes = document.getElementById('paymentNotes').value;

      if (amount <= 0) {
        alert('Please enter a valid payment amount');
        return;
      }

      if (!date) {
        alert('Please select a payment date');
        return;
      }

      // Create payment record
      const payment = {
        date: date,
        amount: amount,
        method: method,
        milestone: milestone || null,
        notes: notes,
        transactionId: 'PAY-' + Date.now() + '-' + Math.random().toString(36).substring(7),
        status: 'Completed'
      };

      paymentHistory.push(payment);

      // Mark milestone as paid if selected
      if (milestone) {
        const milestoneObj = paymentScheduleMilestones.find(m => m.name === milestone);
        if (milestoneObj) {
          milestoneObj.isPaid = true;
        }
      }

      // Clear form
      document.getElementById('paymentAmount').value = '';
      document.getElementById('paymentMethod').value = 'Cash';
      document.getElementById('paymentDate').value = '';
      document.getElementById('paymentMilestone').value = '';
      document.getElementById('paymentNotes').value = '';

      // Update displays
      displayPaymentHistory();
      updatePaymentSummary();
      renderPaymentScheduleBuilder();

      alert('Payment recorded successfully!');
    }

