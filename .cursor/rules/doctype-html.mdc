    async function sendToCustomer() {
      if (!validateForm()) return;
      
      // Stop auto-save to prevent duplicate saves
      if (typeof stopAutoSave === 'function') {
        stopAutoSave();
      }
      
      // Check for profit tracking - MUST be cleared before sending
      if (profitModeActive || profitModeItems.size > 0) {
        showError(
          '🚫 CANNOT SEND QUOTE - PROFIT TRACKING ACTIVE\n\n' +
          `You have ${profitModeItems.size} item(s) marked for profit tracking. ` +
          'You must clear all profit markers before sending this quote to customers.\n\n' +
          'Click "Clear All Profit Markers" in the red warning banner above.'
        );
        
        // Scroll to top to show the warning
        window.scrollTo({ top: 0, behavior: 'smooth' });
        // Restart auto-save if cancelled
        if (typeof startAutoSave === 'function') {
          setTimeout(startAutoSave, 1000);
        }
        return;
      }
      
      // Check for glass filter media
      const hasGlassFilterMedia = lineItems.some(item => 
        item.name && (
          (item.name.toLowerCase().includes('glass') && item.name.toLowerCase().includes('filter')) ||
          item.name.toLowerCase().includes('filter media') ||
          item.name.toLowerCase().includes('glass media') ||
          (item.description && (
            item.description.toLowerCase().includes('glass') && item.description.toLowerCase().includes('filter')
          ))
        )
      );
      
      if (!hasGlassFilterMedia) {
        const confirmed = confirm(
          `⚠️ REMINDER: Glass Filter Media not found in items.\n\n` +
          `Have you included glass filter media in your estimate?\n\n` +
          `Click OK to continue, or Cancel to go back and add it.`
        );
        if (!confirmed) return;
      }
      
      // Check for filter and pump (optional check)
      const hasFilter = lineItems.some(item => 
        item.name && (
          item.name.toLowerCase().includes('filter') || 
          item.code && item.code.toLowerCase().includes('filter')
        )
      );
      const hasPump = lineItems.some(item => 
        item.name && (
          item.name.toLowerCase().includes('pump') || 
          item.code && item.code.toLowerCase().includes('pump')
        )
      );
      
      if (!hasFilter || !hasPump) {
        let missingItems = [];
        if (!hasFilter) missingItems.push('Filter');
        if (!hasPump) missingItems.push('Pump');
        
        const confirmed = confirm(
          `⚠️ Warning: You haven't added ${missingItems.join(' and ')} to this estimate.\n\n` +
          `For new pool builds, filters and pumps are typically required.\n\n` +
          `Do you want to continue anyway?`
        );
        if (!confirmed) return;
      }
      
      const data = getFormData();
      data.status = 'Sent';
      
      try {
        // If recurring, create recurring invoice first
        if (data.recurring) {
          const recurringData = {
            name: data.recurring.name,
            customerEmail: data.customerEmail,
            frequency: data.recurring.frequency,
            items: data.items,
            notes: data.notes,
            terms: data.terms,
            taxRate: data.taxRate
          };
          
          const recurringResponse = await fetch(API_URL, {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: new URLSearchParams({
              action: 'createRecurringInvoice',
              data: JSON.stringify(recurringData)
            })
          });
          const recurringResult = await recurringResponse.json();
          
          if (!recurringResult.success) {
            showError('Failed to create recurring invoice: ' + (recurringResult.error || 'Unknown error'));
            return;
          }
        }
        
        // Ensure we're updating existing quote if we have an ID
        if (currentEditingQuoteId) {
          data.id = currentEditingQuoteId;
        } else if (currentInvoiceId) {
          data.id = currentInvoiceId;
        } else if (currentQuoteId) {
          data.id = currentQuoteId;
        }
        
        const response = await fetch(API_URL, {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: new URLSearchParams({
            action: 'sendInvoiceEstimate',
            data: JSON.stringify(data)
          })
        });
        const result = await response.json();
        
        if (result.success) {
          // Update tracking IDs from result
          if (result.id) {
            currentEditingQuoteId = result.id;
            currentInvoiceId = result.id;
            currentQuoteId = result.id;
          }
          
          showSuccess('Sent successfully! Share link: ' + (result.shareLink || 'N/A'));
          if (data.recurring) {
            showSuccess('Recurring invoice schedule created.');
          }
          
          // Restart auto-save after successful send
          if (typeof startAutoSave === 'function') {
            setTimeout(startAutoSave, 2000);
          }
        } else {
          showError('Failed to send: ' + (result.error || 'Unknown error'));
          // Restart auto-save on error
          if (typeof startAutoSave === 'function') {
            setTimeout(startAutoSave, 1000);
          }
        }
      } catch (error) {
        showError('Error sending: ' + error.message);
        // Restart auto-save on error
        if (typeof startAutoSave === 'function') {
          setTimeout(startAutoSave, 1000);
        }
      }
    }

    function getFormData() {
