    function updateDashboardStats() {
      try {
      const total = allQuotes.length;
      const sent = allQuotes.filter(q => q.status === 'Sent').length;
      const pending = allQuotes.filter(q => q.status === 'Pending').length;
      const approved = allQuotes.filter(q => q.status === 'Approved' || q.status === 'Approved & Signed').length;
      const totalValue = allQuotes.reduce((sum, q) => sum + (parseFloat(q.totalAmount) || 0), 0);

        const totalQuotesEl = document.getElementById('totalQuotes');
        const sentQuotesEl = document.getElementById('sentQuotes');
        const pendingQuotesEl = document.getElementById('pendingQuotes');
        const approvedQuotesEl = document.getElementById('approvedQuotes');
        const totalValueEl = document.getElementById('totalValue');

        if (totalQuotesEl) totalQuotesEl.textContent = total;
        if (sentQuotesEl) sentQuotesEl.textContent = sent;
        if (pendingQuotesEl) pendingQuotesEl.textContent = pending;
        if (approvedQuotesEl) approvedQuotesEl.textContent = approved;
        if (totalValueEl) totalValueEl.textContent = '$' + formatCurrency(totalValue);
