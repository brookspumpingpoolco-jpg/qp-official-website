              </div>
              
              <!-- Submit Button -->
              <div style="display: flex; gap: 10px; margin-top: 30px;">
                <button type="button" class="btn btn-success" onclick="submitManualPayment()" style="flex: 1; padding: 14px;">
                  <i class="fas fa-check-circle"></i> Record Payment
                </button>
                <button type="button" class="btn btn-secondary" onclick="closeManualPaymentModal()" style="flex: 1; padding: 14px;">
                  Cancel
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>
