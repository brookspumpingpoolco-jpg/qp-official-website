    /**
     * Load invoices with filters
     */
    async function loadInvoices() {
      try {
        showLoading(true);
        
        const statusFilter = document.getElementById('invoiceStatusFilter')?.value || 'all';
        const timePeriod = document.getElementById('invoiceTimePeriodFilter')?.value || 'all';
        
        // Load invoices and customers in parallel
        const [invoicesResponse, customersResponse] = await Promise.all([
          fetch(API_URL, {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: new URLSearchParams({
              action: 'getAllInvoicesWithFilters',
              statusFilter: statusFilter,
              timePeriod: timePeriod,
              email: userEmail || ''
            })
          }),
          fetch(API_URL, {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: new URLSearchParams({
              action: 'getCustomers'
            })
          })
        ]);
        
        const invoicesResult = await invoicesResponse.json();
        const customersResult = await customersResponse.json();
        
        // Create customer lookup map (ID -> name)
        const customerMap = {};
        if (customersResult && customersResult.success && customersResult.customers) {
          customersResult.customers.forEach(customer => {
            if (customer.id && customer.name) {
              customerMap[customer.id] = customer.name;
            }
          });
        }
        
        if (invoicesResult && invoicesResult.success) {
          displayInvoicesTable(invoicesResult.invoices || [], customerMap);
          if (document.getElementById('totalInvoicesCount')) {
            document.getElementById('totalInvoicesCount').textContent = invoicesResult.invoices.length;
          }
        } else {
          showError('Failed to load invoices: ' + (invoicesResult.error || 'Unknown error'));
        }
        
        // Also load pending actions
        await loadPendingActions();
      } catch (error) {
        console.error('Error loading invoices:', error);
        // Don't show error if invoices load anyway - just log it
        console.log('Note: Invoice loading had an error but may have succeeded');
      } finally {
        showLoading(false);
      }
    }

    /**
     * Display invoices in table
     */
    function displayInvoicesTable(invoices, customerMap = {}) {
      const tbody = document.getElementById('invoicesTableBody');
      
      if (!tbody) return;
      
      if (invoices.length === 0) {
        tbody.innerHTML = '<tr><td colspan="9" style="text-align: center; padding: 40px; color: #6b7280;">No invoices found matching your filters</td></tr>';
        return;
      }
      
      let html = '';
      invoices.forEach(inv => {
        const statusColor = inv.status === 'Signed' ? '#10b981' : 
                           inv.status === 'Declined' ? '#ef4444' : 
                           inv.status === 'Sent' ? '#3b82f6' : 
                           inv.status === 'Paid' ? '#10b981' : '#6b7280';
        
        // Calculate payment info
        const totalAmount = parseFloat(inv.totalAmount || inv.total || 0);
        const totalPaid = parseFloat(inv.totalPaid || inv.remainingBalance ? (totalAmount - parseFloat(inv.remainingBalance || 0)) : 0);
        const balance = parseFloat(inv.remainingBalance || (totalAmount - totalPaid));
        const isPaid = balance <= 0.01 && totalPaid > 0;
        const isInvoice = inv.type === 'Invoice';
        const isEstimate = inv.type === 'Estimate' || !isInvoice;
        const hasProject = inv.projectId || inv.project_id;
        
        // Highlight paid invoices in green
        const rowBgColor = isPaid && isInvoice ? '#f0fdf4' : 'transparent';
        const rowBorderColor = isPaid && isInvoice ? '#10b981' : '#e5e7eb';
        
        // Get the correct invoice ID - prioritize invoiceNumber, then quoteNumber, then id
        const displayInvoiceId = inv.invoiceNumber || inv.quoteNumber || inv.id || 'N/A';
        
        // Get customer name - resolve customer ID to actual name if needed
        let displayCustomerName = inv.customerName || 'N/A';
        // If customerName looks like a customer ID (starts with CUST-), try to resolve it
        if (displayCustomerName && displayCustomerName.startsWith('CUST-') && customerMap[displayCustomerName]) {
          displayCustomerName = customerMap[displayCustomerName];
        }
        
        html += `
          <tr style="border-bottom: 2px solid ${rowBorderColor}; background: ${rowBgColor};">
            <td style="padding: 12px;">
              <strong style="color: #111827;">${escapeHtml(displayInvoiceId)}</strong>
            </td>
            <td style="padding: 12px;">
              <span style="padding: 4px 8px; border-radius: 4px; font-size: 12px; font-weight: 600; 
                           background: ${inv.type === 'Invoice' ? '#dbeafe' : '#fef3c7'}; 
                           color: ${inv.type === 'Invoice' ? '#1e40af' : '#92400e'};">
                ${inv.type}
              </span>
            </td>
            <td style="padding: 12px;">
              <div style="font-weight: 600; color: #111827;">${escapeHtml(displayCustomerName)}</div>
              <div style="font-size: 12px; color: #6b7280;">${escapeHtml(inv.customerEmail || 'N/A')}</div>
            </td>
            <td style="padding: 12px;">
              <span style="padding: 4px 8px; border-radius: 4px; font-size: 12px; font-weight: 600; 
                           background: ${statusColor}20; color: ${statusColor};">
                ${inv.status}
              </span>
            </td>
            <td style="padding: 12px; color: #6b7280;">
              ${inv.date ? new Date(inv.date).toLocaleDateString() : 'N/A'}
            </td>
            <td style="padding: 12px; text-align: right; font-weight: 600; color: #111827;">
              $${totalAmount.toLocaleString('en-US', {minimumFractionDigits: 2, maximumFractionDigits: 2})}
            </td>
            <td style="padding: 12px; text-align: right; font-weight: 600; color: ${totalPaid > 0 ? '#10b981' : '#6b7280'};">
              $${totalPaid.toLocaleString('en-US', {minimumFractionDigits: 2, maximumFractionDigits: 2})}
            </td>
            <td style="padding: 12px; text-align: right; font-weight: 600; color: ${balance > 0 ? '#ef4444' : '#10b981'};">
              $${balance.toLocaleString('en-US', {minimumFractionDigits: 2, maximumFractionDigits: 2})}
            </td>
            <td style="padding: 12px; text-align: center;">
              <div style="display: flex; gap: 6px; justify-content: center; flex-wrap: wrap;">
                <button class="btn btn-secondary" onclick="viewInvoice('${inv.id}')" style="padding: 6px 12px; font-size: 12px;">
                  <i class="fas fa-eye"></i> View
                </button>
                ${isInvoice ? `
                  <button class="btn btn-info" onclick="openReportPaymentModal('${String(inv.id).replace(/'/g, "\\'")}', '${String(inv.customerEmail || '').replace(/'/g, "\\'")}', '${String(inv.customerName || '').replace(/'/g, "\\'")}', ${totalAmount}, ${balance})" style="padding: 6px 12px; font-size: 12px;" title="Report Cash/Check Payment">
                    <i class="fas fa-money-bill"></i> Report Payment
                  </button>
                  ${!isPaid ? `
                    <button class="btn btn-success" onclick="markInvoiceAsPaid('${String(inv.id).replace(/'/g, "\\'")}')" style="padding: 6px 12px; font-size: 12px;" title="Mark as Paid">
                      <i class="fas fa-check-circle"></i> Mark Paid
                    </button>
                  ` : ''}
                  <button class="btn btn-danger" onclick="deleteInvoice('${String(inv.id).replace(/'/g, "\\'")}', '${String(inv.number || inv.id).replace(/'/g, "\\'")}')" style="padding: 6px 12px; font-size: 12px;" title="Delete Invoice">
                    <i class="fas fa-trash"></i> Delete
                  </button>
                ` : ''}
                ${!hasProject ? `
                  <button class="btn btn-primary" onclick="convertEstimateToProject('${String(inv.id).replace(/'/g, "\\'")}', '${String(inv.number || inv.id).replace(/'/g, "\\'")}')" style="padding: 6px 12px; font-size: 12px; background: linear-gradient(135deg, #8b5cf6 0%, #7c3aed 100%);" title="Convert ${inv.type || 'Invoice/Estimate'} to Project">
                    <i class="fas fa-project-diagram"></i> Convert to Project
                  </button>
                ` : `
                  <button class="btn btn-secondary" onclick="viewProject('${String(hasProject).replace(/'/g, "\\'")}')" style="padding: 6px 12px; font-size: 12px;" title="View Project">
                    <i class="fas fa-project-diagram"></i> View Project
                  </button>
                `}
                <button class="btn btn-success" onclick="sendFullInvoiceEstimate('${inv.id}')" style="padding: 6px 12px; font-size: 12px;" title="Send full ${inv.type || 'Invoice'} with PDF">
                  <i class="fas fa-file-pdf"></i> Send
                </button>
                ${isInvoice ? `
                  <button class="btn btn-primary" onclick="openSendPaymentLinkModal('${String(inv.id).replace(/'/g, "\\'")}', '${String(inv.customerEmail || '').replace(/'/g, "\\'")}', '${String(inv.customerName || '').replace(/'/g, "\\'")}', ${totalAmount})" style="padding: 6px 12px; font-size: 12px;" title="Send payment link only">
                    <i class="fas fa-link"></i> Payment Link
                  </button>
                ` : ''}
              </div>
            </td>
          </tr>
        `;
      });
      
      tbody.innerHTML = html;
    }

    /**
     * Export invoices report
     */
    async function exportInvoicesReport() {
      try {
        showLoading(true);
        
        const statusFilter = document.getElementById('invoiceStatusFilter')?.value || 'all';
        const timePeriod = document.getElementById('invoiceTimePeriodFilter')?.value || 'all';
        
        const response = await fetch(API_URL, {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: new URLSearchParams({
            action: 'exportInvoicesReport',
            statusFilter: statusFilter,
            timePeriod: timePeriod
          })
        });
        
        const result = await response.json();
        
        if (result && result.success) {
          // Create download link
          const blob = new Blob([result.csv], { type: 'text/csv;charset=utf-8;' });
          const link = document.createElement('a');
          const url = URL.createObjectURL(blob);
          link.setAttribute('href', url);
          link.setAttribute('download', result.filename);
          link.style.visibility = 'hidden';
          document.body.appendChild(link);
          link.click();
          document.body.removeChild(link);
          
          showSuccess('Report exported successfully!');
        } else {
          showError('Failed to export report: ' + (result.error || 'Unknown error'));
        }
      } catch (error) {
        console.error('Error exporting report:', error);
        showError('Error exporting report: ' + error.toString());
      } finally {
        showLoading(false);
      }
    }

