      document.getElementById('materialCost').value = quote.materialCost || '';
      document.getElementById('additionalFees').value = quote.additionalFees || '';
      document.getElementById('validUntil').value = quote.validUntil || '';
      document.getElementById('priority').value = quote.priority || 'normal';
      
      // Switch to create tab for viewing/editing
      showTab('create');
      
      // Update current quote reference
      currentQuote = quote;
    }
    
    function editQuote(quoteId) {
      viewQuote(quoteId);
      showNotification('Quote loaded for editing', 'info');
