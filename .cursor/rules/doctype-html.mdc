    /**
     * Load contracts for a specific project
     */
    async function loadProjectContracts(projectId) {
      try {
        const response = await fetch(API_URL, {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: new URLSearchParams({
            action: 'getProjectContracts',
            projectId: projectId
          })
        });
        
        const result = await response.json();
        
        if (result.success) {
          const contracts = result.contracts || [];
          renderProjectContracts(contracts, projectId);
        } else {
          document.getElementById('projectContractsContent').innerHTML = `
            <div style="text-align: center; padding: 20px; color: #ef4444;">
              <i class="fas fa-exclamation-triangle"></i>
              <p style="margin: 8px 0 0 0;">Failed to load contracts: ${result.error || 'Unknown error'}</p>
            </div>
          `;
        }
      } catch (error) {
        console.error('Error loading project contracts:', error);
        document.getElementById('projectContractsContent').innerHTML = `
          <div style="text-align: center; padding: 20px; color: #ef4444;">
            <i class="fas fa-exclamation-triangle"></i>
            <p style="margin: 8px 0 0 0;">Error loading contracts</p>
          </div>
        `;
      }
    }
    
    /**
     * Render contracts for a project
     */
    function renderProjectContracts(contracts, projectId) {
      const container = document.getElementById('projectContractsContent');
      
      if (!contracts || contracts.length === 0) {
        // Show warning alert for no contract
        container.innerHTML = `
          <div style="background: linear-gradient(135deg, #fef3c7 0%, #fde68a 100%); padding: 20px; border-radius: 8px; border-left: 4px solid #f59e0b; margin-bottom: 16px;">
            <div style="display: flex; align-items: start; gap: 12px;">
              <i class="fas fa-exclamation-triangle" style="font-size: 24px; color: #d97706; margin-top: 2px;"></i>
              <div style="flex: 1;">
                <h4 style="margin: 0 0 8px 0; color: #92400e; font-size: 16px;">⚠️ No Contract Found</h4>
                <p style="margin: 0 0 12px 0; color: #78350f; font-size: 14px;">
                  This project doesn't have a contract yet. It's recommended to have a signed contract before collecting deposits or starting work.
                </p>
                <button type="button" class="btn btn-primary" onclick="openCreateContractForProject('${projectId}')" style="font-size: 13px;">
                  <i class="fas fa-plus"></i> Create Contract Now
                </button>
              </div>
            </div>
          </div>
          <div style="text-align: center; padding: 20px; background: #f8fafc; border-radius: 8px; border: 2px dashed #e5e7eb;">
            <i class="fas fa-file-contract" style="font-size: 48px; color: #cbd5e1; margin-bottom: 12px;"></i>
            <p style="color: #64748b; margin: 0;">No contracts for this project (Project ID: ${projectId})</p>
          </div>
        `;
        return;
      }
      
      let html = contracts.map(contract => {
        const statusColors = {
          'Draft': '#64748b',
          'Sent': '#f59e0b',
          'Signed': '#10b981',
          'Cancelled': '#ef4444'
        };
        const statusColor = statusColors[contract.status] || '#64748b';
        
        return `
          <div class="card" style="padding: 16px; margin-bottom: 12px; border-left: 4px solid ${statusColor};">
            <div style="display: flex; justify-content: space-between; align-items: start; margin-bottom: 12px;">
              <div style="flex: 1;">
                <h4 style="margin: 0 0 8px 0; color: #1e293b; font-size: 16px;">${escapeHtml(contract.contractTitle || 'Service Agreement')}</h4>
                <p style="margin: 0 0 4px 0; font-size: 13px; color: #64748b;">${contract.id}</p>
                <p style="margin: 0; font-size: 13px; color: #64748b;">
                  Created: ${new Date(contract.dateCreated).toLocaleDateString()}
                  ${contract.dateSent ? ` • Sent: ${new Date(contract.dateSent).toLocaleDateString()}` : ''}
                  ${contract.dateSigned ? ` • Signed: ${new Date(contract.dateSigned).toLocaleDateString()}` : ''}
                </p>
              </div>
              <span style="padding: 6px 14px; background: ${statusColor}15; color: ${statusColor}; border-radius: 12px; font-size: 13px; font-weight: 600; white-space: nowrap;">
                ${contract.status}
              </span>
            </div>
            
            <div style="font-size: 20px; font-weight: 700; color: #0369a1; margin-bottom: 12px;">
              $${parseFloat(contract.totalAmount || 0).toLocaleString('en-US', {minimumFractionDigits: 2})}
            </div>
            
            <div style="display: flex; gap: 8px; flex-wrap: wrap;">
              ${contract.status === 'Draft' ? `
                <button type="button" class="btn btn-primary" onclick="openSignContractModal('${contract.id}')" style="font-size: 13px; padding: 6px 12px;">
                  <i class="fas fa-signature"></i> Sign
                </button>
                <button type="button" class="btn btn-success" onclick="sendContract('${contract.id}')" style="font-size: 13px; padding: 6px 12px;">
                  <i class="fas fa-paper-plane"></i> Send
                </button>
              ` : ''}
              ${contract.status === 'Awaiting Company Signature' ? `
                <button type="button" class="btn btn-primary" onclick="openSignContractModal('${contract.id}')" style="font-size: 13px; padding: 6px 12px;">
                  <i class="fas fa-signature"></i> Sign
                </button>
              ` : ''}
              ${contract.status === 'Sent' || contract.status === 'Awaiting Company Signature' ? `
                <button type="button" class="btn btn-secondary" onclick="sendContract('${contract.id}')" style="font-size: 13px; padding: 6px 12px;">
                  <i class="fas fa-paper-plane"></i> Resend link
                </button>
                <button type="button" class="btn btn-warning" onclick="sendContractReminderFunc('${contract.id}')" style="font-size: 13px; padding: 6px 12px;">
                  <i class="fas fa-bell"></i> Remind
                </button>
              ` : ''}
              ${contract.pdfUrl ? `
                <button type="button" class="btn btn-secondary" onclick="window.open('${contract.pdfUrl}', '_blank')" style="font-size: 13px; padding: 6px 12px;">
                  <i class="fas fa-file-pdf"></i> PDF
                </button>
              ` : ''}
              ${contract.signedPdfUrl ? `
                <button type="button" class="btn btn-success" onclick="window.open('${contract.signedPdfUrl}', '_blank')" style="font-size: 13px; padding: 6px 12px;">
                  <i class="fas fa-file-pdf"></i> Signed PDF
                </button>
              ` : ''}
              <button type="button" class="btn btn-secondary" onclick="viewContract('${contract.id}')" style="font-size: 13px; padding: 6px 12px;">
                <i class="fas fa-eye"></i> View
              </button>
              ${contract.status !== 'Signed' ? `
                <button type="button" class="btn btn-secondary" onclick="openEditContractModal('${contract.id}')" style="font-size: 13px; padding: 6px 12px;">
                  <i class="fas fa-edit"></i> Edit
                </button>
              ` : ''}
            </div>
          </div>
        `;
      }).join('');
      
      container.innerHTML = html;
    }
    
    /**
     * Open create contract modal with project pre-filled
     */
    function openCreateContractForProject(projectId) {
      const project = allProjects.find(p => p.projectId === projectId);
      if (project) {
        // Close project detail modal
        closeProjectDetail();
        // Switch to contracts tab
        switchTab('contracts');
        // Open contract modal after tab switch
        setTimeout(() => {
          openCreateContractModal();
          // Pre-fill with project data
          setTimeout(() => {
            if (document.getElementById('contractProjectId')) {
              document.getElementById('contractProjectId').value = projectId;
              document.getElementById('contractCustomerName').value = project.projectData.customerName;
              document.getElementById('contractCustomerEmail').value = project.customerEmail;
              document.getElementById('contractTotalAmount').value = project.totalValue;
            }
          }, 100);
        }, 300);
      }
    }

