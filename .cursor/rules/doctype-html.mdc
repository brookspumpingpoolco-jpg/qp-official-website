    async function sendReceiptEmails() {
      if (!_rcptData) return;
      const btn = document.getElementById('sendReceiptBtn');
      btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Sending…';
      btn.disabled = true;
      try {
        const resp = await fetch(SCRIPT_URL, {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: new URLSearchParams({
            action:        'sendPaymentReceipt',
            projectId:     _rcptData.projectId || '',
            transactionId: _rcptData.transactionId || '',
            amount:        _rcptData.amount || 0,
            paymentMethod: _rcptData.paymentMethod || '',
            paymentDate:   _rcptData.paymentDate || '',
            milestoneName: _rcptData.milestoneName || '',
            customerEmail: _rcptData.customerEmail || '',
            customerName:  _rcptData.customerName  || '',
            customerPhone: _rcptData.customerPhone  || '',
            invoiceId:     _rcptData.invoiceId || _rcptData.projectId || ''
          })
        });
        const result = await resp.json();
        if (result.success) {
          btn.innerHTML = '<i class="fas fa-check-circle"></i> Receipt Sent!';
          btn.style.background = '#059669';
          showSuccess('Receipt sent to customer and admin notified!');
        } else {
          btn.innerHTML = '<i class="fas fa-paper-plane"></i> Send Receipt + Notify Admin';
          btn.disabled = false;
          showError('Failed to send receipt: ' + (result.error || 'Unknown error'));
        }
      } catch(err) {
        btn.innerHTML = '<i class="fas fa-paper-plane"></i> Send Receipt + Notify Admin';
        btn.disabled = false;
        showError('Error sending receipt: ' + err.message);
      }
    }

    /**
     * Format payment amount input (while typing - allows free typing)
     */
    function formatPaymentAmountInput(input) {
      // Allow typing, just remove non-numeric characters except decimal point
      let value = input.value.replace(/[^0-9.]/g, '');
      
      // Only allow one decimal point
      const parts = value.split('.');
      if (parts.length > 2) {
        value = parts[0] + '.' + parts.slice(1).join('');
      }
      
      // Limit to 2 decimal places while typing
      if (parts.length === 2 && parts[1].length > 2) {
        value = parts[0] + '.' + parts[1].substring(0, 2);
      }
      
      input.value = value;
    }
    
    /**
     * Format payment amount on blur (final formatting)
     */
    function formatPaymentAmountBlur(input) {
      const value = parseFloat(input.value);
      if (!isNaN(value) && value >= 0) {
        input.value = value.toFixed(2);
      } else if (input.value.trim() === '' || input.value === '0') {
        input.value = '';
      }
    }
    
    /**
     * Legacy function for backward compatibility
     */
    function formatPaymentAmount(input) {
      formatPaymentAmountBlur(input);
    }
    
    /**
     * Submit manual payment
     */
    async function submitManualPayment() {
      const amount = parseFloat(document.getElementById('manualPaymentAmount').value);
      const paymentMethod = document.getElementById('manualPaymentMethod').value;
      const paymentDate = document.getElementById('manualPaymentDate').value;
      const notes = document.getElementById('manualPaymentNotes').value.trim();
      
      // Validation
      if (!amount || amount <= 0) {
        showError('Please enter a valid payment amount');
        return;
      }
      
      if (!paymentMethod) {
        showError('Please select a payment method');
        return;
      }
      
      if (!paymentDate) {
        showError('Please select a payment date');
        return;
      }
      
      // Read milestone from dropdown (overrides context if user selected one)
      const milestoneSelectEl = document.getElementById('manualPaymentMilestoneSelect');
      const selectedMilestoneId = milestoneSelectEl ? milestoneSelectEl.value : '';

      // Save context before closing modal (modal close resets context)
      const savedContext = {
        projectId: currentPaymentContext.projectId,
        invoiceId: currentPaymentContext.invoiceId,
        milestoneId: selectedMilestoneId || currentPaymentContext.milestoneId
      };
      
      try {
        showLoading(true);
        closeManualPaymentModal();
        
        // Debug: Log payment context
        console.log('💳 Payment Context:', {
          savedProjectId: savedContext.projectId,
          savedInvoiceId: savedContext.invoiceId,
          currentInvoiceId: currentInvoiceId,
          savedMilestoneId: savedContext.milestoneId
        });
        
        // Check if this is for a project (priority - project context takes precedence)
        if (savedContext.projectId) {
          // Record payment for project
        const response = await fetch(SCRIPT_URL, {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: new URLSearchParams({
            action: 'recordManualPayment',
              projectId: savedContext.projectId,
              milestoneId: savedContext.milestoneId || '',
            amount: amount.toFixed(2),
            paymentMethod: paymentMethod,
            notes: notes,
            paymentDate: paymentDate
          })
        });
        
        const result = await response.json();
        
        if (result && result.success) {
          showSuccess('Payment recorded successfully!');
          // Show receipt confirmation dialog
          showReceiptConfirmModal(result, savedContext.projectId);
          // Refresh project details in background
          setTimeout(() => {
            viewProjectDetail(savedContext.projectId);
          }, 600);
        } else {
          showError('Failed to record payment: ' + (result.error || 'Unknown error'));
        }
        } else if (savedContext.invoiceId || currentInvoiceId) {
          // Record payment for invoice
          const invoiceIdToUse = savedContext.invoiceId || currentInvoiceId;
          const response = await fetch(SCRIPT_URL, {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: new URLSearchParams({
              action: 'recordPayment',
              invoiceId: invoiceIdToUse,
              amount: amount.toFixed(2),
              paymentMethod: paymentMethod,
              paymentDate: paymentDate,
              notes: notes,
              jobStatus: ''
            })
          });
          
          const result = await response.json();
          
          if (result && result.success) {
            showSuccess('Payment recorded successfully!');
            // Reload the invoice to refresh payment history
            if (invoiceIdToUse) {
              setTimeout(() => {
                loadQuote(invoiceIdToUse);
            }, 500);
          }
        } else {
          showError('Failed to record payment: ' + (result.error || 'Unknown error'));
          }
        } else {
          // Better error message with context info
          const errorMsg = 'No invoice or project found. Please open an invoice or project first.\n\n' +
                          'Context: projectId=' + (savedContext.projectId || 'null') + 
                          ', invoiceId=' + (savedContext.invoiceId || 'null') + 
                          ', currentInvoiceId=' + (currentInvoiceId || 'null');
          console.error('❌ Payment context error:', {
            savedContext: savedContext,
            currentInvoiceId: currentInvoiceId,
            currentPaymentContext: currentPaymentContext
          });
          showError(errorMsg);
        }
      } catch (error) {
        console.error('Error recording payment:', error);
        showError('Error recording payment: ' + error.toString());
      } finally {
        showLoading(false);
      }
    }
    
    /**
     * Record manual payment (legacy function - now opens modal)
     */
    async function recordManualPayment(projectId, milestoneId, amount) {
      // Ensure projectId is valid
      if (!projectId) {
        console.error('❌ recordManualPayment called without projectId');
        showError('Project ID is required to record payment. Please open a project first.');
        return;
      }
      
      // Get milestone info if available
      let milestoneName = null;
      let milestoneAmount = amount;
      
      if (milestoneId) {
        const project = allProjects.find(p => p.projectId === projectId) || currentProject;
        if (project) {
          const projectData = project.projectData || project.project || {};
          const paymentSchedule = projectData.paymentSchedule || [];
          const milestone = paymentSchedule.find(m => m.id == milestoneId);
          if (milestone) {
            milestoneName = milestone.name;
            if (!milestoneAmount) {
              milestoneAmount = milestone.amount;
            }
          }
        }
      }
      
      // Open modal with project context (no invoiceId)
      openManualPaymentModal(projectId, milestoneId, milestoneName, milestoneAmount, null);
    }

    /**
     * View payment history
     */
    async function viewPaymentHistory(projectId) {
      try {
        showLoading(true);

        // Resolve linked estimateId from cached project data if available
        const cachedProject = (typeof allProjects !== 'undefined' ? allProjects : []).find(p => p.projectId === projectId);
        const projData = (cachedProject && cachedProject.projectData) || {};
        const linkedEstimateId = projData.estimateId || projData.invoiceId || (cachedProject && (cachedProject.estimateId || cachedProject.invoiceId)) || '';

        const response = await fetch(API_URL, {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: new URLSearchParams({
            action: 'getProjectPaymentHistory',
            projectId: projectId,
            estimateId: linkedEstimateId
          })
        });
        
        const result = await response.json();
        
        if (result && result.success) {
          // Show payment history in a modal
          let historyHtml = '<div style="max-height: 60vh; overflow-y: auto;"><h3 style="margin-top: 0;">Payment History</h3>';
          
          if (result.payments && result.payments.length > 0) {
            historyHtml += '<table style="width: 100%; border-collapse: collapse; margin-top: 20px;">';
            historyHtml += '<thead><tr style="background: #f9fafb;"><th style="padding: 12px; text-align: left;">Date</th><th style="padding: 12px; text-align: left;">Milestone</th><th style="padding: 12px; text-align: right;">Amount</th><th style="padding: 12px; text-align: left;">Method</th></tr></thead><tbody>';
            
            result.payments.forEach(payment => {
              historyHtml += `<tr style="border-bottom: 1px solid #e5e7eb;">
                <td style="padding: 12px;">${payment.date ? new Date(payment.date).toLocaleDateString() : 'N/A'}</td>
                <td style="padding: 12px;">${payment.milestoneName || 'N/A'}</td>
                <td style="padding: 12px; text-align: right; font-weight: 600;">$${parseFloat(payment.amount || 0).toFixed(2)}</td>
                <td style="padding: 12px;">${payment.method || 'N/A'}</td>
              </tr>`;
            });
            
            historyHtml += '</tbody></table>';
          } else {
            historyHtml += '<p style="text-align: center; color: #6b7280; padding: 40px;">No payment history yet</p>';
          }
          
          historyHtml += '</div>';
          
          // Show in modal
          const modal = document.createElement('div');
          modal.className = 'modal';
          modal.style.display = 'flex';
          modal.style.zIndex = '10001';
          modal.innerHTML = `
            <div class="modal-content" style="max-width: 800px;">
              <div class="modal-header">
                <h2>Payment History</h2>
                <button class="modal-close" onclick="this.closest('.modal').remove()">&times;</button>
              </div>
              <div class="modal-body">${historyHtml}</div>
            </div>
          `;
          document.body.appendChild(modal);
        } else {
          showError('Failed to load payment history: ' + (result.error || 'Unknown error'));
        }
      } catch (error) {
        console.error('Error loading payment history:', error);
        showError('Error loading payment history: ' + error.toString());
      } finally {
        showLoading(false);
      }
    }

