    async function calculateConcretePrice() {
      const poolLength = parseFloat(document.getElementById('concretePoolLength').value) || 0;
      const poolWidth = parseFloat(document.getElementById('concretePoolWidth').value) || 0;
      const hasSteps = document.getElementById('concreteHasSteps').checked;
      const overridePrice = parseFloat(document.getElementById('concreteOverridePriceValue').value) || 0;
      const useOverride = document.getElementById('concreteOverridePrice').checked;

      if (poolLength <= 0 || poolWidth <= 0) {
        document.getElementById('concreteCalculation').style.display = 'none';
        document.getElementById('addConcreteButton').disabled = true;
        return;
      }

      try {
        const response = await fetch(API_URL, {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: new URLSearchParams({
            action: 'calculateConcrete',
            data: JSON.stringify({
              type: 'collar',
              poolLength: poolLength,
              poolWidth: poolWidth,
              hasSteps: hasSteps
            })
          })
        });
        const result = await response.json();
        
        if (result.success) {
          concreteCalculatedData = result;
          
          // Calculate perimeter for display
          const perimeter = 2 * (poolLength + poolWidth);
          const baseYards = perimeter / 32;
          
          // Display calculation
          document.getElementById('concretePerimeter').textContent = perimeter.toFixed(1);
          document.getElementById('concreteBaseVolume').textContent = baseYards.toFixed(2);
          document.getElementById('concreteVolume').textContent = result.roundedYards.toFixed(2);
          document.getElementById('concreteCalculatedPrice').textContent = '$' + result.totalPrice.toFixed(2);
          document.getElementById('concreteCalculation').style.display = 'block';

          // Set final price (override or calculated)
          if (useOverride && overridePrice > 0) {
            concreteFinalPrice = overridePrice;
        } else {
            concreteFinalPrice = result.totalPrice;
          }

          updateConcreteFinalPriceDisplay();
          document.getElementById('addConcreteButton').disabled = false;
        } else {
          showError('Error calculating concrete: ' + (result.error || 'Unknown error'));
          document.getElementById('concreteCalculation').style.display = 'none';
          document.getElementById('addConcreteButton').disabled = true;
        }
      } catch (error) {
        showError('Error calculating concrete: ' + error.message);
        document.getElementById('concreteCalculation').style.display = 'none';
        document.getElementById('addConcreteButton').disabled = true;
      }
    }

    function toggleConcretePriceOverride() {
      const useOverride = document.getElementById('concreteOverridePrice').checked;
      const overrideInput = document.getElementById('concreteOverridePriceValue');
      
      if (useOverride) {
        overrideInput.style.display = 'block';
        if (concreteCalculatedData) {
          overrideInput.value = concreteCalculatedData.totalPrice.toFixed(2);
          concreteFinalPrice = concreteCalculatedData.totalPrice;
          updateConcreteFinalPriceDisplay();
        }
      } else {
        overrideInput.style.display = 'none';
        if (concreteCalculatedData) {
          concreteFinalPrice = concreteCalculatedData.totalPrice;
          updateConcreteFinalPriceDisplay();
        }
      }
    }

