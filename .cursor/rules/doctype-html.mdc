    function updateProfitWithExpenses() {
      const expensesInput = document.getElementById('additionalExpenses');
      const finalProfitEl = document.getElementById('finalProfit');
      const finalProfitRow = document.getElementById('finalProfitRow');
      const profitAmountEl = document.getElementById('profitAmount');
      
      if (!expensesInput || !finalProfitEl || !profitAmountEl) return;
      
      const expenses = parseFloat(expensesInput.value) || 0;
      const profitText = profitAmountEl.textContent.replace('$', '').replace(',', '');
      const currentProfit = parseFloat(profitText) || 0;
      const finalProfit = currentProfit - expenses;
      
      if (expenses > 0 || finalProfit !== currentProfit) {
        finalProfitEl.textContent = '$' + finalProfit.toFixed(2);
        // Color code final profit
        if (finalProfit > 0) {
          finalProfitEl.style.color = '#10b981';
        } else if (finalProfit < 0) {
          finalProfitEl.style.color = '#ef4444';
        } else {
          finalProfitEl.style.color = '#6b7280';
        }
        if (finalProfitRow) finalProfitRow.style.display = 'flex';
      } else {
        if (finalProfitRow) finalProfitRow.style.display = 'none';
      }
    }

    function isValidVerizonPhone(phone) {
      // Verizon phone numbers: vtext.com or vzwpix.com
      // Format: 10-digit number@vtext.com or number@vzwpix.com
      const phoneStr = String(phone).trim();
      
      // Check if it's already an email format
      if (phoneStr.includes('@')) {
        const domain = phoneStr.split('@')[1].toLowerCase();
        return domain === 'vtext.com' || domain === 'vzwpix.com';
      }
      
      // Check if it's a 10-digit phone number
      const digitsOnly = phoneStr.replace(/\D/g, '');
      return digitsOnly.length === 10;
    }

    function formatVerizonEmail(phone) {
      const phoneStr = String(phone).trim();
      
      // If already formatted as email, return as-is
      if (phoneStr.includes('@')) {
        return phoneStr;
      }
      
      // Extract digits only
      const digitsOnly = phoneStr.replace(/\D/g, '');
      
      if (digitsOnly.length === 10) {
        // Use vtext.com for SMS (text messages)
        return digitsOnly + '@vtext.com';
      }
      
      return null;
    }

    async function sendProfitReportToVerizon() {
      const phoneInput = prompt('Enter Verizon phone number (10 digits):');
      if (!phoneInput) return;
      
      if (!isValidVerizonPhone(phoneInput)) {
        showError('Invalid Verizon phone number. Please enter a 10-digit number.');
        return;
      }
      
      const verizonEmail = formatVerizonEmail(phoneInput);
      if (!verizonEmail) {
        showError('Could not format phone number. Please enter a 10-digit number.');
        return;
      }
      
      // Get current profit data
      const revenueEl = document.getElementById('profitRevenue');
      const costEl = document.getElementById('profitCost');
      const profitEl = document.getElementById('profitAmount');
      const materialsProfitEl = document.getElementById('materialsProfit');
      const laborProfitEl = document.getElementById('laborProfit');
      const stockProfitEl = document.getElementById('stockProfit');
      const expensesInput = document.getElementById('additionalExpenses');
      const finalProfitEl = document.getElementById('finalProfit');
      const marginEl = document.getElementById('profitMargin');
      const markupEl = document.getElementById('profitMarkup');
      
      const revenue = revenueEl ? revenueEl.textContent : '$0.00';
      const cost = costEl ? costEl.textContent : '$0.00';
      const profit = profitEl ? profitEl.textContent : '$0.00';
      const materialsProfit = materialsProfitEl ? materialsProfitEl.textContent : '$0.00';
      const laborProfit = laborProfitEl ? laborProfitEl.textContent : '$0.00';
      const stockProfit = stockProfitEl ? stockProfitEl.textContent : null;
      const expenses = expensesInput ? parseFloat(expensesInput.value) || 0 : 0;
      const finalProfit = finalProfitEl ? finalProfitEl.textContent : profit;
      const margin = marginEl ? marginEl.textContent : '0%';
      const markup = markupEl ? markupEl.textContent : '0%';
      
      // Build email body
      let emailBody = 'PROFIT REPORT\n\n';
      emailBody += 'Revenue: ' + revenue + '\n';
      emailBody += 'Cost: ' + cost + '\n';
      emailBody += 'Net Profit: ' + profit + '\n\n';
      
      if (materialsProfitEl && materialsProfitEl.parentElement.style.display !== 'none') {
        emailBody += 'Materials Profit: ' + materialsProfit + '\n';
      }
      if (laborProfitEl && laborProfitEl.parentElement.style.display !== 'none') {
        emailBody += 'Labor Profit: ' + laborProfit + '\n';
      }
      if (stockProfit && stockProfitEl && stockProfitEl.parentElement.style.display !== 'none') {
        emailBody += 'Already on Hand: ' + stockProfit + '\n';
      }
      if (expenses > 0) {
        emailBody += 'Additional Expenses: $' + expenses.toFixed(2) + '\n';
        emailBody += 'Final Profit: ' + finalProfit + '\n';
      }
      emailBody += '\nMargin: ' + margin + '\n';
      emailBody += 'Markup: ' + markup + '\n';
      
      emailBody += '\n---\n';
      emailBody += 'Generated: ' + new Date().toLocaleString();
      
      try {
        const response = await fetch(API_URL, {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: new URLSearchParams({
            action: 'sendProfitReport',
            data: JSON.stringify({
              to: verizonEmail,
              subject: 'Profit Report',
              body: emailBody
            })
          })
        });
        
        const result = await response.json();
        
        if (result.success) {
          showSuccess('Profit report sent to ' + phoneInput + ' (' + verizonEmail + ')');
        } else {
          showError('Failed to send: ' + (result.error || 'Unknown error'));
        }
      } catch (error) {
        showError('Error sending report: ' + error.message);
      }
    }

    function removeItem(id) {
      // Remove from profit tracking if it was marked
      if (profitModeItems.has(id)) {
        profitModeItems.delete(id);
        if (profitModeItems.size === 0) {
          profitModeActive = false;
          hideProfitModeWarning();
        }
        updateProfitModeIndicator();
      }
      
      lineItems = lineItems.filter(i => i.id !== id);
      renderItems();
      calculateTotals();
      
      // Auto-update profit calculation if any items still marked for profit
      if (profitModeItems.size > 0) {
        calculateProfitSilently();
      } else {
        // Hide profit results if no items left
        const resultsEl = document.getElementById('profitResults');
        const placeholderEl = document.getElementById('profitPlaceholder');
        if (resultsEl) resultsEl.style.display = 'none';
        if (placeholderEl) placeholderEl.style.display = 'block';
      }
    }

    function getGrandTotal() {
      if (!lineItems || !Array.isArray(lineItems)) {
        lineItems = [];
      }
      // Exclude processing fee from subtotal (it's added after tax and discount)
      const subtotal = lineItems
        .filter(item => !item.isProcessingFee)
        .reduce((sum, item) => sum + (parseFloat(item.quantity || 0) * parseFloat(item.price || 0)), 0);
      const taxRate = parseFloat(document.getElementById('taxRate')?.value) || 0;
      const taxAmount = subtotal * (taxRate / 100);
      const discount = parseFloat(document.getElementById('discount')?.value) || 0;
      const total = subtotal + taxAmount - discount;
      return total;
    }

    function setTaxRate(rate, state) {
      document.getElementById('taxRate').value = rate;
      calculateTotals();
      showSuccess(`Tax rate set to ${rate}% for ${state}`);
      
      // Visual feedback - highlight the selected button
      document.querySelectorAll('.tax-btn').forEach(btn => {
        btn.style.background = 'white';
        btn.style.borderColor = '#e5e7eb';
        btn.style.color = '#374151';
      });
      event.target.style.background = 'linear-gradient(135deg, #0ea5e9 0%, #06b6d4 100%)';
      event.target.style.borderColor = '#0ea5e9';
      event.target.style.color = 'white';
    }
    
    function calculateTotals() {
      console.log('🔵 [CALCULATE TOTALS] calculateTotals() called');
      
      if (!lineItems || !Array.isArray(lineItems)) {
        lineItems = [];
      }
      // Exclude processing fee from subtotal (it's added after tax and discount)
      const subtotal = lineItems
        .filter(item => !item.isProcessingFee)
        .reduce((sum, item) => sum + (item.quantity * item.price), 0);
      const taxRate = parseFloat(document.getElementById('taxRate')?.value) || 0;
      const taxAmount = subtotal * (taxRate / 100);
      const discount = parseFloat(document.getElementById('discount')?.value) || 0;
      const addProcessingFee = document.getElementById('addProcessingFee')?.checked || false;
      
      // Calculate processing fee if enabled (2.9% + $0.29)
      let processingFee = 0;
      if (addProcessingFee) {
        const baseTotal = subtotal + taxAmount - discount;
        processingFee = (baseTotal * 0.029) + 0.29;
        document.getElementById('processingFeeDetails').style.display = 'block';
        document.getElementById('processingFeeAmount').textContent = '$' + processingFee.toFixed(2);
        
        // Update processing fee line item if it exists
        const processingFeeItem = lineItems.find(item => item.isProcessingFee === true);
        if (processingFeeItem) {
          processingFeeItem.price = processingFee;
          // Re-render to show updated price
          renderItems();
        }
      } else {
        document.getElementById('processingFeeDetails').style.display = 'none';
        
        // Remove processing fee line item if it exists
        const processingFeeIndex = lineItems.findIndex(item => item.isProcessingFee === true);
        if (processingFeeIndex !== -1) {
          lineItems.splice(processingFeeIndex, 1);
          renderItems();
        }
      }
      
      const total = subtotal + taxAmount - discount + processingFee;
      
      console.log('🔵 [CALCULATE TOTALS] Subtotal:', subtotal, 'Tax:', taxAmount, 'Discount:', discount, 'Processing Fee:', processingFee, 'Total:', total);
      
      const subtotalEl = document.getElementById('subtotal');
      const taxAmountEl = document.getElementById('taxAmount');
      const grandTotalEl = document.getElementById('grandTotal');
      
      if (subtotalEl) subtotalEl.textContent = '$' + subtotal.toFixed(2);
      if (taxAmountEl) taxAmountEl.textContent = '$' + taxAmount.toFixed(2);
      if (grandTotalEl) grandTotalEl.textContent = '$' + total.toFixed(2);
      
      // Update payment summary
      updatePaymentSummary();
      
      // Update payment schedule totals if modal is open
      const modalOpen = document.getElementById('paymentScheduleModal')?.classList.contains('active');
      console.log('🔵 [CALCULATE TOTALS] Payment modal open:', modalOpen);
      if (modalOpen) {
        console.log('🔵 [CALCULATE TOTALS] Updating payment schedule totals (modal is open)');
        updatePaymentScheduleTotals();
      }
      
      // Update preview if schedule exists
      console.log('🔵 [CALCULATE TOTALS] Payment milestones:', paymentScheduleMilestones.length);
      if (paymentScheduleMilestones.length > 0) {
        console.log('🔵 [CALCULATE TOTALS] Rendering payment schedule preview');
        renderPaymentSchedulePreview();
      } else {
        console.log('⚠️ [CALCULATE TOTALS] No milestones - preview not rendered');
      }
      console.log('✅ [CALCULATE TOTALS] Complete');
    }

    function updateData() {
      calculateTotals();
    }

    async function saveDraft(silent = false) {
      const data = getFormData();
      data.status = 'Draft';
      
      // Skip auto-save if form is empty (no customer email)
      if (!data.customerEmail || !data.customerEmail.trim()) {
        if (!silent) {
          console.log('Skipping save - no customer email');
        }
        return;
      }
      
      // If editing an existing quote, pass its ID to update instead of creating new
      if (currentEditingQuoteId) {
        data.id = currentEditingQuoteId;
        if (!silent) {
          console.log('Updating existing invoice:', currentEditingQuoteId);
        }
      } else {
        if (!silent) {
          console.log('Creating new invoice');
        }
      }
      
      try {
        const response = await fetch(API_URL, {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: new URLSearchParams({
            action: 'saveInvoiceEstimate',
            data: JSON.stringify(data)
          })
        });
        const result = await response.json();
        
        if (result.success) {
          // Store the ID for future updates
          if (!currentEditingQuoteId) {
            currentEditingQuoteId = result.id;
            if (!silent) {
              console.log('New invoice created with ID:', result.id);
            }
          }
          if (!silent) {
          showSuccess('Draft saved successfully! ID: ' + result.id);
        } else {
            console.log('Auto-saved draft (ID: ' + result.id + ')');
          }
        } else {
          if (!silent) {
          showError('Failed to save: ' + (result.error || 'Unknown error'));
          } else {
            console.warn('Auto-save failed: ' + (result.error || 'Unknown error'));
          }
        }
      } catch (error) {
        if (!silent) {
        showError('Error saving: ' + error.message);
        } else {
          console.warn('Auto-save error: ' + error.message);
        }
      }
    }

