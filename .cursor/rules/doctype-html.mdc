          }
          document.getElementById('date').value = dateValue || new Date().toISOString().split('T')[0];
          
          // Format due date properly - ensure it's a valid date string or empty
          let dueDateValue = '';
          if (data.dueDate) {
            try {
              // Check if it's already a valid date string format
              if (typeof data.dueDate === 'string') {
                // Check if it matches date format (yyyy-MM-dd)
                if (/^\d{4}-\d{2}-\d{2}$/.test(data.dueDate)) {
                  dueDateValue = data.dueDate;
                } else {
                  // Try to parse it as a date
                  const dateObj = new Date(data.dueDate);
                  if (!isNaN(dateObj.getTime())) {
                    dueDateValue = dateObj.toISOString().split('T')[0];
                  }
                }
              } else {
                const dateObj = new Date(data.dueDate);
                if (!isNaN(dateObj.getTime())) {
                  dueDateValue = dateObj.toISOString().split('T')[0];
                }
              }
            } catch (e) {
              console.warn('Invalid due date value:', data.dueDate);
            }
          }
          document.getElementById('dueDate').value = dueDateValue;
          
          document.getElementById('invoiceNumber').value = data.id || data.invoiceNumber || '';
