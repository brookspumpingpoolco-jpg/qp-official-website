  <script>
    console.log('InvoiceEstimateUI loaded - Version 2.0 (No document.write)');
    // ==========================================================================
    //  GLOBAL STATE & CONFIGURATION
    // ==========================================================================
    
    let currentQuote = {};
    let quotes = [];
    let lineItems = [];
    let invoicePhotoUrls = []; // URLs of photos uploaded to customer folder (shown in email)
    let currentEditingQuoteId = null; // Track which quote we're editing
    let currentType = 'Invoice'; // Default to Invoice
    let dashboardData = {
      totalRevenue: 0,
      activeQuotes: 0,
      completedJobs: 0,
      winRate: 0
    };

    // ==========================================================================
    //  UTILITY FUNCTIONS (Define early so they're available everywhere)
    // ==========================================================================
    
    function escapeHtml(text) {
      if (!text) return '';
      const map = { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;' };
      return text.toString().replace(/[&<>"']/g, m => map[m]);
    }

    function escapeJS(text) {
      if (text === null || text === undefined) return '';
      return String(text).replace(/'/g, "\\'").replace(/"/g, '\\"').replace(/\n/g, '\\n').replace(/\r/g, '\\r');
    }
    
    // Escape template literal syntax to prevent breaking template literals
    function escapeTemplateLiteral(text) {
      if (!text) return '';
      return String(text)
        .replace(/\\/g, '\\\\')  // Escape backslashes first
        .replace(/`/g, '\\`')     // Escape backticks
        .replace(/\${/g, '\\${'); // Escape template literal expressions
    }
    
    // Make escape functions globally available
    window.escapeHtml = escapeHtml;
    window.escapeJS = escapeJS;
    window.escapeTemplateLiteral = escapeTemplateLiteral;
    
    // ==========================================================================
    //  TAB MANAGEMENT
    // ==========================================================================
    
    function showTab(tabName, tabButton) {
      // Use switchTab for consistency
      if (typeof switchTab === 'function') {
        switchTab(tabName);
      }
      
      // Add active class to clicked button if provided
      if (tabButton) {
        document.querySelectorAll('.tab-btn').forEach(btn => btn.classList.remove('active'));
        tabButton.classList.add('active');
      }
    }
    
    // Make showTab globally accessible
    window.showTab = showTab;

    // ==========================================================================
    //  QUOTE CREATION & MANAGEMENT
    // ==========================================================================
    
    function createQuote() {
      showLoading(true);
      
      const quoteData = {
        id: 'QTE-' + Date.now(),
        customerName: document.getElementById('customerName').value.trim(),
        customerEmail: document.getElementById('customerEmail').value.trim(),
        customerPhone: document.getElementById('customerPhone').value.trim(),
        serviceType: document.getElementById('serviceType').value,
        serviceAddress: document.getElementById('serviceAddress').value.trim(),
        serviceDescription: document.getElementById('serviceDescription').value.trim(),
        estimatedHours: parseFloat(document.getElementById('estimatedHours').value) || 0,
        hourlyRate: parseFloat(document.getElementById('hourlyRate').value) || 75,
        materialCost: parseFloat(document.getElementById('materialCost').value) || 0,
        additionalFees: parseFloat(document.getElementById('additionalFees').value) || 0,
        validUntil: document.getElementById('validUntil').value,
        priority: document.getElementById('priority').value,
        status: 'draft',
        createdAt: new Date().toISOString(),
        updatedAt: new Date().toISOString()
      };
      
      // Validate required fields
      if (!quoteData.customerName || !quoteData.customerEmail || !quoteData.serviceType) {
        showNotification('Please fill in all required fields', 'error');
        showLoading(false);
        return;
      }
      
      // Calculate total
      const laborCost = quoteData.estimatedHours * quoteData.hourlyRate;
      quoteData.total = laborCost + quoteData.materialCost + quoteData.additionalFees;
      
      // Store current quote
      currentQuote = quoteData;
      
      // Add to quotes list
      quotes.unshift(quoteData);
      
      // Save to Google Apps Script
      saveQuoteToSheet(quoteData).then(() => {
        showNotification('Quote created successfully!', 'success');
        document.getElementById('sendQuoteBtn').style.display = 'inline-flex';
        updateDashboardStats();
        showLoading(false);
      }).catch(error => {
        console.error('Error saving quote:', error);
        showNotification('Error creating quote. Please try again.', 'error');
        showLoading(false);
      });
    }
    
    function saveAsDraft() {
      const quoteData = {
        id: 'DFT-' + Date.now(),
        customerName: document.getElementById('customerName').value.trim(),
        customerEmail: document.getElementById('customerEmail').value.trim(),
        customerPhone: document.getElementById('customerPhone').value.trim(),
        serviceType: document.getElementById('serviceType').value,
        serviceAddress: document.getElementById('serviceAddress').value.trim(),
        serviceDescription: document.getElementById('serviceDescription').value.trim(),
        estimatedHours: parseFloat(document.getElementById('estimatedHours').value) || 0,
        hourlyRate: parseFloat(document.getElementById('hourlyRate').value) || 75,
        materialCost: parseFloat(document.getElementById('materialCost').value) || 0,
        additionalFees: parseFloat(document.getElementById('additionalFees').value) || 0,
        validUntil: document.getElementById('validUntil').value,
        priority: document.getElementById('priority').value,
        status: 'draft',
        createdAt: new Date().toISOString(),
        updatedAt: new Date().toISOString()
      };
      
      const laborCost = quoteData.estimatedHours * quoteData.hourlyRate;
      quoteData.total = laborCost + quoteData.materialCost + quoteData.additionalFees;
      
      quotes.unshift(quoteData);
      showNotification('Quote saved as draft', 'success');
      updateDashboardStats();
    }
    
    function sendQuote() {
      if (!currentQuote.id) {
        showNotification('Please create a quote first', 'error');
        return;
      }
      
      showLoading(true);
      
      // Update quote status
      currentQuote.status = 'sent';
      currentQuote.sentAt = new Date().toISOString();
      
      // Send email via Google Apps Script
      sendQuoteEmail(currentQuote).then(() => {
        showNotification('Quote sent successfully!', 'success');
        updateDashboardStats();
        showLoading(false);
      }).catch(error => {
        console.error('Error sending quote:', error);
        showNotification('Error sending quote. Please try again.', 'error');
        showLoading(false);
      });
    }

    // ==========================================================================
    //  DASHBOARD FUNCTIONALITY
    // ==========================================================================
    
    function loadDashboard() {
      updateDashboardStats();
      renderQuotesList();
    }
    
    // ==========================================================================
    //  PROJECTS MANAGEMENT FUNCTIONALITY
    // ==========================================================================
    
    let currentProjectEstimateId = null;
    
    /**
     * Load all approved projects
     */
    async function loadApprovedProjects() {
      const container = document.getElementById('projectsList');
      
      // Show loading
      container.innerHTML = `
        <div style="text-align: center; padding: 60px 20px; color: #6b7280;">
          <i class="fas fa-spinner fa-spin" style="font-size: 48px; margin-bottom: 20px; opacity: 0.5;"></i>
          <p>Loading projects...</p>
        </div>
      `;
      
      try {
        // Use POST (same as loadAllProjects) so CORS works from Netlify/other hosts
        const response = await fetch(SCRIPT_URL, {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: new URLSearchParams({ action: 'getAllProjects' })
        });
        const text = await response.text();
        let result;
        try {
          result = JSON.parse(text);
        } catch (e) {
          console.error('getAllProjects response not JSON:', text);
          throw new Error('Server response was not valid JSON. Check deployment (Anyone access).');
        }
        const projects = Array.isArray(result.projects) ? result.projects : [];
        console.log('getAllProjects result:', { success: result.success, projectCount: projects.length, error: result.error });
        if (result.success) {
          allProjects = projects;
          renderProjectsGrid(projects);
        } else {
          container.innerHTML = `
            <div style="text-align: center; padding: 60px 20px; color: #ef4444;">
              <i class="fas fa-exclamation-triangle" style="font-size: 48px; margin-bottom: 20px;"></i>
              <p>Error loading projects: ${result.error || 'Unknown error'}</p>
              <button type="button" class="btn btn-primary" onclick="loadApprovedProjects()" style="margin-top: 16px;">Retry</button>
            </div>
          `;
        }
      } catch (error) {
        console.error('Error loading projects:', error);
        container.innerHTML = `
          <div style="text-align: center; padding: 60px 20px; color: #ef4444;">
            <i class="fas fa-exclamation-triangle" style="font-size: 48px; margin-bottom: 20px;"></i>
            <p>Error loading projects: ${error.message}</p>
            <button type="button" class="btn btn-primary" onclick="loadApprovedProjects()" style="margin-top: 16px;">Retry</button>
          </div>
        `;
      }
    }
    
    /**
     * Render projects grid
     */
    function renderProjectsGrid(projects) {
      const container = document.getElementById('projectsList');
      
      if (!projects || projects.length === 0) {
        container.innerHTML = `
          <div style="text-align: center; padding: 60px 20px; color: #6b7280;">
            <i class="fas fa-folder-open" style="font-size: 64px; margin-bottom: 20px; opacity: 0.3;"></i>
            <h3 style="margin-bottom: 12px;">No Projects Found</h3>
            <p style="margin-bottom: 20px;">Convert an approved estimate to a project to see it here.</p>
            <p style="font-size: 13px; margin-bottom: 24px;">Go to <strong>Invoices &amp; Estimates</strong>, open an estimate, and click <strong>Convert to Project</strong>.</p>
            <button type="button" class="btn btn-primary" onclick="typeof switchTab === 'function' && switchTab('preview')" style="padding: 12px 24px; margin-right: 10px;">
              <i class="fas fa-file-invoice"></i> Go to Invoices &amp; Estimates
            </button>
            <button type="button" class="btn btn-secondary" onclick="loadApprovedProjects()" style="padding: 12px 24px;">
              <i class="fas fa-sync-alt"></i> Refresh
            </button>
          </div>
        `;
        return;
      }
      
      let html = '<div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(380px, 1fr)); gap: 20px;">';
      
      projects.forEach(project => {
        const pd = (project && project.projectData) ? project.projectData : {};
        const isLikelyEmail = function(value) {
          const v = String(value || '').trim();
          if (!v) return false;
          if (v.indexOf('{') !== -1 || v.indexOf('}') !== -1) return false;
          return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v);
        };

        // Handle both data structures: from getAllProjects() and getApprovedEstimates()
        const projectId = project.projectId || project.id;
        const customerName = pd.customerName || project.customerName || 'Unknown';
        const rawCustomerEmail = project.customerEmail || pd.customerEmail || '';
        const customerEmail = isLikelyEmail(rawCustomerEmail) ? rawCustomerEmail : (isLikelyEmail(pd.customerEmail) ? pd.customerEmail : '');
        const status = project.status || 'Active';
        const totalValue = parseFloat(project.totalValue || project.total || 0);
        const profitMargin = parseFloat(project.profitMargin || 0);
        const rawCreatedDate = pd.createdDate || project.date || '';
        const createdDate = rawCreatedDate && !isNaN(new Date(rawCreatedDate).getTime())
          ? new Date(rawCreatedDate).toLocaleDateString()
          : 'N/A';
        const estimateId = pd.estimateId || pd.invoiceId || project.id || '';
        
        const statusColor = status === 'Active' ? '#10b981' : status === 'Completed' ? '#3b82f6' : '#64748b';
        const profitColor = profitMargin >= 20 ? '#10b981' : profitMargin >= 10 ? '#f59e0b' : '#ef4444';
        
        html += `
