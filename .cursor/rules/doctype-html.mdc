    /**
     * Report cash/check payment
     */
    async function reportPayment(event, invoiceId, maxAmount) {
      event.preventDefault();
      
      const paymentMethod = document.getElementById('paymentMethod').value;
      const amount = parseFloat(document.getElementById('paymentAmount').value);
      const transactionId = document.getElementById('transactionId').value;
      const paymentDate = document.getElementById('paymentDate').value;
      const notes = document.getElementById('paymentNotes').value;
      
      if (amount > maxAmount) {
        showError(`Amount cannot exceed balance of $${maxAmount.toLocaleString('en-US', {minimumFractionDigits: 2, maximumFractionDigits: 2})}`);
        return;
      }
      
      if (amount <= 0) {
        showError('Amount must be greater than 0');
        return;
      }
      
      try {
        showLoading(true);
        
        const response = await fetch(PAYMENT_REPORTING_API_URL, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            action: 'reportPayment',
            data: {
              invoiceId: invoiceId,
              amount: amount,
              paymentMethod: paymentMethod,
              transactionId: transactionId,
              notes: notes,
              paymentDate: paymentDate
            }
          })
        });
        
        const result = await response.json();
        
        if (result && result.success) {
          showSuccess(`Payment of $${amount.toLocaleString('en-US', {minimumFractionDigits: 2, maximumFractionDigits: 2})} reported successfully!`);
          closeReportPaymentModal();
          loadInvoices(); // Refresh the list
        } else {
          showError('Failed to report payment: ' + (result.error || 'Unknown error'));
        }
      } catch (error) {
        console.error('Error reporting payment:', error);
        showError('Error reporting payment: ' + error.toString());
      } finally {
        showLoading(false);
      }
    }

    /**
     * Mark invoice as paid (full payment)
     */
    async function markInvoiceAsPaid(invoiceId) {
      if (!confirm('Mark this invoice as fully paid? This will record a payment for the remaining balance.')) {
        return;
      }
      
      try {
        showLoading(true);
        
        // First get invoice details to get the balance
        const response = await fetch(API_URL, {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: new URLSearchParams({
            action: 'getInvoiceEstimate',
            id: invoiceId
          })
        });
        
        const invoiceResult = await response.json();
        
        if (!invoiceResult || !invoiceResult.success) {
          showError('Failed to load invoice details');
          return;
        }
        
        const invoice = invoiceResult.data;
        const totalAmount = parseFloat(invoice.total || invoice.totalAmount || 0);
        const totalPaid = parseFloat(invoice.totalPaid || 0);
        const balance = totalAmount - totalPaid;
        
        if (balance <= 0) {
          showError('Invoice is already paid in full');
          return;
        }
        
        // Report payment for remaining balance
        const paymentResponse = await fetch(PAYMENT_REPORTING_API_URL, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            action: 'reportPayment',
            data: {
              invoiceId: invoiceId,
              amount: balance,
              paymentMethod: 'Manual',
              transactionId: 'MARKED-PAID-' + Date.now(),
              notes: 'Marked as paid from Invoices tab',
              paymentDate: new Date().toISOString().split('T')[0]
            }
          })
        });
        
        const paymentResult = await paymentResponse.json();
        
        if (paymentResult && paymentResult.success) {
          showSuccess(`Invoice marked as paid! Payment of $${balance.toLocaleString('en-US', {minimumFractionDigits: 2, maximumFractionDigits: 2})} recorded.`);
          loadInvoices(); // Refresh the list
        } else {
          showError('Failed to mark invoice as paid: ' + (paymentResult.error || 'Unknown error'));
        }
      } catch (error) {
        console.error('Error marking invoice as paid:', error);
        showError('Error marking invoice as paid: ' + error.toString());
      } finally {
        showLoading(false);
      }
    }

