    async function addGeneralBuildMaterials() {
      try {
        // Check if already added
        const existingIndex = lineItems.findIndex(item => item.name && item.name.includes('General Build Materials'));
        if (existingIndex !== -1) {
          if (!confirm('General Build Materials is already in the items list. Add again?')) {
            return;
          }
        }

        const response = await fetch(API_URL, {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: new URLSearchParams({ action: 'getGeneralBuildMaterials' })
        });
        const result = await response.json();
        
        if (result.success && result.materials && result.materials.length > 0) {
          // Add single item (not multiple)
          const material = result.materials[0];
            const item = {
              id: Date.now() + Math.random(),
            code: 'GBM-' + Date.now(),
              name: material.name,
              price: material.price,
              quantity: material.quantity,
              category: material.category,
              unit: material.unit,
            description: material.description || '',
              actualCost: material.actualCost,
              hasMarkup: material.hasMarkup || false,
            fromPriceBook: false,
            requiresUpfrontPayment: material.requiresUpfrontPayment || true,
            itemType: material.itemType || 'material'
            };
            lineItems.push(item);
          
          renderItems();
          calculateTotals();
