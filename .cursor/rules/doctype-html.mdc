    /** POST to API_URL (or gas-proxy) and parse JSON; clear errors for empty/404 HTML responses */
    async function fetchGasPostForm(params) {
      const response = await fetch(API_URL, {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: new URLSearchParams(params)
      });
      const responseText = await response.text();
      if (!response.ok) {
        var extra = '';
        if (response.status === 404 && (API_URL || '').indexOf('gas-proxy') !== -1) {
          extra = ' — gas-proxy not deployed. Use Git + redeploy (or `netlify deploy`), not drag-and-drop. In Netlify set Base directory to `invoice-netlify` (folder must contain netlify/functions/gas-proxy.mjs).';
        }
        throw new Error('HTTP ' + response.status + extra);
      }
      if (!responseText || !String(responseText).trim()) {
        throw new Error('Empty response from server (HTTP ' + response.status + ')');
      }
      try {
        return JSON.parse(responseText);
      } catch (parseErr) {
        throw new Error('Server did not return JSON: ' + String(responseText).substring(0, 200));
      }
    }

