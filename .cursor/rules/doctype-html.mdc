    function searchLaborItems() {
      const query = document.getElementById('laborSearch').value.toLowerCase();
      const filtered = laborItems.filter(item =>
        item.name.toLowerCase().includes(query) ||
        (item.category && item.category.toLowerCase().includes(query)) ||
        (item.description && item.description.toLowerCase().includes(query))
      );
      displayLaborItemsList(filtered);
    }

    function displayLaborItemsList(items) {
      const container = document.getElementById('laborItemsList');
      
      if (items.length === 0) {
        container.innerHTML = '<div style="padding: 40px; text-align: center; color: #9ca3af;">No labor items found. Add items to the "Labor" sheet.</div>';
        return;
      }
      
      container.innerHTML = items.map(item => {
        const priceDisplay = item.unit && item.unit.toLowerCase() === 'flat rate' 
          ? '$' + (item.price || 0).toFixed(2) + ' (Flat Rate)'
          : '$' + (item.price || 0).toFixed(2) + '/' + (item.unit || 'Hour');
        return `
        <div class="item-card" onclick="addLaborItem('${escapeJS(item.name)}', ${item.price || 0}, '${escapeJS(item.category || '')}', '${escapeJS(item.unit || 'Hour')}', '${escapeJS(item.description || '')}')">
          <div class="item-card-name">${escapeHtml(item.name)}</div>
          <div class="item-card-details">
            ${item.category || 'General'} | ${priceDisplay}
            ${item.description ? ' | ' + escapeHtml(item.description.substring(0, 50)) : ''}
          </div>
        </div>
      `;
      }).join('');
    }

    function addLaborItem(name, price, category, unit, description) {
      const item = {
        id: Date.now(),
        code: 'LABOR-' + Date.now(),
        name: name,
        price: parseFloat(price) || 0,
        quantity: 1,
        category: category || 'Labor',
        unit: unit || 'Hour',
        description: description || '',
        isLabor: true,
        actualCost: 0,
        cost: 0,
        isStock: false,
        onHand: false
      };
      lineItems.push(item);
      closeAddLaborModal();
      renderItems();
      calculateTotals();
    }

