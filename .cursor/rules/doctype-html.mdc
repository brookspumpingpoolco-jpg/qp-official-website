    /**
     * Create one-off billing invoice
     */
    async function createOneOffBilling() {
      const projectId = document.getElementById('oneOffBillingProjectId').textContent;
      const description = document.getElementById('oneOffBillingDescription').value.trim();
      const amount = parseFloat(document.getElementById('oneOffBillingAmount').value);
      const quantity = parseFloat(document.getElementById('oneOffBillingQuantity').value) || 1;
      const notes = document.getElementById('oneOffBillingNotes').value.trim();
      const sendEmail = document.getElementById('oneOffBillingSendEmail').checked;
      
      if (!description) {
        showError('Please enter an item/service description');
        return;
      }
      
      if (!amount || amount <= 0) {
        showError('Please enter a valid amount');
        return;
      }
      
      const totalAmount = amount * quantity;
      
      try {
        showLoading(true);
        
        const response = await fetch(API_URL, {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: new URLSearchParams({
            action: 'createOneOffProjectInvoice',
            projectId: projectId,
            description: description,
            amount: totalAmount,
            quantity: quantity,
            unitPrice: amount,
            notes: notes,
            sendEmail: sendEmail ? 'true' : 'false'
          })
        });
        
        const result = await response.json();
        
        if (result && result.success) {
          showSuccess(`One-off invoice created${sendEmail ? ' and sent' : ''} successfully! Invoice ID: ${result.invoiceId}`);
          closeOneOffBillingModal();
          await viewProjectDetail(projectId);
        } else {
          showError('Failed to create invoice: ' + (result.error || 'Unknown error'));
        }
      } catch (error) {
        console.error('Error creating one-off invoice:', error);
        showError('Error creating invoice: ' + error.toString());
      } finally {
        showLoading(false);
      }
    }

