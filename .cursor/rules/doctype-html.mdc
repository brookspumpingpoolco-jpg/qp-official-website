    let _rcptData = null; // holds last payment result for sendReceiptEmails()

    function showReceiptConfirmModal(paymentResult, projectId) {
      _rcptData = { ...paymentResult, projectId };

      const amt = parseFloat(paymentResult.amount || 0);
      document.getElementById('rcptAmountDisplay').textContent = '$' + amt.toFixed(2);
      document.getElementById('rcptMilestoneDisplay').textContent =
        (paymentResult.milestoneName || 'General Payment') + ' · ' + (paymentResult.paymentMethod || '');

      // Customer email display
      const email = paymentResult.customerEmail || '';
      document.getElementById('rcptCustomerEmailDisplay').textContent =
        email ? ('Will be sent to: ' + email) : 'No customer email on file';

      // Build receipt URL (mirrors backend logic)
      const linkedId = paymentResult.invoiceId || projectId;
      const txId     = paymentResult.transactionId || '';
      const viewerBase = 'https://aesthetic-kataifi-88ba27.netlify.app/invoiceestimateviewer.html';
      const rcptUrl  = viewerBase + '?id=' + encodeURIComponent(linkedId)
        + '&receipt=1&txId=' + encodeURIComponent(txId)
        + '&projectId=' + encodeURIComponent(projectId || '');
      _rcptData.receiptUrl = rcptUrl;
      document.getElementById('rcptUrlDisplay').textContent = rcptUrl;

      // Fetch current totals for summary
      const proj = (typeof allProjects !== 'undefined' ? allProjects : []).find(p => p.projectId === projectId) || currentProject;
      const projData = proj ? (proj.projectData || proj.project || {}) : {};
      const total = parseFloat(projData.total || 0);
      // Use totalPaid from currentProject if refreshed, otherwise estimate
      const totalPaid = (currentProject && currentProject.totalPaid) || amt;
      const balance   = Math.max(0, total - totalPaid);

      document.getElementById('rcptBalanceSummary').innerHTML = `
        <div style="background:#eff6ff;border:1px solid #dbeafe;border-radius:8px;padding:14px;text-align:center;">
          <div style="font-size:11px;color:#6b7280;text-transform:uppercase;margin-bottom:4px;">Total Paid</div>
          <div style="font-size:22px;font-weight:700;color:#2563eb;">$${totalPaid.toFixed(2)}</div>
        </div>
        <div style="background:${balance <= 0 ? '#f0fdf4' : '#fef3c7'};border:1px solid ${balance <= 0 ? '#d1fae5' : '#fde68a'};border-radius:8px;padding:14px;text-align:center;">
          <div style="font-size:11px;color:#6b7280;text-transform:uppercase;margin-bottom:4px;">Remaining</div>
          <div style="font-size:22px;font-weight:700;color:${balance <= 0 ? '#059669' : '#d97706'};">$${balance.toFixed(2)}</div>
        </div>`;

      // Reset send button
      const btn = document.getElementById('sendReceiptBtn');
      btn.innerHTML = '<i class="fas fa-paper-plane"></i> Send Receipt + Notify Admin';
      btn.disabled = false;

      document.getElementById('receiptConfirmModal').style.display = 'flex';
    }

