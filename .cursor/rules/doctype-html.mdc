    async function autoGeneratePaymentSchedule() {
      if (lineItems.length === 0) {
        showError('Please add items first before auto-generating payment schedule');
        return;
      }

      // Show progress indicator
      const progressDiv = document.getElementById('autoGenerateProgress');
      const progressBar = document.getElementById('progressBar');
      const progressText = document.getElementById('progressText');
      
      if (progressDiv) {
        progressDiv.style.display = 'block';
        progressBar.style.width = '10%';
        progressText.textContent = 'Analyzing project scope...';
      }

      try {
        const total = getGrandTotal();
        
        // Simulate progress steps with AI messaging
        setTimeout(() => {
          if (progressBar) progressBar.style.width = '20%';
          if (progressText) progressText.textContent = '🤖 AI analyzing project scope...';
        }, 300);
        
        setTimeout(() => {
          if (progressBar) progressBar.style.width = '40%';
          if (progressText) progressText.textContent = '🤖 AI identifying pool components...';
        }, 600);
        
        setTimeout(() => {
          if (progressBar) progressBar.style.width = '60%';
          if (progressText) progressText.textContent = '🤖 AI calculating optimal milestones...';
        }, 900);
        
        setTimeout(() => {
          if (progressBar) progressBar.style.width = '80%';
          if (progressText) progressText.textContent = '🤖 AI optimizing payment schedule...';
        }, 1200);
        
        // Filter out processing fee from items for payment schedule generation
        const itemsForSchedule = lineItems.filter(item => !item.isProcessingFee);
        
        const response = await fetch(API_URL, {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: new URLSearchParams({
            action: 'autoGeneratePaymentSchedule',
            items: JSON.stringify(itemsForSchedule),
            totalAmount: total
          })
        });
        
        setTimeout(() => {
          if (progressBar) progressBar.style.width = '90%';
          if (progressText) progressText.textContent = 'Finalizing schedule...';
        }, 1200);
        
        const result = await response.json();
        
        if (result.success && result.milestones) {
          // Convert milestone IDs to match our format (using 'id' instead of 'milestoneId')
          paymentScheduleMilestones = result.milestones.map(m => ({
            id: m.milestoneId || Date.now() + Math.random(),
            name: m.name,
            percent: m.percent,
            amount: m.amount,
            dueTrigger: m.dueTrigger,
            dueDate: m.dueDate || '',
            duePhase: m.duePhase || ''
          }));
          
          // Complete progress
          if (progressBar) progressBar.style.width = '100%';
          if (progressText) progressText.textContent = 'Schedule generated successfully!';
          
          setTimeout(() => {
            if (progressDiv) progressDiv.style.display = 'none';
            renderPaymentScheduleBuilder();
          renderPaymentSchedulePreview();
            updatePaymentScheduleTotals();
          showSuccess(`Payment schedule auto-generated! Materials: ${result.summary.materialsCount}, Labor: ${result.summary.laborCount}`);
          }, 500);
        } else {
          if (progressDiv) progressDiv.style.display = 'none';
          showError('Failed to auto-generate: ' + (result.error || 'Unknown error'));
        }
      } catch (error) {
        if (progressDiv) progressDiv.style.display = 'none';
        showError('Error auto-generating payment schedule: ' + error.message);
      }
    }

