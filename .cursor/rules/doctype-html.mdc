    /**
     * Check for projects that need contracts
     * Compares approved projects with existing contracts
     */
    async function checkProjectsNeedingContracts() {
      try {
        console.log('🔍 Checking for projects needing contracts...');
        
        // Load all approved projects
        const projectsResponse = await fetch(SCRIPT_URL, {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: new URLSearchParams({
            action: 'getAllProjects'
          })
        });
        
        if (!projectsResponse.ok) {
          console.warn('⚠️ Failed to load projects for contract check');
          return;
        }
        
        const projectsResult = await projectsResponse.json();
        
        if (!projectsResult.success || !projectsResult.projects) {
          console.warn('⚠️ No projects data available');
          return;
        }
        
        const allProjectsData = projectsResult.projects;
        
        // Update global allProjects so metrics and contract form can use this data
        if (!allProjects || allProjects.length === 0) {
          allProjects = allProjectsData;
          console.log('📦 Updated global allProjects with', allProjects.length, 'projects');
        }
        
        // Filter for approved/active projects only
        const approvedProjects = allProjectsData.filter(p => 
          p.status === 'Approved' || p.status === 'In Progress' || p.status === 'Active'
        );
        
        console.log(`📋 Found ${approvedProjects.length} approved projects`);
        
        // Check which projects don't have contracts
        projectsNeedingContracts = [];
        
        for (const project of approvedProjects) {
          // Check if this project has any contracts
          const hasContract = allContracts.some(contract => 
            contract.projectId === project.projectId
          );
          
          if (!hasContract) {
            projectsNeedingContracts.push(project);
          }
        }
        
        console.log(`⚠️ ${projectsNeedingContracts.length} projects need contracts`);
        console.log('📦 Projects data:', projectsNeedingContracts);
        
        // Display alert
        console.log('🚀 About to call displayProjectsNeedingContractsAlert...');
        try {
          displayProjectsNeedingContractsAlert();
          console.log('✅ displayProjectsNeedingContractsAlert completed');
        } catch (error) {
          console.error('❌ Error in displayProjectsNeedingContractsAlert:', error);
        }
        
        // Re-render contracts list now that we know about projects needing contracts
        console.log('🔄 Re-rendering contracts list with updated project info...');
        renderContractsList();
        
        // Re-calculate metrics now that we know projects needing contracts count
        loadContractMetrics();
        
      } catch (error) {
        console.error('❌ Error checking projects needing contracts:', error);
      }
    }
    
