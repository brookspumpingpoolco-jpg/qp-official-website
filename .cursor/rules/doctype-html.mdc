                    <input type="text" id="contractTitle" required placeholder="e.g., Pool Installation Agreement" style="width: 100%; padding: 12px; border: 2px solid #e5e7eb; border-radius: 8px;">
                  </div>
                </div>
                
                <div style="margin-bottom: 20px;">
                  <label style="display: block; margin-bottom: 8px; font-weight: 600;">Customer Name *</label>
                  <input type="text" id="contractCustomerName" required style="width: 100%; padding: 12px; border: 2px solid #e5e7eb; border-radius: 8px;">
                </div>
                
                <div style="margin-bottom: 20px;">
                  <label style="display: block; margin-bottom: 8px; font-weight: 600;">Customer Email *</label>
                  <input type="email" id="contractCustomerEmail" required style="width: 100%; padding: 12px; border: 2px solid #e5e7eb; border-radius: 8px;">
                </div>
                
                <div style="margin-bottom: 20px;">
                  <label style="display: block; margin-bottom: 8px; font-weight: 600;">Customer Address</label>
                  <textarea id="contractCustomerAddress" rows="2" style="width: 100%; padding: 12px; border: 2px solid #e5e7eb; border-radius: 8px;"></textarea>
                </div>
                
                <div style="margin-bottom: 20px;">
                  <label style="display: block; margin-bottom: 8px; font-weight: 600;">Total Amount *</label>
                  <input type="number" id="contractAmount" required step="0.01" min="0" style="width: 100%; padding: 12px; border: 2px solid #e5e7eb; border-radius: 8px;">
