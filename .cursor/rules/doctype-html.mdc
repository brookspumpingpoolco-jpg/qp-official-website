    /**
     * Submit admin signature
     */
    async function submitAdminSignature() {
      const estimateId = currentSigningEstimateId;
      const adminName = document.getElementById('adminPrintedName').value;
      
      if (!adminName.trim()) {
        showError('Please enter your printed name');
        return;
      }
      
      if (adminSignaturePad.isEmpty()) {
        showError('Please sign the contract');
        return;
      }
      
      if (!confirm('Counter-sign this estimate? This will generate a fully executed PDF with both signatures and email it to the customer.')) return;
      
      try {
        showLoading(true);
        
        const signatureData = adminSignaturePad.toDataURL();

        const response = await fetch(API_URL, {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: new URLSearchParams({
            action: 'adminSignContract',
            estimateId: estimateId,
            signatureData: signatureData,
            adminName: adminName
          })
        });

        const result = await response.json();

        if (result && result.success) {
          showSuccess('Estimate countersigned! The customer has been notified.');
          closeAdminSignatureModal();
          if (typeof loadPendingActions === 'function') loadPendingActions();
          if (typeof loadInvoices === 'function') loadInvoices();
          // Refresh the banner so the signed estimate disappears immediately
          if (typeof loadEstimatesAwaitingSignature === 'function') loadEstimatesAwaitingSignature();
        } else {
          showError('Failed to countersign: ' + (result.error || 'Unknown error'));
        }
      } catch (error) {
        console.error('Error signing contract:', error);
        showError('Error signing contract: ' + error.toString());
      } finally {
        showLoading(false);
      }
    }

    /**
     * Send full invoice/estimate with PDF and full email
     */
    async function sendFullInvoiceEstimate(invoiceId) {
      try {
        showLoading(true);
        
        const resolvedInvoiceId = invoiceId || currentEditingQuoteId || currentInvoiceId || '';
        if (!resolvedInvoiceId) {
          showError('Cannot send yet: invoice/estimate ID is missing. Save draft first, then send.');
          return;
        }
        
        // First, get the invoice/estimate data
        const response = await fetch(API_URL, {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: new URLSearchParams({
            action: 'getInvoiceEstimate',
            id: resolvedInvoiceId
          })
        });
        
        const invoiceResult = await response.json();
        
        if (!invoiceResult.success || !invoiceResult.data) {
          showError('Failed to load invoice/estimate: ' + (invoiceResult.error || 'Unknown error'));
          return;
        }
        
        const invoiceData = invoiceResult.data;
        const type = invoiceData.type || 'Invoice';
        
        if (!confirm(`Send this ${type.toLowerCase()} to the customer with PDF attachment and full details?`)) {
          return;
        }
        
        // Prepare data for sending
        const sendData = {
          id: resolvedInvoiceId,
          type: type,
          customerName: invoiceData.customerName || '',
          customerEmail: invoiceData.customerEmail || '',
          customerPhone: invoiceData.customerPhone || '',
          customerAddress: invoiceData.customerAddress || '',
          items: invoiceData.items || '[]',
          taxRate: invoiceData.taxRate || 0,
          discount: invoiceData.discount || 0,
          notes: invoiceData.notes || '',
          terms: invoiceData.terms || '',
          invoiceNumber: invoiceData.invoiceNumber || resolvedInvoiceId,
          quoteNumber: invoiceData.quoteNumber || resolvedInvoiceId,
          date: invoiceData.date || new Date().toISOString(),
          dueDate: invoiceData.dueDate || '',
          status: invoiceData.status || 'Draft',
          serviceType: invoiceData.serviceType || '',
          serviceDescription: invoiceData.serviceDescription || '',
          serviceAddress: invoiceData.serviceAddress || '',
          priority: invoiceData.priority || 'Normal'
        };
        
        // Send the invoice/estimate
        const sendResponse = await fetch(API_URL, {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: new URLSearchParams({
            action: 'sendInvoiceEstimate',
            data: JSON.stringify(sendData)
          })
        });
        
        const sendResult = await sendResponse.json();
        
        if (sendResult && sendResult.success) {
          showSuccess(`${type} sent successfully! Customer will receive the full email with PDF attachment.`);
          loadPendingActions(); // Refresh the list
        } else {
          showError('Failed to send ' + type.toLowerCase() + ': ' + (sendResult.error || 'Unknown error'));
        }
      } catch (error) {
        console.error('Error sending invoice/estimate:', error);
        showError('Error sending invoice/estimate: ' + error.toString());
      } finally {
        showLoading(false);
      }
    }

