    /**
     * Send manual payment link email
     */
    async function sendManualPaymentLinkEmail() {
      if (!currentPaymentLinkInvoiceId) {
        showError('Invoice ID not found');
        return;
      }
      
      const amount = parseFloat(document.getElementById('paymentLinkAmount').value);
      const notes = document.getElementById('paymentLinkNotes').value.trim();
      const customerEmail = document.getElementById('paymentLinkCustomerEmail').textContent;
      
      if (!amount || amount <= 0) {
        showError('Please enter a valid payment amount');
        document.getElementById('paymentLinkAmount').focus();
        return;
      }
      
      if (amount > currentPaymentLinkInvoiceTotal) {
        showError('Payment amount cannot exceed invoice total of $' + currentPaymentLinkInvoiceTotal.toFixed(2));
        document.getElementById('paymentLinkAmount').focus();
        return;
      }
      
      if (!customerEmail || customerEmail === 'N/A') {
        showError('Customer email is required');
        return;
      }
      
      try {
        showLoading(true);
        
        const response = await fetch(API_URL, {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: new URLSearchParams({
            action: 'sendManualPaymentLink',
            data: JSON.stringify({
              invoiceId: currentPaymentLinkInvoiceId,
              customerEmail: customerEmail,
              amount: amount,
              notes: notes
            })
          })
        });
        
        const result = await response.json();
        
        if (result.success) {
          const message = result.isPartialPayment 
            ? `Payment link sent for $${amount.toFixed(2)}. Remaining balance: $${result.remainingBalance.toFixed(2)}`
            : `Payment link sent successfully for $${amount.toFixed(2)}`;
          showSuccess(message);
          closeSendPaymentLinkModal();
          if (typeof loadPendingActions === 'function') {
            loadPendingActions(); // Refresh the list
          }
        } else {
          showError('Failed to send payment link: ' + (result.error || 'Unknown error'));
        }
      } catch (error) {
        console.error('Error sending payment link:', error);
        showError('Error sending payment link: ' + error.message);
      } finally {
        showLoading(false);
      }
    }

