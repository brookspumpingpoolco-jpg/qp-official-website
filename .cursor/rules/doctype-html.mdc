    /**
     * Save Terms & Conditions for a project
     */
    async function saveProjectTerms(projectId) {
      const textarea = document.getElementById('termsTextarea_' + projectId);
      if (!textarea) return;
      const terms = textarea.value;
      try {
        showLoading(true);
        const response = await fetch(API_URL, {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: new URLSearchParams({ action: 'saveProjectTerms', projectId, terms })
        });
        const result = await response.json();
        if (result && result.success) {
          showSuccess('Terms & conditions saved! They will appear on all invoices for this project.');
          // Update the display block with the new terms
          const displayBlock = document.getElementById('termsDisplayBlock_' + projectId);
          const editBlock = document.getElementById('termsEditBlock_' + projectId);
          if (displayBlock) {
            if (terms.trim()) {
              displayBlock.innerHTML = `<div style="background: #f8fafc; border-radius: 8px; padding: 16px; font-size: 14px; color: #374151; white-space: pre-wrap; line-height: 1.7; border: 1px solid #e2e8f0;">${escapeHtml(terms)}</div>`;
            } else {
              displayBlock.innerHTML = `<div style="text-align: center; padding: 24px; color: #94a3b8; background: #f8fafc; border-radius: 8px; border: 1px dashed #cbd5e1;"><i class="fas fa-file-alt" style="font-size: 28px; margin-bottom: 8px;"></i><p style="margin: 0; font-size: 14px;">No terms &amp; conditions set for this project.</p></div>`;
            }
          }
          if (editBlock) editBlock.style.display = 'none';
          if (displayBlock) displayBlock.style.display = 'block';
          // Update currentProject's terms in memory
          if (currentProject && currentProject.projectId === projectId) {
            if (currentProject.projectData) currentProject.projectData.terms = terms;
          }
        } else {
          showError('Failed to save terms: ' + (result ? result.error : 'Unknown error'));
        }
      } catch (error) {
        showError('Error saving terms: ' + error.toString());
      } finally {
        showLoading(false);
      }
    }

