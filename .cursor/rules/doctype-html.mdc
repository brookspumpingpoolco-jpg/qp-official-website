    function renderItems() {
      const tbody = document.getElementById('itemsTableBody');
      
      // Check if any items are in profit mode
      const hasProfitItems = lineItems.some(item => item.isProfit || item.isProfitTracked);
      const costColumnHeader = document.querySelector('.profit-cost-column');
      if (costColumnHeader) {
        costColumnHeader.style.display = hasProfitItems ? 'table-cell' : 'none';
      }
      
      // Update colspan for empty state (7 base columns: Item, Qty, Price, Cost (conditional), Total, Stock, Star, Delete)
      const emptyColspan = hasProfitItems ? 8 : 7;
      
      if (lineItems.length === 0) {
        tbody.innerHTML = '<tr><td colspan="' + emptyColspan + '" style="text-align: center; padding: 40px; color: #9ca3af;">No items added yet. Click "Add from Price Book" or "Add Custom Item" to get started.</td></tr>';
        return;
      }
      
      var rows = [];
      for (var idx = 0; idx < lineItems.length; idx++) {
