          document.getElementById('newExpenseVendor').value = receiptData.vendor || '';
          document.getElementById('newExpenseInvoiceNumber').value = receiptData.invoiceNumber || '';
          document.getElementById('newExpenseReceiptUrl').value = receiptData.receiptUrl || '';
          document.getElementById('newExpenseNotes').value = receiptData.notes || '';
          
          // Update modal title
          const modalTitle = document.querySelector('#addExpenseModal h2');
          if (modalTitle) modalTitle.innerHTML = '<i class="fas fa-edit"></i> Edit Expense';
          
          // Open modal
          document.getElementById('addExpenseModal').style.display = 'flex';
        } else {
          showError('Failed to load expense: ' + (result.error || 'Unknown error'));
        }
      } catch (error) {
        console.error('Error loading expense:', error);
        showError('Error loading expense: ' + error.toString());
      } finally {
        showLoading(false);
      }
    }
    
    /**
     * Delete expense
     */
    async function deleteExpense(expenseId) {
      if (!confirm('Are you sure you want to delete this expense? This action cannot be undone.')) {
        return;
      }
      
      try {
        showLoading(true);
        
        const response = await fetch(API_URL, {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: new URLSearchParams({
            action: 'deleteExpense',
            expenseId: expenseId
          })
        });
        
        const result = await response.json();
        
        if (result.success) {
          showSuccess('Expense deleted successfully!');
