          const initResponse = await fetch(API_URL, {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: new URLSearchParams({ 
              action: 'getInitialData',
              email: userEmail || ''
            })
          });
          const initResult = await initResponse.json();
          if (initResult.success) {
            defaultLaborSets = initResult.defaultLaborSets.sets || [];
            renderDefaultLaborSets();
          }
        } else {
          showError('Failed to save labor set: ' + (result.error || 'Unknown error'));
        }
      } catch (error) {
        showError('Error saving labor set: ' + error.message);
      }
    }

    // Profit Calculator
    async function calculateProfit() {
      if (lineItems.length === 0) {
        showError('Add items first to calculate profit');
        return;
      }
      
      // Only calculate profit for items marked for profit tracking
      // Check both isProfit and isProfitTracked flags
      const profitItems = lineItems.filter(item => item.isProfit || item.isProfitTracked);
      
      if (profitItems.length === 0) {
        showError('Mark items with stars for profit tracking first');
        return;
      }
      
      console.log('Calculating profit for starred items:', profitItems);
      console.log('Profit items count:', profitItems.length);
      showError('Calculating profit...');
      
      try {
        // Use google.script.run if available (no CORS issues when served from webapp)
        let result;
        
        if (typeof google !== 'undefined' && google.script && google.script.run) {
          console.log('Using google.script.run for profit calculation');
          result = await new Promise((resolve, reject) => {
            google.script.run
              .withSuccessHandler(resolve)
              .withFailureHandler(reject)
              .calculateProfit({ items: JSON.stringify(profitItems) });
          });
        } else {
          console.log('Using fetch for profit calculation');
        const response = await fetch(API_URL, {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: new URLSearchParams({
            action: 'calculateProfit',
              data: JSON.stringify({ items: JSON.stringify(profitItems) })
          })
        });
          result = await response.json();
        }
        
        console.log('Profit calculation result:', result);
        
        if (result && result.success) {
          const placeholderEl = document.getElementById('profitPlaceholder');
          const resultsEl = document.getElementById('profitResults');
          
          if (placeholderEl) placeholderEl.style.display = 'none';
          if (resultsEl) resultsEl.style.display = 'block';
          
          // Update display elements with safety checks
          const revenueEl = document.getElementById('profitRevenue');
          const costEl = document.getElementById('profitCost');
          const amountEl = document.getElementById('profitAmount');
          const marginEl = document.getElementById('profitMargin');
          const markupEl = document.getElementById('profitMarkup');
          
          if (revenueEl) revenueEl.textContent = '$' + (result.totalRevenue || 0).toFixed(2);
          if (costEl) costEl.textContent = '$' + (result.totalCost || 0).toFixed(2);
          if (amountEl) {
            amountEl.textContent = '$' + (result.profit || 0).toFixed(2);
            // Color code profit
            const profit = result.profit || 0;
            if (profit > 0) {
              amountEl.style.color = '#10b981';
            } else if (profit < 0) {
              amountEl.style.color = '#ef4444';
          } else {
              amountEl.style.color = '#6b7280';
          }
          }
          
          // Show materials profit
          const materialsProfitEl = document.getElementById('materialsProfit');
          const materialsProfitRow = document.getElementById('materialsProfitRow');
          if (result.materialsProfit !== undefined) {
            if (materialsProfitEl) materialsProfitEl.textContent = '$' + result.materialsProfit.toFixed(2);
            if (materialsProfitRow) materialsProfitRow.style.display = 'flex';
          } else {
            if (materialsProfitRow) materialsProfitRow.style.display = 'none';
          }
          
          // Show labor profit
          const laborProfitEl = document.getElementById('laborProfit');
          const laborProfitRow = document.getElementById('laborProfitRow');
          if (result.laborProfit !== undefined) {
            if (laborProfitEl) laborProfitEl.textContent = '$' + result.laborProfit.toFixed(2);
            if (laborProfitRow) laborProfitRow.style.display = 'flex';
          } else {
            if (laborProfitRow) laborProfitRow.style.display = 'none';
          }
          
          // Show stock/on hand profits if any
          const stockProfitEl = document.getElementById('stockProfit');
          const stockProfitRow = document.getElementById('stockProfitRow');
          if (result.stockProfit && result.stockProfit > 0) {
            if (stockProfitEl) stockProfitEl.textContent = '$' + result.stockProfit.toFixed(2);
            if (stockProfitRow) stockProfitRow.style.display = 'flex';
          } else {
            if (stockProfitRow) stockProfitRow.style.display = 'none';
          }
          
          // Update final profit with expenses
          updateProfitWithExpenses();
          
          if (marginEl) marginEl.textContent = (result.profitMargin || 0).toFixed(1) + '%';
          if (markupEl) markupEl.textContent = (result.markup || 0).toFixed(1) + '%';
          
          showSuccess('Profit calculated successfully');
        } else {
          showError('Failed to calculate profit: ' + (result?.error || 'Unknown error'));
        }
      } catch (error) {
        showError('Error calculating profit: ' + error.message);
      }
    }

