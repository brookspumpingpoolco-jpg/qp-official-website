                <label style="display: block; margin-bottom: 8px; font-weight: 600; color: #0f172a; font-size: 14px;">
                  <i class="fas fa-dollar-sign"></i> Payment Amount *
                </label>
                <input type="text" id="manualPaymentAmount" inputmode="decimal" required
                       style="width: 100%; padding: 14px 16px; border: 2px solid #3b82f6; border-radius: 10px; font-size: 18px; font-weight: 600; color: #0f172a; background: #f8fafc; transition: all 0.2s; box-shadow: 0 2px 4px rgba(59, 130, 246, 0.1);"
                       placeholder="0.00" 
                       oninput="formatPaymentAmountInput(this)"
                       onfocus="this.style.borderColor='#2563eb'; this.style.boxShadow='0 0 0 3px rgba(59, 130, 246, 0.1)'; this.style.background='white';"
                       onblur="formatPaymentAmountBlur(this); this.style.borderColor='#e5e7eb'; this.style.boxShadow='0 2px 4px rgba(59, 130, 246, 0.1)'; this.style.background='#f8fafc';">
              </div>
              
              <!-- Milestone (shown only for project payments) -->
              <div id="manualPaymentMilestoneRow" style="margin-bottom: 24px; display: none;">
                <label style="display: block; margin-bottom: 8px; font-weight: 600; color: #0f172a; font-size: 14px;">
                  <i class="fas fa-flag-checkered"></i> Apply to Milestone
                </label>
                <select id="manualPaymentMilestoneSelect"
                        style="width: 100%; padding: 12px; border: 2px solid #e5e7eb; border-radius: 8px; font-size: 14px;">
                  <option value="">— General payment (no specific milestone) —</option>
                </select>
              </div>

              <!-- Payment Method -->
              <div style="margin-bottom: 24px;">
                <label style="display: block; margin-bottom: 8px; font-weight: 600; color: #0f172a; font-size: 14px;">
                  <i class="fas fa-credit-card"></i> Payment Method *
                </label>
                <select id="manualPaymentMethod" required
                        style="width: 100%; padding: 12px; border: 2px solid #e5e7eb; border-radius: 8px; font-size: 14px;">
                  <option value="">Select payment method</option>
                  <option value="Cash">Cash</option>
                  <option value="Check">Check</option>
                  <option value="Bank Transfer">Bank Transfer</option>
                  <option value="Money Order">Money Order</option>
                  <option value="Other">Other</option>
                </select>
              </div>
              
              <!-- Payment Date -->
              <div style="margin-bottom: 24px;">
                <label style="display: block; margin-bottom: 8px; font-weight: 600; color: #0f172a; font-size: 14px;">
                  <i class="fas fa-calendar"></i> Payment Date *
                </label>
                <input type="date" id="manualPaymentDate" required
                       style="width: 100%; padding: 12px; border: 2px solid #e5e7eb; border-radius: 8px; font-size: 14px;"
                       value="">
              </div>
              
              <!-- Payment Notes -->
              <div style="margin-bottom: 24px;">
                <label style="display: block; margin-bottom: 8px; font-weight: 600; color: #0f172a; font-size: 14px;">
                  <i class="fas fa-sticky-note"></i> Notes (Optional)
