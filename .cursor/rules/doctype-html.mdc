        const response = await fetch(ITEM_LIST_URL, {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: new URLSearchParams({
            action: 'addLaborToPriceBook',
            laborData: JSON.stringify(laborData)
          })
