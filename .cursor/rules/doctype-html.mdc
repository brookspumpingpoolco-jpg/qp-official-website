    async function loadDefaultLaborSet(setId) {
      const set = defaultLaborSets.find(s => s.id === setId);
      if (!set || !set.laborItems) {
        showError('Labor set not found');
        return;
      }
      
      // Add all labor items from the set
      set.laborItems.forEach(laborItem => {
        const item = {
          id: Date.now() + Math.random(),
          code: 'LABOR-' + Date.now(),
          name: laborItem.name || laborItem,
          price: parseFloat(laborItem.price) || 0,
          quantity: parseFloat(laborItem.quantity) || 1,
          category: laborItem.category || 'Labor',
          unit: laborItem.unit || 'Hour',
          description: laborItem.description || '',
          isLabor: true
        };
        lineItems.push(item);
      });
      
      renderItems();
      calculateTotals();
      closeDefaultLaborSetsModal();
      showSuccess(`Loaded ${set.laborItems.length} labor item(s) from "${set.name}"`);
    }

    async function saveCurrentLaborAsSet() {
      // Get all labor items from current line items
      const currentLaborItems = lineItems.filter(item => item.isLabor === true);
      
      if (currentLaborItems.length === 0) {
        showError('No labor items in current invoice. Add labor items first.');
        return;
      }
      
      const name = prompt('Labor Set Name:');
      if (!name) return;
      
      const description = prompt('Description (optional):') || '';
      
      try {
        const response = await fetch(API_URL, {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: new URLSearchParams({
            action: 'saveDefaultLaborSet',
            data: JSON.stringify({
              name: name,
              description: description,
              laborItems: currentLaborItems
            })
          })
        });
        const result = await response.json();
        
        if (result.success) {
          showSuccess('Labor set saved successfully!');
          // Reload default labor sets
          // Get user email if not already set
          if (!userEmail) {
            userEmail = getUserEmail();
