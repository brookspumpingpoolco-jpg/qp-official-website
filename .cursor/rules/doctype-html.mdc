    /**
     * Convert invoice/estimate to project
     */
    async function convertEstimateToProject(invoiceId, invoiceNumber) {
      const documentType = invoiceNumber && invoiceNumber.includes('Estimate') ? 'estimate' : 'invoice/estimate';
      if (!confirm(`Convert this ${documentType} to a project? This will create a new project with all invoice/estimate details, items, and payment schedule.`)) {
        return;
      }
      
      try {
        showLoading(true);
        
        const response = await fetch(API_URL, {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: new URLSearchParams({
            action: 'createProjectFromEstimate',
            id: invoiceId
          })
        });
        
        const result = await response.json();
        showLoading(false);
        
        if (result.success) {
          showSuccess(`${documentType.charAt(0).toUpperCase() + documentType.slice(1)} converted to project successfully! Project ID: ${result.projectId}`);
          // Reload invoices to show the updated project link
          setTimeout(() => {
            loadInvoices();
          }, 2000);
        } else {
          showError('Failed to convert to project: ' + (result.error || 'Unknown error'));
        }
      } catch (error) {
        showLoading(false);
        showError('Error converting to project: ' + error.message);
      }
    }

