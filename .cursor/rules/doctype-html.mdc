              <div style="display: flex; gap: 8px; align-items: center;">
                <span id="projectShopBadge" style="display: none; background: #ede9fe; color: #5b21b6; font-size: 12px; font-weight: 700; padding: 3px 10px; border-radius: 10px;"></span>
                <button type="button" onclick="openQuickShopModal('${project.projectId}')" style="padding:5px 10px;font-size:12px;font-weight:600;background:#7c3aed;color:#fff;border:none;border-radius:6px;cursor:pointer;"><i class="fas fa-plus"></i> Add Item</button>
              </div>
            </div>
            <div id="projectShoppingContent">
              <div style="text-align:center;padding:16px;color:#94a3b8;"><i class="fas fa-spinner fa-spin"></i></div>
            </div>
          </div>

          <!-- Forecast — expected project payments -->
          <div style="background: white; padding: 20px; border-radius: 12px; border: 2px solid #e5e7eb; margin-bottom: 25px;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 14px;">
              <h3 style="margin: 0;"><i class="fas fa-chart-bar" style="color:#0369a1;"></i> Forecast Payments</h3>
              <button type="button" onclick="openQuickForecastModal('${project.projectId}', '${project.customerName || ''}', '${project.estimateId || ''}')" style="padding:5px 10px;font-size:12px;font-weight:600;background:#0369a1;color:#fff;border:none;border-radius:6px;cursor:pointer;"><i class="fas fa-plus"></i> Add Expected Payment</button>
            </div>
            <div id="projectForecastContent">
              <div style="text-align:center;padding:16px;color:#94a3b8;"><i class="fas fa-spinner fa-spin"></i></div>
            </div>
          </div>

          <!-- Quick Actions -->
          <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 15px; margin-bottom: 25px;">
            <button type="button" class="btn btn-primary" onclick="openOneOffBillingModal('${project.projectId}')">
              <i class="fas fa-file-invoice-dollar"></i> Bill One-Off Item
            </button>
            <button type="button" class="btn btn-info" onclick="openWorkOrderModal('${project.projectId}')">
              <i class="fas fa-clipboard-list"></i> Create Work Order
            </button>
            <button type="button" class="btn btn-primary" onclick="quickAddExpense('${project.projectId}')">
              <i class="fas fa-receipt"></i> Add Expense
            </button>
            <button type="button" class="btn btn-success" onclick="quickSendUpdate('${project.projectId}')">
              <i class="fas fa-paper-plane"></i> Send Update
            </button>
            <button type="button" class="btn btn-secondary" onclick="closeProjectDetail()">
              <i class="fas fa-times"></i> Close
            </button>
          </div>
          
          <!-- Project Preview Section -->
          <div style="background: white; padding: 20px; border-radius: 12px; border: 2px solid #e5e7eb;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
              <h3 style="margin: 0;"><i class="fas fa-eye"></i> Project Preview</h3>
              <button type="button" class="btn btn-secondary" onclick="updateProjectPreview('${project.projectId}')" style="padding: 6px 12px; font-size: 13px;">
                <i class="fas fa-sync-alt"></i> Refresh Preview
              </button>
            </div>
            <div style="background: #f8fafc; border: 1px solid #d1d5db; border-radius: 8px; overflow: hidden;">
              <iframe id="projectPreviewIframe" style="width: 100%; height: 500px; border: none; display: block;"></iframe>
            </div>
            <p style="margin: 12px 0 0 0; color: #64748b; font-size: 13px;">
              <i class="fas fa-info-circle"></i> This preview shows how the project information appears to customers
            </p>
          </div>
        </div>
      `;
      
      document.getElementById('projectDetailContent').innerHTML = html;
      
      // Position cash emojis randomly
      setTimeout(() => {
        const container = document.getElementById('cashEmojiContainer_' + project.projectId);
        if (container) {
          const emojis = container.querySelectorAll('div');
          emojis.forEach((emoji, i) => {
            const left = 10 + (i * 20) % 80;
            const top = 10 + (i * 15) % 70;
            emoji.style.left = left + '%';
            emoji.style.top = top + '%';
          });
        }
      }, 100);
      
      // Add tab switching event listeners
      setTimeout(() => {
        const tabs = document.querySelectorAll(`.payment-tab[data-project-id="${project.projectId}"]`);
        tabs.forEach(tab => {
          tab.addEventListener('click', function() {
            const tabType = this.getAttribute('data-tab');
            const projectId = this.getAttribute('data-project-id');
            
            // Update active state
            tabs.forEach(t => t.classList.remove('active'));
            this.classList.add('active');
            
            // Show/hide content
            const scheduleContent = document.getElementById('paymentScheduleContent_' + projectId);
            const historyContent = document.getElementById('paymentHistoryContent_' + projectId);
            
            if (tabType === 'schedule') {
              if (scheduleContent) scheduleContent.style.display = 'block';
              if (historyContent) historyContent.style.display = 'none';
            } else {
              if (scheduleContent) scheduleContent.style.display = 'none';
              if (historyContent) historyContent.style.display = 'block';
            }
          });
        });
      }, 50);
      
      // Load contracts for this project
      loadProjectContracts(project.projectId);

      // Load purchase orders + shopping list + forecast for this project (all from Accounting)
      loadProjectPurchaseOrders(project.projectId);
      loadProjectShoppingList(project.projectId);
      loadProjectForecastPayments(project.projectId);
      
      // Initialize preview after content is loaded
      setTimeout(() => {
        updateProjectPreview(project.projectId);
      }, 100);
    }

    /** Refresh all accounting sections for a project (called after adding expense, etc.) */
    function refreshProjectDetailSections(projectId) {
      if (!projectId) return;
      const poContent = document.getElementById('projectPOContent');
      if (poContent) loadProjectPurchaseOrders(projectId);
      const shopContent = document.getElementById('projectShoppingContent');
      if (shopContent) loadProjectShoppingList(projectId);
      const fcContent = document.getElementById('projectForecastContent');
      if (fcContent) loadProjectForecastPayments(projectId);
    }

    /**
     * Load purchase orders linked to this project from the Purchase_Orders accounting sheet.
     */
    async function loadProjectPurchaseOrders(projectId) {
      const container = document.getElementById('projectPOContent');
      if (!container) return;
      try {
        const response = await fetch(appendGasQuery(SCRIPT_URL, 'action=getPurchaseOrdersForProject&projectId=' + encodeURIComponent(projectId)));
        const result   = await response.json();
        if (!result.success) {
          container.innerHTML = '<div style="color:#64748b;font-size:13px;padding:8px;">Could not load purchase orders.</div>';
          return;
        }
        const orders = result.orders || [];
        const badge  = document.getElementById('projectPOBadge');
        if (badge) {
          if (orders.length > 0) { badge.textContent = orders.length + ' PO' + (orders.length > 1 ? 's' : ''); badge.style.display = 'inline-block'; }
          else { badge.style.display = 'none'; }
        }
        if (orders.length === 0) {
          container.innerHTML = '<div style="text-align:center;padding:24px;color:#94a3b8;"><i class="fas fa-shopping-cart" style="font-size:32px;margin-bottom:8px;opacity:.35;display:block;"></i><p style="margin:0;font-size:13px;">No purchase orders for this project yet.</p></div>';
          return;
        }
        const statusColor = s => s === 'Received' ? '#d1fae5' : s === 'Ordered' ? '#dbeafe' : '#fef3c7';
        const statusTxt   = s => s === 'Received' ? '#065f46' : s === 'Ordered' ? '#1e40af' : '#92400e';
        container.innerHTML = '<div style="overflow-x:auto;"><table style="width:100%;border-collapse:collapse;font-size:13px;">'
          + '<thead><tr style="background:#f8fafc;border-bottom:2px solid #e5e7eb;">'
          + '<th style="padding:9px 12px;text-align:left;font-size:11px;font-weight:700;text-transform:uppercase;color:#64748b;">Vendor</th>'
          + '<th style="padding:9px 12px;text-align:left;font-size:11px;font-weight:700;text-transform:uppercase;color:#64748b;">Description</th>'
          + '<th style="padding:9px 12px;text-align:left;font-size:11px;font-weight:700;text-transform:uppercase;color:#64748b;">Amount</th>'
          + '<th style="padding:9px 12px;text-align:left;font-size:11px;font-weight:700;text-transform:uppercase;color:#64748b;">Status</th>'
          + '<th style="padding:9px 12px;text-align:left;font-size:11px;font-weight:700;text-transform:uppercase;color:#64748b;">Ref #</th>'
          + '<th style="padding:9px 12px;text-align:left;font-size:11px;font-weight:700;text-transform:uppercase;color:#64748b;">Receipt</th>'
          + '</tr></thead><tbody>'
          + orders.map((o, idx) => {
              const rowBg = idx % 2 === 0 ? '#fff' : '#f8fafc';
              const receipt = o.receiptUrl
                ? `<a href="${o.receiptUrl}" target="_blank" style="color:#2563eb;font-size:12px;"><i class="fas fa-external-link-alt"></i> View</a>`
                : '<span style="color:#94a3b8;font-size:11px;">—</span>';
              return `<tr style="border-bottom:1px solid #f1f5f9;background:${rowBg};">
                <td style="padding:10px 12px;font-weight:600;">${o.vendor||'—'}</td>
                <td style="padding:10px 12px;color:#374151;">${o.description||'—'}</td>
                <td style="padding:10px 12px;font-weight:700;">$${parseFloat(o.estAmount||0).toFixed(2)}</td>
                <td style="padding:10px 12px;"><span style="padding:3px 9px;border-radius:10px;font-size:11px;font-weight:700;background:${statusColor(o.status)};color:${statusTxt(o.status)};">${o.status}</span></td>
                <td style="padding:10px 12px;font-size:12px;color:#64748b;">${o.referenceNum||'—'}</td>
                <td style="padding:10px 12px;">${receipt}</td>
              </tr>`;
            }).join('')
          + '</tbody></table></div>';
      } catch (err) {
        console.error('loadProjectPurchaseOrders error:', err);
        if (container) container.innerHTML = '<div style="color:#64748b;font-size:13px;padding:8px;">Could not load purchase orders.</div>';
      }
    }
    
    // ── Shopping List for a project (from Accounting) ─────────────────────────
    async function loadProjectShoppingList(projectId) {
      const container = document.getElementById('projectShoppingContent');
      const badge     = document.getElementById('projectShopBadge');
      if (!container) return;
      try {
        const r = await acctGet('getShoppingList');
        if (!r.success) { container.innerHTML = '<div style="color:#94a3b8;font-size:13px;padding:8px;">Could not load shopping list.</div>'; return; }
        const items = (r.items || []).filter(i => i.projectId === projectId && i.status !== 'Purchased' && i.status !== 'Cancelled');
        if (badge) { badge.textContent = items.length + ' item' + (items.length !== 1 ? 's' : ''); badge.style.display = items.length > 0 ? 'inline-block' : 'none'; }
        if (items.length === 0) {
          container.innerHTML = '<div style="text-align:center;padding:20px;color:#94a3b8;font-size:13px;"><i class="fas fa-list-ul" style="display:block;font-size:28px;margin-bottom:8px;opacity:.3;"></i>No need-to-purchase items for this project.</div>';
          return;
        }
        const priColor = { High:'#dc2626', Normal:'#d97706', Low:'#64748b' };
        const stBg     = { Planned:'#ede9fe', Ordered:'#dbeafe' };
        const stColor  = { Planned:'#5b21b6', Ordered:'#1e40af' };
        container.innerHTML = `<div style="display:flex;flex-direction:column;gap:8px;">
          ${items.map(i => `<div style="display:flex;align-items:center;gap:10px;padding:10px 12px;background:#f8fafc;border-radius:8px;border:1px solid #e2e8f0;">
            <div style="flex:1;">
              <div style="font-weight:700;font-size:13px;">${i.name.replace(/&/g,'&amp;').replace(/</g,'&lt;')}</div>
              <div style="font-size:11px;color:#64748b;margin-top:2px;">${i.category} · <span style="color:${priColor[i.priority]||'#374151'};font-weight:600;">${i.priority} priority</span>${i.dueBy?' · Due: '+new Date(i.dueBy+'T12:00:00').toLocaleDateString('en-US',{month:'short',day:'numeric'}):''}</div>
            </div>
            <span style="font-weight:800;color:#dc2626;white-space:nowrap;">$${parseFloat(i.estCost||0).toFixed(2)}</span>
            <span style="background:${stBg[i.status]||'#f1f5f9'};color:${stColor[i.status]||'#374151'};padding:2px 8px;border-radius:4px;font-size:11px;font-weight:700;">${i.status}</span>
            ${i.status === 'Planned' ? `<button onclick="markShopOrderedFromProject('${i.itemId}','${projectId}')" style="padding:3px 8px;font-size:11px;border:1px solid #0284c7;color:#0284c7;background:#fff;border-radius:4px;cursor:pointer;white-space:nowrap;">Mark Ordered</button>` : ''}
          </div>`).join('')}
        </div>`;
      } catch (err) {
        if (container) container.innerHTML = '<div style="color:#94a3b8;font-size:13px;padding:8px;">Could not load shopping list.</div>';
      }
    }

    async function markShopOrderedFromProject(itemId, projectId) {
      const r = await acctPost('markShoppingItemOrdered', { itemId });
      if (r.success) { loadProjectShoppingList(projectId); }
      else alert('Error: ' + r.error);
    }

    // ── Forecast payments for a project (from Accounting) ─────────────────────
    async function loadProjectForecastPayments(projectId) {
      const container = document.getElementById('projectForecastContent');
      if (!container) return;
      try {
        const now = new Date();
        const r   = await acctGet('getForecastItems', { year: now.getFullYear() });
        if (!r.success) { container.innerHTML = '<div style="color:#94a3b8;font-size:13px;padding:8px;">Could not load forecast.</div>'; return; }
        // Also check next year for forward-looking items
        const r2  = await acctGet('getForecastItems', { year: now.getFullYear() + 1 });
        const all = [...(r.items || []), ...(r2.items || [])];
        const items = all.filter(i => i.sourceId === projectId || i.sourceId === projectId.replace('PROJ-',''));
        if (items.length === 0) {
          container.innerHTML = '<div style="text-align:center;padding:16px;color:#94a3b8;font-size:13px;"><i class="fas fa-chart-bar" style="display:block;font-size:24px;margin-bottom:6px;opacity:.3;"></i>No forecast payments linked to this project. Add expected payments above.</div>';
          return;
        }
        const stCfg = { Confirmed:'#d1fae5:#065f46', Pending:'#fef3c7:#92400e', Posted:'#dbeafe:#1e40af', Cancelled:'#f1f5f9:#64748b' };
        container.innerHTML = `<div style="display:flex;flex-direction:column;gap:6px;">
          ${items.map(i => {
            const [bg, col] = (stCfg[i.status]||'#f1f5f9:#374151').split(':');
            const typeColor = i.type === 'Income' ? '#16a34a' : '#dc2626';
            const sign      = i.type === 'Income' ? '+' : '-';
            const dateStr   = i.expectedDate ? new Date(i.expectedDate+'T12:00:00').toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric'}) : `${['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'][i.month-1]} ${i.year}`;
            return `<div style="display:flex;align-items:center;gap:10px;padding:10px 12px;background:#f8fafc;border-radius:8px;border:1px solid #e2e8f0;">
              <div style="flex:1;">
                <div style="font-weight:700;font-size:13px;">${i.description.replace(/&/g,'&amp;').replace(/</g,'&lt;')}</div>
                <div style="font-size:11px;color:#64748b;margin-top:2px;">${dateStr}</div>
              </div>
              <span style="font-weight:800;color:${typeColor};white-space:nowrap;">${sign}$${parseFloat(i.amount||0).toFixed(2)}</span>
              <span style="background:${bg};color:${col};padding:2px 8px;border-radius:4px;font-size:11px;font-weight:700;">${i.status}</span>
            </div>`;
          }).join('')}
        </div>`;
      } catch (err) {
        if (container) container.innerHTML = '<div style="color:#94a3b8;font-size:13px;padding:8px;">Could not load forecast.</div>';
      }
    }

