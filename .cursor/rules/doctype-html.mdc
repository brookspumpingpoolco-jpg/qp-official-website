    async function saveImage() {
      if (!currentEditingItemId) return;
      
      const newImageUrl = document.getElementById('imageUrlInput').value.trim();
      const item = lineItems.find(i => i.id === currentEditingItemId);
      
      if (item) {
        const oldImageUrl = item.imageUrl;
        item.imageUrl = newImageUrl;
        
        // Update the sheet if this item has a name (either from price book or saved to price book)
        if (item.name && (item.fromPriceBook || item.savedToPriceBook)) {
          try {
            await updateItemImageInSheet(item.name, newImageUrl);
            showSuccess('Image updated successfully and synced with price book');
          } catch (error) {
            // Show user-friendly warning instead of console error
            showError('Image updated locally, but could not sync with price book. The item "' + (item.name || 'Unknown') + '" may not be in the price book.');
          }
        } else if (item.name) {
          // Item has a name but wasn't saved to price book - try to update anyway
          try {
            await updateItemImageInSheet(item.name, newImageUrl);
            showSuccess('Image updated successfully and synced with price book');
          } catch (error) {
            // Show user-friendly message
            showSuccess('Image updated locally. Item "' + (item.name || 'Unknown') + '" not found in price book.');
          }
        } else {
          showSuccess('Image updated locally');
        }
        
        renderItems();
        closeImageEditor();
      }
    }

    async function updateItemImageInSheet(itemName, imageUrl) {
      try {
        // First try the main API
        const result = await apiCall('updateItemImage', {
          name: itemName,
          imageUrl: imageUrl
        });
        
        if (result.success) {
          return result;
        }
        
        // If main API failed, try ItemList.gs directly
        const ITEM_LIST_URL = 'https://script.google.com/macros/s/AKfycbwip6F2jTdpwSpsv824dHEdbvDDU4i-4INr9G5oOE8E3xblcOVsucT17dsq9Z1xL91M/exec';
        
        const response = await fetch(ITEM_LIST_URL, {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: new URLSearchParams({
            action: 'updateItemImage',
            name: itemName,
            imageUrl: imageUrl
          })
        });
        
        if (!response.ok) {
          throw new Error(`HTTP error! status: ${response.status}`);
        }
        
        const fallbackResult = await response.json();
        
        if (!fallbackResult.success) {
          throw new Error(fallbackResult.error || result.error || 'Failed to update image in price book');
        }
        
        return fallbackResult;
        
      } catch (error) {
        // Throw user-friendly error message
        throw new Error(error.message || 'Failed to sync image with price book');
      }
    }

