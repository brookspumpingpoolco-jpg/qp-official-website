    /**
     * Create contract for a specific project (from alert)
     */
    async function createContractForProject(projectId) {
      try {
        // Find the project in needingContracts list or allProjects
        let project = projectsNeedingContracts.find(p => p.projectId === projectId);
        if (!project) {
          project = allProjects.find(p => p.projectId === projectId);
        }
        
        if (!project) {
          showError('Project not found');
          return;
        }
        
        const pd = project.projectData || {};
        const customerName = pd.customerName || project.customerName || '';
        const customerEmail = pd.customerEmail || project.customerEmail || '';
        const customerAddress = pd.customerAddress || project.customerAddress || '';
        const totalValue = parseFloat(project.totalValue || pd.total || project.total || 0);
        
        // Open the create contract modal
        openCreateContractModal();
        
        // Wait a bit for modal to render
        await new Promise(resolve => setTimeout(resolve, 200));
        
        // Pre-fill form with project data from the original estimate
        document.getElementById('contractProjectId').value = project.projectId || '';
        document.getElementById('contractTitle').value = `${pd.type || 'Service'} Agreement - ${customerName}`;
        document.getElementById('contractCustomerName').value = customerName;
        document.getElementById('contractCustomerEmail').value = customerEmail;
        document.getElementById('contractCustomerAddress').value = customerAddress;
        document.getElementById('contractAmount').value = totalValue;
        
        // Build contract content from the original estimate's line items
        let contractContent = '';
        contractContent += `Project ID: ${project.projectId}\n`;
        contractContent += `Customer: ${customerName}\n`;
        contractContent += `Date: ${pd.date || new Date().toLocaleDateString()}\n\n`;
        
        // Parse and include original estimate items
        try {
          const items = typeof pd.items === 'string' ? JSON.parse(pd.items) : (pd.items || []);
          if (items.length > 0) {
            contractContent += 'SCOPE OF WORK\n';
            contractContent += '='.repeat(40) + '\n\n';
            items.forEach((item, i) => {
              const qty = parseFloat(item.quantity || item.qty || 1);
              const price = parseFloat(item.price || item.rate || item.unitPrice || 0);
              const itemTotal = qty * price;
              contractContent += `${i + 1}. ${item.name || item.description || 'Item'}\n`;
              if (item.description && item.name && item.description !== item.name) {
                contractContent += `   ${item.description}\n`;
              }
              contractContent += `   Qty: ${qty}  |  Rate: $${price.toFixed(2)}  |  Amount: $${itemTotal.toFixed(2)}\n\n`;
            });
            contractContent += `${'─'.repeat(40)}\n`;
            contractContent += `TOTAL PROJECT VALUE: $${totalValue.toLocaleString('en-US', {minimumFractionDigits: 2})}\n\n`;
          }
        } catch (e) {
          console.warn('Could not parse estimate items:', e);
          contractContent += `Total Project Value: $${totalValue.toLocaleString('en-US', {minimumFractionDigits: 2})}\n\n`;
        }
        
        // Parse and include payment schedule
        try {
          const schedule = typeof pd.paymentSchedule === 'string' ? JSON.parse(pd.paymentSchedule) : (pd.paymentSchedule || []);
          if (schedule.length > 0) {
            contractContent += 'PAYMENT SCHEDULE\n';
            contractContent += '='.repeat(40) + '\n\n';
            schedule.forEach((m, i) => {
              contractContent += `${i + 1}. ${m.name || 'Milestone ' + (i+1)}: $${parseFloat(m.amount || 0).toFixed(2)} (${parseFloat(m.percent || 0).toFixed(1)}%)\n`;
              if (m.description) contractContent += `   ${m.description}\n`;
              contractContent += '\n';
            });
          }
        } catch (e) {
          console.warn('Could not parse payment schedule:', e);
        }
        
        // Include project notes
        if (pd.notes) {
          contractContent += 'PROJECT NOTES\n';
          contractContent += '='.repeat(40) + '\n';
          contractContent += pd.notes + '\n';
        }
        
        document.getElementById('contractContent').value = contractContent.trim();
        
        // Use original estimate terms if available, otherwise use defaults
        if (pd.terms) {
          document.getElementById('contractTerms').value = pd.terms;
        } else {
          document.getElementById('contractTerms').value = `1. Payment Terms: Payment is due according to the milestone schedule outlined above.

2. Change Orders: Any changes to the scope of work must be approved in writing and may result in additional charges.

3. Warranty: We warrant our workmanship for a period of [X] years from the date of completion.

4. Cancellation: Customer may cancel this agreement with written notice. Cancellation fees may apply.

5. Dispute Resolution: Any disputes will be resolved through mediation or arbitration.

6. Liability: Our liability is limited to the total contract amount.`;
        }
        
        showSuccess(`Contract form pre-filled from estimate data for ${customerName}`);
        
      } catch (error) {
        console.error('Error creating contract for project:', error);
        showError('Error preparing contract: ' + error.message);
      }
    }
    
