            toggleProcessingFee();
          }
          
          // Set type
          await setType(data.type || 'Estimate');
          
          // Load items - handle both string and array formats
          console.log('Loading items from saved quote:', data.items);
          try {
            let items = [];
            if (data.items) {
              if (typeof data.items === 'string') {
                items = JSON.parse(data.items);
              } else if (Array.isArray(data.items)) {
                items = data.items;
              }
            }
            
            // Convert items to lineItems format
            lineItems = [];
            items.forEach((item, index) => {
              // Only preserve fromPriceBook/savedToPriceBook if explicitly set to true
              // Don't default to false if undefined, as that could cause issues
              const fromPriceBook = item.fromPriceBook === true;
              const savedToPriceBook = item.savedToPriceBook === true;
              
              lineItems.push({
                id: item.id || Date.now() + index,
                name: item.name || '',
                description: item.description || '',
                quantity: parseFloat(item.quantity || 1),
                price: parseFloat(item.price || 0),
                category: item.category || '',
                unit: item.unit || '',
                code: item.code || '',
                imageUrl: item.imageUrl || '',
                actualCost: parseFloat(item.actualCost) || 0,
                cost: parseFloat(item.cost) || parseFloat(item.actualCost) || 0,
                isProfitTracked: item.isProfitTracked || item.isProfit || false,
                isProfit: item.isProfit || item.isProfitTracked || false,
                fromPriceBook: fromPriceBook,
                savedToPriceBook: savedToPriceBook,
                hasMarkup: item.hasMarkup || false,
                isStock: item.isStock || item.onHand || false,
                onHand: item.onHand || item.isStock || false
              });
            });
            
            // Restore profit tracking flags
            profitModeItems.clear();
            lineItems.forEach((item, idx) => {
              if (item.isProfit || item.isProfitTracked) {
                profitModeItems.add(item.id);
                if (!profitModeActive) {
                  profitModeActive = true;
                  showProfitModeWarning();
                }
              }
            });
            updateProfitModeIndicator();
            
            console.log('Loaded ' + lineItems.length + ' items into lineItems');
          } catch (e) {
            console.error('Error parsing items:', e);
            console.error('Items data:', data.items);
            lineItems = [];
            showError('Error loading items from saved quote: ' + e.message);
          }
          
          // Store the quote ID so we update instead of creating new
          currentEditingQuoteId = data.id || quoteId;
          currentInvoiceId = data.id || quoteId;
          currentQuoteId = data.id || quoteId;
          console.log('Set currentEditingQuoteId:', currentEditingQuoteId);
          console.log('Set currentInvoiceId:', currentInvoiceId);
          console.log('Loaded invoice ID:', data.id, 'Type:', data.type);
          
          // Show customer details
          document.getElementById('customerDetails').style.display = 'block';
          
          // Render and calculate
          renderItems();
          calculateTotals();
          
          // Close modal
          closeSavedQuotesModal();
          console.log('=== QUOTE LOADED SUCCESSFULLY ===');
          
          showSuccess('Saved quote loaded successfully!');
        } else {
          console.error('Failed to load quote:', result.error);
          showError('Failed to load quote: ' + (result.error || 'Unknown error'));
        }
      } catch (error) {
        console.error('=== ERROR LOADING QUOTE ===');
        console.error('Error details:', error);
        console.error('Error stack:', error.stack);
        showError('Error loading quote: ' + error.message);
      }
    }

