            google.script.run
              .withSuccessHandler(resolve)
              .withFailureHandler(reject)
              .getInitialData();
          } else {
            // For other actions, we need to use doPost via fetch or create wrapper functions
            // Fall back to fetch for now
            fetch(API_URL, {
              method: 'POST',
              headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
              body: new URLSearchParams({ action: action, ...params })
            })
            .then(r => r.text())
            .then(text => {
              try {
                resolve(JSON.parse(text));
              } catch (e) {
                reject(new Error('Invalid JSON: ' + text.substring(0, 200)));
              }
            })
            .catch(reject);
          }
        });
      } else {
        // Not in Apps Script, use fetch
        const response = await fetch(API_URL, {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: new URLSearchParams({ action: action, ...params })
        });
        const text = await response.text();
        return JSON.parse(text);
      }
    }

