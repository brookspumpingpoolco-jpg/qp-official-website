    function toggleProcessingFee() {
      const checkbox = document.getElementById('addProcessingFee');
      const isChecked = checkbox?.checked || false;
      
      // Find and remove existing processing fee item if any
      const processingFeeIndex = lineItems.findIndex(item => item.isProcessingFee === true);
      if (processingFeeIndex !== -1) {
        lineItems.splice(processingFeeIndex, 1);
      }
      
      // Add processing fee as line item if checkbox is checked
      if (isChecked) {
        // First calculate the base total to determine processing fee (exclude existing processing fee if any)
        const subtotal = lineItems
          .filter(item => !item.isProcessingFee)
          .reduce((sum, item) => sum + (item.quantity * item.price), 0);
        const taxRate = parseFloat(document.getElementById('taxRate')?.value) || 0;
        const taxAmount = subtotal * (taxRate / 100);
        const discount = parseFloat(document.getElementById('discount')?.value) || 0;
        const baseTotal = subtotal + taxAmount - discount;
        const processingFee = (baseTotal * 0.029) + 0.29;
        
        // Add processing fee as a line item
        const processingFeeItem = {
          id: 'processing-fee-' + Date.now(),
          name: 'Processing Fee',
          price: processingFee,
          quantity: 1,
          description: 'Processing Fee (2.9% + $0.29) for online payments',
          category: 'Fee',
          unit: 'Each',
          isProcessingFee: true, // Special flag to identify this item
          fromPriceBook: false,
          actualCost: 0,
          cost: 0,
          isStock: false,
          onHand: false
        };
        
        lineItems.push(processingFeeItem);
        renderItems();
      } else {
        renderItems();
      }
      
      calculateTotals(); // Recalculate totals when toggled
    }

