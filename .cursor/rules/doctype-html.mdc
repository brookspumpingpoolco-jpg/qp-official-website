    /**
     * Open create contract modal
     */
    function openCreateContractModal() {
      document.getElementById('contractIdForEdit').value = '';
      document.getElementById('createContractModalTitle').innerHTML = '<i class="fas fa-file-contract"></i> Create New Contract';
      var btn = document.getElementById('contractFormSubmitBtn');
      if (btn) btn.innerHTML = '<i class="fas fa-check"></i> Create Contract';
      document.getElementById('createContractModal').style.display = 'flex';
      if (allProjects && allProjects.length > 0) {
        populateContractProjectSelector();
      } else if (typeof loadAllProjects === 'function') {
        loadAllProjects().then(() => {
          populateContractProjectSelector();
        });
      }
    }
    
    /**
     * Close create contract modal
     */
    function closeCreateContractModal() {
      document.getElementById('createContractModal').style.display = 'none';
      document.getElementById('contractForm').reset();
      document.getElementById('contractIdForEdit').value = '';
      document.getElementById('createContractModalTitle').innerHTML = '<i class="fas fa-file-contract"></i> Create New Contract';
      var btn = document.getElementById('contractFormSubmitBtn');
      if (btn) btn.innerHTML = '<i class="fas fa-check"></i> Create Contract';
    }
    
    /**
     * Populate project selector in contract form
     */
    function populateContractProjectSelector() {
      const selector = document.getElementById('contractProjectId');
      if (!selector || !allProjects) return;
      
      selector.innerHTML = '<option value="">Select a project (optional)</option>';
      allProjects.forEach(project => {
        const pd = project.projectData || {};
        const customerName = pd.customerName || project.customerName || 'Unknown';
        const totalValue = parseFloat(project.totalValue || pd.total || 0);
        const option = document.createElement('option');
        option.value = project.projectId;
        option.textContent = `${project.projectId} - ${customerName} ($${totalValue.toLocaleString('en-US', {minimumFractionDigits: 2})})`;
        selector.appendChild(option);
      });
      
      // Add onchange to auto-fill form when a project is selected
      selector.onchange = function() {
        const projectId = this.value;
        if (!projectId) return;
        
        const project = allProjects.find(p => p.projectId === projectId);
        if (!project) return;
        
        const pd = project.projectData || {};
        
        // Auto-fill customer info
        const nameField = document.getElementById('contractCustomerName');
        const emailField = document.getElementById('contractCustomerEmail');
        const addressField = document.getElementById('contractCustomerAddress');
        const amountField = document.getElementById('contractAmount');
        const titleField = document.getElementById('contractTitle');
        const contentField = document.getElementById('contractContent');
        const termsField = document.getElementById('contractTerms');
        
        if (nameField) nameField.value = pd.customerName || project.customerName || '';
        if (emailField) emailField.value = pd.customerEmail || project.customerEmail || '';
        if (addressField) addressField.value = pd.customerAddress || '';
        if (amountField) amountField.value = parseFloat(project.totalValue || pd.total || 0);
        if (titleField && !titleField.value) titleField.value = `${pd.type || 'Service'} Agreement - ${pd.customerName || ''}`;
        
        // Build contract content from original estimate items
        let contractContent = '';
        try {
          const items = typeof pd.items === 'string' ? JSON.parse(pd.items) : (pd.items || []);
          if (items.length > 0) {
            contractContent += 'SCOPE OF WORK\n';
            contractContent += '='.repeat(40) + '\n\n';
            items.forEach((item, i) => {
              const qty = parseFloat(item.quantity || item.qty || 1);
              const price = parseFloat(item.price || item.rate || item.unitPrice || 0);
              const total = qty * price;
              contractContent += `${i + 1}. ${item.name || item.description || 'Item'}\n`;
              if (item.description && item.name && item.description !== item.name) {
                contractContent += `   ${item.description}\n`;
              }
              contractContent += `   Qty: ${qty}  |  Rate: $${price.toFixed(2)}  |  Amount: $${total.toFixed(2)}\n\n`;
            });
            
            const totalValue = parseFloat(project.totalValue || pd.total || 0);
            contractContent += `${'─'.repeat(40)}\n`;
            contractContent += `TOTAL PROJECT VALUE: $${totalValue.toLocaleString('en-US', {minimumFractionDigits: 2})}\n\n`;
          }
        } catch (e) {
          console.warn('Could not parse estimate items:', e);
        }
        
        // Add payment schedule if available
        try {
          const schedule = typeof pd.paymentSchedule === 'string' ? JSON.parse(pd.paymentSchedule) : (pd.paymentSchedule || []);
          if (schedule.length > 0) {
            contractContent += 'PAYMENT SCHEDULE\n';
            contractContent += '='.repeat(40) + '\n\n';
            schedule.forEach((m, i) => {
              contractContent += `${i + 1}. ${m.name || 'Milestone ' + (i+1)}: $${parseFloat(m.amount || 0).toFixed(2)} (${parseFloat(m.percent || 0).toFixed(1)}%)\n`;
              if (m.description) contractContent += `   ${m.description}\n`;
              contractContent += '\n';
            });
          }
        } catch (e) {
          console.warn('Could not parse payment schedule:', e);
        }
        
        // Add project notes if available
        if (pd.notes) {
          contractContent += '\nPROJECT NOTES\n';
          contractContent += '='.repeat(40) + '\n';
          contractContent += pd.notes + '\n';
        }
        
        if (contentField && contractContent) contentField.value = contractContent.trim();
        
        // Pre-fill terms from original estimate if available
        if (termsField && pd.terms && !termsField.value) {
          termsField.value = pd.terms;
        }
        
        console.log('✅ Contract form auto-filled from project:', projectId, pd);
      };
    }
    
    /**
     * Create new contract
     */
    async function createContract() {
      const form = document.getElementById('contractForm');
      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }
      
      const contractData = {
        projectId: document.getElementById('contractProjectId').value || '',
        customerEmail: document.getElementById('contractCustomerEmail').value,
        customerName: document.getElementById('contractCustomerName').value,
        customerAddress: document.getElementById('contractCustomerAddress').value,
        contractTitle: document.getElementById('contractTitle').value,
        contractContent: document.getElementById('contractContent').value,
        terms: document.getElementById('contractTerms').value,
        totalAmount: parseFloat(document.getElementById('contractAmount').value) || 0
      };
      
      try {
        showLoading('Creating contract...');
        const response = await fetch(CONTRACT_API_URL, {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: new URLSearchParams({
            action: 'createContract',
            data: JSON.stringify(contractData)
          })
        });
        
        const result = await response.json();
        
        if (result.success) {
          showSuccess('Contract created successfully!');
          closeCreateContractModal();
          loadAllContracts();
        } else {
          showError('Failed to create contract: ' + (result.error || 'Unknown error'));
        }
      } catch (error) {
        showError('Error creating contract: ' + error.message);
      } finally {
        hideLoading();
      }
    }
    
    /**
     * Open sign contract modal
     */
    function openSignContractModal(contractId) {
      document.getElementById('signContractModal').style.display = 'flex';
      document.getElementById('signContractId').value = contractId;
      
      // Initialize signature pad
      const canvas = document.getElementById('contractSignatureCanvas');
      if (canvas && typeof SignaturePad !== 'undefined') {
        contractSignaturePad = new SignaturePad(canvas, {
          backgroundColor: 'rgb(255, 255, 255)',
          penColor: 'rgb(3, 105, 161)'
        });
        
        // Resize canvas
        const rect = canvas.getBoundingClientRect();
        canvas.width = rect.width;
        canvas.height = 300;
        contractSignaturePad.clear();
      }
    }
    
    /**
     * Close sign contract modal
     */
    function closeSignContractModal() {
      document.getElementById('signContractModal').style.display = 'none';
      if (contractSignaturePad) {
        contractSignaturePad.clear();
      }
    }
    
    /**
     * Save company signature
     */
    async function saveCompanySignature() {
      const contractId = document.getElementById('signContractId').value;
      
      if (!contractSignaturePad || contractSignaturePad.isEmpty()) {
        showError('Please provide your signature');
        return;
      }
      
      const signatureImage = contractSignaturePad.toDataURL('image/png');
      
      try {
        showLoading('Saving signature...');
        const response = await fetch(CONTRACT_API_URL, {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: new URLSearchParams({
            action: 'saveCompanySignature',
            data: JSON.stringify({
              contractId: contractId,
              signatureImage: signatureImage
            })
          })
        });
        
        const result = await response.json();
        
        if (result.success) {
          showSuccess('Signature saved successfully!');
          closeSignContractModal();
          loadAllContracts();
        } else {
          showError('Failed to save signature: ' + (result.error || 'Unknown error'));
        }
      } catch (error) {
        showError('Error saving signature: ' + error.message);
      } finally {
        showLoading(false);
      }
    }
    
    /**
     * Send contract to customer
     */
    async function sendContract(contractId) {
      if (!confirm('Send this contract to the customer? They will receive an email with a signing link.')) {
        return;
      }
      
      try {
        showLoading('Sending contract...');
        const response = await fetch(CONTRACT_API_URL, {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: new URLSearchParams({
            action: 'sendContractToCustomer',
            contractId: contractId
          })
        });
        
        const result = await response.json();
        
        if (result.success) {
          showSuccess('Contract sent to customer successfully!');
          loadAllContracts();
        } else {
          showError('Failed to send contract: ' + (result.error || 'Unknown error'));
        }
      } catch (error) {
        showError('Error sending contract: ' + error.message);
      } finally {
        hideLoading();
      }
    }
    
    /**
     * View contract
     */
    function viewContract(contractId) {
      const contract = allContracts.find(c => c.id === contractId);
      if (contract && contract.signedPdfUrl) {
        window.open(contract.signedPdfUrl, '_blank');
      } else if (contract && contract.pdfUrl) {
        window.open(contract.pdfUrl, '_blank');
      } else {
        // Open in contract viewer
        window.open(`https://www.aqualitypoolcompanyusa.com/contract-viewer?id=${contractId}`, '_blank');
      }
    }
    
    /**
     * Download contract PDF
     */
    function downloadContractPDF(contractId) {
      const contract = allContracts.find(c => c.id === contractId);
      if (contract && contract.signedPdfUrl) {
        window.open(contract.signedPdfUrl, '_blank');
      } else if (contract && contract.pdfUrl) {
        window.open(contract.pdfUrl, '_blank');
      } else {
        showError('PDF not available for this contract');
      }
    }
    
    /**
     * Open edit contract modal (placeholder)
     */
    async function openEditContractModal(contractId) {
      try {
        showLoading('Loading contract...');
        const response = await fetch(CONTRACT_API_URL, {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: new URLSearchParams({ action: 'getContract', id: contractId })
        });
        const result = await response.json();
        if (!result.success || !result.data) {
          showError(result.error || 'Contract not found');
          return;
        }
        const c = result.data;
        if (c.status === 'Signed') {
          showError('Signed contracts cannot be edited.');
          return;
        }
        document.getElementById('contractIdForEdit').value = contractId;
        document.getElementById('contractProjectId').value = c.projectId || '';
        document.getElementById('contractTitle').value = c.contractTitle || '';
        document.getElementById('contractCustomerName').value = c.customerName || '';
        document.getElementById('contractCustomerEmail').value = c.customerEmail || '';
        document.getElementById('contractCustomerAddress').value = c.customerAddress || '';
        document.getElementById('contractAmount').value = c.totalAmount != null ? c.totalAmount : '';
        document.getElementById('contractContent').value = c.contractContent || '';
        document.getElementById('contractTerms').value = c.terms || '';
        document.getElementById('createContractModalTitle').innerHTML = '<i class="fas fa-edit"></i> Edit Contract';
        var btn = document.getElementById('contractFormSubmitBtn');
        if (btn) { btn.innerHTML = '<i class="fas fa-save"></i> Save Changes'; }
        document.getElementById('createContractModal').style.display = 'flex';
      } catch (error) {
        showError('Error loading contract: ' + (error.message || error));
      } finally {
        hideLoading();
      }
    }

    function submitContractForm() {
      var editId = document.getElementById('contractIdForEdit').value;
      if (editId) {
        updateContract(editId);
      } else {
        createContract();
      }
    }

    async function updateContract(contractId) {
      var form = document.getElementById('contractForm');
      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }
      var contractData = {
        projectId: document.getElementById('contractProjectId').value || '',
        customerEmail: document.getElementById('contractCustomerEmail').value,
        customerName: document.getElementById('contractCustomerName').value,
        customerAddress: document.getElementById('contractCustomerAddress').value,
        contractTitle: document.getElementById('contractTitle').value,
        contractContent: document.getElementById('contractContent').value,
        terms: document.getElementById('contractTerms').value,
        totalAmount: parseFloat(document.getElementById('contractAmount').value) || 0
      };
      try {
        showLoading('Saving changes...');
        var response = await fetch(CONTRACT_API_URL, {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: new URLSearchParams({
            action: 'updateContract',
            contractId: contractId,
            data: JSON.stringify(contractData)
          })
        });
        var result = await response.json();
        if (result.success) {
          showSuccess('Contract updated successfully.');
          closeCreateContractModal();
          loadAllContracts();
        } else {
          showError('Failed to update contract: ' + (result.error || 'Unknown error'));
        }
      } catch (error) {
        showError('Error updating contract: ' + error.message);
      } finally {
        hideLoading();
      }
    }
    
    // Make contract functions globally accessible
    window.loadContractMetrics = loadContractMetrics;
    window.loadAllContracts = loadAllContracts;
    window.checkProjectsNeedingContracts = checkProjectsNeedingContracts;
    window.createContractForProject = createContractForProject;
    window.openCreateContractModal = openCreateContractModal;
    window.closeCreateContractModal = closeCreateContractModal;
    window.createContract = createContract;
    window.submitContractForm = submitContractForm;
    window.openEditContractModal = openEditContractModal;
    window.updateContract = updateContract;
    window.openSignContractModal = openSignContractModal;
    window.closeSignContractModal = closeSignContractModal;
    window.saveCompanySignature = saveCompanySignature;
    window.sendContract = sendContract;
    window.viewContract = viewContract;
    window.downloadContractPDF = downloadContractPDF;
    window.loadProjectContracts = loadProjectContracts;
    window.renderProjectContracts = renderProjectContracts;
    window.openCreateContractForProject = openCreateContractForProject;
    
  </script>


  <script>
    // Handle URL hash for direct navigation
    window.addEventListener('load', function() {
      const hash = window.location.hash;
      if (hash === '#dashboard') {
        switchTab('dashboard');
      } else if (hash === '#preview') {
        switchTab('preview');
      }
    });

    // Handle hash changes
    window.addEventListener('hashchange', function() {
      const hash = window.location.hash;
      if (hash === '#dashboard') {
        switchTab('dashboard');
      } else if (hash === '#preview') {
        switchTab('preview');
      } else if (hash === '#create' || !hash) {
        switchTab('create');
      }
    });
  </script>
</body>
</html>
