    async function saveNewCustomer() {
      const name = document.getElementById('newCustomerName').value.trim();
      const email = document.getElementById('newCustomerEmail').value.trim();
      
      if (!name || !email) {
        showError('Name and Email are required');
          return;
        }

      // Basic email validation
      const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
      if (!emailRegex.test(email)) {
        showError('Please enter a valid email address');
          return;
      }

      try {
        const customerData = {
          name: name,
          email: email,
          phone: document.getElementById('newCustomerPhone').value.trim(),
          address: document.getElementById('newCustomerAddress').value.trim(),
          city: document.getElementById('newCustomerCity').value.trim(),
          state: document.getElementById('newCustomerState').value.trim().toUpperCase(),
          zipCode: document.getElementById('newCustomerZip').value.trim(),
          notes: document.getElementById('newCustomerNotes').value.trim()
        };
        
        // Try using google.script.run first (more reliable when served from same webapp)
        if (typeof google !== 'undefined' && google.script && google.script.run) {
          try {
            google.script.run
              .withSuccessHandler(function(result) {
                if (result.success) {
                  // Add to customers array
                  customers.push(result.customer);
                  
                  // Refresh customer select
                  populateCustomerSelect();
                  
                  // Select the new customer
                  document.getElementById('customerSelect').value = result.customer.email;
                  selectCustomer();
                  
                  // Close modal
                  closeAddCustomerModal();
                  
                  showSuccess('Customer added successfully!');
                } else {
                  showError('Failed to add customer: ' + (result.error || 'Unknown error'));
                }
              })
              .withFailureHandler(function(error) {
                console.error('Error adding customer:', error);
                showError('Error adding customer: ' + (error.message || error.toString()));
              })
              .addCustomer(customerData);
            return; // Exit early, using google.script.run
          } catch (e) {
            console.log('google.script.run not available, using fetch instead:', e);
          }
        }
        
        // Fallback to fetch API
        const response = await fetch(API_URL, {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: new URLSearchParams({
            action: 'addCustomer',
            data: JSON.stringify(customerData)
          })
        });
        
        // Get response text first
        const responseText = await response.text();
        
        // Check if response is JSON
        let result;
        try {
          result = JSON.parse(responseText);
        } catch (parseError) {
          console.error('Non-JSON response received:', responseText.substring(0, 500));
          showError('Server returned an error. Please check that the webapp is deployed correctly. The webapp may need to be redeployed after code changes. Error: ' + responseText.substring(0, 200));
          return;
        }

        if (result.success) {
          // Add to customers array
          customers.push(result.customer);
          
          // Refresh customer select
          populateCustomerSelect();
          
          // Select the new customer
          document.getElementById('customerSelect').value = result.customer.email;
          selectCustomer();
          
          // Close modal
          closeAddCustomerModal();
          
          showSuccess('Customer added successfully!');
        } else {
          showError('Failed to add customer: ' + (result.error || 'Unknown error'));
        }
      } catch (error) {
        console.error('Error adding customer:', error);
        showError('Error adding customer: ' + error.message);
      }
    }

    // Quote Acceptance Functions
    async function convertAcceptedQuoteToInvoice(quoteId) {
      if (!paymentScheduleMilestones || paymentScheduleMilestones.length === 0) {
        showError('Please create a payment schedule before converting to invoice');
        openPaymentScheduleBuilder();
        return;
      }

      if (!validatePaymentSchedule()) {
        showError('Please fix payment schedule validation errors before converting to invoice');
        openPaymentScheduleBuilder();
        return;
      }
      
      if (!confirm('Convert this accepted quote to an invoice? This will create a project and finalize the payment schedule.')) {
        return;
      }
      
      try {
        const total = getGrandTotal();
        const paymentScheduleData = {
          totalContractAmount: total,
          milestones: paymentScheduleMilestones.map(m => ({
            milestoneId: m.id.toString(),
            name: m.name,
            percent: parseFloat(m.percent),
            amount: m.amount,
            dueTrigger: m.dueTrigger,
            dueDate: m.dueDate || null,
            duePhase: m.duePhase || null,
            status: 'pending'
          }))
        };
        
        const response = await fetch(API_URL, {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: new URLSearchParams({
            action: 'convertAcceptedQuoteToInvoice',
            quoteId: quoteId,
            paymentSchedule: JSON.stringify(paymentScheduleData)
          })
        });
        
        const result = await response.json();
        
        if (result.success) {
          showSuccess('Quote converted to invoice successfully! Invoice ID: ' + result.invoiceId + ', Project ID: ' + (result.projectId || 'N/A'));
          // Optionally reload or redirect
          setTimeout(() => {
            window.location.reload();
          }, 2000);
      } else {
          showError('Failed to convert quote: ' + (result.error || 'Unknown error'));
        }
      } catch (error) {
        showError('Error converting quote: ' + error.message);
      }
    }

