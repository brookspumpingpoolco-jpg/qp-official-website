      // Get current type from active button or default to Invoice
      const activeTypeBtn = document.querySelector('.type-btn.active');
      const type = activeTypeBtn ? activeTypeBtn.dataset.type : (currentType || 'Invoice');
      
      // Get user email if not already set
      if (!userEmail) {
        userEmail = getUserEmail();
