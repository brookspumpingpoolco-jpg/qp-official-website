      const emailBody = generateEnhancedEmailBody(data, shareLink, saveResult.approvalToken, paymentLink, customerPortalRegistered, id);
      
      const emailOptions = {
        to: data.customerEmail,
        subject: emailSubject,
        htmlBody: emailBody
      };
      
      // Add PDF attachment if generated successfully
      if (pdfBlob) {
        emailOptions.attachments = [pdfBlob];
      }
      
      MailApp.sendEmail(emailOptions);
    }
    
    // Update invoice status and payment info in JSON after sending
    if (isInvoiceDoc && sheet) {
      try {
        const lastRow = sheet.getLastRow();
        for (let rowNum = 2; rowNum <= lastRow; rowNum++) {
          // Determine column positions based on structure
          const sheetCols = sheet.getLastColumn();
          const is8Column = (sheetCols >= 8);
          const idCol = is8Column ? 2 : 1; // ID column
          
          const rowId = String(sheet.getRange(rowNum, idCol).getValue() || '').trim();
          if (rowId === String(id).trim()) {
            // Read JSON
            const json1Col = is8Column ? 4 : 3;
            const json2Col = is8Column ? 5 : 4;
            const json3Col = is8Column ? 6 : 5;
            
            const jsonPart1 = sheet.getRange(rowNum, json1Col).getValue() || '';
            const jsonPart2 = sheet.getRange(rowNum, json2Col).getValue() || '';
            const jsonPart3 = sheet.getRange(rowNum, json3Col).getValue() || '';
            let jsonStr = concatenateJsonChunks(jsonPart1, jsonPart2, jsonPart3);
            
            if (!jsonStr || jsonStr.length === 0) {
              jsonStr = String(jsonPart1 || '').trim();
            }
            
            if (jsonStr && jsonStr.startsWith('{')) {
              const jsonData = JSON.parse(jsonStr);
              
              // Update payment status and info
              jsonData.status = 'Pending'; // Mark as Pending when sent
              jsonData.paymentStatus = 'Pending';
              jsonData.paymentLink = paymentLink || '';
              jsonData.sentDate = new Date().toISOString();
              jsonData.sentBy = data.createdBy || data.userEmail || '';
              
              // Write updated JSON back
              const updatedJsonStr = JSON.stringify(jsonData);
              const updatedChunks = splitJsonString(updatedJsonStr);
              sheet.getRange(rowNum, json1Col, 1, 3).setValues([[updatedChunks[0] || '', updatedChunks[1] || '', updatedChunks[2] || '']]);
              SpreadsheetApp.flush();
              
              Logger.log('✅ Invoice status updated to Pending in JSON');
              break;
            }
          }
        }
      } catch (e) {
        Logger.log('Error updating invoice status in JSON: ' + e.toString());
      }
    }

    // Update estimate status/approval markers after sending
    if (isEstimateDoc && sheet) {
      try {
        const lastRow = sheet.getLastRow();
        for (let rowNum = 2; rowNum <= lastRow; rowNum++) {
          const sheetCols = sheet.getLastColumn();
          const is8Column = (sheetCols >= 8);
          const idCol = is8Column ? 2 : 1;

          const rowId = String(sheet.getRange(rowNum, idCol).getValue() || '').trim();
          if (rowId === String(id).trim()) {
            const json1Col = is8Column ? 4 : 3;
            const json2Col = is8Column ? 5 : 4;
            const json3Col = is8Column ? 6 : 5;

            const jsonPart1 = sheet.getRange(rowNum, json1Col).getValue() || '';
            const jsonPart2 = sheet.getRange(rowNum, json2Col).getValue() || '';
            const jsonPart3 = sheet.getRange(rowNum, json3Col).getValue() || '';
            let jsonStr = concatenateJsonChunks(jsonPart1, jsonPart2, jsonPart3);

            if (!jsonStr || jsonStr.length === 0) {
              jsonStr = String(jsonPart1 || '').trim();
            }

            if (jsonStr && jsonStr.startsWith('{')) {
              const jsonData = JSON.parse(jsonStr);
              jsonData.status = 'Pending';
              jsonData.approvalStatus = 'Pending';
              jsonData.sentDate = new Date().toISOString();
              jsonData.sentBy = data.createdBy || data.userEmail || '';
              if (jsonData.customerSigned !== true) jsonData.customerSigned = false;
              if (jsonData.adminSigned !== true) jsonData.adminSigned = false;

              const updatedJsonStr = JSON.stringify(jsonData);
              const updatedChunks = splitJsonString(updatedJsonStr);
              sheet.getRange(rowNum, json1Col, 1, 3).setValues([[updatedChunks[0] || '', updatedChunks[1] || '', updatedChunks[2] || '']]);
              SpreadsheetApp.flush();

              Logger.log('✅ Estimate status updated to Pending Customer Approval in JSON');
              break;
            }
          }
        }
      } catch (e) {
        Logger.log('Error updating estimate status in JSON: ' + e.toString());
      }
    }
    
    // FINAL ENFORCEMENT - ensure 8 columns before returning
    // Reuse existing spreadsheet variable from earlier in function
    if (sheet) {
      enforce8ColumnStructure(sheet);
      SpreadsheetApp.flush();
    }
    
    // Check if email was sent successfully
    // If we reach here, email should have been sent (or it's an estimate which doesn't require email)
    Logger.log('✅ Invoice/estimate saved and processed successfully');
    
    return {
      success: true,
      id: id,
      shareLink: shareLink,
      approvalToken: saveResult.approvalToken || '',
      pdfUrl: pdfUrl,
      paymentLink: paymentLink || '',
      status: updatedStatus,
      emailSent: true // Indicate email was sent
    };
  } catch (error) {
    Logger.log('❌ Error sending invoice/estimate: ' + error.toString());
    Logger.log('Error stack: ' + (error.stack || 'No stack trace'));
    
    // Check if this is an email sending error
    const isEmailError = error.toString().includes('Failed to send email') || 
                         error.toString().includes('sendEnhancedInvoiceEmail') ||
                         error.toString().includes('MailApp');
    
    // Even on error, enforce 8 columns
    try {
      const errorSpreadsheet = SpreadsheetApp.openById(SPREADSHEET_ID);
      const errorSheet = errorSpreadsheet.getSheetByName(INVOICES_ESTIMATES_SHEET);
      if (errorSheet) {
        enforce8ColumnStructure(errorSheet);
        SpreadsheetApp.flush();
      }
    } catch (e) {
      Logger.log('Error enforcing columns on error: ' + e.toString());
    }
    
    // Return detailed error message
    return {
      success: false,
      error: error.toString(),
      emailSent: false,
      errorType: isEmailError ? 'email' : 'general'
    };
  }
}

/**
 * Queue a deferred invoice/estimate send payload and ensure worker trigger exists.
 */
function enqueueDeferredInvoiceSend_(payload) {
  try {
    const props = PropertiesService.getScriptProperties();
    const queueKey = 'DEFER_SEND_' + new Date().getTime() + '_' + Utilities.getUuid().substring(0, 8);
    const serialized = JSON.stringify(payload || {});
    props.setProperty(queueKey, serialized);
    const triggerReady = ensureDeferredInvoiceSendTrigger_();
    return { success: true, queueKey: queueKey, triggerReady: triggerReady };
  } catch (error) {
    Logger.log('enqueueDeferredInvoiceSend_ error: ' + error.toString());
    return { success: false, error: error.toString() };
  }
}

/**
 * Ensure a time-driven trigger exists for deferred invoice sends.
 */
function ensureDeferredInvoiceSendTrigger_() {
  try {
    const handler = 'processDeferredInvoiceEmailSends_';
    const existing = ScriptApp.getProjectTriggers().some(function(t) {
      return t.getHandlerFunction && t.getHandlerFunction() === handler;
    });
    if (!existing) {
      ScriptApp.newTrigger(handler).timeBased().everyMinutes(1).create();
      Logger.log('✅ Created deferred invoice send trigger (every 1 minute)');
    }
    return true;
  } catch (error) {
    // Some deployments cannot call ScriptApp.* due to scope restrictions.
    // Queueing should still succeed; the queue can be processed via fallback endpoint.
    Logger.log('⚠️ Could not create deferred send trigger (continuing without trigger): ' + error.toString());
    return false;
  }
}

/**
 * Worker: process queued deferred invoice sends in small batches.
 */
function processDeferredInvoiceEmailSends_(options) {
  options = options || {};
  const props = PropertiesService.getScriptProperties();
  const all = props.getProperties();
  const keys = Object.keys(all).filter(function(k) { return k.indexOf('DEFER_SEND_') === 0; }).sort();
  if (keys.length === 0) return { success: true, processed: 0 };

  let processed = 0;
  const maxPerRun = parseInt(options.maxPerRun, 10) > 0 ? parseInt(options.maxPerRun, 10) : 3;
  const allowTriggerMaintenance = options.allowTriggerMaintenance !== false;

  for (let i = 0; i < keys.length && processed < maxPerRun; i++) {
    const key = keys[i];
    try {
      const raw = props.getProperty(key);
      if (!raw) {
        props.deleteProperty(key);
        continue;
      }
      const entry = JSON.parse(raw);
      const data = (entry && entry.data) ? entry.data : null;
      if (!data) {
        Logger.log('⚠️ Deferred send entry missing data: ' + key);
        props.deleteProperty(key);
        continue;
      }

      // Run full send path synchronously in worker context.
      const result = sendInvoiceEstimate(Object.assign({}, data, { deferEmailSend: false }));
      if (result && result.success) {
        props.deleteProperty(key);
        processed++;
        Logger.log('✅ Deferred invoice send completed: ' + key + ' id=' + (result.id || data.id || 'unknown'));
      } else {
        const msg = (result && result.error) ? result.error : 'Unknown deferred send error';
        Logger.log('❌ Deferred invoice send failed: ' + key + ' error=' + msg);
        // Keep item in queue for retry on next run unless clearly invalid payload
      }
    } catch (err) {
      Logger.log('❌ Error processing deferred send key ' + key + ': ' + err.toString());
      // Keep for retry unless JSON is irrecoverable
      try {
        const raw2 = props.getProperty(key) || '';
        if (raw2 && raw2.trim().charAt(0) !== '{') props.deleteProperty(key);
      } catch (_) {}
    }
  }

  // Optional cleanup: remove trigger when queue is empty to reduce noise
  const remaining = Object.keys(props.getProperties()).filter(function(k) { return k.indexOf('DEFER_SEND_') === 0; }).length;
  if (remaining === 0 && allowTriggerMaintenance) {
    try {
      ScriptApp.getProjectTriggers().forEach(function(t) {
        if (t.getHandlerFunction && t.getHandlerFunction() === 'processDeferredInvoiceEmailSends_') {
          try { ScriptApp.deleteTrigger(t); } catch (e) {}
        }
      });
      Logger.log('🧹 Deferred send queue empty; removed worker trigger');
    } catch (error) {
      Logger.log('⚠️ Could not inspect/delete triggers during queue cleanup: ' + error.toString());
    }
  }

  return { success: true, processed: processed, remaining: remaining };
}

/**
 * Check if customer is registered in Customer Portal
 */
function checkCustomerPortalRegistration(customerEmail) {
  try {
    if (!customerEmail) return false;
    
    // Call Customer Portal API to check if customer exists
    const response = UrlFetchApp.fetch(CUSTOMER_PORTAL_URL, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/x-www-form-urlencoded'
      },
      payload: {
        action: 'checkCustomerExists',
        email: customerEmail
      },
      muteHttpExceptions: true
    });
    
    const responseCode = response.getResponseCode();
    if (responseCode === 200) {
      const result = JSON.parse(response.getContentText());
      return result.exists === true;
    }
    
    return false;
  } catch (error) {
    Logger.log('Error checking customer portal registration: ' + error.toString());
    return false;
  }
}

