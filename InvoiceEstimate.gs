              <p style="margin: 0; font-size: 12px; color: #6b7280; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;">Secure payment powered by Stripe · All major cards accepted</p>
            </td>
          </tr>
          ` : ''}
          <tr>
            <td align="center" style="padding: ${stripePayLink ? '12px' : '32px'} 0 8px 0;">
              <a href="${viewInvoiceLink}" style="display: inline-block; background: ${stripePayLink ? 'transparent' : '#0369a1'}; color: ${stripePayLink ? '#0369a1' : 'white'}; text-decoration: none; padding: 12px 28px; border-radius: 8px; font-weight: 600; font-size: ${stripePayLink ? '14px' : '16px'}; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; ${stripePayLink ? 'border: 2px solid #0369a1;' : ''}">${primaryCtaButtonText}</a>
            </td>
          </tr>
          ${isEstimateDoc ? `
          <tr>
            <td align="center" style="padding: 0 16px 24px 16px;">
              <p style="margin: 0; font-size: 13px; color: #64748b; line-height: 1.5; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;">Opens our secure estimate viewer. Review, sign, and submit your approval.</p>
            </td>
          </tr>
          ` : ''}
        </table>
      `;
    }
    
    // Generate opening message section (fancy box) - only for daily updates with opening message
    let openingMessageSection = '';
    let updateMessageSection = '';
    
    if (isDailyUpdate && data.openingMessage) {
      // Daily update: opening message in fancy box, update message as body text
      openingMessageSection = `
        <div style="background: linear-gradient(135deg, #f0f9ff 0%, #e0f2fe 50%, #dbeafe 100%); border: 2px solid #3b82f6; border-radius: 12px; padding: 24px; margin: 0 0 24px 0; box-shadow: 0 4px 12px rgba(59, 130, 246, 0.15);">
          <div style="font-size: 15px; color: #1e40af; line-height: 1.7; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; white-space: pre-wrap; font-weight: 500;">${escapeHtml(data.openingMessage)}</div>
        </div>
      `;
      
      // Update message as regular body text
      const updateMessageText = data.updateMessage || customMessage || '';
      if (updateMessageText) {
        updateMessageSection = `
          <div style="font-size: 15px; color: #475569; line-height: 1.7; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; margin: 0 0 24px 0; white-space: pre-wrap;">${escapeHtml(updateMessageText)}</div>
        `;
      }
    } else {
      // Regular invoice/estimate: Split custom message - first paragraph in fancy box, rest as regular body text
      // For estimates: if NO custom message was provided, leave opening message empty (no default)
      // For invoices: use default message if no custom message provided
      const shouldUseDefault = (invoiceType !== 'Estimate') || customMessage;
      const fullMessage = customMessage || (shouldUseDefault ? defaultEmailBodyFallback : '');
      
      // Split message intelligently - first paragraph in fancy box, rest as regular body text
      let openingText = '';
      let bodyText = '';
      
      // Try to split at double newline (paragraph break) first
      if (fullMessage.includes('\n\n')) {
        const parts = fullMessage.split('\n\n', 2);
        openingText = parts[0].trim();
        bodyText = parts.slice(1).join('\n\n').trim();
      } 
      // If no paragraph break, try splitting at first sentence (ending with period followed by space)
      else if (fullMessage.match(/\.\s+/)) {
        const match = fullMessage.match(/\.\s+/);
        if (match && match.index !== undefined) {
          const splitIndex = match.index + 1;
          openingText = fullMessage.substring(0, splitIndex).trim();
          bodyText = fullMessage.substring(splitIndex).trim();
        } else {
          openingText = fullMessage;
          bodyText = '';
        }
      } 
      // If message is long, split at reasonable point (first 200 chars or first sentence)
      else if (fullMessage.length > 200) {
        // Try to find a good break point (period, exclamation, or question mark)
        const breakPoints = ['.', '!', '?'];
        let bestBreak = -1;
        for (const breakPoint of breakPoints) {
          const index = fullMessage.indexOf(breakPoint, 100);
          if (index > 100 && index < 250) {
            bestBreak = index;
            break;
          }
        }
        
        if (bestBreak > 0) {
          openingText = fullMessage.substring(0, bestBreak + 1).trim();
          bodyText = fullMessage.substring(bestBreak + 1).trim();
        } else {
          // Fallback: split at 200 chars
          openingText = fullMessage.substring(0, 200).trim() + '...';
          bodyText = fullMessage.substring(200).trim();
        }
      } 
      // Short message - put it all in fancy box
      else {
        openingText = fullMessage;
        bodyText = '';
      }
      
      // Opening message in fancy box (first part)
      if (openingText) {
        openingMessageSection = `
          <div style="background: linear-gradient(135deg, #f0f9ff 0%, #e0f2fe 50%, #dbeafe 100%); border: 2px solid #3b82f6; border-radius: 12px; padding: 24px; margin: 0 0 24px 0; box-shadow: 0 4px 12px rgba(59, 130, 246, 0.15);">
            <div style="font-size: 15px; color: #1e40af; line-height: 1.7; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; white-space: pre-wrap; font-weight: 500;">${escapeHtml(openingText)}</div>
          </div>
        `;
      }
      
      // Body text (remaining part) as regular text
      if (bodyText) {
        updateMessageSection = `
          <div style="font-size: 15px; color: #475569; line-height: 1.7; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; margin: 0 0 24px 0; white-space: pre-wrap;">${escapeHtml(bodyText)}</div>
        `;
      }
    }
    
    // Keep email body lean to avoid Apps Script "Email Body Size" limits.
    // Use hosted image URL (logo and photo strip) instead of base64 in email HTML.
    var emailLogoUrl = 'https://cdn.prod.website-files.com/6931dc4e8e97334e195432df/6993ce0abcd54d3520799318_IMG_1763-p-500.jpg';
    
    // Get customer address - use from data, or fetch from customer sheet if not available
    let customerAddress = data.customerAddress || '';
    if (!customerAddress && data.customerEmail) {
      try {
        const spreadsheet = SpreadsheetApp.openById(SPREADSHEET_ID);
        const customers = getCustomersFromSheet(spreadsheet, data.customerEmail);
        if (customers && customers.length > 0) {
          const customer = customers[0];
          customerAddress = customer.address || customer.customerAddress || '';
          if (customerAddress) {
            Logger.log('✅ Retrieved customer address from customer sheet: ' + customerAddress);
          }
        }
      } catch (error) {
        Logger.log('⚠️ Could not fetch customer address from sheet: ' + error.toString());
      }
    }
    
    // Property location section (lightweight: link + address, no embedded map image)
    let propertyLocationSection = '';
    if (customerAddress) {
      var mapsLink = 'https://maps.google.com/?q=' + encodeURIComponent(customerAddress);
      propertyLocationSection = `
        <div style="margin: 32px 0; padding: 20px; background: #f8fafc; border-radius: 12px; border: 1px solid #e2e8f0;">
          <h3 style="font-size: 16px; font-weight: 700; color: #0369a1; margin: 0 0 10px 0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;">📍 Property Location</h3>
          <p style="font-size: 14px; color: #64748b; margin: 0 0 10px 0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;">${escapeHtml(customerAddress)}</p>
          <a href="${mapsLink}" style="font-size: 14px; color: #0369a1; text-decoration: underline; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;">Open in Google Maps</a>
        </div>
      `;
    } else {
      Logger.log('⚠️ No customer address available for property location map');
    }
    
    // Replace template variables
    let emailHtml = templateHtml
      .replace(/{{LOGO_URL}}/g, emailLogoUrl)
      .replace(/{{COMPANY_NAME}}/g, userSettings.companyName || 'A Quality Pool Company')
      .replace(/{{COMPANY_TAGLINE}}/g, userSettings.companyTagline || 'Professional Pool Services')
      .replace(/{{CUSTOMER_NAME}}/g, data.customerName || 'Valued Customer')
      .replace(/{{CUSTOMER_FIRST_NAME}}/g, firstName)
      .replace(/{{OPENING_MESSAGE_SECTION}}/g, openingMessageSection)
      .replace(/{{UPDATE_MESSAGE_SECTION}}/g, updateMessageSection)
      .replace(/{{CUSTOM_MESSAGE}}/g, customMessage || defaultEmailBodyFallback)
      .replace(/{{INVOICE_NUMBER}}/g, data.invoiceNumber || data.id)
      .replace(/{{INVOICE_DATE}}/g, data.date ? new Date(data.date).toLocaleDateString() : new Date().toLocaleDateString())
      .replace(/{{DUE_DATE}}/g, data.dueDate ? new Date(data.dueDate).toLocaleDateString() : 'Upon Receipt')
      .replace(/{{ORIGINAL_AMOUNT}}/g, '$' + originalTotal.toFixed(2))
      .replace(/{{PAYMENT_INFO}}/g, paymentInfoHtml)
      .replace(/{{AMOUNT_DUE_SECTION}}/g, amountDueSection)
      .replace(/{{AMOUNT_LABEL}}/g, amountLabel)
      .replace(/{{AMOUNT_COLOR}}/g, displayAmountColor)
      .replace(/{{TOTAL_AMOUNT}}/g, displayAmount)
      .replace(/{{PAYMENT_BUTTON}}/g, paymentButtonHtml)
      .replace(/{{VIEW_LINK}}/g, viewInvoiceLink)
      .replace(/{{INVOICE_SUMMARY_SECTION}}/g, invoiceSummarySection)
      .replace(/{{PAYMENT_BUTTON_SECTION}}/g, paymentButtonSection)
      .replace(/{{GOOGLE_REVIEW_LINK}}/g, userSettings.googleReviewLink || 'https://share.google/trWXYisbijqaQsu20')
      .replace(/{{FACEBOOK_REVIEW_LINK}}/g, userSettings.facebookLink || 'https://www.facebook.com/profile.php?id=61582806915407')
      .replace(/{{COMPANY_EMAIL}}/g, userSettings.companyEmail || 'samr@aqualitypoolcompanyusa.com')
      .replace(/{{COMPANY_PHONE}}/g, userSettings.companyPhone || '(502) 706-9172')
      .replace(/{{COMPANY_ADDRESS}}/g, userSettings.companyAddress || '')
      .replace(/{{FACEBOOK_LINK}}/g, userSettings.facebookLink || 'https://www.facebook.com/profile.php?id=61582806915407')
      .replace(/{{GOOGLE_LINK}}/g, userSettings.googleReviewLink || 'https://share.google/trWXYisbijqaQsu20')
      .replace(/{{WEBSITE_LINK}}/g, userSettings.websiteLink || 'https://yourwebsite.com')
      .replace(/{{CURRENT_YEAR}}/g, new Date().getFullYear().toString())
      .replace(/{{IMAGE_GALLERY}}/g, imageGalleryHtml)
      .replace(/{{PROPERTY_LOCATION_SECTION}}/g, propertyLocationSection)
      .replace(/{{SNOW_REMOVAL_MESSAGE}}/g, snowRemovalHtml)
      .replace(/{{REVIEW_SECTION}}/g, reviewSectionHtml)
      .replace(/{{TERMS_SECTION}}/g, data.terms ? `
        <table border="0" cellpadding="0" cellspacing="0" width="100%" style="margin: 24px 0;">
          <tr>
            <td style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 20px;">
              <h3 style="font-size: 15px; font-weight: 700; color: #374151; margin: 0 0 12px 0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;">Terms &amp; Conditions</h3>
              <p style="font-size: 13px; color: #6b7280; line-height: 1.7; white-space: pre-wrap; margin: 0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;">${escapeHtml(data.terms)}</p>
            </td>
          </tr>
        </table>` : '');
    
    // Keep external image URLs in email HTML to avoid body-size overflows.
    
    // Add attachments section if there are attachments
    if (attachments && Array.isArray(attachments) && attachments.length > 0) {
      let attachmentsHtml = `
        <div class="attachments-section">
          <h4 class="attachments-title">📎 Attachments</h4>
      `;
      attachments.forEach(att => {
        if (att && att.name) {
          attachmentsHtml += `<div class="attachment-item">• ${att.name}</div>`;
        }
      });
      attachmentsHtml += '</div>';
      emailHtml = emailHtml.replace('{{ATTACHMENTS_SECTION}}', attachmentsHtml);
    } else {
      emailHtml = emailHtml.replace('{{ATTACHMENTS_SECTION}}', '');
    }
    
    // Validate customer email
    if (!data.customerEmail || typeof data.customerEmail !== 'string' || data.customerEmail.trim() === '') {
      Logger.log('❌ Invalid or missing customer email address');
      return { success: false, error: 'Invalid or missing customer email address' };
    }
    
    const customerEmail = data.customerEmail.trim();
    
    // Basic email validation
    const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
    if (!emailRegex.test(customerEmail)) {
      Logger.log('❌ Invalid email format: ' + customerEmail);
      return { success: false, error: 'Invalid email format: ' + customerEmail };
    }
    
    // Prepare email options
    // Use different subject line for daily updates, estimates, and invoices
    let emailSubject;
    if (isDailyUpdate) {
      emailSubject = `Your Update from ${userSettings.companyName || 'A Quality Pool Company'}`;
    } else if (data.type === 'Estimate') {
      emailSubject = `Estimate ${data.quoteNumber || data.invoiceNumber || data.id} from ${userSettings.companyName || 'A Quality Pool Company'}`;
    } else {
      emailSubject = `Invoice ${data.invoiceNumber || data.id} from ${userSettings.companyName || 'A Quality Pool Company'}`;
    }
    
    const emailOptions = {
      to: customerEmail,
      subject: emailSubject,
      htmlBody: emailHtml
    };
    
    // Add attachments if provided (supports both {blob,name} objects and raw blobs)
    const attachmentBlobs = [];
    if (attachments && Array.isArray(attachments) && attachments.length > 0) {
      attachments.forEach(att => {
        try {
          if (!att) return;
          if (att.blob && typeof att.blob.getBytes === 'function') {
            attachmentBlobs.push(att.blob);
            return;
          }
          if (typeof att.getBytes === 'function') {
            attachmentBlobs.push(att);
          }
        } catch (e) {
          Logger.log('⚠️ Skipping invalid attachment: ' + e.toString());
        }
      });
    }
    
    // Attachments for estimates are optional (uses web viewer instead)
    // Attachments for invoices are recommended (PDF + other docs)
    const isEstimateType = normalizeInvoiceEstimateType(data.type) === 'Estimate';
    
    if (attachmentBlobs.length > 0) {
      emailOptions.attachments = attachmentBlobs;
      Logger.log('📎 Adding ' + attachmentBlobs.length + ' attachment(s) to email');
    } else if (isEstimateType) {
      Logger.log('📋 Estimate email: No attachments (using web viewer link instead)');
    } else {
      Logger.log('🧾 Invoice email: No attachments included');
    }
    
    // Send email with error handling
    try {
      Logger.log('📧 Attempting to send email to: ' + customerEmail);
      Logger.log('📧 Email subject: ' + emailSubject);
      Logger.log('📧 Email HTML length: ' + emailHtml.length + ' characters');
      
      MailApp.sendEmail(emailOptions);
      
      Logger.log('✅ Enhanced invoice email sent successfully to ' + customerEmail);
      return { success: true, message: 'Email sent successfully', email: customerEmail };
    } catch (emailError) {
      Logger.log('❌ Error calling MailApp.sendEmail: ' + emailError.toString());
      Logger.log('❌ Error stack: ' + (emailError.stack || 'No stack trace'));
      Logger.log('❌ Email options: ' + JSON.stringify({
        to: customerEmail,
        subject: emailSubject,
        hasHtmlBody: !!emailHtml,
        htmlBodyLength: emailHtml ? emailHtml.length : 0,
        hasAttachments: !!(emailOptions.attachments && emailOptions.attachments.length > 0),
        attachmentCount: emailOptions.attachments ? emailOptions.attachments.length : 0
      }));
      return { success: false, error: 'Failed to send email: ' + emailError.toString() };
    }
    
  } catch (error) {
    Logger.log('❌ Error sending enhanced invoice email: ' + error.toString());
    return { success: false, error: error.toString() };
  }
}

/**
 * Save PDF to customer folder in Google Drive
 * @param {String} customerEmail - Customer email for folder identification
 * @param {String} customerName - Customer name for folder naming
 * @param {Blob} pdfBlob - PDF blob to save
 * @param {String} fileName - PDF file name
 * @returns {Object} Result object with success status and file info
 */
function savePdfToCustomerFolder(customerEmail, customerName, pdfBlob, fileName) {
  try {
    const rootFolderId = PropertiesService.getScriptProperties().getProperty('CUSTOMER_FOLDERS_ROOT_ID');
    if (!rootFolderId) {
      Logger.log('⚠️ CUSTOMER_FOLDERS_ROOT_ID not set in Script Properties');
      return { success: false, error: 'Customer folders root not configured' };
    }
    
    const rootFolder = DriveApp.getFolderById(rootFolderId);
    
    // Find or create customer folder
    const folderName = `${customerName} - ${customerEmail}`;
    let customerFolder;
    const folders = rootFolder.getFoldersByName(folderName);
    
    if (folders.hasNext()) {
      customerFolder = folders.next();
    } else {
      customerFolder = rootFolder.createFolder(folderName);
      Logger.log('📁 Created new customer folder: ' + folderName);
    }
    
    // Save PDF to folder
    const file = customerFolder.createFile(pdfBlob.setName(fileName));
    
    // Make file accessible
    file.setSharing(DriveApp.Access.ANYONE_WITH_LINK, DriveApp.Permission.VIEW);
    
    Logger.log('✅ Saved PDF: ' + fileName);
    
    return {
      success: true,
      fileName: fileName,
      fileUrl: file.getUrl(),
      fileId: file.getId()
    };
    
  } catch (error) {
    Logger.log('❌ Error in savePdfToCustomerFolder: ' + error.toString());
    return { success: false, error: error.toString() };
  }
}

/**
 * Save attachment images to customer folder in Google Drive
 * @param {String} customerEmail - Customer email for folder identification
 * @param {String} customerName - Customer name for folder naming
 * @param {Array} imageUrls - Array of image URLs to save
 * @returns {Array} Array of saved file URLs
 */
function saveAttachmentsToCustomerFolder(customerEmail, customerName, imageUrls) {
  try {
    // Validate inputs
    if (!imageUrls || !Array.isArray(imageUrls) || imageUrls.length === 0) {
      Logger.log('⚠️ No valid imageUrls provided to saveAttachmentsToCustomerFolder');
      return { success: true, files: [] }; // Return empty success
    }
    
    const rootFolderId = PropertiesService.getScriptProperties().getProperty('CUSTOMER_FOLDERS_ROOT_ID');
    if (!rootFolderId) {
      Logger.log('⚠️ CUSTOMER_FOLDERS_ROOT_ID not set in Script Properties');
      return { success: false, error: 'Customer folders root not configured', files: [] };
    }
    
    const rootFolder = DriveApp.getFolderById(rootFolderId);
    
    // Find or create customer folder
    const folderName = `${customerName} - ${customerEmail}`;
    let customerFolder;
    const folders = rootFolder.getFoldersByName(folderName);
    
    if (folders.hasNext()) {
      customerFolder = folders.next();
    } else {
      customerFolder = rootFolder.createFolder(folderName);
      Logger.log('📁 Created new customer folder: ' + folderName);
    }
    
    // Save each image
    const savedFiles = [];
    imageUrls.forEach((url, index) => {
      // Skip null, undefined, or empty URLs
      if (!url || typeof url !== 'string' || url.trim() === '') {
        Logger.log('⚠️ Skipping invalid URL at index ' + index);
        return;
      }
      
      try {
        const response = UrlFetchApp.fetch(url);
        const blob = response.getBlob();
        const fileName = `Attachment_${new Date().getTime()}_${index + 1}.${blob.getContentType().split('/')[1]}`;
        const file = customerFolder.createFile(blob.setName(fileName));
        
        // Make file accessible
        file.setSharing(DriveApp.Access.ANYONE_WITH_LINK, DriveApp.Permission.VIEW);
        
        savedFiles.push({
          name: fileName,
          url: file.getUrl(),
          id: file.getId()
        });
        
        Logger.log('✅ Saved attachment: ' + fileName);
      } catch (error) {
        Logger.log('❌ Error saving attachment ' + (index + 1) + ': ' + error.toString());
        // Don't push anything - just skip this attachment
      }
    });
    
    return { success: true, files: savedFiles };
    
  } catch (error) {
    Logger.log('❌ Error in saveAttachmentsToCustomerFolder: ' + error.toString());
    return { success: false, error: error.toString(), files: [] };
  }
}

