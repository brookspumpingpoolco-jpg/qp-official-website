                <strong style="font-size: 14px; color: #0f172a; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;">${data.date ? new Date(data.date).toLocaleDateString() : new Date().toLocaleDateString()}</strong>
