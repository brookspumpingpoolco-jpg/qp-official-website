/**
 * Get Price Book items (from ItemList.gs structure)
 */
function getPriceBookData(spreadsheet) {
  try {
    const sheet = spreadsheet.getSheetByName(PRICE_BOOK_SHEET);
    if (!sheet) {
      return { byCategory: {}, allItems: [] };
    }
    
    const data = sheet.getDataRange().getValues();
    if (data.length <= 6) {
      return { byCategory: {}, allItems: [] };
    }
    
    const itemsByCategory = {};
    const allItems = [];
    
    // Headers are in row 5 (index 4), data starts at row 7 (index 6)
    for (let i = 6; i < data.length; i++) {
      const row = data[i];
      const brand = row[0] || '';
      const itemCode = row[1] || '';
      const itemName = row[2] || '';
      const category = row[3] || 'Other';
      const unit = row[4] || 'Each';
      const price = parseFloat(row[5]) || 0;
      const description = row[6] || '';
      const imageUrl = row[7] || '';
      const active = row[8] === true || row[8] === 'TRUE' || row[8] === true;
      
      if (!active || !itemName) continue;
      
      const item = {
        brand: brand,
        code: itemCode,
        name: itemName,
        category: category,
        unit: unit,
        price: price,
        description: description,
        imageUrl: imageUrl
      };
      
      allItems.push(item);
      
      if (!itemsByCategory[category]) {
        itemsByCategory[category] = [];
      }
      itemsByCategory[category].push(item);
    }
    
    return {
      byCategory: itemsByCategory,
      allItems: allItems
    };
  } catch (error) {
    Logger.log('Error getting price book data: ' + error.toString());
    return { byCategory: {}, allItems: [] };
  }
}

/**
 * Get Labor items
 */
function getLaborData(spreadsheet) {
  try {
    const sheet = spreadsheet.getSheetByName(LABOR_SHEET);
    if (!sheet) {
      Logger.log('Labor sheet not found. Sheet name: ' + LABOR_SHEET);
      return { byCategory: {}, allItems: [] };
    }
    
    const data = sheet.getDataRange().getValues();
    Logger.log('Labor sheet data rows: ' + data.length);
    
    if (data.length <= 1) {
      Logger.log('Labor sheet has no data rows (only headers or empty)');
      return { byCategory: {}, allItems: [] };
    }
    
    const itemsByCategory = {};
    const allItems = [];
    
    // Labor sheet structure: 
    // Row 1-3: Title/instructions
    // Row 4 (index 3): Headers = "Labor Type", "Category", "Unit", "Rate", "Description", "Notes", "Active"
    // Row 5 (index 4): Helper text
    // Row 6+ (index 5+): Data rows
    
    // Default column positions (standard structure)
    let nameCol = 0; // Column A: Labor Type
    let categoryCol = 1; // Column B: Category
    let unitCol = 2; // Column C: Unit
    let priceCol = 3; // Column D: Rate
    let descCol = 4; // Column E: Description
    let notesCol = 5; // Column F: Notes
    let activeCol = 6; // Column G: Active
    
    // Try to detect headers in row 4 (index 3) for flexibility
    // But use default positions as fallback (standard structure)
    if (data.length > 3) {
      const headerRow = data[3] || []; // Row 4 in Google Sheets (index 3)
      for (let i = 0; i < headerRow.length; i++) {
        const header = String(headerRow[i] || '').toLowerCase().trim();
        if (header.includes('labor type') || (header.includes('labor') && header.includes('type')) || header === 'labor type') {
          nameCol = i;
        } else if (header === 'category' || header.includes('category')) {
          categoryCol = i;
        } else if (header === 'unit') {
          unitCol = i;
        } else if (header === 'rate' || header.includes('rate')) {
          priceCol = i;
        } else if (header === 'description' || header.includes('description')) {
          descCol = i;
        } else if (header === 'notes') {
          notesCol = i;
        } else if (header === 'active') {
          activeCol = i;
        }
      }
    }
    
    // Data starts at row 6 (index 5) - after headers (row 4) and helper text (row 5)
    let dataStartRow = 5; // Row 6 in Google Sheets (index 5)
    
    Logger.log('Labor sheet structure: Headers in row 4 (index 3), Data starts at row 6 (index 5)');
    Logger.log('Labor columns - nameCol: ' + nameCol + ' (Labor Type), categoryCol: ' + categoryCol + ', unitCol: ' + unitCol + ', priceCol: ' + priceCol + ' (Rate), descCol: ' + descCol + ', activeCol: ' + activeCol);
    
    for (let i = dataStartRow; i < data.length; i++) {
      const row = data[i];
      
      // Extract values from correct columns
      const itemName = String(row[nameCol] || '').trim();
      const category = String(row[categoryCol] || 'General').trim();
      const unit = String(row[unitCol] || 'Hour').trim();
      let price = 0;
      
      // Handle price - can be number or string with $ or comma
      const priceValue = row[priceCol];
      if (typeof priceValue === 'number') {
        price = priceValue;
      } else if (typeof priceValue === 'string') {
        // Remove $ and commas, then parse
        price = parseFloat(priceValue.replace(/[$,]/g, '')) || 0;
      } else {
        price = parseFloat(priceValue) || 0;
      }
      
      const description = String(row[descCol] || '').trim();
      const activeValue = row.length > activeCol ? row[activeCol] : true;
      
      // Check if active - handle checkbox, boolean, text
      let active = true;
      if (activeValue === false || activeValue === 'FALSE' || activeValue === 'No' || activeValue === 'N' || activeValue === 0 || activeValue === '') {
        active = false;
      } else if (activeValue === true || activeValue === 'TRUE' || activeValue === 'Yes' || activeValue === 'Y' || activeValue === 1 || activeValue === '✓' || activeValue === 'x') {
        active = true;
      }
      
      // Skip empty rows or inactive items
      if (!itemName || itemName === '') continue;
      if (!active) continue;
      
      const item = {
        name: itemName,
        category: category || 'General',
        unit: unit || 'Hour',
        price: price,
        description: description
      };
      
      allItems.push(item);
      
      const catKey = category || 'General';
      if (!itemsByCategory[catKey]) {
        itemsByCategory[catKey] = [];
      }
      itemsByCategory[catKey].push(item);
      
      Logger.log('Added labor item: ' + itemName + ', Price: $' + price + ', Unit: ' + unit);
    }
    
    Logger.log('Total labor items found: ' + allItems.length);
    
    Logger.log('Loaded ' + allItems.length + ' labor items from ' + LABOR_SHEET + ' sheet');
    
    return {
      byCategory: itemsByCategory,
      allItems: allItems
    };
  } catch (error) {
    Logger.log('Error getting labor data: ' + error.toString());
    return { byCategory: {}, allItems: [] };
  }
}

/**
 * Get Default Labor Sets
 */
function getDefaultLaborSets(spreadsheet) {
  try {
    const sheetName = 'Default Labor Sets';
    let sheet = spreadsheet.getSheetByName(sheetName);
    
    if (!sheet) {
      // Create sheet if it doesn't exist
      sheet = spreadsheet.insertSheet(sheetName);
      const headers = ['Set Name', 'Description', 'Labor Items JSON', 'Created Date', 'Last Used'];
      sheet.getRange(1, 1, 1, headers.length).setValues([headers]);
      sheet.getRange(1, 1, 1, headers.length).setFontWeight('bold');
      return { success: true, sets: [] };
    }
    
    const data = sheet.getDataRange().getValues();
    if (data.length <= 1) {
      return { success: true, sets: [] };
    }
    
    const sets = [];
    for (let i = 1; i < data.length; i++) {
      const row = data[i];
      if (!row[0]) continue; // Skip empty rows
      
      try {
        const laborItems = JSON.parse(row[2] || '[]');
        sets.push({
          id: i,
          name: row[0] || '',
          description: row[1] || '',
          laborItems: laborItems,
