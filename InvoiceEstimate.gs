// PM_Projects: getAllProjects() and getProject() are defined ONLY in ProjectManagement.gs.
// Do not duplicate them here — in Apps Script the last file wins; duplicates caused Status/JSON column bugs and confusion.

/**
 * Resolve project ID robustly for project-detail milestone invoice sending.
 * Handles projectId, estimateId, invoiceId, linkedEstimateId, and milestone membership.
 */
function resolveProjectIdForMilestoneSend(projectId, milestoneId, linkedId) {
  const targetProjectId = String(projectId || '').trim();
  const targetMilestoneId = String(milestoneId || '').trim();
  const targetLinkedId = String(linkedId || '').trim();

  if (targetProjectId) {
    const direct = getProject(targetProjectId);
    if (direct && direct.success) return targetProjectId;
  }

  const all = getAllProjects();
  const projects = (all && all.success && Array.isArray(all.projects)) ? all.projects : [];
  if (!projects.length) return '';

  const match = projects.find(function(p) {
    const pid = String(p.projectId || '').trim();
    const pd = p.projectData || {};
    const estId = String(pd.estimateId || '').trim();
    const invId = String(pd.invoiceId || '').trim();
    const linkedId = String(pd.linkedEstimateId || '').trim();

    let schedule = pd.paymentSchedule || [];
    if (typeof schedule === 'string') {
      try { schedule = JSON.parse(schedule || '[]'); } catch (e) { schedule = []; }
    }
    if (!Array.isArray(schedule)) schedule = [];
    const hasMilestone = targetMilestoneId && schedule.some(function(ms) {
      return String(ms.id || '').trim() === targetMilestoneId;
    });

    if (targetLinkedId && (estId === targetLinkedId || invId === targetLinkedId || linkedId === targetLinkedId)) {
      return true;
    }
    if (targetProjectId) {
      return pid === targetProjectId || estId === targetProjectId || invId === targetProjectId || linkedId === targetProjectId || hasMilestone;
    }
    return hasMilestone;
  });

  return match ? String(match.projectId || '').trim() : '';
}

/**
 * Entry point used by doPost(action=generateInvoice) from Project Details.
 * Adds robust project-id resolution and clear debug context in failures.
 */
function generateInvoiceFromProjectDetail(projectId, milestoneId, linkedId, addProcessingFee) {
  try {
    const resolvedProjectId = resolveProjectIdForMilestoneSend(projectId, milestoneId, linkedId);
    if (!resolvedProjectId) {
      return {
        success: false,
        error: 'Project not found',
        debug: {
          receivedProjectId: String(projectId || ''),
          receivedMilestoneId: String(milestoneId || ''),
          receivedLinkedId: String(linkedId || ''),
          note: 'Could not resolve to PM_Projects row'
        }
      };
    }

    const result = quickSendInvoice(resolvedProjectId, milestoneId, addProcessingFee === true);
    if (result && result.success) {
      result.projectId = resolvedProjectId;
      return result;
    }

    return {
      success: false,
      error: (result && result.error) ? result.error : 'Failed to send milestone invoice',
      debug: {
        receivedProjectId: String(projectId || ''),
        resolvedProjectId: resolvedProjectId,
        receivedMilestoneId: String(milestoneId || ''),
        receivedLinkedId: String(linkedId || '')
      }
    };
  } catch (error) {
    return {
      success: false,
      error: 'generateInvoiceFromProjectDetail error: ' + error.toString(),
      debug: {
        receivedProjectId: String(projectId || ''),
        receivedMilestoneId: String(milestoneId || ''),
        receivedLinkedId: String(linkedId || '')
      }
    };
  }
}

/**
 * Fallback entry point when Stripe link is created outside Apps Script
 * (e.g., Netlify function) due to UrlFetch quota limits.
 */
function generateInvoiceFromProjectDetailWithPaymentLink(projectId, milestoneId, paymentUrl, linkedId, addProcessingFee) {
  try {
    const resolvedProjectId = resolveProjectIdForMilestoneSend(projectId, milestoneId, linkedId);
    if (!resolvedProjectId) {
      return {
        success: false,
        error: 'Project not found',
        debug: {
          receivedProjectId: String(projectId || ''),
          receivedMilestoneId: String(milestoneId || ''),
          receivedLinkedId: String(linkedId || ''),
          note: 'Could not resolve to PM_Projects row'
        }
      };
    }

    if (!paymentUrl || !String(paymentUrl).trim()) {
      return {
