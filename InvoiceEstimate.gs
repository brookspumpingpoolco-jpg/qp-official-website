/**
 * Generate PDF and save to Drive
 */
/**
 * Render a satellite property map as an embedded data URI for PDF conversion.
 * Using the Apps Script Maps service avoids browser-referrer restrictions on
 * the Google Static Maps API key and prevents the PDF renderer from having to
 * download an external image.
 */
function getSatelliteMapDataUri_(address, width, height) {
  try {
    var cleanAddress = String(address || '').replace(/\s+/g, ' ').trim();
    if (!cleanAddress) return null;

    var map = Maps.newStaticMap()
      .setSize(Math.min(parseInt(width, 10) || 600, 640), Math.min(parseInt(height, 10) || 400, 640))
      .setCenter(cleanAddress)
      .setZoom(18)
      .setMapType(Maps.StaticMap.Type.SATELLITE)
      .addMarker(cleanAddress);

    var mapBlob = map.getBlob();
    var contentType = mapBlob.getContentType() || 'image/png';
    var encoded = Utilities.base64Encode(mapBlob.getBytes());
    Logger.log('✅ Satellite map rendered for PDF (' + cleanAddress + ', ' + encoded.length + ' base64 chars)');
    return 'data:' + contentType + ';base64,' + encoded;
  } catch (mapError) {
    Logger.log('❌ Satellite map rendering failed for PDF: ' + mapError.toString());
    return null;
  }
}

/**
 * Unified PDF generation function - uses InvoiceTemplate.html for ALL PDFs
 * Supports signatures for signed contracts
 * @param {string} id - Invoice/Estimate ID
 * @param {object} data - Invoice/Estimate data
 * @param {object} options - Optional: customerSignature, customerPrintedName, adminSignature, adminPrintedName, signedContractImageUrl
 * @returns {string} - PDF file URL
 */
function generateUnifiedPDF(id, data, options) {
  try {
    options = options || {};
    
    // Use InvoiceTemplate.html and fill with data
    const template = HtmlService.createTemplateFromFile('InvoiceTemplate');
    template.data = data;
    template.items = JSON.parse(data.items || '[]');
    
    // Calculate totals
    const items = template.items;
    const subtotal = items.reduce((sum, item) => sum + (parseFloat(item.quantity || 0) * parseFloat(item.price || 0)), 0);
    const taxRate = parseFloat(data.taxRate || 0);
    const taxAmount = subtotal * (taxRate / 100);
    const discount = parseFloat(data.discount || 0);
    const total = subtotal + taxAmount - discount;
    
    template.subtotal = subtotal;
    template.taxRate = taxRate;
    template.taxAmount = taxAmount;
    template.discount = discount;
    template.total = total;
    
    // Add signature data if provided
    template.customerSignature = options.customerSignature || '';
    template.customerPrintedName = options.customerPrintedName || '';
    template.adminSignature = options.adminSignature || '';
    template.adminPrintedName = options.adminPrintedName || '';
    template.signedContractImageUrl = options.signedContractImageUrl || '';
    template.isSignedContract = !!(options.customerSignature || options.adminSignature);
    
    let htmlContent = template.evaluate().getContent();
    
    // Replace logo URL with base64 for PDF compatibility (non-fatal if quota exhausted)
    try {
      const logoBase64 = getLogoBase64();
      htmlContent = htmlContent.replace(
        /https:\/\/cdn\.prod\.website-files\.com\/[^"']+/g,
        logoBase64
      );
    } catch (logoErr) {
      Logger.log('⚠️ Logo replacement skipped: ' + logoErr.toString());
    }
    
    // Helper function to convert image URL to base64
    const getImageBase64 = (imageUrl) => {
      if (!imageUrl || !imageUrl.trim()) return null;
      try {
        const response = UrlFetchApp.fetch(imageUrl);
        const blob = response.getBlob();
    
        // Detect image type from blob
        let imageType = 'png'; // default
        const contentType = blob.getContentType();
        if (contentType && contentType.startsWith('image/')) {
          imageType = contentType.split('/')[1].split(';')[0]; // e.g., 'jpeg', 'png', 'gif'
        }
        
        const base64 = Utilities.base64Encode(blob.getBytes());
        return `data:image/${imageType};base64,${base64}`;
      } catch (error) {
        Logger.log('Error fetching image from ' + imageUrl + ': ' + error.toString());
        return null;
      }
    };
    
    // Get customer address - use from data, or fetch from customer sheet if not available
    let customerAddress = data.customerAddress || '';
    if (!customerAddress && data.customerEmail) {
      try {
        const spreadsheet = SpreadsheetApp.openById(SPREADSHEET_ID);
        const customers = getCustomersFromSheet(spreadsheet, data.customerEmail);
        if (customers && customers.length > 0) {
          const customer = customers[0];
          customerAddress = customer.address || customer.customerAddress || '';
          if (customerAddress) {
            Logger.log('✅ Retrieved customer address from customer sheet for PDF: ' + customerAddress);
          }
        }
      } catch (error) {
        Logger.log('⚠️ Could not fetch customer address from sheet for PDF: ' + error.toString());
      }
    }
    
    // Replace property location map URL with an embedded image for PDF compatibility.
    if (customerAddress) {
      try {
        const mapBase64 = getSatelliteMapDataUri_(customerAddress, 600, 400);
        if (mapBase64) {
          // Replace the Google Maps URL with base64 version
          htmlContent = htmlContent.replace(
            /https:\/\/maps\.googleapis\.com\/maps\/api\/staticmap[^"']+/g,
            mapBase64
          );
          Logger.log('✅ Property location map converted to base64 for PDF');
        } else {
          Logger.log('⚠️ Could not fetch property map image');
          htmlContent = htmlContent.replace(
            /<img src="https:\/\/maps\.googleapis\.com\/maps\/api\/staticmap[^"]*"[^>]*>/g,
            '<p style="color: #6b7280; font-size: 13px;">Property location map unavailable</p>'
          );
        }
      } catch (error) {
        Logger.log('⚠️ Could not convert property map to base64: ' + error.toString());
        // Remove the image if it fails to load
        htmlContent = htmlContent.replace(
          /<img src="https:\/\/maps\.googleapis\.com\/maps\/api\/staticmap[^"]*"[^>]*>/g,
          '<p style="color: #6b7280; font-size: 13px;">Property location map unavailable</p>'
        );
      }
    } else {
      Logger.log('⚠️ No customer address available for property location map in PDF');
    }
    
    // Add signatures to HTML if provided
    if (options.customerSignature) {
      const signatureHtml = `
        <div style="margin-top: 40px; padding-top: 30px; border-top: 2px solid #e5e7eb;">
          <h3 style="color: #0369a1; margin-bottom: 20px;">Customer Signature</h3>
          <img src="${options.customerSignature}" style="max-width: 300px; height: auto; margin-bottom: 10px;" />
          <p style="margin-top: 10px;"><strong>Printed Name:</strong> ${options.customerPrintedName || 'N/A'}</p>
          <p><strong>Date Signed:</strong> ${data.approvalDate ? new Date(data.approvalDate).toLocaleDateString() : new Date().toLocaleDateString()}</p>
        </div>
      `;
      htmlContent = htmlContent.replace('</body>', signatureHtml + '</body>');
    }
    
    if (options.adminSignature) {
      const adminSignatureHtml = `
        <div style="margin-top: 40px; padding-top: 30px; border-top: 2px solid #e5e7eb;">
          <h3 style="color: #0369a1; margin-bottom: 20px;">Company Signature</h3>
          <img src="${options.adminSignature}" style="max-width: 300px; height: auto; margin-bottom: 10px;" />
          <p style="margin-top: 10px;"><strong>Printed Name:</strong> ${options.adminPrintedName || COMPANY_NAME}</p>
          <p><strong>Date Signed:</strong> ${data.adminSignedDate ? new Date(data.adminSignedDate).toLocaleDateString() : new Date().toLocaleDateString()}</p>
        </div>
      `;
      htmlContent = htmlContent.replace('</body>', adminSignatureHtml + '</body>');
    }
    
    // Add uploaded signed contract image if provided
    if (options.signedContractImageUrl) {
      try {
        const imageBase64 = getImageBase64(options.signedContractImageUrl);
        const imageHtml = `
          <div style="margin-top: 40px; padding-top: 30px; border-top: 2px solid #e5e7eb;">
            <h3 style="color: #0369a1; margin-bottom: 20px;">Uploaded Signed Contract</h3>
            <img src="${imageBase64}" style="max-width: 100%; height: auto; border: 1px solid #e5e7eb; border-radius: 8px;" />
          </div>
        `;
        htmlContent = htmlContent.replace('</body>', imageHtml + '</body>');
      } catch (e) {
        Logger.log('⚠️ Could not add uploaded contract image: ' + e.toString());
      }
    }
    
    // Convert to PDF
    const blob = Utilities.newBlob(htmlContent, 'text/html', 'invoice.html');
    const pdfName = options.isSignedContract 
      ? `Signed_Contract_${data.customerName.replace(/[^a-zA-Z0-9]/g, '_')}_${id}.pdf`
      : `${data.type || 'Estimate'} - ${id}.pdf`;
    const pdf = blob.getAs('application/pdf').setName(pdfName);
    
    // Save to customer folder in Drive
    let pdfFile;
    if (CUSTOMER_DRIVE_FOLDER_ID && data.customerName) {
      const parentFolder = DriveApp.getFolderById(CUSTOMER_DRIVE_FOLDER_ID);
      const customerFolderName = `${data.customerName} - ${data.customerAddress || 'No Address'}`;
      
      let customerFolder;
      const folders = parentFolder.getFoldersByName(customerFolderName);
      if (folders.hasNext()) {
        customerFolder = folders.next();
      } else {
        customerFolder = parentFolder.createFolder(customerFolderName);
      }
      
      pdfFile = customerFolder.createFile(pdf);
    } else {
      // Fallback to root folder
      pdfFile = DriveApp.createFile(pdf);
    }
    
    pdfFile.setSharing(DriveApp.Access.ANYONE_WITH_LINK, DriveApp.Permission.VIEW);
    
    Logger.log('✅ Unified PDF generated: ' + pdfFile.getUrl());
    return pdfFile.getUrl();
  } catch (error) {
    Logger.log('❌ Error generating unified PDF: ' + error.toString());
    return '';
  }
}

/**
 * Generate PDF and save to Drive (legacy function - now uses unified function)
 */
function generateAndSavePDF(id, data) {
  return generateUnifiedPDF(id, data, {});
}

/**
 * When an estimate/invoice row is linked to a PM project, use the project's line items
 * (including one-off add-ons) as the source of truth for the public viewer.
 */
function mergeLinkedProjectItemsIntoInvoiceData(jsonData, invoiceIdForLookup) {
  try {
    if (!jsonData || typeof jsonData !== 'object') return jsonData;
    const lookupId = String(invoiceIdForLookup || jsonData.id || '').trim();
    if (!lookupId) return jsonData;

    if (typeof getProjectByLinkedInvoiceId !== 'function') {
      Logger.log('⚠️ mergeLinkedProjectItemsIntoInvoiceData: getProjectByLinkedInvoiceId not available');
      return jsonData;
    }

    const linked = getProjectByLinkedInvoiceId(lookupId);
    if (!linked || !linked.success || !linked.project) return jsonData;

    let pd = linked.project;
    // Prefer fresh read by project id (canonical items + one-offs)
    const pidForRefresh = String(linked.projectId || pd.projectId || '').trim();
    if (pidForRefresh && typeof getProject === 'function') {
      try {
        const fresh = getProject(pidForRefresh);
        if (fresh && fresh.success && fresh.project) {
          pd = fresh.project;
        }
      } catch (refreshErr) {
        Logger.log('mergeLinkedProjectItemsIntoInvoiceData refresh: ' + refreshErr.toString());
      }
    }
    // Nested shape used by some UI paths
    if ((!pd.items || !Array.isArray(pd.items) || pd.items.length === 0) && pd.projectData && pd.projectData.items) {
      pd = Object.assign({}, pd, pd.projectData);
    }

    let items = pd.items;
    if (typeof items === 'string') {
      try { items = JSON.parse(items || '[]'); } catch (e) { items = []; }
    }
    if (!Array.isArray(items) || items.length === 0) return jsonData;

    const normalized = items.map(function(item) {
      const qty = parseFloat(item.quantity || 1);
      const price = parseFloat(item.price || item.unitPrice || 0);
      const nameLower = String(item.name || item.description || '').toLowerCase();
      return {
        name: item.name || item.description || 'Item',
        description: item.description || item.name || '',
        quantity: qty,
        price: price,
        total: parseFloat(item.total != null ? item.total : (qty * price)),
        isProcessingFee: item.isProcessingFee === true || nameLower.indexOf('processing fee') !== -1,
        isOneOff: item.isOneOff === true
      };
    });

    jsonData.items = JSON.stringify(normalized);

    const projectTotal = parseFloat(pd.totalValue || pd.total || 0);
    if (projectTotal > 0) {
      jsonData.subtotal = projectTotal;
      jsonData.total = projectTotal;
    }

    if (linked.projectId) jsonData.projectId = linked.projectId;
    else if (pd.projectId) jsonData.projectId = pd.projectId;

    if (pd.paymentSchedule) {
      try {
        jsonData.paymentSchedule = typeof pd.paymentSchedule === 'string'
          ? pd.paymentSchedule
          : JSON.stringify(pd.paymentSchedule);
      } catch (psErr) { /* keep existing */ }
    }
    if (pd.terms && String(pd.terms).trim()) jsonData.terms = pd.terms;

    jsonData.type = 'Invoice';

    Logger.log('✅ mergeLinkedProjectItemsIntoInvoiceData: merged ' + normalized.length + ' items from project for invoice ' + lookupId);
    return jsonData;
  } catch (e) {
    Logger.log('mergeLinkedProjectItemsIntoInvoiceData: ' + e.toString());
    return jsonData;
  }
}

/**
 * If document is linked to a PM project, customer-facing type should be Invoice (not Estimate).
 */
function applyLinkedProjectInvoiceType(jsonData, invoiceIdForLookup) {
  try {
    if (!jsonData || typeof jsonData !== 'object') return jsonData;
    if (normalizeInvoiceEstimateType(jsonData.type) === 'Invoice') return jsonData;
    var lid = String(invoiceIdForLookup || jsonData.id || '').trim();
    if (!lid || typeof getProjectByLinkedInvoiceId !== 'function') return jsonData;
    var linked = getProjectByLinkedInvoiceId(lid);
    if (linked && linked.success && linked.projectId) {
      jsonData.type = 'Invoice';
      jsonData.linkedToProjectId = linked.projectId;
    }
    return jsonData;
  } catch (e) {
    Logger.log('applyLinkedProjectInvoiceType: ' + e.toString());
    return jsonData;
  }
}

/**
 * Narrow a linked sheet document to a single one-off line + correct Stripe URL (PM col A match).
 */
function applyOneOffTrackingFilterToInvoiceData(jsonData, trackingId) {
  try {
    if (!jsonData || !trackingId) return jsonData;
    var tid = String(trackingId).trim();
    if (!tid) return jsonData;
    var items = [];
    try {
      items = JSON.parse(jsonData.items || '[]');
    } catch (e) {
      return jsonData;
    }
    if (!Array.isArray(items)) return jsonData;
    var filtered = items.filter(function(it) {
      return String(it.oneOffTrackingId || '').trim() === tid;
    });
    if (filtered.length === 0) return jsonData;
    var sub = filtered.reduce(function(s, it) {
      return s + (parseFloat(it.quantity || 1) * parseFloat(it.price != null && it.price !== '' ? it.price : (it.unitPrice || 0)));
    }, 0);
    jsonData.items = JSON.stringify(filtered);
    jsonData.subtotal = sub;
    jsonData.total = sub;
    jsonData.type = 'Invoice';
    jsonData.oneOffViewOnly = true;
    var stripeUrl = getPMStripeUrlByTrackingId(tid);
    if (stripeUrl) jsonData.paymentLink = stripeUrl;
    return jsonData;
  } catch (err) {
    Logger.log('applyOneOffTrackingFilterToInvoiceData: ' + err.toString());
    return jsonData;
  }
}

/**
 * PM_Project_Invoices row is a one-off: single line + invoice type (not full project total).
 */
function buildOneOffPMInvoiceIfApplicable(milestoneData, rowIndex, matchedId) {
  try {
    var rowType = String(milestoneData[rowIndex][8] || '').trim();
    if (rowType !== 'One-Off') return null;
    var projectId = milestoneData[rowIndex][1];
    var lineName = milestoneData[rowIndex][2];
    var rowAmount = parseFloat(milestoneData[rowIndex][3] || 0);
    var status = milestoneData[rowIndex][4] || 'Pending';
    var stripeLink = milestoneData[rowIndex][5] || '';
    var dateSent = milestoneData[rowIndex][6];
    var rowNotes = milestoneData[rowIndex][7] || '';
    var rowQty = parseFloat(milestoneData[rowIndex][9] || 1);
    var rowUnitRaw = milestoneData[rowIndex][10];
    var rowUnit = parseFloat(rowUnitRaw != null && rowUnitRaw !== '' ? rowUnitRaw : (rowAmount / (rowQty || 1)));
    var project = getProject(projectId);
    if (!project || !project.success) {
      return { success: false, error: 'Project not found for one-off invoice' };
    }
    var projectData = project.project;
    var linkedId = projectData.estimateId || projectData.invoiceId || projectData.linkedEstimateId || '';
    var shareBase = linkedId
      ? (WEBFLOW_INVOICE_VIEWER_URL + '?id=' + encodeURIComponent(linkedId))
      : (WEBFLOW_INVOICE_VIEWER_URL + '?id=' + encodeURIComponent(String(matchedId).trim()));
    var shareLink = shareBase + (shareBase.indexOf('?') >= 0 ? '&' : '?') + 'oneOffTrackingId=' + encodeURIComponent(String(matchedId).trim());
    var oneItem = [{
      name: lineName,
      description: rowNotes || lineName,
      quantity: rowQty,
      price: rowUnit,
      total: rowAmount,
      isOneOff: true,
      oneOffTrackingId: String(matchedId).trim()
    }];
    return {
      success: true,
      data: {
        id: String(matchedId).trim(),
        invoiceNumber: String(matchedId).trim(),
        type: 'Invoice',
        date: dateSent ? new Date(dateSent).toISOString() : new Date().toISOString(),
        customerName: projectData.customerName || '',
        customerEmail: projectData.customerEmail || '',
        customerPhone: projectData.customerPhone || '',
        customerAddress: projectData.customerAddress || '',
        items: JSON.stringify(oneItem),
        subtotal: rowAmount,
        taxRate: 0,
        tax: 0,
        discount: 0,
        total: rowAmount,
        notes: rowNotes || ('One-off charge for project ' + projectId),
        paymentLink: stripeLink,
        shareLink: shareLink,
        status: status,
        paymentStatus: status === 'Paid' ? 'Paid' : 'Pending',
        projectId: projectId,
        isOneOffPMInvoice: true,
        isMilestoneInvoice: false,
        currentMilestoneName: lineName,
        currentMilestoneAmount: rowAmount,
        terms: projectData.terms || ''
      }
    };
  } catch (e) {
    Logger.log('buildOneOffPMInvoiceIfApplicable: ' + e.toString());
    return null;
  }
}

/**
 * Unified payment history write with Stripe session/payment-intent idempotency.
 * @returns {{success: boolean, duplicate?: boolean, message?: string}}
 */
function recordPaymentHistoryUnified(invoiceId, amount, transactionId, paymentMethod, companyId, paymentDate, email, description, fee, notes) {
  try {
    var txn = String(transactionId || '').trim();
    var inv = String(invoiceId || '').trim();
    var method = paymentMethod || 'Manual';
    var company = companyId || 'CMP-AQUALITYPOOL';
    var payDate = paymentDate ? (paymentDate instanceof Date ? paymentDate : new Date(paymentDate)) : new Date();
    var emailVal = email || '';
    var desc = description || '';
    var feeVal = fee != null && fee !== '' ? parseFloat(fee) : 0;
    var notesCol = notes != null && notes !== undefined ? String(notes) : '';

    if (!txn && method.toLowerCase() === 'stripe') {
      return recordPaymentHistory(inv, amount, txn, method, company, payDate, emailVal, desc, feeVal, notesCol);
    }

    var lock = LockService.getScriptLock();
    lock.waitLock(15000);
    try {
      var sheet = SpreadsheetApp.openById(SPREADSHEET_ID).getSheetByName(PAYMENT_HISTORY_SHEET);
      if (!sheet) {
        sheet = SpreadsheetApp.openById(SPREADSHEET_ID).insertSheet(PAYMENT_HISTORY_SHEET);
        var headers = ['Date', 'Invoice ID', 'Company ID', 'Amount', 'Payment Method', 'Transaction ID', 'Status', 'Email', 'Description', 'Fee', 'Notes'];
        sheet.getRange(1, 1, 1, headers.length).setValues([headers]);
        sheet.getRange(1, 1, 1, headers.length).setFontWeight('bold');
      }

      var existing = sheet.getDataRange().getValues();
      var txnCol = 5;
      var invCol = 1;
      var amtCol = 3;
      for (var i = 1; i < existing.length; i++) {
        var existingTxn = String(existing[i][txnCol] || '').trim();
        var existingInv = String(existing[i][invCol] || '').trim();
        if (existingTxn && existingTxn === txn) {
          Logger.log('⚠️ DUPLICATE PAYMENT (txn): ' + txn);
          return { success: true, duplicate: true, message: 'Payment already recorded (transaction ID)' };
        }
        if (existingInv === inv && Math.abs(parseFloat(existing[i][amtCol] || 0) - parseFloat(amount)) < 0.01) {
          var existingDate = existing[i][0];
          var incoming = payDate instanceof Date ? payDate : new Date(payDate);
          if (existingDate instanceof Date && incoming instanceof Date &&
              Math.abs(incoming.getTime() - existingDate.getTime()) < 86400000) {
            Logger.log('⚠️ DUPLICATE PAYMENT (invoice+amount): ' + inv);
            return { success: true, duplicate: true, message: 'Payment already recorded' };
          }
        }
      }

      sheet.appendRow([
        payDate,
        inv,
        company,
        amount,
        method,
        txn,
        'Completed',
        emailVal,
        desc,
        feeVal,
        notesCol
      ]);
      Logger.log('Payment recorded (unified): Invoice ' + inv + ', $' + amount + ', txn ' + txn);
      try {
        syncSchedulingAppointmentPaidFromInvoice_(inv);
      } catch (syncApptErr) {
        Logger.log('syncSchedulingAppointmentPaidFromInvoice_: ' + syncApptErr.toString());
      }
      return { success: true };
    } finally {
      lock.releaseLock();
    }
  } catch (error) {
    Logger.log('recordPaymentHistoryUnified error: ' + error.toString());
    return { success: false, error: error.toString() };
  }
}

/**
 * Parse flexible boolean inputs from Sheets/API payloads.
 */
function parseBooleanFlagInvoice_(value, defaultValue) {
  if (value === undefined || value === null || value === '') return defaultValue;
  if (typeof value === 'boolean') return value;
  if (typeof value === 'number') return value !== 0;
  var normalized = String(value).trim().toLowerCase();
  if (['true', '1', 'yes', 'y', 'on'].indexOf(normalized) !== -1) return true;
  if (['false', '0', 'no', 'n', 'off'].indexOf(normalized) !== -1) return false;
  return defaultValue;
}

/**
 * PM_Project_Invoices milestone row → viewer payload: ONE line item (milestone amount) + Stripe-aligned fee — not full project contract.
 */
function buildPmMilestoneInvoiceViewerData_(invoiceIdStr, projectId, milestoneName, amountNum, status, stripeLink, dateSent, project, forceAddProcessingFee) {
  var projectData = project.project;
  var fullPaymentSchedule = Array.isArray(projectData.paymentSchedule)
    ? projectData.paymentSchedule
    : (typeof projectData.paymentSchedule === 'string'
      ? (function() {
          try { return JSON.parse(projectData.paymentSchedule || '[]'); } catch (e) { return []; }
        })()
      : []);
  var linkedProjectId = projectData.estimateId || projectData.invoiceId || projectData.linkedEstimateId || '';
  var applyProc =
    (typeof forceAddProcessingFee === 'boolean')
      ? forceAddProcessingFee
      : (typeof pmResolveApplyProcessingFeeForStripe_ === 'function'
          ? pmResolveApplyProcessingFeeForStripe_(projectData)
          : true);
  var milestoneBase = parseFloat(amountNum || 0);
  var procFee = 0;
  var totalDue = 0;
  var computedProjectTotal = parseFloat(projectData.totalValue || projectData.total || 0);

  var historyPaidTotal = 0;
  var historyMilestones = {};
  var historyPayments = [];
  try {
    if (typeof getMilestoneStatusFromHistory === 'function') {
      var hist = getMilestoneStatusFromHistory(projectId, linkedProjectId);
      if (hist && hist.success) {
        historyPaidTotal = parseFloat(hist.totalPaid || 0);
        historyMilestones = hist.milestones || {};
        historyPayments = hist.payments || [];
      }
    }
  } catch (histErr) {
    Logger.log('buildPmMilestoneInvoiceViewerData_ history: ' + histErr.toString());
  }

  var currentMilestone = fullPaymentSchedule.find(function(ms) {
    return String(ms.name || '')
      .trim()
      .toLowerCase() === String(milestoneName || '')
        .trim()
        .toLowerCase();
  }) || null;
  if (!currentMilestone) {
    // Fallback for legacy/stale milestone rows: if there's only one non-one-off milestone,
    // treat it as the current milestone so viewer amount stays in sync with edited project totals.
    var regularMilestones = fullPaymentSchedule.filter(function(ms) {
      return !(ms && (ms.type === 'one-off' || ms.isOneOff === true));
    });
    if (regularMilestones.length === 1) {
      currentMilestone = regularMilestones[0];
    }
  }

  // Prefer latest schedule amount over stale PM_Project_Invoices amount.
  if (currentMilestone) {
    var scheduleAmt = parseFloat(currentMilestone.amount != null ? currentMilestone.amount : currentMilestone.total || 0);
    if (!isNaN(scheduleAmt) && scheduleAmt > 0) {
      milestoneBase = scheduleAmt;
    }
  }
  procFee = applyProc ? Math.round((milestoneBase * 0.029 + 0.29) * 100) / 100 : 0;
  totalDue = milestoneBase + procFee;

  var nextMilestone = fullPaymentSchedule.find(function(ms) {
    if (ms.type === 'one-off') return false;
    var key = String(ms.id || '');
    return !(historyMilestones[key] && historyMilestones[key].paid === true);
  }) || null;

  var notesSchedule = fullPaymentSchedule
    .map(function(ms, idx) {
      var msAmount = parseFloat(ms.amount || ms.total || 0);
      var msKey = String(ms.id || '');
      var isPaid = historyMilestones[msKey] && historyMilestones[msKey].paid === true;
      var isCurrent = currentMilestone && String(currentMilestone.id || '') === msKey;
      var icon = isPaid ? '✅' : (isCurrent ? '👉' : '⏳');
      return (
        icon +
        ' ' +
        (ms.name || 'Milestone ' + (idx + 1)) +
        ': $' +
        msAmount.toFixed(2) +
        (isPaid ? ' (Paid)' : isCurrent ? ' (Due Now)' : '')
      );
    })
    .join('\n');

  var invoiceData = {
    id: invoiceIdStr,
    invoiceNumber: invoiceIdStr,
    type: 'Invoice',
    date: dateSent ? new Date(dateSent).toISOString() : new Date().toISOString(),
    customerName: projectData.customerName || '',
    customerEmail: projectData.customerEmail || '',
    customerPhone: projectData.customerPhone || '',
    customerAddress: projectData.customerAddress || '',
    items: JSON.stringify([
      {
        name: milestoneName,
        description: 'Milestone payment only — add-ons are billed separately. Project: ' + projectId,
        quantity: 1,
        price: milestoneBase,
        total: milestoneBase
      }
    ]),
    subtotal: milestoneBase,
    taxRate: 0,
    tax: 0,
    discount: 0,
    total: totalDue,
    notes:
      'Project ' +
      projectId +
      '\nContract reference total: $' +
      computedProjectTotal.toFixed(2) +
      '\nThis page is for one milestone payment: ' +
      milestoneName +
      ' — base $' +
      milestoneBase.toFixed(2) +
      (procFee > 0 ? ' + card processing $' + procFee.toFixed(2) : '') +
      '\nPaid to date (all project payments): $' +
      historyPaidTotal.toFixed(2) +
      '\nNext payment: ' +
      (nextMilestone ? nextMilestone.name || 'N/A' : 'Complete') +
      '\n\nPayment schedule:\n' +
      notesSchedule,
    // If processing fee is disabled, force viewer to create a fresh no-fee checkout
    // instead of reusing a possibly stale fee-on Stripe URL.
    paymentLink: applyProc ? stripeLink : '',
    shareLink: getCustomerViewerWebflowUrl('Invoice', invoiceIdStr, ''),
    status: status,
    paymentStatus: status === 'Paid' ? 'Paid' : status === 'Partial' ? 'Partial' : 'Pending',
    projectId: projectId,
    milestoneName: milestoneName,
    currentMilestoneName: milestoneName,
    currentMilestoneAmount: milestoneBase,
    nextMilestoneName: nextMilestone ? nextMilestone.name || '' : '',
    paymentSchedule: JSON.stringify(fullPaymentSchedule),
    addProcessingFee: !!applyProc,
    processingFee: procFee,
    isMilestoneInvoice: true,
    terms: projectData.terms || ''
  };

  var remainingBalance = status === 'Paid' ? 0 : totalDue;
  var isPaidInFull = status === 'Paid';

  invoiceData.paymentHistory = historyPayments;
  invoiceData.totalPaid = historyPaidTotal;
  invoiceData.remainingBalance = remainingBalance;

  if (isPaidInFull) {
    invoiceData.paymentStatus = 'Paid';
    invoiceData.status = 'Paid';
  }

  Logger.log(
    '💰 Milestone viewer payload ' +
      String(invoiceIdStr).trim() +
      ': milestone=$' +
      milestoneBase.toFixed(2) +
      ', fee=$' +
      procFee.toFixed(2) +
      ', due=$' +
      totalDue.toFixed(2) +
      ', contractRef=$' +
      computedProjectTotal.toFixed(2)
  );

  return { invoiceData: invoiceData, historyPaidTotal: historyPaidTotal, computedProjectTotal: computedProjectTotal };
}

/**
 * Get invoice/estimate by ID
 * @param {string} id
 * @param {string} oneOffTrackingIdOpt - When viewing linked doc, filter to this PM one-off line only
 */
function getInvoiceEstimate(id, oneOffTrackingIdOpt) {
  try {
    // Validate and normalize ID
    if (!id) {
      Logger.log('❌ No invoice ID provided');
      return { success: false, error: 'Invoice ID is required' };
    }
    
    const searchId = String(id).trim();
    Logger.log('🔍 getInvoiceEstimate called with ID: "' + searchId + '" (length: ' + searchId.length + ')');
    
    const spreadsheet = SpreadsheetApp.openById(SPREADSHEET_ID);
    
    // First, check if this is a milestone invoice in PM_Project_Invoices sheet.
    // Performance guard: for regular invoice/estimate IDs, skip scanning the milestone sheet.
    const looksLikeProjectId = /^PROJ-/i.test(searchId);
    const looksLikeMilestoneInvoiceId = /^INV-?PROJ-/i.test(searchId) || searchId.toUpperCase().indexOf('PROJ-') !== -1;
    const shouldScanMilestoneSheet = looksLikeProjectId || looksLikeMilestoneInvoiceId;
    const milestoneInvoiceSheet = shouldScanMilestoneSheet ? spreadsheet.getSheetByName(PM_PROJECT_INVOICES_SHEET) : null;
    if (milestoneInvoiceSheet) {
      Logger.log('🔍 Checking milestone invoices sheet for ID: ' + searchId);
      const milestoneData = milestoneInvoiceSheet.getDataRange().getValues();
      Logger.log('📊 Found ' + (milestoneData.length - 1) + ' milestone invoices');

      // Robust PM_Projects fallback reader (handles with/without Company ID and header drift)
      const getProjectFromPmSheetFallback_ = function(targetProjectId) {
        try {
          const pmProjectsSheetName = (typeof PM_PROJECTS_SHEET !== 'undefined' && PM_PROJECTS_SHEET)
            ? PM_PROJECTS_SHEET
            : 'PM_Projects';
          const projectsSheet = spreadsheet.getSheetByName(pmProjectsSheetName);
          if (!projectsSheet) return null;

          const rows = projectsSheet.getDataRange().getValues() || [];
          if (rows.length < 2) return null;

          const headers = (rows[0] || []).map(function(h) { return String(h || '').trim(); });
          const hasCompanyId = String(headers[0] || '').toLowerCase() === 'company id';

          const findHeader = function(names) {
            const list = Array.isArray(names) ? names : [names];
            for (let n = 0; n < list.length; n++) {
              const want = String(list[n] || '').trim().toLowerCase();
              for (let c = 0; c < headers.length; c++) {
                if (String(headers[c] || '').trim().toLowerCase() === want) return c;
              }
            }
            return -1;
          };

          let projectIdCol = findHeader(['Project ID', 'ProjectId']);
          if (projectIdCol === -1) projectIdCol = hasCompanyId ? 1 : 0;

          let json1Col = findHeader('Project JSON Part 1');
          let json2Col = findHeader('Project JSON Part 2');
          let json3Col = findHeader('Project JSON Part 3');
          if (json1Col === -1 || json2Col === -1 || json3Col === -1) {
            json1Col = hasCompanyId ? 3 : 2;
            json2Col = json1Col + 1;
            json3Col = json1Col + 2;
          }

          const target = String(targetProjectId || '').trim();
          for (let j = 1; j < rows.length; j++) {
            if (String(rows[j][projectIdCol] || '').trim() !== target) continue;
            const jsonPart1 = rows[j][json1Col] || '';
            const jsonPart2 = rows[j][json2Col] || '';
            const jsonPart3 = rows[j][json3Col] || '';
            let jsonStr = concatenateJsonChunks(jsonPart1, jsonPart2, jsonPart3);
            if (!jsonStr || !String(jsonStr).trim()) jsonStr = String(jsonPart1 || '').trim();
            if (!jsonStr || String(jsonStr).trim().charAt(0) !== '{') return null;
            const projectDataObj = JSON.parse(jsonStr);
            return { success: true, project: projectDataObj };
          }
        } catch (fallbackErr) {
          Logger.log('⚠️ getProjectFromPmSheetFallback_ error: ' + fallbackErr.toString());
        }
        return null;
      };
      
      // Log first few invoice IDs for debugging
      if (milestoneData.length > 1) {
        Logger.log('📋 Sample invoice IDs in sheet:');
        for (let k = 1; k < Math.min(4, milestoneData.length); k++) {
          const sampleId = String(milestoneData[k][0] || '').trim();
          Logger.log('  - Row ' + (k + 1) + ': "' + sampleId + '" (length: ' + sampleId.length + ')');
        }
      }
      
      for (let i = 1; i < milestoneData.length; i++) {
        const invoiceIdFromSheet = String(milestoneData[i][0] || '').trim();
        
        // Try exact match first
        if (invoiceIdFromSheet === searchId) {
          Logger.log('✅ Exact match found at row ' + (i + 1) + ': "' + invoiceIdFromSheet + '" === "' + searchId + '"');
          Logger.log('✅ Found matching milestone invoice at row ' + (i + 1));
          var oneOffEarlyExact = buildOneOffPMInvoiceIfApplicable(milestoneData, i, searchId);
          if (oneOffEarlyExact) return oneOffEarlyExact;
          // Found milestone invoice - format it for the viewer
          const projectId = milestoneData[i][1];
          const milestoneName = milestoneData[i][2];
          const amount = parseFloat(milestoneData[i][3] || 0);
          const status = milestoneData[i][4] || 'Pending';
          const stripeLink = milestoneData[i][5] || '';
          const dateSent = milestoneData[i][6];
          const feeFlagExact = parseBooleanFlagInvoice_((milestoneData[i].length >= 8) ? milestoneData[i][7] : '', false);
          
          // Get project data to fill in customer info
          Logger.log('🔍 Looking up project: ' + projectId);
          let project;
          try {
            // Try to use getProject from ProjectManagement.gs first
            project = getProject(projectId);
          } catch (e) {
            Logger.log('⚠️ Error calling getProject: ' + e.toString());
          }
          if (!project || !project.success) {
            // Fallback: try to get project directly from PM_Projects sheet
            try {
              project = getProjectFromPmSheetFallback_(projectId);
            } catch (e2) {
              Logger.log('❌ Error getting project from sheet: ' + e2.toString());
            }
          }
          
          if (!project || !project.success) {
            Logger.log('⚠️ Project not found for milestone invoice; serving minimal invoice payload from PM_Project_Invoices. projectId=' + projectId);
            var baseExact = parseFloat(amount || 0);
            var feeExact = feeFlagExact ? Math.round((baseExact * 0.029 + 0.29) * 100) / 100 : 0;
            var minimalExact = {
              id: String(id).trim(),
              invoiceNumber: String(id).trim(),
              type: 'Invoice',
              date: dateSent ? new Date(dateSent).toISOString() : new Date().toISOString(),
              customerName: '',
              customerEmail: '',
              customerPhone: '',
              customerAddress: '',
              items: JSON.stringify([
                {
                  name: milestoneName || 'Milestone Payment',
                  description: 'Milestone payment. Project: ' + String(projectId || ''),
                  quantity: 1,
                  price: baseExact,
                  total: baseExact
                }
              ]),
              subtotal: baseExact,
              taxRate: 0,
              tax: 0,
              discount: 0,
              total: baseExact + feeExact,
              // If fee is disabled, don't reuse an old milestone Stripe URL that may include fee.
              paymentLink: feeFlagExact ? (stripeLink || '') : '',
              shareLink: getCustomerViewerWebflowUrl('Invoice', String(id).trim(), ''),
              status: status || 'Pending',
              paymentStatus: status === 'Paid' ? 'Paid' : status === 'Partial' ? 'Partial' : 'Pending',
              projectId: projectId,
              milestoneName: milestoneName || '',
              currentMilestoneName: milestoneName || '',
              currentMilestoneAmount: baseExact,
              nextMilestoneName: '',
              paymentSchedule: '[]',
              addProcessingFee: feeFlagExact,
              processingFee: feeExact,
              isMilestoneInvoice: true,
              terms: ''
            };
            return { success: true, data: minimalExact };
          }

          var builtExact = buildPmMilestoneInvoiceViewerData_(
            String(id).trim(),
            projectId,
            milestoneName,
            amount,
            status,
            stripeLink,
            dateSent,
            project,
            feeFlagExact
          );
          Logger.log('✅ Found milestone invoice: ' + searchId);
          return { success: true, data: builtExact.invoiceData };
        }
        
        // Try case-insensitive match as fallback
        if (invoiceIdFromSheet.toLowerCase() === searchId.toLowerCase()) {
          Logger.log('✅ Case-insensitive match found at row ' + (i + 1));
          // Use the exact ID from sheet for consistency
          const actualId = invoiceIdFromSheet;
          var oneOffEarlyCi = buildOneOffPMInvoiceIfApplicable(milestoneData, i, actualId);
          if (oneOffEarlyCi) return oneOffEarlyCi;
          
          // Get invoice data (same as above)
          const projectId = milestoneData[i][1];
          const milestoneName = milestoneData[i][2];
          const amount = parseFloat(milestoneData[i][3] || 0);
          const status = milestoneData[i][4] || 'Pending';
          const stripeLink = milestoneData[i][5] || '';
          const dateSent = milestoneData[i][6];
          const feeFlagCi = parseBooleanFlagInvoice_((milestoneData[i].length >= 8) ? milestoneData[i][7] : '', false);
          
          // Get project data
          Logger.log('🔍 Looking up project: ' + projectId);
          let project;
          try {
            project = getProject(projectId);
          } catch (e) {
            Logger.log('⚠️ Error calling getProject (CI match): ' + e.toString());
          }
          if (!project || !project.success) {
            try {
              project = getProjectFromPmSheetFallback_(projectId);
            } catch (e2) {
              Logger.log('❌ Error getting project from sheet (CI match): ' + e2.toString());
            }
          }
          
          if (!project || !project.success) {
            Logger.log('⚠️ Project not found (CI match) for milestone invoice; serving minimal invoice payload from PM_Project_Invoices. projectId=' + projectId);
            var baseCi = parseFloat(amount || 0);
            var feeCi = feeFlagCi ? Math.round((baseCi * 0.029 + 0.29) * 100) / 100 : 0;
            var minimalCi = {
              id: String(actualId).trim(),
              invoiceNumber: String(actualId).trim(),
              type: 'Invoice',
              date: dateSent ? new Date(dateSent).toISOString() : new Date().toISOString(),
              customerName: '',
              customerEmail: '',
              customerPhone: '',
              customerAddress: '',
              items: JSON.stringify([
                {
                  name: milestoneName || 'Milestone Payment',
                  description: 'Milestone payment. Project: ' + String(projectId || ''),
                  quantity: 1,
                  price: baseCi,
                  total: baseCi
                }
              ]),
              subtotal: baseCi,
              taxRate: 0,
              tax: 0,
              discount: 0,
              total: baseCi + feeCi,
              // If fee is disabled, don't reuse an old milestone Stripe URL that may include fee.
              paymentLink: feeFlagCi ? (stripeLink || '') : '',
              shareLink: getCustomerViewerWebflowUrl('Invoice', String(actualId).trim(), ''),
              status: status || 'Pending',
              paymentStatus: status === 'Paid' ? 'Paid' : status === 'Partial' ? 'Partial' : 'Pending',
              projectId: projectId,
              milestoneName: milestoneName || '',
              currentMilestoneName: milestoneName || '',
              currentMilestoneAmount: baseCi,
              nextMilestoneName: '',
              paymentSchedule: '[]',
              addProcessingFee: feeFlagCi,
              processingFee: feeCi,
              isMilestoneInvoice: true,
              terms: ''
            };
            return { success: true, data: minimalCi };
          }

          var builtCi = buildPmMilestoneInvoiceViewerData_(
            String(actualId).trim(),
            projectId,
            milestoneName,
            amount,
            status,
            stripeLink,
            dateSent,
            project,
            feeFlagCi
          );
          Logger.log('✅ Found milestone invoice (case-insensitive): ' + actualId);
          return { success: true, data: builtCi.invoiceData };
        }
      }
      
      Logger.log('❌ No matching milestone invoice found after checking ' + (milestoneData.length - 1) + ' rows');
    } else if (shouldScanMilestoneSheet) {
      Logger.log('⚠️ PM_Project_Invoices sheet not found');
    } else {
      Logger.log('⏭️ Skipping milestone sheet scan for non-milestone ID: ' + searchId);
    }

    // Fallback: if viewer is called with a Project ID, resolve linked invoice/estimate ID from PM_Projects,
    // then cross-reference invoices/estimates (and latest milestone invoice as backup).
    try {
      if (looksLikeProjectId) {
        Logger.log('🔁 Project-ID fallback lookup for: ' + searchId);
        var resolvedLinkedId = '';

        var projectSheetName = (typeof PM_PROJECTS_SHEET !== 'undefined' && PM_PROJECTS_SHEET)
          ? PM_PROJECTS_SHEET
          : 'PM_Projects';
        var projectsSheet = spreadsheet.getSheetByName(projectSheetName);
        if (projectsSheet) {
          var pRows = projectsSheet.getDataRange().getValues() || [];
          var pHeaders = (pRows[0] || []).map(function(h) { return String(h || '').trim(); });
          var hasCompanyIdPm = String(pHeaders[0] || '').toLowerCase() === 'company id';
          var findPmCol = function(names) {
            var list = Array.isArray(names) ? names : [names];
            for (var n = 0; n < list.length; n++) {
              var want = String(list[n] || '').trim().toLowerCase();
              for (var c = 0; c < pHeaders.length; c++) {
                if (String(pHeaders[c] || '').trim().toLowerCase() === want) return c;
              }
            }
            return -1;
          };
          var projectIdColPm = findPmCol(['Project ID', 'ProjectId']);
          if (projectIdColPm === -1) projectIdColPm = hasCompanyIdPm ? 1 : 0;
          var invoiceIdColPm = findPmCol(['Invoice ID', 'Linked Invoice ID', 'Estimate ID']);
          if (invoiceIdColPm === -1) invoiceIdColPm = hasCompanyIdPm ? 2 : 1;
          var json1ColPm = findPmCol('Project JSON Part 1');
          if (json1ColPm === -1) json1ColPm = hasCompanyIdPm ? 3 : 2;
          var json2ColPm = json1ColPm + 1;
          var json3ColPm = json1ColPm + 2;
          for (var pr = 1; pr < pRows.length; pr++) {
            var pid = String(pRows[pr][projectIdColPm] || '').trim();
            if (pid !== searchId) continue;

            // Primary mapping: PM_Projects column B = Invoice ID.
            // Cross-reference that directly against Invoices & Estimates column B.
            var directInvoiceId = String(pRows[pr][invoiceIdColPm] || '').trim();
            if (directInvoiceId && directInvoiceId !== searchId) {
              resolvedLinkedId = directInvoiceId;
              Logger.log('✅ Resolved linked invoice from PM_Projects column B: ' + resolvedLinkedId);
            }

            var pJson = concatenateJsonChunks(pRows[pr][json1ColPm] || '', pRows[pr][json2ColPm] || '', pRows[pr][json3ColPm] || '');
            if (!pJson || !String(pJson).trim()) pJson = String(pRows[pr][json1ColPm] || '').trim();
            if (!resolvedLinkedId && pJson && String(pJson).trim().charAt(0) === '{') {
              var pData = JSON.parse(pJson);
              var candidates = [
                pData.invoiceId,
                pData.estimateId,
                pData.linkedEstimateId,
                pData.linkedInvoiceId,
                pData.originalEstimateId,
                pData.sourceInvoiceId
              ]
                .map(function(v) { return String(v || '').trim(); })
                .filter(function(v) { return v && v !== searchId && !/^PROJ-/i.test(v); });

              if (candidates.length > 0) {
                resolvedLinkedId = candidates[0];
                Logger.log('✅ Resolved linked doc from project row: ' + resolvedLinkedId);
              }
            }
            break;
          }
        }

        // Backup: find most recent milestone invoice belonging to this project
        if (!resolvedLinkedId && milestoneInvoiceSheet) {
          var mRows = milestoneInvoiceSheet.getDataRange().getValues() || [];
          for (var mr = mRows.length - 1; mr >= 1; mr--) {
            var rowProjectId = String(mRows[mr][1] || '').trim();
            if (rowProjectId === searchId) {
              var latestInvId = String(mRows[mr][0] || '').trim();
              if (latestInvId) {
                resolvedLinkedId = latestInvId;
                Logger.log('✅ Resolved latest milestone invoice from project: ' + resolvedLinkedId);
              }
              break;
            }
          }
        }

        if (resolvedLinkedId) {
          Logger.log('↪️ Re-routing getInvoiceEstimate from project ID ' + searchId + ' to linked ID ' + resolvedLinkedId);
          return getInvoiceEstimate(resolvedLinkedId, oneOffTrackingIdOpt);
        }
      }
    } catch (projectFallbackErr) {
      Logger.log('⚠️ Project-ID fallback lookup error: ' + projectFallbackErr.toString());
    }
    
    // If not found in milestone invoices, check regular invoices/estimates sheet
    const sheet = spreadsheet.getSheetByName(INVOICES_ESTIMATES_SHEET);
    
    if (!sheet) {
      return { success: false, error: 'Sheet not found' };
    }
    enforce8ColumnStructure(sheet);
    ensureInvoicesEstimatesNineColumns(sheet);
    
    const lastRow = sheet.getLastRow();
    if (lastRow < 2) {
      return { success: false, error: 'Invoice/Estimate not found' };
    }
    
    // Find by ID (Column 2) and read from JSON (Columns 4-6)
    // Column structure: 1=Company ID, 2=ID, 3=Customer Email, 4-6=JSON Parts, 7=Total, 8=Payment Schedule
    Logger.log('🔍 Checking regular invoices/estimates sheet for ID: ' + searchId);
    const rowValues = sheet.getRange(2, 2, lastRow - 1, 7).getValues();
    // rowValues columns map: 0=ID(col2), 1=CustomerEmail(col3), 2=JSON1(col4), 3=JSON2(col5), 4=JSON3(col6), 5=Total(col7), 6=PaymentSchedule(col8)
    for (let i = 0; i < rowValues.length; i++) {
      const rowNum = i + 2;
      const row = rowValues[i] || [];
      const invoiceId = String(row[0] || '').trim();
      if (invoiceId === searchId) {
        Logger.log('✅ Found matching invoice/estimate at row ' + rowNum);
        try {
          const jsonPart1 = row[2] || '';
          const jsonPart2 = row[3] || '';
          const jsonPart3 = row[4] || '';
          let jsonStr = concatenateJsonChunks(jsonPart1, jsonPart2, jsonPart3);
          if (!jsonStr || jsonStr.length === 0) {
            jsonStr = String(jsonPart1 || '').trim();
          }
          if (jsonStr && jsonStr.startsWith('{')) {
            const jsonData = JSON.parse(jsonStr);
            
            // Read payment schedule from Column H (column 8)
            const paymentScheduleCol = row[6] || '';
            if (paymentScheduleCol && String(paymentScheduleCol).trim().length > 0) {
              try {
                Logger.log('💰 Payment Schedule found in Column H: ' + String(paymentScheduleCol).substring(0, 100) + '...');
                jsonData.paymentSchedule = JSON.parse(String(paymentScheduleCol));
                Logger.log('✅ Payment Schedule parsed successfully: ' + jsonData.paymentSchedule.length + ' milestones');
              } catch (parseError) {
                Logger.log('⚠️ Error parsing payment schedule JSON: ' + parseError.toString());
                jsonData.paymentSchedule = null;
              }
            } else {
              Logger.log('⚠️ No payment schedule in Column H');
              jsonData.paymentSchedule = null;
            }

            // Mirror PM project line items (one-off add-ons) into this document for the public viewer
            mergeLinkedProjectItemsIntoInvoiceData(jsonData, String(invoiceId).trim());
            applyLinkedProjectInvoiceType(jsonData, String(invoiceId).trim());
            // One-offs stored in column 9 (canonical) — applied after project merge so sheet wins
            mergeInvoiceSheetColumn9OneOffsIntoJsonData(sheet, rowNum, jsonData);
            
            // Get payment history from Payment History sheet
            // Use the exact invoice ID from the sheet (not the search ID) to ensure consistency
            const invoiceIdForPayments = String(invoiceId).trim();
            Logger.log('🔍 getInvoiceEstimate: Getting payment history for invoice ID: "' + invoiceIdForPayments + '"');
            let payments = getPaymentsForInvoice(invoiceIdForPayments);

            // If this invoice/estimate is linked to a PM project, merge project-level payment history too.
            // This keeps public viewer totals aligned with the Project tab history.
            try {
              if (typeof getProjectPaymentHistory === 'function') {
                let linkedProjectId = String(jsonData.projectId || '').trim();
                if (!linkedProjectId && typeof getProjectByLinkedInvoiceId === 'function') {
                  const linked = getProjectByLinkedInvoiceId(invoiceIdForPayments);
                  if (linked && linked.success) {
                    linkedProjectId = String(linked.projectId || (linked.project && linked.project.projectId) || '').trim();
                  }
                }

                if (linkedProjectId) {
                  const projectHist = getProjectPaymentHistory(linkedProjectId, invoiceIdForPayments);
                  if (projectHist && projectHist.success && Array.isArray(projectHist.payments) && projectHist.payments.length > 0) {
                    const merged = [];
                    const seen = {};
                    const keyFor = function(p) {
                      const tx = String((p && p.transactionId) || '').trim();
                      if (tx) return 'tx:' + tx;
                      const inv = String((p && p.invoiceId) || '').trim();
                      const amt = (parseFloat((p && p.amount) || 0) || 0).toFixed(2);
                      const dt = String((p && p.date) || '').trim();
                      const m = String((p && p.method) || '').trim();
                      return 'f:' + inv + '|' + amt + '|' + dt + '|' + m;
                    };

                    payments.concat(projectHist.payments).forEach(function(p) {
                      const k = keyFor(p);
                      if (seen[k]) return;
                      seen[k] = true;
                      merged.push(p);
                    });

                    payments = merged;
                    Logger.log('🔗 getInvoiceEstimate: merged project payment history for ' + invoiceIdForPayments + ' via project ' + linkedProjectId + ' (total rows=' + payments.length + ')');
                  }
                }
              }
            } catch (payMergeErr) {
              Logger.log('⚠️ getInvoiceEstimate payment merge warning: ' + payMergeErr.toString());
            }

            const invoiceTotal = parseFloat(jsonData.total || 0);
            const totalPaid = payments.reduce((sum, p) => sum + parseFloat(p.amount || 0), 0);
            const remainingBalance = invoiceTotal - totalPaid;
            const isPaidInFull = remainingBalance <= 0.01 && totalPaid > 0;
            
            Logger.log('💰 Payment summary for invoice ' + invoiceIdForPayments + ': Total=$' + invoiceTotal.toFixed(2) + ', Paid=$' + totalPaid.toFixed(2) + ', Balance=$' + remainingBalance.toFixed(2) + ', Payments found=' + payments.length);
            
            // Add payment history to response
            jsonData.paymentHistory = payments;
            jsonData.totalPaid = totalPaid;
            jsonData.remainingBalance = remainingBalance;
            
            // Update status if fully paid
            if (isPaidInFull && jsonData.type === 'Invoice') {
              jsonData.paymentStatus = 'Paid';
              jsonData.status = 'Paid';
            } else if (totalPaid > 0 && jsonData.type === 'Invoice') {
              jsonData.paymentStatus = 'Partial';
              jsonData.status = 'Partial';
            }
            
            if (oneOffTrackingIdOpt && String(oneOffTrackingIdOpt).trim()) {
              applyOneOffTrackingFilterToInvoiceData(jsonData, String(oneOffTrackingIdOpt).trim());
            }
            
        return {
          success: true,
              data: jsonData
            };
          }
        } catch (e) {
          Logger.log('Error parsing JSON at row ' + rowNum + ': ' + e.toString());
        }
      }
    }
    
    Logger.log('❌ Invoice/Estimate not found with ID: "' + searchId + '"');
    Logger.log('💡 Searched in: ' + INVOICES_ESTIMATES_SHEET + ' and ' + PM_PROJECT_INVOICES_SHEET);
    Logger.log('💡 ID type: ' + typeof searchId + ', length: ' + searchId.length);
    
    // Additional debugging: check if ID might be a project ID instead
    if (searchId.startsWith('PROJ-')) {
      Logger.log('⚠️ Warning: ID starts with PROJ- - this might be a project ID, not an invoice ID');
      Logger.log('💡 Milestone invoices should start with INV-PROJ-');
    }
    
    return { success: false, error: 'Invoice/Estimate not found with ID: ' + searchId };
  } catch (error) {
    Logger.log('❌ Error getting invoice/estimate: ' + error.toString());
    Logger.log('Error stack: ' + (error.stack || 'No stack trace'));
    return { success: false, error: error.toString() };
  }
}

/**
 * Get all quotes/estimates with status for dashboard (filtered by company if email provided)
 */
function getAllQuotesWithStatus(email) {
  try {
    const spreadsheet = SpreadsheetApp.openById(SPREADSHEET_ID);
    const sheet = spreadsheet.getSheetByName(INVOICES_ESTIMATES_SHEET);
    
    if (!sheet) {
      return { success: true, quotes: [] };
    }
    
    // Get company info for filtering
    let companyId = null;
    let isAdmin = false;
    if (email) {
      const companyResult = getCompanyIdForUser(email);
      if (companyResult.success) {
        companyId = companyResult.companyId;
        isAdmin = companyResult.isAdmin || false;
      }
    }
    
    // Read data - sheet structure: Company ID (col 1), ID (col 2), Customer Email (col 3), JSON Parts (cols 4-6), Total (col 7), Payment Schedule (col 8)
    const lastRow = sheet.getLastRow();
    if (lastRow < 2) {
      return { success: true, quotes: [] };
    }
    
    // Read all 8 columns
    const dataRows = sheet.getRange(2, 1, lastRow - 1, 8).getValues();
    const quotes = [];
    
    // Process each row
    for (let i = 0; i < dataRows.length; i++) {
      const row = dataRows[i];
      const rowCompanyId = String(row[0] || '').trim(); // Column 1: Company ID
      const id = String(row[1] || '').trim(); // Column 2: ID
      
      if (!id) continue;
      
      // Filter by Company ID if provided (and user is not admin)
      if (companyId && !isAdmin) {
        if (rowCompanyId !== companyId) {
          continue; // Skip quotes from other companies
        }
      }
      
      // Read JSON from columns 4, 5, 6
      const jsonChunks = [
        String(row[3] || '').trim(), // JSON Part 1 (column 4, index 3)
        String(row[4] || '').trim(), // JSON Part 2 (column 5, index 4)
        String(row[5] || '').trim()  // JSON Part 3 (column 6, index 5)
      ];
      const fullJson = concatenateJsonChunks(jsonChunks[0], jsonChunks[1], jsonChunks[2]);
      
      if (!fullJson || !fullJson.startsWith('{')) {
        // Skip rows without valid JSON
        continue;
      }
      
      try {
        const jsonData = JSON.parse(fullJson);
        
        // Filter by Company ID if provided (and user is not admin)
        if (companyId && !isAdmin) {
          const invoiceCompanyId = jsonData.companyId || '';
          if (invoiceCompanyId !== companyId) {
            continue; // Skip invoices from other companies
          }
        }
        
        const type = jsonData.type || 'Estimate';
        const status = jsonData.approvalStatus || jsonData.status || 'Draft';
        const customerName = jsonData.customerName || '';
        const customerEmail = jsonData.customerEmail || '';
        const date = jsonData.date || '';
        const total = parseFloat(jsonData.total || row[5] || 0); // Use JSON total or column 6
        const invoiceNumber = jsonData.invoiceNumber || '';
        const quoteNumber = jsonData.quoteNumber || '';
        const shareLink = jsonData.shareLink || '';
        
        quotes.push({
          id: id,
          type: type,
          status: status || 'Draft',
          customerName: customerName || 'Unknown',
          customerEmail: customerEmail || '',
          date: date ? (date instanceof Date ? date.toISOString().split('T')[0] : date.toString()) : '',
          totalAmount: total,
          invoiceNumber: invoiceNumber || '',
          quoteNumber: quoteNumber || '',
          shareLink: shareLink || ''
        });
      } catch (parseError) {
        Logger.log('Error parsing JSON for quote ' + id + ': ' + parseError.toString());
        // Skip this row if JSON is invalid
        continue;
      }
    }
    
    // Sort by date descending (most recent first)
    quotes.sort((a, b) => {
      const dateA = a.date ? new Date(a.date) : new Date(0);
      const dateB = b.date ? new Date(b.date) : new Date(0);
      return dateB - dateA;
    });
    
    Logger.log('Found ' + quotes.length + ' quotes (filtered by company: ' + (companyId || 'none') + ')');
    return { success: true, quotes: quotes };
  } catch (error) {
    Logger.log('Error getting all quotes with status: ' + error.toString());
    return { success: false, error: error.toString(), quotes: [] };
  }
}

/**
 * Get pending actions (signatures needed and invoices ready to send)
 */
function getPendingActionsEstimatesOnly() {
  try {
    const spreadsheet = SpreadsheetApp.openById(SPREADSHEET_ID);
    const sheet = spreadsheet.getSheetByName(INVOICES_ESTIMATES_SHEET);
    
    if (!sheet) {
      return { 
        success: true, 
        pendingSignatures: [], 
        pendingInvoices: [] 
      };
    }
    
    enforce8ColumnStructure(sheet);
    const lastRow = sheet.getLastRow();
    if (lastRow < 2) {
      return { 
        success: true, 
        pendingSignatures: [], 
        pendingInvoices: [] 
      };
    }
    
    const sheetCols = sheet.getLastColumn();
    const is8Column = (sheetCols >= 8);
    const idCol = is8Column ? 2 : 1;
    const json1Col = is8Column ? 4 : 3;
    const json2Col = is8Column ? 5 : 4;
    const json3Col = is8Column ? 6 : 5;
    
    const dataRows = sheet.getRange(2, 1, lastRow - 1, sheetCols).getValues();
    const pendingSignatures = [];
    const pendingInvoices = [];
    
    for (let i = 0; i < dataRows.length; i++) {
      const row = dataRows[i];
      const id = String(row[idCol - 1] || '').trim();
      
      if (!id) continue;
      
      // Read JSON
      const jsonPart1 = row[json1Col - 1] || '';
      const jsonPart2 = row[json2Col - 1] || '';
      const jsonPart3 = row[json3Col - 1] || '';
      let jsonStr = concatenateJsonChunks(jsonPart1, jsonPart2, jsonPart3);
      
      if (!jsonStr || jsonStr.length === 0) {
        jsonStr = String(jsonPart1 || '').trim();
      }
      
      if (!jsonStr || !jsonStr.startsWith('{')) continue;
      
      try {
        const jsonData = JSON.parse(jsonStr);
        const type = jsonData.type || '';
        const status = jsonData.status || '';
        const approvalStatus = jsonData.approvalStatus || '';
        const paymentStatus = jsonData.paymentStatus || '';
        
        // Pending Signatures: Estimates approved by customer and NOT countersigned by admin yet
        // Accept multiple admin-sign indicators for backward compatibility across older rows.
        const hasAdminSigned = (
          jsonData.adminSigned === true ||
          jsonData.adminSigned === 'true' ||
          !!jsonData.adminSignatureData ||
          !!jsonData.adminSignature ||
          !!jsonData.adminSignedDate ||
          !!jsonData.contractPdfUrl ||
          jsonData.contractFullyExecuted === true
        );
        if (type === 'Estimate' && approvalStatus === 'Approved' && !hasAdminSigned) {
          pendingSignatures.push({
            id: id,
            customerName: jsonData.customerName || '',
            customerEmail: jsonData.customerEmail || '',
            total: parseFloat(jsonData.total) || 0,
            approvalDate: jsonData.approvalDate || null,
            date: jsonData.date || null,
            source: 'estimate'
          });
        }
        
        // Pending Invoices: Invoices that are Draft or Pending (ready to send)
        if (type === 'Invoice' && (status === 'Draft' || status === 'Pending' || paymentStatus === 'Pending')) {
          pendingInvoices.push({
            id: id,
            invoiceNumber: jsonData.invoiceNumber || id,
            customerName: jsonData.customerName || '',
            customerEmail: jsonData.customerEmail || '',
            total: parseFloat(jsonData.total) || 0,
            status: status,
            paymentStatus: paymentStatus,
            date: jsonData.date || null
          });
        }
      } catch (e) {
        Logger.log('Error parsing JSON for row ' + (i + 2) + ': ' + e.toString());
        continue;
      }
    }
    
    return {
      success: true,
      pendingSignatures: pendingSignatures,
      pendingInvoices: pendingInvoices
    };
  } catch (error) {
    Logger.log('Error in getPendingActions: ' + error.toString());
    return {
      success: false,
      error: error.toString(),
      pendingSignatures: [],
      pendingInvoices: []
    };
  }
}

/**
 * True when company side has completed signing / contract (same signals as pending-actions).
 */
function estimateAdminFullyExecuted_(jsonData) {
  if (!jsonData || typeof jsonData !== 'object') return false;
  return (
    jsonData.adminSigned === true ||
    jsonData.adminSigned === 'true' ||
    !!jsonData.adminSignatureData ||
    !!jsonData.adminSignature ||
    !!jsonData.adminSignedDate ||
    !!jsonData.contractPdfUrl ||
    jsonData.contractFullyExecuted === true ||
    jsonData.contractFullyExecuted === 'true'
  );
}

function isInvoiceLikeType_(t) {
  var s = String(t || '').toLowerCase();
  return s === 'invoice' || s === 'snow removal';
}

/**
 * Tab display status: Estimates use "Signed" only after admin execution; "Approved" = customer only.
 * Invoices are not labeled Signed from approvalStatus alone.
 */
function deriveInvoicesTabDisplayStatus_(jsonData) {
  var type = jsonData.type || 'Estimate';
  var approvalStatus = String(jsonData.approvalStatus || '');
  var docStatus = String(jsonData.status || 'Draft');
  var paymentStatus = String(jsonData.paymentStatus || '');
  var lowerApproval = approvalStatus.toLowerCase();
  var lowerDoc = docStatus.toLowerCase();

  if (lowerApproval === 'declined' || lowerApproval === 'rejected' || lowerApproval === 'denied') {
    return 'Declined';
  }

  if (isInvoiceLikeType_(type)) {
    if (paymentStatus.toLowerCase() === 'paid') return 'Paid';
    if (paymentStatus.toLowerCase() === 'partial') return 'Partial';
    if (lowerDoc === 'sent') return 'Sent';
    if (lowerDoc === 'pending') return 'Pending';
    if (lowerDoc === 'draft') return 'Draft';
    if (jsonData.signatureData || jsonData.signatureUrl) return 'Signed';
    return docStatus || 'Draft';
  }

  // Estimate: "Signed" only after company execution; customer-only = Approved
  if (lowerApproval === 'pending' || !String(approvalStatus || '').trim()) {
    if (lowerDoc === 'sent') return 'Sent';
  }
  if (
    lowerApproval === 'approved' ||
    lowerApproval === 'signed' ||
    lowerApproval === 'approved & signed' ||
    lowerApproval === 'approved and signed'
  ) {
    return estimateAdminFullyExecuted_(jsonData) ? 'Signed' : 'Approved';
  }
  if (lowerDoc === 'sent') return 'Sent';
  if (lowerDoc === 'draft') return 'Draft';
  return docStatus || 'Draft';
}

/**
 * Get projectId for an invoice ID by looking in PM_projects sheet column B
 * @param {string} invoiceId - The invoice/estimate ID
 * @returns {string} - The projectId if found, empty string otherwise
 */
function getProjectIdForInvoice(invoiceId) {
  if (!invoiceId || String(invoiceId).trim() === '') return '';
  
  try {
    const spreadsheet = SpreadsheetApp.openById(SPREADSHEET_ID);
    const projectsSheet = spreadsheet.getSheetByName(PM_PROJECTS_SHEET);
    
    if (!projectsSheet) return '';
    
    const lastRow = projectsSheet.getLastRow();
    if (lastRow < 2) return '';
    
    // Get all data from PM_projects (columns A and B)
    const data = projectsSheet.getRange(2, 1, lastRow - 1, 2).getValues();
    const invoiceIdStr = String(invoiceId).trim();
    
    for (let i = 0; i < data.length; i++) {
      const projectId = String(data[i][0] || '').trim(); // Column A
      const invId = String(data[i][1] || '').trim(); // Column B
      
      if (invId === invoiceIdStr && projectId) {
        return projectId;
      }
    }
    
    return '';
  } catch (e) {
    Logger.log('Error getting projectId for invoice: ' + e.toString());
    return '';
  }
}

/**
 * TEST SCRIPT: Link all invoices to their projects
 * Run this once to populate column 9 (Project ID) in invoices sheet
 */
function testLinkInvoicesToProjects() {
  try {
    const spreadsheet = SpreadsheetApp.openById(SPREADSHEET_ID);
    const invoicesSheet = spreadsheet.getSheetByName(INVOICES_ESTIMATES_SHEET);
    
    if (!invoicesSheet) {
      Logger.log('❌ Invoices sheet not found');
      return;
    }
    
    // Ensure 9 columns exist
    enforce8ColumnStructure(invoicesSheet);
    
    const lastRow = invoicesSheet.getLastRow();
    let updated = 0;
    let alreadyLinked = 0;
    
    Logger.log('🔍 Scanning ' + (lastRow - 1) + ' invoices...');
    
    for (let i = 2; i <= lastRow; i++) {
      const invId = String(invoicesSheet.getRange(i, 2).getValue() || '').trim(); // Column B = ID
      if (!invId) continue;
      
      const currentProjectId = String(invoicesSheet.getRange(i, 9).getValue() || '').trim(); // Column I (9)
      const projectId = getProjectIdForInvoice(invId);
      
      if (projectId && !currentProjectId) {
        // Found a project, update column 9
        invoicesSheet.getRange(i, 9).setValue(projectId);
        updated++;
        Logger.log('✅ Row ' + i + ': ' + invId + ' → ' + projectId);
      } else if (projectId && currentProjectId === projectId) {
        alreadyLinked++;
      } else if (projectId && currentProjectId !== projectId) {
        // Mismatch - update to correct one
        invoicesSheet.getRange(i, 9).setValue(projectId);
        updated++;
        Logger.log('🔄 Row ' + i + ': ' + invId + ' → ' + projectId + ' (was: ' + currentProjectId + ')');
      }
    }
    
    Logger.log('✅ DONE: Updated ' + updated + ' invoices, ' + alreadyLinked + ' already linked');
    
  } catch (error) {
    Logger.log('❌ Error: ' + error.toString());
  }
}

/**
 * Verify projectId by looking it up in PM_projects sheet
 * @param {string} projectId - The project ID to verify
 * @returns {boolean} - True if project exists, false otherwise
 */
function projectIdExists(projectId) {
  if (!projectId || String(projectId).trim() === '') return false;
  
  try {
    const spreadsheet = SpreadsheetApp.openById(SPREADSHEET_ID);
    const projectsSheet = spreadsheet.getSheetByName(PM_PROJECTS_SHEET);
    
    if (!projectsSheet) return false;
    
    const lastRow = projectsSheet.getLastRow();
    if (lastRow < 2) return false;
    
    // Get all project IDs from column A
    const projectIds = projectsSheet.getRange(2, 1, lastRow - 1, 1).getValues();
    const projIdStr = String(projectId).trim();
    
    for (let i = 0; i < projectIds.length; i++) {
      if (String(projectIds[i][0] || '').trim() === projIdStr) {
        return true;
      }
    }
    
    return false;
  } catch (e) {
    Logger.log('Error checking projectId: ' + e.toString());
    return false;
  }
}

/**
 * Get all invoices/estimates with filters for the Invoices tab (filtered by company if email provided)
 * @param {string} workflowFilter - 'active' (default): hide invoicesTabComplete; 'complete': only complete; 'all': show everything
 */
function getAllInvoicesWithFilters(statusFilter, timePeriod, email, workflowFilter) {
  try {
    var wf = String(workflowFilter || 'active').toLowerCase();
    if (wf !== 'active' && wf !== 'complete' && wf !== 'all') wf = 'active';

    const spreadsheet = SpreadsheetApp.openById(SPREADSHEET_ID);
    const sheet = spreadsheet.getSheetByName(INVOICES_ESTIMATES_SHEET);
    
    if (!sheet) {
      return { success: true, invoices: [] };
    }
    
    // Get company info for filtering
    let companyId = null;
    let isAdmin = false;
    if (email) {
      const companyResult = getCompanyIdForUser(email);
      if (companyResult.success) {
        companyId = companyResult.companyId;
        isAdmin = companyResult.isAdmin || false;
      }
    }
    
    // Read data - sheet structure: Company ID (col 1), ID (col 2), Customer Email (col 3), JSON Parts (cols 4-6), Total (col 7), Payment Schedule (col 8), Project ID (col 9)
    const lastRow = sheet.getLastRow();
    if (lastRow < 2) {
      return { success: true, invoices: [] };
    }
    
    // Read up to 9 columns to include Project ID if it exists
    const numCols = Math.max(8, sheet.getLastColumn());
    const dataRows = sheet.getRange(2, 1, lastRow - 1, numCols).getValues();
    const invoices = [];
    
    // Calculate date range for time period filter
    const now = new Date();
    let startDate = null;
    if (timePeriod === 'week') {
      startDate = new Date(now.getTime() - 7 * 24 * 60 * 60 * 1000);
    } else if (timePeriod === 'month') {
      startDate = new Date(now.getTime() - 30 * 24 * 60 * 60 * 1000);
    } else if (timePeriod === 'year') {
      startDate = new Date(now.getTime() - 365 * 24 * 60 * 60 * 1000);
    }
    
    // Process each row
    for (let i = 0; i < dataRows.length; i++) {
      const row = dataRows[i];
      const rowCompanyId = String(row[0] || '').trim(); // Column 1: Company ID
      const id = String(row[1] || '').trim(); // Column 2: ID
      
      if (!id) continue;
      
      // Filter by Company ID if provided (and user is not admin) - check column directly first
      if (companyId && !isAdmin) {
        if (rowCompanyId !== companyId) {
          continue; // Skip invoices from other companies
        }
      }
      
      // Read JSON from columns 4, 5, 6
      const jsonChunks = [
        String(row[3] || '').trim(), // JSON Part 1 (column 4, index 3)
        String(row[4] || '').trim(), // JSON Part 2 (column 5, index 4)
        String(row[5] || '').trim()  // JSON Part 3 (column 6, index 5)
      ];
      const fullJson = concatenateJsonChunks(jsonChunks[0], jsonChunks[1], jsonChunks[2]);
      
      if (!fullJson || !fullJson.startsWith('{')) {
        // Skip rows without valid JSON
        continue;
      }
      
      try {
        const jsonData = JSON.parse(fullJson);
        
        // Company ID filtering already done above by checking row[0] directly
        
        const type = jsonData.type || 'Estimate';
        const tabComplete = jsonData.invoicesTabComplete === true || jsonData.invoicesTabComplete === 'true';
        if (wf === 'active' && tabComplete) continue;
        if (wf === 'complete' && !tabComplete) continue;

        const invoiceStatus = deriveInvoicesTabDisplayStatus_(jsonData);

        // Apply status filter
        if (statusFilter && statusFilter !== 'all') {
          if (statusFilter === 'sent' && invoiceStatus !== 'Sent') continue;
          if (statusFilter === 'signed' && invoiceStatus !== 'Signed') continue;
          if (statusFilter === 'approved' && invoiceStatus !== 'Approved') continue;
          if (statusFilter === 'declined' && invoiceStatus !== 'Declined') continue;
          if (statusFilter === 'draft' && invoiceStatus !== 'Draft') continue;
          if (statusFilter === 'paid' && invoiceStatus !== 'Paid') continue;
          if (statusFilter === 'partial' && invoiceStatus !== 'Partial') continue;
          if (statusFilter === 'pending' && invoiceStatus !== 'Pending') continue;
        }
        
        const date = jsonData.date || '';
        const approvalDate = jsonData.approvedDate || jsonData.approvalDate || '';
        const invoiceDate = approvalDate || date;
        
        // Apply time period filter
        if (startDate && invoiceDate) {
          const invoiceDateObj = invoiceDate instanceof Date ? invoiceDate : new Date(invoiceDate);
          if (isNaN(invoiceDateObj.getTime()) || invoiceDateObj < startDate) {
            continue;
          }
        }
        
        const customerName = jsonData.customerName || '';
        const customerEmail = jsonData.customerEmail || '';
        const total = parseFloat(jsonData.total || row[6] || 0); // Use JSON total or column 7 (index 6)
        const invoiceNumber = jsonData.invoiceNumber || '';
        const quoteNumber = jsonData.quoteNumber || '';
        
        // First check column 9, then cross-reference with PM_projects if empty
        let projectId = row[8] ? String(row[8]).trim() : '';
        if (!projectId && id) {
          // Column 9 is empty - look it up in PM_projects sheet by invoice ID
          projectId = getProjectIdForInvoice(id);
        }
        // Only include projectId if it actually exists in PM_projects sheet
        projectId = projectId && projectIdExists(projectId) ? projectId : '';
        
        const totalPaidJson = parseFloat(jsonData.totalPaid || 0);
        const remainingJson = jsonData.remainingBalance != null ? parseFloat(jsonData.remainingBalance) : NaN;
        const remainingBalance = !isNaN(remainingJson) ? remainingJson : Math.max(0, total - totalPaidJson);

        invoices.push({
          id: id,
          type: type,
          status: invoiceStatus,
          customerName: customerName || 'Unknown',
          customerEmail: customerEmail || '',
          date: date ? (date instanceof Date ? date.toISOString().split('T')[0] : date.toString()) : '',
          approvalDate: approvalDate ? (approvalDate instanceof Date ? approvalDate.toISOString().split('T')[0] : approvalDate.toString()) : '',
          totalAmount: total,
          totalPaid: totalPaidJson,
          remainingBalance: remainingBalance,
          invoicesTabComplete: tabComplete,
          invoiceNumber: invoiceNumber || '',
          quoteNumber: quoteNumber || '',
          number: invoiceNumber || quoteNumber || id,
          projectId: projectId || null
        });
      } catch (parseError) {
        Logger.log('Error parsing JSON for invoice ' + id + ': ' + parseError.toString());
        // Skip this row if JSON is invalid
        continue;
      }
    }
    
    // Sort by date descending (most recent first)
    invoices.sort((a, b) => {
      const dateA = a.date ? new Date(a.date) : new Date(0);
      const dateB = b.date ? new Date(b.date) : new Date(0);
      return dateB - dateA;
    });
    
    Logger.log('Found ' + invoices.length + ' invoices (filtered by company: ' + (companyId || 'none') + ')');
    return { success: true, invoices: invoices };
  } catch (error) {
    Logger.log('Error getting all invoices with filters: ' + error.toString());
    return { success: false, error: error.toString(), invoices: [] };
  }
}

/**
 * Export invoices report as CSV
 */
function exportInvoicesReport(statusFilter, timePeriod) {
  try {
    const result = getAllInvoicesWithFilters(statusFilter, timePeriod);
    if (!result.success || !result.invoices || result.invoices.length === 0) {
      return { success: false, error: 'No invoices found' };
    }
    
    // Create CSV header
    let csv = 'ID,Type,Status,Customer Name,Customer Email,Date,Approval Date,Total Amount,Invoice/Quote Number\n';
    
    // Add rows
    result.invoices.forEach(inv => {
      csv += `"${inv.id}","${inv.type}","${inv.status}","${inv.customerName}","${inv.customerEmail}","${inv.date}","${inv.approvalDate}","${inv.totalAmount}","${inv.number}"\n`;
    });
    
    return {
      success: true,
      csv: csv,
      filename: `invoices_report_${statusFilter || 'all'}_${timePeriod || 'all'}_${new Date().toISOString().split('T')[0]}.csv`
    };
  } catch (error) {
    Logger.log('Error exporting invoices report: ' + error.toString());
    return { success: false, error: error.toString() };
  }
}

/**
