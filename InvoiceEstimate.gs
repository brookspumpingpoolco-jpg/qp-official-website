/**
 * Normalize folder title for fuzzy matching (duplicates / phone-in-name variants).
 * @private
 */
function normalizeFolderNameKey_(s) {
  return String(s || '').replace(/\s+/g, ' ').trim().toLowerCase();
}

function buildCustomerFolderCacheKey_(customerName, customerAddress) {
  var raw = normalizeFolderNameKey_(String(customerName || '') + '|' + String(customerAddress || ''));
  return 'customer-folder:' + Utilities.base64EncodeWebSafe(raw).substring(0, 180);
}

function getCachedCustomerFolderInfo_(customerName, customerAddress) {
  try {
    var cache = CacheService.getScriptCache();
    var raw = cache.get(buildCustomerFolderCacheKey_(customerName, customerAddress));
    return raw ? JSON.parse(raw) : null;
  } catch (e) {
    Logger.log('Customer folder cache read error: ' + e.toString());
    return null;
  }
}

function setCachedCustomerFolderInfo_(customerName, customerAddress, payload) {
  try {
    if (!payload) return;
    CacheService.getScriptCache().put(
      buildCustomerFolderCacheKey_(customerName, customerAddress),
      JSON.stringify(payload),
      21600
    );
  } catch (e) {
    Logger.log('Customer folder cache write error: ' + e.toString());
  }
}

function getCustomerFolderUrlFromId_(folderId) {
  var id = String(folderId || '').trim();
  return id ? ('https://drive.google.com/drive/folders/' + id) : '';
}

function findHeaderIndexByName_(headers, candidates) {
  var names = Array.isArray(candidates) ? candidates : [candidates];
  for (var i = 0; i < headers.length; i++) {
    var hv = String(headers[i] || '').trim().toLowerCase();
    for (var j = 0; j < names.length; j++) {
      if (hv === String(names[j] || '').trim().toLowerCase()) return i;
    }
  }
  return -1;
}

function ensureCustomerFolderIdColumnQ_(sheet) {
  if (!sheet) return null;
  var targetCol = 17; // Column Q
  if (sheet.getMaxColumns() < targetCol) {
    sheet.insertColumnsAfter(sheet.getMaxColumns(), targetCol - sheet.getMaxColumns());
  }
  var headerCell = sheet.getRange(1, targetCol);
  var headerVal = String(headerCell.getValue() || '').trim();
  if (!headerVal) {
    headerCell.setValue('Customer Folder ID');
  }
  return targetCol - 1; // zero-based index
}

function resolveCustomerSheetFolderColumns_(headers) {
  var nameCol = findHeaderIndexByName_(headers, ['Name']);
  if (nameCol === -1) nameCol = 1;
  var emailCol = findHeaderIndexByName_(headers, ['Email']);
  if (emailCol === -1) emailCol = 2;
  var addressCol = findHeaderIndexByName_(headers, ['Address']);
  if (addressCol === -1) addressCol = 4;
  return { nameCol: nameCol, emailCol: emailCol, addressCol: addressCol };
}

function findBestCustomerSheetRowForFolder_(rows, cols, customerName, customerAddress, customerEmail) {
  var bestRow = -1;
  var bestScore = -1;
  var wantEmail = normalizeFolderNameKey_(customerEmail || '');
  var wantName = normalizeFolderNameKey_(customerName || '');
  var wantAddr = normalizeFolderNameKey_(customerAddress || '');

  for (var r = 0; r < rows.length; r++) {
    var row = rows[r] || [];
    var rowEmail = normalizeFolderNameKey_(row[cols.emailCol] || '');
    var rowName = normalizeFolderNameKey_(row[cols.nameCol] || '');
    var rowAddr = normalizeFolderNameKey_(row[cols.addressCol] || '');
    var score = 0;
    if (wantEmail && rowEmail && rowEmail === wantEmail) score = 100;
    else if (wantName && rowName && rowName === wantName && wantAddr && rowAddr && rowAddr === wantAddr) score = 90;
    else if (wantName && rowName && rowName === wantName) score = 50;

    if (score > bestScore) {
      bestScore = score;
      bestRow = r;
    }
  }
  return { rowIndex0: bestRow, score: bestScore };
}

function getCustomerFolderIdFromCustomersSheet_(customerName, customerAddress, customerEmail) {
  try {
    var ss = SpreadsheetApp.openById(SPREADSHEET_ID);
    var sheet = ss.getSheetByName(CUSTOMERS_SHEET);
    if (!sheet) return '';
    ensureCustomerFolderIdColumnQ_(sheet);
    var lastRow = sheet.getLastRow();
    var lastCol = Math.max(sheet.getLastColumn(), 17);
    if (lastRow < 2) return '';
    var all = sheet.getRange(1, 1, lastRow, lastCol).getValues();
    var headers = all[0] || [];
    var rows = all.slice(1);
    var cols = resolveCustomerSheetFolderColumns_(headers);
    var folderCol = 16;
    var match = findBestCustomerSheetRowForFolder_(rows, cols, customerName, customerAddress, customerEmail);
    if (match.rowIndex0 < 0 || match.score < 50) return '';
    return String((rows[match.rowIndex0] || [])[folderCol] || '').trim();
  } catch (e) {
    Logger.log('getCustomerFolderIdFromCustomersSheet_ error: ' + e.toString());
    return '';
  }
}

function setCustomerFolderIdInCustomersSheet_(customerName, customerAddress, customerEmail, folderId) {
  try {
    var id = String(folderId || '').trim();
    if (!id) return false;
    var ss = SpreadsheetApp.openById(SPREADSHEET_ID);
    var sheet = ss.getSheetByName(CUSTOMERS_SHEET);
    if (!sheet) return false;
    ensureCustomerFolderIdColumnQ_(sheet);
    var lastRow = sheet.getLastRow();
    var lastCol = Math.max(sheet.getLastColumn(), 17);
    if (lastRow < 2) return false;
    var all = sheet.getRange(1, 1, lastRow, lastCol).getValues();
    var headers = all[0] || [];
    var rows = all.slice(1);
    var cols = resolveCustomerSheetFolderColumns_(headers);
    var folderCol = 16;
    var match = findBestCustomerSheetRowForFolder_(rows, cols, customerName, customerAddress, customerEmail);
    if (match.rowIndex0 < 0 || match.score < 50) return false;
    var rowNumber = match.rowIndex0 + 2;
    var current = String((rows[match.rowIndex0] || [])[folderCol] || '').trim();
    if (current !== id) {
      sheet.getRange(rowNumber, folderCol + 1).setValue(id);
    }
    return true;
  } catch (e) {
    Logger.log('setCustomerFolderIdInCustomersSheet_ error: ' + e.toString());
    return false;
  }
}

function backfillCustomerFolderIds(limit, createMissing) {
  try {
    var maxRows = parseInt(limit, 10);
    if (isNaN(maxRows) || maxRows <= 0) maxRows = 300;
    var shouldCreate = String(createMissing || '').toLowerCase() === 'true';

    var ss = SpreadsheetApp.openById(SPREADSHEET_ID);
    var sheet = ss.getSheetByName(CUSTOMERS_SHEET);
    if (!sheet) return { success: false, error: 'Customers sheet not found' };
    ensureCustomerFolderIdColumnQ_(sheet);

    var lastRow = sheet.getLastRow();
    var lastCol = Math.max(sheet.getLastColumn(), 17);
    if (lastRow < 2) {
      return { success: true, processed: 0, updated: 0, skippedExisting: 0, missing: 0, errors: 0, createMissing: shouldCreate };
    }

    var values = sheet.getRange(1, 1, lastRow, lastCol).getValues();
    var headers = values[0] || [];
    var rows = values.slice(1);
    var cols = resolveCustomerSheetFolderColumns_(headers);
    var folderCol = 16;

    var processed = 0;
    var updated = 0;
    var skippedExisting = 0;
    var missing = 0;
    var errors = 0;

    for (var i = 0; i < rows.length; i++) {
      if (processed >= maxRows) break;
      processed++;

      var row = rows[i] || [];
      var name = String(row[cols.nameCol] || '').trim();
      var email = String(row[cols.emailCol] || '').trim();
      var address = String(row[cols.addressCol] || '').trim();
      var existingId = String(row[folderCol] || '').trim();

      if (!name && !email) continue;
      if (existingId) {
        skippedExisting++;
        continue;
      }

      try {
        var folder = null;
        if (shouldCreate) {
          folder = getOrCreateCustomerFolder(name, address, email);
        } else {
          var found = findExistingCustomerFolder_(name, address, false);
          folder = found && found.folder ? found.folder : null;
        }

        if (folder) {
          var folderId = String(folder.getId() || '').trim();
          if (folderId) {
            sheet.getRange(i + 2, folderCol + 1).setValue(folderId);
            updated++;
            setCachedCustomerFolderInfo_(name, address, {
              success: true,
              folderId: folderId,
              folderName: folder.getName(),
              folderUrl: getCustomerFolderUrlFromId_(folderId),
              folderStatus: 'found',
              folderSource: shouldCreate ? 'backfill-create' : 'backfill-found',
              statusMessage: 'Customer folder found'
            });
          } else {
            missing++;
          }
        } else {
          missing++;
        }
      } catch (rowErr) {
        errors++;
        Logger.log('backfillCustomerFolderIds row ' + (i + 2) + ' error: ' + rowErr.toString());
      }
    }

    return {
      success: true,
      processed: processed,
      updated: updated,
      skippedExisting: skippedExisting,
      missing: missing,
      errors: errors,
      createMissing: shouldCreate,
      limit: maxRows
    };
  } catch (error) {
    Logger.log('backfillCustomerFolderIds error: ' + error.toString());
    return { success: false, error: error.toString() };
  }
}

function findExistingCustomerFolder_(customerName, customerAddress, exactOnly) {
  var parentFolder = DriveApp.getFolderById(CUSTOMER_DRIVE_FOLDER_ID);
  var name = String(customerName || 'Customer').trim() || 'Customer';
  var addr = String(customerAddress || '').trim();
  var folderName = name + (addr ? ' - ' + addr : '');

  var exact = parentFolder.getFoldersByName(folderName);
  if (exact.hasNext()) {
    return { folder: exact.next(), source: 'exact' };
  }
  if (exactOnly) {
    return { folder: null, source: 'none' };
  }

  var nameKey = normalizeFolderNameKey_(name);
  var addrKey = normalizeFolderNameKey_(addr);
  var prefix = nameKey + ' -';
  var best = null;
  var bestScore = -1;
  var it = parentFolder.getFolders();
  while (it.hasNext()) {
    var f = it.next();
    var fn = f.getName();
    var fnKey = normalizeFolderNameKey_(fn);
    if (fnKey === normalizeFolderNameKey_(folderName)) {
      return { folder: f, source: 'normalized' };
    }
    if (fnKey === nameKey || fnKey.indexOf(prefix) === 0) {
      var score = 1;
      if (addrKey && fnKey.indexOf(addrKey) !== -1) {
        score = 3;
      } else if (addrKey) {
        var addrParts = addrKey.split(/[\s,]+/).filter(function(p) { return p.length > 3; });
        for (var p = 0; p < addrParts.length; p++) {
          if (fnKey.indexOf(addrParts[p]) !== -1) {
            score = 2;
            break;
          }
        }
      }
      if (score > bestScore) {
        bestScore = score;
        best = f;
      }
    }
  }
  return { folder: (bestScore >= 1 ? best : null), source: (bestScore >= 1 ? 'fuzzy' : 'none') };
}

function buildCustomerFolderPayload_(folder, status, source) {
  return {
    success: true,
    folderId: folder.getId(),
    folderName: folder.getName(),
    folderUrl: folder.getUrl(),
    folderStatus: status,
    folderSource: source,
    statusMessage: status === 'found' ? 'Customer folder found' : 'Customer folder created'
  };
}

/**
 * Get or create customer folder under CUSTOMER_DRIVE_FOLDER_ID.
 * 1) Exact match on "Name - Address"
 * 2) Else folder whose name equals name or starts with "name -" (pick best address overlap)
 * 3) Else create new folder with standard name
 */
function getOrCreateCustomerFolder(customerName, customerAddress, customerEmail) {
  try {
    var cached = getCachedCustomerFolderInfo_(customerName, customerAddress);
    if (cached && cached.folderId) {
      try {
        return DriveApp.getFolderById(cached.folderId);
      } catch (cacheErr) {
        Logger.log('Cached customer folder lookup failed: ' + cacheErr.toString());
      }
    }

    var folderIdFromSheet = getCustomerFolderIdFromCustomersSheet_(customerName, customerAddress, customerEmail);
    if (folderIdFromSheet) {
      try {
        var folderFromSheet = DriveApp.getFolderById(folderIdFromSheet);
        var payloadFromSheet = {
          success: true,
          folderId: folderIdFromSheet,
          folderName: folderFromSheet.getName(),
          folderUrl: getCustomerFolderUrlFromId_(folderIdFromSheet),
          folderStatus: 'found',
          folderSource: 'customers-sheet',
          statusMessage: 'Customer folder found'
        };
        setCachedCustomerFolderInfo_(customerName, customerAddress, payloadFromSheet);
        return folderFromSheet;
      } catch (sheetFolderErr) {
        Logger.log('Customer folder ID in sheet is invalid: ' + sheetFolderErr.toString());
      }
    }

    var found = findExistingCustomerFolder_(customerName, customerAddress, false);
    if (found.folder) {
      var foundPayload = buildCustomerFolderPayload_(found.folder, 'found', found.source);
      setCachedCustomerFolderInfo_(customerName, customerAddress, foundPayload);
      setCustomerFolderIdInCustomersSheet_(customerName, customerAddress, customerEmail, foundPayload.folderId);
      if (found.source === 'fuzzy') Logger.log('📁 Matched existing customer folder (fuzzy): ' + found.folder.getName());
      return found.folder;
    }

    const parentFolder = DriveApp.getFolderById(CUSTOMER_DRIVE_FOLDER_ID);
    const name = String(customerName || 'Customer').trim() || 'Customer';
    const addr = String(customerAddress || '').trim();
    const folderName = name + (addr ? ' - ' + addr : '');
    var newFolder = parentFolder.createFolder(folderName);
    try {
      newFolder.setSharing(DriveApp.Access.ANYONE_WITH_LINK, DriveApp.Permission.VIEW);
    } catch (shareErr) {
      Logger.log('Folder sharing note: ' + shareErr.toString());
    }
    Logger.log('📁 Created new customer folder: ' + folderName);
    var createdPayload = buildCustomerFolderPayload_(newFolder, 'created', 'created');
    setCachedCustomerFolderInfo_(customerName, customerAddress, createdPayload);
    setCustomerFolderIdInCustomersSheet_(customerName, customerAddress, customerEmail, createdPayload.folderId);
    return newFolder;
  } catch (error) {
    Logger.log('Error getting customer folder: ' + error.toString());
    return null;
  }
}

/**
 * Ensure a "Receipts" subfolder exists under the customer folder (expense uploads).
 * @private
 */
function getOrCreateReceiptsSubfolder_(customerFolder) {
  if (!customerFolder) return null;
  var subs = customerFolder.getFoldersByName('Receipts');
  if (subs.hasNext()) return subs.next();
  var nf = customerFolder.createFolder('Receipts');
  try {
    nf.setSharing(DriveApp.Access.ANYONE_WITH_LINK, DriveApp.Permission.VIEW);
  } catch (e) { /* ignore */ }
  return nf;
}

/**
 * Upload expense receipt image to customer Drive folder under Receipts/ (creates folder tree as needed).
 */
function uploadExpenseReceipt(base64Data, customerName, customerAddress) {
  try {
    if (!base64Data || typeof base64Data !== 'string') {
      return { success: false, error: 'No image data provided' };
    }
    var base64 = base64Data;
    var mimeType = MimeType.JPEG;
    if (base64.indexOf('base64,') !== -1) {
      var prefix = base64.substring(0, base64.indexOf('base64,') + 7);
      if (prefix.indexOf('image/png') !== -1) mimeType = MimeType.PNG;
      else if (prefix.indexOf('image/gif') !== -1) mimeType = MimeType.GIF;
      else if (prefix.indexOf('image/webp') !== -1) mimeType = 'image/webp';
      else if (prefix.indexOf('application/pdf') !== -1) mimeType = MimeType.PDF;
      base64 = base64.substring(prefix.length);
    }
    var blob = Utilities.newBlob(Utilities.base64Decode(base64), mimeType, 'receipt');
    var customerFolder = getOrCreateCustomerFolder(customerName, customerAddress);
    if (!customerFolder) {
      return { success: false, error: 'Could not get or create customer folder' };
    }
    var receiptsFolder = getOrCreateReceiptsSubfolder_(customerFolder);
    if (!receiptsFolder) {
      return { success: false, error: 'Could not create Receipts folder' };
    }
    var ext = '.jpg';
    if (mimeType === MimeType.PNG) ext = '.png';
    else if (mimeType === MimeType.GIF) ext = '.gif';
    else if (mimeType === 'image/webp' || String(mimeType).indexOf('webp') !== -1) ext = '.webp';
    else if (mimeType === MimeType.PDF) ext = '.pdf';
    var fileName = 'ExpenseReceipt_' + new Date().getTime() + ext;
    var file = receiptsFolder.createFile(blob.setName(fileName));
    file.setSharing(DriveApp.Access.ANYONE_WITH_LINK, DriveApp.Permission.VIEW);
    var fileId = file.getId();
    // /file/d/.../view works for PDFs and images in the browser (export=view is unreliable for PDF)
    var fileUrl = 'https://drive.google.com/file/d/' + fileId + '/view';
    return { success: true, fileUrl: fileUrl, fileId: fileId, folderName: customerFolder.getName() };
  } catch (error) {
    Logger.log('Error in uploadExpenseReceipt: ' + error.toString());
    return { success: false, error: error.toString() };
  }
}

/**
 * Upload a photo (base64) to the customer's Drive folder and return a shareable image URL.
 * Used for invoice/estimate photos that appear in the email.
 */
function uploadInvoicePhoto(base64Data, customerName, customerAddress) {
  try {
    if (!base64Data || typeof base64Data !== 'string') {
      return { success: false, error: 'No image data provided' };
    }
    // Strip data URL prefix if present (e.g. "data:image/jpeg;base64,...")
    let base64 = base64Data;
    let mimeType = MimeType.JPEG;
    if (base64.indexOf('base64,') !== -1) {
      const prefix = base64.substring(0, base64.indexOf('base64,') + 7);
      if (prefix.indexOf('image/png') !== -1) mimeType = MimeType.PNG;
      else if (prefix.indexOf('image/gif') !== -1) mimeType = MimeType.GIF;
      else if (prefix.indexOf('image/webp') !== -1) mimeType = 'image/webp';
      base64 = base64.substring(prefix.length);
    }
    const blob = Utilities.newBlob(Utilities.base64Decode(base64), mimeType, 'photo');
    const folder = getOrCreateCustomerFolder(customerName, customerAddress);
    if (!folder) {
      return { success: false, error: 'Could not get or create customer folder' };
    }
    const fileName = 'InvoicePhoto_' + new Date().getTime() + (mimeType === MimeType.PNG ? '.png' : '.jpg');
    const file = folder.createFile(blob.setName(fileName));
    file.setSharing(DriveApp.Access.ANYONE_WITH_LINK, DriveApp.Permission.VIEW);
    const fileId = file.getId();
    const imageUrl = 'https://drive.google.com/uc?export=view&id=' + fileId;
    return { success: true, fileUrl: imageUrl, fileId: fileId };
  } catch (error) {
    Logger.log('Error in uploadInvoicePhoto: ' + error.toString());
    return { success: false, error: error.toString() };
  }
}

function normalizePhotoArray_(value) {
  try {
    if (Array.isArray(value)) {
      return value.map(function(v) { return String(v || '').trim(); }).filter(Boolean);
    }
    if (typeof value === 'string' && value.trim()) {
      var parsed = JSON.parse(value);
      if (Array.isArray(parsed)) {
        return parsed.map(function(v) { return String(v || '').trim(); }).filter(Boolean);
      }
    }
  } catch (_) {}
  return [];
}

function sanitizeDriveFileNamePart_(value, fallback) {
  var cleaned = String(value || '').trim().replace(/[^a-zA-Z0-9_-]+/g, '_').replace(/^_+|_+$/g, '');
  return cleaned || String(fallback || 'Project');
}

function extractDriveFileIdFromUrl_(url) {
  var value = String(url || '').trim();
  if (!value) return '';
  var match = value.match(/[?&]id=([a-zA-Z0-9_-]+)/);
  if (match && match[1]) return match[1];
  match = value.match(/\/d\/([a-zA-Z0-9_-]+)/);
  if (match && match[1]) return match[1];
  match = value.match(/[-\w]{20,}/);
  return match ? String(match[0] || '') : '';
}

function uploadProjectPhoto(projectId, base64Data, customerName, customerAddress, customerEmail) {
  try {
    var pid = String(projectId || '').trim();
    if (!pid) return { success: false, error: 'Project ID required' };
    if (!base64Data || typeof base64Data !== 'string') {
      return { success: false, error: 'No image data provided' };
    }

    var projectResult = getProject(pid);
    if (!projectResult || !projectResult.success || !projectResult.project) {
      return { success: false, error: 'Project not found' };
    }
    var projectData = projectResult.project || {};

    var base64 = base64Data;
    var mimeType = MimeType.JPEG;
    var extension = '.jpg';
    if (base64.indexOf('base64,') !== -1) {
      var prefix = base64.substring(0, base64.indexOf('base64,') + 7);
      if (prefix.indexOf('image/png') !== -1) {
        mimeType = MimeType.PNG;
        extension = '.png';
      } else if (prefix.indexOf('image/gif') !== -1) {
        mimeType = MimeType.GIF;
        extension = '.gif';
      } else if (prefix.indexOf('image/webp') !== -1) {
        mimeType = 'image/webp';
        extension = '.webp';
      }
      base64 = base64.substring(prefix.length);
    }

    var blob = Utilities.newBlob(Utilities.base64Decode(base64), mimeType, 'project-photo');
    var folder = getOrCreateCustomerFolder(
      customerName || projectData.customerName,
      customerAddress || projectData.customerAddress,
      customerEmail || projectData.customerEmail || ''
    );
    if (!folder) {
      return { success: false, error: 'Could not get or create customer folder' };
    }

    var stamp = Utilities.formatDate(new Date(), Session.getScriptTimeZone() || 'America/New_York', 'yyyyMMdd_HHmmss');
    var fileName = sanitizeDriveFileNamePart_(pid, 'Project') + '_Photo_' + stamp + extension;
    var file = folder.createFile(blob.setName(fileName));
    file.setSharing(DriveApp.Access.ANYONE_WITH_LINK, DriveApp.Permission.VIEW);
    var imageUrl = 'https://drive.google.com/uc?export=view&id=' + file.getId();

    var photos = normalizePhotoArray_(projectData.photos);
    photos.push(imageUrl);
    photos = Array.from(new Set(photos));

    var saveResult = updateProject(pid, { photos: photos });
    if (!saveResult || !saveResult.success) {
      return { success: false, error: (saveResult && saveResult.error) || 'Failed to save project photo' };
    }

    var folderPayload = buildCustomerFolderPayload_(folder, 'found', 'cached');
    setCachedCustomerFolderInfo_(customerName || projectData.customerName, customerAddress || projectData.customerAddress, folderPayload);
    setCustomerFolderIdInCustomersSheet_(
      customerName || projectData.customerName,
      customerAddress || projectData.customerAddress,
      customerEmail || projectData.customerEmail || '',
      folderPayload.folderId
    );

    return {
      success: true,
      fileUrl: imageUrl,
      fileId: file.getId(),
      fileName: fileName,
      photos: photos,
      folderUrl: folder.getUrl()
    };
  } catch (error) {
    Logger.log('Error in uploadProjectPhoto: ' + error.toString());
    return { success: false, error: error.toString() };
  }
}

function deleteProjectPhoto(projectId, photoUrl) {
  try {
    var pid = String(projectId || '').trim();
    var url = String(photoUrl || '').trim();
    if (!pid) return { success: false, error: 'Project ID required' };
    if (!url) return { success: false, error: 'Photo URL required' };

    var projectResult = getProject(pid);
    if (!projectResult || !projectResult.success || !projectResult.project) {
      return { success: false, error: 'Project not found' };
    }
    var projectData = projectResult.project || {};
    var photos = normalizePhotoArray_(projectData.photos).filter(function(v) { return String(v) !== url; });
    var invoicePhotos = normalizePhotoArray_(projectData.invoicePhotos).filter(function(v) { return String(v) !== url; });

    var saveResult = updateProject(pid, {
      photos: photos,
      invoicePhotos: invoicePhotos
    });
    if (!saveResult || !saveResult.success) {
      return { success: false, error: (saveResult && saveResult.error) || 'Failed to delete project photo' };
    }

    var fileId = extractDriveFileIdFromUrl_(url);
    if (fileId) {
      try {
        DriveApp.getFileById(fileId).setTrashed(true);
      } catch (trashErr) {
        Logger.log('deleteProjectPhoto trash warning: ' + trashErr.toString());
      }
    }

    return {
      success: true,
      photos: photos,
      invoicePhotos: invoicePhotos
    };
  } catch (error) {
    Logger.log('Error in deleteProjectPhoto: ' + error.toString());
    return { success: false, error: error.toString() };
  }
}

function getCustomerFolderLink(customerName, customerAddress, customerEmail) {
  try {
    var cached = getCachedCustomerFolderInfo_(customerName, customerAddress);
    if (cached && cached.folderId && cached.folderUrl) {
      return cached;
    }

    var folderIdFromSheet = getCustomerFolderIdFromCustomersSheet_(customerName, customerAddress, customerEmail);
    if (folderIdFromSheet) {
      var payloadFromSheet = {
        success: true,
        folderId: folderIdFromSheet,
        folderName: String(customerName || '').trim() || 'Customer Folder',
        folderUrl: getCustomerFolderUrlFromId_(folderIdFromSheet),
        folderStatus: 'found',
        folderSource: 'customers-sheet',
        statusMessage: 'Customer folder found'
      };
      setCachedCustomerFolderInfo_(customerName, customerAddress, payloadFromSheet);
      return payloadFromSheet;
    }

    var found = findExistingCustomerFolder_(customerName, customerAddress, false);
    if (found.folder) {
      var payload = buildCustomerFolderPayload_(found.folder, 'found', found.source);
      setCachedCustomerFolderInfo_(customerName, customerAddress, payload);
      setCustomerFolderIdInCustomersSheet_(customerName, customerAddress, customerEmail, payload.folderId);
      return payload;
    }

    var folder = getOrCreateCustomerFolder(customerName, customerAddress, customerEmail);
    if (!folder) {
      return { success: false, error: 'Could not create or find customer folder' };
