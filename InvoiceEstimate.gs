/**
 * Finalize invoice and automatically create project
 */
function finalizeInvoice(invoiceId) {
  try {
    const invoiceResult = getInvoiceEstimate(invoiceId);
    if (!invoiceResult.success) {
      return invoiceResult;
    }
    
    const invoice = invoiceResult.data;
    
    // Verify invoice is not already finalized
    const spreadsheet = SpreadsheetApp.openById(SPREADSHEET_ID);
    const sheet = spreadsheet.getSheetByName(INVOICES_ESTIMATES_SHEET);
    // ENFORCE 6 COLUMNS FIRST
    enforce8ColumnStructure(sheet);
    
    const lastRow = sheet.getLastRow();
    let invoiceStatus = '';
    
    // Read from JSON (columns 3-5), NOT from separate column
    for (let i = 2; i <= lastRow; i++) {
      const rowId = String(sheet.getRange(i, 1).getValue() || '').trim();
      if (rowId === String(invoiceId).trim()) {
        try {
          const jsonPart1 = sheet.getRange(i, 3).getValue() || '';
          const jsonPart2 = sheet.getRange(i, 4).getValue() || '';
          const jsonPart3 = sheet.getRange(i, 5).getValue() || '';
          let jsonStr = concatenateJsonChunks(jsonPart1, jsonPart2, jsonPart3);
          if (jsonStr && jsonStr.startsWith('{')) {
            const jsonData = JSON.parse(jsonStr);
            invoiceStatus = jsonData.invoiceStatus || jsonData.status || '';
          }
        } catch (e) {
          Logger.log('Error reading invoice status from JSON: ' + e.toString());
        }
        break;
      }
    }
    
    if (invoiceStatus === 'Finalized' || invoiceStatus === 'Locked') {
      return { success: false, error: 'Invoice is already finalized' };
    }
    
    // Verify payment schedule exists and is finalized
    const scheduleResult = getPaymentScheduleByInvoiceId(invoiceId);
    if (!scheduleResult.success) {
      return { success: false, error: 'Payment schedule must be created and finalized before invoice finalization' };
    }
    
    const paymentSchedule = scheduleResult.paymentSchedule;
    if (paymentSchedule.status !== 'Finalized') {
      return { success: false, error: 'Payment schedule must be finalized before invoice finalization' };
    }
    
    // Mark invoice as finalized - store in JSON, NOT in separate column
    // ENFORCE 6 COLUMNS FIRST
    enforce8ColumnStructure(sheet);
    
    for (let i = 1; i < dataRows.length; i++) {
      if (dataRows[i][idCol] === invoiceId) {
        // Update status in JSON data (columns 3-5)
        try {
          const jsonPart1 = sheet.getRange(i + 1, 3).getValue() || '';
          const jsonPart2 = sheet.getRange(i + 1, 4).getValue() || '';
          const jsonPart3 = sheet.getRange(i + 1, 5).getValue() || '';
          let jsonStr = concatenateJsonChunks(jsonPart1, jsonPart2, jsonPart3);
          if (jsonStr && jsonStr.startsWith('{')) {
            const jsonData = JSON.parse(jsonStr);
            jsonData.invoiceStatus = 'Finalized';
            jsonData.status = 'Finalized';
            const updatedJsonStr = JSON.stringify(jsonData);
            const updatedChunks = splitJsonString(updatedJsonStr);
            sheet.getRange(i + 1, 3, 1, 3).setValues([[updatedChunks[0] || '', updatedChunks[1] || '', updatedChunks[2] || '']]);
          }
        } catch (e) {
          Logger.log('Error updating invoice status in JSON: ' + e.toString());
        }
        
        // ENFORCE 6 COLUMNS after update
        enforce8ColumnStructure(sheet);
        break;
      }
    }
    
    // Automatically create project
    const projectResult = createProjectFromInvoice(invoiceId);
    if (!projectResult.success) {
      Logger.log('Error creating project: ' + projectResult.error);
      // Don't fail finalization if project creation fails, but log it
    }
    
    // Send project created notification
    if (projectResult.success) {
      try {
        sendProjectCreatedNotification(projectResult.projectId, invoice.customerEmail);
      } catch (e) {
        Logger.log('Error sending project created notification: ' + e.toString());
      }
    }
    
    return {
      success: true,
      invoiceId: invoiceId,
      projectId: projectResult.success ? projectResult.projectId : null,
      message: 'Invoice finalized and project created'
    };
  } catch (error) {
    Logger.log('Error finalizing invoice: ' + error.toString());
    return { success: false, error: error.toString() };
  }
}

/**
 * Create project from finalized invoice
 */
function createProjectFromInvoice(invoiceId) {
  try {
    const invoiceResult = getInvoiceEstimate(invoiceId);
    if (!invoiceResult.success) {
      return invoiceResult;
    }
    
    const invoice = invoiceResult.data;
    const scheduleResult = getPaymentScheduleByInvoiceId(invoiceId);
    
    // Generate Project ID
    const year = new Date().getFullYear();
    const yearPrefix = 'PROJ-' + year + '-';
    const spreadsheet = SpreadsheetApp.openById(SPREADSHEET_ID);
    let projectsSheet = spreadsheet.getSheetByName(PROJECTS_SHEET_NAME);
    
    // Create Projects sheet if it doesn't exist
    if (!projectsSheet) {
      projectsSheet = spreadsheet.insertSheet(PROJECTS_SHEET_NAME);
      const headers = [
        'Project ID', 'Customer Email', 'Customer Name', 'Project Type', 'Status',
        'Start Date', 'Estimated Completion Date', 'Current Phase', 'Notes',
        'Created Date', 'Last Updated', 'Invoice ID', 'GC Name', 'GC Email',
        'Job Site Address', 'Billing Address', 'Total Contract Amount', 'Payment Schedule ID'
      ];
      projectsSheet.getRange(1, 1, 1, headers.length).setValues([headers]);
      projectsSheet.getRange(1, 1, 1, headers.length).setFontWeight('bold');
      projectsSheet.getRange(1, 1, 1, headers.length).setBackground('#0369a1');
      projectsSheet.getRange(1, 1, 1, headers.length).setFontColor('#ffffff');
    }
    
    // Generate Project ID
    const dataRows = projectsSheet.getDataRange().getValues();
    let maxNumber = 0;
    const projectIdCol = 0;
    
    for (let i = 1; i < dataRows.length; i++) {
      const id = dataRows[i][projectIdCol];
      if (id && typeof id === 'string' && id.startsWith(yearPrefix)) {
        const numPart = id.replace(yearPrefix, '');
        const num = parseInt(numPart);
        if (!isNaN(num) && num > maxNumber) {
          maxNumber = num;
        }
      }
    }
    
    const projectId = yearPrefix + String(maxNumber + 1).padStart(3, '0');
    
    const now = new Date();
    const jobSiteAddress = invoice.jobSiteAddress || invoice.customerAddress || '';
    const gcName = invoice.gcName || '';
    const gcEmail = invoice.gcEmail || '';
    
    // Calculate estimated completion (roughly 8-12 weeks for pool install)
    const estimatedCompletion = new Date(now);
    estimatedCompletion.setDate(estimatedCompletion.getDate() + 70); // ~10 weeks
    
    const rowData = [
      projectId,
      invoice.customerEmail || '',
      invoice.customerName || '',
      'Pool Build', // Default project type
      'Planning', // Initial status
      now,
      estimatedCompletion,
      'Planning',
      'Project created from Invoice ' + (invoice.invoiceNumber || invoiceId),
      now,
      now,
      invoiceId,
      gcName,
      gcEmail,
      jobSiteAddress,
      invoice.customerAddress || '',
      invoice.total || 0,
      scheduleResult.success ? scheduleResult.paymentSchedule.paymentScheduleId : ''
    ];
    
    projectsSheet.appendRow(rowData);
    
    // Link project ID to payment schedule
    if (scheduleResult.success) {
      const paymentSchedulesSheet = spreadsheet.getSheetByName(PAYMENT_SCHEDULES_SHEET);
      if (paymentSchedulesSheet) {
        const scheduleDataRows = paymentSchedulesSheet.getDataRange().getValues();
        const scheduleHeaders = scheduleDataRows[0];
        const scheduleIdCol = scheduleHeaders.indexOf('Payment Schedule ID');
        const projectIdColSchedule = scheduleHeaders.indexOf('Project ID');
        
        for (let i = 1; i < scheduleDataRows.length; i++) {
          if (scheduleDataRows[i][scheduleIdCol] === scheduleResult.paymentSchedule.paymentScheduleId) {
            paymentSchedulesSheet.getRange(i + 1, projectIdColSchedule + 1).setValue(projectId);
            break;
          }
        }
      }
    }
    
    // Link project ID to invoice
    linkProjectToInvoice(invoiceId, projectId);
    
    // Create project items from invoice items
    const items = JSON.parse(invoice.items || '[]');
    createProjectItemsFromInvoiceItems(projectId, items);
    
    return {
      success: true,
      projectId: projectId,
      message: 'Project created successfully'
    };
  } catch (error) {
    Logger.log('Error creating project from invoice: ' + error.toString());
    return { success: false, error: error.toString() };
  }
}

/**
 * Create project items from invoice items
 */
function createProjectItemsFromInvoiceItems(projectId, items) {
  try {
    const spreadsheet = SpreadsheetApp.openById(SPREADSHEET_ID);
    let itemsSheet = spreadsheet.getSheetByName(PROJECT_ITEMS_SHEET_NAME);
    
    // Create Project Items sheet if it doesn't exist
    if (!itemsSheet) {
      itemsSheet = spreadsheet.insertSheet(PROJECT_ITEMS_SHEET_NAME);
      const headers = [
        'Project ID', 'Item Name', 'Item Description', 'Quantity', 'Unit Price',
        'Total Cost', 'Order Date', 'Delivery Date', 'Status', 'Vendor/Supplier',
        'Notes', 'Added Date', 'Invoice ID'
      ];
      itemsSheet.getRange(1, 1, 1, headers.length).setValues([headers]);
      itemsSheet.getRange(1, 1, 1, headers.length).setFontWeight('bold');
      itemsSheet.getRange(1, 1, 1, headers.length).setBackground('#0369a1');
      itemsSheet.getRange(1, 1, 1, headers.length).setFontColor('#ffffff');
    }
    
    const now = new Date();
    
    for (const item of items) {
      const quantity = parseFloat(item.quantity || 0);
      const unitPrice = parseFloat(item.price || 0);
      const totalCost = quantity * unitPrice;
      
      const rowData = [
        projectId,
        item.name || item.description || 'Unnamed Item',
        item.description || '',
        quantity,
        unitPrice,
        totalCost,
        '', // Order Date
        '', // Delivery Date
        'Not Ordered', // Initial status
        '', // Vendor/Supplier
        '', // Notes
        now,
        '' // Invoice ID (can be added if needed)
      ];
      
      itemsSheet.appendRow(rowData);
    }
    
    return { success: true };
  } catch (error) {
    Logger.log('Error creating project items: ' + error.toString());
    return { success: false, error: error.toString() };
  }
}

/**
 * Link project to invoice
 */
function linkProjectToInvoice(invoiceId, projectId) {
  try {
    const spreadsheet = SpreadsheetApp.openById(SPREADSHEET_ID);
    const sheet = spreadsheet.getSheetByName(INVOICES_ESTIMATES_SHEET);
    
    if (!sheet) {
      return { success: false, error: 'Sheet not found' };
    }
    
    const dataRows = sheet.getDataRange().getValues();
    const headers = dataRows[0];
    const idCol = headers.indexOf('ID');
    let projectIdCol = findColumnIndexByName(sheet, 'Project ID');
    
    // Add column if it doesn't exist
    if (projectIdCol === -1) {
      const lastCol = sheet.getLastColumn();
      sheet.getRange(1, lastCol + 1).setValue('Project ID');
      sheet.getRange(1, lastCol + 1).setFontWeight('bold');
      sheet.getRange(1, lastCol + 1).setBackground('#0369a1');
      sheet.getRange(1, lastCol + 1).setFontColor('#ffffff');
      projectIdCol = lastCol;
    }
    
    for (let i = 1; i < dataRows.length; i++) {
      if (dataRows[i][idCol] === invoiceId) {
        sheet.getRange(i + 1, projectIdCol + 1).setValue(projectId);
        return { success: true };
      }
    }
    
    return { success: false, error: 'Invoice not found' };
  } catch (error) {
    Logger.log('Error linking project to invoice: ' + error.toString());
    return { success: false, error: error.toString() };
  }
}

/**
 * Send project created notification
 */
function sendProjectCreatedNotification(projectId, customerEmail) {
  try {
    const spreadsheet = SpreadsheetApp.openById(SPREADSHEET_ID);
    const projectsSheet = spreadsheet.getSheetByName(PROJECTS_SHEET_NAME);
    
    if (!projectsSheet) {
      return { success: false, error: 'Projects sheet not found' };
    }
    
    const dataRows = projectsSheet.getDataRange().getValues();
    const headers = dataRows[0];
    const projectIdCol = headers.indexOf('Project ID');
    const customerNameCol = headers.indexOf('Customer Name');
    const totalAmountCol = headers.indexOf('Total Contract Amount');
    const startDateCol = headers.indexOf('Start Date');
    const completionDateCol = headers.indexOf('Estimated Completion Date');
    const gcEmailCol = headers.indexOf('GC Email');
    
    let projectData = null;
    for (let i = 1; i < dataRows.length; i++) {
      if (dataRows[i][projectIdCol] === projectId) {
        projectData = {
          projectId: projectId,
          customerName: dataRows[i][customerNameCol] || '',
          totalAmount: dataRows[i][totalAmountCol] || 0,
          startDate: dataRows[i][startDateCol] || '',
          completionDate: dataRows[i][completionDateCol] || '',
          gcEmail: dataRows[i][gcEmailCol] || ''
        };
        break;
      }
    }
    
    if (!projectData) {
      return { success: false, error: 'Project not found' };
    }
    
    // Get payment schedule
    const scheduleResult = getPaymentScheduleByInvoiceId(projectData.projectId);
    let paymentScheduleSummary = 'No payment schedule available';
    if (scheduleResult.success) {
      const milestones = scheduleResult.paymentSchedule.milestones;
      paymentScheduleSummary = milestones.map(m => 
        `${m.name}: $${parseFloat(m.amount).toFixed(2)} (${m.percent}%)`
      ).join('\n');
    }
    
    // Format dates
    const formatDate = (date) => {
      if (!date) return 'TBD';
      const d = new Date(date);
      return d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
    };
    
    const emailSubject = 'Welcome! Your Pool Project Has Started - ' + projectId;
    const emailBody = `
      <div style="font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto;">
        <h2 style="color: #0369a1;">Welcome! Your Pool Project Has Started</h2>
        <p>Dear ${projectData.customerName},</p>
        <p>Your pool project has been officially started! Here's what you need to know:</p>
        
        <h3 style="color: #0369a1;">Project Details</h3>
        <ul>
          <li><strong>Project ID:</strong> ${projectId}</li>
          <li><strong>Total Contract Amount:</strong> $${parseFloat(projectData.totalAmount).toFixed(2)}</li>
          <li><strong>Start Date:</strong> ${formatDate(projectData.startDate)}</li>
          <li><strong>Estimated Completion:</strong> ${formatDate(projectData.completionDate)}</li>
        </ul>
        
        <h3 style="color: #0369a1;">Payment Schedule</h3>
        <pre style="background: #f5f5f5; padding: 15px; border-radius: 5px;">${paymentScheduleSummary}</pre>
        
        <h3 style="color: #0369a1;">Next Steps</h3>
        <ol>
          <li>Review your payment schedule in your customer portal</li>
          <li>Make your first payment when due</li>
          <li>Track project progress in real-time</li>
        </ol>
        
        <p><a href="${CUSTOMER_PORTAL_URL}" style="background: #0369a1; color: white; padding: 12px 24px; text-decoration: none; border-radius: 5px; display: inline-block;">Access Your Customer Portal</a></p>
        
        ${projectData.gcEmail ? '<p><strong>Note:</strong> Your General Contractor will also receive project updates.</p>' : ''}
        
        <p>Thank you for choosing ${COMPANY_NAME}!</p>
        <p>Best regards,<br>${COMPANY_NAME}<br>${COMPANY_PHONE}</p>
      </div>
    `;
    
    // Send to customer
    MailApp.sendEmail({
      to: customerEmail,
      subject: emailSubject,
      htmlBody: emailBody
    });
    
    // Send to GC if provided
    if (projectData.gcEmail) {
      MailApp.sendEmail({
        to: projectData.gcEmail,
        subject: 'New Project Started - ' + projectId,
        htmlBody: emailBody.replace('Welcome! Your Pool Project Has Started', 'New Project Started')
      });
    }
    
    return { success: true, message: 'Notification sent' };
  } catch (error) {
    Logger.log('Error sending project created notification: ' + error.toString());
    return { success: false, error: error.toString() };
  }
}

/**
 * Create Stripe checkout session for specific milestone payment
 */
function createStripeCheckoutForMilestone(milestoneId, paymentScheduleId, customerEmail) {
  try {
    const scheduleResult = getPaymentSchedule(paymentScheduleId);
    if (!scheduleResult.success) {
      return scheduleResult;
    }
    
    const schedule = scheduleResult.paymentSchedule;
    const milestone = schedule.milestones.find(m => m.milestoneId === milestoneId);
    
    if (!milestone) {
      return { success: false, error: 'Milestone not found' };
    }
    
    if (milestone.status === 'paid' || milestone.status === 'Paid') {
      return { success: false, error: 'Milestone is already paid' };
    }
    
    const amount = parseFloat(milestone.amount);
    const amountInCents = Math.round(amount * 100);
    
    // Create Stripe checkout session
    const checkoutUrl = STRIPE_API_URL + '/checkout/sessions';
    const payload = {
      payment_method_types: ['card'],
      line_items: [{
        price_data: {
          currency: 'usd',
          product_data: {
            name: milestone.name + ' - Payment',
            description: 'Payment for ' + milestone.name + ' milestone'
          },
          unit_amount: amountInCents
        },
        quantity: 1
      }],
      mode: 'payment',
      success_url: ScriptApp.getService().getUrl() + '?payment=success',
      cancel_url: ScriptApp.getService().getUrl() + '?payment=cancelled',
      customer_email: customerEmail,
      metadata: {
        milestone_id: milestoneId,
        payment_schedule_id: paymentScheduleId,
        invoice_id: schedule.invoiceId || '',
        project_id: schedule.projectId || ''
      }
    };
    
    const response = UrlFetchApp.fetch(checkoutUrl, {
      method: 'POST',
      headers: {
        'Authorization': 'Bearer ' + STRIPE_SECRET_KEY,
        'Content-Type': 'application/x-www-form-urlencoded'
      },
      payload: Object.keys(payload).map(key => {
        if (typeof payload[key] === 'object') {
          return key + '=' + encodeURIComponent(JSON.stringify(payload[key]));
        }
        return key + '=' + encodeURIComponent(payload[key]);
      }).join('&'),
      muteHttpExceptions: true
    });
    
    const result = JSON.parse(response.getContentText());
    
    if (result.error) {
      return { success: false, error: result.error.message || 'Stripe error' };
    }
    
    return {
      success: true,
      checkoutUrl: result.url,
      sessionId: result.id
    };
  } catch (error) {
    Logger.log('Error creating Stripe checkout for milestone: ' + error.toString());
    return { success: false, error: error.toString() };
  }
}

