/**
 * Step 1 — Confirm the token works and see current @username (run BEFORE changing username in @BotFather).
 * Requires Script property BROOKS_TELEGRAM_BOT_TOKEN. Returns { ok, id, username, first_name }.
 */
function verifyTelegramBotOperational() {
  var token = getTelegramBotToken_();
  if (!token) {
    throw new Error('Set Script property BROOKS_TELEGRAM_BOT_TOKEN (Project Settings → Script properties).');
  }
  var url = 'https://api.telegram.org/bot' + token + '/getMe';
  var response = UrlFetchApp.fetch(url, { muteHttpExceptions: true });
  var status = response.getResponseCode();
  var body = response.getContentText() || '';
  if (status < 200 || status >= 300) {
    Logger.log('verifyTelegramBotOperational: HTTP ' + status + ' ' + body);
    throw new Error('Telegram getMe failed HTTP ' + status + ': ' + body);
  }
  var json = JSON.parse(body);
  if (!json.ok) {
    throw new Error('getMe not ok: ' + body);
  }
  var r = json.result || {};
  Logger.log('Telegram bot operational: @' + (r.username || '?') + ' (id ' + r.id + ')');
  return r;
}

/**
 * Step 2 — Sends a test message so you can verify delivery to a DM or channel.
 *
 * Chat id resolution (first match wins):
 * 1) Constant TELEGRAM_TEST_CHAT_ID (top of script) — channel (-100…) or any test chat.
 * 2) Script property TELEGRAM_TEST_CHAT_ID.
 * 3) Production: BROOKS_TELEGRAM_CHAT_ID constant, then property, via getBrooksTelegramChatId_().
 *
 * Channel: add the bot as admin, post once, get id from getUpdates or @getidsbot.
 */
function testTelegramChannel() {
  var props = PropertiesService.getScriptProperties();
  var raw = '';
  var chatSource = '';
  if (TELEGRAM_TEST_CHAT_ID && String(TELEGRAM_TEST_CHAT_ID).trim()) {
    raw = String(TELEGRAM_TEST_CHAT_ID).trim();
    chatSource = 'constant TELEGRAM_TEST_CHAT_ID';
  } else {
    raw = (props.getProperty('TELEGRAM_TEST_CHAT_ID') || '').trim();
    if (raw) chatSource = 'Script property TELEGRAM_TEST_CHAT_ID';
  }
  var chatId = raw || getBrooksTelegramChatId_();
  if (!chatId) {
    var msg = 'No chat id. Set TELEGRAM_TEST_CHAT_ID or BROOKS_TELEGRAM_CHAT_ID at top of script, or Script properties TELEGRAM_TEST_CHAT_ID (channel -100…) or BROOKS_TELEGRAM_CHAT_ID (Brooks user id).';
    Logger.log(msg);
    throw new Error(msg);
  }
  if (!chatSource) chatSource = 'BROOKS_TELEGRAM_CHAT_ID / getBrooksTelegramChatId_';
  var token = getTelegramBotToken_();
  if (!token) {
    throw new Error('BROOKS_TELEGRAM_BOT_TOKEN is empty — set constant at top of script or Script property BROOKS_TELEGRAM_BOT_TOKEN');
  }
  var tokenMatch = String(token).match(/^(\d+):/);
  var botUserId = tokenMatch ? tokenMatch[1] : '';
  if (botUserId && String(chatId) === botUserId) {
    throw new Error(
      'chat_id equals your bot user id (the number before ":" in the token). Never use that as chat_id. ' +
      'Remove Script property TELEGRAM_TEST_CHAT_ID if it was set to that number. ' +
      'Use your personal Telegram user id from @userinfobot (or message your bot, then read message.chat.id from getUpdates).'
    );
  }
  Logger.log('testTelegramChannel: using chat_id=' + chatId + ' (source: ' + chatSource + ')');
  var url = 'https://api.telegram.org/bot' + token + '/sendMessage';
  var when = Utilities.formatDate(new Date(), Session.getScriptTimeZone() || 'America/New_York', "yyyy-MM-dd HH:mm z");
  var text = '<b>Pool app — Telegram test</b>\n\nIf you see this, the bot can post to this chat.\n\n<i>' + escapeTelegramHtml_(when) + '</i>';
  var response = UrlFetchApp.fetch(url, {
    method: 'post',
    payload: {
      chat_id: chatId,
      text: text,
      parse_mode: 'HTML',
      disable_web_page_preview: true
    },
    muteHttpExceptions: true
  });
  var status = response.getResponseCode();
  var body = response.getContentText() || '';
  if (status >= 200 && status < 300) {
    Logger.log('testTelegramChannel: OK — check Telegram. chat_id=' + chatId);
    return;
  }
  Logger.log('testTelegramChannel failed: HTTP ' + status + ' ' + body);
  var errMsg = 'Telegram HTTP ' + status + ': ' + body;
  if (status === 403 && body.indexOf('bots can\'t send messages to bots') !== -1) {
    errMsg +=
      '\n\n→ Telegram thinks chat_id is another BOT, not a human user.' +
      '\n• If TELEGRAM_TEST_CHAT_ID is empty, Apps Script may be using Script property TELEGRAM_TEST_CHAT_ID — open Project Settings → Script properties and DELETE it if it equals the number before ":" in your token, or any bot id.' +
      '\n• Otherwise get YOUR id from the account that should receive DMs: open @userinfobot from that account and use the numeric Id (must not be a bot).' +
      '\n• After you message your bot once, https://api.telegram.org/bot<TOKEN>/getUpdates shows message.chat.id for your private chat (use is_bot:false on "from" if present).' +
      '\n• Log line above shows which source supplied chat_id.';
  }
  throw new Error(errMsg);
}

