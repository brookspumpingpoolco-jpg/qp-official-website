/**
 * Get all contracts for a specific project
 */
function getProjectContracts(projectId) {
  try {
    const spreadsheet = SpreadsheetApp.openById(SPREADSHEET_ID);
    
    // Try to get contracts sheet (might not exist yet)
    const contractsSheet = spreadsheet.getSheetByName(CONTRACTS_SHEET);
    
    if (!contractsSheet) {
      return { success: true, contracts: [] };
    }
    
    const data = contractsSheet.getDataRange().getValues();
    const contracts = [];
    
    for (let i = 1; i < data.length; i++) {
      try {
        const jsonPart1 = data[i][3] || '';
        const jsonPart2 = data[i][4] || '';
        const jsonPart3 = data[i][5] || '';
        const jsonStr = jsonPart1 + jsonPart2 + jsonPart3;
        
        if (jsonStr && jsonStr.trim()) {
          const contract = JSON.parse(jsonStr);
          
          // Check if contract belongs to this project
          if (contract.projectId === projectId) {
            contract.id = data[i][0];
            contract.status = data[i][6] || 'Draft';
            contract.dateCreated = data[i][7];
            contract.dateSent = data[i][8];
            contract.dateSigned = data[i][9];
            contract.pdfUrl = data[i][10] || '';
            contract.signedPdfUrl = data[i][11] || '';
            
            contracts.push(contract);
          }
        }
      } catch (parseError) {
        Logger.log('⚠️ Error parsing contract at row ' + (i + 1) + ': ' + parseError.toString());
      }
    }
    
    Logger.log('📋 Found ' + contracts.length + ' contracts for project ' + projectId);
    
    return {
      success: true,
      contracts: contracts
    };
  } catch (error) {
    Logger.log('❌ Error getting project contracts: ' + error.toString());
    return {
      success: false,
      error: error.toString()
    };
  }
}

/**
 * Check Stripe payment status for an invoice and update payment history if needed
 */
function checkStripePaymentStatus(invoiceId) {
  try {
    Logger.log('🔍 Checking Stripe payment status for invoice: ' + invoiceId);
    
    const spreadsheet = SpreadsheetApp.openById(SPREADSHEET_ID);
    const sheet = spreadsheet.getSheetByName(INVOICES_ESTIMATES_SHEET);
    
    if (!sheet) {
      return { success: false, error: 'Invoice sheet not found' };
    }
    
    enforce8ColumnStructure(sheet);
    const lastRow = sheet.getLastRow();
    const sheetCols = sheet.getLastColumn();
    const is8Column = (sheetCols >= 8);
    const idCol = is8Column ? 2 : 1;
    const json1Col = is8Column ? 4 : 3;
    const json2Col = is8Column ? 5 : 4;
    const json3Col = is8Column ? 6 : 5;
    const companyIdCol = is8Column ? 1 : 0;
    
    // Find invoice
    let foundRow = null;
    for (let i = 1; i < lastRow; i++) {
      const rowId = String(sheet.getRange(i + 1, idCol).getValue() || '').trim();
      if (rowId === String(invoiceId).trim()) {
        foundRow = i + 1;
        break;
      }
    }
    
    if (!foundRow) {
      return { success: false, error: 'Invoice not found' };
    }
    
    // Read invoice JSON
    const jsonPart1 = sheet.getRange(foundRow, json1Col).getValue() || '';
    const jsonPart2 = sheet.getRange(foundRow, json2Col).getValue() || '';
    const jsonPart3 = sheet.getRange(foundRow, json3Col).getValue() || '';
    let jsonStr = concatenateJsonChunks(jsonPart1, jsonPart2, jsonPart3);
    
    if (!jsonStr || jsonStr.length === 0) {
      jsonStr = String(jsonPart1 || '').trim();
    }
    
    if (!jsonStr || !jsonStr.startsWith('{')) {
      return { success: false, error: 'Invalid invoice data' };
    }
    
    const invoiceData = JSON.parse(jsonStr);
    const customerEmail = invoiceData.customerEmail || '';
    
    if (!customerEmail) {
      return { success: false, error: 'Customer email not found' };
    }
    
    // Check for Stripe payments for this invoice
    // Search for checkout sessions with this invoice ID in metadata
    const searchUrl = STRIPE_API_URL + '/checkout/sessions/search?query=metadata[\'invoice_id\']:\'' + encodeURIComponent(invoiceId) + '\'';
    
    const searchResponse = UrlFetchApp.fetch(searchUrl, {
      method: 'get',
      headers: {
        'Authorization': 'Bearer ' + STRIPE_SECRET_KEY
      },
      muteHttpExceptions: true
    });
    
    let paymentFound = false;
    let totalPaid = parseFloat(invoiceData.totalPaid || 0);
    const invoiceTotal = parseFloat(invoiceData.total || 0);
    
    if (searchResponse.getResponseCode() === 200) {
      const searchResult = JSON.parse(searchResponse.getContentText());
      
      if (searchResult.data && searchResult.data.length > 0) {
        // Check each session for payment status
        for (const session of searchResult.data) {
          if (session.payment_status === 'paid' && session.status === 'complete') {
            const paidAmount = (session.amount_total || 0) / 100;
            
            // Check if this payment is already recorded
            const existingPayments = invoiceData.partialPayments || [];
            const paymentExists = existingPayments.some(p => 
              p.transactionId === (session.payment_intent || session.id) && p.status === 'Completed'
            );
            
            if (!paymentExists) {
              // Record new payment
              if (!invoiceData.partialPayments) {
                invoiceData.partialPayments = [];
              }
              
              invoiceData.partialPayments.push({
                amount: paidAmount,
                paidDate: new Date().toISOString(),
                transactionId: session.payment_intent || session.id,
                status: 'Completed'
              });
              
              totalPaid += paidAmount;
              paymentFound = true;
              
              // Record in payment history
              const companyId = is8Column ? (sheet.getRange(foundRow, companyIdCol).getValue() || 'CMP-AQUALITYPOOL') : 'CMP-AQUALITYPOOL';
              const stripeFee = (paidAmount * 0.029) + 0.30;
              
              var ph = recordPaymentHistoryUnified(
                invoiceId,
                paidAmount,
                session.payment_intent || session.id,
                'Stripe',
                companyId,
                new Date(),
                invoiceData.customerEmail || '',
                invoiceData.customerName ? `Payment for Invoice ${invoiceId} - ${invoiceData.customerName}` : `Payment for Invoice ${invoiceId}`,
                stripeFee,
                ''
              );
              if (ph.duplicate) {
                Logger.log('Payment history duplicate skipped (already recorded): ' + (ph.transactionId || session.payment_intent || session.id));
              } else if (!ph.success) {
                Logger.log('Payment history record failed: ' + (ph.error || ph.message));
              } else {
                syncAppointmentsLinkedInvoiceForInvoice_(invoiceId);
              }
              
              Logger.log('✅ New payment found and recorded: $' + paidAmount.toFixed(2));
            }
          }
        }
      }
    }
    
    // Update payment status
    if (totalPaid >= invoiceTotal - 0.01) {
      invoiceData.paymentStatus = 'Paid';
      invoiceData.status = 'Paid';
      invoiceData.paidDate = new Date().toISOString();
    } else if (totalPaid > 0) {
      invoiceData.paymentStatus = 'Partial';
      invoiceData.totalPaid = totalPaid;
      invoiceData.remainingBalance = invoiceTotal - totalPaid;
    } else {
      invoiceData.paymentStatus = invoiceData.paymentStatus || 'Pending';
    }
    
    invoiceData.totalPaid = totalPaid;
    invoiceData.remainingBalance = invoiceTotal - totalPaid;
    
    // Save updated invoice data
    if (paymentFound) {
      const updatedJsonStr = JSON.stringify(invoiceData);
      const updatedChunks = splitJsonString(updatedJsonStr);
      sheet.getRange(foundRow, json1Col, 1, 3).setValues([[updatedChunks[0] || '', updatedChunks[1] || '', updatedChunks[2] || '']]);
      SpreadsheetApp.flush();
    }
    
    return {
      success: true,
      paymentStatus: invoiceData.paymentStatus,
      totalPaid: totalPaid,
      remainingBalance: invoiceTotal - totalPaid,
      isPaid: totalPaid >= invoiceTotal - 0.01,
      paymentFound: paymentFound
    };
    
  } catch (error) {
    Logger.log('❌ Error checking payment status: ' + error.toString());
    return { success: false, error: error.toString() };
  }
}

/**
 * Record review request from payment portal
 * Tracks when customers interact with review popup (Yes/No/Maybe Later)
 */
function recordPaymentPortalReviewRequest(data) {
  try {
    const invoiceId = data.invoiceId;
    const customerEmail = data.customerEmail || '';
    const customerName = data.customerName || '';
    const action = data.action || 'Shown'; // 'Yes' (clicked review), 'No' (maybe later), 'Shown' (just displayed)
    const reviewPlatform = data.platform || ''; // 'Google' or 'Facebook' if action is 'Yes'
    
    if (!invoiceId) {
      return { success: false, error: 'Invoice ID required' };
    }
    
    // Get invoice data to get company ID
    const spreadsheet = SpreadsheetApp.openById(SPREADSHEET_ID);
    const invoiceSheet = spreadsheet.getSheetByName(INVOICES_ESTIMATES_SHEET);
    
    if (!invoiceSheet) {
      return { success: false, error: 'Invoice sheet not found' };
    }
    
    enforce8ColumnStructure(invoiceSheet);
    const lastRow = invoiceSheet.getLastRow();
    const sheetCols = invoiceSheet.getLastColumn();
    const is8Column = (sheetCols >= 8);
    const idCol = is8Column ? 2 : 1;
    const companyIdCol = is8Column ? 1 : 0;
    
    // Find invoice to get company ID and find linked appointment
    let companyId = 'CMP-AQUALITYPOOL';
    let appointmentId = '';
    
    for (let i = 1; i < lastRow; i++) {
      const rowId = String(invoiceSheet.getRange(i + 1, idCol).getValue() || '').trim();
      if (rowId === String(invoiceId).trim()) {
        companyId = is8Column ? (invoiceSheet.getRange(i + 1, companyIdCol).getValue() || 'CMP-AQUALITYPOOL') : 'CMP-AQUALITYPOOL';
        // Try to find linked appointment - check if invoice has appointment reference
        // This would be in invoice metadata or notes - for now we'll search appointments
        break;
      }
    }
    
    // Find appointment linked to this invoice
    try {
      const appointmentsSheet = spreadsheet.getSheetByName('Appointments');
      if (appointmentsSheet) {
        const apptValues = appointmentsSheet.getDataRange().getValues();
        // LinkedInvoiceID is column 25 (index 24) in appointments
        for (let i = 1; i < apptValues.length; i++) {
          const linkedInvoice = String(apptValues[i][24] || '').trim();
          if (linkedInvoice === String(invoiceId).trim()) {
            appointmentId = String(apptValues[i][0] || '').trim(); // Appointment ID is column 1 (index 0)
            Logger.log('✅ Found linked appointment: ' + appointmentId + ' for invoice: ' + invoiceId);
            break;
          }
        }
      }
    } catch (error) {
      Logger.log('⚠️ Could not find linked appointment: ' + error.toString());
    }
    
    // Use the same Reviews sheet from SchedulingScript
    let reviewsSheet = spreadsheet.getSheetByName('Reviews');
    
    if (!reviewsSheet) {
      // Create Reviews sheet if it doesn't exist
      reviewsSheet = spreadsheet.insertSheet('Reviews');
      const headers = [
        'ReviewID', 'CompanyID', 'CustomerEmail', 'CustomerName', 'CustomerPhone',
        'ServiceType', 'AppointmentID', 'RequestMethod', 'RequestSentAt', 'TimesRequested',
        'CustomMessage', 'ReviewReceived', 'ReceivedAt', 'ReviewRating', 'ReviewText',
        'GoogleAuthor', 'ResponseSent', 'ResponseText', 'ResponseSentAt', 'Tags',
        'Notes', 'CreatedAt', 'UpdatedAt', 'InvoiceID', 'ReviewAction', 'ReviewPlatform'
      ];
      reviewsSheet.appendRow(headers);
      reviewsSheet.getRange(1, 1, 1, headers.length).setFontWeight('bold');
      reviewsSheet.getRange(1, 1, 1, headers.length).setBackground('#0369a1');
      reviewsSheet.getRange(1, 1, 1, headers.length).setFontColor('#ffffff');
    } else {
      // Check if new columns exist, add them if not
      const headers = reviewsSheet.getRange(1, 1, 1, reviewsSheet.getLastColumn()).getValues()[0];
      const headerMap = {};
      headers.forEach((h, i) => { headerMap[h] = i; });
      
      let needsUpdate = false;
      if (!headerMap['InvoiceID']) {
        const lastCol = reviewsSheet.getLastColumn();
        reviewsSheet.getRange(1, lastCol + 1).setValue('InvoiceID');
        headerMap['InvoiceID'] = lastCol;
        needsUpdate = true;
      }
      if (!headerMap['ReviewAction']) {
        const lastCol = reviewsSheet.getLastColumn();
        reviewsSheet.getRange(1, lastCol + 1).setValue('ReviewAction');
        headerMap['ReviewAction'] = lastCol;
        needsUpdate = true;
      }
      if (!headerMap['ReviewPlatform']) {
        const lastCol = reviewsSheet.getLastColumn();
        reviewsSheet.getRange(1, lastCol + 1).setValue('ReviewPlatform');
        headerMap['ReviewPlatform'] = lastCol;
        needsUpdate = true;
      }
      
      if (needsUpdate) {
        // Update header formatting
        const headerRange = reviewsSheet.getRange(1, 1, 1, reviewsSheet.getLastColumn());
        headerRange.setFontWeight('bold');
        headerRange.setBackground('#0369a1');
        headerRange.setFontColor('#ffffff');
      }
    }
    
    // Get headers and create header map (refresh after potential column additions)
    const headerRow = reviewsSheet.getRange(1, 1, 1, reviewsSheet.getLastColumn()).getValues()[0];
    const headerMapFinal = {};
    headerRow.forEach((h, i) => { headerMapFinal[h] = i; });
    
    // Check if review request already exists for this invoice
    const dataRows = reviewsSheet.getDataRange().getValues();
    let existingRow = null;
    
    // Check if InvoiceID column exists
    const invoiceIdColIndex = headerMapFinal['InvoiceID'] !== undefined ? headerMapFinal['InvoiceID'] : -1;
    
    if (invoiceIdColIndex >= 0) {
      for (let i = 1; i < dataRows.length; i++) {
        const rowInvoiceId = dataRows[i][invoiceIdColIndex] || '';
        if (String(rowInvoiceId).trim() === String(invoiceId).trim()) {
          existingRow = i + 1;
          break;
        }
      }
    }
    
    const now = new Date().toISOString();
    
    if (existingRow) {
      // Update existing review request
      const reviewActionCol = headerMapFinal['ReviewAction'] !== undefined ? headerMapFinal['ReviewAction'] : -1;
      const reviewPlatformCol = headerMapFinal['ReviewPlatform'] !== undefined ? headerMapFinal['ReviewPlatform'] : -1;
      const requestMethodCol = headerMapFinal['RequestMethod'] !== undefined ? headerMapFinal['RequestMethod'] : 7;
      const reviewReceivedCol = headerMapFinal['ReviewReceived'] !== undefined ? headerMapFinal['ReviewReceived'] : 11;
      const updatedAtCol = headerMapFinal['UpdatedAt'] !== undefined ? headerMapFinal['UpdatedAt'] : 21;
      
      if (action === 'Yes') {
        if (reviewActionCol >= 0) reviewsSheet.getRange(existingRow, reviewActionCol + 1).setValue('Yes');
        if (reviewPlatformCol >= 0 && reviewPlatform) {
          reviewsSheet.getRange(existingRow, reviewPlatformCol + 1).setValue(reviewPlatform);
        }
        if (reviewReceivedCol >= 0) reviewsSheet.getRange(existingRow, reviewReceivedCol + 1).setValue('Pending');
      } else if (action === 'No') {
        if (reviewActionCol >= 0) reviewsSheet.getRange(existingRow, reviewActionCol + 1).setValue('No');
        if (reviewReceivedCol >= 0) reviewsSheet.getRange(existingRow, reviewReceivedCol + 1).setValue('No');
      } else {
        if (reviewActionCol >= 0) reviewsSheet.getRange(existingRow, reviewActionCol + 1).setValue('Shown');
      }
      if (requestMethodCol >= 0) reviewsSheet.getRange(existingRow, requestMethodCol + 1).setValue('Payment Portal');
      if (updatedAtCol >= 0) reviewsSheet.getRange(existingRow, updatedAtCol + 1).setValue(now);
      
      Logger.log('✅ Updated review request for invoice: ' + invoiceId + ', action: ' + action);
    } else {
      // Create new review request
      const reviewId = 'REV-INV-' + Date.now();
      const headers = reviewsSheet.getRange(1, 1, 1, reviewsSheet.getLastColumn()).getValues()[0];
      const newRow = new Array(headers.length).fill('');
      
      // Set values using header map
      const setValue = (colName, value) => {
        if (headerMapFinal[colName] !== undefined) {
          newRow[headerMapFinal[colName]] = value;
        }
      };
      
      setValue('ReviewID', reviewId);
      setValue('CompanyID', companyId);
      setValue('CustomerEmail', customerEmail);
      setValue('CustomerName', customerName);
      setValue('ServiceType', 'Invoice Payment');
      setValue('AppointmentID', appointmentId); // Link to appointment if found
      setValue('RequestMethod', 'Payment Portal');
      setValue('RequestSentAt', now);
      setValue('TimesRequested', 1);
      setValue('CustomMessage', 'Review requested via payment portal after invoice payment');
      setValue('ReviewReceived', action === 'Yes' ? 'Pending' : (action === 'No' ? 'No' : 'Pending'));
      setValue('ReceivedAt', action === 'Yes' ? now : '');
      setValue('Tags', 'Payment Portal');
      setValue('Notes', 'Review popup shown in invoice payment portal');
      setValue('CreatedAt', now);
      setValue('UpdatedAt', now);
      setValue('InvoiceID', invoiceId);
      setValue('ReviewAction', action);
      setValue('ReviewPlatform', reviewPlatform);
      
      reviewsSheet.appendRow(newRow);
      
      Logger.log('✅ Created review request for invoice: ' + invoiceId + ', action: ' + action);
    }
    
    return {
      success: true,
      message: 'Review request recorded',
      action: action,
      platform: reviewPlatform
    };
    
  } catch (error) {
    Logger.log('❌ Error recording review request: ' + error.toString());
    return { success: false, error: error.toString() };
  }
}

/**
 * Mark a contract/estimate as fully executed (both parties have signed).
 * This clears the "Needs Signature" flag in getPendingActions().
 */
function markContractExecuted(id) {
  if (!id) return { success: false, error: 'ID is required' };
  try {
    const spreadsheet = SpreadsheetApp.openById(SPREADSHEET_ID);
    const sheet = spreadsheet.getSheetByName(INVOICES_ESTIMATES_SHEET);
    if (!sheet) return { success: false, error: 'Sheet not found' };

    const lastRow = sheet.getLastRow();
    for (let rowNum = 2; rowNum <= lastRow; rowNum++) {
      const rowId = String(sheet.getRange(rowNum, 1).getValue() || '').trim();
      if (rowId !== String(id).trim()) continue;

      const jsonPart1 = sheet.getRange(rowNum, 3).getValue() || '';
      const jsonPart2 = sheet.getRange(rowNum, 4).getValue() || '';
      const jsonPart3 = sheet.getRange(rowNum, 5).getValue() || '';
      let jsonStr = concatenateJsonChunks(jsonPart1, jsonPart2, jsonPart3);
      if (!jsonStr || jsonStr.length === 0) jsonStr = String(jsonPart1 || '').trim();
      if (!jsonStr || !jsonStr.startsWith('{')) return { success: false, error: 'Invalid JSON data for record' };

      const jsonData = JSON.parse(jsonStr);
      jsonData.contractFullyExecuted = true;
      jsonData.adminSignedDate = new Date().toISOString();

      const updatedJsonStr = JSON.stringify(jsonData);
      const updatedChunks = splitJsonString(updatedJsonStr);
      sheet.getRange(rowNum, 3, 1, 3).setValues([[updatedChunks[0] || '', updatedChunks[1] || '', updatedChunks[2] || '']]);
      SpreadsheetApp.flush();

      Logger.log('✅ Contract marked as fully executed: ' + id);
      return { success: true, message: 'Contract marked as fully executed', id: id, adminSignedDate: jsonData.adminSignedDate };
    }
    return { success: false, error: 'Record not found: ' + id };
  } catch (error) {
    Logger.log('❌ markContractExecuted error: ' + error.toString());
    return { success: false, error: error.toString() };
  }
}

/**
 * One-time maintenance helper for a clean restart.
 *
 * What it does:
 * 1) Invoices => always treated as final (no signature workflow):
 *    - approvalStatus = Approved
 *    - customerSigned/adminSigned/contractFullyExecuted = true
 *    - invoiceStatus = Finalized
 * 2) Stale estimates that are customer-approved but not admin-executed are reset
 *    to awaiting-customer-approval so old queue items disappear.
 *
 * Run manually from Apps Script editor once, then redeploy.
 */
function oneTimeResetApprovalDataForFreshStart() {
  try {
    const spreadsheet = SpreadsheetApp.openById(SPREADSHEET_ID);
    const sheet = spreadsheet.getSheetByName(INVOICES_ESTIMATES_SHEET);
    if (!sheet) return { success: false, error: 'Sheet not found: ' + INVOICES_ESTIMATES_SHEET };

    enforce8ColumnStructure(sheet);
    ensureInvoicesEstimatesNineColumns(sheet);

    const lastRow = sheet.getLastRow();
    if (lastRow < 2) return { success: true, message: 'No rows to process', updatedRows: 0 };

    const sheetCols = sheet.getLastColumn();
    const is8Column = (sheetCols >= 8);
    const idCol = is8Column ? 2 : 1;
    const json1Col = is8Column ? 4 : 3;
    const json2Col = is8Column ? 5 : 4;
    const json3Col = is8Column ? 6 : 5;

    let updatedRows = 0;
    let invoicesNormalized = 0;
    let estimatesReset = 0;

    for (let rowNum = 2; rowNum <= lastRow; rowNum++) {
      const rowId = String(sheet.getRange(rowNum, idCol).getValue() || '').trim();
      if (!rowId) continue;

      const jsonPart1 = sheet.getRange(rowNum, json1Col).getValue() || '';
      const jsonPart2 = sheet.getRange(rowNum, json2Col).getValue() || '';
      const jsonPart3 = sheet.getRange(rowNum, json3Col).getValue() || '';
      let jsonStr = concatenateJsonChunks(jsonPart1, jsonPart2, jsonPart3);
      if (!jsonStr || jsonStr.length === 0) jsonStr = String(jsonPart1 || '').trim();
      if (!jsonStr || !jsonStr.startsWith('{')) continue;

      try {
        const jsonData = JSON.parse(jsonStr);
        const typeNorm = normalizeInvoiceEstimateType(jsonData.type || 'Estimate');
        let changed = false;

        if (typeNorm === 'Invoice' || typeNorm === 'Snow Removal') {
          if (jsonData.approvalStatus !== 'Approved') { jsonData.approvalStatus = 'Approved'; changed = true; }
          if (jsonData.customerSigned !== true) { jsonData.customerSigned = true; changed = true; }
          if (jsonData.adminSigned !== true) { jsonData.adminSigned = true; changed = true; }
          if (jsonData.contractFullyExecuted !== true) { jsonData.contractFullyExecuted = true; changed = true; }
          if (!jsonData.adminSignedDate) { jsonData.adminSignedDate = new Date().toISOString(); changed = true; }
          if (!jsonData.invoiceStatus || String(jsonData.invoiceStatus).trim() === '') { jsonData.invoiceStatus = 'Finalized'; changed = true; }
          if (!jsonData.status || String(jsonData.status).toLowerCase() === 'draft') { jsonData.status = 'Final'; changed = true; }
          if (changed) invoicesNormalized++;
        } else if (typeNorm === 'Estimate') {
          const approved = String(jsonData.approvalStatus || '').toLowerCase() === 'approved';
          const adminExecuted = estimateAdminFullyExecuted_(jsonData);
          // Reset old approved-but-not-executed estimates so queue starts fresh.
          if (approved && !adminExecuted) {
            jsonData.approvalStatus = 'Pending';
            jsonData.status = 'Pending';
            jsonData.customerSigned = false;
            jsonData.adminSigned = false;
            jsonData.signatureData = '';
            jsonData.signatureUrl = '';
            jsonData.printedName = '';
            jsonData.approvalDate = null;
            changed = true;
            estimatesReset++;
          }
        }

        if (changed) {
          const updatedJsonStr = JSON.stringify(jsonData);
          const updatedChunks = splitJsonString(updatedJsonStr);
          sheet.getRange(rowNum, json1Col, 1, 3).setValues([[updatedChunks[0] || '', updatedChunks[1] || '', updatedChunks[2] || '']]);
          updatedRows++;
        }
      } catch (parseErr) {
        Logger.log('oneTimeResetApprovalDataForFreshStart parse error row ' + rowNum + ': ' + parseErr.toString());
      }
    }

    SpreadsheetApp.flush();
    return {
      success: true,
      message: 'One-time approval reset completed',
      updatedRows: updatedRows,
      invoicesNormalized: invoicesNormalized,
      estimatesReset: estimatesReset
    };
  } catch (error) {
    Logger.log('oneTimeResetApprovalDataForFreshStart error: ' + error.toString());
    return { success: false, error: error.toString() };
  }
}

