    const data = sheet.getDataRange().getValues();
    if (data.length < 2) {
      return { success: true, payments: [], message: 'No payments recorded' };
    }
    
    const payments = [];
    for (let i = 1; i < data.length; i++) {
      if (String(data[i][1]) === String(invoiceId)) {
        payments.push({
          date: data[i][0],
          invoiceId: data[i][1],
