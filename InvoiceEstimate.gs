  var textBody = 'Balance Breakdown — ' + String(breakdown.projectId || '') + '\n'
    + 'Customer: ' + String(breakdown.customerName || '') + '\n'
    + 'Total Contract: $' + money2_(breakdown.totalContract).toFixed(2) + '\n'
    + 'Total Paid: $' + money2_(breakdown.totalPaid).toFixed(2) + '\n'
    + 'Balance Due: $' + money2_(breakdown.totalOwed).toFixed(2) + '\n';

  return { subject: subject, htmlBody: htmlBody, textBody: textBody };
}

function getProjectBalanceBreakdownPreview(projectId, toEmail, linkedId) {
  try {
    var breakdown = getProjectBalanceBreakdown(projectId, linkedId);
    if (!breakdown || !breakdown.success) return breakdown || { success: false, error: 'Failed to build breakdown' };

    var rendered = renderProjectBalanceBreakdownEmail_(breakdown);
    var to = String(toEmail || breakdown.customerEmail || '').trim();

    return {
      success: true,
      projectId: projectId,
      toEmail: to,
      subject: rendered.subject,
      htmlBody: rendered.htmlBody,
      textBody: rendered.textBody,
      summary: {
        totalContract: breakdown.totalContract,
        totalPaid: breakdown.totalPaid,
        totalOwed: breakdown.totalOwed,
        milestones: Array.isArray(breakdown.rows) ? breakdown.rows.length : 0
      }
    };
  } catch (error) {
    Logger.log('getProjectBalanceBreakdownPreview error: ' + error.toString());
    return { success: false, error: error.toString() };
  }
}

function sendProjectBalanceBreakdown(projectId, toEmail, linkedId) {
  try {
    var preview = getProjectBalanceBreakdownPreview(projectId, toEmail, linkedId);
    if (!preview || !preview.success) return preview || { success: false, error: 'Failed to build preview' };
    var to = String(preview.toEmail || '').trim();
    if (!to) return { success: false, error: 'No destination email provided' };

    MailApp.sendEmail({
      to: to,
      subject: preview.subject,
      htmlBody: preview.htmlBody,
      body: preview.textBody
    });

    return {
      success: true,
      sentTo: to,
      projectId: projectId,
      totalOwed: preview.summary ? preview.summary.totalOwed : null
    };
  } catch (error) {
    Logger.log('sendProjectBalanceBreakdown error: ' + error.toString());
    return { success: false, error: error.toString() };
  }
}

