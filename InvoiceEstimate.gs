/**
 * Generate a link to open the contract signing modal in the Contract System
 * The Contract System is hosted at: www.aqualitypoolcompanyusa.com/contract-system
 */
function getContractSigningLink(invoiceId, email) {
  try {
    // Get invoice details
    const invoiceData = getInvoiceById(invoiceId);
    if (!invoiceData || !invoiceData.success) {
      return { success: false, error: 'Invoice not found' };
    }
    
    const invoice = invoiceData.invoice || {};
    const contractSystemUrl = 'https://www.aqualitypoolcompanyusa.com/contract-system';
    
    // Build the signing link with parameters
    const signingLink = contractSystemUrl + '?'
      + 'action=sign'
      + '&invoiceId=' + encodeURIComponent(invoiceId)
      + '&email=' + encodeURIComponent(email || invoice.customerEmail || '')
      + '&amount=' + encodeURIComponent(invoice.total || 0)
      + '&customerName=' + encodeURIComponent(invoice.customerName || '');
    
    return {
      success: true,
      link: signingLink,
      invoiceId: invoiceId,
      email: email || invoice.customerEmail
    };
  } catch (error) {
    Logger.log('Error generating contract signing link: ' + error.toString());
    return { success: false, error: error.toString() };
  }
}

/**
 * Generate a link to view the contract in the Contract System
 */
function getContractViewLink(invoiceId, email) {
  try {
    const invoiceData = getInvoiceById(invoiceId);
    if (!invoiceData || !invoiceData.success) {
      return { success: false, error: 'Invoice not found' };
    }
    
    const invoice = invoiceData.invoice || {};
    const contractSystemUrl = 'https://www.aqualitypoolcompanyusa.com/contract-system';
    
    // Build the view link with parameters
    const viewLink = contractSystemUrl + '?'
      + 'action=view'
      + '&invoiceId=' + encodeURIComponent(invoiceId)
      + '&email=' + encodeURIComponent(email || invoice.customerEmail || '')
      + '&token=' + encodeURIComponent(invoice.approvalToken || '');
    
    return {
      success: true,
      link: viewLink,
      invoiceId: invoiceId,
      email: email || invoice.customerEmail
    };
  } catch (error) {
    Logger.log('Error generating contract view link: ' + error.toString());
    return { success: false, error: error.toString() };
  }
}

