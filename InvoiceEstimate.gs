/**
 * Load appointments from Appointments sheet for scheduling UI
 */
function loadAppointments(userEmail) {
  try {
    Logger.log('Loading appointments for user: ' + userEmail);
    
    const spreadsheet = SpreadsheetApp.openById(SPREADSHEET_ID);
    const appointmentsSheet = spreadsheet.getSheetByName('Appointments');
    
    if (!appointmentsSheet) {
      Logger.log('Appointments sheet not found, returning empty array');
      return { success: true, appointments: [] };
    }
    
    const values = appointmentsSheet.getDataRange().getValues();
    if (values.length <= 1) {
      Logger.log('No appointment data found');
      return { success: true, appointments: [] };
    }
    
    const headers = values[0];
    const appointments = [];
    
    // Convert sheet data to appointment objects
    for (let i = 1; i < values.length; i++) {
      const row = values[i];
      const appointment = {};
      
      // Map each column to appointment properties
      for (let j = 0; j < headers.length; j++) {
        const header = headers[j];
        let value = row[j];
        
        // Convert dates if needed
        if ((header.toLowerCase().includes('date') || header.toLowerCase().includes('time')) && value instanceof Date) {
          value = value.toISOString();
        }
        
        appointment[header] = value;
      }
      
      // Only include appointments that have a status
      if (appointment.Status && appointment.Status.toString().trim() !== '') {
        appointments.push(appointment);
      }
    }
    
    Logger.log('Loaded ' + appointments.length + ' appointments');
    return { success: true, appointments: appointments };
    
  } catch (error) {
    Logger.log('Error loading appointments: ' + error.toString());
    return { success: false, error: error.toString(), appointments: [] };
  }
}

/**
 * Create a single invoice containing multiple payment schedule milestones
 * @param {string} projectId - The project ID
 * @param {array} milestoneIds - Array of milestone IDs to include in the invoice
 * @param {string} invoiceTitle - Custom title for the bundled invoice (optional)
 * @returns {object} { success, invoiceId, error }
 */
function createMultiMilestoneInvoice(projectId, milestoneIds, invoiceTitle) {
  try {
    if (!projectId || !milestoneIds || !Array.isArray(milestoneIds) || milestoneIds.length === 0) {
      return { 
        success: false, 
        error: 'Invalid projectId or milestoneIds. Must provide projectId and non-empty array of milestone IDs.' 
      };
    }

    // Get project data
    const projectResult = getProject(projectId);
    if (!projectResult.success) {
      return { success: false, error: 'Project not found: ' + projectId };
    }

    const projectData = projectResult.project;
    const paymentSchedule = projectData.paymentSchedule || [];
    
    if (typeof paymentSchedule === 'string') {
      try { paymentSchedule = JSON.parse(paymentSchedule); } catch(e) { }
    }

    // Find all milestones matching the provided IDs
    const selectedMilestones = [];
    let totalAmount = 0;

    milestoneIds.forEach(function(milestoneId) {
      const milestone = paymentSchedule.find(m => String(m.id || '') === String(milestoneId || ''));
      if (milestone) {
        selectedMilestones.push(milestone);
        totalAmount += parseFloat(milestone.amount || 0);
      } else {
        Logger.log('⚠️ Milestone not found: ' + milestoneId);
      }
    });

    if (selectedMilestones.length === 0) {
      return { success: false, error: 'No valid milestones found for the provided milestone IDs' };
    }

    // Create line items for each milestone
    const lineItems = selectedMilestones.map(function(milestone, index) {
      return {
        id: String(milestone.id || index),
        name: String(milestone.name || 'Payment Milestone'),
        description: 'Project: ' + projectId + ' | Milestone: ' + String(milestone.name || 'Unnamed'),
        quantity: 1,
        price: parseFloat(milestone.amount || 0),
        amount: parseFloat(milestone.amount || 0)
      };
    });

    // Create invoice data object
    const invoiceData = {
      type: 'Invoice',
      customerEmail: projectData.customerEmail,
      customerName: projectData.customerName,
      customerPhone: projectData.customerPhone || '',
      customerAddress: projectData.customerAddress || '',
      customerCity: projectData.customerCity || '',
      customerState: projectData.customerState || '',
      customerZip: projectData.customerZip || '',
      items: lineItems,
      total: totalAmount,
      notes: invoiceTitle ? 'Invoice: ' + invoiceTitle + '\n\nMultiple payment milestones consolidated into single invoice.' : 'Multiple payment milestones consolidated into single invoice.',
      companyName: COMPANY_NAME,
      companyEmail: COMPANY_EMAIL,
      projectId: projectId,
      linkedMilestoneIds: milestoneIds, // Track which milestones are included
      multiMilestone: true // Flag to indicate this is a multi-milestone invoice
    };

    // Save invoice using existing saveInvoiceEstimate function
    const saveResult = saveInvoiceEstimate(invoiceData);
    
    if (!saveResult.success) {
      return { success: false, error: 'Failed to save invoice: ' + (saveResult.error || 'Unknown error') };
    }

    // Store reference to this consolidated invoice in the project
    const projectUpdate = {
      lastMultiMilestoneInvoiceId: saveResult.documentId || saveResult.id,
      lastMultiMilestoneInvoiceDate: new Date().toISOString(),
      lastMultiMilestoneInvoiceMilestones: milestoneIds.join(',')
    };

    updateProject(projectId, projectUpdate);

    Logger.log('✅ Multi-milestone invoice created successfully');
    Logger.log('   Invoice ID: ' + (saveResult.documentId || saveResult.id));
    Logger.log('   Milestones: ' + milestoneIds.join(', '));
    Logger.log('   Total Amount: $' + totalAmount.toFixed(2));

    return {
      success: true,
      invoiceId: saveResult.documentId || saveResult.id,
      totalAmount: totalAmount,
      milestonesIncluded: selectedMilestones.length
    };

  } catch (error) {
    Logger.log('❌ Error creating multi-milestone invoice: ' + error.toString());
    return { success: false, error: error.toString() };
  }
}

/**
 * Get payment milestones for a project with optional filtering
 * Useful for UI to display available milestones for bundling
 * @param {string} projectId - The project ID
 * @param {boolean} unpaidOnly - If true, only return unpaid milestones
 * @returns {object} { success, milestones, totalUnpaid, error }
 */
function getProjectMilestonesForBundling(projectId, unpaidOnly) {
  try {
    const projectResult = getProject(projectId);
    if (!projectResult.success) {
      return { success: false, error: 'Project not found: ' + projectId };
    }

    const projectData = projectResult.project;
    const paymentSchedule = projectData.paymentSchedule || [];
    
    if (typeof paymentSchedule === 'string') {
      try { paymentSchedule = JSON.parse(paymentSchedule); } catch(e) { }
    }

    // Get milestone status to check payment status
    const statusResult = getMilestoneStatusFromHistory(projectId);
    const milestoneStatus = (statusResult.success ? statusResult.milestones : {}) || {};

    // Filter and format milestones
    const milestones = paymentSchedule
      .filter(function(milestone) {
        if (!unpaidOnly) return true;
        const status = milestoneStatus[String(milestone.id)] || {};
        return !status.paid; // Return only unpaid
      })
      .map(function(milestone) {
        const status = milestoneStatus[String(milestone.id)] || {};
        return {
          id: milestone.id,
          name: milestone.name,
          amount: parseFloat(milestone.amount || 0),
          dueDate: milestone.dueDate || '',
          paid: status.paid || false,
          paidAmount: status.amount || 0,
          paidDate: status.date || null
        };
      });

    const totalUnpaid = milestones
      .filter(m => !m.paid)
      .reduce(function(sum, m) { return sum + m.amount; }, 0);

    Logger.log('✅ Retrieved ' + milestones.length + ' milestones for project ' + projectId);
    if (unpaidOnly) {
      Logger.log('   Unpaid total: $' + totalUnpaid.toFixed(2));
    }

    return {
      success: true,
      milestones: milestones,
      totalUnpaid: totalUnpaid,
      projectName: projectData.projectName,
      customerEmail: projectData.customerEmail,
      customerName: projectData.customerName
    };

  } catch (error) {
    Logger.log('❌ Error getting project milestones: ' + error.toString());
    return { success: false, error: error.toString() };
  }
}

/**
 * PAYMENT ALLOCATION SYSTEM
 * Allows assigning payments to specific milestones or leaving them unallocated
 * Tracks allocations separately from milestone status — no auto-rebalancing
 */

/**
 * Record a payment allocation (milestone-specific or unallocated)
 * @param {string} projectId - The project ID
 * @param {number} amount - Payment amount
 * @param {string} allocationType - 'milestone' or 'unallocated'
 * @param {string} milestoneId - Milestone ID (required if allocationType='milestone')
 * @param {string} description - Payment description (check #, method, etc.)
 * @param {string} date - Payment date (ISO format or Date object)
 * @param {string} paymentMethod - How it was paid (e.g., 'Check', 'ACH', 'Card')
 * @param {string} transactionId - Transaction/reference ID (optional)
 * @returns {object} { success, allocationId, error }
 */
function recordPaymentAllocation(projectId, amount, allocationType, milestoneId, description, date, paymentMethod, transactionId) {
  try {
    if (!projectId) return { success: false, error: 'Project ID required' };
    if (!amount || parseFloat(amount) <= 0) return { success: false, error: 'Amount must be > 0' };
    if (!allocationType || !['milestone', 'unallocated'].includes(allocationType)) {
      return { success: false, error: 'Allocation type must be "milestone" or "unallocated"' };
    }
    if (allocationType === 'milestone' && !milestoneId) {
      return { success: false, error: 'Milestone ID required for milestone allocation' };
    }

    const spreadsheet = SpreadsheetApp.openById(SPREADSHEET_ID);
    
    // Create/get Payment Allocations sheet - NEVER overwrite if it exists!
    let sheet = spreadsheet.getSheetByName('Payment Allocations');
    if (!sheet) {
      Logger.log('⚠️  Payment Allocations sheet not found - creating it');
      try {
        sheet = spreadsheet.insertSheet('Payment Allocations');
        const headers = [
          'Allocation ID',
          'Project ID',
          'Amount',
          'Allocation Type',
          'Milestone ID',
          'Milestone Name',
          'Description',
          'Date',
          'Payment Method',
          'Transaction ID',
          'Created Date',
          'Notes'
        ];
        sheet.getRange(1, 1, 1, headers.length).setValues([headers]);
        sheet.getRange(1, 1, 1, headers.length).setFontWeight('bold');
        sheet.getRange(1, 1, 1, headers.length).setBackground('#0369a1');
        sheet.getRange(1, 1, 1, headers.length).setFontColor('#ffffff');
        Logger.log('✅ Created Payment Allocations sheet with headers');
      } catch (e) {
        Logger.log('❌ Error creating sheet: ' + e.toString());
        return { success: false, error: 'Could not create Payment Allocations sheet: ' + e.toString() };
      }
    } else {
      Logger.log('✅ Payment Allocations sheet found - will append to it');
    }

    // Get milestone name if allocating to milestone
    let milestoneName = '';
    if (allocationType === 'milestone') {
      const projectResult = getProject(projectId);
      if (projectResult.success) {
        const paymentSchedule = projectResult.project.paymentSchedule || [];
        const schedule = typeof paymentSchedule === 'string' ? JSON.parse(paymentSchedule) : paymentSchedule;
        const milestone = schedule.find(m => String(m.id) === String(milestoneId));
        milestoneName = milestone ? milestone.name : '';
      }
    }

    // Generate allocation ID
    const allocationId = 'PA-' + String(Date.now()).slice(-8) + '-' + Math.random().toString(36).substring(2, 8).toUpperCase();
    const payDate = date ? (date instanceof Date ? date : new Date(date)) : new Date();
    const createdDate = new Date();

    // Get current row count to verify appending
    const lastRow = sheet.getLastRow();
    Logger.log('⚠️  Before append - Last row in Payment Allocations: ' + lastRow);

    // Append row
    sheet.appendRow([
      allocationId,
      projectId,
      parseFloat(amount),
      allocationType,
      allocationType === 'milestone' ? milestoneId : '',
      allocationType === 'milestone' ? milestoneName : '',
      description || '',
      payDate,
      paymentMethod || 'Manual',
      transactionId || '',
      createdDate,
      ''
    ]);

    // Verify append succeeded
    const newLastRow = sheet.getLastRow();
    Logger.log('⚠️  After append - Last row in Payment Allocations: ' + newLastRow);

    if (newLastRow <= lastRow) {
      Logger.log('❌ WARNING: Row was not appended! lastRow=' + lastRow + ', newLastRow=' + newLastRow);
      return { success: false, error: 'Failed to append allocation record to sheet' };
    }

    Logger.log('✅ Payment allocation recorded: ' + allocationId);
    Logger.log('   Type: ' + allocationType + ' | Amount: $' + amount + ' | Project: ' + projectId);
    Logger.log('   Row ' + newLastRow + ' added to Payment Allocations sheet');

    // Update milestone status if allocating to a milestone
    if (allocationType === 'milestone' && milestoneId) {
      try {
        const projectResult = getProject(projectId);
        if (projectResult.success) {
          const projectData = projectResult.project;
          
          // Ensure milestoneStatus object exists
          if (!projectData.milestoneStatus) {
            projectData.milestoneStatus = {};
          }
          
          // Initialize milestone status if not present
          const msKey = String(milestoneId);
          if (!projectData.milestoneStatus[msKey]) {
            projectData.milestoneStatus[msKey] = { paid: false };
          }
          
          // Mark milestone as paid
          projectData.milestoneStatus[msKey].paid = true;
          projectData.milestoneStatus[msKey].datePaid = payDate;
          projectData.milestoneStatus[msKey].paymentMethod = paymentMethod || 'Manual';
          projectData.milestoneStatus[msKey].transactionId = transactionId || '';
          projectData.milestoneStatus[msKey].allocationId = allocationId;
          
          // Save updated project
          updateProject(projectId, projectData);
          Logger.log('✅ Updated milestone ' + milestoneId + ' status to paid');
        }
      } catch (statusErr) {
        Logger.log('⚠️  Could not update milestone status: ' + statusErr.toString());
        // Don't fail the whole operation if status update fails
      }
    }

    return {
      success: true,
      allocationId: allocationId,
      message: 'Payment allocation recorded successfully'
    };

  } catch (error) {
    Logger.log('❌ Error recording payment allocation: ' + error.toString());
    Logger.log('   Stack: ' + error.stack);
    return { success: false, error: error.toString() };
  }
}

/**
 * Get all payment allocations for a project with balance calculations
 * @param {string} projectId - The project ID
 * @returns {object} { success, allocations, summary, error }
 */
function getPaymentAllocations(projectId) {
  try {
    if (!projectId) return { success: false, error: 'Project ID required' };

    const spreadsheet = SpreadsheetApp.openById(SPREADSHEET_ID);
    const sheet = spreadsheet.getSheetByName('Payment Allocations');
    
    if (!sheet) {
      return { success: true, allocations: [], summary: { totalPaid: 0, unallocated: 0, byMilestone: {} } };
    }

    const data = sheet.getDataRange().getValues();
    const headers = data[0] || [];
    const projIdIdx = headers.indexOf('Project ID');
    const amtIdx = headers.indexOf('Amount');
    const typeIdx = headers.indexOf('Allocation Type');
    const msIdIdx = headers.indexOf('Milestone ID');
    const msNameIdx = headers.indexOf('Milestone Name');
    const descIdx = headers.indexOf('Description');
    const dateIdx = headers.indexOf('Date');
    const methodIdx = headers.indexOf('Payment Method');
    const allocationIdIdx = headers.indexOf('Allocation ID');

    const allocations = [];
    let totalPaid = 0;
    let unallocatedTotal = 0;
    const byMilestone = {};

    for (let i = 1; i < data.length; i++) {
      const projId = String(data[i][projIdIdx] || '').trim();
      if (projId !== String(projectId).trim()) continue;

      const amt = parseFloat(data[i][amtIdx] || 0);
      const type = String(data[i][typeIdx] || '').toLowerCase();
      const msId = String(data[i][msIdIdx] || '').trim();
      const msName = String(data[i][msNameIdx] || '').trim();
      const desc = String(data[i][descIdx] || '').trim();
      const payDate = data[i][dateIdx] instanceof Date ? data[i][dateIdx].toISOString() : String(data[i][dateIdx] || '');
      const method = String(data[i][methodIdx] || 'Manual').trim();
      const allocationId = String(data[i][allocationIdIdx] || '').trim();

      allocations.push({
        allocationId: allocationId,
        amount: amt,
        type: type,
        milestoneId: msId,
        milestoneName: msName,
        description: desc,
        date: payDate,
        method: method
      });

      totalPaid += amt;

      if (type === 'milestone') {
        byMilestone[msId] = (byMilestone[msId] || 0) + amt;
      } else {
        unallocatedTotal += amt;
      }
    }

    // Get project value
    const projectResult = getProject(projectId);
    const projectValue = projectResult.success ? (projectResult.project.totalProjectValue || 0) : 0;
    const totalRemaining = projectValue - totalPaid;

    return {
      success: true,
      allocations: allocations,
      summary: {
        totalPaid: totalPaid,
        totalProjectValue: projectValue,
        totalRemaining: Math.max(0, totalRemaining),
        unallocated: unallocatedTotal,
        byMilestone: byMilestone
      }
    };

  } catch (error) {
    Logger.log('❌ Error getting payment allocations: ' + error.toString());
    return { success: false, error: error.toString() };
  }
}

/**
 * Get project balance including allocation breakdowns
 * Total remaining = total project value − total paid (always)
 * Shows what's allocated to each milestone vs unallocated
 * @param {string} projectId - The project ID
 * @returns {object} { success, balance, milestones, error }
 */
function getProjectBalanceWithAllocations(projectId) {
  try {
    if (!projectId) return { success: false, error: 'Project ID required' };

    const projectResult = getProject(projectId);
    if (!projectResult.success) {
      return { success: false, error: 'Project not found: ' + projectId };
    }

    const projectData = projectResult.project;
    const projectValue = parseFloat(projectData.totalProjectValue || 0);
    
    // Get all allocations
    const allocResult = getPaymentAllocations(projectId);
    const allocations = allocResult.success ? allocResult.allocations : [];
    const summary = allocResult.success ? allocResult.summary : { totalPaid: 0, byMilestone: {} };

    // Get payment schedule
    const paymentSchedule = projectData.paymentSchedule || [];
    const schedule = typeof paymentSchedule === 'string' ? JSON.parse(paymentSchedule) : paymentSchedule;

    // Build milestone breakdown
    const milestoneBreakdown = schedule.map(function(milestone) {
      const msId = String(milestone.id);
      const allocatedToMs = summary.byMilestone[msId] || 0;
      const msAmount = parseFloat(milestone.amount || 0);
      const remaining = Math.max(0, msAmount - allocatedToMs);

      return {
        id: msId,
        name: milestone.name,
        totalAmount: msAmount,
        allocated: allocatedToMs,
        remaining: remaining,
        dueDate: milestone.dueDate || ''
      };
    });

    // Build response
    return {
      success: true,
      balance: {
        projectValue: projectValue,
        totalPaid: summary.totalPaid,
        totalRemaining: Math.max(0, projectValue - summary.totalPaid),
        unallocatedPayments: summary.unallocated
      },
      milestones: milestoneBreakdown,
      allocations: allocations,
      summary: {
        allocationsCount: allocations.length,
        allMilestonesFullyAllocated: milestoneBreakdown.every(m => m.remaining === 0)
      }
    };

  } catch (error) {
    Logger.log('❌ Error getting project balance: ' + error.toString());
    return { success: false, error: error.toString() };
  }
}

