      Logger.log('  Processing Fee: $' + processingFee.toFixed(2));
      Logger.log('  Total Amount (originalTotal): $' + originalTotal.toFixed(2));
      Logger.log('  Amount Due Section: ' + (amountDueSection ? 'Generated' : 'Not generated'));
      if (amountDueSection) {
        Logger.log('  Amount Due Section contains: $' + total.toFixed(2));
      }
    }
    
    // Generate payment button section (hidden for daily updates)
    let paymentButtonSection = '';
    if (!isDailyUpdate) {
      paymentButtonSection = `
        <table border="0" cellpadding="0" cellspacing="0" width="100%">
          ${stripePayLink ? `
          <tr>
