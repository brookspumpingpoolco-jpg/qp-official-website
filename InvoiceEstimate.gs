      if (rowEmail === cleanEmail) {
        const companyId = data[i][companyIdCol];
        const companyName = companyNameCol !== -1 ? (data[i][companyNameCol] || 'My Company') : 'My Company';
        
        if (!companyId) {
          return { success: false, error: 'Company ID not set for this user' };
        }
        
        return { 
          success: true, 
          companyId: companyId,
          companyName: companyName,
          isAdmin: false
        };
      }
    }
    
    return { success: false, error: 'User not found' };
  } catch (error) {
    Logger.log('Error in getCompanyInfoForInvoice: ' + error);
    return { success: false, error: error.toString() };
  }
}

/**
 * Check if user is an admin
 */
function isAdmin(email) {
  if (!email) return false;
  const cleanEmail = email.toString().toLowerCase().trim();
  return cleanEmail === 'samr@aqualitypoolcompanyusa.com';
}

/**
 * Serve the HTML interface
 */
/**
 * Helper function to create JSON response with proper CORS headers
 * This allows the Netlify-hosted frontend to access the Google Apps Script
 */
function createCorsResponse(data) {
  return ContentService.createTextOutput(JSON.stringify(data))
    .setMimeType(ContentService.MimeType.JSON);
}

/**
 * Normalize Invoice / Estimate type from UI or saved JSON ("estimate", "Estimate", etc.)
 * so email copy and logic never fall through to invoice wording by mistake.
 */
function normalizeInvoiceEstimateType(type) {
  if (type === undefined || type === null) return 'Invoice';
  var t = String(type).trim();
  if (!t) return 'Invoice';
  var low = t.toLowerCase();
  if (low === 'estimate') return 'Estimate';
  if (low === 'invoice') return 'Invoice';
  // Snow Removal and similar billable doc types behave as invoices in viewer / email
  if (low === 'snow removal' || low === 'snow-removal') return 'Invoice';
  return t;
}

/**
 * Public link for customers:
 * - estimates with approval token -> Netlify estimate viewer
 * - invoices and non-token links -> Webflow invoice viewer
 */
function getCustomerViewerWebflowUrl(documentType, documentId, approvalToken) {
  var id = documentId != null ? String(documentId).trim() : '';
  if (!id) return NETLIFY_ESTIMATE_VIEWER_URL;
  var tok = approvalToken != null ? String(approvalToken).trim() : '';
  var isEstimate = normalizeInvoiceEstimateType(documentType) === 'Estimate';
  // For estimates with approval tokens, use Netlify viewer (has proper approval flow)
  // For invoices, use Webflow viewer (invoice-viewer)
  var base = isEstimate ? NETLIFY_ESTIMATE_VIEWER_URL : WEBFLOW_INVOICE_VIEWER_URL;
  var url = base + '?id=' + encodeURIComponent(id);
  // Only append token for estimate approval flow.
  // Invoice links should be ID-based to avoid unnecessary token validation failures.
  if (isEstimate && tok) {
    url += '&token=' + encodeURIComponent(tok);
  }
  return url;
}

