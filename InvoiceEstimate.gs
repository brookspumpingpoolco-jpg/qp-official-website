          Logger.log('✅ Enhanced invoice email sent successfully to ' + (emailResult.email || data.customerEmail));
        }
      } catch (error) {
        Logger.log('❌ Error in sendEnhancedInvoiceEmail: ' + error.toString());
        Logger.log('Error stack: ' + (error.stack || 'No stack trace'));
