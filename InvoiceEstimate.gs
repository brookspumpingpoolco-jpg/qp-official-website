    // Determine display amount (balance if payment received, otherwise total)
    // IMPORTANT: total already includes processing fee, so displayAmount will include it
    const displayAmount = paymentReceived > 0 ? (isPaidInFull ? '✓ Paid in Full' : '$' + balance.toFixed(2)) : '$' + total.toFixed(2);
    const displayAmountColor = isPaidInFull ? '#10b981' : '#0369a1';
    
    Logger.log('💰 Display amount (includes processing fee): ' + displayAmount);
    
    // Generate amount due section (matches preview format exactly)
    // If paymentInfoHtml exists (cash payment), it already includes the payment info
    // So amountDueSection should only show the amount due when no payment received
    // IMPORTANT: Use total (which includes processing fee) for amount due
    let amountDueSection = '';
    if (paymentReceived === 0) {
      var amountDueLabel = isEstimateDoc ? 'Estimate total' : 'Amount due';
      Logger.log('💰 Amount section - Using total: $' + total.toFixed(2) + ' (includes processing fee: $' + processingFee.toFixed(2) + ')');
      amountDueSection = `
        <div style="margin-top: 16px; padding-top: 16px; border-top: 2px solid #0369a1;">
