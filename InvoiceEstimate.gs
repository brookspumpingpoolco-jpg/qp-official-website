          paymentMethod: data[i][4],
          transactionId: data[i][5],
          status: data[i][6],
          notes: data[i][7]
        });
      }
    }
    
    return { success: true, payments: payments };
  } catch (error) {
    Logger.log('Error getting payment records: ' + error.toString());
    return { success: false, error: error.toString() };
  }
}

/**
 * Get all approved estimates (projects)
 */
function getApprovedEstimates() {
  try {
    const spreadsheet = SpreadsheetApp.openById(SPREADSHEET_ID);
    const sheet = spreadsheet.getSheetByName(INVOICES_ESTIMATES_SHEET);
    
    if (!sheet) {
      return { success: false, error: 'Sheet not found' };
    }
    
    const lastRow = sheet.getLastRow();
    if (lastRow < 2) {
      return { success: true, projects: [] };
    }
    
    const projects = [];
    
    // Read all rows
    for (let rowNum = 2; rowNum <= lastRow; rowNum++) {
      try {
        const companyId = sheet.getRange(rowNum, 1).getValue();
        const id = sheet.getRange(rowNum, 2).getValue();
        const customerEmail = sheet.getRange(rowNum, 3).getValue();
        
        // Read JSON data
        const jsonPart1 = sheet.getRange(rowNum, 4).getValue() || '';
        const jsonPart2 = sheet.getRange(rowNum, 5).getValue() || '';
        const jsonPart3 = sheet.getRange(rowNum, 6).getValue() || '';
        const jsonStr = concatenateJsonChunks(jsonPart1, jsonPart2, jsonPart3);
        
        if (jsonStr && jsonStr.startsWith('{')) {
          const data = JSON.parse(jsonStr);
          
          // Only include approved estimates
          if (data.type === 'Estimate' && data.status === 'Approved') {
            // Calculate total
            const items = JSON.parse(data.items || '[]');
            const subtotal = items.reduce((sum, item) => sum + (parseFloat(item.quantity || 0) * parseFloat(item.price || 0)), 0);
            const taxRate = parseFloat(data.taxRate || 0);
            const taxAmount = subtotal * (taxRate / 100);
            const discount = parseFloat(data.discount || 0);
            const total = subtotal + taxAmount - discount;
            
            // Get payment info from Payment History
            const paymentsReceived = getPaymentsForInvoice(id);
            const totalPaid = paymentsReceived.reduce((sum, p) => sum + parseFloat(p.amount || 0), 0);
            const balance = total - totalPaid;
            
            projects.push({
              id: id,
              companyId: companyId,
              customerName: data.customerName,
              customerEmail: customerEmail,
              quoteNumber: data.quoteNumber || id,
              date: data.date,
              total: total,
              totalPaid: totalPaid,
              balance: balance,
              status: balance <= 0.01 ? 'Paid' : (totalPaid > 0 ? 'Partial' : 'Unpaid'),
              contractPdfUrl: data.contractPdfUrl || '',
              signatureUrl: data.signatureUrl || '',
              items: items.length,
              projectDescription: items[0]?.description || 'Project'
            });
          }
        }
      } catch (error) {
        Logger.log('Error processing row ' + rowNum + ': ' + error.toString());
      }
    }
    
    // Sort by date (newest first)
    projects.sort((a, b) => new Date(b.date) - new Date(a.date));
    
    Logger.log('Found ' + projects.length + ' approved estimates');
    return { success: true, projects: projects };
    
  } catch (error) {
    Logger.log('Error getting approved estimates: ' + error.toString());
    return { success: false, error: error.toString() };
  }
}

/**
 * Get detailed project information
 */
function getProjectDetails(id) {
  try {
    // First, try to get as a project (from PM_Projects sheet)
    const projectResult = getProject(id);
    if (projectResult.success) {
      const projectData = projectResult.project || {};
      const linkedId = projectData.estimateId || projectData.invoiceId || projectData.linkedEstimateId || '';

      // Ensure project line items are always available for Project Details.
      let normalizedItems = [];
      try {
        const rawItems = projectData.items;
        if (Array.isArray(rawItems)) {
          normalizedItems = rawItems;
        } else if (typeof rawItems === 'string' && rawItems.trim()) {
          normalizedItems = JSON.parse(rawItems);
        }
      } catch (itemParseErr) {
        Logger.log('getProjectDetails item parse warning: ' + itemParseErr.toString());
      }
      if ((!Array.isArray(normalizedItems) || normalizedItems.length === 0) && linkedId) {
        try {
          const linkedDoc = getInvoiceEstimate(linkedId);
          if (linkedDoc && linkedDoc.success && linkedDoc.data && linkedDoc.data.items) {
            const linkedItems = typeof linkedDoc.data.items === 'string'
              ? JSON.parse(linkedDoc.data.items || '[]')
              : (Array.isArray(linkedDoc.data.items) ? linkedDoc.data.items : []);
            if (Array.isArray(linkedItems) && linkedItems.length > 0) {
              normalizedItems = linkedItems;
            }
          }
        } catch (linkedErr) {
          Logger.log('getProjectDetails linked items warning: ' + linkedErr.toString());
        }
      }
      projectData.items = Array.isArray(normalizedItems) ? normalizedItems : [];

      // One-offs for linked estimates/invoices: ONLY Invoices & Estimates column I — never PM_Project_Invoices col C / PM JSON one-offs for display
      var col9OneOffs = [];
      try {
        col9OneOffs = linkedId ? getInvoiceColumn9OneOffItems(linkedId) : [];
      } catch (col9Err) {
        Logger.log('getProjectDetails col9: ' + col9Err.toString());
      }
      if (!Array.isArray(col9OneOffs)) col9OneOffs = [];

      var nonOneOffItems = (projectData.items || []).filter(function(it) {
        return !it.isOneOff;
      });
      
      // Merge project one-offs with column 9 one-offs (deduped by trackingId)
      var projectOneOffs = (projectData.items || []).filter(function(it) {
        return it.isOneOff === true;
      });
      
      // Combine col9 and project one-offs, removing duplicates by trackingId
      var allOneOffs = col9OneOffs.concat(projectOneOffs);
      var seenTrackingIds = {};
      var dedupedOneOffs = [];
      allOneOffs.forEach(function(item) {
        var tid = String(item.oneOffTrackingId || '').trim();
        if (tid && seenTrackingIds[tid]) return; // skip duplicate
        if (tid) seenTrackingIds[tid] = true;
        dedupedOneOffs.push(item);
      });
      
      projectData.items = nonOneOffItems.concat(dedupedOneOffs);

      // Payment schedule: combine project one-offs with col9-derived one-offs
      var schedule = projectData.paymentSchedule || [];
      if (typeof schedule === 'string') {
        try {
          schedule = JSON.parse(schedule);
        } catch (e) {
          schedule = [];
        }
      }
      if (!Array.isArray(schedule)) schedule = [];
      var regularMilestones = schedule.filter(function(m) {
        return m.type !== 'one-off';
      });
      var projectOneOffMilestones = schedule.filter(function(m) {
        return m.type === 'one-off';
      });

      // Build one-off milestones from dedupedOneOffs (items), merging with project's stored one-off milestones
      if (dedupedOneOffs.length > 0) {
        var shareLink = linkedId
          ? (WEBFLOW_INVOICE_VIEWER_URL + '?id=' + encodeURIComponent(linkedId))
          : '';
        var oneOffMilestones = [];
        
        // Add all dedupedOneOffs as milestones, using project one-offs as source of truth for Stripe URLs
        dedupedOneOffs.forEach(function(item, idx) {
          var tid = String(item.oneOffTrackingId || '').trim();
          
          // Try to find existing project milestone for this tracking ID
          var existingMilestone = projectOneOffMilestones.find(function(m) {
            return String(m.trackingId || '').trim() === tid;
          });
          
          var amt = parseFloat(
            item.total != null && item.total !== ''
              ? item.total
              : parseFloat(item.quantity || 1) * parseFloat(item.price || 0)
          );
          var stripeUrl = tid ? getPMStripeUrlByTrackingId(tid) : '';
          var sid = tid ? 'one-off-' + tid.replace(/[^a-zA-Z0-9_-]/g, '_') : 'one-off-col9-' + idx;
          
          oneOffMilestones.push({
            id: sid,
            name: item.name || item.description || 'One-off',
            amount: amt,
            percent: 0,
            type: 'one-off',
            trackingId: tid,
            stripePaymentUrl: stripeUrl,
            shareLink: existingMilestone ? (existingMilestone.shareLink || shareLink) : shareLink,
            notes: item.description && item.description !== item.name ? item.description : '',
            paid: existingMilestone ? existingMilestone.paid : false
          });
        });
        
        projectData.paymentSchedule = regularMilestones.concat(oneOffMilestones);
      } else {
        projectData.paymentSchedule = regularMilestones.concat(projectOneOffMilestones);
      }

      // Add "next payment" context for UI display.
      schedule = projectData.paymentSchedule;

      const milestoneStatusMap = projectData.milestoneStatus || {};
      let historyMilestones = {};
      try {
        if (typeof getMilestoneStatusFromHistory === 'function') {
          const hist = getMilestoneStatusFromHistory(id, linkedId);
          if (hist && hist.success) {
            historyMilestones = hist.milestones || {};
          }
        }
      } catch (histErr) {
        Logger.log('getProjectDetails history lookup warning: ' + histErr.toString());
      }
      const nextMilestone = schedule.find(function(ms) {
        const key = String(ms.id || '');
        const fromHistory = historyMilestones[key] && historyMilestones[key].paid === true;
        const fromProject = milestoneStatusMap[key] && milestoneStatusMap[key].paid === true;
        return !(fromHistory || fromProject);
      }) || null;
      projectData.nextMilestoneName = nextMilestone ? (nextMilestone.name || '') : '';

      let totalExpenses = 0;
      try {
        if (typeof getProjectExpenses === 'function') {
          const expResult = getProjectExpenses(id);
          if (expResult && expResult.success) totalExpenses = parseFloat(expResult.total || 0);
        }
      } catch (e) {
        Logger.log('getProjectDetails getProjectExpenses: ' + (e && e.toString()));
      }
      const totalValue = parseFloat(
        projectData.totalValue != null ? projectData.totalValue : projectData.total != null ? projectData.total : projectResult.totalValue || 0
      );
      const profit = totalValue - totalExpenses;
      const profitMarginPct = totalValue > 0 ? (profit / totalValue) * 100 : 0;
      return {
        success: true,
        project: projectData,
        projectId: projectResult.projectId || projectData.projectId,
        customerEmail: projectResult.customerEmail || projectData.customerEmail,
        status: projectResult.status != null && projectResult.status !== '' ? projectResult.status : projectData.status,
        totalValue: totalValue,
        totalExpenses: totalExpenses,
        profit: profit,
        profitMargin: projectResult.profitMargin,
        profitMarginPct: profitMarginPct
      };
    }
    
    // If not found as project, try as invoice/estimate
    const result = getInvoiceEstimate(id);
    if (!result.success) {
      return result;
    }
    
    const estimate = result.data;
    
    // Calculate totals
    const items = JSON.parse(estimate.items || '[]');
    const subtotal = items.reduce((sum, item) => sum + (parseFloat(item.quantity || 0) * parseFloat(item.price || 0)), 0);
    const taxRate = parseFloat(estimate.taxRate || 0);
    const taxAmount = subtotal * (taxRate / 100);
    const discount = parseFloat(estimate.discount || 0);
    const total = subtotal + taxAmount - discount;
    
    // Get payment history
    const payments = getPaymentsForInvoice(id);
    const totalPaid = payments.reduce((sum, p) => sum + parseFloat(p.amount || 0), 0);
    const balance = total - totalPaid;
    
    // Get related invoices (invoices created from this estimate)
    const relatedInvoices = getInvoicesForEstimate(id);
    
    return {
      success: true,
      project: {
        ...estimate,
        total: total,
        totalPaid: totalPaid,
        balance: balance,
        payments: payments,
        relatedInvoices: relatedInvoices,
        contractFullyExecuted: estimate.contractFullyExecuted || false,
        adminSignedDate: estimate.adminSignedDate || null,
        signatureUrl: estimate.signatureUrl || null,
        contractPdfUrl: estimate.contractPdfUrl || null
      }
    };
    
  } catch (error) {
    Logger.log('Error getting project details: ' + error.toString());
    return { success: false, error: error.toString() };
  }
}

/**
 * Get liner job metrics: count and total value of Liner Job estimates/invoices.
 */
function getLinerJobMetrics() {
  try {
    const spreadsheet = SpreadsheetApp.openById(SPREADSHEET_ID);
    const sheet = spreadsheet.getSheetByName(INVOICES_ESTIMATES_SHEET);
    if (!sheet) {
      return { success: true, count: 0, totalValue: 0 };
    }
    const lastRow = sheet.getLastRow();
    if (lastRow < 2) {
      return { success: true, count: 0, totalValue: 0 };
    }
    const sheetCols = sheet.getLastColumn();
    const is8Column = (sheetCols >= 8);
    const json1Col = is8Column ? 4 : 3;
    const json2Col = is8Column ? 5 : 4;
    const json3Col = is8Column ? 6 : 5;
    let count = 0;
    let totalValue = 0;
    for (let rowNum = 2; rowNum <= lastRow; rowNum++) {
      try {
        const jsonPart1 = sheet.getRange(rowNum, json1Col).getValue() || '';
        const jsonPart2 = sheet.getRange(rowNum, json2Col).getValue() || '';
        const jsonPart3 = sheet.getRange(rowNum, json3Col).getValue() || '';
        let jsonStr = concatenateJsonChunks(jsonPart1, jsonPart2, jsonPart3);
        if (!jsonStr || !jsonStr.startsWith('{')) continue;
        const data = JSON.parse(jsonStr);
        const projectType = (data.projectType || '').toString().trim();
        if (projectType !== 'Liner Job' && projectType !== 'Liner') continue;
        count++;
        const items = JSON.parse(data.items || '[]');
        const subtotal = items.reduce(function(sum, item) {
          return sum + (parseFloat(item.quantity || 0) * parseFloat(item.price || 0));
        }, 0);
        const taxRate = parseFloat(data.taxRate || 0);
        const taxAmount = subtotal * (taxRate / 100);
        const discount = parseFloat(data.discount || 0);
        totalValue += subtotal + taxAmount - discount;
      } catch (e) {
        // skip row
      }
    }
    return { success: true, count: count, totalValue: Math.round(totalValue * 100) / 100 };
  } catch (error) {
    Logger.log('Error in getLinerJobMetrics: ' + error.toString());
    return { success: false, error: error.toString(), count: 0, totalValue: 0 };
  }
}

/**
 * Get purchase orders linked to a project from the Purchase_Orders accounting sheet.
 * Returns empty list if the sheet doesn't exist yet (accounting app not deployed).
 */
function getPurchaseOrdersForProject(projectId) {
  try {
    if (!projectId) return { success: true, orders: [] };
    const spreadsheet = SpreadsheetApp.openById(SPREADSHEET_ID);
    const sheet       = spreadsheet.getSheetByName('Purchase_Orders');
    if (!sheet) return { success: true, orders: [] };
    const data   = sheet.getDataRange().getValues();
    const orders = [];
    for (let i = 1; i < data.length; i++) {
      if (String(data[i][2] || '').trim() !== String(projectId).trim()) continue;
      orders.push({
        poId:         data[i][1],
        projectId:    data[i][2],
        vendor:       data[i][4] || '',
        description:  data[i][5] || '',
        estAmount:    parseFloat(data[i][6] || 0),
        status:       data[i][7] || 'Pending',
        referenceNum: data[i][8] || '',
        receiptUrl:   data[i][9] || '',
        orderDate:    data[i][11] ? new Date(data[i][11]).toISOString() : '',
        receivedDate: data[i][12] ? new Date(data[i][12]).toISOString() : '',
        notes:        data[i][14] || ''
      });
    }
    return { success: true, orders: orders };
  } catch (error) {
    Logger.log('getPurchaseOrdersForProject error: ' + error.toString());
    return { success: true, orders: [] };
  }
}

/**
 * Get project expenses (local copy so Expenses tab works when deployed without ProjectManagement.gs).
 * Reads PM_Expenses sheet; if sheet missing, returns empty list.
 */
function getProjectExpenses(projectId) {
  try {
    if (!projectId) {
      return { success: true, expenses: [], total: 0 };
    }
    const spreadsheet = SpreadsheetApp.openById(SPREADSHEET_ID);
    const expensesSheet = spreadsheet.getSheetByName(PM_EXPENSES_SHEET);
    if (!expensesSheet) {
      return { success: true, expenses: [], total: 0 };
    }
    const data = expensesSheet.getDataRange().getValues();
    const expenses = [];
    let totalExpenses = 0;
    for (let i = 1; i < data.length; i++) {
      if (String(data[i][1] || '').trim() === String(projectId).trim()) {
        let receiptData = {};
        try {
          if (data[i][7] && String(data[i][7]).trim()) {
            receiptData = JSON.parse(data[i][7]);
          }
        } catch (parseError) {
          receiptData = {};
        }
        expenses.push({
          expenseId: data[i][0],
          projectId: data[i][1],
          date: data[i][2],
          category: data[i][3],
          description: data[i][4],
          amount: data[i][5],
          paidFromAccount: data[i][6],
          receiptData: receiptData
        });
        totalExpenses += parseFloat(data[i][5] || 0);
      }
    }
    return {
      success: true,
      expenses: expenses,
      total: totalExpenses
    };
  } catch (error) {
    Logger.log('getProjectExpenses error: ' + error.toString());
    return { success: false, error: error.toString(), expenses: [], total: 0 };
  }
}

/**
 * Calculate project profit (local copy for Project Details when deployed without ProjectManagement.gs).
 */
function calculateProjectProfit(projectId) {
  try {
    const projectResult = getProject(projectId);
    if (!projectResult || !projectResult.success) {
      return { success: false, error: 'Project not found' };
    }
    const projectData = projectResult.project;
    const totalRevenue = parseFloat(projectData.totalAmount || projectData.total || 0);
    const expResult = getProjectExpenses(projectId);
    const totalExpenses = expResult.success ? (expResult.total || 0) : 0;
    const spreadsheet = SpreadsheetApp.openById(SPREADSHEET_ID);
    const invoicesSheet = spreadsheet.getSheetByName(PM_PROJECT_INVOICES_SHEET);
    let totalPaid = 0;
    if (invoicesSheet) {
      const data = invoicesSheet.getDataRange().getValues();
      for (let i = 1; i < data.length; i++) {
        if (data[i][1] === projectId && data[i][4] === 'Paid') {
          totalPaid += parseFloat(data[i][3] || 0);
        }
      }
    }
    const profit = totalRevenue - totalExpenses;
    const profitMargin = totalRevenue > 0 ? (profit / totalRevenue) * 100 : 0;
    return {
      success: true,
      totalRevenue: totalRevenue,
      totalExpenses: totalExpenses,
      totalPaid: totalPaid,
      remainingRevenue: totalRevenue - totalPaid,
      profit: profit,
      profitMargin: profitMargin
    };
  } catch (error) {
    Logger.log('calculateProjectProfit error: ' + error.toString());
    return { success: false, error: error.toString() };
  }
}

/**
 * Export project expenses as CSV (local copy for standalone deployment).
 */
function exportProjectExpenses(projectId, startDate, endDate, category) {
  try {
    if (!projectId) {
      return { success: false, error: 'Project ID required' };
    }
    const expensesResult = getProjectExpenses(projectId);
    if (!expensesResult.success) {
      return { success: false, error: expensesResult.error };
    }
    let expenses = expensesResult.expenses || [];
    if (startDate) {
      const start = new Date(startDate);
      expenses = expenses.filter(function(e) { return new Date(e.date) >= start; });
    }
    if (endDate) {
      const end = new Date(endDate);
      end.setHours(23, 59, 59, 999);
      expenses = expenses.filter(function(e) { return new Date(e.date) <= end; });
    }
    if (category) {
      expenses = expenses.filter(function(e) { return e.category === category; });
    }
    expenses.sort(function(a, b) { return new Date(b.date) - new Date(a.date); });
    let csv = 'Expense ID,Project ID,Date,Category,Description,Amount,Paid From Account,Vendor,Invoice Number,Notes\n';
    expenses.forEach(function(expense) {
      const receiptData = expense.receiptData || {};
      const date = new Date(expense.date).toLocaleDateString();
      const amount = parseFloat(expense.amount || 0).toFixed(2);
      const vendor = (receiptData.vendor || '').replace(/"/g, '""');
      const invoiceNumber = (receiptData.invoiceNumber || '').replace(/"/g, '""');
      const notes = (receiptData.notes || '').replace(/"/g, '""');
      const desc = (expense.description || '').replace(/"/g, '""');
      csv += '"' + expense.expenseId + '","' + expense.projectId + '","' + date + '","' + expense.category + '","' + desc + '","' + amount + '","' + (expense.paidFromAccount || '') + '","' + vendor + '","' + invoiceNumber + '","' + notes + '"\n';
    });
    const projectResult = getProject(projectId);
    const projectName = (projectResult.success && projectResult.project && projectResult.project.customerName) ? projectResult.project.customerName : projectId;
    const filename = 'Expenses_' + (projectName || projectId).replace(/[^a-zA-Z0-9_-]/g, '_') + '_' + new Date().toISOString().split('T')[0] + '.csv';
    return { success: true, csv: csv, filename: filename, count: expenses.length };
  } catch (error) {
    Logger.log('exportProjectExpenses error: ' + error.toString());
    return { success: false, error: error.toString() };
  }
}

/**
 * Record a manual cash/check/other payment against a project milestone or the
 * project as a whole. Writes a row to the Payment History sheet.
 * Description column: structured tag only ([milestone:…] — Project …) for parsing.
 * Notes column: free text; optional check photo as CHECK_IMAGE:url after upload.
 * @param {string} [checkImageBase64] Optional data URL or raw base64 (same as uploadInvoicePhoto).
 */
function recordInvoiceEstimateManualPayment_(projectId, milestoneId, amount, paymentMethod, notes, paymentDate, checkImageBase64) {
  try {
    if (!projectId) return { success: false, error: 'Project ID required' };

    var parsedAmount = parseFloat(amount || 0);
    if (isNaN(parsedAmount) || parsedAmount <= 0) return { success: false, error: 'Invalid amount: ' + amount };

    var method  = paymentMethod || 'Manual';
    var pDate   = paymentDate   ? new Date(paymentDate) : new Date();
    var notesStr = (notes || '').trim();

    // Look up the project
    var projectResult = getProject(projectId);
    if (!projectResult || !projectResult.success) {
      return { success: false, error: 'Project not found: ' + projectId };
    }
    var projectData = projectResult.project;

    // Payment History is the single source of truth — no JSON updates needed.
    // Prefer the project's linked invoice/estimate ID as the Invoice ID so the
    // history row is easily queryable. Fall back to projectId.
    var invoiceId = projectData.estimateId || projectData.invoiceId || projectData.linkedEstimateId || projectId;

    // Resolve milestone name from the schedule (for the description column).
    var milestoneName = 'General Payment';
    var schedule = projectData.paymentSchedule || [];
    if (typeof schedule === 'string') { try { schedule = JSON.parse(schedule); } catch(e) { schedule = []; } }

    if (milestoneId) {
      for (var k = 0; k < schedule.length; k++) {
        if (String(schedule[k].id) === String(milestoneId) || schedule[k].name === milestoneId) {
          milestoneName = schedule[k].name || milestoneId;
          break;
        }
      }
    }

    // Structured description only (milestone tag + project ref) — user text goes to Notes column.
    var description = '[milestone:' + milestoneName + '] — Project ' + projectId;

    var notesCol = notesStr;
    if (checkImageBase64 && String(checkImageBase64).trim()) {
      try {
        var up = uploadInvoicePhoto(
          String(checkImageBase64).trim(),
          projectData.customerName || 'Customer',
          projectData.customerAddress || ''
        );
        if (up.success && up.fileUrl) {
          notesCol = (notesCol ? notesCol + '\n' : '') + 'CHECK_IMAGE:' + up.fileUrl;
        } else {
          Logger.log('⚠️ Check image upload skipped: ' + (up.error || 'unknown'));
        }
      } catch (imgErr) {
        Logger.log('⚠️ Check image upload error: ' + imgErr.toString());
      }
    }

    // Write to Payment History sheet — this is the only write needed.
    var transactionId = 'MAN-' + new Date().getTime();
    recordPaymentHistory(
      invoiceId,
      parsedAmount,
      transactionId,
      method,
      projectData.companyId || 'CMP-AQUALITYPOOL',
      pDate,
      projectData.customerEmail || '',
      description,
      0,
      notesCol
    );

    Logger.log('✅ Manual payment recorded: $' + parsedAmount + ' for project ' + projectId + ' milestone ' + milestoneName);
    return {
      success: true,
      message: 'Payment of $' + parsedAmount.toFixed(2) + ' recorded for ' + milestoneName,
      transactionId: transactionId,
      milestoneName: milestoneName,
      invoiceId: invoiceId,
      amount: parsedAmount,
      paymentMethod: method,
      paymentDate: pDate.toISOString(),
      customerEmail: projectData.customerEmail || '',
      customerName: projectData.customerName || '',
      customerPhone: projectData.customerPhone || ''
    };

  } catch(e) {
    Logger.log('recordInvoiceEstimateManualPayment_ error: ' + e.toString());
    return { success: false, error: e.toString() };
  }
}

