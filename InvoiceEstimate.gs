/**
 * Get customers from Customers sheet (filtered by company if email provided)
 */
function getCustomersFromSheet(spreadsheet, email) {
  try {
    setupCustomersSheet(); // Ensure sheet exists
    
    // Get company info for filtering
    let companyId = null;
    if (email) {
      const companyResult = getCompanyIdForUser(email);
      if (companyResult.success) {
        companyId = companyResult.companyId;
      }
    }
    
    const sheet = spreadsheet.getSheetByName(CUSTOMERS_SHEET);
    if (!sheet) {
      return { success: true, customers: [] };
    }
    
    const dataRows = sheet.getDataRange().getValues();
    if (dataRows.length <= 1) {
      return { success: true, customers: [] };
    }
    
    const headers = dataRows[0];
    
    // Find Company ID column index
    const companyIdColIndex = headers.findIndex(h => 
      String(h || '').toLowerCase().trim() === 'company id'
    );
    
    // Find column indices (case-insensitive, trim whitespace)
    const findColIndex = (headerName) => {
      for (let i = 0; i < headers.length; i++) {
        if (String(headers[i]).trim().toLowerCase() === headerName.toLowerCase()) {
          return i;
        }
      }
      return -1;
    };
    
    const idCol = findColIndex('Customer ID');
    const nameCol = findColIndex('Name');
    const emailCol = findColIndex('Email');
    const phoneCol = findColIndex('Phone');
    const addressCol = findColIndex('Address');
    const cityCol = findColIndex('City');
    const stateCol = findColIndex('State');
    const zipCol = findColIndex('Zip Code');
    
    // Log column indices for debugging
    Logger.log('Customer sheet column indices - ID: ' + idCol + ', Name: ' + nameCol + ', Email: ' + emailCol);
    
    // Check if required columns were found
    if (nameCol === -1 && emailCol === -1) {
      Logger.log('Warning: Could not find Name or Email columns. Headers: ' + JSON.stringify(headers));
      return { success: true, customers: [] };
    }
    
    const customers = [];
    for (let i = 1; i < dataRows.length; i++) {
      const row = dataRows[i];
      const name = (nameCol >= 0) ? (String(row[nameCol] || '').trim()) : '';
      const email = (emailCol >= 0) ? (String(row[emailCol] || '').trim()) : '';
      
      // Skip empty rows
      if (!name && !email) continue;
      
      // Filter by Company ID if provided (and company ID column exists)
      if (companyId && companyIdColIndex >= 0) {
        const rowCompanyId = String(row[companyIdColIndex] || '').trim();
        // Only skip rows that explicitly belong to a DIFFERENT company.
        // Rows with an empty Company ID are legacy / invoice-created customers — always show them.
        if (rowCompanyId && rowCompanyId !== companyId) {
          continue;
        }
      }
      
      // Build full address
      let fullAddress = (addressCol >= 0) ? (String(row[addressCol] || '').trim()) : '';
      const city = (cityCol >= 0) ? (String(row[cityCol] || '').trim()) : '';
      const state = (stateCol >= 0) ? (String(row[stateCol] || '').trim()) : '';
      const zip = (zipCol >= 0) ? (String(row[zipCol] || '').trim()) : '';
      
      if (city || state || zip) {
        const addressParts = [city, state, zip].filter(p => p);
        if (fullAddress && addressParts.length > 0) {
          fullAddress += ', ' + addressParts.join(', ');
        } else if (addressParts.length > 0) {
          fullAddress = addressParts.join(', ');
        }
      }
      
      // Detect if name and email are swapped (name looks like email, email doesn't)
      let finalName = name;
      let finalEmail = email;
      
      // If name contains @ and email doesn't, they're swapped
      if (finalName && finalName.includes('@') && finalEmail && !finalEmail.includes('@')) {
        const temp = finalName;
        finalName = finalEmail;
        finalEmail = temp;
        Logger.log('⚠️ Detected swapped Name/Email for row ' + (i+1) + ', corrected to Name="' + finalName + '", Email="' + finalEmail + '"');
      }
      
      customers.push({
        id: (idCol >= 0) ? (String(row[idCol] || '').trim()) : '',
        name: finalName || 'No Name',
        email: finalEmail,
        phone: (phoneCol >= 0) ? (String(row[phoneCol] || '').trim()) : '',
        address: fullAddress
      });
    }
    
    Logger.log('Loaded ' + customers.length + ' customers from sheet');
    return { success: true, customers: customers };
  } catch (error) {
    Logger.log('Error getting customers from sheet: ' + error.toString());
    return { success: false, customers: [], error: error.toString() };
  }
}

/**
 * Customers sheet layout for PM task autocomplete — prefers exact "Name" header (not "Customer ID").
 * @returns {object|null}
 */
function pmTaskGetCustomerSheetLayout_() {
  try {
    setupCustomersSheet();
    var sheet = SpreadsheetApp.openById(SPREADSHEET_ID).getSheetByName(CUSTOMERS_SHEET);
    if (!sheet) return null;
    var dataRows = sheet.getDataRange().getValues();
    if (dataRows.length <= 1) return null;

    var findColIn = function(headers, names) {
      var list = Array.isArray(names) ? names : [names];
      for (var n = 0; n < list.length; n++) {
        var want = String(list[n] || '').trim().toLowerCase();
        for (var i = 0; i < headers.length; i++) {
          if (String(headers[i] || '').trim().toLowerCase() === want) return i;
        }
      }
      return -1;
    };
    var findColExact = function(headers, exact) {
      var w = String(exact || '').trim().toLowerCase();
      for (var i = 0; i < headers.length; i++) {
        if (String(headers[i] || '').trim().toLowerCase() === w) return i;
      }
      return -1;
    };

    var headerRowIdx = 0;
    for (var hr = 0; hr < Math.min(3, dataRows.length); hr++) {
      var h = dataRows[hr];
      if (findColIn(h, ['Name', 'Customer Name', 'Email', 'Customer ID']) >= 0) {
        headerRowIdx = hr;
        break;
      }
    }

    var headers = dataRows[headerRowIdx];
    var companyIdCol = findColIn(headers, ['Company ID', 'CompanyID']);
    var idCol = findColIn(headers, ['Customer ID', 'CustomerID']);
    // Prefer exact "Name" so we never use "Customer ID" column as the display name
    var nameCol = findColExact(headers, 'Name');
    if (nameCol === -1) nameCol = findColIn(headers, ['Customer Name']);
    if (nameCol === -1) nameCol = findColIn(headers, ['Full Name']);
    var emailCol = findColIn(headers, ['Email', 'Customer Email']);
    if (nameCol === -1) return null;
    if (idCol === nameCol) idCol = -1;

    var layout = {
      dataRows: dataRows,
      headerRowIdx: headerRowIdx,
      companyIdCol: companyIdCol,
      idCol: idCol,
      nameCol: nameCol,
      emailCol: emailCol
    };
    pmTaskMaybeSwapNameIdColumns_(layout);
    return layout;
  } catch (e) {
    Logger.log('pmTaskGetCustomerSheetLayout_: ' + e);
    return null;
  }
}

/**
 * True if value looks like a generated customer code (e.g. CUST-2025-0001).
 */
function pmTaskLooksLikeCustCode_(s) {
  s = String(s || '').trim();
  if (!s) return false;
  if (!/^CUST/i.test(s)) return false;
  return /\d/.test(s);
}

/**
 * When headers don't match data (Name column holds IDs, Customer ID holds names), swap column indices.
 */
function pmTaskMaybeSwapNameIdColumns_(layout) {
  if (!layout || layout.nameCol < 0 || layout.idCol < 0) return;
  var dr = layout.dataRows;
  var hr = layout.headerRowIdx;
  var nc = layout.nameCol;
  var ic = layout.idCol;
  var sample = 0;
  var nameColCodes = 0;
  var idColCodes = 0;
  var end = Math.min(hr + 1 + 60, dr.length);
  for (var i = hr + 1; i < end; i++) {
    var a = String(dr[i][nc] || '').trim();
    var b = String(dr[i][ic] || '').trim();
    if (!a && !b) continue;
    sample++;
    if (pmTaskLooksLikeCustCode_(a)) nameColCodes++;
    if (pmTaskLooksLikeCustCode_(b)) idColCodes++;
  }
  if (sample < 4) return;
  // Expected: "Name" column is mostly people text; "Customer ID" column is mostly CUST-*.
  if (nameColCodes >= sample * 0.5 && idColCodes <= sample * 0.25) {
    var t = layout.nameCol;
    layout.nameCol = layout.idCol;
    layout.idCol = t;
  }
}

function pmTaskRowMatchesCompany_(row, companyIdCol, cid) {
  if (companyIdCol < 0) return true;
  var rowCid = String(row[companyIdCol] || '').trim();
  if (rowCid) {
    return rowCid === cid;
  }
  return cid === 'CMP-AQUALITYPOOL';
}

/**
 * Some spreadsheets label columns such that CUST-* appears under "Name" and the
 * person's name under "Customer ID". Normalize so { name, customerId } are semantic.
 */
function pmTaskNormalizeCustomerNameAndId_(nameRaw, idRaw) {
  var a = String(nameRaw || '').trim();
  var b = String(idRaw || '').trim();
  if (pmTaskLooksLikeCustCode_(a) && b && !pmTaskLooksLikeCustCode_(b)) {
    return { name: b, customerId: a };
  }
  if (pmTaskLooksLikeCustCode_(b) && a && !pmTaskLooksLikeCustCode_(a)) {
    return { name: a, customerId: b };
  }
  return { name: a, customerId: b };
}

/**
 * When Name column holds CUST-* but ID column is blank, the person's label may only appear in Email
 * (e.g. "Vinny" or local part of vinny@...). Promote that to display name and keep CUST as id.
 */
function pmTaskTitleCaseWords_(s) {
  return String(s || '').trim().replace(/\w\S*/g, function(t) {
    return t.charAt(0).toUpperCase() + t.slice(1).toLowerCase();
  });
}

function pmTaskFinalizeCustomerRecord_(norm, emailRaw) {
  var name = String(norm.name || '').trim();
  var custId = String(norm.customerId || '').trim();
  var email = String(emailRaw || '').trim();
  if (!pmTaskLooksLikeCustCode_(name)) {
    return { name: name, customerId: custId, email: email };
  }
  if (custId) {
    return { name: name, customerId: custId, email: email };
  }
  if (!email || pmTaskLooksLikeCustCode_(email)) {
    return { name: name, customerId: custId, email: email };
  }
  custId = name;
  var display;
  if (email.indexOf('@') >= 0) {
    var local = email.split('@')[0].replace(/[._+-]+/g, ' ').replace(/\s+/g, ' ').trim();
    display = pmTaskTitleCaseWords_(local);
  } else {
    display = email;
  }
  return { name: display, customerId: custId, email: email };
}

/**
 * One read of Customers for company — use with client-side filter (fast typing).
 */
function getPmTaskCustomerCache(companyId) {
  try {
    var cid = String(companyId || '').trim();
    var layout = pmTaskGetCustomerSheetLayout_();
    if (!layout) return { success: true, customers: [] };

    var customers = [];
    var maxRows = 800;
    for (var i = layout.headerRowIdx + 1; i < layout.dataRows.length && customers.length < maxRows; i++) {
      var row = layout.dataRows[i];
      if (!pmTaskRowMatchesCompany_(row, layout.companyIdCol, cid)) continue;
      var rawName = String(row[layout.nameCol] || '').trim();
      var rawId = layout.idCol >= 0 ? String(row[layout.idCol] || '').trim() : '';
      var norm = pmTaskNormalizeCustomerNameAndId_(rawName, rawId);
      var email = layout.emailCol >= 0 ? String(row[layout.emailCol] || '').trim() : '';
      var fin = pmTaskFinalizeCustomerRecord_(norm, email);
      if (!fin.name) continue;
      customers.push({ customerId: fin.customerId, name: fin.name, email: fin.email });
    }
    return { success: true, customers: customers };
  } catch (error) {
    Logger.log('getPmTaskCustomerCache: ' + error);
    return { success: false, customers: [], error: error.toString() };
  }
}

/**
 * If the task form still has a CUST-* code in the customer field, replace with display name from Customers.
 */
function pmTaskResolveCustomerDisplayName_(companyId, input) {
  var raw = String(input || '').trim();
  if (!raw) return '';
  if (!pmTaskLooksLikeCustCode_(raw)) return raw;
  try {
    var cache = getPmTaskCustomerCache(companyId);
    if (!cache || !cache.success || !cache.customers) return raw;
    var customers = cache.customers;
    for (var i = 0; i < customers.length; i++) {
      var c = customers[i];
      if (String(c.customerId || '').trim() === raw) {
        var n = String(c.name || '').trim();
        return n || raw;
      }
    }
  } catch (e) {}
  return raw;
}

/**
 * Typeahead: filter customer names by company and search query (for PM tasks, etc.).
 */
function searchCustomersByCompanyId(companyId, query, maxResults) {
  try {
    var cid = String(companyId || '').trim();
    var q = String(query || '').toLowerCase().trim();
    maxResults = maxResults || 20;

    var layout = pmTaskGetCustomerSheetLayout_();
    if (!layout) return { success: true, suggestions: [] };

    var suggestions = [];
    for (var i = layout.headerRowIdx + 1; i < layout.dataRows.length && suggestions.length < maxResults; i++) {
      var row = layout.dataRows[i];
      if (!pmTaskRowMatchesCompany_(row, layout.companyIdCol, cid)) continue;
      var rawName = String(row[layout.nameCol] || '').trim();
      var rawId = layout.idCol >= 0 ? String(row[layout.idCol] || '').trim() : '';
      var norm = pmTaskNormalizeCustomerNameAndId_(rawName, rawId);
      var email = layout.emailCol >= 0 ? String(row[layout.emailCol] || '').trim() : '';
      var fin = pmTaskFinalizeCustomerRecord_(norm, email);
      if (!fin.name) continue;
      if (q) {
        var nm = fin.name.toLowerCase().indexOf(q) !== -1;
        var em = email.toLowerCase().indexOf(q) !== -1;
        var idm = String(fin.customerId || '').toLowerCase().indexOf(q) !== -1;
        var rawNm = rawName.toLowerCase().indexOf(q) !== -1;
        var rawIdm = rawId.toLowerCase().indexOf(q) !== -1;
        if (!nm && !em && !idm && !rawNm && !rawIdm) continue;
      }
      suggestions.push({ name: fin.name, email: fin.email, customerId: fin.customerId });
    }
    return { success: true, suggestions: suggestions };
  } catch (error) {
    Logger.log('searchCustomersByCompanyId: ' + error);
    return { success: false, suggestions: [], error: error.toString() };
  }
}

/**
 * Add customer to Customers sheet
 */
function addCustomer(data) {
  try {
    // Validate input
    if (!data) {
      Logger.log('addCustomer: No data provided');
      return { success: false, error: 'No customer data provided' };
    }
    
    setupCustomersSheet(); // Ensure sheet exists
    
    const spreadsheet = SpreadsheetApp.openById(SPREADSHEET_ID);
    const sheet = spreadsheet.getSheetByName(CUSTOMERS_SHEET);
    
    if (!sheet) {
      return { success: false, error: 'Customers sheet not found' };
    }
    
    // Validate required fields
    if (!data.name || !data.email) {
      return { success: false, error: 'Name and Email are required' };
    }
    
    // Check if customer with same email already exists
    const dataRows = sheet.getDataRange().getValues();
    const headers = dataRows[0];
    const emailCol = headers.indexOf('Email');
    
    for (let i = 1; i < dataRows.length; i++) {
      if (dataRows[i][emailCol] && dataRows[i][emailCol].toLowerCase() === data.email.toLowerCase()) {
        return { success: false, error: 'Customer with this email already exists' };
      }
    }
    
    // Generate Customer ID
    const year = new Date().getFullYear();
    const yearPrefix = 'CUST-' + year + '-';
    let maxNumber = 0;
    
    const idCol = headers.indexOf('Customer ID');
    for (let i = 1; i < dataRows.length; i++) {
      const id = dataRows[i][idCol];
      if (id && typeof id === 'string' && id.startsWith(yearPrefix)) {
        const numPart = id.replace(yearPrefix, '');
        const num = parseInt(numPart);
        if (!isNaN(num) && num > maxNumber) {
          maxNumber = num;
        }
      }
    }
    
    const customerId = yearPrefix + String(maxNumber + 1).padStart(4, '0');
    
    // Parse address if it's a string
    let address = data.address || '';
    let city = data.city || '';
    let state = data.state || '';
    let zipCode = data.zipCode || '';
    
    // If address is a single string, try to parse it
    if (address && !city && !state && !zipCode) {
      const parts = address.split(',').map(p => p.trim());
      if (parts.length >= 3) {
        address = parts.slice(0, -2).join(', ');
        city = parts[parts.length - 2] || '';
        const stateZip = parts[parts.length - 1] || '';
        const stateZipParts = stateZip.trim().split(' ');
        state = stateZipParts[0] || '';
        zipCode = stateZipParts.slice(1).join(' ') || '';
      }
    }
    
    const now = new Date();
    const rowData = [
      data.companyId || '',  // col A: Company ID (blank for single-tenant / legacy rows)
      data.name || '',
      data.email || '',
      data.phone || '',
      address,
      city,
      state,
      zipCode,
      data.notes || '',
      now,
      now
    ];
    
    sheet.appendRow(rowData);
    
    return {
      success: true,
      customerId: customerId,
      customer: {
        id: customerId,
        name: data.name,
        email: data.email,
        phone: data.phone || '',
        address: [address, city, state, zipCode].filter(p => p).join(', ')
      }
    };
  } catch (error) {
    Logger.log('Error adding customer: ' + error.toString());
    return { success: false, error: error.toString() };
  }
}

/**
 * Check if customer exists in Customer Portal and return their information
 */
function findCustomerInPortal(email) {
  try {
    const spreadsheet = SpreadsheetApp.openById(SPREADSHEET_ID);
    const customerPortalSheet = spreadsheet.getSheetByName('Customer Portal');
    
    if (!customerPortalSheet) {
      return { found: false, customer: null };
    }
    
    const portalData = customerPortalSheet.getDataRange().getValues();
    if (portalData.length <= 2) { // Skip header rows
      return { found: false, customer: null };
    }
    
    const portalHeaders = portalData[1]; // Headers are in row 2
    const emailColIndex = portalHeaders.indexOf('Email');
    const nameColIndex = portalHeaders.indexOf('Name');
    const phoneColIndex = portalHeaders.indexOf('Phone');
    const addressColIndex = portalHeaders.indexOf('Address');
    const squareIdColIndex = portalHeaders.indexOf('Square Customer ID');
    
    if (emailColIndex === -1) {
      return { found: false, customer: null };
    }
    
    for (let i = 2; i < portalData.length; i++) { // Data starts at row 3
      if (portalData[i][emailColIndex] && 
          portalData[i][emailColIndex].toLowerCase().trim() === email.toLowerCase().trim()) {
        return {
          found: true,
          customer: {
            email: portalData[i][emailColIndex],
            name: (nameColIndex >= 0) ? portalData[i][nameColIndex] : '',
            phone: (phoneColIndex >= 0) ? portalData[i][phoneColIndex] : '',
            address: (addressColIndex >= 0) ? portalData[i][addressColIndex] : '',
            squareCustomerId: (squareIdColIndex >= 0) ? portalData[i][squareIdColIndex] : ''
          }
        };
      }
    }
    
    return { found: false, customer: null };
  } catch (error) {
    Logger.log('Error finding customer in portal: ' + error.toString());
    return { found: false, customer: null };
  }
}

/**
 * Split JSON string into chunks of max 49,500 characters
 * Returns array of exactly 3 chunks (empty strings for unused)
 */
function splitJsonString(jsonString) {
  const MAX_CHUNK_SIZE = 49500;
  const chunks = [];
  
  if (jsonString.length <= MAX_CHUNK_SIZE) {
    return [jsonString, '', '']; // Return 3 elements, empty strings for unused chunks
  }
  
  let remaining = jsonString;
  while (remaining.length > 0 && chunks.length < 3) {
    if (remaining.length <= MAX_CHUNK_SIZE) {
      chunks.push(remaining);
      remaining = '';
    } else {
      // Try to split at a safe point (not in the middle of a string)
      let splitPoint = MAX_CHUNK_SIZE;
      // Look backwards for a safe split point (end of a value)
      for (let i = MAX_CHUNK_SIZE; i > MAX_CHUNK_SIZE - 100 && i > 0; i--) {
        if (remaining[i] === ',' || remaining[i] === '}' || remaining[i] === ']') {
          splitPoint = i + 1;
          break;
        }
      }
      chunks.push(remaining.substring(0, splitPoint));
      remaining = remaining.substring(splitPoint);
    }
  }
  
  // Pad to exactly 3 chunks with empty strings
  while (chunks.length < 3) {
    chunks.push('');
  }
  
  return chunks.slice(0, 3); // Return exactly 3 chunks
}

/**
 * Concatenate JSON chunks from multiple columns back into single JSON string
 */
function concatenateJsonChunks(chunk1, chunk2, chunk3) {
  const parts = [];
  if (chunk1) parts.push(String(chunk1).trim());
  if (chunk2) parts.push(String(chunk2).trim());
  if (chunk3) parts.push(String(chunk3).trim());
  return parts.join('');
}

/**
 * Row number (1-based) for a document ID in Invoices sheet, or -1.
 */
function findInvoiceEstimateRowByDocumentId_(sheet, documentId) {
  if (!sheet || documentId === undefined || documentId === null) return -1;
  const norm = String(documentId).trim();
  if (!norm) return -1;
  const lastRow = sheet.getLastRow();
  if (lastRow < 2) return -1;
  const ids = sheet.getRange(2, INVOICES_SHEET_COL_ID, lastRow, INVOICES_SHEET_COL_ID).getValues();
  for (var i = 0; i < ids.length; i++) {
    if (String(ids[i][0] || '').trim() === norm) return i + 2;
  }
  return -1;
}

/**
 * Read approvalToken from stored JSON chunks for an invoice row.
 */
function readApprovalTokenFromInvoiceRow_(sheet, rowNum) {
  if (!sheet || rowNum < 2) return '';
  try {
    var j1 = sheet.getRange(rowNum, INVOICES_SHEET_COL_JSON1).getValue();
    var j2 = sheet.getRange(rowNum, INVOICES_SHEET_COL_JSON2).getValue();
    var j3 = sheet.getRange(rowNum, INVOICES_SHEET_COL_JSON3).getValue();
    var full = concatenateJsonChunks(j1, j2, j3);
    if (!full || !String(full).trim().startsWith('{')) return '';
    var data = JSON.parse(full);
    var t = data.approvalToken;
    return (t && String(t).trim()) ? String(t).trim() : '';
  } catch (e) {
    return '';
  }
}

/**
 * One row per document ID in PM_Approval_Tokens; refresh token + long expiry on save/send.
 * Preserves Used flag when updating an existing row.
 */
function upsertPMApprovalToken_(spreadsheet, token, documentId, customerEmail, documentType) {
  if (!spreadsheet || !token || !documentId) return;
  try {
    documentType = documentType || 'Invoice'; // Default to Invoice if not specified
    var sheet = spreadsheet.getSheetByName(PM_APPROVAL_TOKENS_SHEET);
    if (!sheet) {
      sheet = spreadsheet.insertSheet(PM_APPROVAL_TOKENS_SHEET);
      sheet.getRange(1, 1, 1, 7).setValues([['Token', 'EstimateID', 'CustomerEmail', 'CreatedDate', 'ExpiresDate', 'Used', 'DocumentType']]);
    } else {
      // Check if DocumentType column exists (column 7), add it if missing
      var headers = sheet.getRange(1, 1, 1, sheet.getLastColumn()).getValues()[0];
      var hasDocTypeCol = headers.indexOf('DocumentType') !== -1;
      if (!hasDocTypeCol && sheet.getLastColumn() === 6) {
        // Add DocumentType column to existing sheet
        sheet.getRange(1, 7).setValue('DocumentType');
        Logger.log('✅ Added DocumentType column to PM_Approval_Tokens sheet');
      }
    }
    var lastRow = sheet.getLastRow();
    var targetRow = -1;
    if (lastRow >= 2) {
      var idCol = sheet.getRange(2, 2, lastRow - 1, 1).getValues();
      var want = String(documentId).trim();
      for (var i = 0; i < idCol.length; i++) {
        if (String(idCol[i][0] || '').trim() === want) {
          targetRow = i + 2;
          break;
        }
      }
    }
    var now = new Date();
    var exp = new Date(now.getTime());
    exp.setFullYear(exp.getFullYear() + PM_APPROVAL_TOKEN_EXPIRY_YEARS);
    if (targetRow === -1) {
      sheet.appendRow([token, documentId, customerEmail || '', now, exp, false, documentType]);
    } else {
      var usedVal = sheet.getRange(targetRow, 6).getValue();
      var usedBool = (usedVal === true || String(usedVal).toLowerCase() === 'true');
      sheet.getRange(targetRow, 1, 1, 7).setValues([[token, documentId, customerEmail || '', now, exp, usedBool, documentType]]);
    }
  } catch (e) {
    Logger.log('upsertPMApprovalToken_ error: ' + e);
  }
}

/**
 * Migrate sheet to 8-column structure with Company ID
 * Column 1: Company ID (NEW), Column 2: ID, Column 3: Customer Email, Columns 4-6: JSON Parts, Column 7: Total, Column 8: Payment Schedule
 * This function ONLY adds the Company ID column and shifts everything right - it does NOT clear any existing data
 */
function migrateTo8ColumnStructure(sheet) {
  try {
    const lastCol = sheet.getLastColumn();
    const lastRow = sheet.getLastRow();
    
    // If sheet has 7 columns, migrate to 8
    if (lastCol === 7) {
      Logger.log('🔄 Migrating from 7-column to 8-column structure (adding Company ID column)');
      
      // Insert Company ID column at the beginning - this automatically shifts all existing data to the right
      sheet.insertColumnBefore(1);
      SpreadsheetApp.flush();
      
      // Update headers
      const newHeaders = ['Company ID', 'ID', 'Customer Email', 'JSON Part 1', 'JSON Part 2', 'JSON Part 3', 'Total', 'Payment Schedule'];
      sheet.getRange(1, 1, 1, 8).setValues([newHeaders]);
      sheet.getRange(1, 1, 1, 8).setFontWeight('bold');
      sheet.getRange(1, 1, 1, 8).setBackground('#0369a1');
      sheet.getRange(1, 1, 1, 8).setFontColor('#ffffff');
      
      // Populate Company ID for existing rows (all data is preserved, just shifted right)
      if (lastRow > 1) {
        Logger.log('📝 Populating Company ID for ' + (lastRow - 1) + ' existing rows (all data preserved)...');
        for (let rowNum = 2; rowNum <= lastRow; rowNum++) {
          try {
            // Try to get Company ID from JSON data (now in columns 4-6 after shift)
            const jsonPart1 = sheet.getRange(rowNum, 4).getValue() || ''; // Now column 4 (was 3)
            const jsonPart2 = sheet.getRange(rowNum, 5).getValue() || ''; // Now column 5 (was 4)
            const jsonPart3 = sheet.getRange(rowNum, 6).getValue() || ''; // Now column 6 (was 5)
            const fullJson = concatenateJsonChunks(jsonPart1, jsonPart2, jsonPart3);
            
            if (fullJson && fullJson.startsWith('{')) {
              const jsonData = JSON.parse(fullJson);
              const companyId = jsonData.companyId || 'CMP-AQUALITYPOOL'; // Default to admin company
              sheet.getRange(rowNum, 1).setValue(companyId);
            } else {
              // No JSON or invalid JSON - default to admin company
              sheet.getRange(rowNum, 1).setValue('CMP-AQUALITYPOOL');
            }
          } catch (e) {
            // Error parsing - default to admin company
            Logger.log('⚠️ Error parsing JSON for row ' + rowNum + ', defaulting to CMP-AQUALITYPOOL: ' + e.toString());
            sheet.getRange(rowNum, 1).setValue('CMP-AQUALITYPOOL');
          }
        }
        SpreadsheetApp.flush();
        Logger.log('✅ Migration complete - all ' + (lastRow - 1) + ' rows preserved and have Company ID');
      }
      
      return true;
    }
    return false;
  } catch (e) {
    Logger.log('Error migrating to 8-column structure: ' + e.toString());
    return false;
  }
}

/**
 * Enforce 8-column structure for Invoices/Estimates sheet
 * Column 1: Company ID, Column 2: ID, Column 3: Customer Email, Columns 4-6: JSON Parts, Column 7: Total, Column 8: Payment Schedule
 * This function will migrate from 7 columns to 8 if needed
 */
function enforce8ColumnStructure(sheet) {
  try {
    const lastCol = sheet.getLastColumn();
    
    // First, migrate from 7 to 8 if needed
    if (lastCol === 7) {
      return migrateTo8ColumnStructure(sheet);
    }
    
    if (lastCol > 9) {
      Logger.log('⚠ Trimming columns beyond 9 (keeping col 9 One-Off Items JSON)');
      const numColsToDelete = lastCol - 9;
      sheet.deleteColumns(10, numColsToDelete);
      SpreadsheetApp.flush();
      Logger.log('✓ Sheet now has exactly 9 columns');
      return true;
    } else if (lastCol < 8) {
      // If somehow we have fewer than 8 columns, add them
      Logger.log('⚠ WARNING: Sheet has only ' + lastCol + ' columns. Adding columns to reach 8.');
      const missingCols = 8 - lastCol;
      sheet.insertColumns(lastCol + 1, missingCols);
      SpreadsheetApp.flush();
      
      // Set headers for any new columns
      const expectedHeaders = ['Company ID', 'ID', 'Customer Email', 'JSON Part 1', 'JSON Part 2', 'JSON Part 3', 'Total', 'Payment Schedule'];
      sheet.getRange(1, 1, 1, 8).setValues([expectedHeaders]);
      sheet.getRange(1, 1, 1, 8).setFontWeight('bold');
      sheet.getRange(1, 1, 1, 8).setBackground('#0369a1');
      sheet.getRange(1, 1, 1, 8).setFontColor('#ffffff');
      
      Logger.log('✓ Added ' + missingCols + ' columns to reach 8-column structure');
      return true;
    }
    return false;
  } catch (e) {
    Logger.log('Error enforcing 8-column structure: ' + e.toString());
    return false;
  }
}

/**
 * Ensure column 9 exists with header "One-Off Items JSON" (canonical storage for one-off line items).
 */
function ensureInvoicesEstimatesNineColumns(sheet) {
  try {
    if (!sheet) return;
    enforce8ColumnStructure(sheet);
    var lc = sheet.getLastColumn();
    if (lc === 8) {
      sheet.insertColumnAfter(8);
      SpreadsheetApp.flush();
      sheet.getRange(1, INVOICES_COL_ONE_OFF_ITEMS).setValue(INVOICES_HEADER_ONE_OFF_ITEMS);
      sheet.getRange(1, INVOICES_COL_ONE_OFF_ITEMS).setFontWeight('bold');
      sheet.getRange(1, INVOICES_COL_ONE_OFF_ITEMS).setBackground('#0369a1');
      sheet.getRange(1, INVOICES_COL_ONE_OFF_ITEMS).setFontColor('#ffffff');
      Logger.log('✅ Added column 9: ' + INVOICES_HEADER_ONE_OFF_ITEMS);
    } else if (lc < 8) {
      enforce8ColumnStructure(sheet);
      ensureInvoicesEstimatesNineColumns(sheet);
      return;
    }
    var h = String(sheet.getRange(1, INVOICES_COL_ONE_OFF_ITEMS).getValue() || '').trim();
