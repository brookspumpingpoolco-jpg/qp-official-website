// FEATURE 14: PAYMENT HISTORY
// ========================================

/**
 * Get payment history for a project — aggregates payments across all milestone
 * invoices linked to the given project ID.
 */
/**
 * @param {string} projectId  - The PROJ-xxxx identifier
 * @param {string} [linkedId] - The invoice/estimate ID already known by the caller (preferred)
 */
function getProjectPaymentHistory(projectId, linkedId) {
  try {
    if (!projectId) return { success: false, error: 'Project ID required' };
    var spreadsheet = SpreadsheetApp.openById(SPREADSHEET_ID);
    var payments = [];
    var totalPaid = 0;

    // --- Helper: read all payment history rows once ---
    function readHistorySheet() {
      var hs = spreadsheet.getSheetByName(PAYMENT_HISTORY_SHEET);
      if (!hs) return null;
      var rows = hs.getDataRange().getValues();
      var hdrs = rows[0] || [];
      // Support both "Payment Method" and "Method" column names
      var methIdx = hdrs.indexOf('Payment Method');
      if (methIdx < 0) methIdx = hdrs.indexOf('Method');
      return {
        rows: rows,
        idIdx:     hdrs.indexOf('Invoice ID'),
        amtIdx:    hdrs.indexOf('Amount'),
        dateIdx:   hdrs.indexOf('Date'),
        methIdx:   methIdx,
        txIdx:     hdrs.indexOf('Transaction ID'),
        feeIdx:    hdrs.indexOf('Fee'),
        statusIdx: hdrs.indexOf('Status'),
        descIdx:   hdrs.indexOf('Description'),  // [milestone:Name] tag lookup
        notesIdx:  hdrs.indexOf('Notes')
      };
    }

    function rowToPayment(row, h, invoiceId) {
      var noteRaw = h.notesIdx >= 0 ? String(row[h.notesIdx] || '') : '';
      return {
        invoiceId:     invoiceId || String(row[h.idIdx] || '').trim(),
        milestone:     '',
        amount:        parseFloat(row[h.amtIdx] || 0),
        date:          h.dateIdx >= 0 && row[h.dateIdx] ? new Date(row[h.dateIdx]).toISOString() : '',
        method:        h.methIdx >= 0 ? String(row[h.methIdx] || 'Unknown') : 'Unknown',
        transactionId: h.txIdx >= 0 ? String(row[h.txIdx] || '') : '',
        fee:           h.feeIdx >= 0 ? parseFloat(row[h.feeIdx] || 0) : 0,
        description:   h.descIdx >= 0 ? String(row[h.descIdx] || '') : '',
        notes:         noteRaw
      };
    }

    // Helper: add a payment only if not already collected (dedup by transactionId)
    function addPayment(p, invoiceIdOverride, milestoneOverride) {
      var txId = p.transactionId || '';
      if (txId && payments.some(function(ep) { return ep.transactionId === txId; })) return;
      var amt = parseFloat(p.amount || 0);
      var rawNotes = p.notes != null && p.notes !== undefined ? String(p.notes) : '';
      var parsedN = parseCheckImageFromNotes(rawNotes);
      payments.push({
        invoiceId:     invoiceIdOverride || p.invoiceId || '',
        milestone:     milestoneOverride !== undefined ? milestoneOverride : (p.milestone || ''),
        amount:        amt,
        date:          p.date || '',
        method:        p.method || 'Unknown',
        transactionId: txId,
        fee:           p.fee || 0,
        description:   p.description || '',
        notes:         parsedN.notesOnly,
        checkImageUrl: parsedN.checkImageUrl || ''
      });
      totalPaid += amt;
    }

    // Collect all IDs to search — never return early, always aggregate all sources.
    var searchIds = [];

    // 1. Caller-supplied linkedId (e.g. Invoice-xxxxx)
    if (linkedId && String(linkedId).trim()) {
      searchIds.push(String(linkedId).trim());
    }

    // 2. Project JSON linked IDs (top-level + nested projectData)
    try {
      var projectResult = getProject(projectId);
      if (projectResult.success && projectResult.project) {
        var pTop = projectResult.project || {};
        var pData = pTop.projectData || {};
        var projLinkedIds = [
          pTop.estimateId,
          pTop.invoiceId,
          pTop.linkedEstimateId,
          pTop.linkedInvoiceId,
          pData.estimateId,
          pData.invoiceId,
          pData.linkedEstimateId,
          pData.linkedInvoiceId
        ].map(function(v) {
          return String(v || '').trim();
        }).filter(function(v) {
          return !!v;
        });

        projLinkedIds.forEach(function(idVal) {
          if (searchIds.indexOf(idVal) === -1) searchIds.push(idVal);
        });
      }
    } catch(err) {
      Logger.log('getProjectPaymentHistory project lookup error: ' + err.toString());
    }

    // 3. The projectId itself (catches old payments stored under PROJ-xxx)
    if (searchIds.indexOf(projectId) === -1) searchIds.push(projectId);

    Logger.log('🔍 getProjectPaymentHistory: searching IDs: ' + searchIds.join(', '));

    // Query Payment History for every ID
    searchIds.forEach(function(sid) {
      getPaymentsForInvoice(sid).forEach(function(p) { addPayment(p, sid, ''); });
    });

    // 4. Milestone invoice sheet — Stripe-sent invoices for this project
    var milestoneSheet = spreadsheet.getSheetByName(PM_PROJECT_INVOICES_SHEET);
    if (milestoneSheet) {
      var milestoneData = milestoneSheet.getDataRange().getValues();
      for (var i = 1; i < milestoneData.length; i++) {
        if (String(milestoneData[i][1] || '').trim() !== String(projectId).trim()) continue;
        var invId    = String(milestoneData[i][0] || '').trim();
        var msName   = String(milestoneData[i][2] || '').trim();
        var msAmt    = parseFloat(milestoneData[i][3] || 0);
        var msStatus = String(milestoneData[i][4] || '').trim();
        var msDate   = milestoneData[i][6] ? new Date(milestoneData[i][6]).toISOString() : '';
        var invPays  = getPaymentsForInvoice(invId);
        if (invPays && invPays.length > 0) {
          invPays.forEach(function(p) { addPayment(p, invId, msName); });
        } else if (msStatus === 'Paid') {
          // No history row but sheet says Paid — synthetic entry
          addPayment({ amount: msAmt, date: msDate, method: 'Stripe', transactionId: 'MS-' + invId }, invId, msName);
        }
      }
    }

    function isCompletedLikeStatus(statusValue) {
      var s = String(statusValue || '').trim().toLowerCase();
      if (!s) return true; // Treat blank as completed for legacy/manual rows
      return s === 'completed' || s === 'paid' || s === 'succeeded' || s === 'success';
    }

    // 5. Fallback full scan — any row whose Invoice ID OR description/notes references projectId
    var h = readHistorySheet();
    if (h && h.idIdx >= 0) {
      for (var j = 1; j < h.rows.length; j++) {
        var hId     = String(h.rows[j][h.idIdx] || '').trim();
        var hStatus = h.statusIdx >= 0 ? String(h.rows[j][h.statusIdx] || '').trim() : 'Completed';
        var hDesc   = h.descIdx >= 0 ? String(h.rows[j][h.descIdx] || '') : '';
        var hNotes  = h.notesIdx >= 0 ? String(h.rows[j][h.notesIdx] || '') : '';
        var pidNorm = String(projectId || '').trim().toUpperCase();
        var idNorm = String(hId || '').toUpperCase();
        var descNorm = String(hDesc || '').toUpperCase();
        var notesNorm = String(hNotes || '').toUpperCase();
        var matchesProject = (idNorm && idNorm.indexOf(pidNorm) !== -1) ||
                             descNorm.indexOf(pidNorm) !== -1 ||
                             notesNorm.indexOf(pidNorm) !== -1;
        if (matchesProject && isCompletedLikeStatus(hStatus)) {
          addPayment(rowToPayment(h.rows[j], h, hId), hId, '');
        }
      }
    }

    Logger.log('✅ getProjectPaymentHistory: ' + payments.length + ' total payment(s), totalPaid=$' + totalPaid.toFixed(2));
    return { success: true, payments: payments, totalPaid: totalPaid };
  } catch(e) {
    Logger.log('getProjectPaymentHistory error: ' + e.toString());
    return { success: false, error: e.toString() };
  }
}

/**
 * Derives per-milestone paid status purely from Payment History.
 * Payment History is the single source of truth — JSON fields are ignored.
 *
 * Matching (in priority order):
 *  1. Description contains "[milestone:MilestoneName]" — written by recordManualPayment.
 *  2. Cumulative fallback — totalPaid covers the running milestone sum in order.
 *
 * Returns: { success, milestones: { id: { paid, amount, date, method } }, totalPaid, payments }
 */
function getMilestoneStatusFromHistory(projectId, linkedId) {
  try {
    var projectResult = getProject(projectId);
    if (!projectResult.success) return { success: false, error: projectResult.error };
    var projectData = projectResult.project;

    var schedule = projectData.paymentSchedule || [];
    if (typeof schedule === 'string') { try { schedule = JSON.parse(schedule); } catch(e2) { schedule = []; } }
    if (!schedule.length) return { success: true, milestones: {}, totalPaid: 0, payments: [] };

    var histResult = getProjectPaymentHistory(
      projectId,
      linkedId || projectData.estimateId || projectData.invoiceId || ''
    );
    var payments = (histResult.success ? histResult.payments : []) || [];
    var totalPaid = payments.reduce(function(s, p) { return s + parseFloat(p.amount || 0); }, 0);

    // Initialise all milestones as unpaid
    var milestoneStatus = {};
    schedule.forEach(function(ms) {
      milestoneStatus[String(ms.id)] = { paid: false, amount: 0, date: null, method: null };
    });

    // PASS 0 — Check Payment Allocations sheet for explicit milestone allocations
    // This is the primary source of truth for milestone payments
    var allocationResult = getPaymentAllocations(projectId);
    if (allocationResult.success && allocationResult.allocations) {
      var allocations = allocationResult.allocations;
      // Group allocations by milestone ID
      var allocationsByMilestone = {};
      allocations.forEach(function(alloc) {
        if (alloc.type === 'milestone' && alloc.milestoneId) {
          var msId = String(alloc.milestoneId);
          if (!allocationsByMilestone[msId]) {
            allocationsByMilestone[msId] = { amount: 0, date: null, method: null, allocations: [] };
          }
          allocationsByMilestone[msId].amount += alloc.amount;
          allocationsByMilestone[msId].allocations.push(alloc);
          if (!allocationsByMilestone[msId].date || new Date(alloc.date) > new Date(allocationsByMilestone[msId].date)) {
            allocationsByMilestone[msId].date = alloc.date;
            allocationsByMilestone[msId].method = alloc.method;
          }
        }
      });
      
      // Mark milestones with allocations as paid
      schedule.forEach(function(ms) {
        var msId = String(ms.id);
        if (allocationsByMilestone[msId]) {
          var msAmount = parseFloat(ms.amount || 0);
          var allocAmount = allocationsByMilestone[msId].amount;
          // Mark as paid if allocation >= milestone amount (or very close due to rounding)
          if (allocAmount >= msAmount - 0.01) {
            milestoneStatus[msId] = {
              paid: true,
              amount: allocAmount,
              date: allocationsByMilestone[msId].date,
              method: allocationsByMilestone[msId].method
            };
          }
        }
      });
      
      Logger.log('✅ getMilestoneStatusFromHistory: Checked ' + allocations.length + ' payment allocations');
    }

    // Pass 1 — explicit [milestone:Name] tag written by recordManualPayment
    var explicitTaggedMatchCount = 0;
    payments.forEach(function(p) {
      var desc = String(p.description || p.milestone || '');
      var match = desc.match(/\[milestone:([^\]]+)\]/i);
      if (!match) return;
      var paidName = match[1].trim().toLowerCase();
      schedule.forEach(function(ms) {
        if ((ms.name || '').toLowerCase() === paidName && !milestoneStatus[String(ms.id)].paid) {
          milestoneStatus[String(ms.id)] = {
            paid: true,
            amount: parseFloat(p.amount || 0),
            date: p.date,
            method: p.method
          };
          explicitTaggedMatchCount++;
        }
      });
    });

    // Pass 2 — cumulative allocation fallback.
    // Apply any remaining paid total to unpaid milestones in schedule order.
    // This keeps explicit matches while still handling untagged/legacy manual payments.
    var explicitlyAllocated = schedule.reduce(function(sum, ms) {
      var id = String(ms.id || '');
      var amt = parseFloat(ms.amount || 0) || 0;
      if (milestoneStatus[id] && milestoneStatus[id].paid) {
        return sum + amt;
      }
      return sum;
    }, 0);

    var remainingPaid = totalPaid - explicitlyAllocated;
    if (remainingPaid < 0) remainingPaid = 0;

    schedule.forEach(function(ms) {
      var id = String(ms.id || '');
      var amt = parseFloat(ms.amount || 0) || 0;
      if (!milestoneStatus[id]) return;
      if (milestoneStatus[id].paid) return;
      if (remainingPaid >= amt - 0.01) {
        milestoneStatus[id] = {
          paid: true,
          amount: amt,
          date: null,
          method: null
        };
        remainingPaid -= amt;
      }
    });

    // If project is fully paid by total dollars, force all milestones to paid.
    var scheduleTotal = schedule.reduce(function(sum, ms) {
      return sum + (parseFloat(ms.amount || 0) || 0);
    }, 0);
    if (totalPaid >= scheduleTotal - 0.01) {
      schedule.forEach(function(ms) {
        var id = String(ms.id || '');
        var amt = parseFloat(ms.amount || 0) || 0;
        milestoneStatus[id] = milestoneStatus[id] || { paid: false, amount: 0, date: null, method: null };
        milestoneStatus[id].paid = true;
        if (!(parseFloat(milestoneStatus[id].amount || 0) > 0)) {
          milestoneStatus[id].amount = amt;
        }
      });
    }

    return { success: true, milestones: milestoneStatus, totalPaid: totalPaid, payments: payments };
  } catch(e) {
    Logger.log('getMilestoneStatusFromHistory error: ' + e.toString());
    return { success: false, error: e.toString() };
  }
}

function money2_(n) {
  return Math.round((parseFloat(n || 0) || 0) * 100) / 100;
}

function recalculateProjectPaymentScheduleInternal_(projectId, newTotal, options) {
  options = options || {};
  try {
    if (!projectId) return { success: false, error: 'Project ID required' };

    var projectResult = getProject(projectId);
    if (!projectResult || !projectResult.success || !projectResult.project) {
      return { success: false, error: 'Project not found' };
    }

    var project = projectResult.project || {};
    var projectData = project.projectData || project;
    var total = money2_(newTotal != null && !isNaN(parseFloat(newTotal))
      ? parseFloat(newTotal)
      : (projectData.totalValue != null ? projectData.totalValue : projectData.total));
    if (total < 0) total = 0;

    var schedule = projectData.paymentSchedule || [];
    if (typeof schedule === 'string') {
      try { schedule = JSON.parse(schedule || '[]'); } catch (_) { schedule = []; }
    }
    if (!Array.isArray(schedule)) schedule = [];

    if (!schedule.length) {
      return { success: true, paymentSchedule: [], total: total, generated: false };
    }

    var oneOff = [];
    var regular = [];
    schedule.forEach(function(ms) {
      var row = ms || {};
      var isOneOff = row.type === 'one-off' || row.isOneOff === true;
      if (isOneOff) oneOff.push(row);
      else regular.push(row);
    });

    var oneOffTotal = money2_(oneOff.reduce(function(sum, ms) {
      return sum + money2_(ms.amount || ms.total || 0);
    }, 0));

    var distributable = money2_(Math.max(0, total - oneOffTotal));
    var pctSum = 0;

    regular.forEach(function(ms) {
      var pct = parseFloat(ms.percent);
      if (isNaN(pct) || pct < 0) pct = 0;
      ms.__pct = pct;
      pctSum += pct;
    });

    if (pctSum <= 0 && regular.length > 0) {
      var oldRegularTotal = money2_(regular.reduce(function(sum, ms) {
        return sum + money2_(ms.amount || ms.total || 0);
      }, 0));

      if (oldRegularTotal > 0) {
        pctSum = 0;
        regular.forEach(function(ms) {
          ms.__pct = (money2_(ms.amount || ms.total || 0) / oldRegularTotal) * 100;
          pctSum += ms.__pct;
        });
      } else {
        var evenPct = 100 / regular.length;
        pctSum = 100;
        regular.forEach(function(ms) { ms.__pct = evenPct; });
      }
    }

    var running = 0;
    regular.forEach(function(ms, idx) {
      var normalizedPct = pctSum > 0 ? (ms.__pct / pctSum) * 100 : 0;
      ms.percent = money2_(normalizedPct);
      if (idx < regular.length - 1) {
        ms.amount = money2_(distributable * (normalizedPct / 100));
        running = money2_(running + ms.amount);
      } else {
        ms.amount = money2_(distributable - running);
      }
      ms.total = ms.amount;
      delete ms.__pct;
    });

    var updatedSchedule = regular.concat(oneOff);

    if (options.save === true) {
      var saveResult = updateProject(projectId, {
        paymentSchedule: updatedSchedule,
        total: total,
        totalValue: total
      });
      if (!saveResult || !saveResult.success) {
        return { success: false, error: (saveResult && saveResult.error) || 'Failed to save updated schedule' };
      }
    }

    return {
      success: true,
      projectId: projectId,
      total: total,
      oneOffTotal: oneOffTotal,
      distributableTotal: distributable,
      paymentSchedule: updatedSchedule
    };
  } catch (error) {
    Logger.log('recalculateProjectPaymentScheduleInternal_ error: ' + error.toString());
    return { success: false, error: error.toString() };
  }
}

function saveProjectManualPaymentSchedule(projectId, scheduleJson, linkedId, replaceExistingFlag) {
  try {
    var pid = String(projectId || '').trim();
    if (!pid) return { success: false, error: 'Project ID required' };

    var projectResult = getProject(pid);
    if (!projectResult || !projectResult.success || !projectResult.project) {
      return { success: false, error: 'Project not found' };
    }

    var project = projectResult.project || {};
    var projectData = project.projectData || project;
    var total = money2_(projectData.totalValue != null ? projectData.totalValue : projectData.total);

    var existing = projectData.paymentSchedule || [];
    if (typeof existing === 'string') {
      try { existing = JSON.parse(existing || '[]'); } catch (_) { existing = []; }
    }
    if (!Array.isArray(existing) || existing.length === 0) {
      return { success: false, error: 'No project payment schedule found' };
    }

    var incoming = [];
    try {
      incoming = JSON.parse(String(scheduleJson || '[]'));
    } catch (parseErr) {
      return { success: false, error: 'Invalid schedule payload: ' + parseErr.toString() };
    }
    if (!Array.isArray(incoming)) incoming = [];
    var replaceExisting = String(replaceExistingFlag || '').toLowerCase() === 'true';

    var incomingById = {};
    var incomingOrder = [];
    incoming.forEach(function(ms) {
      var id = String(ms && ms.id || '').trim();
      if (!id) return;
      incomingById[id] = ms;
      incomingOrder.push(id);
    });

    var existingIdSet = {};
    existing.forEach(function(ms) {
      var id = String(ms && ms.id || '').trim();
      if (id) existingIdSet[id] = true;
    });

    function normalizeMilestoneKey_(value) {
      var raw = String(value == null ? '' : value).trim();
      if (!raw) return '';
      if (/^-?\d+(\.\d+)?$/.test(raw)) {
        var n = Number(raw);
        if (isFinite(n)) return String(n);
      }
      return raw.toLowerCase();
    }

    var resolvedLinkedId = linkedId || projectData.estimateId || projectData.invoiceId || project.linkedEstimateId || project.linkedInvoiceId || '';
    var hist = getMilestoneStatusFromHistory(pid, resolvedLinkedId);
    var histStatus = (hist && hist.success && hist.milestones) ? hist.milestones : {};
    var histStatusByNorm = {};
    Object.keys(histStatus || {}).forEach(function(k) {
      histStatusByNorm[normalizeMilestoneKey_(k)] = histStatus[k];
    });
    var projectStatusByNorm = {};
    Object.keys((projectData && projectData.milestoneStatus) || {}).forEach(function(k) {
      projectStatusByNorm[normalizeMilestoneKey_(k)] = projectData.milestoneStatus[k];
    });

    var oneOffTotal = 0;
    var regularTotal = 0;
    var lockedPaidTotal = 0;
    var editableTarget = 0;
    var editedUnpaidTotal = 0;
    var lockedMilestones = 0;

    var updated = existing.map(function(ms) {
      var row = Object.assign({}, ms || {});
      var id = String(row.id || '').trim();
      var isOneOff = row.type === 'one-off' || row.isOneOff === true;
      var idNorm = normalizeMilestoneKey_(id);
      var paidFromHistory = idNorm && histStatusByNorm[idNorm] && histStatusByNorm[idNorm].paid === true;
      var paidFromProject = idNorm && projectStatusByNorm[idNorm] && projectStatusByNorm[idNorm].paid === true;
      var paidFromRow = String(row.status || '').toLowerCase() === 'paid';
      var isPaidLocked = !!(paidFromHistory || paidFromProject || paidFromRow);
      var currentAmount = money2_(row.amount != null ? row.amount : row.total);

      if (isOneOff) {
        var proposedOneOff = incomingById[id] || null;
        if (proposedOneOff && !isPaidLocked) {
          var oneOffName = String(proposedOneOff.name || row.name || '').trim();
          var oneOffNotes = String(proposedOneOff.notes || row.notes || '').trim();
          var oneOffAmount = money2_(proposedOneOff.amount);
          if (oneOffAmount < 0) oneOffAmount = 0;
          row.name = oneOffName || row.name || 'Add-on Item';
          row.notes = oneOffNotes;
          row.items = Array.isArray(proposedOneOff.items) ? proposedOneOff.items : (Array.isArray(row.items) ? row.items : []);
          row.amount = oneOffAmount;
          row.total = oneOffAmount;
          row.type = 'one-off';
          row.isOneOff = true;
        } else {
          row.amount = currentAmount;
          row.total = currentAmount;
          row.type = 'one-off';
          row.isOneOff = true;
          row.items = Array.isArray(row.items) ? row.items : [];
        }
        oneOffTotal = money2_(oneOffTotal + money2_(row.amount));
        return row;
      }

      regularTotal = money2_(regularTotal + currentAmount);

      if (isPaidLocked) {
        row.amount = currentAmount;
        row.total = currentAmount;
        lockedPaidTotal = money2_(lockedPaidTotal + currentAmount);
        lockedMilestones++;
        return row;
      }

      editableTarget = money2_(editableTarget + currentAmount);
      var proposed = incomingById[id] || null;
      if (!proposed) {
        editedUnpaidTotal = money2_(editedUnpaidTotal + currentAmount);
        return row;
      }

      var newName = String(proposed.name || row.name || '').trim();
      var newNotes = String(proposed.notes || row.notes || '').trim();
      var newGroup = String(proposed.group || row.group || 'general').trim().toLowerCase();
      if (newGroup !== 'materials' && newGroup !== 'labor') newGroup = 'general';
      var newAmount = money2_(proposed.amount);
      if (newAmount < 0) newAmount = 0;

      row.name = newName || row.name || 'Milestone';
      row.notes = newNotes;
      row.group = newGroup;
      row.items = Array.isArray(proposed.items) ? proposed.items : (Array.isArray(row.items) ? row.items : []);
      row.amount = newAmount;
      row.total = newAmount;
      editedUnpaidTotal = money2_(editedUnpaidTotal + newAmount);
      return row;
    });

    // Append newly added rows from incoming payload
    incomingOrder.forEach(function(id) {
      if (!id || existingIdSet[id]) return;
      var incomingRow = incomingById[id] || {};
      var isIncomingOneOff = incomingRow.type === 'one-off' || incomingRow.isOneOff === true;

      var newName = String(incomingRow.name || 'Add-on Item').trim();
      var newNotes = String(incomingRow.notes || '').trim();
      var newAmount = money2_(incomingRow.amount);
      if (newAmount < 0) newAmount = 0;
      var newItems = Array.isArray(incomingRow.items) ? incomingRow.items : [];
      var newType = isIncomingOneOff ? 'one-off' : 'milestone';

      updated.push({
        id: id,
        name: newName || (isIncomingOneOff ? 'Add-on Item' : 'Milestone'),
        amount: newAmount,
        total: newAmount,
        percent: 0,
        type: newType,
        isOneOff: isIncomingOneOff,
        status: 'pending',
        notes: newNotes,
        group: isIncomingOneOff ? 'general' : String(incomingRow.group || 'general').toLowerCase(),
        items: newItems
      });

      if (isIncomingOneOff) {
        oneOffTotal = money2_(oneOffTotal + newAmount);
      } else {
        regularTotal = money2_(regularTotal + newAmount);
      }
      editedUnpaidTotal = money2_(editedUnpaidTotal + newAmount);
    });

    function isPaidLockedRow_(row) {
      var ms = row || {};
      var id = String(ms.id || '').trim();
      var idNorm = normalizeMilestoneKey_(id);
      var fromHist = idNorm && histStatusByNorm[idNorm] && histStatusByNorm[idNorm].paid === true;
      var fromProj = idNorm && projectStatusByNorm[idNorm] && projectStatusByNorm[idNorm].paid === true;
      var fromRow = String(ms.status || '').toLowerCase() === 'paid';
      return !!(fromHist || fromProj || fromRow);
    }

    // Replace mode: keep only incoming rows, plus any paid/locked milestones for history integrity.
    if (replaceExisting) {
      updated = updated.filter(function(ms) {
        var id = String(ms && ms.id || '').trim();
        if (!id) return false;
        if (incomingById[id]) return true;
        return isPaidLockedRow_(ms);
      });
    }

    // Recompute totals from final updated rows (important after replace mode filtering)
    oneOffTotal = 0;
    lockedPaidTotal = 0;
    editedUnpaidTotal = 0;
    lockedMilestones = 0;
    updated.forEach(function(ms) {
      var row = ms || {};
      var amt = money2_(row.amount != null ? row.amount : row.total);
      var isOneOff = row.type === 'one-off' || row.isOneOff === true;
      var isLockedPaid = isPaidLockedRow_(row);
      if (isOneOff) oneOffTotal = money2_(oneOffTotal + amt);
      if (isLockedPaid) {
        lockedPaidTotal = money2_(lockedPaidTotal + amt);
        lockedMilestones++;
      } else {
        editedUnpaidTotal = money2_(editedUnpaidTotal + amt);
      }
    });

    var targetUnpaid = money2_(Math.max(0, total - oneOffTotal - lockedPaidTotal));
    var unscheduledOutstanding = money2_(Math.max(0, targetUnpaid - editedUnpaidTotal));

    var updatedRegularTotal = money2_(updated.filter(function(ms) {
      return !(ms && (ms.type === 'one-off' || ms.isOneOff === true));
    }).reduce(function(sum, ms) {
      return sum + money2_(ms.amount != null ? ms.amount : ms.total);
    }, 0));

    updated = updated.map(function(ms) {
      var row = Object.assign({}, ms || {});
      var isOneOff = row.type === 'one-off' || row.isOneOff === true;
      if (!isOneOff) {
        var amt = money2_(row.amount != null ? row.amount : row.total);
        row.percent = updatedRegularTotal > 0 ? money2_((amt / updatedRegularTotal) * 100) : 0;
      }
      return row;
    });

    var saveResult = updateProject(pid, { paymentSchedule: updated });
    if (!saveResult || !saveResult.success) {
      return { success: false, error: (saveResult && saveResult.error) || 'Failed to save payment schedule' };
    }

    return {
        unscheduledOutstanding: unscheduledOutstanding,
      success: true,
      projectId: pid,
      paymentSchedule: updated,
      lockedMilestones: lockedMilestones,
      oneOffTotal: oneOffTotal,
      paidLockedTotal: lockedPaidTotal,
      unpaidTotal: editedUnpaidTotal
    };
  } catch (error) {
    Logger.log('saveProjectManualPaymentSchedule error: ' + error.toString());
    return { success: false, error: error.toString() };
  }
}

function getProjectBalanceBreakdown(projectId, linkedId) {
  try {
    if (!projectId) return { success: false, error: 'Project ID required' };

    var projectResult = getProject(projectId);
    if (!projectResult || !projectResult.success || !projectResult.project) {
      return { success: false, error: 'Project not found' };
    }

    var project = projectResult.project || {};
    var projectData = project.projectData || project;
    var resolvedLinkedId = linkedId || projectData.estimateId || projectData.invoiceId || project.estimateId || project.invoiceId || '';

    var schedule = projectData.paymentSchedule || [];
    if (typeof schedule === 'string') {
      try { schedule = JSON.parse(schedule || '[]'); } catch (_) { schedule = []; }
    }
    if (!Array.isArray(schedule)) schedule = [];

    var hist = getMilestoneStatusFromHistory(projectId, resolvedLinkedId);
    var milestoneStatus = (hist && hist.success && hist.milestones) ? hist.milestones : {};
    var totalPaid = money2_((hist && hist.success) ? (hist.totalPaid || 0) : 0);

    var totalContract = money2_(projectData.totalValue != null ? projectData.totalValue : (projectData.total != null ? projectData.total : 0));
    var rows = schedule.map(function(ms) {
      var milestoneId = String(ms && ms.id || '');
      var statusRow = milestoneStatus[milestoneId] || {};
      var amount = money2_(ms && (ms.amount != null ? ms.amount : ms.total) || 0);
      var isPaid = statusRow.paid === true;
      var paidAmount = isPaid ? money2_(statusRow.amount || amount) : 0;
      var owed = isPaid ? 0 : amount;
      return {
        id: milestoneId,
        name: String(ms && ms.name || 'Milestone'),
        type: String(ms && ms.type || ''),
        amount: amount,
        paid: isPaid,
        paidAmount: paidAmount,
        owed: owed,
        paidDate: statusRow.date || '',
        method: statusRow.method || ''
      };
    });

    var totalScheduled = money2_(rows.reduce(function(sum, row) { return sum + money2_(row.amount || 0); }, 0));
    if (totalContract <= 0.01) totalContract = totalScheduled;
    var totalOwed = money2_(Math.max(0, totalContract - totalPaid));

    // Partial payments: per-milestone owed must sum to totalOwed (not full schedule amounts).
    if (totalOwed > 0.01) {
      var unpaidRows = rows.filter(function(row) { return !row.paid; });
      var sumUnpaidSchedule = money2_(unpaidRows.reduce(function(sum, row) {
        return sum + money2_(row.owed || 0);
      }, 0));
      if (sumUnpaidSchedule > totalOwed + 0.01 && unpaidRows.length > 0) {
        if (unpaidRows.length === 1) {
          unpaidRows[0].owed = totalOwed;
        } else {
          var allocated = 0;
          for (var ui = 0; ui < unpaidRows.length; ui++) {
            var uRow = unpaidRows[ui];
            if (ui === unpaidRows.length - 1) {
              uRow.owed = money2_(Math.max(0, totalOwed - allocated));
            } else {
              var share = totalOwed * (money2_(uRow.amount || 0) / sumUnpaidSchedule);
              uRow.owed = money2_(share);
              allocated += uRow.owed;
            }
          }
        }
      }
    }

    // When fully paid by payment-history totals, mirror that state across milestones.
    if (totalOwed <= 0.01) {
      rows = rows.map(function(row) {
        row.paid = true;
        row.owed = 0;
        if (!(parseFloat(row.paidAmount || 0) > 0)) {
          row.paidAmount = row.amount;
        }
        return row;
      });
    }

    return {
      success: true,
      projectId: projectId,
      linkedId: resolvedLinkedId,
      customerName: String(projectData.customerName || ''),
      customerEmail: String(projectData.customerEmail || ''),
      totalContract: totalContract,
      totalScheduled: totalScheduled,
      totalPaid: totalPaid,
      totalOwed: totalOwed,
      rows: rows,
      payments: (hist && hist.success && Array.isArray(hist.payments)) ? hist.payments : []
    };
  } catch (error) {
    Logger.log('getProjectBalanceBreakdown error: ' + error.toString());
    return { success: false, error: error.toString() };
  }
}

