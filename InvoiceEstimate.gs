/**
 * Update invoice status
 */
function updateInvoiceStatus(id, status) {
  try {
    const spreadsheet = SpreadsheetApp.openById(SPREADSHEET_ID);
    const sheet = spreadsheet.getSheetByName(INVOICES_ESTIMATES_SHEET);
    
    if (!sheet) {
      return { success: false, error: 'Sheet not found' };
    }
    
    const lastRow = sheet.getLastRow();
    if (lastRow < 2) {
      return { success: false, error: 'Invoice/Estimate not found' };
    }
    
    // SIMPLIFIED: Find by ID (Column 1) and update JSON (Column 3)
    for (let rowNum = 2; rowNum <= lastRow; rowNum++) {
      const invoiceId = sheet.getRange(rowNum, 1).getValue();
      if (invoiceId === id) {
        try {
          const jsonPart1 = sheet.getRange(rowNum, 3).getValue() || '';
          const jsonPart2 = sheet.getRange(rowNum, 4).getValue() || '';
          const jsonPart3 = sheet.getRange(rowNum, 5).getValue() || '';
          let jsonStr = concatenateJsonChunks(jsonPart1, jsonPart2, jsonPart3);
          if (!jsonStr || jsonStr.length === 0) {
            jsonStr = String(jsonPart1 || '').trim();
          }
          if (jsonStr && jsonStr.startsWith('{')) {
            const jsonData = JSON.parse(jsonStr);
            jsonData.status = status;
            jsonData.lastModified = new Date();
            const updatedJson = JSON.stringify(jsonData);
            // Split and write back to columns 3, 4, 5
            const updatedChunks = splitJsonString(updatedJson);
            sheet.getRange(rowNum, 3, 1, 3).setValues([[updatedChunks[0] || '', updatedChunks[1] || '', updatedChunks[2] || '']]);
            SpreadsheetApp.flush();
        return { success: true, message: 'Status updated' };
          }
        } catch (e) {
          Logger.log('Error updating JSON at row ' + rowNum + ': ' + e.toString());
          return { success: false, error: 'Error updating status: ' + e.toString() };
        }
      }
    }
    
    return { success: false, error: 'Invoice/Estimate not found' };
  } catch (error) {
    Logger.log('Error updating status: ' + error.toString());
    return { success: false, error: error.toString() };
  }
}

/**
 * Create Stripe Invoice for invoice payment (when processing fee is included)
 */
function stripeFormEncode_(payload) {
  return Object.keys(payload || {}).map(function(key) {
    var value = payload[key];
    if (value === undefined || value === null) value = '';
    return encodeURIComponent(key) + '=' + encodeURIComponent(String(value));
  }).join('&');
}

function stripeCreatePendingInvoiceItem_(customerId, amountCents, description, metadata) {
  try {
    var payload = {
      customer: customerId,
      amount: String(Math.round(amountCents || 0)),
      currency: 'usd',
      description: String(description || 'Invoice item').substring(0, 1000)
    };
    metadata = metadata || {};
    Object.keys(metadata).forEach(function(key) {
      payload['metadata[' + key + ']'] = String(metadata[key] == null ? '' : metadata[key]).substring(0, 500);
    });

    var response = UrlFetchApp.fetch(STRIPE_API_URL + '/invoiceitems', {
      method: 'post',
      headers: {
        'Authorization': 'Bearer ' + STRIPE_SECRET_KEY,
        'Content-Type': 'application/x-www-form-urlencoded'
      },
      payload: stripeFormEncode_(payload),
      muteHttpExceptions: true
    });

    var code = response.getResponseCode();
    var text = response.getContentText();
    if (code !== 200) {
      Logger.log('❌ Stripe invoice item error: ' + code + ' -> ' + text);
      return { success: false, error: 'Stripe invoice item error: ' + code, responseText: text };
    }

    var parsed = JSON.parse(text);
    return { success: true, itemId: parsed.id, item: parsed };
  } catch (error) {
    Logger.log('stripeCreatePendingInvoiceItem_: ' + error.toString());
    return { success: false, error: error.toString() };
  }
}

function stripeDeleteInvoiceItemSafe_(invoiceItemId) {
  try {
    if (!invoiceItemId) return;
    UrlFetchApp.fetch(STRIPE_API_URL + '/invoiceitems/' + encodeURIComponent(invoiceItemId), {
      method: 'delete',
      headers: {
        'Authorization': 'Bearer ' + STRIPE_SECRET_KEY
      },
      muteHttpExceptions: true
    });
  } catch (error) {
    Logger.log('stripeDeleteInvoiceItemSafe_: ' + error.toString());
  }
}

function createStripeInvoice(data) {
  try {
    const invoiceId = data.invoiceId;
    const totalAmount = parseFloat(data.amount); // Total including processing fee
    const baseAmount = parseFloat(data.baseAmount || data.amount);
    const processingFee = parseFloat(data.processingFee || 0);
    const customerEmail = data.customerEmail;
    const customerName = data.customerName || '';
    const invoiceNumber = data.invoiceNumber || invoiceId;
    
    if (!invoiceId || !totalAmount || totalAmount <= 0) {
      return { success: false, error: 'Invalid invoice data' };
    }
    
    // Create or get Stripe customer - REQUIRED for invoices
    let customerId = null;
    try {
      const customerResult = createOrGetStripeCustomer(customerEmail, customerName);
      if (customerResult.success) {
        customerId = customerResult.customerId;
        Logger.log('✅ Stripe customer found/created: ' + customerId);
      } else {
        Logger.log('❌ Failed to create/get Stripe customer: ' + (customerResult.error || 'Unknown error'));
        return { success: false, error: 'Failed to create Stripe customer: ' + (customerResult.error || 'Unknown error') };
      }
    } catch (error) {
      Logger.log('Error creating/getting customer: ' + error.toString());
      return { success: false, error: 'Failed to create Stripe customer: ' + error.toString() };
    }
    
    if (!customerId) {
      return { success: false, error: 'Customer ID is required for Stripe invoice' };
    }
    
    const createdInvoiceItemIds = [];

    // Create pending invoice items first (Stripe no longer accepts line_items directly on /invoices)
    const baseItemResult = stripeCreatePendingInvoiceItem_(
      customerId,
      Math.round(baseAmount * 100),
      'Invoice ' + String(invoiceNumber).substring(0, 100) + ' — Base Invoice Amount',
      {
        invoice_id: invoiceId,
        invoice_number: invoiceNumber,
        line_type: 'base_amount'
      }
    );
    if (!baseItemResult.success) {
      return { success: false, error: baseItemResult.error || 'Failed to create base Stripe invoice item' };
    }
    createdInvoiceItemIds.push(baseItemResult.itemId);

    if (processingFee > 0) {
      const feeItemResult = stripeCreatePendingInvoiceItem_(
        customerId,
        Math.round(processingFee * 100),
        'Processing Fee (2.9% + $0.29)',
        {
          invoice_id: invoiceId,
          invoice_number: invoiceNumber,
          line_type: 'processing_fee'
        }
      );
      if (!feeItemResult.success) {
        createdInvoiceItemIds.forEach(stripeDeleteInvoiceItemSafe_);
        return { success: false, error: feeItemResult.error || 'Failed to create processing fee invoice item' };
      }
      createdInvoiceItemIds.push(feeItemResult.itemId);
    }

    // Create invoice after pending items exist
    const invoicePayload = {
      'customer': customerId,
      'collection_method': 'send_invoice',
      'days_until_due': 30,
      'metadata[invoice_id]': String(invoiceId).substring(0, 200),
      'metadata[invoice_number]': String(invoiceNumber).substring(0, 200),
      'metadata[base_amount]': String(baseAmount.toFixed(2)),
      'metadata[processing_fee]': String(processingFee.toFixed(2))
    };
    
    const invoiceOptions = {
      method: 'post',
      headers: {
        'Authorization': 'Bearer ' + STRIPE_SECRET_KEY,
        'Content-Type': 'application/x-www-form-urlencoded'
      },
      payload: stripeFormEncode_(invoicePayload),
      muteHttpExceptions: true
    };
    
    Logger.log('Creating Stripe Invoice for invoice: ' + invoiceId + ', total: $' + totalAmount.toFixed(2));
    
    let response = UrlFetchApp.fetch(STRIPE_API_URL + '/invoices', invoiceOptions);
    let responseCode = response.getResponseCode();
    let responseText = response.getContentText();
    
    if (responseCode !== 200) {
      Logger.log('❌ Stripe Invoice API Error: ' + responseCode);
      Logger.log('Response: ' + responseText);
      createdInvoiceItemIds.forEach(stripeDeleteInvoiceItemSafe_);
      return { success: false, error: 'Failed to create Stripe invoice: ' + responseCode };
    }
    
    const invoice = JSON.parse(responseText);
    
    // Finalize the invoice
    try {
      const finalizeResponse = UrlFetchApp.fetch(STRIPE_API_URL + '/invoices/' + invoice.id + '/finalize', {
        method: 'post',
        headers: {
          'Authorization': 'Bearer ' + STRIPE_SECRET_KEY
        },
        muteHttpExceptions: true
      });
      
      if (finalizeResponse.getResponseCode() === 200) {
        const finalizedInvoice = JSON.parse(finalizeResponse.getContentText());
        // Send the invoice
        try {
          UrlFetchApp.fetch(STRIPE_API_URL + '/invoices/' + finalizedInvoice.id + '/send', {
            method: 'post',
            headers: {
              'Authorization': 'Bearer ' + STRIPE_SECRET_KEY
            },
            muteHttpExceptions: true
          });
        } catch (e) {
          Logger.log('Note: Invoice created but may need to be sent manually');
        }
        
        return {
          success: true,
          invoiceId: finalizedInvoice.id,
          invoiceUrl: finalizedInvoice.hosted_invoice_url || finalizedInvoice.invoice_pdf,
          paymentUrl: finalizedInvoice.hosted_invoice_url
        };
      }
    } catch (error) {
      Logger.log('Error finalizing invoice: ' + error.toString());
    }
    
    return {
      success: true,
      invoiceId: invoice.id,
      invoiceUrl: invoice.hosted_invoice_url || invoice.invoice_pdf,
      paymentUrl: invoice.hosted_invoice_url
    };
    
  } catch (error) {
    Logger.log('❌ Error creating Stripe invoice: ' + error.toString());
    return { success: false, error: error.toString() };
  }
}

/**
 * Create duplicate Stripe invoice (not sent to customer) for internal tracking
 * This invoice mirrors the invoice in our system and is marked as paid when payment is received
 */
function createDuplicateStripeInvoice(data) {
  try {
    const invoiceId = data.invoiceId;
    const totalAmount = parseFloat(data.amount); // Total including processing fee
    const baseAmount = parseFloat(data.baseAmount || data.amount);
    const processingFee = parseFloat(data.processingFee || 0);
    const customerEmail = data.customerEmail;
    const customerName = data.customerName || '';
    const customerAddress = data.customerAddress || '';
    const invoiceNumber = data.invoiceNumber || invoiceId;
    const items = data.items ? JSON.parse(data.items) : [];
    
    if (!invoiceId || !totalAmount || totalAmount <= 0) {
      return { success: false, error: 'Invalid invoice data' };
    }
    
    // Create or get Stripe customer
    let customerId = null;
    try {
      const customerResult = createOrGetStripeCustomer(customerEmail, customerName);
      if (customerResult.success) {
        customerId = customerResult.customerId;
        Logger.log('✅ Stripe customer found/created for duplicate invoice: ' + customerId);
      } else {
        Logger.log('❌ Failed to create/get Stripe customer: ' + (customerResult.error || 'Unknown error'));
        return { success: false, error: 'Failed to create Stripe customer: ' + (customerResult.error || 'Unknown error') };
      }
    } catch (error) {
      Logger.log('Error creating/getting customer: ' + error.toString());
      return { success: false, error: 'Failed to create Stripe customer: ' + error.toString() };
    }
    
    if (!customerId) {
      return { success: false, error: 'Customer ID is required for Stripe invoice' };
    }
    
    const createdInvoiceItemIds = [];

    // Create pending invoice items first (required by current Stripe invoice API)
    let itemIndex = 0;
    const itemsToAdd = items.filter(function(item) { return !item.isProcessingFee; });

    for (let i = 0; i < itemsToAdd.length && itemIndex < 100; i++) {
      const item = itemsToAdd[i];
      const itemPrice = parseFloat(item.price || 0);
      const itemQuantity = parseFloat(item.quantity || 1);
      const itemTotal = itemPrice * itemQuantity;

      if (itemTotal > 0) {
        const lineName = String(item.name || 'Item').substring(0, 100);
        const lineDesc = String(item.description || '').substring(0, 400);
        const combinedDescription = lineName
          + (itemQuantity !== 1 ? (' (Qty ' + itemQuantity + ' @ $' + itemPrice.toFixed(2) + ')') : '')
          + (lineDesc ? (' — ' + lineDesc) : '');
        const lineResult = stripeCreatePendingInvoiceItem_(
          customerId,
          Math.round(itemTotal * 100),
          combinedDescription,
          {
            invoice_id: invoiceId,
            invoice_number: invoiceNumber,
            line_type: 'item',
            line_index: itemIndex,
            internal_only: 'true'
          }
        );
        if (!lineResult.success) {
          createdInvoiceItemIds.forEach(stripeDeleteInvoiceItemSafe_);
          return { success: false, error: lineResult.error || 'Failed to create Stripe invoice item' };
        }
        createdInvoiceItemIds.push(lineResult.itemId);
        itemIndex++;
      }
    }

    if (processingFee > 0) {
      const feeLineResult = stripeCreatePendingInvoiceItem_(
        customerId,
        Math.round(processingFee * 100),
        'Processing Fee (2.9% + $0.29)',
        {
          invoice_id: invoiceId,
          invoice_number: invoiceNumber,
          line_type: 'processing_fee',
          internal_only: 'true'
        }
      );
      if (!feeLineResult.success) {
        createdInvoiceItemIds.forEach(stripeDeleteInvoiceItemSafe_);
        return { success: false, error: feeLineResult.error || 'Failed to create processing fee invoice item' };
      }
      createdInvoiceItemIds.push(feeLineResult.itemId);
    }

    // Fallback if line items array was empty
    if (createdInvoiceItemIds.length === 0) {
      const fallbackLine = stripeCreatePendingInvoiceItem_(
        customerId,
        Math.round(baseAmount * 100),
        'Invoice ' + String(invoiceNumber).substring(0, 100) + ' — Base Invoice Amount',
        {
          invoice_id: invoiceId,
          invoice_number: invoiceNumber,
          line_type: 'base_amount',
          internal_only: 'true'
        }
      );
      if (!fallbackLine.success) {
        return { success: false, error: fallbackLine.error || 'Failed to create fallback invoice item' };
      }
      createdInvoiceItemIds.push(fallbackLine.itemId);
    }

    // Create invoice with auto_advance: false so it doesn't auto-finalize
    const invoicePayload = {
      'customer': customerId,
      'collection_method': 'send_invoice',
      'auto_advance': 'false', // Don't auto-finalize - we'll mark as paid manually
      'days_until_due': 30,
      'metadata[invoice_id]': String(invoiceId).substring(0, 200),
      'metadata[invoice_number]': String(invoiceNumber).substring(0, 200),
      'metadata[base_amount]': String(baseAmount.toFixed(2)),
      'metadata[processing_fee]': String(processingFee.toFixed(2)),
      'metadata[is_duplicate]': 'true', // Mark as duplicate for tracking
      'metadata[internal_only]': 'true' // Mark as internal only
    };
    
    const invoiceOptions = {
      method: 'post',
      headers: {
        'Authorization': 'Bearer ' + STRIPE_SECRET_KEY,
        'Content-Type': 'application/x-www-form-urlencoded'
      },
      payload: stripeFormEncode_(invoicePayload),
      muteHttpExceptions: true
    };
    
    Logger.log('Creating duplicate Stripe Invoice for invoice: ' + invoiceId + ', total: $' + totalAmount.toFixed(2));
    
    let response = UrlFetchApp.fetch(STRIPE_API_URL + '/invoices', invoiceOptions);
    let responseCode = response.getResponseCode();
    let responseText = response.getContentText();
    
    if (responseCode !== 200) {
      Logger.log('❌ Stripe Invoice API Error: ' + responseCode);
      Logger.log('Response: ' + responseText);
      createdInvoiceItemIds.forEach(stripeDeleteInvoiceItemSafe_);
      return { success: false, error: 'Failed to create duplicate Stripe invoice: ' + responseCode };
    }
    
    const invoice = JSON.parse(responseText);
    
    // Finalize the invoice (but don't send it)
    try {
      const finalizeResponse = UrlFetchApp.fetch(STRIPE_API_URL + '/invoices/' + invoice.id + '/finalize', {
        method: 'post',
        headers: {
          'Authorization': 'Bearer ' + STRIPE_SECRET_KEY
        },
        muteHttpExceptions: true
      });
      
      if (finalizeResponse.getResponseCode() === 200) {
        const finalizedInvoice = JSON.parse(finalizeResponse.getContentText());
        Logger.log('✅ Duplicate Stripe invoice created and finalized (not sent): ' + finalizedInvoice.id);
        
        return {
          success: true,
          invoiceId: finalizedInvoice.id,
          invoiceUrl: finalizedInvoice.hosted_invoice_url || finalizedInvoice.invoice_pdf,
          paymentUrl: finalizedInvoice.hosted_invoice_url
        };
      }
    } catch (error) {
      Logger.log('Error finalizing duplicate invoice: ' + error.toString());
    }
    
    return {
      success: true,
      invoiceId: invoice.id,
      invoiceUrl: invoice.hosted_invoice_url || invoice.invoice_pdf,
      paymentUrl: invoice.hosted_invoice_url
    };
    
  } catch (error) {
    Logger.log('❌ Error creating duplicate Stripe invoice: ' + error.toString());
    return { success: false, error: error.toString() };
  }
}

/**
 * Mark duplicate Stripe invoice as paid (void it or mark as paid)
 */
function markDuplicateStripeInvoiceAsPaid(stripeInvoiceId, paymentIntentId) {
  try {
    if (!stripeInvoiceId) {
      Logger.log('⚠️ No Stripe invoice ID provided to mark as paid');
      return { success: false, error: 'Stripe invoice ID required' };
    }
    
    // Void the invoice to mark it as paid (since we don't want to charge the customer)
    // Alternatively, we can just leave it as finalized but not sent
    // For now, we'll void it to indicate it's been paid
    const voidResponse = UrlFetchApp.fetch(STRIPE_API_URL + '/invoices/' + stripeInvoiceId + '/void', {
      method: 'post',
      headers: {
        'Authorization': 'Bearer ' + STRIPE_SECRET_KEY
      },
      muteHttpExceptions: true
    });
    
    if (voidResponse.getResponseCode() === 200) {
      Logger.log('✅ Duplicate Stripe invoice marked as paid (voided): ' + stripeInvoiceId);
      return { success: true };
    } else {
      // If voiding fails, try to mark as paid by updating metadata
      Logger.log('⚠️ Could not void invoice, updating metadata instead');
      const updateResponse = UrlFetchApp.fetch(STRIPE_API_URL + '/invoices/' + stripeInvoiceId, {
        method: 'post',
        headers: {
          'Authorization': 'Bearer ' + STRIPE_SECRET_KEY,
          'Content-Type': 'application/x-www-form-urlencoded'
        },
        payload: {
          'metadata[paid_via]': paymentIntentId || 'manual',
          'metadata[paid_date]': new Date().toISOString()
        },
        muteHttpExceptions: true
      });
      
      if (updateResponse.getResponseCode() === 200) {
        Logger.log('✅ Duplicate Stripe invoice metadata updated: ' + stripeInvoiceId);
        return { success: true };
      }
    }
    
    return { success: false, error: 'Could not mark invoice as paid' };
  } catch (error) {
    Logger.log('❌ Error marking duplicate Stripe invoice as paid: ' + error.toString());
    return { success: false, error: error.toString() };
  }
}

/**
 * Create or get Stripe customer
 * Always creates a customer in Stripe for tracking and invoice management
 */
function createOrGetStripeCustomer(email, name) {
  try {
    if (!email || email.trim() === '') {
      return { success: false, error: 'Email is required to create Stripe customer' };
    }
    
    // Search for existing customer by email
    const searchResponse = UrlFetchApp.fetch(STRIPE_API_URL + '/customers/search?query=email:\'' + encodeURIComponent(email) + '\'', {
      method: 'get',
      headers: {
        'Authorization': 'Bearer ' + STRIPE_SECRET_KEY
      },
      muteHttpExceptions: true
    });
    
    if (searchResponse.getResponseCode() === 200) {
      const searchResult = JSON.parse(searchResponse.getContentText());
      if (searchResult.data && searchResult.data.length > 0) {
        Logger.log('✅ Found existing Stripe customer: ' + searchResult.data[0].id);
        return { success: true, customerId: searchResult.data[0].id };
      }
    }
    
    // Create new customer
    const customerPayload = {
      'email': email.trim(),
      'name': name || email.trim(),
      'metadata[source]': 'invoice_system',
      'metadata[created_via]': 'google_apps_script'
    };
    
    Logger.log('Creating new Stripe customer for: ' + email);
    
    const customerResponse = UrlFetchApp.fetch(STRIPE_API_URL + '/customers', {
      method: 'post',
      headers: {
        'Authorization': 'Bearer ' + STRIPE_SECRET_KEY,
        'Content-Type': 'application/x-www-form-urlencoded'
      },
      payload: customerPayload,
      muteHttpExceptions: true
    });
    
    const responseCode = customerResponse.getResponseCode();
    const responseText = customerResponse.getContentText();
    
    if (responseCode === 200) {
      const customer = JSON.parse(responseText);
      Logger.log('✅ Created new Stripe customer: ' + customer.id);
      return { success: true, customerId: customer.id };
    } else {
      Logger.log('❌ Failed to create Stripe customer: ' + responseCode + ' - ' + responseText);
      try {
        const errorData = JSON.parse(responseText);
        return { success: false, error: errorData.error?.message || 'Failed to create customer' };
      } catch (e) {
        return { success: false, error: 'Failed to create customer: ' + responseCode };
      }
    }
  } catch (error) {
    Logger.log('Error in createOrGetStripeCustomer: ' + error.toString());
    return { success: false, error: error.toString() };
  }
}

/**
 * Create Stripe Checkout Session for invoice payment
 */
function createStripeCheckoutSession(data) {
  try {
    const parseBooleanFlag = (value, defaultValue) => {
      if (value === undefined || value === null || value === '') return defaultValue;
      if (typeof value === 'boolean') return value;
      if (typeof value === 'number') return value !== 0;
      const normalized = String(value).trim().toLowerCase();
      if (['true', '1', 'yes', 'y', 'on'].indexOf(normalized) !== -1) return true;
      if (['false', '0', 'no', 'n', 'off'].indexOf(normalized) !== -1) return false;
      return defaultValue;
    };

    const invoiceId = data.invoiceId;
    const baseAmount = parseFloat(data.amount); // Original invoice amount
    const customerEmail = data.customerEmail;
    const invoiceNumber = data.invoiceNumber || invoiceId;
    // Never auto-add processing fee in Stripe checkout.
    // Fee handling is controlled by invoice line items in this system.
    const addProcessingFee = false;
    
    if (!invoiceId || !baseAmount || baseAmount <= 0) {
      return { success: false, error: 'Invalid invoice data' };
    }
    
    // Processing fee is optional and must follow caller choice exactly
    const processingFee = 0;
    const amountInCents = Math.round(baseAmount * 100); // Convert to cents (no fee added)
    
    // Get web app URL for success/cancel URLs
    const webAppUrl = ScriptApp.getService().getUrl();
    
    // Redirect to invoice viewer after payment (so review popup can appear)
    const successUrl = WEBFLOW_INVOICE_VIEWER_URL + '?id=' + encodeURIComponent(invoiceId) + '&payment=success';
    const cancelUrl = WEBFLOW_INVOICE_VIEWER_URL + '?id=' + encodeURIComponent(invoiceId) + '&payment=cancelled';
    
    // Use Checkout Sessions directly (more reliable than Payment Links API)
    // Payment Links API may require additional account setup
    const checkoutUrl = STRIPE_API_URL + '/checkout/sessions';
    
    const checkoutPayload = {
      'payment_method_types[]': 'card',
      'mode': 'payment',
      'success_url': successUrl,
      'cancel_url': cancelUrl,
      'customer_email': customerEmail || '',
      'line_items[0][price_data][currency]': 'usd',
      'line_items[0][price_data][product_data][name]': 'Invoice ' + String(invoiceNumber).substring(0, 100),
      'line_items[0][price_data][product_data][description]': addProcessingFee
        ? `Invoice base amount: $${baseAmount.toFixed(2)}. Processing fee is added as a separate line item.`.substring(0, 500)
        : `Invoice amount: $${baseAmount.toFixed(2)}`.substring(0, 500),
      'line_items[0][price_data][unit_amount]': String(amountInCents),
      'line_items[0][quantity]': '1',
      'metadata[invoice_id]': String(invoiceId).substring(0, 200),
      'metadata[invoice_number]': String(invoiceNumber).substring(0, 200),
      'metadata[base_amount]': String(baseAmount.toFixed(2)),
      'metadata[processing_fee]': String(processingFee.toFixed(2)),
      'metadata[add_processing_fee]': addProcessingFee ? 'true' : 'false',
      'metadata[total_charge_amount]': String((baseAmount + processingFee).toFixed(2))
    };

    if (addProcessingFee && processingFee > 0) {
      checkoutPayload['line_items[1][price_data][currency]'] = 'usd';
      checkoutPayload['line_items[1][price_data][product_data][name]'] = 'Processing Fee';
      checkoutPayload['line_items[1][price_data][product_data][description]'] = 'Credit card processing fee (2.9% + $0.29)';
      checkoutPayload['line_items[1][price_data][unit_amount]'] = String(Math.round(processingFee * 100));
      checkoutPayload['line_items[1][quantity]'] = '1';
      checkoutPayload['custom_text[submit][message]'] = 'Checkout total includes base amount + processing fee.';
    }
    
    const checkoutOptions = {
      method: 'post',
      headers: {
        'Authorization': 'Bearer ' + STRIPE_SECRET_KEY,
        'Content-Type': 'application/x-www-form-urlencoded'
      },
      payload: checkoutPayload,
      muteHttpExceptions: true
    };
    
    Logger.log('Creating Stripe Checkout Session for invoice: ' + invoiceId + ', amount: $' + baseAmount.toFixed(2));
    
    let response = UrlFetchApp.fetch(checkoutUrl, checkoutOptions);
    let responseCode = response.getResponseCode();
    let responseText = response.getContentText();
    
    // Log error details for debugging
    if (responseCode !== 200) {
      Logger.log('❌ Checkout Session API Error: ' + responseCode);
      Logger.log('Response: ' + responseText);
      try {
        const errorData = JSON.parse(responseText);
        Logger.log('Stripe Error Message: ' + (errorData.error?.message || errorData.message || 'Unknown error'));
        Logger.log('Stripe Error Type: ' + (errorData.error?.type || 'Unknown'));
        Logger.log('Stripe Error Code: ' + (errorData.error?.code || 'Unknown'));
      } catch (e) {
        Logger.log('Could not parse error response');
      }
    }
    
    if (responseCode !== 200) {
      let errorMessage = 'Failed to create payment link: ' + responseCode;
      try {
        const errorData = JSON.parse(responseText);
        errorMessage = errorData.error?.message || errorData.message || errorMessage;
      } catch (e) {
        // Use default error message
      }
      Logger.log('Stripe API error: ' + responseCode + ' - ' + responseText);
      return { success: false, error: errorMessage };
    }
    
    const result = JSON.parse(responseText);
    
    // Record payment link creation in invoice metadata
    if (result.url) {
      try {
        const spreadsheet = SpreadsheetApp.openById(SPREADSHEET_ID);
        const sheet = spreadsheet.getSheetByName(INVOICES_ESTIMATES_SHEET);
        if (sheet) {
          const dataRows = sheet.getDataRange().getValues();
          for (let i = 1; i < dataRows.length; i++) {
            if (String(dataRows[i][0]).trim() === String(invoiceId).trim()) {
              // Store payment link in invoice JSON metadata
              const jsonChunks = [
                dataRows[i][2] || '', // JSON Part 1
                dataRows[i][3] || '', // JSON Part 2
                dataRows[i][4] || ''  // JSON Part 3
              ];
              const fullJson = concatenateJsonChunks(jsonChunks[0], jsonChunks[1], jsonChunks[2]);
              if (fullJson) {
                try {
                  const invoiceData = JSON.parse(fullJson);
                  invoiceData.paymentLink = result.url;
                  invoiceData.paymentLinkId = result.id;
                  invoiceData.processingFee = processingFee;
                  invoiceData.processingFeeNote = 'Stripe automatically charges 2.9% + $0.29 processing fee';
                  if (customerId) {
                    invoiceData.stripeCustomerId = customerId;
                  }
                  
                  const updatedJson = JSON.stringify(invoiceData);
                  const updatedChunks = splitJsonString(updatedJson);
                  sheet.getRange(i + 1, 3, 1, 3).setValues([[updatedChunks[0], updatedChunks[1], updatedChunks[2]]]);
                  SpreadsheetApp.flush();
                } catch (e) {
                  Logger.log('Error updating invoice with payment link: ' + e.toString());
                }
              }
              break;
            }
          }
        }
      } catch (e) {
        Logger.log('Error recording payment link: ' + e.toString());
      }
    }
    
    return {
      success: true,
      paymentUrl: result.url,
      paymentLinkId: result.id,
      baseAmount: baseAmount,
      processingFee: processingFee,
      totalAmount: baseAmount + processingFee,
      addProcessingFee: addProcessingFee,
      feePercentage: (STRIPE_PROCESSING_FEE_RATE * 100).toFixed(1) + '%',
      note: addProcessingFee
        ? 'Checkout total includes the configured 2.9% + $0.29 processing fee.'
        : 'No processing fee was added to this checkout session.'
    };
  } catch (error) {
    Logger.log('Error creating Stripe checkout: ' + error.toString());
    return { success: false, error: error.toString() };
  }
}

/**
 * Send payment link to customer via email
 */
function sendPaymentLink(data) {
  try {
    const invoiceId = data.invoiceId;
    const customerEmail = data.customerEmail;
    
    if (!invoiceId || !customerEmail) {
      return { success: false, error: 'Invoice ID and customer email are required' };
    }
    
    // Get invoice data
    const invoiceResult = getInvoiceEstimate(invoiceId);
    if (!invoiceResult.success || !invoiceResult.data) {
      return { success: false, error: 'Invoice not found' };
    }
    
    const invoiceData = invoiceResult.data;

    const invoiceTotal = parseFloat(invoiceData.total || 0) || 0;
    const invoicePaid = parseFloat(invoiceData.totalPaid || 0) || 0;
    const parsedRemaining = invoiceData.remainingBalance != null ? parseFloat(invoiceData.remainingBalance) : NaN;
    const invoiceRemaining = !isNaN(parsedRemaining)
      ? Math.max(0, parsedRemaining)
      : Math.max(0, invoiceTotal - invoicePaid);

    if (invoiceRemaining <= 0.01) {
      return { success: false, error: 'Invoice is already paid in full. No payment link needed.' };
    }
    
    // Always create a fresh checkout session for the CURRENT remaining balance
    // so stale Stripe links cannot show outdated/zero-dollar invoices.
    let paymentUrl = '';
    const invDepositMode = invoiceData.depositMode === true || String(invoiceData.depositMode || '').toLowerCase() === 'true';
    const depositAmount = parseFloat(invoiceData.depositAmount || 0) || 0;
    const invChargeAmount = (invDepositMode && depositAmount > 0)
      ? Math.min(depositAmount, invoiceRemaining)
      : invoiceRemaining;

    if (invChargeAmount <= 0.01) {
      return { success: false, error: 'Nothing due on this invoice.' };
    }

    // Route customer through the invoice viewer, which creates a fresh checkout session on click.
    // This avoids stale Stripe-hosted invoice URLs showing paid/$0 on mobile.
    paymentUrl = getCustomerViewerWebflowUrl('Invoice', invoiceId, '');
    if (!paymentUrl) {
      return { success: false, error: 'Failed to build invoice viewer payment URL' };
    }
    
    // Send email with payment link
    const subject = `Payment Request: Invoice ${invoiceData.invoiceNumber || invoiceId} - ${COMPANY_NAME}`;
    
    const emailBody = `
      <html>
        <body style="font-family: Arial, sans-serif; line-height: 1.6; color: #333;">
          <div style="max-width: 600px; margin: 0 auto; padding: 20px;">
            <h2 style="color: #0369a1;">Payment Request</h2>
            <p>Dear ${invoiceData.customerName || 'Valued Customer'},</p>
            <p>Please open your invoice using the link below and tap <strong>Pay invoice</strong>:</p>
            <p><strong>Invoice #:</strong> ${invoiceData.invoiceNumber || invoiceId}</p>
            <p><strong>Amount Due:</strong> $${invChargeAmount.toFixed(2)}</p>
            <p style="font-size: 14px; color: #666; font-style: italic;">Your payment amount matches the invoice amount shown in your document.</p>
            <div style="margin: 30px 0; text-align: center;">
              <a href="${paymentUrl}" target="_blank" style="background-color: #0369a1; color: white; padding: 15px 30px; text-decoration: none; border-radius: 5px; display: inline-block; font-size: 16px; font-weight: bold;">
                Open Invoice &amp; Pay
              </a>
            </div>
            <p style="font-size: 12px; color: #666;">Secure payment powered by Stripe.</p>
            <p>If you have any questions, please contact us at ${COMPANY_EMAIL} or ${COMPANY_PHONE}.</p>
            <p>Thank you for your business!</p>
            <p style="margin-top: 30px;">
              <strong>${COMPANY_NAME}</strong><br>
              ${COMPANY_ADDRESS}<br>
              ${COMPANY_PHONE}<br>
              ${COMPANY_EMAIL}
            </p>
          </div>
        </body>
      </html>
    `;
    
    MailApp.sendEmail({
      to: customerEmail,
      subject: subject,
      htmlBody: emailBody
    });
    
    return {
      success: true,
      message: 'Payment link sent successfully',
      paymentUrl: paymentUrl
    };
  } catch (error) {
    Logger.log('Error sending payment link: ' + error.toString());
    return { success: false, error: error.toString() };
  }
}

/**
 * Create and send a final closeout invoice for all unpaid milestones/add-ons.
 * Reuses the standard invoice workflow so the customer receives one Pay Now button.
 */
function createFinalCloseoutInvoice(data) {
  try {
    data = data || {};
    const projectId = String(data.projectId || '').trim();
    const customerName = String(data.customerName || '').trim();
    const customerEmail = String(data.customerEmail || '').trim();
    if (!projectId || !customerName || !customerEmail) {
      return { success: false, error: 'Project ID, customer name, and customer email are required' };
    }

    let items = [];
    if (data.lineItemsJson) {
      try { items = JSON.parse(String(data.lineItemsJson || '[]')); } catch (e) { items = []; }
    } else if (Array.isArray(data.items)) {
      items = data.items;
    } else if (typeof data.items === 'string') {
      try { items = JSON.parse(data.items || '[]'); } catch (e2) { items = []; }
    }
    items = Array.isArray(items) ? items : [];
    if (items.length === 0) {
      return { success: false, error: 'No unpaid line items found for final invoice' };
    }

    const total = parseFloat(data.totalDue != null ? data.totalDue : data.total || 0) || items.reduce(function(sum, item) {
      return sum + (parseFloat(item.total != null ? item.total : (parseFloat(item.quantity || 0) * parseFloat(item.price || 0))) || 0);
    }, 0);

    const generatedInvoiceId = String(data.invoiceId || ('INV-' + projectId + '-FINAL-' + new Date().getTime())).trim();
    const invoiceData = {
      type: 'Invoice',
      invoiceNumber: String(data.invoiceNumber || generatedInvoiceId),
      customerName: customerName,
      customerEmail: customerEmail,
      customerPhone: String(data.customerPhone || ''),
      customerAddress: String(data.customerAddress || ''),
      date: new Date().toISOString(),
      dueDate: '',
      items: JSON.stringify(items),
      subtotal: total,
      taxRate: 0,
      tax: 0,
      discount: 0,
      total: total,
      notes: String(data.notes || 'Final closeout invoice — balance for all remaining milestones and add-ons.'),
      terms: String(data.terms || ''),
      paymentSchedule: '[]',
      projectId: projectId,
      status: 'Pending',
      paymentStatus: 'Pending',
      depositMode: false,
      addProcessingFee: false,
      processingFee: 0
    };

    // Create as a new invoice. Passing an explicit non-existent ID makes saveInvoiceEstimate()
    // enforce update-only behavior and fail with "specified document ID was not found".
    delete invoiceData.id;

    const saveResult = saveInvoiceEstimate(invoiceData);
    if (!saveResult || !saveResult.success) {
      return saveResult || { success: false, error: 'Failed to save final invoice' };
    }

    const finalInvoiceId = saveResult.id || generatedInvoiceId;
    const sendResult = sendPaymentLink({
      invoiceId: finalInvoiceId,
      customerEmail: customerEmail
    });

    return {
      success: true,
      invoiceId: finalInvoiceId,
      paymentLink: sendResult && sendResult.paymentUrl ? sendResult.paymentUrl : (saveResult.paymentLink || ''),
      emailSent: !!(sendResult && sendResult.success),
      saveResult: saveResult,
      sendResult: sendResult
    };
  } catch (error) {
    Logger.log('createFinalCloseoutInvoice error: ' + error.toString());
    return { success: false, error: error.toString() };
  }
}

/**
 * Send manual payment link email for a specific amount (supports partial payments)
 * Opens link in new tab
 */
function sendManualPaymentLink(data) {
  try {
    const invoiceId = data.invoiceId;
    const customerEmail = data.customerEmail;
    const paymentAmount = parseFloat(data.amount); // Custom amount for partial payment
    const notes = data.notes || ''; // Optional notes
    
    if (!invoiceId || !customerEmail) {
      return { success: false, error: 'Invoice ID and customer email are required' };
    }
    
    if (!paymentAmount || paymentAmount <= 0) {
      return { success: false, error: 'Payment amount must be greater than 0' };
    }
    
    // Get invoice data
    const invoiceResult = getInvoiceEstimate(invoiceId);
    if (!invoiceResult.success || !invoiceResult.data) {
      return { success: false, error: 'Invoice not found' };
    }
    
    const invoiceData = invoiceResult.data;
    const invoiceTotal = parseFloat(invoiceData.total) || 0;
    
    // Validate payment amount doesn't exceed invoice total
    if (paymentAmount > invoiceTotal) {
      return { success: false, error: 'Payment amount cannot exceed invoice total of $' + invoiceTotal.toFixed(2) };
    }
    
    // Create payment link for the specific amount
    const checkoutResult = createStripeCheckoutSession({
      invoiceId: invoiceId,
      amount: paymentAmount, // Use custom amount
      customerEmail: customerEmail,
      invoiceNumber: invoiceData.invoiceNumber || invoiceId
    });
    
    if (!checkoutResult.success || !checkoutResult.paymentUrl) {
      return { success: false, error: 'Failed to create payment link: ' + (checkoutResult.error || 'Unknown error') };
    }
    
    const paymentUrl = checkoutResult.paymentUrl;
    const isPartialPayment = paymentAmount < invoiceTotal;
    const remainingBalance = invoiceTotal - paymentAmount;
    
    // Update invoice JSON to track partial payment request
    try {
      const spreadsheet = SpreadsheetApp.openById(SPREADSHEET_ID);
      const sheet = spreadsheet.getSheetByName(INVOICES_ESTIMATES_SHEET);
      if (sheet) {
        enforce8ColumnStructure(sheet);
        const lastRow = sheet.getLastRow();
        const sheetCols = sheet.getLastColumn();
        const is8Column = (sheetCols >= 8);
        const idCol = is8Column ? 2 : 1;
        const json1Col = is8Column ? 4 : 3;
        const json2Col = is8Column ? 5 : 4;
        const json3Col = is8Column ? 6 : 5;
        
        for (let rowNum = 2; rowNum <= lastRow; rowNum++) {
          const rowId = String(sheet.getRange(rowNum, idCol).getValue() || '').trim();
          if (rowId === String(invoiceId).trim()) {
            const jsonPart1 = sheet.getRange(rowNum, json1Col).getValue() || '';
            const jsonPart2 = sheet.getRange(rowNum, json2Col).getValue() || '';
            const jsonPart3 = sheet.getRange(rowNum, json3Col).getValue() || '';
            let jsonStr = concatenateJsonChunks(jsonPart1, jsonPart2, jsonPart3);
            
            if (!jsonStr || jsonStr.length === 0) {
              jsonStr = String(jsonPart1 || '').trim();
            }
            
            if (jsonStr && jsonStr.startsWith('{')) {
              const jsonData = JSON.parse(jsonStr);
              
              // Track partial payment request
              if (!jsonData.partialPayments) {
                jsonData.partialPayments = [];
              }
              
              jsonData.partialPayments.push({
                amount: paymentAmount,
                paymentLink: paymentUrl,
                requestedDate: new Date().toISOString(),
                notes: notes,
                status: 'Pending'
              });
              
              // Update payment status if partial
              if (isPartialPayment) {
                jsonData.paymentStatus = 'Partial';
              }
              
              // Write updated JSON back
              const updatedJsonStr = JSON.stringify(jsonData);
              const updatedChunks = splitJsonString(updatedJsonStr);
              sheet.getRange(rowNum, json1Col, 1, 3).setValues([[updatedChunks[0] || '', updatedChunks[1] || '', updatedChunks[2] || '']]);
              SpreadsheetApp.flush();
              
              Logger.log('✅ Partial payment request tracked in invoice JSON');
              break;
            }
          }
        }
      }
    } catch (e) {
      Logger.log('Error updating invoice with partial payment: ' + e.toString());
    }
    
    // Send email with payment link (opens in new tab)
    const subject = isPartialPayment 
      ? `Partial Payment Request: $${paymentAmount.toFixed(2)} - Invoice ${invoiceData.invoiceNumber || invoiceId}`
      : `Payment Request: Invoice ${invoiceData.invoiceNumber || invoiceId} - ${COMPANY_NAME}`;
    
    const emailBody = `
      <!DOCTYPE html>
      <html>
      <head>
        <meta charset="UTF-8">
        <style>
          body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; line-height: 1.6; color: #374151; margin: 0; padding: 0; background: #f3f4f6; }
          .container { max-width: 600px; margin: 0 auto; padding: 40px 20px; }
          .card { background: white; border-radius: 12px; padding: 40px; text-align: center; box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1); }
          h1 { color: #0369a1; margin: 0 0 20px 0; font-size: 28px; }
          .amount { font-size: 36px; font-weight: bold; color: #0369a1; margin: 20px 0; }
          .pay-button { display: inline-block; padding: 18px 48px; background: #10b981; color: white; text-decoration: none; border-radius: 8px; font-weight: bold; font-size: 18px; margin: 20px 0; box-shadow: 0 4px 12px rgba(16, 185, 129, 0.3); }
          .pay-button:hover { background: #059669; }
          .fee-notice { color: #6b7280; font-size: 14px; margin-top: 16px; }
          .invoice-details { margin-top: 30px; padding-top: 30px; border-top: 1px solid #e5e7eb; text-align: left; }
          .invoice-details p { margin: 8px 0; color: #6b7280; font-size: 14px; }
          .partial-notice { background: #fef3c7; border: 2px solid #f59e0b; border-radius: 8px; padding: 16px; margin: 20px 0; color: #92400e; }
        </style>
      </head>
      <body>
        <div class="container">
          <div class="card">
            <h1>${COMPANY_NAME}</h1>
            <h2 style="color: #374151; margin: 20px 0; font-size: 24px;">${isPartialPayment ? 'Partial Payment Request' : 'Invoice Payment'}</h2>
            <div class="amount">$${paymentAmount.toFixed(2)}</div>
            <p style="color: #6b7280; font-size: 16px; margin: 10px 0;">Invoice #${invoiceData.invoiceNumber || invoiceId}</p>
            ${isPartialPayment ? `
              <div class="partial-notice">
                <strong>Partial Payment:</strong> This payment of $${paymentAmount.toFixed(2)} will be applied towards your invoice.<br>
                <strong>Remaining Balance:</strong> $${remainingBalance.toFixed(2)}
              </div>
            ` : ''}
            <a href="${paymentUrl}" target="_blank" class="pay-button">Pay $${paymentAmount.toFixed(2)} Now</a>
            <p class="fee-notice">Secure payment powered by Stripe.</p>
            <div class="invoice-details">
              <p><strong>Customer:</strong> ${invoiceData.customerName || ''}</p>
              <p><strong>Invoice Total:</strong> $${invoiceTotal.toFixed(2)}</p>
              ${isPartialPayment ? `<p><strong>Payment Amount:</strong> $${paymentAmount.toFixed(2)}</p>` : ''}
              ${isPartialPayment ? `<p><strong>Remaining Balance:</strong> $${remainingBalance.toFixed(2)}</p>` : ''}
              <p><strong>Date:</strong> ${invoiceData.date ? new Date(invoiceData.date).toLocaleDateString() : new Date().toLocaleDateString()}</p>
              ${notes ? `<p><strong>Notes:</strong> ${notes}</p>` : ''}
            </div>
          </div>
        </div>
      </body>
      </html>
    `;
    
    MailApp.sendEmail({
      to: customerEmail,
      subject: subject,
      htmlBody: emailBody
    });
    
    Logger.log('✅ Manual payment link email sent: $' + paymentAmount.toFixed(2) + ' for invoice ' + invoiceId);
    
    return {
      success: true,
      message: isPartialPayment 
        ? `Partial payment link sent for $${paymentAmount.toFixed(2)}. Remaining balance: $${remainingBalance.toFixed(2)}`
        : 'Payment link sent successfully',
      paymentUrl: paymentUrl,
      amount: paymentAmount,
      isPartialPayment: isPartialPayment,
      remainingBalance: isPartialPayment ? remainingBalance : 0
    };
  } catch (error) {
    Logger.log('Error sending manual payment link: ' + error.toString());
    return { success: false, error: error.toString() };
  }
}

