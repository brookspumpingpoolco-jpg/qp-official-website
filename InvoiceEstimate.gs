            '<div style="border-top:1px solid #e5e7eb;padding-top:24px;font-size:13px;color:#6b7280;">' +
              '<strong style="color:#111827;">A Quality Pool Company</strong><br>' +
              '<a href="tel:5027069172" style="color:#0284c7;text-decoration:none;">(502) 706-9172</a><br>' +
