          try {
            // Filter out any null/undefined/empty values from attachments array
            // Attachments can be either strings (URLs) or objects with url property
            const validAttachments = data.attachments.filter(att => {
              try {
                if (!att) return false;
                if (typeof att === 'string') return att.trim() !== '';
                if (typeof att === 'object' && att.url) return typeof att.url === 'string' && att.url.trim() !== '';
                return false;
              } catch (e) {
                Logger.log('⚠️ Error filtering attachment: ' + e.toString());
                return false;
              }
            });
            
            if (validAttachments.length === 0) {
              Logger.log('⚠️ No valid attachments found after filtering');
            } else {
              Logger.log('📎 Processing ' + validAttachments.length + ' valid attachment(s)');
              
              // Convert to array of URL strings
              const attachmentUrls = validAttachments.map(att => {
                try {
                  return typeof att === 'string' ? att : att.url;
                } catch (e) {
                  Logger.log('⚠️ Error mapping attachment: ' + e.toString());
                  return '';
                }
              }).filter(url => url && url.trim() !== '');
              
              if (attachmentUrls.length > 0) {
                const saveResult = saveAttachmentsToCustomerFolder(
                  data.customerEmail,
                  data.customerName,
                  attachmentUrls
                );
                
                if (saveResult && saveResult.success && saveResult.files && Array.isArray(saveResult.files) && saveResult.files.length > 0) {
                  Logger.log('✅ Saved ' + saveResult.files.length + ' image(s) to customer folder');
                  saveResult.files.forEach((file, index) => {
                    try {
                      // Robust null/undefined checking
                      if (!file) {
                        Logger.log('⚠️ Skipping null/undefined file at index ' + index);
                        return;
                      }
                      
                      if (!file.id || typeof file.id !== 'string' || file.id.trim() === '') {
                        Logger.log('⚠️ Skipping file with invalid ID at index ' + index);
                        return;
                      }
                      
                      try {
                        const fileBlob = DriveApp.getFileById(file.id.trim()).getBlob();
                        attachments.push({
                          name: file.name || 'Attachment_' + (index + 1),
                          blob: fileBlob
                        });
                        Logger.log('✅ Added attachment: ' + (file.name || 'Attachment_' + (index + 1)));
                      } catch (driveError) {
                        Logger.log('❌ Error fetching file from Drive (ID: ' + file.id + '): ' + driveError.toString());
                      }
                    } catch (error) {
                      Logger.log('❌ Error processing attachment at index ' + index + ': ' + error.toString());
                    }
                  });
                } else {
                  Logger.log('⚠️ saveAttachmentsToCustomerFolder returned no valid files');
                }
              }
            }
          } catch (error) {
            Logger.log('❌ Error in attachment processing: ' + error.toString());
          }
        }
      } catch (outerError) {
        // Catch any unexpected errors in attachment processing
        // This ensures attachments never block the email from sending
        Logger.log('❌ CRITICAL: Attachment processing failed, but continuing with email: ' + outerError.toString());
      }
      
      // Calculate totals
      const items = JSON.parse(data.items || '[]');
      const subtotal = items.reduce((sum, item) => sum + (parseFloat(item.quantity || 0) * parseFloat(item.price || 0)), 0);
      const taxRate = parseFloat(data.taxRate || 0);
      const taxAmount = subtotal * (taxRate / 100);
      const discount = parseFloat(data.discount || 0);
      const total = subtotal + taxAmount - discount;
      
      // Send enhanced email
      try {
        Logger.log('📧 Preparing to send enhanced email with ' + attachments.length + ' attachment(s)');
        
        // Ensure shareLink is set correctly for Webflow
        const finalShareLink = shareLink || (id ? getCustomerViewerWebflowUrl(data.type, id, saveResult.approvalToken) : '');
        Logger.log('🔗 Final ShareLink for email: ' + finalShareLink);
        
        // If customer uploaded photos, build gallery HTML so they appear in the email
        const emailData = {
          ...data,
          type: invoiceType,
          id: id,
          approvalToken: saveResult.approvalToken || data.approvalToken || '',
          paymentLink: paymentLink,
          shareLink: finalShareLink,
          total: total,
          status: updatedStatus
        };
        if (data.photos && Array.isArray(data.photos) && data.photos.length > 0) {
          emailData.customImageGallery = buildPhotoGalleryHtml(data.photos);
