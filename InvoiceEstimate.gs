/**
 * Approve estimate (with optional comment), using PM_Approval_Tokens sheet.
 * Works for both portal approvals and contract signatures.
 */
function approveEstimate(id, token, comment) {
  try {
    if (!id || !token) {
      return { success: false, error: 'Invalid token or estimate not found' };
    }

    Logger.log('🔍 approveEstimate called with id: [' + id + '] token: [' + token + ']');

    const spreadsheet = SpreadsheetApp.openById(SPREADSHEET_ID);
    const estimatesSheet = spreadsheet.getSheetByName(INVOICES_ESTIMATES_SHEET);
    const tokensSheet = spreadsheet.getSheetByName(PM_APPROVAL_TOKENS_SHEET);

    if (!estimatesSheet || !tokensSheet) {
      return { success: false, error: 'Approval sheets not found' };
    }

    const now = new Date();

    // 1) Validate token in PM_Approval_Tokens sheet
    const tokenValues = tokensSheet.getDataRange().getValues(); // [Token, Estimate ID, Email, Created, Expires, Used]
    Logger.log('📋 PM_Approval_Tokens sheet has ' + tokenValues.length + ' rows');
    
    let tokenRowIndex = -1;
    for (let i = 1; i < tokenValues.length; i++) {
      const row = tokenValues[i];
      const rowToken = String(row[0] || '').trim();
      const rowEstimateId = String(row[1] || '').trim();
      const expires = row[4];
      const used = row[5];

      // Log first few rows for debugging
      if (i <= 3) {
        Logger.log('Row ' + (i+1) + ': token=[' + rowToken.substring(0, 20) + '...] id=[' + rowEstimateId + '] used=' + used);
      }

      if (rowToken === String(token).trim() && rowEstimateId === String(id).trim()) {
        Logger.log('✅ Token and ID match at row ' + (i+1));
        // Check expiration if present
        if (expires && expires instanceof Date && expires.getTime() < now.getTime()) {
          return { success: false, error: 'Approval link has expired' };
        }
        // Check if already used
        if (used === true || String(used).toLowerCase() === 'true') {
          // Allow idempotent behavior but don't re-process project creation
          tokenRowIndex = i;
          break;
        }
        tokenRowIndex = i;
        break;
      }
    }

    if (tokenRowIndex === -1) {
      Logger.log('❌ Token validation failed - no matching row found');
      Logger.log('Looking for token: [' + String(token).trim() + ']');
      Logger.log('Looking for id: [' + String(id).trim() + ']');
      Logger.log('Total rows checked: ' + (tokenValues.length - 1));
      return { success: false, error: 'Invalid token or estimate not found' };
    }

    // Mark token as used
    tokensSheet.getRange(tokenRowIndex + 1, 6).setValue(true); // "Used" column

    // 2) Find estimate row by ID in INVOICES_ESTIMATES_SHEET
    const estimateValues = estimatesSheet.getDataRange().getValues();
    let estimateRowIndex = -1;
    Logger.log('🔍 Looking for estimate ID [' + String(id).trim() + '] in INVOICES_ESTIMATES_SHEET');
    Logger.log('📄 INVOICES_ESTIMATES_SHEET has ' + estimateValues.length + ' rows');
    
    // Column 2 (index 1) has the estimate/invoice ID
    for (let i = 1; i < estimateValues.length; i++) {
      const rowId = String(estimateValues[i][1] || '').trim();  // Column index 1 = column B = estimate ID
      if (i <= 3) {
        Logger.log('Row ' + (i+1) + ' col[1]: [' + rowId + ']');
      }
      if (rowId === String(id).trim()) {
        Logger.log('✅ Found estimate at row ' + (i+1));
        estimateRowIndex = i;
        break;
      }
    }

    if (estimateRowIndex === -1) {
      Logger.log('❌ Estimate ID [' + String(id).trim() + '] not found in sheet!');
      return { success: false, error: 'Invalid token or estimate not found' };
    }

    const rowNumber = estimateRowIndex + 1;

    // 3) Update approval status inside JSON (columns 3–5)
    try {
      const jsonPart1 = estimatesSheet.getRange(rowNumber, 3).getValue() || '';
      const jsonPart2 = estimatesSheet.getRange(rowNumber, 4).getValue() || '';
      const jsonPart3 = estimatesSheet.getRange(rowNumber, 5).getValue() || '';
      let jsonStr = concatenateJsonChunks(jsonPart1, jsonPart2, jsonPart3);
      if (!jsonStr || jsonStr.length === 0) {
        jsonStr = String(jsonPart1 || '').trim();
      }

      if (jsonStr && jsonStr.startsWith('{')) {
        const jsonData = JSON.parse(jsonStr);
        jsonData.quoteStatus = 'Accepted';
        jsonData.status = 'Approved';
        jsonData.approvalStatus = 'Approved';
        jsonData.customerSigned = true;
        jsonData.approvalDate = now.toISOString();
        if (comment) {
          jsonData.approvalComment = comment;
        }

        const updatedJsonStr = JSON.stringify(jsonData);
        const updatedChunks = splitJsonString(updatedJsonStr);
        estimatesSheet
          .getRange(rowNumber, 3, 1, 3)
          .setValues([[updatedChunks[0] || '', updatedChunks[1] || '', updatedChunks[2] || '']]);
      }
    } catch (e) {
      Logger.log('Error updating approval status in JSON: ' + e.toString());
    }

    // 4) Ensure sheet structure is correct
    enforce8ColumnStructure(estimatesSheet);

    // 5) Convert to project and notify Brooks: project accepted, contract needed
    try {
      const projectResult = createProjectFromEstimate(id);
      const projectId = projectResult.success ? (projectResult.projectId || '') : '';
      const pd = projectResult.success && projectResult.projectData ? projectResult.projectData : {};
      notifyBrooksProjectAccepted(id, projectId, pd.customerName || '', pd.customerEmail || '', parseFloat(pd.total || 0));
    } catch (postErr) {
      Logger.log('Post-approval (create project / notify Brooks): ' + postErr.toString());
    }

    return { success: true, message: 'Estimate approved successfully' };
  } catch (error) {
    Logger.log('Error approving estimate: ' + error.toString());
    return { success: false, error: error.toString() };
  }
}

