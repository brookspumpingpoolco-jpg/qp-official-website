        // Build item cell with image, name, and description
        let itemCellContent = '';
        if (imageHtml) {
          itemCellContent += imageHtml;
        }
        itemCellContent += `<div style="font-weight: 600; color: #111827; margin-bottom: ${itemDescription ? '4px' : '0'};">${itemName}</div>`;
