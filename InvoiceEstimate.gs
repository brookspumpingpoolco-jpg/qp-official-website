      sheet.getRange(1, INVOICES_COL_ONE_OFF_ITEMS).setFontWeight('bold');
    }
  } catch (e) {
    Logger.log('ensureInvoicesEstimatesNineColumns: ' + e.toString());
  }
}

/**
 * Merge column 9 one-off JSON into jsonData.items (column 9 wins for all isOneOff lines).
 */
function mergeInvoiceSheetColumn9OneOffsIntoJsonData(sheet, rowNum, jsonData) {
  try {
    if (!sheet || !rowNum || !jsonData) return jsonData;
    ensureInvoicesEstimatesNineColumns(sheet);
    if (sheet.getLastColumn() < INVOICES_COL_ONE_OFF_ITEMS) return jsonData;
    var cell = sheet.getRange(rowNum, INVOICES_COL_ONE_OFF_ITEMS).getValue();
    if (!cell || !String(cell).trim()) return jsonData;
    var oneOffs = [];
    try {
      oneOffs = JSON.parse(String(cell));
    } catch (e) {
      return jsonData;
    }
    if (!Array.isArray(oneOffs) || oneOffs.length === 0) return jsonData;

    var items = [];
    try {
      items = JSON.parse(jsonData.items || '[]');
    } catch (e) {
      items = [];
    }
    var base = items.filter(function(i) {
      return !i.isOneOff;
    });
    var merged = base.concat(oneOffs);
    jsonData.items = JSON.stringify(merged);

    var regularItems = merged.filter(function(it) {
      return !it.isProcessingFee;
    });
    var newSubtotal = regularItems.reduce(function(sum, it) {
      return sum + (parseFloat(it.quantity || 1) * parseFloat(it.price != null && it.price !== '' ? it.price : (it.unitPrice || 0)));
    }, 0);
    var taxRate = parseFloat(jsonData.taxRate || 0);
    var tax = newSubtotal * (taxRate / 100);
    var discount = parseFloat(jsonData.discount || 0);
    var procFee = 0;
    if (jsonData.addProcessingFee) {
      procFee = ((newSubtotal + tax - discount) * STRIPE_PROCESSING_FEE_RATE) + STRIPE_PROCESSING_FEE_FIXED;
      var feeIdx = merged.findIndex(function(it) {
        return it.isProcessingFee;
      });
      if (feeIdx >= 0) {
        merged[feeIdx].price = procFee;
        merged[feeIdx].total = procFee;
        jsonData.items = JSON.stringify(merged);
      }
    }
    var newTotal = newSubtotal + tax - discount + procFee;
    jsonData.subtotal = newSubtotal;
    jsonData.total = newTotal;
    if (jsonData.taxAmount !== undefined) jsonData.taxAmount = tax;
    Logger.log('✅ mergeInvoiceSheetColumn9OneOffsIntoJsonData: applied ' + oneOffs.length + ' one-off line(s) from column 9');
    return jsonData;
  } catch (err) {
    Logger.log('mergeInvoiceSheetColumn9OneOffsIntoJsonData: ' + err.toString());
    return jsonData;
  }
}

/**
