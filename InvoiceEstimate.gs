/**
 * Get logo as base64 data URL for PDF embedding
 */
function getLogoBase64() {
  try {
    const logoUrl = 'https://cdn.prod.website-files.com/6931dc4e8e97334e195432df/6993ce0abcd54d3520799318_IMG_1763-p-500.jpg';
    Logger.log('🖼️ Fetching logo from: ' + logoUrl);
    const response = UrlFetchApp.fetch(logoUrl, {
      muteHttpExceptions: true
    });
    
    // Check if request was successful
    const responseCode = response.getResponseCode();
    if (responseCode !== 200) {
      Logger.log('⚠️ Logo fetch failed with response code: ' + responseCode);
      throw new Error('Failed to fetch logo: HTTP ' + responseCode);
    }
    
    const blob = response.getBlob();
    const base64 = Utilities.base64Encode(blob.getBytes());
    
    // Detect image type from blob
    const contentType = blob.getContentType();
    let imageType = 'jpeg'; // Default to jpeg for .jpg files
    if (contentType && contentType.startsWith('image/')) {
      imageType = contentType.split('/')[1].split(';')[0];
    }
    
    Logger.log('✅ Logo converted to base64 successfully (type: ' + imageType + ', size: ' + base64.length + ' chars)');
    return 'data:image/' + imageType + ';base64,' + base64;
  } catch (error) {
    Logger.log('❌ Error fetching logo: ' + error.toString());
    Logger.log('Stack: ' + (error.stack || 'No stack trace'));
    // Fallback to hosted logo URL so branding still appears in email
    return 'https://cdn.prod.website-files.com/6931dc4e8e97334e195432df/6993ce0abcd54d3520799318_IMG_1763-p-500.jpg';
  }
}

/**
 * Generate PDF blob for email attachment
 */
function generatePDFBlob(id, data) {
  try {
    // Get customer address - use from data, or fetch from customer sheet if not available
    if (!data.customerAddress && data.customerEmail) {
      try {
        const spreadsheet = SpreadsheetApp.openById(SPREADSHEET_ID);
        const customers = getCustomersFromSheet(spreadsheet, data.customerEmail);
        if (customers && customers.length > 0) {
          const customer = customers[0];
          data.customerAddress = customer.address || customer.customerAddress || '';
          if (data.customerAddress) {
            Logger.log('✅ Retrieved customer address from customer sheet for PDF: ' + data.customerAddress);
          }
        }
      } catch (error) {
        Logger.log('⚠️ Could not fetch customer address from sheet for PDF: ' + error.toString());
      }
    }
    
    // Get logo as base64 for embedding in PDF
    const logoBase64 = getLogoBase64();
    
    // Generate HTML server-side to match InvoiceTemplate.html exactly
    // This ensures PDF matches the live preview
    const items = JSON.parse(data.items || '[]');
    const subtotal = items.reduce((sum, item) => sum + (parseFloat(item.quantity || 0) * parseFloat(item.price || 0)), 0);
    const taxRate = parseFloat(data.taxRate || 0);
    const taxAmount = subtotal * (taxRate / 100);
    const discount = parseFloat(data.discount || 0);
    const total = subtotal + taxAmount - discount;
    
    const type = data.type === 'Invoice' ? 'INVOICE' : 'ESTIMATE';
    const invoiceNumber = data.invoiceNumber || data.quoteNumber || id;
    const invoiceDate = data.date || new Date().toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
    
    // Format currency
    const formatCurrency = (amount) => parseFloat(amount || 0).toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/g, ',');
    
    // Escape HTML
    const escapeHtml = (text) => {
      if (!text) return '';
      return String(text).replace(/[&<>"']/g, (m) => {
        const map = {'&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;'};
        return map[m];
      });
    };
    
    // Helper function to get image as base64
    const getImageBase64 = (imageUrl) => {
      if (!imageUrl || !imageUrl.trim()) {
        Logger.log('⚠️ getImageBase64: Empty or invalid image URL');
        return null;
      }
      try {
        Logger.log('🖼️ Fetching image from URL: ' + imageUrl.substring(0, 100) + '...');
        const response = UrlFetchApp.fetch(imageUrl, { muteHttpExceptions: true });
        const responseCode = response.getResponseCode();
        
        // Check if request was successful
        if (responseCode !== 200) {
          const responseText = response.getContentText();
          Logger.log('❌ getImageBase64: HTTP ' + responseCode + ' - ' + responseText.substring(0, 200));
          return null;
        }
        
        const blob = response.getBlob();
        const contentType = blob.getContentType();
        
        // Check if response is actually an image
        if (!contentType || !contentType.startsWith('image/')) {
          Logger.log('⚠️ getImageBase64: Response is not an image. Content-Type: ' + contentType);
          // Check if it's an error response (JSON)
          try {
            const responseText = response.getContentText();
            if (responseText.startsWith('{') || responseText.startsWith('[')) {
              Logger.log('❌ getImageBase64: Received JSON error response: ' + responseText.substring(0, 200));
            }
          } catch (e) {
            // Ignore
          }
          return null;
        }
    
        // Detect image type from blob or URL
        let imageType = 'png'; // default
        if (contentType && contentType.startsWith('image/')) {
          imageType = contentType.split('/')[1].split(';')[0]; // e.g., 'jpeg', 'png', 'gif'
        } else {
          // Fallback: detect from URL extension
          const urlLower = imageUrl.toLowerCase();
          if (urlLower.includes('.jpg') || urlLower.includes('.jpeg')) imageType = 'jpeg';
          else if (urlLower.includes('.png')) imageType = 'png';
          else if (urlLower.includes('.gif')) imageType = 'gif';
          else if (urlLower.includes('.webp')) imageType = 'webp';
        }
        
        const base64 = Utilities.base64Encode(blob.getBytes());
        Logger.log('✅ getImageBase64: Successfully converted image to base64 (type: ' + imageType + ', size: ' + base64.length + ' chars)');
        return `data:image/${imageType};base64,${base64}`;
      } catch (error) {
        Logger.log('❌ Error fetching image from ' + imageUrl.substring(0, 100) + ': ' + error.toString());
        Logger.log('Error stack: ' + (error.stack || 'No stack trace'));
        return null;
      }
    };
    
    // Build items HTML with images and descriptions
    let itemsHtml = '';
    if (items.length > 0) {
      items.forEach(item => {
        const itemTotal = parseFloat(item.quantity || 0) * parseFloat(item.price || 0);
        const itemName = escapeHtml(item.name || '');
        const itemDescription = escapeHtml(item.description || '');
        const itemImageUrl = item.imageUrl || item.image || '';
      
        // Get image as base64 if available
        let imageHtml = '';
        if (itemImageUrl) {
          const imageBase64 = getImageBase64(itemImageUrl);
          if (imageBase64) {
            imageHtml = `<div style="margin-bottom: 8px;"><img src="${imageBase64}" alt="${itemName}" style="max-width: 120px; max-height: 120px; border-radius: 6px; object-fit: cover; border: 1px solid #e5e7eb;" /></div>`;
          }
