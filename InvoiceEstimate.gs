/**
 * HTML-escape a value for safe use inside HTML strings.
 */
function escapeHtml(val) {
  if (val === null || val === undefined) return '';
  return String(val)
    .replace(/&/g,  '&amp;')
    .replace(/</g,  '&lt;')
    .replace(/>/g,  '&gt;')
    .replace(/"/g,  '&quot;')
    .replace(/'/g,  '&#039;');
}

function escapeTelegramHtml_(val) {
  return escapeHtml(val);
}

function buildTelegramReplyMarkup_(buttons) {
  var validButtons = (buttons || []).filter(function(btn) {
    return btn && btn.text && btn.url;
  });
  if (validButtons.length === 0) return '';
  return JSON.stringify({
    inline_keyboard: validButtons.map(function(btn) {
      return [{ text: String(btn.text), url: String(btn.url) }];
    })
  });
}

/**
 * Build sms: URI for Telegram inline buttons (opens native SMS with pre-filled body).
 * Normalizes US numbers to E.164 (+1XXXXXXXXXX). Other digit lengths 10–15 treated as +digits.
 * Optional name is prepended to the message (not a separate query param).
 * Note: Telegram clients vary — sms: often works on mobile; desktop may ignore.
 */
function buildTelegramSmsRedirectUrl_(phone, body, name) {
  var cleanPhone = phone ? String(phone).replace(/\D/g, '') : '';
  if (!cleanPhone) return '';
  var e164 = '';
  if (cleanPhone.length === 11 && cleanPhone.charAt(0) === '1') {
    e164 = '+1' + cleanPhone.substring(1);
  } else if (cleanPhone.length === 10) {
    e164 = '+1' + cleanPhone;
  } else if (cleanPhone.length >= 10 && cleanPhone.length <= 15) {
    e164 = '+' + cleanPhone;
  } else {
    return '';
  }
  var prefix = '';
  var n = name ? String(name).trim() : '';
  if (n) {
    prefix = 'Customer: ' + n + '\n\n';
  }
  var fullBody = prefix + (body || '');
  var maxLen = 1200;
  if (fullBody.length > maxLen) {
    fullBody = fullBody.substring(0, maxLen - 3) + '...';
  }
  return 'sms:' + e164 + '?body=' + encodeURIComponent(fullBody);
}

/**
 * Bot API token: BROOKS_TELEGRAM_BOT_TOKEN constant first, else Script property BROOKS_TELEGRAM_BOT_TOKEN.
 */
function getTelegramBotToken_() {
  if (BROOKS_TELEGRAM_BOT_TOKEN && String(BROOKS_TELEGRAM_BOT_TOKEN).trim()) {
    return String(BROOKS_TELEGRAM_BOT_TOKEN).trim();
  }
  var prop = PropertiesService.getScriptProperties().getProperty('BROOKS_TELEGRAM_BOT_TOKEN');
  if (prop && String(prop).trim()) return String(prop).trim();
  return '';
}

/**
 * Telegram recipient for Brooks notifications. Constant BROOKS_TELEGRAM_CHAT_ID wins; else Script property.
 * Returns '' if unset or if value equals bot user id (invalid — causes HTTP 403).
 */
function getBrooksTelegramChatId_() {
  var id = '';
  if (BROOKS_TELEGRAM_CHAT_ID && String(BROOKS_TELEGRAM_CHAT_ID).trim()) {
    id = String(BROOKS_TELEGRAM_CHAT_ID).trim();
  } else {
    var prop = PropertiesService.getScriptProperties().getProperty('BROOKS_TELEGRAM_CHAT_ID');
    if (prop && String(prop).trim()) id = String(prop).trim();
  }
  if (!id) return '';
  var token = String(getTelegramBotToken_() || '');
  var m = token.match(/^(\d+):/);
  var botUserId = m ? m[1] : '';
  if (botUserId && id === botUserId) {
    Logger.log('getBrooksTelegramChatId_: chat_id must be Brooks personal Telegram user id, not the bot id (token prefix).');
    return '';
  }
  return id;
}

/**
 * Circuit breaker for Telegram sends when UrlFetch daily quota is exhausted.
 * Stored in Script Properties as epoch ms.
 */
function getTelegramUrlFetchBlockedUntil_() {
  try {
    var raw = PropertiesService.getScriptProperties().getProperty('TELEGRAM_URLFETCH_BLOCK_UNTIL') || '';
    var ts = parseInt(String(raw).trim(), 10);
    return isNaN(ts) ? 0 : ts;
  } catch (e) {
    return 0;
  }
}

function setTelegramUrlFetchBlockedUntil_(epochMs) {
  try {
    PropertiesService.getScriptProperties().setProperty('TELEGRAM_URLFETCH_BLOCK_UNTIL', String(Math.max(0, parseInt(epochMs, 10) || 0)));
  } catch (e) {
    Logger.log('setTelegramUrlFetchBlockedUntil_ error: ' + e.toString());
  }
}

function clearTelegramUrlFetchBlockedUntil_() {
  try {
    PropertiesService.getScriptProperties().deleteProperty('TELEGRAM_URLFETCH_BLOCK_UNTIL');
  } catch (e) {
    Logger.log('clearTelegramUrlFetchBlockedUntil_ error: ' + e.toString());
  }
}

function isDailyUrlFetchQuotaError_(text) {
  return /service invoked too many times for one day:\s*urlfetch/i.test(String(text || ''));
}

function computeTelegramQuotaResetEpochMs_() {
  // Default: block until next local midnight + 5 minutes.
  var now = new Date();
  var reset = new Date(now.getTime());
  reset.setHours(24, 5, 0, 0);
  return reset.getTime();
}

function sendTelegramBotMessage_(htmlText, buttons) {
  var lock = null;
  var lockAcquired = false;
  try {
    var blockUntil = getTelegramUrlFetchBlockedUntil_();
    var nowMs = Date.now();
    if (blockUntil && nowMs < blockUntil) {
      var blockedUntilText = Utilities.formatDate(new Date(blockUntil), Session.getScriptTimeZone() || 'America/New_York', 'yyyy-MM-dd HH:mm z');
      return {
        success: false,
        error: 'Telegram paused: UrlFetch daily quota already exhausted. Retry after ' + blockedUntilText
      };
    }

    var token = getTelegramBotToken_();
    if (!token) {
      return { success: false, error: 'BROOKS_TELEGRAM_BOT_TOKEN missing. Set Script property BROOKS_TELEGRAM_BOT_TOKEN.' };
    }
    var chatId = getBrooksTelegramChatId_();
    if (!chatId) {
      return {
        success: false,
        error: 'BROOKS_TELEGRAM_CHAT_ID missing or invalid. Set constant BROOKS_TELEGRAM_CHAT_ID at top of script or Script property to Brooks’ personal Telegram user id (not the bot id from the token).'
      };
    }
    Logger.log('🚀🚀🚀 sendTelegramBotMessage_ CALLED');
    Logger.log('🔑 Token check: ' + (token ? '✅ found' : '❌ EMPTY'));
    Logger.log('💬 Chat ID check: ' + (chatId ? '✅ ' + chatId : '❌ EMPTY'));

    // Serialize outbound Telegram sends to avoid burst/rate-limit failures.
    try {
      lock = LockService.getScriptLock();
      lockAcquired = lock.tryLock(2500);
      if (!lockAcquired) {
        Logger.log('⚠️ Telegram send lock not acquired quickly; continuing without lock');
      }
    } catch (lockErr) {
      Logger.log('⚠️ Telegram lock setup failed: ' + lockErr.toString());
    }
    
    const url = 'https://api.telegram.org/bot' + token + '/sendMessage';
    var payload = {
      chat_id: chatId,
      text: htmlText,
      parse_mode: 'HTML',
      disable_web_page_preview: false
    };
    var replyMarkupStr = buildTelegramReplyMarkup_(buttons);
    if (replyMarkupStr) {
      try {
        payload.reply_markup = JSON.parse(replyMarkupStr);
      } catch(e) {
        Logger.log('⚠️ Failed to parse replyMarkup: ' + e.toString());
      }
    }
    
    Logger.log('🤖 Telegram API URL: ' + url);
    Logger.log('🤖 Telegram payload: ' + JSON.stringify(payload));

    var attempts = 3;
    for (var attempt = 1; attempt <= attempts; attempt++) {
      try {
        const response = UrlFetchApp.fetch(url, {
          method: 'post',
          contentType: 'application/json',
          payload: JSON.stringify(payload),
          muteHttpExceptions: true
        });
        const status = response.getResponseCode();
        const body = response.getContentText() || '';

        Logger.log('🤖 Telegram response status (attempt ' + attempt + '/' + attempts + '): ' + status);
        Logger.log('🤖 Telegram response body (attempt ' + attempt + '/' + attempts + '): ' + body);

        if (status >= 200 && status < 300) {
          Logger.log('✅ Telegram message sent successfully');
          clearTelegramUrlFetchBlockedUntil_();
          return { success: true };
        }

        var lowerBody = String(body || '').toLowerCase();
        var retryable = (status === 429) || /too many requests|retry after|rate limit|flood control/i.test(lowerBody);
        if (retryable && attempt < attempts) {
          var waitMs = 1500 * attempt;
          var retryAfterMatch = String(body || '').match(/"retry_after"\s*:\s*(\d+)/i);
          if (retryAfterMatch && retryAfterMatch[1]) {
            var retryAfterSec = parseInt(retryAfterMatch[1], 10);
            if (!isNaN(retryAfterSec) && retryAfterSec > 0) {
              waitMs = Math.max(waitMs, retryAfterSec * 1000);
            }
          }
          Logger.log('⏳ Telegram rate-limited. Waiting ' + waitMs + 'ms before retry...');
          Utilities.sleep(waitMs);
          continue;
        }

        Logger.log('❌ Telegram send failed: ' + status + ' ' + body);
        return { success: false, error: 'Telegram HTTP ' + status + ': ' + body };
      } catch (fetchErr) {
        var errText = String(fetchErr || '');
        if (isDailyUrlFetchQuotaError_(errText)) {
          var untilMs = computeTelegramQuotaResetEpochMs_();
          setTelegramUrlFetchBlockedUntil_(untilMs);
          var untilText = Utilities.formatDate(new Date(untilMs), Session.getScriptTimeZone() || 'America/New_York', 'yyyy-MM-dd HH:mm z');
          Logger.log('🛑 UrlFetch daily quota exhausted. Blocking Telegram attempts until ' + untilText + '. Error: ' + errText);
          return { success: false, error: 'UrlFetch daily quota exhausted. Retry after ' + untilText };
        }
        var errRetryable = /service invoked too many times|rate limit exceeded|too many requests|quota/i.test(errText);
        if (errRetryable && attempt < attempts) {
          var waitOnErrMs = 1500 * attempt;
          Logger.log('⏳ Telegram quota/rate error on attempt ' + attempt + '. Waiting ' + waitOnErrMs + 'ms. Error: ' + errText);
          Utilities.sleep(waitOnErrMs);
          continue;
        }
        throw fetchErr;
      }
    }

    return { success: false, error: 'Telegram send failed after retries' };
  } catch (error) {
    Logger.log('sendTelegramBotMessage_ error: ' + error.toString());
    return { success: false, error: error.toString() };
  } finally {
    if (lock && lockAcquired) {
      try { lock.releaseLock(); } catch (_lockReleaseErr) {}
    }
  }
}

