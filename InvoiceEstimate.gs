      'Payment of ' + fmtAmount + ' recorded for ' + (customerName || 'customer') + '. View receipt: ' + receiptUrl,
      adminHtml
    );
    Logger.log('📧 Admin notification sent to ' + BROOKS_EMAIL);

    return { success: true, receiptUrl: receiptUrl };
  } catch(e) {
    Logger.log('sendPaymentReceipt error: ' + e.toString());
    return { success: false, error: e.toString() };
  }
}

/**
 * Get payments for a specific invoice/estimate ID
 */
function getPaymentsForInvoice(invoiceId) {
  try {
    const spreadsheet = SpreadsheetApp.openById(SPREADSHEET_ID);
    const sheet = spreadsheet.getSheetByName(PAYMENT_HISTORY_SHEET);
    
    if (!sheet) {
      return [];
    }
    
    const lastRow = sheet.getLastRow();
    if (lastRow < 2) {
      return [];
    }
    
    // Detect data start row
    const firstRow = sheet.getRange(1, 1, 1, 11).getValues()[0];
    const firstCell = String(firstRow[0] || '').trim();
    let dataStartRow = firstCell.toUpperCase().includes('PAYMENT') || firstCell.includes('💳') ? 3 : (firstCell === 'Date' || firstCell === 'Invoice ID' ? 2 : 1);
    
    const payments = [];
    const numRows = lastRow - dataStartRow + 1;
    if (numRows < 1) return [];
    
    const data = sheet.getRange(dataStartRow, 1, numRows, 11).getValues();
    
    // Normalize the search invoice ID - convert to string and trim
    const searchInvoiceId = String(invoiceId).trim();
    Logger.log('🔍 getPaymentsForInvoice: Searching for invoice ID: "' + searchInvoiceId + '" (length: ' + searchInvoiceId.length + ')');
    
    // Track all invoice IDs found for debugging
    const foundInvoiceIds = new Set();
    
    for (let i = 0; i < data.length; i++) {
      const row = data[i];
      // Column 1 (index 1) is Invoice ID in Payment History sheet
      const rowInvoiceId = String(row[1] || '').trim();
      const rowStatus = String(row[6] || '').trim();
      const rowStatusNorm = rowStatus.toLowerCase();
      // Only count rows that are explicitly paid/completed.
      // Do NOT treat blank status as paid (it creates phantom paid amounts and wrong remaining balance).
      const isCompletedLike = rowStatusNorm === 'completed'
        || rowStatusNorm === 'paid'
        || rowStatusNorm === 'succeeded'
        || rowStatusNorm === 'success'
        || rowStatusNorm === 'captured';
      
      // Track all invoice IDs we see
      if (rowInvoiceId) {
        foundInvoiceIds.add(rowInvoiceId);
      }
      
      // STRICT EXACT MATCH - must match exactly (case-sensitive, no partial matches)
      // Also ensure status is 'Completed'
      if (rowInvoiceId === searchInvoiceId && isCompletedLike) {
        Logger.log('✅ Found payment for invoice ' + searchInvoiceId + ': $' + (row[3] || 0) + ' on ' + (row[0] || 'unknown date'));
        payments.push({
          date: row[0],
          amount: parseFloat(row[3]) || 0,
          method: row[4] || 'Unknown',
          transactionId: row[5] || '',
          email: row[7] || '',
          description: row[8] || '',
          fee: parseFloat(row[9]) || 0,
          notes: row[10] || '' // Payment notes from column 11
        });
      }
    }
    
    Logger.log('📊 getPaymentsForInvoice: Found ' + payments.length + ' payment(s) for invoice "' + searchInvoiceId + '"');
    Logger.log('📋 getPaymentsForInvoice: Total unique invoice IDs in Payment History: ' + foundInvoiceIds.size);
    if (foundInvoiceIds.size > 0 && foundInvoiceIds.size <= 10) {
      Logger.log('📋 Sample invoice IDs in Payment History: ' + Array.from(foundInvoiceIds).slice(0, 10).join(', '));
    }
    
    return payments;
    
  } catch (error) {
    Logger.log('Error getting payments for invoice: ' + error.toString());
    return [];
  }
}

/**
 * Get invoices created from an estimate
 */
function getInvoicesForEstimate(estimateId) {
  try {
    const spreadsheet = SpreadsheetApp.openById(SPREADSHEET_ID);
    const sheet = spreadsheet.getSheetByName(INVOICES_ESTIMATES_SHEET);
    
    if (!sheet) {
      return [];
    }
    
    const lastRow = sheet.getLastRow();
    if (lastRow < 2) {
      return [];
    }
    
    const invoices = [];
    
    for (let rowNum = 2; rowNum <= lastRow; rowNum++) {
      try {
        const id = sheet.getRange(rowNum, 2).getValue();
        const jsonPart1 = sheet.getRange(rowNum, 4).getValue() || '';
        const jsonPart2 = sheet.getRange(rowNum, 5).getValue() || '';
        const jsonPart3 = sheet.getRange(rowNum, 6).getValue() || '';
        const jsonStr = concatenateJsonChunks(jsonPart1, jsonPart2, jsonPart3);
        
        if (jsonStr && jsonStr.startsWith('{')) {
          const data = JSON.parse(jsonStr);
          
          // Check if this invoice was created from our estimate
          if (data.type === 'Invoice' && data.sourceEstimateId === estimateId) {
            const items = JSON.parse(data.items || '[]');
            const subtotal = items.reduce((sum, item) => sum + (parseFloat(item.quantity || 0) * parseFloat(item.price || 0)), 0);
            const taxRate = parseFloat(data.taxRate || 0);
            const taxAmount = subtotal * (taxRate / 100);
            const discount = parseFloat(data.discount || 0);
            const total = subtotal + taxAmount - discount;
            
            invoices.push({
              id: id,
              invoiceNumber: data.invoiceNumber,
              date: data.date,
              dueDate: data.dueDate,
              total: total,
              status: data.status,
              description: data.description || items[0]?.description || 'Invoice',
              pdfUrl: data.pdfUrl || '',
              shareLink: data.shareLink || ''
            });
          }
        }
      } catch (error) {
        Logger.log('Error processing row ' + rowNum + ': ' + error.toString());
      }
    }
    
    return invoices;
    
  } catch (error) {
    Logger.log('Error getting invoices for estimate: ' + error.toString());
    return [];
  }
}

/**
 * Create invoice from approved estimate
 */
function createInvoiceFromEstimate(estimateId, invoiceData) {
  try {
    // Get the estimate
    const estimateResult = getInvoiceEstimate(estimateId);
    if (!estimateResult.success) {
      return { success: false, error: 'Estimate not found' };
    }
    
    const estimate = estimateResult.data;
    
    // Create new invoice based on estimate
    const newInvoice = {
      ...estimate,
      type: 'Invoice',
      invoiceNumber: invoiceData.invoiceNumber || 'INV-' + new Date().getTime(),
      quoteNumber: undefined, // Remove quote number
      date: invoiceData.date || new Date().toISOString().split('T')[0],
      dueDate: invoiceData.dueDate || new Date(Date.now() + 30 * 24 * 60 * 60 * 1000).toISOString().split('T')[0],
      status: 'Draft',
      sourceEstimateId: estimateId, // Link back to estimate
      description: invoiceData.description || estimate.description || '',
      notes: invoiceData.notes || 'Invoice created from approved estimate ' + (estimate.quoteNumber || estimateId)
    };
    
    // Override with any custom invoice data
    Object.keys(invoiceData).forEach(key => {
      if (invoiceData[key] !== undefined && invoiceData[key] !== '') {
        newInvoice[key] = invoiceData[key];
      }
    });
    
    // Save the invoice
    const saveResult = saveInvoiceEstimate(newInvoice);
    
    if (saveResult.success) {
      Logger.log('✅ Invoice created from estimate ' + estimateId + ': ' + saveResult.id);
    }
    
    return saveResult;
    
  } catch (error) {
    Logger.log('Error creating invoice from estimate: ' + error.toString());
    return { success: false, error: error.toString() };
  }
}

