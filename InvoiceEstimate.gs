/**
 * Generate project from approved estimate (auto-called when estimate is approved)
 */
function generateProjectFromEstimate(estimateId) {
  try {
    const spreadsheet = SpreadsheetApp.openById(SPREADSHEET_ID);
    const invoiceSheet = spreadsheet.getSheetByName(INVOICES_ESTIMATES_SHEET);
    
    if (!invoiceSheet) {
      return { success: false, error: 'Invoices sheet not found' };
    }
    
    // Get estimate data
    const estimateResult = getInvoiceEstimate(estimateId);
    if (!estimateResult.success) {
      return estimateResult;
    }
    
    const estimate = estimateResult.data;
    
    // Only create project from approved estimates
    if (estimate.type !== 'Estimate' || estimate.approvalStatus !== 'Approved') {
      return { success: false, error: 'Can only generate projects from approved estimates' };
    }
    
    const customerEmail = estimate.customerEmail || '';
    const customerName = estimate.customerName || '';
    const quoteNumber = estimate.quoteNumber || estimateId;
    const estimateTotal = parseFloat(estimate.total) || 0;
    const estimateDate = estimate.date || new Date();
    const estimateNotes = estimate.notes || '';
    const itemsJson = estimate.items || '[]';
    const items = JSON.parse(itemsJson);
    
    // Generate Project ID
    const projectId = 'PROJ-' + quoteNumber.replace(/[^0-9]/g, '') || 'PROJ-' + Utilities.getUuid().substring(0, 8).toUpperCase();
    
    // 1. Create/Update Project
    let projectsSheet = spreadsheet.getSheetByName(PROJECTS_SHEET_NAME);
    if (!projectsSheet) {
      projectsSheet = spreadsheet.insertSheet(PROJECTS_SHEET_NAME);
      projectsSheet.appendRow(['Project ID', 'Customer Email', 'Customer Name', 'Project Type', 'Status', 'Start Date', 'Estimated Completion Date', 'Current Phase', 'Notes', 'Created Date', 'Last Updated', 'Estimate ID', 'Estimate Number']);
      // Format header
      const headerRange = projectsSheet.getRange(1, 1, 1, 13);
      headerRange.setFontWeight('bold');
      headerRange.setBackground('#1a1a1a');
      headerRange.setFontColor('#3b82f6');
    }
    
    // Check if project already exists for this estimate
    const projectData = projectsSheet.getDataRange().getValues();
    const projectHeaders = projectData[0];
    const projectIdCol = projectHeaders.indexOf('Project ID');
    const estimateIdCol = projectHeaders.indexOf('Estimate ID');
    
    let projectExists = false;
    let projectRowIndex = -1;
    for (let i = 1; i < projectData.length; i++) {
      if (projectData[i][estimateIdCol] === estimateId) {
        projectExists = true;
        projectRowIndex = i + 1;
        break;
      }
    }
    
    const now = new Date();
    const projectRow = [
      projectId,
      customerEmail,
      customerName,
      'Pool Build', // Default, can be changed
      'Planning',
      estimateDate,
      '', // Estimated completion - can be set later
      'Project created from approved estimate',
      estimateNotes || 'Generated from estimate ' + quoteNumber,
      now,
      now,
      estimateId,
      quoteNumber
    ];
    
    if (projectExists) {
      projectsSheet.getRange(projectRowIndex, 1, 1, projectRow.length).setValues([projectRow]);
    } else {
      projectsSheet.appendRow(projectRow);
    }
    
    // 2. Create Project Items from Estimate Items
    let itemsSheet = spreadsheet.getSheetByName(PROJECT_ITEMS_SHEET_NAME);
    if (!itemsSheet) {
      itemsSheet = spreadsheet.insertSheet(PROJECT_ITEMS_SHEET_NAME);
      itemsSheet.appendRow(['Project ID', 'Item Name', 'Item Description', 'Quantity', 'Unit Price', 'Total Cost', 'Order Date', 'Delivery Date', 'Status', 'Vendor/Supplier', 'Tracking Number', 'Notes', 'Added Date', 'Estimate Item']);
      // Format header
      const headerRange = itemsSheet.getRange(1, 1, 1, 14);
      headerRange.setFontWeight('bold');
      headerRange.setBackground('#1a1a1a');
      headerRange.setFontColor('#3b82f6');
    }
    
    // Add each estimate item as a project item
    const itemsData = itemsSheet.getDataRange().getValues();
    const itemsHeaders = itemsData[0];
    const itemProjectIdCol = itemsHeaders.indexOf('Project ID');
    const itemEstimateItemCol = itemsHeaders.indexOf('Estimate Item');
    
    // Remove existing items for this project (to avoid duplicates)
    const rowsToDelete = [];
    for (let i = itemsData.length - 1; i >= 1; i--) {
      if (itemsData[i][itemProjectIdCol] === projectId) {
        rowsToDelete.push(i + 1);
      }
    }
    // Delete from bottom to top to maintain indices
    for (let i = rowsToDelete.length - 1; i >= 0; i--) {
      itemsSheet.deleteRow(rowsToDelete[i]);
    }
    
    // Add new items
    items.forEach((item, index) => {
      const itemRow = [
        projectId,
        item.description || item.name || 'Item ' + (index + 1),
        item.description || '',
        parseFloat(item.quantity || 1),
        parseFloat(item.price || item.unitPrice || 0),
        parseFloat(item.quantity || 1) * parseFloat(item.price || item.unitPrice || 0),
        '', // Order Date - to be filled
        '', // Delivery Date - to be filled
        'Ordered', // Status
        '', // Vendor
        '', // Tracking Number
        '', // Notes
        now,
        JSON.stringify(item) // Store original estimate item
      ];
      itemsSheet.appendRow(itemRow);
    });
    
    return {
      success: true,
      projectId: projectId,
      message: 'Project created successfully from approved estimate',
      itemsCount: items.length
    };
    
  } catch (error) {
    Logger.log('Error generating project from estimate: ' + error.toString());
    return {
      success: false,
      error: error.toString()
    };
  }
}

/**
 * Get saved quotes for a customer from Customer Portal
 */
function getSavedQuotesForCustomer(customerEmail) {
  try {
    if (!customerEmail) {
      return { success: false, error: 'Customer email is required' };
    }
    
    Logger.log('getSavedQuotesForCustomer called with: ' + customerEmail);
    
    // Check if input is an email or a name
    const isEmail = customerEmail.includes('@');
    const searchValue = customerEmail.toLowerCase().trim();
    
    Logger.log('Input type: ' + (isEmail ? 'Email' : 'Name') + ', Search value: "' + searchValue + '"');
    
    const spreadsheet = SpreadsheetApp.openById(SPREADSHEET_ID);
    const sheet = spreadsheet.getSheetByName(INVOICES_ESTIMATES_SHEET);
    
    if (!sheet) {
      Logger.log('Sheet "' + INVOICES_ESTIMATES_SHEET + '" not found');
      return { success: true, quotes: [] };
    }
    
    const lastRow = sheet.getLastRow();
    if (lastRow < 2) {
      Logger.log('Sheet has no data rows');
      return { success: true, quotes: [] };
    }
    
    const quotes = [];
    const seenIds = new Set(); // Prevent duplicates
    
    const sheetCols = sheet.getLastColumn();
    Logger.log('Sheet has ' + sheetCols + ' columns. Last row: ' + lastRow);
    
    // Determine column structure (8 columns = new, 7 columns = old, 6 columns = older, 4 columns = oldest)
    const is8Column = (sheetCols >= 8);
    const is7Column = (sheetCols === 7);
    const is6Column = (sheetCols === 6);
    const is4Column = (sheetCols === 4);
    
    Logger.log('Sheet structure detected: ' + sheetCols + ' columns (8=new, 7=old, 6=older, 4=oldest)');
    
    // Read all columns (handles 4, 6, 7, and 8 column formats)
    for (let rowNum = 2; rowNum <= lastRow; rowNum++) {
      try {
        // Determine column positions based on structure
        let idCol, emailCol, json1Col, json2Col, json3Col, totalCol;
        
        if (is8Column) {
          // New 8-column structure: Company ID (1), ID (2), Email (3), JSON Parts (4-6), Total (7), Payment Schedule (8)
          idCol = 2;
          emailCol = 3;
          json1Col = 4;
          json2Col = 5;
          json3Col = 6;
          totalCol = 7;
        } else if (is7Column) {
          // Old 7-column structure: ID (1), Email (2), JSON Parts (3-5), Total (6), Payment Schedule (7)
          idCol = 1;
          emailCol = 2;
          json1Col = 3;
          json2Col = 4;
          json3Col = 5;
          totalCol = 6;
        } else if (is6Column) {
          // Older 6-column structure: ID (1), Email (2), JSON Parts (3-5), Total (6)
          idCol = 1;
          emailCol = 2;
          json1Col = 3;
          json2Col = 4;
          json3Col = 5;
          totalCol = 6;
        } else {
          // Oldest 4-column structure: ID (1), Email (2), JSON (3), Total (4)
          idCol = 1;
          emailCol = 2;
          json1Col = 3;
          json2Col = 3; // Same column for old format
          json3Col = 3; // Same column for old format
          totalCol = 4;
        }
        
        // Column: ID
        const invoiceId = sheet.getRange(rowNum, idCol).getValue();
        if (!invoiceId) {
          Logger.log('Row ' + rowNum + ': No ID found, skipping');
          continue;
        }
        
        // Column: Customer Email
        const rowEmailRaw = sheet.getRange(rowNum, emailCol).getValue();
        const rowEmail = (rowEmailRaw || '').toString().toLowerCase().trim();
        Logger.log('Row ' + rowNum + ': ID=' + invoiceId + ', Email="' + rowEmail + '"');
      
        // Skip if already seen
        if (seenIds.has(invoiceId)) {
          Logger.log('Row ' + rowNum + ': Already seen ID ' + invoiceId + ', skipping');
          continue;
        }
      
        // First, try to get JSON to check customer name (for name-based search)
        let jsonData = null;
        let rowCustomerName = '';
        try {
          const jsonPart1 = sheet.getRange(rowNum, json1Col).getValue() || '';
          const jsonPart2 = (is4Column ? '' : sheet.getRange(rowNum, json2Col).getValue() || '');
          const jsonPart3 = (is4Column ? '' : sheet.getRange(rowNum, json3Col).getValue() || '');
          let jsonStr = concatenateJsonChunks(jsonPart1, jsonPart2, jsonPart3);
          
          // If no JSON found in parts, try old format (single column)
          if (!jsonStr || jsonStr.length === 0) {
            jsonStr = String(jsonPart1 || '').trim();
          }
          
          if (jsonStr && (jsonStr.startsWith('{') || jsonStr.startsWith('['))) {
            jsonData = JSON.parse(jsonStr);
            rowCustomerName = (jsonData.customerName || '').toString().toLowerCase().trim();
          }
        } catch (e) {
          Logger.log('ERROR parsing JSON at row ' + rowNum + ': ' + e.toString());
          // Continue to next row if JSON parsing fails
          continue;
        }
      
        // Match by email OR by customer name (if input doesn't look like an email)
        let isMatch = false;
        if (isEmail) {
          // Search by email
          isMatch = (rowEmail === searchValue);
        } else {
          // Search by customer name
          isMatch = (rowCustomerName === searchValue);
          // Also try matching email if name doesn't match (in case name was entered in email field)
          if (!isMatch && rowEmail === searchValue) {
            isMatch = true;
          }
        }
        
        if (isMatch) {
          Logger.log('✓ MATCH FOUND! Row ' + rowNum + ' - ID: ' + invoiceId + ', Email: "' + rowEmail + '", Name: "' + rowCustomerName + '"');
          seenIds.add(invoiceId);
          
          // If we haven't parsed JSON yet, do it now
          if (!jsonData) {
            try {
              const jsonPart1 = sheet.getRange(rowNum, json1Col).getValue() || '';
              const jsonPart2 = (is4Column ? '' : sheet.getRange(rowNum, json2Col).getValue() || '');
              const jsonPart3 = (is4Column ? '' : sheet.getRange(rowNum, json3Col).getValue() || '');
              let jsonStr = concatenateJsonChunks(jsonPart1, jsonPart2, jsonPart3);
              
              if (!jsonStr || jsonStr.length === 0) {
                jsonStr = String(jsonPart1 || '').trim();
              }
              
              if (jsonStr && (jsonStr.startsWith('{') || jsonStr.startsWith('['))) {
                jsonData = JSON.parse(jsonStr);
              } else {
                Logger.log('⚠ JSON cell is empty or invalid at row ' + rowNum);
                continue;
              }
            } catch (e) {
              Logger.log('ERROR parsing JSON at row ' + rowNum + ': ' + e.toString());
              continue;
            }
          }
          
          // Total column
          let totalValue = parseFloat(String(sheet.getRange(rowNum, totalCol).getValue() || 0).replace(/[$,]/g, '')) || 0;
          if (totalValue === 0 && is4Column) {
            // Try old format (column 4)
            totalValue = parseFloat(String(sheet.getRange(rowNum, 4).getValue() || 0).replace(/[$,]/g, '')) || 0;
          }
          
          // Build quote object from JSON data
          const quoteObj = {
            id: jsonData.id || invoiceId,
            invoiceEstimateId: jsonData.id || invoiceId,
            type: jsonData.type || 'Estimate',
            status: jsonData.status || 'Draft',
            customerName: jsonData.customerName || '',
            customerEmail: jsonData.customerEmail || rowEmail,
            customerPhone: jsonData.customerPhone || '',
            customerAddress: jsonData.customerAddress || '',
            date: jsonData.date ? (jsonData.date instanceof Date ? Utilities.formatDate(jsonData.date, Session.getScriptTimeZone(), 'yyyy-MM-dd') : String(jsonData.date)) : '',
            dueDate: jsonData.dueDate ? (jsonData.dueDate instanceof Date ? Utilities.formatDate(jsonData.dueDate, Session.getScriptTimeZone(), 'yyyy-MM-dd') : String(jsonData.dueDate)) : '',
            invoiceNumber: jsonData.invoiceNumber || '',
            quoteNumber: jsonData.quoteNumber || invoiceId,
            items: jsonData.items || '[]',
            subtotal: jsonData.subtotal || 0,
            taxRate: jsonData.taxRate || 0,
            taxAmount: jsonData.taxAmount || 0,
            discount: jsonData.discount || 0,
            total: totalValue || jsonData.total || 0,
            notes: jsonData.notes || '',
            terms: jsonData.terms || '',
            savedDate: jsonData.date ? (jsonData.date instanceof Date ? Utilities.formatDate(jsonData.date, Session.getScriptTimeZone(), 'yyyy-MM-dd') : String(jsonData.date)) : new Date().toISOString().split('T')[0]
          };
          
          Logger.log('✓ Quote loaded: ID=' + quoteObj.id + ', Total=' + quoteObj.total + ', Items length=' + quoteObj.items.length);
          quotes.push(quoteObj);
        }
      } catch (e) {
        Logger.log('Error processing row ' + rowNum + ': ' + e.toString());
        continue;
      }
    }
    
    // Sort by date descending (most recent first)
    quotes.sort((a, b) => {
      const dateA = a.date ? new Date(a.date) : new Date(0);
      const dateB = b.date ? new Date(b.date) : new Date(0);
      return dateB - dateA;
    });
    
    Logger.log('Found ' + quotes.length + ' saved quotes/estimates for customer: ' + customerEmail);
    return { success: true, quotes: quotes };
    
  } catch (error) {
    Logger.log('Error getting saved quotes: ' + error.toString());
    Logger.log('Stack trace: ' + error.stack);
    return { success: false, error: error.toString() };
  }
}

/**
 * Load a saved quote from Customer Portal into the invoice maker
 * Returns the quote data formatted for the invoice maker
 */
function loadSavedQuote(customerEmail, quoteId) {
  try {
    if (!customerEmail || !quoteId) {
      return { success: false, error: 'Customer email and quote ID are required' };
    }
    
    const spreadsheet = SpreadsheetApp.openById(SPREADSHEET_ID);
    const sheet = spreadsheet.getSheetByName(INVOICES_ESTIMATES_SHEET);
    
    if (!sheet) {
      return { success: false, error: 'Invoices & Estimates sheet not found' };
    }
    
    const lastRow = sheet.getLastRow();
    if (lastRow < 2) {
        return { success: false, error: 'Quote not found' };
      }
      
    // Determine column structure (8 columns = new, 7 columns = old, 6 columns = older, 4 columns = oldest)
    const sheetCols = sheet.getLastColumn();
    const is8Column = (sheetCols >= 8);
    const is7Column = (sheetCols === 7);
    const is6Column = (sheetCols === 6);
    const is4Column = (sheetCols === 4);
    
    Logger.log('loadSavedQuote: Sheet has ' + sheetCols + ' columns. Looking for quote ID: ' + quoteId);
    
    // Determine column positions based on structure
    let idCol, emailCol, json1Col, json2Col, json3Col, paymentScheduleCol;
    
    if (is8Column) {
      // New 8-column structure: Company ID (1), ID (2), Email (3), JSON Parts (4-6), Total (7), Payment Schedule (8)
      idCol = 2;
      emailCol = 3;
      json1Col = 4;
      json2Col = 5;
      json3Col = 6;
      paymentScheduleCol = 8;
    } else if (is7Column) {
      // Old 7-column structure: ID (1), Email (2), JSON Parts (3-5), Total (6), Payment Schedule (7)
      idCol = 1;
      emailCol = 2;
      json1Col = 3;
      json2Col = 4;
      json3Col = 5;
      paymentScheduleCol = 7;
    } else if (is6Column) {
      // Older 6-column structure: ID (1), Email (2), JSON Parts (3-5), Total (6)
      idCol = 1;
      emailCol = 2;
      json1Col = 3;
      json2Col = 4;
      json3Col = 5;
      paymentScheduleCol = -1; // No payment schedule column
    } else {
      // Oldest 4-column structure: ID (1), Email (2), JSON (3), Total (4)
      idCol = 1;
      emailCol = 2;
      json1Col = 3;
      json2Col = 3; // Same column for old format
      json3Col = 3; // Same column for old format
      paymentScheduleCol = -1; // No payment schedule column
    }
    
    const customerEmailLower = customerEmail.toLowerCase().trim();
    let jsonData = null;
    
    for (let rowNum = 2; rowNum <= lastRow; rowNum++) {
      const invoiceId = sheet.getRange(rowNum, idCol).getValue(); // ID column
      if (invoiceId === quoteId) {
        Logger.log('Found quote ID match at row ' + rowNum);
        
        // Verify customer email matches
        const rowEmail = (sheet.getRange(rowNum, emailCol).getValue() || '').toString().toLowerCase().trim();
        Logger.log('Row email: "' + rowEmail + '", Looking for: "' + customerEmailLower + '"');
        
        // Also check customer name in case email was entered as name
        let emailMatches = (rowEmail === customerEmailLower);
        
        if (!emailMatches) {
          // Try to read JSON to check customer name
          try {
            const jsonPart1 = sheet.getRange(rowNum, json1Col).getValue() || '';
            const jsonPart2 = (is4Column ? '' : sheet.getRange(rowNum, json2Col).getValue() || '');
            const jsonPart3 = (is4Column ? '' : sheet.getRange(rowNum, json3Col).getValue() || '');
            let jsonStr = concatenateJsonChunks(jsonPart1, jsonPart2, jsonPart3);
            
            if (!jsonStr || jsonStr.length === 0) {
              jsonStr = String(jsonPart1 || '').trim();
            }
            
            if (jsonStr && jsonStr.startsWith('{')) {
              const tempJsonData = JSON.parse(jsonStr);
              const jsonEmail = (tempJsonData.customerEmail || '').toString().toLowerCase().trim();
              const jsonName = (tempJsonData.customerName || '').toString().toLowerCase().trim();
              
              // Match by email or name
              emailMatches = (jsonEmail === customerEmailLower) || (jsonName === customerEmailLower);
            }
          } catch (e) {
            Logger.log('Error checking JSON for email match: ' + e.toString());
          }
        }
        
        if (emailMatches) {
          Logger.log('Email/name matches! Reading quote data...');
          
          // Read JSON (concatenate them, handle old formats)
          try {
            const jsonPart1 = sheet.getRange(rowNum, json1Col).getValue() || '';
            const jsonPart2 = (is4Column ? '' : sheet.getRange(rowNum, json2Col).getValue() || '');
            const jsonPart3 = (is4Column ? '' : sheet.getRange(rowNum, json3Col).getValue() || '');
            let jsonStr = concatenateJsonChunks(jsonPart1, jsonPart2, jsonPart3);
            
            // If no JSON found in parts, try old format (single column)
            if (!jsonStr || jsonStr.length === 0) {
              jsonStr = String(jsonPart1 || '').trim();
            }
            
            if (jsonStr && (jsonStr.startsWith('{') || jsonStr.startsWith('['))) {
              jsonData = JSON.parse(jsonStr);
              
              // Read payment schedule if available
              if (paymentScheduleCol > 0) {
                try {
                  const paymentScheduleStr = sheet.getRange(rowNum, paymentScheduleCol).getValue() || '';
                  if (paymentScheduleStr && String(paymentScheduleStr).trim().length > 0) {
                    jsonData.paymentSchedule = JSON.parse(String(paymentScheduleStr));
                  }
                } catch (e) {
                  Logger.log('Error parsing payment schedule: ' + e.toString());
                }
              }
              
              Logger.log('Successfully loaded quote data');
              break;
            }
          } catch (e) {
            Logger.log('Error parsing JSON at row ' + rowNum + ': ' + e.toString());
            return { success: false, error: 'Error parsing quote data: ' + e.toString() };
          }
        } else {
          Logger.log('Email/name does not match. Row email: "' + rowEmail + '", Looking for: "' + customerEmailLower + '"');
        }
      }
    }
    
    if (!jsonData) {
      return { success: false, error: 'Quote not found' };
    }
    
    // Format dates from JSON
    let dateValue = '';
    if (jsonData.date) {
      if (jsonData.date instanceof Date) {
        dateValue = Utilities.formatDate(jsonData.date, Session.getScriptTimeZone(), 'yyyy-MM-dd');
      } else {
        dateValue = String(jsonData.date);
      }
    }
    
    let dueDateValue = '';
    if (jsonData.dueDate) {
      if (jsonData.dueDate instanceof Date) {
        dueDateValue = Utilities.formatDate(jsonData.dueDate, Session.getScriptTimeZone(), 'yyyy-MM-dd');
      } else {
        dueDateValue = String(jsonData.dueDate);
      }
    }
    
    // Build quote object from JSON data
    const quote = {
      id: jsonData.id || quoteId,
      invoiceEstimateId: jsonData.id || quoteId,
      type: jsonData.type || 'Estimate',
      status: jsonData.status || 'Draft',
      customerName: jsonData.customerName || '',
      customerEmail: jsonData.customerEmail || customerEmail,
      customerPhone: jsonData.customerPhone || '',
      customerAddress: jsonData.customerAddress || '',
      date: dateValue,
      dueDate: dueDateValue,
      invoiceNumber: jsonData.invoiceNumber || '',
      quoteNumber: jsonData.quoteNumber || quoteId,
      items: jsonData.items || '[]',
      subtotal: jsonData.subtotal || 0,
      taxRate: jsonData.taxRate || 0,
      taxAmount: jsonData.taxAmount || 0,
      discount: jsonData.discount || 0,
      total: jsonData.total || 0,
      notes: jsonData.notes || '',
      terms: jsonData.terms || ''
    };
    
    // Convert to invoice maker format
      const invoiceData = {
      id: quoteId,
        type: quote.type || 'Estimate',
        customerName: quote.customerName || '',
        customerEmail: customerEmail,
        customerPhone: quote.customerPhone || '',
        customerAddress: quote.customerAddress || '',
      date: dateValue || new Date().toISOString().split('T')[0],
      dueDate: dueDateValue || '',
        invoiceNumber: quote.invoiceNumber || '',
      quoteNumber: quote.quoteNumber || quoteId,
      items: quote.items,
        notes: quote.notes || '',
        terms: quote.terms || '',
        taxRate: quote.taxRate || 0,
        discount: quote.discount || 0,
        status: quote.status || 'Draft',
      savedQuoteId: quoteId
      };
      
      return {
        success: true,
        invoiceData: invoiceData,
        quote: quote
      };
    
  } catch (error) {
    Logger.log('Error loading saved quote: ' + error.toString());
    Logger.log('Stack trace: ' + error.stack);
    return { success: false, error: error.toString() };
  }
}

