            <td class="text-center" style="padding: 16px;">${item.quantity || 0}</td>
            <td class="text-right" style="padding: 16px;">$${formatCurrency(item.price || 0)}</td>
            <td class="text-right" style="padding: 16px;"><strong>$${formatCurrency(itemTotal)}</strong></td>
          </tr>
        `;
      });
    } else {
      itemsHtml = '<tr><td colspan="4" style="text-align: center; padding: 40px; color: #6b7280;">No items</td></tr>';
    }
    
    // Build payment schedule HTML if exists
