        ${taxRate > 0 ? `<div class="total-row tax"><span>Tax (${taxRate}%):</span><span>$${formatCurrency(taxAmount)}</span></div>` : ''}
        ${discount > 0 ? `<div class="total-row"><span>Discount:</span><span>-$${formatCurrency(discount)}</span></div>` : ''}
        <div class="total-row grand-total">
          <span>Total:</span>
          <span>$${formatCurrency(total)}</span>
        </div>
      </div>
      ${paymentScheduleHtml}
      ${signatureLineHtml}
    </div>
    <div class="invoice-footer">
      <div class="invoice-notes">
        <h3>Notes</h3>
        <p style="white-space: pre-wrap;">${escapeHtml(data.notes || 'Thank you for your business!')}</p>
      </div>
      
      ${data.terms ? `
      <div class="invoice-notes">
        <h3>Terms & Conditions</h3>
        <p style="white-space: pre-wrap;">${escapeHtml(data.terms)}</p>
      </div>
      ` : ''}
    </div>
  </div>
</body>
</html>`;
    
    // Convert HTML to PDF blob
    const blob = Utilities.newBlob(htmlContent, 'text/html', 'invoice.html');
    const pdfBlob = blob.getAs('application/pdf');
    
    pdfBlob.setName(`${type}_${invoiceNumber}.pdf`);
    
    Logger.log('✅ PDF blob generated (matches live preview). Size: ' + pdfBlob.getBytes().length + ' bytes');
    
    return pdfBlob;
    
  } catch (error) {
    Logger.log('Error generating PDF blob: ' + error.toString());
    throw error;
  }
}

/**
 * Record all backdated payments from Stripe export
 * Processes CSV data, records payments, and highlights fully-paid invoices green
 * @param {array} paymentData - Array of payment objects from Stripe CSV
 * Example: [{date, amount, email, status, description}, ...]
 */
function recordAllBackdatedPayments(paymentData) {
  try {
    const spreadsheet = SpreadsheetApp.openById(SPREADSHEET_ID);
    const invoicesSheet = spreadsheet.getSheetByName(INVOICES_ESTIMATES_SHEET);
    
    if (!invoicesSheet) {
      return { success: false, error: 'Invoices sheet not found' };
    }
    
    const results = {
      totalProcessed: 0,
      successfulRecordings: 0,
      failedRecordings: 0,
      highlighted: 0,
      recordings: []
    };
    
    // Process each payment
    paymentData.forEach(payment => {
      // Skip failed payments, pending payments without IDs, or missing data
      if (payment.Status !== 'Paid' && payment.Status !== 'Completed') {
        return;
      }
      
      if (!payment['Customer Email'] || !payment.Amount) {
        return;
      }
      
      results.totalProcessed++;
      
      try {
        // Parse amount and date
        const amount = parseFloat(payment.Amount) || 0;
        const paymentDate = payment['Created date (UTC)'] || new Date().toISOString();
        const email = String(payment['Customer Email']).trim();
        const description = payment.Description || 'Stripe Payment';
        
        // Record the payment
        const recordResult = recordInvoiceEstimatePayment_(
          email,                    // Search by customer email
          amount,
          'Stripe',                 // Payment method
          paymentDate,              // Backdate to payment date
          description,              // Notes
          ''                        // Job status - will auto-set to Completed if fully paid
        );
        
        if (recordResult.success) {
          results.successfulRecordings++;
          results.recordings.push({
            email: email,
            amount: amount,
            invoiceId: recordResult.invoiceId,
            status: recordResult.paymentStatus,
            jobStatus: recordResult.jobStatus,
            isFullyPaid: recordResult.isFullyPaid
          });
          Logger.log('✅ Recorded: ' + email + ' - $' + amount.toFixed(2) + ' (Invoice: ' + recordResult.invoiceId + ')');
        } else {
          results.failedRecordings++;
          Logger.log('❌ Failed: ' + email + ' - ' + recordResult.error);
        }
      } catch (error) {
        results.failedRecordings++;
        Logger.log('Error processing payment for ' + payment['Customer Email'] + ': ' + error.toString());
      }
    });
    
    // Now highlight fully-paid invoices in green
    const lastRow = invoicesSheet.getLastRow();
    const sheetCols = invoicesSheet.getLastColumn();
    const is8Column = (sheetCols >= 8);
    const idCol = is8Column ? 2 : 1;
    const emailCol = is8Column ? 3 : 2;
    const json1Col = is8Column ? 4 : 3;
    const json2Col = is8Column ? 5 : 4;
    const json3Col = is8Column ? 6 : 5;
    
    for (let i = 1; i < lastRow; i++) {
      try {
        const rowEmail = String(invoicesSheet.getRange(i + 1, emailCol).getValue() || '').trim().toLowerCase();
        const jsonPart1 = invoicesSheet.getRange(i + 1, json1Col).getValue() || '';
        const jsonPart2 = invoicesSheet.getRange(i + 1, json2Col).getValue() || '';
        const jsonPart3 = invoicesSheet.getRange(i + 1, json3Col).getValue() || '';
        
        let jsonStr = concatenateJsonChunks(jsonPart1, jsonPart2, jsonPart3);
        if (!jsonStr || jsonStr.length === 0) {
          jsonStr = String(jsonPart1 || '').trim();
        }
        
        if (jsonStr && jsonStr.startsWith('{')) {
          const jsonData = JSON.parse(jsonStr);
          const paymentStatus = jsonData.paymentStatus || 'Pending';
          
          // Highlight green if fully paid
          if (paymentStatus === 'Paid') {
            invoicesSheet.getRange(i + 1, 1, 1, sheetCols).setBackground('#d4edda'); // Light green
            invoicesSheet.getRange(i + 1, 1, 1, sheetCols).setFontColor('#155724'); // Dark green text
            results.highlighted++;
            Logger.log('🟢 Highlighted as PAID: ' + (jsonData.customerName || rowEmail));
          }
        }
      } catch (e) {
        // Skip rows with parse errors
      }
    }
    
    Logger.log('✅ Batch recording complete! Processed: ' + results.totalProcessed + ', Successful: ' + results.successfulRecordings + ', Highlighted: ' + results.highlighted);
    
    return {
      success: true,
      message: 'Batch payment recording complete',
      totalProcessed: results.totalProcessed,
      successfulRecordings: results.successfulRecordings,
      failedRecordings: results.failedRecordings,
      highlightedGreen: results.highlighted,
      details: results.recordings
    };
    
  } catch (error) {
    Logger.log('Error in recordAllBackdatedPayments: ' + error.toString());
    return { success: false, error: error.toString() };
  }
}

/**
 * Import Stripe CSV and batch record all payments
 * Paste CSV data into a "Stripe Import" sheet first
 */
function importAndRecordStripePayments() {
  try {
    const spreadsheet = SpreadsheetApp.openById(SPREADSHEET_ID);
    let importSheet = spreadsheet.getSheetByName('Stripe Import');
    
    // If sheet doesn't exist, create it
    if (!importSheet) {
      importSheet = spreadsheet.insertSheet('Stripe Import');
      Logger.log('Created "Stripe Import" sheet. Please paste CSV data there.');
      return { success: false, message: 'Created Stripe Import sheet. Paste your CSV there and run again.' };
    }
    
    const data = importSheet.getDataRange().getValues();
    if (data.length <= 1) {
      return { success: false, message: 'No data in Stripe Import sheet. Paste CSV data first.' };
    }
    
    // Parse CSV headers
    const headers = data[0];
    const payments = [];
    
    for (let i = 1; i < data.length; i++) {
      const row = data[i];
      const payment = {};
      
      headers.forEach((header, index) => {
        payment[header] = row[index] || '';
      });
      
      payments.push(payment);
    }
    
    // Record all payments
    const result = recordAllBackdatedPayments(payments);
    
    if (result.success) {
      // Clear the import sheet after successful import
      importSheet.clear();
      Logger.log('✅ Import sheet cleared.');
    }
    
    return result;
    
  } catch (error) {
    Logger.log('Error in importAndRecordStripePayments: ' + error.toString());
    return { success: false, error: error.toString() };
  }
}

