    const statusCol = headers.indexOf('Status');
    const finalizedDateCol = headers.indexOf('Finalized Date');
    
    for (let i = 1; i < dataRows.length; i++) {
      const row = dataRows[i];
      if (row[idCol] === paymentScheduleId) {
