/**
 * Send payment receipt to customer via email
 * @param {string} projectId - The project ID
 * @param {string} allocationId - The allocation ID
 * @param {string} customerEmail - Customer email address
 * @returns {object} { success, messageId, error }
 */
function sendPaymentReceipt(projectId, allocationId, customerEmail) {
  try {
    const receiptResult = generatePaymentReceipt(projectId, allocationId, customerEmail);
    if (!receiptResult.success) {
      return { success: false, error: receiptResult.error };
    }

    if (!customerEmail) {
      return { success: false, error: 'Customer email required' };
    }

    const projectResult = getProject(projectId);
    const project = projectResult.success ? projectResult.project : {};

    const emailSubject = `Payment Receipt - ${project.projectName || projectId}`;
    const emailBody = receiptResult.receiptHTML;

    GmailApp.sendEmail(customerEmail, emailSubject, receiptResult.receiptText, {
      htmlBody: emailBody,
      from: COMPANY_EMAIL,
      replyTo: COMPANY_EMAIL
    });

    Logger.log('✅ Payment receipt sent to ' + customerEmail);
    return {
      success: true,
      messageId: allocationId,
      message: 'Receipt sent to ' + customerEmail
    };

  } catch (error) {
    Logger.log('❌ Error sending payment receipt: ' + error.toString());
    return { success: false, error: error.toString() };
  }
}

