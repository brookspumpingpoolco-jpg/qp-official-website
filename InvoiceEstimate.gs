/**
 * Calculate Profit
 */
function calculateProfit(data) {
  try {
    const items = JSON.parse(data.items || '[]');
    const spreadsheet = SpreadsheetApp.openById(SPREADSHEET_ID);
    const priceBookSheet = spreadsheet.getSheetByName(PRICE_BOOK_SHEET);
    
    let totalRevenue = 0;
    let totalCost = 0;
    let stockRevenue = 0; // Revenue from items already in stock
    let stockProfit = 0; // Profit from stock items (revenue - 0 cost = revenue)
    let materialsRevenue = 0;
    let materialsCost = 0;
    let laborRevenue = 0;
    let laborCost = 0;
    let itemDetails = [];
    
    // Calculate revenue and cost for each item
    items.forEach(item => {
      const quantity = parseFloat(item.quantity || 0);
      const price = parseFloat(item.price || 0);
      const revenue = quantity * price;
      const isStock = item.isStock || item.onHand || false;
      const isLabor = item.isLabor || false;
      
      Logger.log('Processing item: ' + (item.name || 'Unknown') + ', Qty: ' + quantity + ', Price: ' + price + ', Revenue: ' + revenue + ', Stock: ' + isStock + ', Labor: ' + isLabor);
      
      // If item is in stock, cost is 0 (already on hand)
      let cost = 0;
      if (isStock) {
        // Stock items have 0 cost - we already have them
        cost = 0;
        stockRevenue += revenue;
        stockProfit += revenue; // Profit = revenue when cost is 0
        if (isLabor) {
          laborRevenue += revenue;
        } else {
          materialsRevenue += revenue;
        }
        Logger.log('Stock item - cost set to 0, stockProfit += ' + revenue);
      } else {
        // Regular item - calculate cost normally
        totalRevenue += revenue;
        if (isLabor) {
          laborRevenue += revenue;
        } else {
          materialsRevenue += revenue;
        }
        
        // PRIORITY: Use actualCost if manually set (from profit mode cost input)
        // This is what the user actually paid, so it takes highest priority
        // Check if actualCost was explicitly set (even if it's 0, that's a valid value)
        cost = null;
        if (item.hasOwnProperty('actualCost') || item.actualCost !== undefined) {
          cost = parseFloat(item.actualCost);
          if (isNaN(cost)) cost = 0;
        }
        
        // If actualCost not set, try item.cost field
        if (cost === null || (cost === 0 && !item.hasOwnProperty('actualCost'))) {
          const costValue = parseFloat(item.cost || 0);
          if (!isNaN(costValue)) {
            cost = costValue;
          }
        }
        
        // If still no cost, try to find from price book
        if ((cost === null || cost === 0) && priceBookSheet && item.code) {
          const data = priceBookSheet.getDataRange().getValues();
          for (let i = 6; i < data.length; i++) {
            const row = data[i];
            if (row[1] === item.code) {
              // Cost might be in a column - adjust based on your sheet structure
              // Assuming cost is in column 9 (index 8) or calculate from markup
              const priceBookCost = parseFloat(row[8]) || 0;
              if (priceBookCost > 0) {
                cost = priceBookCost;
                break;
              }
            }
          }
        }
        
        // If no cost found and user hasn't manually entered one, estimate based on typical markup
        // Only estimate if actualCost was never set (user hasn't interacted with cost field)
        if ((cost === null || cost === 0) && price > 0 && !item.hasOwnProperty('actualCost')) {
          cost = price * 0.67; // Rough estimate (assume 50% markup = 33% cost)
        }
        
        // Final fallback - ensure cost is a number
        if (cost === null || isNaN(cost)) {
          cost = 0;
        }
        
        const itemCost = quantity * cost;
        totalCost += itemCost;
        
        // Track costs by type
        if (isLabor) {
          laborCost += itemCost;
        } else {
          materialsCost += itemCost;
        }
        
        Logger.log('Item cost calculation: actualCost=' + (item.actualCost !== undefined ? item.actualCost : 'not set') + 
                   ', finalCost=' + cost + ', quantity=' + quantity + ', itemCost=' + itemCost);
      }
      
      itemDetails.push({
        name: item.name,
        quantity: quantity,
        price: price,
        revenue: revenue,
        cost: cost,
        itemCost: quantity * cost,
        profit: revenue - (quantity * cost),
        margin: price > 0 ? ((price - cost) / price * 100) : 0,
        isStock: isStock
      });
    });
    
    // Total revenue includes both regular and stock items
    const totalRevenueAll = totalRevenue + stockRevenue;
    const profit = totalRevenue - totalCost;
    const materialsProfit = materialsRevenue - materialsCost;
    const laborProfit = laborRevenue - laborCost;
    const profitMargin = totalRevenueAll > 0 ? ((profit + stockProfit) / totalRevenueAll * 100) : 0;
    const markup = totalCost > 0 ? ((totalRevenue - totalCost) / totalCost * 100) : 0;
    
    return {
      success: true,
      totalRevenue: totalRevenueAll, // Include stock revenue in total
      totalCost: totalCost,
      profit: profit, // Regular profit (excluding stock)
      stockProfit: stockProfit, // Profit from stock items
      materialsRevenue: materialsRevenue,
      materialsCost: materialsCost,
      materialsProfit: materialsProfit,
      laborRevenue: laborRevenue,
      laborCost: laborCost,
      laborProfit: laborProfit,
      profitMargin: profitMargin,
      markup: markup,
      itemDetails: itemDetails
    };
  } catch (error) {
    Logger.log('Error calculating profit: ' + error.toString());
    return { success: false, error: error.toString() };
  }
}

