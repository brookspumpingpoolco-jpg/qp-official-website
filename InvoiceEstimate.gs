/**
 * Normalize email for safe comparisons.
 */
function normalizeEmail_(email) {
  return String(email || '').trim().toLowerCase();
}

/**
 * Send internal/admin notification email while avoiding same-sender/same-recipient routing loops.
 * If destination is the company mailbox, force `noReply` and set `replyTo` to company email.
 */
function sendInternalNotificationEmail_(toEmail, subject, textBody, htmlBody) {
  var to = String(toEmail || '').trim();
  if (!to) return { success: false, error: 'Missing destination email' };

  var toNorm = normalizeEmail_(to);
  var companyNorm = normalizeEmail_(COMPANY_EMAIL);

  var mailOptions = {
    to: to,
    subject: String(subject || ''),
    body: String(textBody || ''),
    name: COMPANY_NAME
  };

  if (htmlBody) mailOptions.htmlBody = String(htmlBody);

  // Key fix: avoid direct "samr@... -> samr@..." style sender/recipient pattern.
  // Using noReply still delivers the message but not as a self-sent mailbox message.
  if (toNorm && companyNorm && toNorm === companyNorm) {
    mailOptions.noReply = true;
    mailOptions.replyTo = COMPANY_EMAIL;
  }

  MailApp.sendEmail(mailOptions);
  return { success: true };
}

/**
 * Load contract JSON from the Contracts sheet when ContractManagement.gs is not part of
 * this Apps Script project (same row layout as ContractManagement.getContract).
 */
function getContractFromSheetFallback_(contractId) {
  try {
    var spreadsheet = SpreadsheetApp.openById(SPREADSHEET_ID);
    var contractsSheet = spreadsheet.getSheetByName(CONTRACTS_SHEET);
    if (!contractsSheet) {
      return { success: false, error: 'Contracts sheet not found' };
    }
    var data = contractsSheet.getDataRange().getValues();
    var id = String(contractId || '').trim();
    for (var i = 1; i < data.length; i++) {
      if (String(data[i][0] || '').trim() === id) {
        var jsonPart1 = data[i][3] || '';
        var jsonPart2 = data[i][4] || '';
        var jsonPart3 = data[i][5] || '';
        var jsonStr = jsonPart1 + jsonPart2 + jsonPart3;
        if (jsonStr) {
          var contract = JSON.parse(jsonStr);
          contract.status = data[i][6] || 'Draft';
          contract.dateCreated = data[i][7] ? new Date(data[i][7]).toISOString() : null;
          contract.dateSent = data[i][8] ? new Date(data[i][8]).toISOString() : null;
          contract.dateSigned = data[i][9] ? new Date(data[i][9]).toISOString() : null;
          contract.pdfUrl = data[i][10] || '';
          contract.signedPdfUrl = data[i][11] || '';
          contract.companySignature = data[i][12] || contract.companySignature || '';
          contract.customerSignature = data[i][13] || contract.customerSignature || '';
          return { success: true, data: contract };
        }
      }
    }
    return { success: false, error: 'Contract not found' };
  } catch (error) {
    Logger.log('getContractFromSheetFallback_: ' + error.toString());
    return { success: false, error: error.toString() };
  }
}

