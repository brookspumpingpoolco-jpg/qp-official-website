 */
function markQuoteAccepted(quoteId) {
  try {
    const spreadsheet = SpreadsheetApp.openById(SPREADSHEET_ID);
    const sheet = spreadsheet.getSheetByName(INVOICES_ESTIMATES_SHEET);
    
    if (!sheet) {
      return { success: false, error: 'Invoices & Estimates sheet not found' };
    }
    
    const dataRows = sheet.getDataRange().getValues();
    // ENFORCE 6 COLUMNS FIRST - delete any extra columns
    enforce8ColumnStructure(sheet);
    
    const headers = dataRows[0];
    const idCol = headers.indexOf('ID');
    const typeCol = headers.indexOf('Type');
    
    // Update status in JSON data (columns 3-5), NOT in separate column
    for (let i = 1; i < dataRows.length; i++) {
      const row = dataRows[i];
      if (row[idCol] === quoteId && row[typeCol] === 'Estimate') {
        try {
          const jsonPart1 = sheet.getRange(i + 1, 3).getValue() || '';
          const jsonPart2 = sheet.getRange(i + 1, 4).getValue() || '';
          const jsonPart3 = sheet.getRange(i + 1, 5).getValue() || '';
          let jsonStr = concatenateJsonChunks(jsonPart1, jsonPart2, jsonPart3);
          if (jsonStr && jsonStr.startsWith('{')) {
            const jsonData = JSON.parse(jsonStr);
            jsonData.quoteStatus = 'Accepted';
            const updatedJsonStr = JSON.stringify(jsonData);
            const updatedChunks = splitJsonString(updatedJsonStr);
            sheet.getRange(i + 1, 3, 1, 3).setValues([[updatedChunks[0] || '', updatedChunks[1] || '', updatedChunks[2] || '']]);
          }
        } catch (e) {
          Logger.log('Error updating quote status in JSON: ' + e.toString());
        }
        
        // ENFORCE 6 COLUMNS after update
        enforce8ColumnStructure(sheet);
        return { success: true, message: 'Quote marked as accepted' };
      }
    }
    
    return { success: false, error: 'Quote not found' };
  } catch (error) {
    Logger.log('Error marking quote as accepted: ' + error.toString());
    return { success: false, error: error.toString() };
  }
}

/**
 * Convert accepted quote to invoice with payment schedule requirement
 */
function convertAcceptedQuoteToInvoice(quoteId, paymentSchedule) {
  try {
    // First verify quote is accepted
    const quoteResult = getInvoiceEstimate(quoteId);
    if (!quoteResult.success) {
      return quoteResult;
    }
    
    const quote = quoteResult.data;
    
    // Check quote status
    const spreadsheet = SpreadsheetApp.openById(SPREADSHEET_ID);
    const sheet = spreadsheet.getSheetByName(INVOICES_ESTIMATES_SHEET);
    // ENFORCE 6 COLUMNS FIRST
    enforce8ColumnStructure(sheet);
    
    const lastRow = sheet.getLastRow();
    let quoteStatus = '';
    
    // Read from JSON (columns 3-5), NOT from separate column
    for (let i = 2; i <= lastRow; i++) {
      const rowId = String(sheet.getRange(i, 1).getValue() || '').trim();
      if (rowId === String(quoteId).trim()) {
        try {
          const jsonPart1 = sheet.getRange(i, 3).getValue() || '';
          const jsonPart2 = sheet.getRange(i, 4).getValue() || '';
          const jsonPart3 = sheet.getRange(i, 5).getValue() || '';
          let jsonStr = concatenateJsonChunks(jsonPart1, jsonPart2, jsonPart3);
          if (jsonStr && jsonStr.startsWith('{')) {
            const jsonData = JSON.parse(jsonStr);
            quoteStatus = jsonData.quoteStatus || jsonData.status || '';
          }
        } catch (e) {
          Logger.log('Error reading quote status from JSON: ' + e.toString());
        }
        break;
      }
    }
    
    if (quoteStatus !== 'Accepted' && quote.type === 'Estimate') {
      return { success: false, error: 'Quote must be accepted before conversion to invoice' };
    }
    
    // Payment schedule is required
    if (!paymentSchedule || !paymentSchedule.milestones || paymentSchedule.milestones.length === 0) {
      return { success: false, error: 'Payment schedule is required to convert quote to invoice' };
    }
    
    // Validate payment schedule
    const totalAmount = quote.total || 0;
    const validation = validatePaymentSchedule(paymentSchedule.milestones, totalAmount);
    if (!validation.valid) {
      return { success: false, error: validation.error };
    }
    
    // Create invoice from quote
    const invoiceData = {
      type: 'Invoice',
      customerName: quote.customerName,
      customerEmail: quote.customerEmail,
      customerPhone: quote.customerPhone,
      customerAddress: quote.customerAddress,
      items: quote.items,
      notes: quote.notes,
      terms: quote.terms,
      taxRate: quote.taxRate,
      discount: quote.discount,
      status: 'Draft',
      invoiceNumber: generateNextNumber('Invoice'),
      jobSiteAddress: quote.jobSiteAddress || quote.customerAddress,
      gcName: quote.gcName || '',
      gcEmail: quote.gcEmail || ''
    };
    
    const saveResult = saveInvoiceEstimate(invoiceData);
    if (!saveResult.success) {
      return saveResult;
    }
    
    const invoiceId = saveResult.id;
    
    // Create payment schedule
    const scheduleResult = createPaymentSchedule(invoiceId, paymentSchedule.milestones, totalAmount);
    if (!scheduleResult.success) {
      return scheduleResult;
    }
    
    // Link payment schedule to invoice
    linkPaymentScheduleToInvoice(invoiceId, scheduleResult.paymentScheduleId);
    
    // Finalize payment schedule
    finalizePaymentSchedule(scheduleResult.paymentScheduleId);
    
    // Finalize invoice (this also creates the project automatically)
    const finalizeResult = finalizeInvoice(invoiceId);
    
    // Update quote status
    updateInvoiceStatus(quoteId, 'Converted to Invoice');
    
    return {
      success: true,
      invoiceId: invoiceId,
      paymentScheduleId: scheduleResult.paymentScheduleId,
      projectId: finalizeResult.projectId || null,
      message: 'Quote converted to invoice, project created, and payment schedule finalized'
    };
  } catch (error) {
    Logger.log('Error converting accepted quote to invoice: ' + error.toString());
    return { success: false, error: error.toString() };
  }
}

/**
 * Helper function to find column index by name
 */
function findColumnIndexByName(sheet, columnName) {
  try {
    const headers = sheet.getRange(1, 1, 1, sheet.getLastColumn()).getValues()[0];
    return headers.indexOf(columnName);
  } catch (error) {
    return -1;
  }
}

/**
 * Create change order for invoice/project
 */
function createChangeOrder(invoiceId, changeOrderData) {
  try {
    // Get invoice
    const invoiceResult = getInvoiceEstimate(invoiceId);
    if (!invoiceResult.success) {
      return invoiceResult;
    }
    
    const invoice = invoiceResult.data;
    
    // Create change order entry
    const spreadsheet = SpreadsheetApp.openById(SPREADSHEET_ID);
    let changeOrdersSheet = spreadsheet.getSheetByName('Change Orders');
    
    if (!changeOrdersSheet) {
      changeOrdersSheet = spreadsheet.insertSheet('Change Orders');
      const headers = [
        'Change Order ID', 'Invoice ID', 'Project ID', 'Description', 'Items JSON',
        'Amount', 'Status', 'Customer Approved', 'Approved Date', 'Created Date'
      ];
      changeOrdersSheet.getRange(1, 1, 1, headers.length).setValues([headers]);
      changeOrdersSheet.getRange(1, 1, 1, headers.length).setFontWeight('bold');
      changeOrdersSheet.getRange(1, 1, 1, headers.length).setBackground('#0369a1');
      changeOrdersSheet.getRange(1, 1, 1, headers.length).setFontColor('#ffffff');
    }
    
    // Generate Change Order ID
    const year = new Date().getFullYear();
    const yearPrefix = 'CO-' + year + '-';
    const dataRows = changeOrdersSheet.getDataRange().getValues();
    let maxNumber = 0;
    
    for (let i = 1; i < dataRows.length; i++) {
      const id = dataRows[i][0];
      if (id && typeof id === 'string' && id.startsWith(yearPrefix)) {
        const numPart = id.replace(yearPrefix, '');
        const num = parseInt(numPart);
        if (!isNaN(num) && num > maxNumber) {
          maxNumber = num;
        }
      }
    }
    
    const changeOrderId = yearPrefix + String(maxNumber + 1).padStart(3, '0');
    
    // Get project ID if exists
    const projectIdCol = findColumnIndexByName(spreadsheet.getSheetByName(PROJECTS_SHEET_NAME), 'Project ID');
    let projectId = '';
    if (projectIdCol !== -1) {
      const projectsSheet = spreadsheet.getSheetByName(PROJECTS_SHEET_NAME);
      const projectRows = projectsSheet.getDataRange().getValues();
      const invoiceIdCol = projectRows[0].indexOf('Invoice ID');
      if (invoiceIdCol !== -1) {
        for (let i = 1; i < projectRows.length; i++) {
          if (projectRows[i][invoiceIdCol] === invoiceId) {
            projectId = projectRows[i][0]; // Project ID is first column
            break;
          }
        }
      }
    }
    
    const items = changeOrderData.items || [];
    const amount = items.reduce((sum, item) => sum + (parseFloat(item.quantity || 0) * parseFloat(item.price || 0)), 0);
    
    const now = new Date();
    const rowData = [
      changeOrderId,
      invoiceId,
      projectId,
      changeOrderData.description || 'Change Order',
      JSON.stringify(items),
      amount,
      'Pending Approval',
      false,
      '',
      now
    ];
    
    changeOrdersSheet.appendRow(rowData);
    
    // Send notification to customer
    try {
      const emailSubject = `Change Order Request: ${changeOrderData.description || 'Project Update'}`;
      const emailBody = `
        <div style="font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto; padding: 20px;">
          <h2 style="color: #0369a1;">Change Order Request</h2>
          <p>Dear ${invoice.customerName || 'Customer'},</p>
          <p>We have requested a change order for your project:</p>
          <div style="background: #f9fafb; padding: 16px; border-radius: 8px; margin: 20px 0;">
            <p><strong>Description:</strong> ${changeOrderData.description || 'N/A'}</p>
            <p><strong>Amount:</strong> $${amount.toFixed(2)}</p>
            <p><strong>Change Order ID:</strong> ${changeOrderId}</p>
          </div>
          <p>Please review and approve this change order to proceed.</p>
          <p>Best regards,<br>${COMPANY_NAME}</p>
        </div>
      `;
      
      MailApp.sendEmail({
        to: invoice.customerEmail,
        subject: emailSubject,
        htmlBody: emailBody
      });
    } catch (e) {
      Logger.log('Error sending change order notification: ' + e.toString());
    }
    
    return {
      success: true,
      changeOrderId: changeOrderId,
      amount: amount,
      message: 'Change order created successfully'
    };
  } catch (error) {
    Logger.log('Error creating change order: ' + error.toString());
    return { success: false, error: error.toString() };
  }
}

