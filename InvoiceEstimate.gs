/**
 * Request customer signature via Customer Portal
 */
function requestCustomerSignature(invoiceId, customerEmail) {
  try {
    // Get invoice data
    const invoice = getInvoiceEstimate(invoiceId);
    if (!invoice.success) {
      return invoice;
    }
    
    // Generate signature token
    const signatureToken = Utilities.getUuid();
    
    // Update invoice with signature token
    const spreadsheet = SpreadsheetApp.openById(SPREADSHEET_ID);
    const sheet = spreadsheet.getSheetByName(INVOICES_ESTIMATES_SHEET);
    const dataRows = sheet.getDataRange().getValues();
    const headers = dataRows[0];
    
    // Add signature token column if it doesn't exist
    let tokenCol = headers.indexOf('Signature Token');
    if (tokenCol === -1) {
      const lastCol = sheet.getLastColumn();
      sheet.getRange(1, lastCol + 1).setValue('Signature Token');
      tokenCol = lastCol;
    }
    
    // Update row with signature token
    const idCol = headers.indexOf('ID');
    for (let i = 1; i < dataRows.length; i++) {
      if (dataRows[i][idCol] === invoiceId) {
        sheet.getRange(i + 1, tokenCol + 1).setValue(signatureToken);
        break;
      }
    }
    
    // Send signature request email
    const signatureUrl = `https://script.google.com/macros/s/AKfycbzXn2xrGyuuIQFGjk_vn5O80_kAEg28tMHZJtdpAoagtnqLx3vQ0t-kuEJa2YEXcTP5WA/exec?action=ui#sign&id=${invoiceId}&token=${signatureToken}`;
    
    const subject = `Signature Required: ${invoice.data.type} ${invoice.data.quoteNumber || invoice.data.invoiceNumber || invoiceId}`;
    const body = `
Hi ${invoice.data.customerName},

Please review and sign your ${invoice.data.type.toLowerCase()}:

${signatureUrl}

Thank you,
A Quality Pool Company
    `;
    
    GmailApp.sendEmail(customerEmail, subject, body);
    
    return {
      success: true,
      message: 'Signature request sent to customer',
      signatureUrl: signatureUrl
    };
  } catch (error) {
    return { success: false, error: error.toString() };
  }
}

/**
 * Get signature URL for an invoice
 */
function getSignatureUrl(invoiceId) {
  try {
    const spreadsheet = SpreadsheetApp.openById(SPREADSHEET_ID);
    const sheet = spreadsheet.getSheetByName(INVOICES_ESTIMATES_SHEET);
    const dataRows = sheet.getDataRange().getValues();
    const headers = dataRows[0];
    
    const idCol = headers.indexOf('ID');
    const signatureUrlCol = headers.indexOf('Signature URL');
    
    for (let i = 1; i < dataRows.length; i++) {
      if (dataRows[i][idCol] === invoiceId) {
        return {
          success: true,
          signatureUrl: dataRows[i][signatureUrlCol] || ''
        };
      }
    }
    
    return { success: false, error: 'Invoice not found' };
  } catch (error) {
    return { success: false, error: error.toString() };
  }
}

/**
 * Generate contract PDF with signature
 */
function generateContractPDF(invoiceData, signatureDataUrl, customerName) {
  try {
    // Generate contract HTML with signature
    const contractHTML = generateContractHTML(invoiceData, signatureDataUrl, customerName);
    
    // Convert to PDF
    const blob = Utilities.newBlob(contractHTML, 'text/html', 'contract.html');
    const pdf = blob.getAs('application/pdf').setName('Signed Contract - ' + (invoiceData.quoteNumber || invoiceData.id) + '.pdf');
    
    // Save to customer folder
    const customerFolder = getOrCreateCustomerFolder(customerName, invoiceData.customerAddress);
    let pdfFile;
    if (customerFolder) {
      pdfFile = customerFolder.createFile(pdf);
    } else {
      pdfFile = DriveApp.createFile(pdf);
    }
    
    pdfFile.setSharing(DriveApp.Access.ANYONE_WITH_LINK, DriveApp.Permission.VIEW);
    
    return pdfFile.getUrl();
  } catch (error) {
    Logger.log('Error generating contract PDF: ' + error.toString());
    return '';
  }
}

