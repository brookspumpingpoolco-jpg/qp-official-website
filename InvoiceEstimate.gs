/**
 * Upload a scanned/paper contract to the customer's Drive folder and mark the project.
 * Parent folder: https://drive.google.com/drive/folders/1caFBUhSzE5WNAm9vCT4dwDQuAO0iuo1h
 * Customer subfolder format: "Anthony Smitherman - 7504 Brittany Drive, Knoxville, TN, 37931"
 */
function uploadPaperContract(projectId, fileDataBase64, fileName, mimeType) {
  try {
    var CUSTOMERS_FOLDER_ID = '1caFBUhSzE5WNAm9vCT4dwDQuAO0iuo1h';

    // Get project JSON
    var projectResult = getProject(projectId);
    var customerName = '';
    var customerAddress = '';

    if (projectResult.success && projectResult.project) {
      customerName = projectResult.project.customerName || '';
      customerAddress = projectResult.project.customerAddress || '';
    } else {
      // Fall back to looking up the linked estimate
      var linkedId = null;
      if (projectResult.success && projectResult.project) {
        linkedId = projectResult.project.estimateId || projectResult.project.invoiceId;
      }
      if (linkedId) {
        var est = getInvoiceEstimate(linkedId);
        if (est.success && est.data) {
          customerName = est.data.customerName || '';
          customerAddress = est.data.customerAddress || '';
        }
      }
    }

    if (!customerName) return { success: false, error: 'Could not determine customer name for project ' + projectId };

    // Build the folder name in the required format
    var folderName = customerName.trim();
    if (customerAddress && customerAddress.trim()) {
      folderName += ' - ' + customerAddress.trim();
    }

    // Get or create customer subfolder inside the parent
    var parentFolder = DriveApp.getFolderById(CUSTOMERS_FOLDER_ID);
    var customerFolder;
    var folderIter = parentFolder.getFoldersByName(folderName);
    if (folderIter.hasNext()) {
      customerFolder = folderIter.next();
    } else {
      customerFolder = parentFolder.createFolder(folderName);
      Logger.log('📁 Created customer folder: ' + folderName);
    }

    // Decode and upload the file
    var safeFileName = fileName || ('Paper_Contract_' + new Date().toISOString().substring(0, 10) + '.pdf');
    var blob = Utilities.newBlob(Utilities.base64Decode(fileDataBase64), mimeType || 'application/pdf', safeFileName);
    var uploadedFile = customerFolder.createFile(blob);
    uploadedFile.setSharing(DriveApp.Access.ANYONE_WITH_LINK, DriveApp.Permission.VIEW);
    var fileUrl = uploadedFile.getUrl();
    Logger.log('✅ Uploaded paper contract: ' + fileUrl);

    // Update the PM_Projects record with the contract URL
    var spreadsheet = SpreadsheetApp.openById(SPREADSHEET_ID);
    var sheet = spreadsheet.getSheetByName(PM_PROJECTS_SHEET);
    if (sheet) {
      var data = sheet.getDataRange().getValues();
      var headers = data[0] || [];
      var hasCompanyId = (headers[0] && String(headers[0]).trim() === 'Company ID');
      var idCol    = hasCompanyId ? 1 : 0;
      var json1Col = hasCompanyId ? 3 : 2;
      var json2Col = hasCompanyId ? 4 : 3;
      var json3Col = hasCompanyId ? 5 : 4;

      for (var i = 1; i < data.length; i++) {
        if (String(data[i][idCol] || '').trim() !== String(projectId).trim()) continue;
        var jsonStr = (data[i][json1Col] || '') + (data[i][json2Col] || '') + (data[i][json3Col] || '');
        try {
          var projectData = JSON.parse(jsonStr);
          projectData.paperContractUrl      = fileUrl;
          projectData.paperContractSigned   = true;
          projectData.paperContractDate     = new Date().toISOString();
          projectData.paperContractFileName = safeFileName;
          projectData.contractFullyExecuted = true;

          var chunks = chunkJsonDataForProject(JSON.stringify(projectData), 50000);
          sheet.getRange(i + 1, json1Col + 1).setValue(chunks[0] || '');
          sheet.getRange(i + 1, json2Col + 1).setValue(chunks[1] || '');
          sheet.getRange(i + 1, json3Col + 1).setValue(chunks[2] || '');
          Logger.log('✅ Project ' + projectId + ' updated with paper contract URL');
        } catch (e) {
          Logger.log('⚠️ Could not update project JSON: ' + e.toString());
        }
        break;
      }
    }

    return {
      success: true,
      fileUrl: fileUrl,
      folderName: folderName,
      folderId: customerFolder.getId(),
      fileName: safeFileName
    };
  } catch (e) {
    Logger.log('uploadPaperContract error: ' + e.toString());
    return { success: false, error: e.toString() };
  }
}

