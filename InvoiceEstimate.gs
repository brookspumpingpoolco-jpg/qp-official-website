/**
 * Send enhanced invoice email with custom template
 * @param {Object} data - Invoice data
 * @param {Object} userSettings - User's company settings (logo, social links, etc.)
 * @param {String} customMessage - User's custom message (editable before send)
 * @param {Array} attachments - Array of attachment objects [{name, url, blob}]
 */
function sendEnhancedInvoiceEmail(data, userSettings, customMessage, attachments) {
  try {
    // Normalize document type
    const invoiceType = normalizeInvoiceEstimateType(data.type);
    
    // Helper function to escape HTML
    const escapeHtml = (text) => {
      if (!text) return '';
      return String(text).replace(/[&<>"']/g, (m) => {
        const map = {'&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;'};
        return map[m];
      });
    };
    
    // Load email template
    const templateHtml = HtmlService.createHtmlOutputFromFile('InvoiceEmailTemplate_Enhanced').getContent();
    
    // Extract first name from customer name
    let firstName = 'Valued Customer';
    if (data.customerName && typeof data.customerName === 'string') {
      const name = data.customerName.trim();
      if (name.indexOf(' ') > 0) {
        firstName = name.substring(0, name.indexOf(' '));
      } else {
        firstName = name;
      }
    }
    
    // Clean up custom message to remove duplicate greetings
    // Remove common greeting patterns like "Dear [Name]," or "Hello [Name]," since template already has greeting
    if (customMessage && typeof customMessage === 'string') {
      let cleanedMessage = customMessage.trim();
      
      // Remove "Dear [FirstName]," or "Dear [FullName]," from anywhere in the text
      cleanedMessage = cleanedMessage.replace(/Dear\s+[^,]+,\s*/gi, '');
      
      // Remove "Hello [FirstName]," or "Hello [FullName]," from anywhere in the text
      cleanedMessage = cleanedMessage.replace(/Hello\s+[^,]+,\s*/gi, '');
      
      // Remove "Hi [FirstName]," or "Hi [FullName]," from anywhere in the text
      cleanedMessage = cleanedMessage.replace(/Hi\s+[^,]+,\s*/gi, '');
      
      // Remove any standalone greeting with the first name (e.g., "Samuel,")
      if (firstName && firstName !== 'Valued Customer') {
        const firstNameRegex = new RegExp(`\\b${firstName}\\s*,\\s*`, 'gi');
        cleanedMessage = cleanedMessage.replace(firstNameRegex, '');
      }
      
      // Remove duplicate "Best regards" or closing phrases if they appear multiple times
      cleanedMessage = cleanedMessage.replace(/(Best regards[^.]*\.\s*){2,}/gi, 'Best regards, A Quality Pool Company Team');
      
      // Clean up any double spaces, triple spaces, or leading/trailing whitespace
      cleanedMessage = cleanedMessage.replace(/\s{2,}/g, ' ').trim();
      
      customMessage = cleanedMessage;
    }
    
    var isEstimateDoc = normalizeInvoiceEstimateType(data.type) === 'Estimate';
    var defaultEmailBodyFallback = isEstimateDoc
      ? ('Thank you for choosing ' + (userSettings.companyName || 'A Quality Pool Company') + '. Please review your estimate details below.')
      : ('Thank you for choosing ' + (userSettings.companyName || 'A Quality Pool Company') + '. Please find your invoice details below.');
    
    var primaryCtaButtonText = isEstimateDoc ? 'View and approve estimate' : 'View and pay invoice';
    
    // Calculate totals
    const items = JSON.parse(data.items || '[]');
    // Filter out processing fee from items (it's added separately)
    const itemsWithoutFee = items.filter(item => !item.isProcessingFee);
    const subtotal = itemsWithoutFee.reduce((sum, item) => sum + (parseFloat(item.quantity || 0) * parseFloat(item.price || 0)), 0);
    const taxRate = parseFloat(data.taxRate || 0);
    const taxAmount = subtotal * (taxRate / 100);
    const discount = parseFloat(data.discount || 0);
    
    // Calculate processing fee if enabled (2.9% + $0.29)
