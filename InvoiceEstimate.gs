    +       '<div style="display:flex;justify-content:space-between;padding:4px 0;"><span>Total Paid</span><strong style="color:#166534;">$' + money2_(breakdown.totalPaid).toFixed(2) + '</strong></div>'
    +       '<div style="display:flex;justify-content:space-between;padding:4px 0;"><span>Balance Due</span><strong style="color:#92400e;">$' + money2_(breakdown.totalOwed).toFixed(2) + '</strong></div>'
