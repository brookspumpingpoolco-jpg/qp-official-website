/**
 * Release quote to customer from Invoice tool
 * This function is called when releasing a quote from the invoice/estimate maker
 * Generates shareable link and sends email notification
 */
function releaseQuoteToCustomerFromInvoice(customerEmail, quoteId, invoiceEstimateId) {
  try {
    // Get the invoice/estimate data
    const invoiceData = getInvoiceEstimate(invoiceEstimateId);
    if (!invoiceData.success) {
      return invoiceData;
    }
    
    const data = invoiceData.data;
    
    const shareLink = getCustomerViewerWebflowUrl(data.type, invoiceEstimateId, data.approvalToken);
    
    // Update status to Released and share link
    const spreadsheet = SpreadsheetApp.openById(SPREADSHEET_ID);
    const sheet = spreadsheet.getSheetByName(INVOICES_ESTIMATES_SHEET);
    if (sheet) {
      const dataRows = sheet.getDataRange().getValues();
      for (let i = 1; i < dataRows.length; i++) {
        if (dataRows[i][0] === invoiceEstimateId) {
          sheet.getRange(i + 1, 3).setValue('Released'); // Status column
          const shareLinkCol = findColumnIndex(sheet, 'Share Link') + 1;
          if (shareLinkCol > 0) {
            sheet.getRange(i + 1, shareLinkCol).setValue(shareLink);
          }
          break;
        }
      }
    }
    
    // Call Customer Portal to release quote and send email
    const customerPortalUrl = 'https://script.google.com/macros/s/AKfycbzXn2xrGyuuIQFGjk_vn5O80_kAEg28tMHZJtdpAoagtnqLx3vQ0t-kuEJa2YEXcTP5WA/exec';
    const response = UrlFetchApp.fetch(customerPortalUrl, {
      method: 'POST',
      payload: {
        action: 'releaseQuoteToCustomer',
        email: customerEmail,
        quoteId: quoteId,
        invoiceEstimateId: invoiceEstimateId,
        shareLink: shareLink
      },
      muteHttpExceptions: true
    });
    
    const result = JSON.parse(response.getContentText());
    
    return {
      success: true,
      message: 'Quote released successfully',
      shareLink: shareLink,
      emailSent: result.emailSent || false
    };
    
  } catch (error) {
    Logger.log('Error releasing quote: ' + error.toString());
    return { success: false, error: error.toString() };
  }
}

/**
 * Update project item with tracking number and status
 * Called from dashboard to manage project items
 */
function updateProjectItem(projectId, itemName, updateData) {
  try {
    const spreadsheet = SpreadsheetApp.openById(SPREADSHEET_ID);
    const itemsSheet = spreadsheet.getSheetByName(PROJECT_ITEMS_SHEET_NAME);
    
    if (!itemsSheet) {
      return { success: false, error: 'Project Items sheet not found' };
    }
    
    const data = itemsSheet.getDataRange().getValues();
    if (data.length <= 1) {
      return { success: false, error: 'No project items found' };
    }
    
    const headers = data[0];
    const projectIdCol = headers.indexOf('Project ID');
    const itemNameCol = headers.indexOf('Item Name');
    const trackingCol = headers.indexOf('Tracking Number');
    const statusCol = headers.indexOf('Status');
    const vendorCol = headers.indexOf('Vendor/Supplier');
    const orderDateCol = headers.indexOf('Order Date');
    const deliveryDateCol = headers.indexOf('Delivery Date');
    const notesCol = headers.indexOf('Notes');
    
    let updated = false;
    for (let i = 1; i < data.length; i++) {
      if (data[i][projectIdCol] === projectId && data[i][itemNameCol] === itemName) {
        if (updateData.trackingNumber !== undefined && trackingCol !== -1) {
          itemsSheet.getRange(i + 1, trackingCol + 1).setValue(updateData.trackingNumber);
        }
        if (updateData.status !== undefined && statusCol !== -1) {
          itemsSheet.getRange(i + 1, statusCol + 1).setValue(updateData.status);
        }
        if (updateData.vendor !== undefined && vendorCol !== -1) {
          itemsSheet.getRange(i + 1, vendorCol + 1).setValue(updateData.vendor);
        }
        if (updateData.orderDate !== undefined && orderDateCol !== -1) {
          itemsSheet.getRange(i + 1, orderDateCol + 1).setValue(updateData.orderDate);
        }
        if (updateData.deliveryDate !== undefined && deliveryDateCol !== -1) {
          itemsSheet.getRange(i + 1, deliveryDateCol + 1).setValue(updateData.deliveryDate);
        }
        if (updateData.notes !== undefined && notesCol !== -1) {
          itemsSheet.getRange(i + 1, notesCol + 1).setValue(updateData.notes);
        }
        updated = true;
        break;
      }
    }
    
    if (!updated) {
      return { success: false, error: 'Project item not found' };
    }
    
    // Update project last updated date
    const projectsSheet = spreadsheet.getSheetByName(PROJECTS_SHEET_NAME);
    if (projectsSheet) {
      const projectData = projectsSheet.getDataRange().getValues();
      const projectHeaders = projectData[0];
      const projIdCol = projectHeaders.indexOf('Project ID');
      const lastUpdatedCol = projectHeaders.indexOf('Last Updated');
      
      for (let i = 1; i < projectData.length; i++) {
        if (projectData[i][projIdCol] === projectId && lastUpdatedCol !== -1) {
          projectsSheet.getRange(i + 1, lastUpdatedCol + 1).setValue(new Date());
          break;
        }
      }
    }
    
    return { success: true, message: 'Project item updated successfully' };
    
  } catch (error) {
    Logger.log('Error updating project item: ' + error.toString());
    return { success: false, error: error.toString() };
  }
