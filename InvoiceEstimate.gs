/**
 * FULL DIAGNOSTIC: verify Telegram setup + send path used by Brooks notifications.
 *
 * Run from Apps Script editor: testBrooksNotificationFullPipeline()
 * Returns a detailed object so you can see exactly where it fails.
 */
function testBrooksNotificationFullPipeline() {
  var report = {
    success: false,
    timestamp: new Date().toISOString(),
    checks: {}
  };

  try {
    // 1) Token + chat id resolution
    var token = getTelegramBotToken_();
    var chatId = getBrooksTelegramChatId_();
    report.checks.tokenResolved = !!token;
    report.checks.chatIdResolved = !!chatId;
    report.checks.chatIdValue = chatId || '';
    report.checks.tokenPreview = token ? (String(token).substring(0, 10) + '...') : '';

    if (!token) {
      report.error = 'BROOKS_TELEGRAM_BOT_TOKEN is empty';
      return report;
    }
    if (!chatId) {
      report.error = 'BROOKS_TELEGRAM_CHAT_ID is empty/invalid (or equals bot user id)';
      return report;
    }

    // 2) Verify bot account (getMe)
    var meResp = UrlFetchApp.fetch('https://api.telegram.org/bot' + token + '/getMe', { muteHttpExceptions: true });
    var meStatus = meResp.getResponseCode();
    var meBody = meResp.getContentText() || '';
    report.checks.getMe = { status: meStatus, bodyPreview: meBody.substring(0, 300) };
    if (meStatus < 200 || meStatus >= 300) {
      report.error = 'getMe failed HTTP ' + meStatus;
      return report;
    }

    // 3) Verify chat is valid/reachable (getChat)
    var getChatUrl = 'https://api.telegram.org/bot' + token + '/getChat?chat_id=' + encodeURIComponent(chatId);
    var chatResp = UrlFetchApp.fetch(getChatUrl, { muteHttpExceptions: true });
    var chatStatus = chatResp.getResponseCode();
    var chatBody = chatResp.getContentText() || '';
    report.checks.getChat = { status: chatStatus, bodyPreview: chatBody.substring(0, 400) };

    // 4) Direct send using shared helper (same function production uses)
    var helperSend = sendTelegramBotMessage_(
      '<b>🧪 Telegram helper test</b>\n\nThis is a direct helper test for Brooks notifications.',
      [{ text: '🔗 Open Viewer', url: NETLIFY_ESTIMATE_VIEWER_URL + '?id=EST-TEST-001&token=TEST' }]
    );
    report.checks.helperSend = helperSend;

    // 5) End-to-end send via production notification function
    var sampleLink = NETLIFY_ESTIMATE_VIEWER_URL + '?id=EST-TEST-PIPELINE&token=TEST-PIPELINE';
    var pipelineResult = sendBrooksLinkNotification(
      sampleLink,
      'EST-TEST-PIPELINE',
      'Estimate',
      'Test Customer',
      '5551234567',
      'TEST-PIPELINE',
      'Hi Test, your estimate is ready: ' + sampleLink
    );
    report.checks.pipelineSend = pipelineResult;

    // Final status
    report.success = !!(pipelineResult && pipelineResult.telegramSent);
    if (!report.success) {
      report.error = (pipelineResult && pipelineResult.error) || 'Pipeline send failed';
      report.hint = 'If getMe works but getChat/send fails, Brooks must message the bot first and chat_id must be his personal user id.';
    }

    Logger.log('testBrooksNotificationFullPipeline report: ' + JSON.stringify(report));
    return report;
  } catch (e) {
    report.error = e.toString();
    report.stack = e.stack || '';
    Logger.log('testBrooksNotificationFullPipeline error: ' + report.error);
    return report;
  }
}

/**
 * TEST SCRIPT - Cross reference a PM project row to Invoices & Estimates.
 *
 * What it checks:
 * 1. Finds the project in PM_Projects by Project ID (column A)
 * 2. Reads Invoice ID from PM_Projects column B
 * 3. Parses the PM_Projects JSON (columns D-F) for linked estimate/invoice IDs
 * 4. Cross-references all discovered IDs against Invoices & Estimates column B
 * 5. Also lists milestone invoice rows in PM_Project_Invoices for the same project
 *
 * Run from Apps Script editor:
 *   testCrossReferenceProjectToInvoiceEstimate()
 * or:
 *   testCrossReferenceProjectToInvoiceEstimate('PROJ-1777015267534')
 */
function testCrossReferenceProjectToInvoiceEstimate(projectId) {
  var targetProjectId = String(projectId || 'PROJ-1777015267534').trim();
  var report = {
    projectId: targetProjectId,
    success: false,
    pmProjects: {},
    linkedIds: [],
    invoiceEstimateMatches: [],
    milestoneInvoiceMatches: []
  };

  try {
    Logger.log('=== TEST CROSS REFERENCE PROJECT TO INVOICE/ESTIMATE ===');
    Logger.log('Target Project ID: ' + targetProjectId);

    var spreadsheet = SpreadsheetApp.openById(SPREADSHEET_ID);
    var pmProjectsSheetName = (typeof PM_PROJECTS_SHEET !== 'undefined' && PM_PROJECTS_SHEET)
      ? PM_PROJECTS_SHEET
      : 'PM_Projects';
    var pmProjectsSheet = spreadsheet.getSheetByName(pmProjectsSheetName);
    var invoicesSheet = spreadsheet.getSheetByName(INVOICES_ESTIMATES_SHEET);
    var pmProjectInvoicesSheetName = (typeof PM_PROJECT_INVOICES_SHEET !== 'undefined' && PM_PROJECT_INVOICES_SHEET)
      ? PM_PROJECT_INVOICES_SHEET
      : 'PM_Project_Invoices';
    var pmProjectInvoicesSheet = spreadsheet.getSheetByName(pmProjectInvoicesSheetName);

    if (!pmProjectsSheet) {
      report.error = 'PM_Projects sheet not found';
      Logger.log('❌ ' + report.error);
      return report;
    }
    if (!invoicesSheet) {
      report.error = 'Invoices & Estimates sheet not found';
      Logger.log('❌ ' + report.error);
      return report;
    }

    var pmRows = pmProjectsSheet.getDataRange().getValues() || [];
    var foundProjectRow = -1;
    for (var i = 1; i < pmRows.length; i++) {
      if (String(pmRows[i][0] || '').trim() === targetProjectId) {
        foundProjectRow = i + 1;
        break;
      }
    }

    if (foundProjectRow === -1) {
      report.error = 'Project not found in PM_Projects';
      Logger.log('❌ ' + report.error);
      return report;
    }

    var pmRow = pmRows[foundProjectRow - 1];
    var directInvoiceId = String(pmRow[1] || '').trim(); // PM_Projects col B
    var customerEmail = String(pmRow[2] || '').trim();   // PM_Projects col C
    var projectJson = concatenateJsonChunks(pmRow[3] || '', pmRow[4] || '', pmRow[5] || ''); // D-F
    if (!projectJson || !String(projectJson).trim()) {
      projectJson = String(pmRow[3] || '').trim();
    }

    var parsedProject = {};
    if (projectJson && String(projectJson).trim().charAt(0) === '{') {
      try {
        parsedProject = JSON.parse(projectJson);
      } catch (jsonErr) {
        report.pmProjects.jsonParseError = jsonErr.toString();
      }
    }

    report.pmProjects = {
      row: foundProjectRow,
      projectId: String(pmRow[0] || '').trim(),
      invoiceIdColumnB: directInvoiceId,
      customerEmailColumnC: customerEmail,
      statusColumnG: String(pmRow[6] || '').trim(),
      totalValueColumnH: pmRow[7],
      parsedJsonSummary: {
        invoiceId: parsedProject.invoiceId || '',
        estimateId: parsedProject.estimateId || '',
        linkedEstimateId: parsedProject.linkedEstimateId || '',
        linkedInvoiceId: parsedProject.linkedInvoiceId || '',
        sourceInvoiceId: parsedProject.sourceInvoiceId || ''
      }
    };

    var linkedIds = [
      directInvoiceId,
      parsedProject.invoiceId,
      parsedProject.estimateId,
      parsedProject.linkedEstimateId,
      parsedProject.linkedInvoiceId,
      parsedProject.originalEstimateId,
      parsedProject.sourceInvoiceId
    ]
      .map(function(v) { return String(v || '').trim(); })
      .filter(function(v) { return !!v; })
      .filter(function(v, idx, arr) { return arr.indexOf(v) === idx; });

    report.linkedIds = linkedIds;
    Logger.log('🔗 Linked IDs discovered: ' + JSON.stringify(linkedIds));

    var invoiceRows = invoicesSheet.getDataRange().getValues() || [];
    for (var r = 1; r < invoiceRows.length; r++) {
      var rowId = String(invoiceRows[r][1] || '').trim(); // Invoices & Estimates col B
      if (linkedIds.indexOf(rowId) === -1) continue;

      var jsonPart1 = invoiceRows[r][3] || '';
      var jsonPart2 = invoiceRows[r][4] || '';
      var jsonPart3 = invoiceRows[r][5] || '';
      var jsonStr = concatenateJsonChunks(jsonPart1, jsonPart2, jsonPart3);
      if (!jsonStr || !String(jsonStr).trim()) jsonStr = String(jsonPart1 || '').trim();

      var doc = {};
      try {
        if (jsonStr && String(jsonStr).trim().charAt(0) === '{') {
          doc = JSON.parse(jsonStr);
        }
      } catch (docErr) {
        doc = { _parseError: docErr.toString() };
      }

      report.invoiceEstimateMatches.push({
        row: r + 1,
        idColumnB: rowId,
        type: doc.type || '',
        status: doc.status || '',
        paymentStatus: doc.paymentStatus || '',
        customerName: doc.customerName || '',
        customerEmail: doc.customerEmail || '',
        shareLink: doc.shareLink || '',
        projectIdInJson: doc.projectId || '',
        quoteNumber: doc.quoteNumber || '',
        invoiceNumber: doc.invoiceNumber || ''
      });
    }

    if (pmProjectInvoicesSheet) {
      var pmInvRows = pmProjectInvoicesSheet.getDataRange().getValues() || [];
      for (var m = 1; m < pmInvRows.length; m++) {
        if (String(pmInvRows[m][1] || '').trim() !== targetProjectId) continue;
        report.milestoneInvoiceMatches.push({
          row: m + 1,
          invoiceId: String(pmInvRows[m][0] || '').trim(),
          projectId: String(pmInvRows[m][1] || '').trim(),
          milestoneName: String(pmInvRows[m][2] || '').trim(),
          amount: pmInvRows[m][3],
          status: String(pmInvRows[m][4] || '').trim(),
          paymentUrl: String(pmInvRows[m][5] || '').trim()
        });
      }
    }

    report.success = true;
    report.summary = {
      projectFound: true,
      linkedIdsFound: linkedIds.length,
      invoicesEstimatesMatches: report.invoiceEstimateMatches.length,
      milestoneInvoiceMatches: report.milestoneInvoiceMatches.length
    };

    Logger.log('testCrossReferenceProjectToInvoiceEstimate report: ' + JSON.stringify(report));
    return report;
  } catch (e) {
    report.error = e.toString();
    report.stack = e.stack || '';
    Logger.log('testCrossReferenceProjectToInvoiceEstimate error: ' + report.error);
    return report;
  }
}

