        Logger.log('❌ action variable: "' + action + '"');
        Logger.log('❌ action type: ' + typeof action);
        Logger.log('❌ action length: ' + (action ? action.length : 'null'));
        Logger.log('❌ action char codes: ' + (action ? Array.from(action).map((c, i) => i + ':' + c.charCodeAt(0)).join(' | ') : 'N/A'));
        Logger.log('📊 All e.parameter keys: ' + (e.parameter ? Object.keys(e.parameter).join(', ') : 'NO e.parameter'));
        Logger.log('📊 e.parameter.action specifically: "' + (e.parameter ? e.parameter.action : 'N/A') + '"');
        
        // FALLBACK: Try common actions manually if switch didn't match
        // Use lowercased comparison for robust matching (same as ultra-defensive check)
        const fallbackActionLower = action ? String(action).toLowerCase().trim() : '';
        
        if (fallbackActionLower === 'saveinvoiceestimate') {
          Logger.log('✅ FALLBACK MATCH: saveInvoiceEstimate (using lowercased comparison)');
          try {
            const dataStr = e.parameter.data || '';
            if (!dataStr) {
              result = { success: false, error: 'No data parameter provided' };
            } else {
              const parsedData = JSON.parse(dataStr);
              result = saveInvoiceEstimate(parsedData);
            }
          } catch (parseErr) {
            Logger.log('Fallback saveInvoiceEstimate error: ' + parseErr.toString());
            result = { success: false, error: 'Error in saveInvoiceEstimate: ' + parseErr.toString() };
          }
        } else if (fallbackActionLower === 'sendinvoiceestimate') {
          Logger.log('✅ FALLBACK MATCH: sendInvoiceEstimate (using lowercased comparison)');
          try {
            const dataStr = e.parameter.data || '';
            if (!dataStr) {
              result = { success: false, error: 'No data parameter provided' };
            } else {
              const parsedData = JSON.parse(dataStr);
              result = sendInvoiceEstimate(parsedData);
            }
          } catch (parseErr) {
            Logger.log('Fallback sendInvoiceEstimate error: ' + parseErr.toString());
            result = { success: false, error: 'Error in sendInvoiceEstimate: ' + parseErr.toString() };
          }
        } else {
          result = { success: false, error: 'Invalid action: ' + action };
        }
      }
    } // Close the outer if/else for saveInvoiceEstimate check
    
    // Ensure result is always defined and is an object
    if (!result) {
      Logger.log('⚠️ Warning: result is null/undefined, setting default error response');
      result = { success: false, error: 'No result returned from action handler' };
    }
    
    // Ensure result is an object (not a string or other type)
    if (typeof result !== 'object') {
      Logger.log('⚠️ Warning: result is not an object, converting: ' + typeof result);
      result = { success: false, error: 'Invalid result format: ' + String(result) };
    }
    
    Logger.log('📤 Returning result for action "' + action + '": ' + JSON.stringify(result).substring(0, 200));
    return createCorsResponse(result);
      
  } catch (error) {
    Logger.log('doPost error: ' + error.toString());
    return createCorsResponse({
      success: false,
      error: error.toString()
    });
  }
}

