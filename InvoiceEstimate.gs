/**
 * Wrapper function for google.script.run to get contract template
 */
function getContractTemplate() {
  return { success: true, template: getContractTemplateText() };
}

/**
 * Get terms by ID from Terms Library
 */
function getTermsById(termsId) {
  try {
    const spreadsheet = SpreadsheetApp.openById(SPREADSHEET_ID);
    let sheet = spreadsheet.getSheetByName(TERMS_LIBRARY_SHEET);
    
    if (!sheet) {
      // Create the sheet if it doesn't exist
      sheet = spreadsheet.insertSheet(TERMS_LIBRARY_SHEET);
      const headers = ['ID', 'Name', 'Content', 'Category', 'Created Date'];
      sheet.getRange(1, 1, 1, headers.length).setValues([headers]);
      sheet.getRange(1, 1, 1, headers.length).setFontWeight('bold');
      return { success: false, error: 'Terms Library sheet was empty - created new sheet' };
    }
    
    const dataRows = sheet.getDataRange().getValues();
    
    // If sheet is empty or only has headers, return not found
    if (dataRows.length <= 1) {
      return { success: false, error: 'Terms Library is empty' };
    }
    
    // Search for terms by ID (column 0) or by name containing the ID
    for (let i = 1; i < dataRows.length; i++) {
      const id = dataRows[i][0];
      const name = dataRows[i][1];
      const content = dataRows[i][2];
      
      // Match by exact ID or if ID is a number, match by numeric ID
      if (id == termsId || id === termsId || id === String(termsId) || 
          (typeof termsId === 'number' && id == termsId) ||
          (termsId === 2 && (id == 2 || id === '2' || name && name.toLowerCase().includes('snow')))) {
        return { success: true, template: content || '' };
      }
    }
    
    return { success: false, error: 'Terms with ID ' + termsId + ' not found' };
  } catch (error) {
    Logger.log('Error in getTermsById: ' + error.toString());
    return { success: false, error: 'Error accessing Terms Library: ' + error.toString() };
  }
}

/**
