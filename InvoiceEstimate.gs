/**
 * Calculate Concrete Volume and Pricing
 */
function calculateConcrete(data) {
  try {
    const type = data.type || 'footer'; // 'footer' or 'collar'
    const isStamped = data.isStamped === true || data.isStamped === 'true';
    
    let length, width, depth, volumeCubicFeet, volumeCubicYards;
    
    if (type === 'footer') {
      // Footer calculation: 2ft over-dig around pool (more for stairs)
      const poolLength = parseFloat(data.poolLength) || 0;
      const poolWidth = parseFloat(data.poolWidth) || 0;
      const overDigWidth = parseFloat(data.overDigWidth) || 2; // Default 2 feet (2ft over-dig on each side)
      const stairsWidth = parseFloat(data.stairsWidth) || 0; // Additional width for stairs area
      depth = parseFloat(data.depth) || 4; // Default 4 inches
      
      if (poolLength <= 0 || poolWidth <= 0 || depth <= 0) {
        return { success: false, error: 'Pool length, width, and depth must be greater than 0' };
      }
      
      // Convert depth from inches to feet
      const depthFeet = depth / 12;
      
      // Calculate pool perimeter
      const poolPerimeter = 2 * (poolLength + poolWidth);
      
      // Calculate footer area: perimeter × over-dig width (2ft on each side)
      const footerArea = poolPerimeter * overDigWidth;
      
      // Add stairs area if specified (stairs need more space)
      const stairsArea = stairsWidth > 0 ? (stairsWidth * overDigWidth) : 0;
      
      // Total footer area (standard + stairs area)
      const totalFooterArea = footerArea + stairsArea;
      
      // Calculate volume in cubic feet
      volumeCubicFeet = totalFooterArea * depthFeet;
      
      // Store dimensions for display
      length = poolLength;
      width = poolWidth;
      
    } else if (type === 'collar') {
      // Collar calculation: Use QuickQuote method (perimeter-based with 20% buffer)
      const poolLength = parseFloat(data.poolLength) || 0;
      const poolWidth = parseFloat(data.poolWidth) || 0;
      const hasSteps = data.hasSteps === true || data.hasSteps === 'true';
      
      if (poolLength <= 0 || poolWidth <= 0) {
        return { success: false, error: 'Pool length and width must be greater than 0' };
      }
      
      // Calculate pool perimeter
      const poolPerimeter = 2 * (poolLength + poolWidth);
      
      // Base calculation: perimeter / 32 (accounts for 12" wide × 6" deep collar)
      // This matches QuickQuote logic: 96ft ÷ 32 = 3 yards
      const baseCubicYards = poolPerimeter / 32;
      
      // Add 20% buffer for waste/overage (like QuickQuote)
      let cubicYardsWithBuffer = baseCubicYards * 1.2;
      
      // If steps exist: steps extend 6ft, require at least 8ft of concrete on step side
      if (hasSteps) {
        // Add extra area for steps: 8ft minimum (6ft step + 2ft buffer) × 1ft width (12" collar) × 6" depth
        // Convert to cubic yards: (8ft × 1ft × 0.5ft) / 27 = 8 / 27 = ~0.3 yards
        const stepsExtraYards = (8 * 1 * 0.5) / 27; // 8ft length × 1ft width × 0.5ft depth
        cubicYardsWithBuffer += stepsExtraYards;
      }
      
      // Convert to cubic feet for display
      volumeCubicFeet = cubicYardsWithBuffer * 27;
      volumeCubicYards = cubicYardsWithBuffer;
      
      // Round up to nearest 0.25 yards (concrete is typically ordered in 0.25 yard increments)
      const roundedYards = Math.ceil(cubicYardsWithBuffer * 4) / 4;
      volumeCubicYards = roundedYards;
      volumeCubicFeet = roundedYards * 27;
      
      // Store dimensions for display
      length = poolLength;
      width = poolWidth;
      depth = 6; // Standard 6 inches for collar
      
    } else {
      // Manual dimensions (deprecated - use collar type instead)
      length = parseFloat(data.length) || 0;
      width = parseFloat(data.width) || 0;
      depth = parseFloat(data.depth) || 0;
      
      if (length <= 0 || width <= 0 || depth <= 0) {
        return { success: false, error: 'Length, width, and depth must be greater than 0' };
      }
      
      // Convert depth from inches to feet
      const depthFeet = depth / 12;
      
      // Calculate volume in cubic feet
      volumeCubicFeet = length * width * depthFeet;
    }
    
    // Convert to cubic yards (1 cubic yard = 27 cubic feet)
    volumeCubicYards = volumeCubicFeet / 27;
    
    // Round up to nearest 0.25 yards (concrete is typically ordered in 0.25 yard increments)
    // Note: For collar type, this is already done above
    let roundedYards = volumeCubicYards;
    if (type !== 'collar') {
      roundedYards = Math.ceil(volumeCubicYards * 4) / 4;
      volumeCubicYards = roundedYards;
      volumeCubicFeet = roundedYards * 27;
    }
    
    // Price per yard for materials
    const pricePerYard = 208;
    const materialCost = roundedYards * pricePerYard;
    
    // Stamped materials only apply to deck/footer, NOT collar
    const stampedMaterialsCost = (isStamped && type !== 'collar') ? 500 : 0;
    
    // Total cost
    const totalCost = materialCost + stampedMaterialsCost;
    
    // Calculate with 30% profit margin (price = cost / 0.7)
    const totalPrice = totalCost / 0.7;
    
    return {
      success: true,
      type: type,
      length: length,
      width: width,
      depth: depth,
      depthFeet: depth / 12,
      volumeCubicFeet: volumeCubicFeet,
      volumeCubicYards: volumeCubicYards,
      roundedYards: roundedYards,
      pricePerYard: pricePerYard,
      materialCost: materialCost,
      isStamped: isStamped,
      stampedMaterialsCost: stampedMaterialsCost,
      totalCost: totalCost,
      totalPrice: totalPrice,
      profitMargin: 30,
      // Additional info for footer
      poolLength: (type === 'footer' || type === 'collar') ? (parseFloat(data.poolLength) || 0) : undefined,
      poolWidth: (type === 'footer' || type === 'collar') ? (parseFloat(data.poolWidth) || 0) : undefined,
      overDigWidth: type === 'footer' ? (parseFloat(data.overDigWidth) || 2) : undefined,
      stairsWidth: type === 'footer' ? (parseFloat(data.stairsWidth) || 0) : undefined,
      hasSteps: type === 'collar' ? (data.hasSteps === true || data.hasSteps === 'true') : undefined
    };
  } catch (error) {
    Logger.log('Error calculating concrete: ' + error.toString());
    return { success: false, error: error.toString() };
  }
}

