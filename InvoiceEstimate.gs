/**
 * Collect image URLs from project JSON and customer Drive "Photos InDrive" folder.
 */
function searchCustomerPhotosInDriveFolder_(customerName) {
  var urls = [];
  if (!customerName || !CUSTOMER_DRIVE_FOLDER_ID) return urls;
  try {
    var parentFolder = DriveApp.getFolderById(CUSTOMER_DRIVE_FOLDER_ID);
    var sanitized = sanitizeCustomerName(customerName);
    var folders = parentFolder.getFoldersByName(sanitized);
    if (!folders.hasNext()) return urls;
    var customerFolder = folders.next();
    var files = customerFolder.getFilesByType(MimeType.IMAGE);
    var it = files.iterator();
    while (it.hasNext()) {
      var f = it.next();
      try {
        urls.push(f.getUrl());
        if (urls.length >= 8) break;
      } catch (e) {}
    }
  } catch (e) {
    Logger.log('searchCustomerPhotosInDriveFolder_: ' + e);
  }
  return urls;
}

