        status: data.status || 'Sent'
      };
      
      if (data.sendEmails) {
        const result = sendInvoiceEstimate(invoiceData);
        results.push(result);
      } else {
        const result = saveInvoiceEstimate(invoiceData);
        results.push(result);
      }
    }
    
    return {
      success: true,
      created: results.length,
      results: results
    };
  } catch (error) {
    return { success: false, error: error.toString() };
  }
}

