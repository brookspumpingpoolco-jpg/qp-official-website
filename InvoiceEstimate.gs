    var createdPayload = buildCustomerFolderPayload_(folder, 'created', 'created');
    setCachedCustomerFolderInfo_(customerName, customerAddress, createdPayload);
    setCustomerFolderIdInCustomersSheet_(customerName, customerAddress, customerEmail, createdPayload.folderId);
    return createdPayload;
  } catch (error) {
    Logger.log('Error in getCustomerFolderLink: ' + error.toString());
    return { success: false, error: error.toString() };
  }
}

function checkCustomerFolderStatus(customerName, customerAddress, customerEmail) {
  try {
    var cached = getCachedCustomerFolderInfo_(customerName, customerAddress);
    if (cached && cached.folderId && cached.folderUrl) {
      cached.folderStatus = 'found';
      cached.statusMessage = 'Customer folder found';
      return cached;
    }

    var folderIdFromSheet = getCustomerFolderIdFromCustomersSheet_(customerName, customerAddress, customerEmail);
    if (folderIdFromSheet) {
      var payloadFromSheet = {
        success: true,
        folderId: folderIdFromSheet,
        folderName: String(customerName || '').trim() || 'Customer Folder',
        folderUrl: getCustomerFolderUrlFromId_(folderIdFromSheet),
        folderStatus: 'found',
        folderSource: 'customers-sheet',
        statusMessage: 'Customer folder found'
      };
      setCachedCustomerFolderInfo_(customerName, customerAddress, payloadFromSheet);
      return payloadFromSheet;
    }

    return {
      success: true,
      folderStatus: 'missing',
      folderSource: 'none',
      statusMessage: 'No customer folder found yet'
    };
  } catch (error) {
    Logger.log('Error in checkCustomerFolderStatus: ' + error.toString());
    return { success: false, error: error.toString() };
  }
}

/**
 * Build HTML for embedding uploaded photos in the email (small gallery).
 */
function buildPhotoGalleryHtml(photoUrls) {
  if (!photoUrls || !Array.isArray(photoUrls) || photoUrls.length === 0) return '';
  const maxPerRow = 3;
  let rows = [];
  for (let i = 0; i < photoUrls.length; i += maxPerRow) {
    const chunk = photoUrls.slice(i, i + maxPerRow);
    const cells = chunk.map(function(url) {
      return '<td width="33%" style="padding: 4px;"><img src="' + url + '" alt="Photo" style="width: 100%; max-width: 180px; height: auto; border-radius: 8px; display: block;"></td>';
    }).join('');
    rows.push('<tr>' + cells + '</tr>');
  }
  return '<div class="card" style="padding: 12px;"><p style="margin: 0 0 8px 0; font-size: 14px; color: #64748b;"><strong>Photos</strong></p><table style="width: 100%; border-collapse: collapse;">' + rows.join('') + '</table></div>';
}

/**
 * Validate approval token (allows viewing even if used, unless allowUsed=false)
 * Local copy is required for the standalone InvoiceEstimate web app deployment.
 */
function validateApprovalToken(estimateId, token, allowUsed) {
  try {
    allowUsed = allowUsed !== false; // default true

    if (!token || !String(token).trim()) {
      return { success: false, error: 'Token not found' };
    }

    const spreadsheet = SpreadsheetApp.openById(SPREADSHEET_ID);
    const tokensSheet = spreadsheet.getSheetByName(PM_APPROVAL_TOKENS_SHEET);
    if (!tokensSheet) {
      return { success: false, error: 'Tokens sheet not found' };
    }

    const data = tokensSheet.getDataRange().getValues();
    const tokenStr = String(token).trim();
    const estimateIdStr = String(estimateId || '').trim();

    for (let i = 1; i < data.length; i++) {
      const row = data[i];
      const rowToken = String(row[0] || '').trim();
      const rowEstimateId = String(row[1] || '').trim();

      if (rowToken === tokenStr && rowEstimateId === estimateIdStr) {
        const used = row[5];
        if (!allowUsed && (used === true || String(used).toLowerCase() === 'true')) {
          return { success: false, error: 'Token already used' };
        }

        const expiresVal = row[4];
        if (expiresVal) {
          const expiresDate = expiresVal instanceof Date ? expiresVal : new Date(expiresVal);
          if (!isNaN(expiresDate.getTime()) && new Date() > expiresDate) {
            return { success: false, error: 'Token expired' };
          }
        }

        return { success: true, rowIndex: i + 1 };
      }
    }

    return { success: false, error: 'Token not found' };
  } catch (error) {
    Logger.log('❌ Error validating token: ' + error.toString());
    return { success: false, error: error.toString() };
  }
}

/**
 * Get estimate data for approval links.
 */
function getEstimateForApprovalFast_(estimateId) {
  try {
    const lookupId = String(estimateId || '').trim();
    if (!lookupId) return { success: false, error: 'Estimate ID is required' };

    const spreadsheet = SpreadsheetApp.openById(SPREADSHEET_ID);
    const sheet = spreadsheet.getSheetByName(INVOICES_ESTIMATES_SHEET);
    if (!sheet) return { success: false, error: 'Sheet not found' };

    const lastRow = sheet.getLastRow();
    if (lastRow < 2) return { success: false, error: 'Estimate not found' };

    // Read all needed columns in one call for speed:
    // col 2 = ID, cols 4-6 = JSON chunks, col 8 = payment schedule JSON
    const rows = sheet.getRange(2, 2, lastRow - 1, 7).getValues();

    for (let i = 0; i < rows.length; i++) {
      const row = rows[i];
      const rowId = String(row[0] || '').trim();
      if (rowId !== lookupId) continue;

      const jsonPart1 = row[2] || ''; // col 4
      const jsonPart2 = row[3] || ''; // col 5
      const jsonPart3 = row[4] || ''; // col 6
      let jsonStr = concatenateJsonChunks(jsonPart1, jsonPart2, jsonPart3);
      if (!jsonStr || !String(jsonStr).trim()) jsonStr = String(jsonPart1 || '').trim();
      if (!jsonStr || String(jsonStr).charAt(0) !== '{') {
        return { success: false, error: 'Estimate JSON not found' };
      }

      const jsonData = JSON.parse(jsonStr);

      // col 8 (offset +6 from col2) may contain payment schedule JSON
      const paymentScheduleRaw = row[6] || '';
      if (paymentScheduleRaw && String(paymentScheduleRaw).trim()) {
        try {
          jsonData.paymentSchedule = JSON.parse(String(paymentScheduleRaw));
        } catch (_) {
          // keep existing jsonData.paymentSchedule if schedule column parse fails
        }
      }

      return { success: true, data: jsonData };
    }

    return { success: false, error: 'Estimate not found' };
  } catch (e) {
    Logger.log('❌ getEstimateForApprovalFast_ error: ' + e.toString());
    return { success: false, error: e.toString() };
  }
}

function getEstimateForApproval(estimateId, token) {
  try {
    const tokenValid = validateApprovalToken(estimateId, token, true);
    if (!tokenValid.success) {
      Logger.log('❌ getEstimateForApproval token validation failed: id=' + estimateId + ', reason=' + (tokenValid.error || 'unknown'));
      return { success: false, error: tokenValid.error || 'Invalid or expired token' };
    }

    // Fast path for estimate approval links (avoids slow row-by-row sheet reads).
    let estimate = null;
    const estimateIdUpper = String(estimateId || '').toUpperCase();
    if (estimateIdUpper.indexOf('EST-') === 0) {
      estimate = getEstimateForApprovalFast_(estimateId);
      if (!estimate.success) {
        Logger.log('⚠️ Fast estimate lookup failed; falling back to getInvoiceEstimate: ' + (estimate.error || 'unknown'));
      }
    }
    if (!estimate || !estimate.success) {
      estimate = getInvoiceEstimate(estimateId);
    }
    if (!estimate.success || !estimate.data) {
      return { success: false, error: 'Estimate not found' };
    }

    const estimateData = estimate.data;
    let docType = '';

    try {
      const spreadsheet = SpreadsheetApp.openById(SPREADSHEET_ID);
      const tokensSheet = spreadsheet.getSheetByName(PM_APPROVAL_TOKENS_SHEET);
      if (tokensSheet) {
        const tokenData = tokensSheet.getDataRange().getValues();
        const tokenStr = String(token || '').trim();
        const estimateIdStr = String(estimateId || '').trim();
        for (let i = 1; i < tokenData.length; i++) {
          const row = tokenData[i];
          if (String(row[0] || '').trim() === tokenStr && String(row[1] || '').trim() === estimateIdStr) {
            if (row.length > 6 && row[6]) {
              docType = String(row[6]).trim();
            } else {
              docType = 'Estimate';
            }
            break;
          }
        }
      }

      if (!docType) {
        const idStr = String(estimateId || '').toUpperCase();
        if (idStr.indexOf('EST-') === 0) docType = 'Estimate';
        else if (idStr.indexOf('INV-') === 0) docType = 'Invoice';
        else if (typeof normalizeInvoiceEstimateType === 'function') docType = normalizeInvoiceEstimateType(estimateData.type);
        else {
          const t = String(estimateData.type || '').toLowerCase();
          docType = (t === 'estimate') ? 'Estimate' : 'Invoice';
        }
      }
    } catch (typeErr) {
      Logger.log('⚠️ Error reading document type: ' + typeErr.toString());
      docType = estimateData.type || 'Estimate';
    }

    if (!docType || (docType !== 'Invoice' && docType !== 'Estimate')) {
      docType = 'Estimate';
    }

    const taxAmt = estimateData.taxAmount != null ? estimateData.taxAmount : estimateData.tax;

    return {
      success: true,
      estimate: {
        id: estimateId,
        type: docType,
        customerName: estimateData.customerName,
        customerEmail: estimateData.customerEmail,
        customerPhone: estimateData.customerPhone,
        customerAddress: estimateData.customerAddress,
        date: estimateData.date,
