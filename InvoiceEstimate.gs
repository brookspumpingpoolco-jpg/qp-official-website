function getUnpaidCloseoutMilestones_(projectData, breakdown) {
  var rows = (breakdown && Array.isArray(breakdown.rows)) ? breakdown.rows : [];
  var schedule = (projectData && projectData.paymentSchedule) ? projectData.paymentSchedule : [];
  if (typeof schedule === 'string') {
    try { schedule = JSON.parse(schedule || '[]'); } catch (_) { schedule = []; }
  }
  if (!Array.isArray(schedule)) schedule = [];

  var scheduleMap = {};
  schedule.forEach(function(ms) {
    scheduleMap[String(ms && ms.id || '')] = ms || {};
  });

  var fallbackDocId = String(
    (projectData && (projectData.invoiceId || projectData.estimateId || projectData.linkedInvoiceId || projectData.linkedEstimateId)) || ''
  ).trim();

  return rows.filter(function(r) {
    return money2_(r && r.owed || 0) > 0.01;
  }).map(function(r) {
    var rowId = String(r && r.id || '');
    var ms = scheduleMap[rowId] || {};
    var link = String(ms.stripePaymentUrl || ms.shareLink || '').trim();
    if (!link && ms.trackingId) {
      link = String(getPMStripeUrlByTrackingId(ms.trackingId) || '').trim();
    }
    if (!link) {
      // Prefer PM milestone invoice id (INV-PROJ-...) over linked estimate id
      var docId = String(ms.invoiceId || ms.trackingId || '').trim();
      if (!docId && ms.trackingId) {
        docId = String(getPMInvoiceIdByTrackingId_(ms.trackingId) || '').trim();
      }
      if (!docId) docId = String(fallbackDocId || '').trim();
      if (docId) {
        if (/^EST-/i.test(docId)) {
          link = NETLIFY_ESTIMATE_VIEWER_URL + '?id=' + encodeURIComponent(docId);
        } else {
          link = WEBFLOW_INVOICE_VIEWER_URL + '?id=' + encodeURIComponent(docId);
        }
      }
    }
    return {
      id: rowId,
      name: String(r && r.name || ms.name || 'Payment milestone'),
      owed: money2_(r && r.owed || ms.amount || 0),
      amount: money2_(ms.amount || r.amount || 0),
      link: link
    };
  });
}

function getLatestFinalCloseoutInvoiceForProject_(projectId) {
  try {
    var pid = String(projectId || '').trim();
    if (!pid) return null;
    var spreadsheet = SpreadsheetApp.openById(SPREADSHEET_ID);
    var sheet = spreadsheet.getSheetByName(INVOICES_ESTIMATES_SHEET);
    if (!sheet) return null;
    ensureInvoicesEstimatesNineColumns(sheet);

    var rows = sheet.getDataRange().getValues() || [];
    if (rows.length < 2) return null;

    var prefix = ('INV-' + pid + '-FINAL-').toUpperCase();
    var best = null;

    for (var r = 1; r < rows.length; r++) {
      var row = rows[r] || [];
      var rowId = String(row[1] || '').trim(); // column B = ID
      if (!rowId || rowId.toUpperCase().indexOf(prefix) !== 0) continue;

      var jsonStr = concatenateJsonChunks(row[3] || '', row[4] || '', row[5] || '');
      if (!jsonStr || !String(jsonStr).trim()) jsonStr = String(row[3] || '').trim();
      if (!jsonStr || String(jsonStr).trim().charAt(0) !== '{') continue;

      var data;
      try { data = JSON.parse(String(jsonStr)); } catch (_) { continue; }
      var status = String((data && (data.paymentStatus || data.status)) || '').toLowerCase();
      var isPaid = status === 'paid' || status === 'completed' || status === 'succeeded' || status === 'success';
      if (isPaid) continue;

      var ts = 0;
      var m = rowId.match(/-FINAL-(\d+)$/i);
      if (m) ts = parseInt(m[1], 10) || 0;
      if (!ts && data && data.date) {
        try { ts = new Date(data.date).getTime() || 0; } catch (eDate) { ts = 0; }
      }

      var viewerLink = getCustomerViewerWebflowUrl('Invoice', rowId, '');
      var paymentLink = String((data && (data.viewerLink || data.shareLink)) || '').trim();
      if (!paymentLink) paymentLink = String((data && (data.paymentLink || data.stripePaymentUrl)) || '').trim();
      var total = money2_((data && data.total) || row[6] || 0);

      if (!best || ts > best.ts) {
        best = {
          id: rowId,
          ts: ts,
          total: total,
          paymentLink: paymentLink,
          viewerLink: viewerLink
        };
      }
    }

    return best;
  } catch (e) {
    Logger.log('getLatestFinalCloseoutInvoiceForProject_ error: ' + e.toString());
    return null;
  }
}

function getProjectCloseoutPreview(projectId, openIssuesJson, photoUrlsJson, summaryMessage, askReview, includeDrivePhotos) {
  try {
    if (!projectId) return { success: false, error: 'Project ID required' };
    var proj = getProjectDetails(projectId);
    if (!proj || !proj.success) {
      return { success: false, error: (proj && proj.error) ? proj.error : 'Project not found' };
