/**
 * Calculate Pool Wall Price with 30% profit margin
 */
function calculatePoolWallPrice(cost) {
  try {
    const actualCost = parseFloat(cost) || 0;
    if (actualCost <= 0) {
      return { success: false, error: 'Cost must be greater than 0' };
    }
    
    // Calculate price with 30% profit margin
    // If cost is 70% of price, then price = cost / 0.7
    const price = actualCost / 0.7;
    const profit = price - actualCost;
    const profitMargin = 30; // Fixed at 30%
    
    return {
      success: true,
      cost: actualCost,
      price: price,
      profit: profit,
      profitMargin: profitMargin
    };
  } catch (error) {
    Logger.log('Error calculating pool wall price: ' + error.toString());
    return { success: false, error: error.toString() };
  }
}

