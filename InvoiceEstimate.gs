/**
 * Save invoice or estimate
 */
function saveInvoiceEstimate(data) {
  let scriptLock = null;
  try {
    // Serialize saves to prevent race-condition duplicates (double-clicks, parallel autosaves, etc.)
    scriptLock = LockService.getScriptLock();
    // Fail fast instead of blocking for long periods.
    // UI can retry quickly; this prevents 1-2 minute hangs.
    if (!scriptLock.tryLock(5000)) {
      return {
        success: false,
        error: 'Lock timeout: another process is updating this record. Please retry in a few seconds.'
      };
    }

    const spreadsheet = SpreadsheetApp.openById(SPREADSHEET_ID);
    let sheet = spreadsheet.getSheetByName(INVOICES_ESTIMATES_SHEET);
    
    // CRITICAL: Enforce 8 columns then column 9 (One-Off Items JSON)
    if (sheet) {
      enforce8ColumnStructure(sheet);
      ensureInvoicesEstimatesNineColumns(sheet);
    }
    
    // Create sheet with 9 columns if it doesn't exist
    // Col 9 = canonical JSON array of one-off line items (not merged into D–F JSON chunks)
    if (!sheet) {
      sheet = spreadsheet.insertSheet(INVOICES_ESTIMATES_SHEET);
      const headers = ['Company ID', 'ID', 'Customer Email', 'JSON Part 1', 'JSON Part 2', 'JSON Part 3', 'Total', 'Payment Schedule', INVOICES_HEADER_ONE_OFF_ITEMS];
      sheet.getRange(1, 1, 1, 9).setValues([headers]);
      sheet.getRange(1, 1, 1, 9).setFontWeight('bold');
      sheet.getRange(1, 1, 1, 9).setBackground('#0369a1');
      sheet.getRange(1, 1, 1, 9).setFontColor('#ffffff');
    } else {
        // CRITICAL: Ensure sheet has at least 8 columns (migrate from 7 or 4 if needed), then 9
        const lastCol = sheet.getLastColumn();
        Logger.log('Current sheet has ' + lastCol + ' columns');
        
        if (lastCol < 8) {
          // Migrate from old format to new 8-column format
          Logger.log('Migrating from ' + lastCol + ' columns to 8 columns');
          
          // First migrate to 7 if needed, then to 8
          if (lastCol < 7) {
            const missingCols = 7 - lastCol;
            sheet.insertColumns(lastCol + 1, missingCols);
            SpreadsheetApp.flush();
            
            // Migrate existing data if we had 4 columns
            if (lastCol === 4) {
              const lastRow = sheet.getLastRow();
              if (lastRow > 1) {
                Logger.log('Migrating ' + (lastRow - 1) + ' existing rows to 6-column format');
                for (let rowNum = 2; rowNum <= lastRow; rowNum++) {
                  try {
                    const oldJson = sheet.getRange(rowNum, 3).getValue();
                    if (oldJson && String(oldJson).length > 0) {
                      const jsonStr = String(oldJson);
                      const chunks = splitJsonString(jsonStr);
                      sheet.getRange(rowNum, 3, 1, 3).setValues([[chunks[0] || '', chunks[1] || '', chunks[2] || '']]);
                      const oldTotal = sheet.getRange(rowNum, 4).getValue();
                      sheet.getRange(rowNum, 6).setValue(oldTotal);
                      sheet.getRange(rowNum, 4).setValue('');
                    }
                  } catch (e) {
                    Logger.log('Error migrating row ' + rowNum + ': ' + e.toString());
                  }
                }
                SpreadsheetApp.flush();
              }
            }
          }
          
          if (sheet.getLastColumn() === 7) {
            migrateTo8ColumnStructure(sheet);
          }
        }
        if (sheet.getLastColumn() > 9) {
          Logger.log('⚠ WARNING: Sheet has ' + sheet.getLastColumn() + ' columns (expected 9). Trimming past column 9');
          const lcTrim = sheet.getLastColumn();
          sheet.deleteColumns(10, lcTrim - 9);
          SpreadsheetApp.flush();
          Logger.log('✓ Sheet trimmed to 9 columns.');
        }
        ensureInvoicesEstimatesNineColumns(sheet);
      
      // CRITICAL: Ensure headers are correct (9 columns)
      const expectedHeaders = ['Company ID', 'ID', 'Customer Email', 'JSON Part 1', 'JSON Part 2', 'JSON Part 3', 'Total', 'Payment Schedule', INVOICES_HEADER_ONE_OFF_ITEMS];
      const existingHeaders = sheet.getRange(1, 1, 1, Math.min(9, sheet.getLastColumn())).getValues()[0];
      let headersMatch = true;
      for (let i = 0; i < 9; i++) {
        const existingHeader = String(existingHeaders[i] || '').trim();
        const expectedHeader = expectedHeaders[i];
        if (existingHeader !== expectedHeader) {
          headersMatch = false;
          Logger.log('Header mismatch at column ' + (i + 1) + ': "' + existingHeader + '" vs "' + expectedHeader + '"');
          break;
        }
      }
      if (!headersMatch) {
        Logger.log('⚠ Headers do not match - FORCING update to 9-column headers');
        ensureInvoicesEstimatesNineColumns(sheet);
        if (sheet.getLastColumn() < 9) {
          const missingCols = 9 - sheet.getLastColumn();
          sheet.insertColumns(sheet.getLastColumn() + 1, missingCols);
        }
        sheet.getRange(1, 1, 1, 9).setValues([expectedHeaders]);
        sheet.getRange(1, 1, 1, 9).setFontWeight('bold');
        sheet.getRange(1, 1, 1, 9).setBackground('#0369a1');
        sheet.getRange(1, 1, 1, 9).setFontColor('#ffffff');
        SpreadsheetApp.flush();
        Logger.log('✓ Headers updated to 9-column format');
      } else {
        Logger.log('✓ Headers match 9-column format');
      }
    }
    
    // Normalize type FIRST to generate proper ID prefix
    const normalizedTypeForId = normalizeInvoiceEstimateType(data.type || 'Estimate');
    const isInvoiceForId = normalizedTypeForId === 'Invoice' || normalizedTypeForId === 'Snow Removal';
    const idPrefix = isInvoiceForId ? INVOICE_PREFIX : ESTIMATE_PREFIX;

    // If client omitted ID, try to upsert by existing document number before creating a new ID.
    // This prevents accidental duplicates when UI retries send/save for the same draft.
    function findExistingIdByDocNumber_(sheetRef, normalizedType, payload) {
      try {
        const lastRowLocal = sheetRef.getLastRow();
        if (lastRowLocal < 2) return '';

        enforce8ColumnStructure(sheetRef);
        ensureInvoicesEstimatesNineColumns(sheetRef);

        const targetNumber = String(
          (normalizedType === 'Invoice' || normalizedType === 'Snow Removal')
            ? (payload.invoiceNumber || '')
            : (payload.quoteNumber || '')
        ).trim();
        if (!targetNumber) return '';

        const targetEmail = String(payload.customerEmail || '').trim().toLowerCase();
        const scanCols = Math.max(9, sheetRef.getLastColumn());
        const rows = sheetRef.getRange(2, 1, lastRowLocal - 1, scanCols).getValues();

        for (let i = rows.length - 1; i >= 0; i--) {
          const row = rows[i];
          const rowId = String(row[1] || '').trim();
          if (!rowId) continue;

          let parsed = null;
          try {
            const jsonStr = concatenateJsonChunks(String(row[3] || ''), String(row[4] || ''), String(row[5] || ''));
            if (!jsonStr || jsonStr.charAt(0) !== '{') continue;
            parsed = JSON.parse(jsonStr);
          } catch (e) {
            continue;
          }
          if (!parsed) continue;

          const rowType = normalizeInvoiceEstimateType(parsed.type || 'Estimate');
          if (rowType !== normalizedType) continue;

          const rowNumber = String(
            (normalizedType === 'Invoice' || normalizedType === 'Snow Removal')
              ? (parsed.invoiceNumber || '')
              : (parsed.quoteNumber || '')
          ).trim();
          if (rowNumber !== targetNumber) continue;

          const rowEmail = String(parsed.customerEmail || '').trim().toLowerCase();
          if (targetEmail && rowEmail && targetEmail !== rowEmail) continue;

          return rowId;
        }
      } catch (lookupErr) {
        Logger.log('findExistingIdByDocNumber_ failed: ' + lookupErr.toString());
      }
      return '';
    }
    
    const originalProvidedId = data && data.id ? String(data.id).trim() : '';
    const explicitIdProvided = !!originalProvidedId;
    const editingExisting = !!(data && (data.editingExisting === true || String(data.editingExisting || '').toLowerCase() === 'true'));

    // Generate ID if new - CRITICAL: Use the ID from data if provided (for updates)
    // BUT: Fix misidentified estimates that have INV- prefix when they should be EST-
    let id = data.id;
    let isNewQuote = !data.id;
    
    if (data.id && normalizedTypeForId === 'Estimate' && String(data.id).startsWith(INVOICE_PREFIX + '-')) {
      // This is an estimate that was wrongly saved with INV- prefix - regenerate with EST- prefix
      Logger.log('⚠️ FIXING MISIDENTIFIED ESTIMATE: ' + data.id + ' → generating new ' + ESTIMATE_PREFIX + '- ID');
      id = generateId(idPrefix);
      isNewQuote = false; // Treat as update even though generating new ID
    } else if (!data.id) {
      const matchedId = findExistingIdByDocNumber_(sheet, normalizedTypeForId, data);
      if (matchedId) {
        id = matchedId;
        isNewQuote = false;
        Logger.log('♻️ Reusing existing document by number to prevent duplicate create. Matched ID: ' + id);
      } else {
        id = generateId(idPrefix);
      }
    }
    Logger.log('=== SAVE INVOICE ESTIMATE ===');
    Logger.log('ID from data: ' + (data.id || 'NONE (new quote)'));
    Logger.log('Final ID: ' + id);
    Logger.log('Is new quote: ' + isNewQuote);
    Logger.log('Will ' + (isNewQuote ? 'CREATE NEW' : 'UPDATE EXISTING') + ' row');
    
    const now = new Date();
    
    // Calculate totals (exclude processing fee line items; include one-offs in $ totals)
    const itemsParsed = JSON.parse(data.items || '[]');
    const oneOffOnlyRows = itemsParsed.filter(function(i) { return i.isOneOff === true; });
    const itemsForMainJson = itemsParsed.filter(function(i) { return i.isOneOff !== true; });
    const regularItems = itemsParsed.filter(function(item) { return !item.isProcessingFee; });
    const subtotal = regularItems.reduce((sum, item) => sum + (parseFloat(item.quantity || 0) * parseFloat(item.price || 0)), 0);
    const taxRate = parseFloat(data.taxRate || 0);
    const taxAmount = subtotal * (taxRate / 100);
    const discount = parseFloat(data.discount || 0);
    let processingFee = 0;
    if (data.addProcessingFee) {
      const baseTotal = subtotal + taxAmount - discount;
      processingFee = (baseTotal * STRIPE_PROCESSING_FEE_RATE) + STRIPE_PROCESSING_FEE_FIXED;
    }
    const total = subtotal + taxAmount - discount + processingFee;
    
    // Main JSON (cols D–F chunks) excludes one-offs — those live in column 9 only
    let itemsForStorage = itemsForMainJson.filter(function(item) { return !item.isProcessingFee; });
    if (data.addProcessingFee && processingFee > 0) {
      itemsForStorage.push({
        name: 'Processing Fee',
        description: 'Credit card processing fee (2.9% + $0.29)',
        quantity: 1,
        price: processingFee,
        total: processingFee,
        isProcessingFee: true
      });
    }
    
    // Get Company ID for the user creating the invoice/estimate
    let companyId = 'CMP-AQUALITYPOOL'; // Default for admin
    let companyInfo = { success: true, companyId: companyId, isAdmin: true };
    if (data.createdBy || data.userEmail) {
      const userEmail = data.createdBy || data.userEmail;
      companyInfo = getCompanyIdForUser(userEmail);
      if (companyInfo.success) {
        companyId = companyInfo.companyId;
      }
    }

    // Find existing row FIRST and load JSON so merges never wipe tokens, signatures, or links.
    const lastRow = sheet.getLastRow();
    let existingRow = -1;
    let ex = {};
    if (lastRow > 1) {
      enforce8ColumnStructure(sheet);
      ensureInvoicesEstimatesNineColumns(sheet);
      const scanCols = Math.max(9, sheet.getLastColumn());
      const dataRowsScan = sheet.getRange(2, 1, lastRow - 1, scanCols).getValues();
      const searchId = String(originalProvidedId || id).trim().toLowerCase();
      for (let si = 0; si < dataRowsScan.length; si++) {
        const rowIdCol2 = String(dataRowsScan[si][1] || '').trim().toLowerCase();
        const rowIdCol1Legacy = String(dataRowsScan[si][0] || '').trim().toLowerCase();
        if (rowIdCol2 === searchId || rowIdCol1Legacy === searchId) {
          existingRow = si + 2;
          try {
            const fj = concatenateJsonChunks(String(dataRowsScan[si][3] || ''), String(dataRowsScan[si][4] || ''), String(dataRowsScan[si][5] || ''));
            if (fj && fj.indexOf('{') === 0) ex = JSON.parse(fj);
          } catch (eEx) {
            ex = {};
          }
          break;
        }
      }
    }

    // Strict update protections (prevents accidental overwrite/new-row creation during saved-quote edits)
    if (editingExisting && !explicitIdProvided) {
      return {
        success: false,
        error: 'Editing existing document requires a valid ID. Please reload the saved quote and try again.'
      };
    }

    if (explicitIdProvided && existingRow === -1) {
      return {
        success: false,
        error: 'Cannot update: the specified document ID was not found. Refresh and reopen the saved quote before saving.'
      };
    }

    if (explicitIdProvided && existingRow !== -1) {
      const incomingType = normalizeInvoiceEstimateType(data.type || 'Estimate');
      const existingType = normalizeInvoiceEstimateType(ex.type || incomingType);
      if (existingType && incomingType && existingType !== incomingType) {
        return {
          success: false,
          error: 'Type mismatch for this ID. Existing record is ' + existingType + ' but attempted to save as ' + incomingType + '. Save was blocked to prevent overwriting another document.'
        };
      }
    }

    function _mergeStr_(d, exObj, key) {
      var dv = d[key];
      if (dv !== undefined && dv !== null && String(dv).trim() !== '') return String(dv).trim();
      var ev = exObj[key];
      if (ev !== undefined && ev !== null && String(ev).trim() !== '') return String(ev).trim();
      return '';
    }
    function _mergeBool_(d, exObj, key) {
      if (d[key] === true || d[key] === 'true') return true;
      if (d[key] === false || d[key] === 'false') return false;
      if (exObj[key] === true || exObj[key] === 'true') return true;
      if (exObj[key] === false || exObj[key] === 'false') return false;
      return false;
    }

    // Preserve existing approval token — NEVER regenerate once set (breaks emailed links).
    var approvalToken = '';
    if (data.approvalToken && String(data.approvalToken).trim()) {
      approvalToken = String(data.approvalToken).trim();
    } else if (ex.approvalToken && String(ex.approvalToken).trim()) {
      approvalToken = String(ex.approvalToken).trim();
    } else {
      approvalToken = Utilities.getUuid();
    }

    // Auto-approve invoices in workflow (no customer approval step) — but merge stored approval if client omits
    const normalizedType = normalizeInvoiceEstimateType(data.type || ex.type || 'Estimate');
    const isInvoice = normalizedType === 'Invoice';
    const isEstimate = normalizedType === 'Estimate';
    const defaultApprovalStatus = isInvoice ? 'Approved' : (approvalToken ? 'Pending' : '');
    var approvalStatusMerged = defaultApprovalStatus;
    if (data.approvalStatus !== undefined && data.approvalStatus !== null && String(data.approvalStatus).trim() !== '') {
      approvalStatusMerged = data.approvalStatus;
    } else if (ex.approvalStatus !== undefined && ex.approvalStatus !== null && String(ex.approvalStatus).trim() !== '') {
      approvalStatusMerged = ex.approvalStatus;
    }

    var createdDateMerged = ex.createdDate || data.createdDate || now;
    if (isNewQuote) createdDateMerged = now;

    var paymentScheduleMerged = null;
    if (data.paymentSchedule !== undefined && data.paymentSchedule !== null && String(data.paymentSchedule).trim() !== '') {
      paymentScheduleMerged = data.paymentSchedule;
    } else if (ex.paymentSchedule !== undefined && ex.paymentSchedule !== null) {
      paymentScheduleMerged = ex.paymentSchedule;
    }

    // Build complete JSON object with ALL data (merge preserves server fields on partial client payloads)
    var mergedStatus = data.status !== undefined && data.status !== null && String(data.status).trim() !== '' ? String(data.status) : String(ex.status || 'Draft');
    // Estimates sent to customer should show as pending customer approval in UI/workflow.
    if (isEstimate && String(mergedStatus).toLowerCase() === 'sent') {
      mergedStatus = 'Pending';
    }
    // Invoices are final documents (no signature flow).
    if (isInvoice && (!String(mergedStatus || '').trim() || String(mergedStatus).toLowerCase() === 'draft')) {
      mergedStatus = 'Final';
    }

    var mergedAdminSignedDate = data.adminSignedDate !== undefined ? data.adminSignedDate : (ex.adminSignedDate || null);
    if (isInvoice && !mergedAdminSignedDate) {
      mergedAdminSignedDate = now;
    }

    const jsonData = {
      id: id,
      type: normalizedType,
      status: mergedStatus,
      customerName: data.customerName !== undefined ? data.customerName : (ex.customerName || ''),
      customerEmail: data.customerEmail !== undefined ? data.customerEmail : (ex.customerEmail || ''),
      customerPhone: data.customerPhone !== undefined ? data.customerPhone : (ex.customerPhone || ''),
      customerAddress: data.customerAddress !== undefined ? data.customerAddress : (ex.customerAddress || ''),
      customerId: data.customerId !== undefined ? data.customerId : (ex.customerId || ''),
      date: data.date || ex.date || now,
      dueDate: data.dueDate !== undefined ? data.dueDate : (ex.dueDate || ''),
      invoiceNumber: data.invoiceNumber || ex.invoiceNumber || (isInvoice ? generateNextNumber('Invoice') : ''),
      quoteNumber: data.quoteNumber || ex.quoteNumber || (isEstimate ? generateNextNumber('Estimate') : ''),
      items: JSON.stringify(itemsForStorage),
      subtotal: subtotal,
      taxRate: taxRate,
      taxAmount: taxAmount,
      discount: discount,
      total: total,
      addProcessingFee: data.addProcessingFee !== undefined
        ? parseBooleanFlagInvoice_(data.addProcessingFee, false)
        : parseBooleanFlagInvoice_(ex.addProcessingFee, false),
      processingFee: processingFee,
      notes: data.notes !== undefined ? data.notes : (ex.notes || ''),
      terms: data.terms !== undefined ? data.terms : (ex.terms || ''),
      paymentSchedule: paymentScheduleMerged,
      approvalToken: approvalToken,
      companyId: companyId,
      pdfUrl: _mergeStr_(data, ex, 'pdfUrl'),
      shareLink: _mergeStr_(data, ex, 'shareLink'),
      createdDate: createdDateMerged,
      createdBy: data.createdBy || ex.createdBy || '',
      lastModified: now,
      paymentStatus: data.paymentStatus !== undefined && String(data.paymentStatus).trim() !== '' ? data.paymentStatus : (ex.paymentStatus || 'Not Sent'),
      paymentLink: _mergeStr_(data, ex, 'paymentLink'),
      paymentDate: data.paymentDate !== undefined ? data.paymentDate : (ex.paymentDate || null),
      paymentMethod: data.paymentMethod !== undefined ? data.paymentMethod : (ex.paymentMethod || ''),
      paymentTransactionId: _mergeStr_(data, ex, 'paymentTransactionId'),
      sentDate: data.sentDate !== undefined ? data.sentDate : (ex.sentDate || null),
      sentBy: data.sentBy !== undefined ? data.sentBy : (ex.sentBy || ''),
      approvalStatus: approvalStatusMerged,
      approvalDate: data.approvalDate !== undefined ? data.approvalDate : (ex.approvalDate || null),
      signatureData: data.signatureData !== undefined ? (data.signatureData || '') : (ex.signatureData || ''),
      signatureUrl: data.signatureUrl !== undefined ? (data.signatureUrl || '') : (ex.signatureUrl || ''),
      printedName: data.printedName !== undefined ? data.printedName : (ex.printedName || ''),
      customerSigned: isInvoice ? true : _mergeBool_(data, ex, 'customerSigned'),
      adminSigned: isInvoice ? true : _mergeBool_(data, ex, 'adminSigned'),
      adminSignatureData: data.adminSignatureData !== undefined ? (data.adminSignatureData || '') : (ex.adminSignatureData || ''),
      adminPrintedName: isInvoice
        ? (data.adminPrintedName !== undefined ? data.adminPrintedName : (ex.adminPrintedName || COMPANY_NAME || 'A Quality Pool Company'))
        : (data.adminPrintedName !== undefined ? data.adminPrintedName : (ex.adminPrintedName || '')),
      adminSignedDate: mergedAdminSignedDate,
      contractPdfUrl: _mergeStr_(data, ex, 'contractPdfUrl'),
      contractFullyExecuted: isInvoice ? true : _mergeBool_(data, ex, 'contractFullyExecuted'),
      driveFileId: _mergeStr_(data, ex, 'driveFileId'),
      invoiceSent: _mergeBool_(data, ex, 'invoiceSent'),
      invoiceSentDate: data.invoiceSentDate !== undefined ? data.invoiceSentDate : (ex.invoiceSentDate || null),
      invoicesTabComplete: _mergeBool_(data, ex, 'invoicesTabComplete'),
      invoiceStatus: isInvoice
        ? (data.invoiceStatus !== undefined && String(data.invoiceStatus).trim() !== '' ? data.invoiceStatus : (ex.invoiceStatus || 'Finalized'))
        : (data.invoiceStatus !== undefined ? data.invoiceStatus : (ex.invoiceStatus || '')),
      totalPaid: data.totalPaid !== undefined ? parseFloat(data.totalPaid || 0) : parseFloat(ex.totalPaid || 0),
      remainingBalance: data.remainingBalance !== undefined && data.remainingBalance !== null && String(data.remainingBalance).trim() !== ''
        ? parseFloat(data.remainingBalance)
        : (ex.remainingBalance !== undefined ? parseFloat(ex.remainingBalance) : null),
      // ── Deposit / partial-billing ──
      depositMode: data.depositMode !== undefined
        ? parseBooleanFlagInvoice_(data.depositMode, false)
        : parseBooleanFlagInvoice_(ex.depositMode, false),
      depositAmount: (data.depositMode === true || data.depositMode === 'true')
        ? (data.depositAmount !== undefined && data.depositAmount !== null ? parseFloat(data.depositAmount) : parseFloat(ex.depositAmount || 0))
        : (ex.depositMode ? parseFloat(ex.depositAmount || 0) : null),
      depositBalance: (data.depositMode === true || data.depositMode === 'true')
        ? (data.depositBalance !== undefined && data.depositBalance !== null ? parseFloat(data.depositBalance) : parseFloat(ex.depositBalance || 0))
        : (ex.depositMode ? parseFloat(ex.depositBalance || 0) : null)
    };

    // Enforce estimate pending-customer-approval defaults when not yet signed.
    if (isEstimate && !jsonData.customerSigned && !jsonData.signatureData && !jsonData.signatureUrl) {
      jsonData.approvalStatus = String(jsonData.approvalStatus || 'Pending');
      if (String(jsonData.status || '').toLowerCase() === 'sent' || !String(jsonData.status || '').trim()) {
        jsonData.status = 'Pending';
      }
    }
    
    // Log auto-approval for invoices
    if (isInvoice) {
      Logger.log('✅ Invoice auto-approved (no customer approval required)');
    }
    
    // Log payment schedule for debugging
    if (data.paymentSchedule) {
      var paymentSchedulePreview = (typeof data.paymentSchedule === 'string')
        ? data.paymentSchedule
        : JSON.stringify(data.paymentSchedule);
      Logger.log('💰 Payment schedule being saved: ' + paymentSchedulePreview.substring(0, 200) + '...');
    } else {
      Logger.log('⚠️ No payment schedule in data');
    }
    
    const jsonString = JSON.stringify(jsonData);
    Logger.log('JSON string length: ' + jsonString.length);
    
    // Split JSON into chunks if needed (max 49,500 chars per chunk)
    const jsonChunks = splitJsonString(jsonString);
    Logger.log('JSON split into ' + jsonChunks.filter(c => c).length + ' chunks');
    Logger.log('Searching for existing row with ID: ' + id);
    Logger.log('Total rows in sheet: ' + lastRow);
    if (existingRow === -1) {
      Logger.log('No existing row found - will create new row');
    } else {
      Logger.log('✓ FOUND EXISTING ROW at index: ' + existingRow);
    }
    
    // Build row data: 8 cols + column 9 = One-Off Items JSON (canonical array)
    let col9OneOffJson = JSON.stringify(oneOffOnlyRows);
    if (existingRow !== -1 && oneOffOnlyRows.length === 0) {
      try {
        ensureInvoicesEstimatesNineColumns(sheet);
        const prev9 = sheet.getRange(existingRow, INVOICES_COL_ONE_OFF_ITEMS).getValue();
        if (prev9 && String(prev9).trim()) col9OneOffJson = String(prev9).trim();
      } catch (presErr) {
        Logger.log('Preserve col9: ' + presErr.toString());
      }
    }
    
    // Handle Payment Schedule - convert to JSON string if it's an array or object
    let paymentScheduleStr = '';
    let preserveExistingSchedule = false;
    
    if (data.paymentSchedule) {
      if (typeof data.paymentSchedule === 'string') {
        paymentScheduleStr = data.paymentSchedule;
      } else if (Array.isArray(data.paymentSchedule) || typeof data.paymentSchedule === 'object') {
        paymentScheduleStr = JSON.stringify(data.paymentSchedule);
      }
    } else {
      // If no payment schedule provided, preserve existing one
      preserveExistingSchedule = true;
      Logger.log('⚠️ No payment schedule in save data - will preserve existing Column H value');
      
      // Read existing payment schedule from Column H (8) if updating
      if (existingRow !== -1) {
        try {
          const existingSchedule = sheet.getRange(existingRow, 8).getValue() || '';
          paymentScheduleStr = String(existingSchedule).trim();
          Logger.log('✅ Preserved existing payment schedule from Column H');
        } catch (e) {
          Logger.log('⚠️ Error reading existing payment schedule: ' + e.toString());
        }
      }
    }
    
    const rowData = [
      String(companyId || 'CMP-AQUALITYPOOL').trim(),
      String(id || '').trim(),
      String(data.customerEmail || '').trim(),
      String(jsonChunks[0] || '').trim(),
      String(jsonChunks[1] || '').trim(),
      String(jsonChunks[2] || '').trim(),
      parseFloat(total) || 0,
      paymentScheduleStr.trim(),
      col9OneOffJson
    ];
    
    Logger.log('💰 Payment Schedule column H: ' + (paymentScheduleStr ? paymentScheduleStr.substring(0, 100) + '...' : 'EMPTY'));
    Logger.log('📎 Column 9 one-offs length: ' + (col9OneOffJson ? col9OneOffJson.length : 0));
    
    if (rowData.length !== 9) {
      throw new Error('Row data must have exactly 9 elements');
    }
    
    // Check for changes if updating existing estimate
    let changes = [];
    if (existingRow !== -1 && data.type === 'Estimate') {
      // Read the 8 columns from the existing row
      const oldRow = sheet.getRange(existingRow, 1, 1, 9).getValues()[0];
      const oldTotal = parseFloat(oldRow[6]) || 0; // Total is now column 7 (index 6)
      if (Math.abs(total - oldTotal) > 0.01) {
        changes.push(`Total changed from $${oldTotal.toFixed(2)} to $${total.toFixed(2)}`);
      }
      try {
        const oldJsonStr = concatenateJsonChunks(oldRow[3], oldRow[4], oldRow[5]); // JSON parts are now columns 4-6 (indices 3-5)
        const oldJsonData = JSON.parse(oldJsonStr || '{}');
        const oldItems = JSON.parse(oldJsonData.items || '[]');
        if (JSON.stringify(oldItems) !== JSON.stringify(items)) {
        changes.push('Items have been modified');
        }
      } catch (e) {
        Logger.log('Error parsing old JSON: ' + e.toString());
      }
    }
    
    ensureInvoicesEstimatesNineColumns(sheet);
    
    if (existingRow === -1) {
      Logger.log('Creating NEW row with 9 columns');
      const nextRow = sheet.getLastRow() + 1;
      sheet.getRange(nextRow, 1, 1, 9).setValues([rowData]);
      SpreadsheetApp.flush();
      Logger.log('✓ New row ' + nextRow + ' created successfully with ID: ' + id);
    } else {
      Logger.log('Updating EXISTING row ' + existingRow + ' with 9 columns');
      sheet.getRange(existingRow, 1, 1, 9).setValues([rowData]);
      SpreadsheetApp.flush();
      Logger.log('✓ Row ' + existingRow + ' updated successfully with ID: ' + id);
    }
    
    ensureInvoicesEstimatesNineColumns(sheet);
    SpreadsheetApp.flush();
    
    Logger.log('=== SAVE COMPLETE ===');
    Logger.log('Sheet now has exactly ' + sheet.getLastColumn() + ' columns');
    Logger.log('Returning ID: ' + id);
    
    // Save approval token if this is an Estimate
    Logger.log('🔑 Token save check: type=' + normalizedType + ', approvalToken=' + (approvalToken ? 'yes' : 'no'));
    if (approvalToken) {
      try {
        upsertPMApprovalToken_(spreadsheet, approvalToken, id, data.customerEmail || '', normalizedType);
        Logger.log('✅ Approval token saved to PM_Approval_Tokens sheet for ' + normalizedType);
      } catch (tokenErr) {
        Logger.log('⚠️ Error saving approval token: ' + tokenErr.toString());
      }
    } else if (!approvalToken) {
      Logger.log('⚠️ No approval token generated!');
    }

    // Release lock before non-critical network/integration work.
    // This dramatically reduces lock contention for concurrent autosave/send requests.
    if (scriptLock) {
      try {
        scriptLock.releaseLock();
        Logger.log('🔓 Released saveInvoiceEstimate lock before external integrations');
      } catch (unlockErr) {
        Logger.log('⚠️ Early lock release failed: ' + unlockErr.toString());
      }
      scriptLock = null;
    }
    
    // If this is an Estimate, save to Customer Portal
    if (data.type === 'Estimate' && data.customerEmail) {
      try {
        const quoteData = {
          id: id,
          type: 'Estimate',
          status: data.status || 'Draft',
          customerName: data.customerName || '',
          customerEmail: data.customerEmail || '',
          customerPhone: data.customerPhone || '',
          customerAddress: data.customerAddress || '',
          date: data.date || now,
          dueDate: data.dueDate || '',
          quoteNumber: jsonData.quoteNumber,
          items: data.items || '[]',
          subtotal: subtotal,
          taxRate: taxRate,
          taxAmount: taxAmount,
          discount: discount,
          total: total,
          notes: data.notes || '',
          terms: data.terms || '',
          invoiceEstimateId: id
        };
        
        // Save to Customer Portal via HTTP call to CustomerPortal webapp
        const customerPortalUrl = 'https://script.google.com/macros/s/AKfycbzXn2xrGyuuIQFGjk_vn5O80_kAEg28tMHZJtdpAoagtnqLx3vQ0t-kuEJa2YEXcTP5WA/exec';
        try {
          UrlFetchApp.fetch(customerPortalUrl, {
            method: 'POST',
            payload: {
              action: 'saveCustomerQuote',
              email: data.customerEmail,
              quoteData: JSON.stringify(quoteData)
            },
            muteHttpExceptions: true
          });
        } catch (e) {
          Logger.log('Error saving quote to Customer Portal: ' + e.toString());
        }
        
        // If there are changes and quote was already released, send change notification
        if (changes.length > 0 && data.status === 'Released') {
          try {
            UrlFetchApp.fetch(customerPortalUrl, {
              method: 'POST',
              payload: {
                action: 'sendQuoteChangeEmail',
                email: data.customerEmail,
                quoteId: id,
                changes: JSON.stringify(changes)
              },
              muteHttpExceptions: true
            });
          } catch (e) {
            Logger.log('Error sending quote change email: ' + e.toString());
          }
        }
      } catch (e) {
        Logger.log('Error integrating with Customer Portal: ' + e.toString());
      }
    }
    
    return {
      success: true,
      id: id,
      approvalToken: approvalToken,
      changes: changes.length > 0 ? changes : undefined
    };
  } catch (error) {
    Logger.log('Error saving invoice/estimate: ' + error.toString());
    return {
      success: false,
      error: error.toString()
    };
  } finally {
    if (scriptLock) {
      try { scriptLock.releaseLock(); } catch (_) {}
    }
  }
}

/**
 * Add a line item to an existing invoice/estimate record in-place.
 * Updates items array, subtotal, and total in the stored JSON chunks.
 * Returns { success, error }
 */
function addItemToInvoiceRecord(invoiceId, newItem) {
  try {
    if (!invoiceId) return { success: false, error: 'No invoice ID provided' };

    const spreadsheet = SpreadsheetApp.openById(SPREADSHEET_ID);
    const sheet = spreadsheet.getSheetByName(INVOICES_ESTIMATES_SHEET);
    if (!sheet) return { success: false, error: 'Invoices sheet not found' };
    ensureInvoicesEstimatesNineColumns(sheet);

    const lastRow = sheet.getLastRow();
    for (let rowNum = 2; rowNum <= lastRow; rowNum++) {
      const rowId = String(sheet.getRange(rowNum, 2).getValue() || '').trim();
      if (rowId !== String(invoiceId).trim()) continue;

      // Read stored JSON
      const chunk1 = sheet.getRange(rowNum, 4).getValue() || '';
      const chunk2 = sheet.getRange(rowNum, 5).getValue() || '';
      const chunk3 = sheet.getRange(rowNum, 6).getValue() || '';
      const jsonStr = concatenateJsonChunks(chunk1, chunk2, chunk3);
      if (!jsonStr || !jsonStr.startsWith('{')) {
        return { success: false, error: 'Could not read invoice JSON for ID: ' + invoiceId };
      }

      const jsonData = JSON.parse(jsonStr);

      // Parse existing items
      let existingItems = [];
      try {
        existingItems = JSON.parse(jsonData.items || '[]');
      } catch (e) { existingItems = []; }

      // Add new item
      var pushed = {
        name:        newItem.name || 'Item',
        description: newItem.description || newItem.name || '',
        quantity:    parseFloat(newItem.quantity || 1),
        price:       parseFloat(newItem.price || 0),
        total:       parseFloat(newItem.total || (newItem.price * (newItem.quantity || 1))),
        isOneOff:    true
      };
      if (newItem.oneOffTrackingId) pushed.oneOffTrackingId = newItem.oneOffTrackingId;
      existingItems.push(pushed);

      // Recalculate totals (exclude processing fees from subtotal)
      const regularItems = existingItems.filter(function(it) { return !it.isProcessingFee; });
      const newSubtotal = regularItems.reduce(function(sum, it) {
        return sum + (parseFloat(it.quantity || 1) * parseFloat(it.price || 0));
      }, 0);
      const taxRate = parseFloat(jsonData.taxRate || 0);
      const tax = newSubtotal * (taxRate / 100);
      const discount = parseFloat(jsonData.discount || 0);
      let procFee = 0;
      if (jsonData.addProcessingFee) {
        procFee = ((newSubtotal + tax - discount) * STRIPE_PROCESSING_FEE_RATE) + STRIPE_PROCESSING_FEE_FIXED;
        // Update processing fee line item if present
        const feeIdx = existingItems.findIndex(function(it) { return it.isProcessingFee; });
        if (feeIdx >= 0) {
          existingItems[feeIdx].price = procFee;
          existingItems[feeIdx].total = procFee;
        }
      }
      const newTotal = newSubtotal + tax - discount + procFee;

      const oneOffOnly = existingItems.filter(function(it) {
        return it.isOneOff === true;
      });
      const itemsForMainJson = existingItems.filter(function(it) {
        return it.isOneOff !== true;
      });
      jsonData.items = JSON.stringify(itemsForMainJson);
      jsonData.subtotal = newSubtotal;
      jsonData.total = newTotal;
      jsonData.lastModified = new Date();

      const chunks = splitJsonString(JSON.stringify(jsonData));
      sheet.getRange(rowNum, 4).setValue(chunks[0] || '');
      sheet.getRange(rowNum, 5).setValue(chunks[1] || '');
      sheet.getRange(rowNum, 6).setValue(chunks[2] || '');
      sheet.getRange(rowNum, 7).setValue(newTotal);
      ensureInvoicesEstimatesNineColumns(sheet);
      sheet.getRange(rowNum, INVOICES_COL_ONE_OFF_ITEMS).setValue(JSON.stringify(oneOffOnly));
      SpreadsheetApp.flush();

      Logger.log('✅ addItemToInvoiceRecord: added "' + newItem.name + '" to invoice ' + invoiceId + ' (col 9 one-offs: ' + oneOffOnly.length + ')');
      return { success: true };
    }

    Logger.log('⚠️ addItemToInvoiceRecord: invoice not found: ' + invoiceId);
    return { success: false, error: 'Invoice not found: ' + invoiceId };
  } catch (err) {
    Logger.log('❌ addItemToInvoiceRecord error: ' + err.toString());
    return { success: false, error: err.toString() };
  }
}

/**
 * Remove one one-off line from invoice col 9 and recalc totals (mirrors addItemToInvoiceRecord).
 * @param {string} invoiceId - Linked estimate/invoice document ID
 * @param {string} trackingId - ONE-PROJ-... id (preferred match on stored oneOffTrackingId)
 * @param {string} name - Milestone/item name (fallback if col 9 lines lack tracking id)
 * @param {number} amount - Line total (fallback match)
 */
function removeOneOffFromInvoiceRecord(invoiceId, trackingId, name, amount) {
  try {
    if (!invoiceId) return { success: false, error: 'No invoice ID provided' };
    var targetAmt = parseFloat(amount || 0);
    var targetName = String(name || '').trim();
    var tid = String(trackingId || '').trim();

    var spreadsheet = SpreadsheetApp.openById(SPREADSHEET_ID);
    var sheet = spreadsheet.getSheetByName(INVOICES_ESTIMATES_SHEET);
    if (!sheet) return { success: false, error: 'Invoices sheet not found' };
    ensureInvoicesEstimatesNineColumns(sheet);

    var lastRow = sheet.getLastRow();
    for (var rowNum = 2; rowNum <= lastRow; rowNum++) {
      var rowId = String(sheet.getRange(rowNum, 2).getValue() || '').trim();
      if (rowId !== String(invoiceId).trim()) continue;

      var chunk1 = sheet.getRange(rowNum, 4).getValue() || '';
      var chunk2 = sheet.getRange(rowNum, 5).getValue() || '';
      var chunk3 = sheet.getRange(rowNum, 6).getValue() || '';
      var jsonStr = concatenateJsonChunks(chunk1, chunk2, chunk3);
      if (!jsonStr || !jsonStr.startsWith('{')) {
        return { success: false, error: 'Could not read invoice JSON for ID: ' + invoiceId };
      }
      var jsonData = JSON.parse(jsonStr);

      var mainItems = [];
      try {
        mainItems = JSON.parse(jsonData.items || '[]');
      } catch (e) {
        mainItems = [];
      }

      var oneOffOnly = [];
      var cell9 = sheet.getRange(rowNum, INVOICES_COL_ONE_OFF_ITEMS).getValue();
      if (cell9 && String(cell9).trim()) {
        try {
          oneOffOnly = JSON.parse(String(cell9));
        } catch (e2) {
          oneOffOnly = [];
        }
      }
      if (!Array.isArray(oneOffOnly)) oneOffOnly = [];

      var removed = false;
      var newOneOffs = [];
      for (var i = 0; i < oneOffOnly.length; i++) {
        var it = oneOffOnly[i];
        var byTid = tid && String(it.oneOffTrackingId || '').trim() === tid;
        var byLegacy =
          String(it.name || '').trim() === targetName &&
          Math.abs(parseFloat(it.total || 0) - targetAmt) < 0.02;
        if (!removed && (byTid || (!it.oneOffTrackingId && byLegacy))) {
          removed = true;
          continue;
        }
        newOneOffs.push(it);
      }
      if (!removed) {
        return { success: false, error: 'One-off line not found on invoice record' };
      }

      var existingItems = mainItems.concat(newOneOffs);
      var regularItems = existingItems.filter(function(it) {
        return !it.isProcessingFee;
      });
      var newSubtotal = regularItems.reduce(function(sum, it) {
        return sum + parseFloat(it.quantity || 1) * parseFloat(it.price != null && it.price !== '' ? it.price : it.unitPrice || 0);
      }, 0);
      var taxRate = parseFloat(jsonData.taxRate || 0);
      var tax = newSubtotal * (taxRate / 100);
      var discount = parseFloat(jsonData.discount || 0);
      var procFee = 0;
      if (jsonData.addProcessingFee) {
        procFee = (newSubtotal + tax - discount) * STRIPE_PROCESSING_FEE_RATE + STRIPE_PROCESSING_FEE_FIXED;
        var feeIdx = existingItems.findIndex(function(it) {
          return it.isProcessingFee;
        });
        if (feeIdx >= 0) {
          existingItems[feeIdx].price = procFee;
          existingItems[feeIdx].total = procFee;
        }
      }
      var newTotal = newSubtotal + tax - discount + procFee;

      var itemsForMainJson = existingItems.filter(function(it) {
        return it.isOneOff !== true;
      });
      jsonData.items = JSON.stringify(itemsForMainJson);
      jsonData.subtotal = newSubtotal;
      jsonData.total = newTotal;
      jsonData.lastModified = new Date();

      var chunks = splitJsonString(JSON.stringify(jsonData));
      sheet.getRange(rowNum, 4).setValue(chunks[0] || '');
      sheet.getRange(rowNum, 5).setValue(chunks[1] || '');
      sheet.getRange(rowNum, 6).setValue(chunks[2] || '');
      sheet.getRange(rowNum, 7).setValue(newTotal);
      ensureInvoicesEstimatesNineColumns(sheet);
      sheet.getRange(rowNum, INVOICES_COL_ONE_OFF_ITEMS).setValue(JSON.stringify(newOneOffs));
      SpreadsheetApp.flush();

      Logger.log('✅ removeOneOffFromInvoiceRecord: removed one-off from invoice ' + invoiceId);
      return { success: true };
    }

    return { success: false, error: 'Invoice not found: ' + invoiceId };
  } catch (err) {
    Logger.log('❌ removeOneOffFromInvoiceRecord: ' + err.toString());
    return { success: false, error: err.toString() };
  }
}

/**
 * Delete invoice/estimate by ID
 */
function deleteInvoiceEstimate(id) {
  try {
    Logger.log('Deleting invoice/estimate with ID: ' + id);
    
    const spreadsheet = SpreadsheetApp.openById(SPREADSHEET_ID);
    const sheet = spreadsheet.getSheetByName(INVOICES_ESTIMATES_SHEET);
    
    if (!sheet) {
      return { success: false, error: 'Sheet not found' };
    }
    
    // Ensure 8-column structure
    enforce8ColumnStructure(sheet);
    
    const lastRow = sheet.getLastRow();
    const sheetCols = sheet.getLastColumn();
    const is8Column = (sheetCols >= 8);
    
    // Determine ID column based on structure
    // In 8-column structure: Column 1 = Company ID, Column 2 = ID
    // In old 7-column structure: Column 1 = ID
    const idCol = is8Column ? 2 : 1;
    
    Logger.log('Sheet has ' + sheetCols + ' columns. Using column ' + idCol + ' for ID lookup. Looking for ID: ' + id);
    
    // Find the row with this ID
    for (let i = 1; i < lastRow; i++) {
      const rowId = String(sheet.getRange(i + 1, idCol).getValue() || '').trim();
      if (rowId === id) {
        Logger.log('Found row to delete: ' + (i + 1) + ' with ID: ' + rowId);
        sheet.deleteRow(i + 1);
        return { success: true, message: 'Invoice deleted successfully' };
      }
    }
    
    Logger.log('❌ Invoice not found with ID: ' + id);
    // Try searching in column 1 as fallback (in case of mixed column structure)
    Logger.log('📋 Checking fallback search in column 1...');
    for (let i = 1; i < lastRow; i++) {
      const rowId = String(sheet.getRange(i + 1, 1).getValue() || '').trim();
      if (rowId === id) {
        Logger.log('✅ Found in column 1! Deleting row ' + (i + 1));
        sheet.deleteRow(i + 1);
        return { success: true, message: 'Invoice deleted successfully' };
      }
    }
    
    Logger.log('❌ Invoice not found with ID: ' + id + ' in either column 1 or column 2');
    return { success: false, error: 'Invoice not found with ID: ' + id };
  } catch (error) {
    Logger.log('Error deleting invoice: ' + error.toString());
    return {
      success: false,
      error: error.toString()
    };
  }
}

/**
 * Generate unique ID
 */
function generateId(prefix) {
  const timestamp = Date.now();
  const random = Math.floor(Math.random() * 10000);
  return prefix + '-' + timestamp.toString().slice(-8) + '-' + random;
}

/**
 * Generate next invoice/estimate number (auto-numbering)
 */
function generateNextDocumentNumber_(type) {
  const normalizedType = String(type || 'Estimate').trim();
  const isInvoice = normalizedType === 'Invoice' || normalizedType === 'Snow Removal';
  const prefix = isInvoice ? INVOICE_PREFIX : ESTIMATE_PREFIX;
  const year = new Date().getFullYear();
  const yearPrefix = prefix + '-' + year + '-';

  try {
    const spreadsheet = SpreadsheetApp.openById(SPREADSHEET_ID);
    const sheet = spreadsheet.getSheetByName(INVOICES_ESTIMATES_SHEET);

    if (!sheet || sheet.getLastRow() < 2) {
      return yearPrefix + '001';
    }

    enforce8ColumnStructure(sheet);
    ensureInvoicesEstimatesNineColumns(sheet);

    const lastRow = sheet.getLastRow();
    let maxNumber = 0;

    for (let rowNum = 2; rowNum <= lastRow; rowNum++) {
      try {
        const jsonPart1 = sheet.getRange(rowNum, 4).getValue() || '';
        const jsonPart2 = sheet.getRange(rowNum, 5).getValue() || '';
        const jsonPart3 = sheet.getRange(rowNum, 6).getValue() || '';
        const jsonStr = concatenateJsonChunks(jsonPart1, jsonPart2, jsonPart3);
        if (!jsonStr || jsonStr.charAt(0) !== '{') continue;

        const jsonData = JSON.parse(jsonStr);
        const number = String(isInvoice ? (jsonData.invoiceNumber || '') : (jsonData.quoteNumber || '')).trim();
        if (!number.startsWith(yearPrefix)) continue;

        const num = parseInt(number.slice(yearPrefix.length), 10);
        if (!isNaN(num) && num > maxNumber) {
          maxNumber = num;
        }
      } catch (e) {
        continue;
      }
    }

    return yearPrefix + String(maxNumber + 1).padStart(3, '0');
  } catch (error) {
    Logger.log('Error generating number: ' + error.toString());
    return yearPrefix + '001';
  }
}

function generateNextNumber(type) {
  return generateNextDocumentNumber_(type);
}

function getNextDocumentNumber(type) {
  try {
    return {
      success: true,
      type: type,
      number: generateNextDocumentNumber_(type)
    };
  } catch (error) {
    return {
      success: false,
      error: error.toString()
    };
  }
}

/**
 * Send invoice/estimate to customer
 */
function sendInvoiceEstimate(data) {
  try {
    // Validate input data
    if (!data) {
      Logger.log('❌ sendInvoiceEstimate called with null/undefined data');
      return { success: false, error: 'No data provided' };
    }
    
    if (!data.customerEmail || !data.customerName) {
      Logger.log('❌ Missing required customer information');
      return { success: false, error: 'Customer email and name are required' };
    }
    
    const normalizedDocType = normalizeInvoiceEstimateType(data.type);
    const isEstimateDoc = normalizedDocType === 'Estimate';
    const isInvoiceDoc = normalizedDocType === 'Invoice';
    const deferEmailSend = data && data.deferEmailSend === true;

    Logger.log('📧 Sending invoice/estimate for: ' + data.customerName + ' (' + data.customerEmail + ')');
    Logger.log('📎 Attachments count: ' + (data.attachments ? data.attachments.length : 0));
    Logger.log('📄 Normalized document type: ' + normalizedDocType + ' (raw: ' + (data.type || 'undefined') + ')');
    
    // Save first
    const saveResult = saveInvoiceEstimate(data);
    if (!saveResult.success) {
      return saveResult;
    }
    
    const id = saveResult.id;
    
    // Validate that we have an approval token for estimates
    Logger.log('💾 saveInvoiceEstimate returned:');
    Logger.log('   - id: ' + saveResult.id);
    Logger.log('   - approvalToken: ' + (saveResult.approvalToken ? saveResult.approvalToken.substring(0, 20) + '...' : 'NULL/UNDEFINED'));
    Logger.log('   - type: ' + data.type);
    
    if (isEstimateDoc && !saveResult.approvalToken) {
      Logger.log('⚠️ WARNING: Estimate saved but approvalToken is missing!');
    }
    
    // Share link: estimate + token -> Netlify estimate viewer; else invoice-viewer
    const shareLink = getCustomerViewerWebflowUrl(data.type, id, saveResult.approvalToken);
    Logger.log('📎 Generated shareLink: ' + shareLink);
    
    // Update share link in JSON (Column 3) - DO NOT CREATE EXTRA COLUMNS
    const spreadsheet = SpreadsheetApp.openById(SPREADSHEET_ID);
    
    // NOTE: Token already saved by saveInvoiceEstimate via upsertPMApprovalToken_ with multi-year expiry
    // No need to save it again here
    let sheet = spreadsheet.getSheetByName(INVOICES_ESTIMATES_SHEET);
    if (sheet) {
      // ENFORCE 6 COLUMNS FIRST
      enforce8ColumnStructure(sheet);
      
      const lastRow = sheet.getLastRow();
      if (lastRow < 2) {
        Logger.log('⚠️ Invoices sheet is empty');
      } else {
        // Use current 9-column structure with legacy fallback
        for (let rowNum = 2; rowNum <= lastRow; rowNum++) {
          const rowIdCol2 = String(sheet.getRange(rowNum, 2).getValue() || '').trim();
          const rowIdCol1Legacy = String(sheet.getRange(rowNum, 1).getValue() || '').trim();
          if (rowIdCol2 === String(id).trim() || rowIdCol1Legacy === String(id).trim()) {
            // Read JSON from Columns 4-6 (legacy fallback handled by concatenation)
            try {
              const jsonPart1 = sheet.getRange(rowNum, 4).getValue() || '';
              const jsonPart2 = sheet.getRange(rowNum, 5).getValue() || '';
              const jsonPart3 = sheet.getRange(rowNum, 6).getValue() || '';
              let jsonStr = concatenateJsonChunks(jsonPart1, jsonPart2, jsonPart3);
              if (!jsonStr || jsonStr.length === 0) {
                jsonStr = String(jsonPart1 || '').trim();
              }
              if (jsonStr && jsonStr.startsWith('{')) {
                const jsonData = JSON.parse(jsonStr);
                jsonData.shareLink = shareLink; // Update share link in JSON
                // Write back to columns 4, 5, 6 (split if needed)
                const updatedJsonStr = JSON.stringify(jsonData);
                const updatedChunks = splitJsonString(updatedJsonStr);
                sheet.getRange(rowNum, 4, 1, 3).setValues([[updatedChunks[0] || '', updatedChunks[1] || '', updatedChunks[2] || '']]);
                SpreadsheetApp.flush();
              }
            } catch (e) {
              Logger.log('Error updating share link in JSON: ' + e.toString());
            }
            
            // ENFORCE 6 COLUMNS after update
            enforce8ColumnStructure(sheet);
            SpreadsheetApp.flush();
            break;
          }
        }
      }
      
      // Final enforcement check before leaving function
      enforce8ColumnStructure(sheet);
      SpreadsheetApp.flush();
    }

    // Optional deferred mode: return quickly and process email/PDF in background trigger.
    // This avoids upstream proxy timeouts for long PDF + email operations.
    if (deferEmailSend) {
      try {
        const queueResult = enqueueDeferredInvoiceSend_({
          id: id,
          data: Object.assign({}, data, {
            id: id,
            deferEmailSend: false // ensure worker runs full send path
          }),
          createdAt: new Date().toISOString()
        });
        if (!queueResult.success) {
          Logger.log('❌ Failed to enqueue deferred invoice send: ' + (queueResult.error || 'Unknown error'));
          return { success: false, error: queueResult.error || 'Failed to enqueue deferred send', emailSent: false, errorType: 'queue' };
        }
        Logger.log('✅ Deferred invoice send queued: ' + queueResult.queueKey);
        return {
          success: true,
          id: id,
          shareLink: shareLink,
          approvalToken: saveResult.approvalToken || '',
          pdfUrl: '',
          paymentLink: '',
          status: data.status || 'Sent',
          emailSent: true,
          emailQueued: true,
          queueKey: queueResult.queueKey,
          triggerReady: queueResult.triggerReady === true
        };
      } catch (queueErr) {
        Logger.log('❌ Deferred send queue error: ' + queueErr.toString());
        return { success: false, error: 'Deferred send queue failed: ' + queueErr.toString(), emailSent: false, errorType: 'queue' };
      }
    }
    
    // Generate PDF and save to Drive (Invoices only).
    // Estimates use web viewer link and are countersigned later, so skip heavy PDF work now.
    let pdfUrl = null;
    if (isInvoiceDoc) {
      try {
        pdfUrl = generateAndSavePDF(id, data);
        Logger.log('✅ PDF saved to Drive: ' + pdfUrl);
      } catch (pdfError) {
        Logger.log('❌ Error generating PDF to Drive: ' + pdfError.toString());
        return { success: false, error: 'Failed to generate PDF: ' + pdfError.toString() };
      }
    } else {
      Logger.log('📋 Estimate send: skipping immediate PDF generation for faster send');
    }
    
    // Generate PDF blob for email attachment (invoices only - estimates use web viewer).
    // Skip ALL PDF work for estimates to keep send fast.
    let pdfBlob = null;
    const isEstimateEmail = isEstimateDoc;
    
    if (isEstimateEmail) {
      Logger.log('📋 Estimate sending - Skipping PDF entirely. Web viewer link will be used.');
    } else {
      try {
        if (pdfUrl) {
          let fileId = null;
          const driveMatch = String(pdfUrl).match(/\/d\/([a-zA-Z0-9_-]+)/);
          if (driveMatch) {
            fileId = driveMatch[1];
          } else {
            const idMatch = String(pdfUrl).match(/[a-zA-Z0-9_-]{25,}/);
            if (idMatch) fileId = idMatch[0];
          }
          if (fileId) {
            pdfBlob = DriveApp.getFileById(fileId).getBlob();
            pdfBlob.setName(`${normalizedDocType}_${data.quoteNumber || data.invoiceNumber || id}.pdf`);
            Logger.log('✅ PDF blob prepared for email attachment');
          }
        }
        // Fallback: if Drive URL parsing fails or URL is empty, build PDF blob directly
        if (!pdfBlob) {
          Logger.log('⚠️ PDF blob not available from Drive URL, attempting direct PDF blob generation fallback');
          const fallbackPdf = generatePDFBlob(id, data);
          if (fallbackPdf) {
            fallbackPdf.setName(`${normalizedDocType}_${data.quoteNumber || data.invoiceNumber || id}.pdf`);
            pdfBlob = fallbackPdf;
            Logger.log('✅ Fallback PDF blob generated successfully');
          }
        }
      } catch (blobError) {
        Logger.log('❌ Error preparing PDF blob for email: ' + blobError.toString());
        try {
          const fallbackPdf = generatePDFBlob(id, data);
          if (fallbackPdf) {
            fallbackPdf.setName(`${normalizedDocType}_${data.quoteNumber || data.invoiceNumber || id}.pdf`);
            pdfBlob = fallbackPdf;
            Logger.log('✅ Fallback PDF blob generated after blob error');
          }
        } catch (fallbackErr) {
          Logger.log('❌ Fallback PDF generation also failed: ' + fallbackErr.toString());
        }
      }
      if (!pdfBlob) {
        Logger.log('⚠️ Invoice PDF could not be prepared, but continuing with payment link');
      }
    }
    
    // Handle cash payment or create Stripe payment link
    let paymentLink = '';
    let invoiceStatus = data.status || 'Draft';
    
    if (isInvoiceDoc) {
      // Calculate invoice total (exclude processing fee line items from subtotal)
      const items = JSON.parse(data.items || '[]');
      const regularItems = items.filter(function(item) { return !item.isProcessingFee; });
      const subtotal = regularItems.reduce((sum, item) => sum + (parseFloat(item.quantity || 0) * parseFloat(item.price || 0)), 0);
      const taxRate = parseFloat(data.taxRate || 0);
      const taxAmount = subtotal * (taxRate / 100);
      const discount = parseFloat(data.discount || 0);
      
      // Processing fee: use stored line item if present, else calculate when addProcessingFee
      let processingFee = 0;
      const feeItems = items.filter(function(item) { return item.isProcessingFee; });
      if (feeItems.length > 0) {
        processingFee = feeItems.reduce((sum, item) => sum + (parseFloat(item.quantity || 0) * parseFloat(item.price || 0)), 0);
      } else if (data.addProcessingFee) {
        const baseTotal = subtotal + taxAmount - discount;
        processingFee = (baseTotal * STRIPE_PROCESSING_FEE_RATE) + STRIPE_PROCESSING_FEE_FIXED;
      }
      
      const total = subtotal + taxAmount - discount + processingFee;

      // Deposit mode: charge only the deposit amount via Stripe, not the full total
      const depositModeActive = data.depositMode === true || String(data.depositMode || '').toLowerCase() === 'true';
      const depositAmount = depositModeActive && data.depositAmount != null
        ? parseFloat(data.depositAmount || 0)
        : null;
      // Amount Stripe will charge = deposit (if set) or full total
      const stripeChargeAmount = (depositModeActive && depositAmount != null && depositAmount > 0)
        ? depositAmount
        : total;
      Logger.log('💰 Deposit mode: ' + depositModeActive + ', depositAmount: ' + (depositAmount != null ? '$' + depositAmount.toFixed(2) : 'N/A') + ', stripeChargeAmount: $' + stripeChargeAmount.toFixed(2));

      // Check if cash payment was received
      if (data.cashPayment && data.cashPayment.received && data.cashPayment.amount > 0) {
        // Record cash payment to Payment History
        const cashAmount = parseFloat(data.cashPayment.amount);
        const cashNotes = data.cashPayment.notes || 'Cash payment received';
        
        try {
          var ph = recordPaymentHistoryUnified(
            id,
            cashAmount,
            'CASH-' + new Date().getTime(),
            'Cash',
            data.companyId || 'CMP-AQUALITYPOOL',
            new Date(),
            data.customerEmail || '',
            `Cash payment for Invoice ${data.invoiceNumber || id} - ${data.customerName || ''}`,
            0,
            cashNotes
          );
          if (!ph.success && !ph.duplicate) {
            Logger.log('Cash payment history record failed: ' + (ph.error || ph.message));
          }
          
          Logger.log('✅ Cash payment recorded: $' + cashAmount.toFixed(2));
          
          // Check if fully paid
          if (cashAmount >= total - 0.01) {
            invoiceStatus = 'Paid';
            Logger.log('✅ Invoice marked as PAID (cash payment)');
          } else {
            invoiceStatus = 'Partial';
            Logger.log('⚠️ Partial cash payment: $' + cashAmount.toFixed(2) + ' of $' + total.toFixed(2));
          }
        } catch (error) {
          Logger.log('❌ Error recording cash payment: ' + error.toString());
        }
        
        // No payment link needed for cash payments
        paymentLink = '';
        
      } else {
        // Create Stripe invoice and payment link for unpaid invoices
        try {
          // Create duplicate Stripe invoice for internal tracking (not sent to customer)
          const duplicateInvoiceData = {
            invoiceId: id,
            amount: total,
            baseAmount: subtotal + taxAmount - discount,
            processingFee: processingFee,
            customerEmail: data.customerEmail,
            customerName: data.customerName || '',
            customerAddress: data.customerAddress || '',
            invoiceNumber: data.invoiceNumber || id,
            items: data.items || '[]'
          };
          
          const duplicateInvoiceResult = createDuplicateStripeInvoice(duplicateInvoiceData);
          if (duplicateInvoiceResult.success) {
            Logger.log('✅ Duplicate Stripe invoice created for internal tracking: ' + duplicateInvoiceResult.invoiceId);
            // Store the duplicate invoice ID in the invoice data for later reference
            data.duplicateStripeInvoiceId = duplicateInvoiceResult.invoiceId;
            
            // Update the saved invoice JSON to include the duplicate invoice ID
            try {
              const spreadsheet = SpreadsheetApp.openById(SPREADSHEET_ID);
              const sheet = spreadsheet.getSheetByName(INVOICES_ESTIMATES_SHEET);
              if (sheet) {
                enforce8ColumnStructure(sheet);
                const lastRow = sheet.getLastRow();
                const sheetCols = sheet.getLastColumn();
                const is8Column = (sheetCols >= 8);
                const idCol = is8Column ? 2 : 1;
                const json1Col = is8Column ? 4 : 3;
                const json2Col = is8Column ? 5 : 4;
                const json3Col = is8Column ? 6 : 5;
                
                for (let i = 1; i < lastRow; i++) {
                  const rowId = String(sheet.getRange(i + 1, idCol).getValue() || '').trim();
                  if (rowId === String(id).trim()) {
                    const jsonPart1 = sheet.getRange(i + 1, json1Col).getValue() || '';
                    const jsonPart2 = sheet.getRange(i + 1, json2Col).getValue() || '';
                    const jsonPart3 = sheet.getRange(i + 1, json3Col).getValue() || '';
                    let jsonStr = concatenateJsonChunks(jsonPart1, jsonPart2, jsonPart3);
                    
                    if (!jsonStr || jsonStr.length === 0) {
                      jsonStr = String(jsonPart1 || '').trim();
                    }
                    
                    if (jsonStr && jsonStr.startsWith('{')) {
                      const jsonData = JSON.parse(jsonStr);
                      jsonData.duplicateStripeInvoiceId = duplicateInvoiceResult.invoiceId;
                      const updatedJsonStr = JSON.stringify(jsonData);
                      const updatedChunks = splitJsonString(updatedJsonStr);
                      sheet.getRange(i + 1, json1Col, 1, 3).setValues([[updatedChunks[0] || '', updatedChunks[1] || '', updatedChunks[2] || '']]);
                      SpreadsheetApp.flush();
                      Logger.log('✅ Duplicate Stripe invoice ID saved to invoice JSON');
                    }
                    break;
                  }
                }
              }
            } catch (error) {
              Logger.log('⚠️ Error saving duplicate invoice ID to JSON: ' + error.toString());
            }
          } else {
            Logger.log('⚠️ Failed to create duplicate Stripe invoice: ' + (duplicateInvoiceResult.error || 'Unknown error'));
          }
          
          // Create Stripe invoice if processing fee is enabled, otherwise use checkout session
          if (data.addProcessingFee && processingFee > 0) {
            const invoiceResult = createStripeInvoice({
              invoiceId: id,
              amount: stripeChargeAmount,
              baseAmount: depositModeActive && depositAmount ? depositAmount : (subtotal + taxAmount - discount),
              processingFee: processingFee,
              customerEmail: data.customerEmail,
              customerName: data.customerName || '',
              invoiceNumber: data.invoiceNumber || id
            });
            
            if (invoiceResult.success && invoiceResult.paymentUrl) {
              paymentLink = invoiceResult.paymentUrl;
              Logger.log('✅ Stripe invoice created: ' + paymentLink);
            } else {
              Logger.log('❌ Failed to create Stripe invoice: ' + (invoiceResult.error || 'Unknown error'));
              // Fallback to checkout session
