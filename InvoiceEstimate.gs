    Logger.log('Error finalizing payment schedule: ' + error.toString());
    return { success: false, error: error.toString() };
  }
}

/**
 * Update payment schedule (edit milestones)
 */
function updatePaymentSchedule(paymentScheduleId, milestones, totalAmount) {
  try {
    const spreadsheet = SpreadsheetApp.openById(SPREADSHEET_ID);
    const sheet = spreadsheet.getSheetByName(PAYMENT_SCHEDULES_SHEET);
    
    if (!sheet) {
      return { success: false, error: 'Payment Schedules sheet not found' };
    }
    
    // Check if schedule exists and get status
    const scheduleResult = getPaymentSchedule(paymentScheduleId);
    if (!scheduleResult.success) {
      return scheduleResult;
    }
    
    const schedule = scheduleResult.paymentSchedule;
    
    // Can only edit if status is Draft (not Finalized)
    if (schedule.status === 'Finalized') {
      return { success: false, error: 'Cannot edit finalized payment schedule. Please create a change order instead.' };
    }
    
    // Validate payment schedule
    const validation = validatePaymentSchedule(milestones, totalAmount);
    if (!validation.valid) {
      return { success: false, error: validation.error };
    }
    
    // Update the schedule
    const dataRows = sheet.getDataRange().getValues();
    const headers = dataRows[0];
    const idCol = headers.indexOf('Payment Schedule ID');
    const milestonesCol = headers.indexOf('Payment Milestones JSON');
    const amountCol = headers.indexOf('Total Contract Amount');
    const finalPaymentPercentCol = headers.indexOf('Final Payment Percent');
    const finalPaymentAmountCol = headers.indexOf('Final Payment Amount');
    
    // Find final payment amount
    const finalPayment = milestones.find(m => 
      m.name.toLowerCase().includes('final') || 
      m.milestoneId === 'MIL-FINAL'
    );
    const finalPaymentAmount = finalPayment ? parseFloat(finalPayment.amount) : (totalAmount * 0.03);
    
    for (let i = 1; i < dataRows.length; i++) {
      const row = dataRows[i];
      if (row[idCol] === paymentScheduleId) {
        const rowNum = i + 1;
        sheet.getRange(rowNum, milestonesCol + 1).setValue(JSON.stringify(milestones));
        sheet.getRange(rowNum, amountCol + 1).setValue(totalAmount);
        sheet.getRange(rowNum, finalPaymentPercentCol + 1).setValue(3);
        sheet.getRange(rowNum, finalPaymentAmountCol + 1).setValue(finalPaymentAmount);
        return { success: true, message: 'Payment schedule updated successfully' };
      }
    }
    
    return { success: false, error: 'Payment schedule not found' };
  } catch (error) {
    Logger.log('Error updating payment schedule: ' + error.toString());
    return { success: false, error: error.toString() };
  }
}

/**
 * Auto-generate payment schedule from line items
 * Materials = upfront payment, Labor = milestone payments
 */
function autoGeneratePaymentSchedule(items, totalAmount) {
  try {
    if (!items || items.length === 0) {
      return { success: false, error: 'No items provided' };
    }
    
    // Parse items if they're a string
    let parsedItems = items;
    if (typeof items === 'string') {
      parsedItems = JSON.parse(items);
    }
    
    // Try OpenAI-powered generation first (if API key is available)
    // Check Script Properties first, then fall back to constant
    let openaiKey = PropertiesService.getScriptProperties().getProperty('OPENAI_API_KEY') || OPENAI_API_KEY;
    if (openaiKey) {
      try {
        const aiResult = generatePaymentScheduleWithOpenAI(parsedItems, totalAmount, openaiKey);
        if (aiResult && aiResult.success) {
          return aiResult;
        }
      } catch (aiError) {
        Logger.log('OpenAI generation failed, falling back to rule-based: ' + aiError.toString());
      }
    }
    
    // Fallback to rule-based generation
    
    // Separate materials and labor
    let materialsTotal = 0;
    let laborTotal = 0;
    const materials = [];
    const labor = [];
    
    parsedItems.forEach(item => {
      const amount = (parseFloat(item.quantity || 0) * parseFloat(item.price || 0));
      const category = (item.category || '').toLowerCase();
      const name = (item.name || '').toLowerCase();
      
      // Determine if it's labor or materials
      // Check explicit itemType first, then requiresUpfrontPayment, then category/name
      const itemType = item.itemType || '';
      const requiresUpfront = item.requiresUpfrontPayment === true || itemType === 'material';
      
      // Labor items: category contains "labor", name contains "labor", or category is "labor"
      const isLabor = (itemType === 'labor') ||
                     (!requiresUpfront && (
                       category.includes('labor') || 
                       name.includes('labor') || 
                       category.includes('installation') ||
                       name.includes('installation') ||
                       item.fromLaborSet === true ||
                       (item.unit && item.unit.toLowerCase().includes('hour'))
                     ));
      
      // Materials include: concrete (requires upfront payment), or items marked as materials
      const isMaterial = requiresUpfront || 
                        itemType === 'material' ||
                        category.includes('concrete') ||
                        name.includes('concrete') ||
                        (!isLabor && !category.includes('labor'));
      
      if (isLabor) {
        laborTotal += amount;
        labor.push({ ...item, amount: amount });
      } else if (isMaterial) {
        materialsTotal += amount;
        materials.push({ ...item, amount: amount });
      } else {
        // Default to materials if unclear
        materialsTotal += amount;
        materials.push({ ...item, amount: amount });
      }
    });
    
    const milestones = [];
    let currentPercent = 0;
    
    // Materials = upfront payment (unless 0)
    if (materialsTotal > 0) {
      const materialsPercent = (materialsTotal / totalAmount) * 100;
      // Cap materials at 50% max (to leave room for labor milestones and 3% final)
      const cappedPercent = Math.min(materialsPercent, 50);
      
      milestones.push({
        milestoneId: 'MIL-MATERIALS-' + Date.now(),
        name: 'Materials (Upfront)',
        percent: cappedPercent,
        amount: (totalAmount * cappedPercent) / 100,
        dueTrigger: 'date',
        dueDate: new Date().toISOString().split('T')[0], // Due immediately
        status: 'pending'
      });
      currentPercent += cappedPercent;
    }
    
    // Labor = split into milestones (remaining % minus 3% final)
    const laborPercent = (laborTotal / totalAmount) * 100;
    const availablePercent = 100 - currentPercent - 3; // Reserve 3% for final
    const laborMilestonePercent = Math.min(laborPercent, availablePercent);
    
    if (laborMilestonePercent > 0) {
      // Split labor into 2-3 milestones
      const numMilestones = laborMilestonePercent > 30 ? 3 : 2;
      const percentPerMilestone = laborMilestonePercent / numMilestones;
      
      const phases = ['Excavation', 'Installation', 'Final Inspection'];
      for (let i = 0; i < numMilestones; i++) {
        milestones.push({
          milestoneId: 'MIL-LABOR-' + i + '-' + Date.now(),
          name: phases[i] || 'Labor Milestone ' + (i + 1),
          percent: percentPerMilestone,
          amount: (totalAmount * percentPerMilestone) / 100,
          dueTrigger: 'phase',
          duePhase: phases[i] || 'Installation',
          status: 'pending'
        });
        currentPercent += percentPerMilestone;
      }
    }
    
    // Final payment = 3% (always)
    milestones.push({
      milestoneId: 'MIL-FINAL-' + Date.now(),
      name: 'Final Payment',
      percent: 3,
      amount: (totalAmount * 3) / 100,
      dueTrigger: 'phase',
      duePhase: 'Complete',
      status: 'pending'
    });
    currentPercent += 3;
    
    // If we have leftover percent, add to materials milestone
    if (currentPercent < 100 && milestones.length > 0) {
      const diff = 100 - currentPercent;
      milestones[0].percent += diff;
      milestones[0].amount = (totalAmount * milestones[0].percent) / 100;
    }
    
    return {
      success: true,
      milestones: milestones,
      summary: {
        materialsTotal: materialsTotal,
        laborTotal: laborTotal,
        materialsCount: materials.length,
        laborCount: labor.length
      }
    };
  } catch (error) {
    Logger.log('Error auto-generating payment schedule: ' + error.toString());
    return { success: false, error: error.toString() };
  }
}

/**
 * Generate payment schedule using OpenAI GPT-4
 */
function generatePaymentScheduleWithOpenAI(items, totalAmount, apiKey) {
  try {
    // Build context about the project
    const projectSummary = items.map(item => {
      return `${item.name || 'Item'}: ${item.quantity || 0} ${item.unit || 'each'} @ $${item.price || 0} = $${(parseFloat(item.quantity || 0) * parseFloat(item.price || 0)).toFixed(2)} (${item.category || 'Other'})`;
    }).join('\n');
    
    const systemPrompt = `You are an expert pool construction payment schedule advisor. Create optimized payment schedules for pool installation projects.

Key Rules:
- Total must equal 100%
- Final payment must be exactly 3%
- Payments align with pool construction phases
- Materials typically require upfront payment
- Labor is split across installation phases

Pool Installation Phases:
1. Deposit (30-40%)
2. Excavation & Site Prep (7-10%)
3. Wall System Installation (10-15%)
4. Concrete Collar (4-6%)
5. Plumbing & Equipment Pad (8-12%)
6. Pool Bottom (5-7%)
7. Backfill + Liner Installation (9-12%)
8. Electrical Hookup (1-3%)
9. Stamped Concrete Materials (5-7%)
10. Stamped Concrete Labor (9-12%)
11. Final Payment (whatever percentage is needed to reach 100%)

Return ONLY a valid JSON array of milestones.`;

    const userPrompt = `Project Total: $${totalAmount.toFixed(2)}

Project Items:
${projectSummary}

Create an optimized payment schedule. Return JSON array only.`;

    const requestBody = {
      model: 'gpt-4o-mini',
      messages: [
        { role: 'system', content: systemPrompt },
        { role: 'user', content: userPrompt }
      ],
      temperature: 0.3,
      max_tokens: 2000
    };
    
    const options = {
      method: 'post',
      headers: {
        'Content-Type': 'application/json',
        'Authorization': 'Bearer ' + apiKey
      },
      payload: JSON.stringify(requestBody),
      muteHttpExceptions: true
    };
    
    const response = UrlFetchApp.fetch(OPENAI_API_URL, options);
    const responseCode = response.getResponseCode();
    
    if (responseCode === 200) {
      const result = JSON.parse(response.getContentText());
      if (result.choices && result.choices.length > 0) {
        const content = result.choices[0].message.content;
        let milestonesData = JSON.parse(content);
        if (!Array.isArray(milestonesData)) milestonesData = [milestonesData];
        
        const milestones = milestonesData.map((m, index) => ({
          milestoneId: 'MIL-AI-' + index + '-' + Date.now(),
          name: m.name || 'Payment ' + (index + 1),
          percent: parseFloat(m.percent) || 0,
          amount: parseFloat(m.amount) || (totalAmount * parseFloat(m.percent || 0) / 100),
          dueTrigger: m.dueTrigger || 'phase',
          duePhase: m.duePhase || ''
        }));
        
        // Ensure final payment is 3%
        const finalPayment = milestones.find(m => m.name.toLowerCase().includes('final'));
        if (finalPayment) {
          finalPayment.percent = 3;
          finalPayment.amount = (totalAmount * 3) / 100;
        }
        
        return {
          success: true,
          milestones: milestones,
          summary: { aiGenerated: true }
        };
      }
    }
    
    return { success: false, error: 'AI generation failed' };
  } catch (error) {
    Logger.log('OpenAI error: ' + error.toString());
    return { success: false, error: error.toString() };
  }
}

/**
 * Update payment milestone status
 */
function updatePaymentMilestoneStatus(paymentScheduleId, milestoneId, status, transactionId, paidDate) {
  try {
    const scheduleResult = getPaymentSchedule(paymentScheduleId);
    if (!scheduleResult.success) {
      return scheduleResult;
    }
    
    const schedule = scheduleResult.paymentSchedule;
    const milestones = schedule.milestones;
    
    // Find and update milestone
    const milestone = milestones.find(m => m.milestoneId === milestoneId);
    if (!milestone) {
      return { success: false, error: 'Milestone not found' };
    }
    
    milestone.status = status;
    if (transactionId) milestone.transactionId = transactionId;
    if (paidDate) milestone.paidDate = paidDate;
    
    // Update in sheet
    const spreadsheet = SpreadsheetApp.openById(SPREADSHEET_ID);
    const sheet = spreadsheet.getSheetByName(PAYMENT_SCHEDULES_SHEET);
    const dataRows = sheet.getDataRange().getValues();
    const headers = dataRows[0];
    const idCol = headers.indexOf('Payment Schedule ID');
    const milestonesCol = headers.indexOf('Payment Milestones JSON');
    
    for (let i = 1; i < dataRows.length; i++) {
      const row = dataRows[i];
      if (row[idCol] === paymentScheduleId) {
        sheet.getRange(i + 1, milestonesCol + 1).setValue(JSON.stringify(milestones));
        return { success: true, message: 'Milestone status updated' };
      }
    }
    
    return { success: false, error: 'Payment schedule not found' };
  } catch (error) {
    Logger.log('Error updating milestone status: ' + error.toString());
    return { success: false, error: error.toString() };
  }
}

