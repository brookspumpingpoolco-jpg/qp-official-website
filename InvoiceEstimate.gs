      + (draftText ? '<hr style="border:none;border-top:1px solid #ddd;margin:20px 0;"><p><strong>Suggested Message:</strong></p><pre style="background:#f5f5f5;padding:12px;border-radius:4px;overflow-x:auto;">' + escapeHtml(draftText) + '</pre>' : '')
      + '</body></html>';
    
    try {
      sendInternalNotificationEmail_(
        BROOKS_EMAIL,
        emailSubject,
        docType + ' ready for ' + custName + '. View: ' + viewLink,
        emailHtml
      );
      Logger.log('✅ Email sent to ' + BROOKS_EMAIL);
      emailSent = true;
    } catch(emailErr) {
      Logger.log('⚠️ Email sending failed: ' + emailErr.toString());
    }
    
    // === SEND TELEGRAM MESSAGE ===
    try {
      Logger.log('� ENTERING TELEGRAM SEND SECTION');
      Logger.log('🔗 viewLink for draft text: ' + viewLink);
      var previewText = buildBrooksTelegramDraftText_(viewLink, documentId, docType, custName, custPhone, draftText);
      Logger.log('📝 Draft text built: ' + previewText);
      
      // Build link to web app's SMS handler (like sms: links but works in Telegram buttons)
      var draftUrl = '';
      if (custPhone) {
        var webAppUrl = ScriptApp.getService().getUrl();
        draftUrl = webAppUrl + '?action=sms&phone=' + encodeURIComponent(custPhone) + '&body=' + encodeURIComponent(previewText) + '&name=' + encodeURIComponent(custName);
        Logger.log('📱 Draft URL built. Web app will show the draft text in preview');
      }
      
      // Build Telegram HTML with suggested customer text
      var telegramHtml =
        '<b>📱 ' + escapeHtml(docType) + ' ready</b>' + (custName ? ' - <b>' + escapeHtml(custName) + '</b>' : '') + '\n' +
        (documentId ? '<b>ID:</b> ' + escapeHtml(documentId) + '\n' : '') +
        (custPhone ? '<b>Phone:</b> ' + escapeHtml(custPhone) + '\n' : '') +
        '\n<b>Suggested customer text:</b>\n<pre>' + escapeHtml(previewText) + '</pre>';
      
      Logger.log('📧 Telegram HTML:\n' + telegramHtml);
      
      var telegramButtons = [];
      if (draftUrl) {
        telegramButtons.push({ text: '💬 Open Draft Text', url: draftUrl });
      }
      telegramButtons.push({ text: '🔗 View ' + docType, url: viewLink });
      
      Logger.log('🚀 ABOUT TO CALL sendTelegramBotMessage_ with ' + telegramButtons.length + ' buttons');
      Logger.log('🤖 Sending Telegram message with ' + telegramButtons.length + ' button(s): ' + JSON.stringify(telegramButtons));
      var telegramResult = sendTelegramBotMessage_(telegramHtml, telegramButtons);
      if (telegramResult && telegramResult.success) {
        Logger.log('✅ Telegram message sent with draft text button (web app SMS handler)');
        telegramSent = true;
      } else {
        telegramError = (telegramResult && telegramResult.error ? telegramResult.error : 'Unknown error');
        Logger.log('⚠️ Telegram sending failed: ' + telegramError);
      }
    } catch(telegramErr) {
      telegramError = telegramErr.toString();
      Logger.log('⚠️ Telegram sending error: ' + telegramErr.toString());
      Logger.log('Stack: ' + telegramErr.stack);
    }
    
    Logger.log('✅ Brooks notification complete (email + Telegram attempted)');
    return {
      success: telegramSent,
      emailSent: emailSent,
      telegramSent: telegramSent,
      error: telegramSent ? '' : ('Telegram failed' + (telegramError ? ': ' + telegramError : '')),
      message: telegramSent
        ? 'Notification sent to Brooks via email and Telegram'
        : 'Email sent, but Telegram failed'
    };
  } catch(e) {
    Logger.log('❌ sendBrooksLinkNotification error: ' + e.toString());
    return { success: false, error: e.toString() };
  }
}

/**
 * Approve estimate with signature and send contract
 */
/**
 * Returns estimates where the customer has signed but the company hasn't yet countersigned.
 * Used to drive the "Estimates awaiting your signature" banner in InvoiceEstimateUI.
 */
function getEstimatesAwaitingSignature() {
  try {
    var ss = SpreadsheetApp.openById(SPREADSHEET_ID);
    var sheet = ss.getSheetByName(INVOICES_ESTIMATES_SHEET);
    if (!sheet) return { success: true, estimates: [] };

    var lastRow = sheet.getLastRow();
    if (lastRow < 2) return { success: true, estimates: [] };

    var waiting = [];
    // Current sheet layout:
    // col 1 = Company ID, col 2 = Document ID, col 3 = Customer Email,
    // cols 4-6 = JSON chunks, col 7 = total, col 8 = payment schedule.
    // Read once for performance.
    var rows = sheet.getRange(2, 2, lastRow - 1, 7).getValues();
    for (var i = 0; i < rows.length; i++) {
      try {
        var row = rows[i];
        var rowId = String(row[0] || '').trim(); // col 2
        if (!rowId) continue;
        var j1 = row[2] || ''; // col 4
        var j2 = row[3] || ''; // col 5
        var j3 = row[4] || ''; // col 6
        var js = concatenateJsonChunks(j1, j2, j3);
        if (!js || !js.startsWith('{')) continue;
        var data = JSON.parse(js);
        // Include only Estimates where the customer approved but admin hasn't signed
        var isEstimate = (data.type || '').toLowerCase() === 'estimate';
        var adminSigned = data.adminSigned === true || String(data.adminSigned).toLowerCase() === 'true';
        var customerApproved = data.approvalStatus === 'Approved'
          || data.status === 'Awaiting Company Signature'
          || ((data.signatureUrl || data.signatureData) && !adminSigned);
        var adminNotSigned = !adminSigned;
        if (isEstimate && customerApproved && adminNotSigned) {
          waiting.push({
            id: rowId,
            quoteNumber: data.quoteNumber || data.invoiceNumber || rowId,
            customerName: data.customerName || '',
            customerEmail: data.customerEmail || '',
            customerAddress: data.customerAddress || '',
            total: parseFloat(data.total || 0),
            approvedDate: data.approvedDate || data.approvalDate || '',
            signatureUrl: data.signatureUrl || ''
          });
        }
      } catch(e2) { /* skip bad rows */ }
    }
    waiting.sort(function(a, b) {
      var da = new Date(a.approvedDate || 0).getTime() || 0;
      var db = new Date(b.approvedDate || 0).getTime() || 0;
      return db - da;
    });
    return { success: true, estimates: waiting };
  } catch(e) {
    Logger.log('getEstimatesAwaitingSignature error: ' + e.toString());
    return { success: false, error: e.toString() };
  }
}

function approveEstimateWithSignature(id, token, signatureDataUrl, customerName, customerEmail, selectedAddOnsJson) {
  try {
    Logger.log('=== approveEstimateWithSignature START ===');
    Logger.log('id: ' + id);
    Logger.log('token: ' + token);
    Logger.log('customerName: ' + customerName);
    Logger.log('hasSignature: ' + (signatureDataUrl ? signatureDataUrl.length : 'none'));

    // First approve the estimate
    const approveResult = approveEstimate(id, token, '');
    Logger.log('approveEstimate result: ' + JSON.stringify(approveResult));
    if (!approveResult.success) {
      return approveResult;
    }
    
    // Get invoice/estimate data
    const invoiceResult = getInvoiceEstimate(id);
    Logger.log('getInvoiceEstimate result success: ' + (invoiceResult ? invoiceResult.success : 'null'));
    if (!invoiceResult.success) {
      return invoiceResult;
    }
    
    const invoice = invoiceResult.data;

    // Apply client-selected optional add-ons (if provided by viewer)
    try {
      let selectedAddOns = [];
      if (selectedAddOnsJson && String(selectedAddOnsJson).trim()) {
        selectedAddOns = JSON.parse(String(selectedAddOnsJson));
      }
      if (!Array.isArray(selectedAddOns)) selectedAddOns = [];

      const selectedAddOnMap = new Map();
      selectedAddOns.forEach(function(addOn, idx) {
        if (!addOn || typeof addOn !== 'object') return;
        const addOnId = String(addOn.clientAddonId || ('addon_' + idx)).trim();
        if (!addOnId) return;
        const normalized = Object.assign({}, addOn, {
          clientAddonId: addOnId,
          isClientOptionalAddon: true,
          customerSelected: true
        });
        selectedAddOnMap.set(addOnId, normalized);
      });

      let baseItems = [];
      try {
        baseItems = invoice.items ? (typeof invoice.items === 'string' ? JSON.parse(invoice.items) : invoice.items) : [];
      } catch (_) {
        baseItems = [];
      }
      if (!Array.isArray(baseItems)) baseItems = [];

      let optionalAddOns = [];
      try {
        optionalAddOns = invoice.optionalAddOns
          ? (typeof invoice.optionalAddOns === 'string' ? JSON.parse(invoice.optionalAddOns) : invoice.optionalAddOns)
          : [];
      } catch (_) {
        optionalAddOns = [];
      }
      if (!Array.isArray(optionalAddOns)) optionalAddOns = [];

      // Legacy fallback: optional add-ons may have been saved in `items` with a flag.
      const optionalFromItems = [];
      const normalizedBaseItems = [];
      baseItems.forEach(function(it) {
        if (it && it.isClientOptionalAddon === true) optionalFromItems.push(it);
        else normalizedBaseItems.push(it);
      });

      const optionalPoolMap = new Map();
      optionalAddOns.concat(optionalFromItems).forEach(function(it, idx) {
        if (!it || typeof it !== 'object') return;
        const addOnId = String(it.clientAddonId || ('addon_legacy_' + idx)).trim();
        if (!addOnId) return;
        optionalPoolMap.set(addOnId, Object.assign({}, it, {
          clientAddonId: addOnId,
          isClientOptionalAddon: true,
          customerSelected: selectedAddOnMap.has(addOnId)
        }));
      });

      // Include any selected add-ons from payload even if they were not previously saved.
      selectedAddOnMap.forEach(function(value, key) {
        if (!optionalPoolMap.has(key)) optionalPoolMap.set(key, value);
      });

      const selectedAddOnItems = [];
      optionalPoolMap.forEach(function(value, key) {
        if (selectedAddOnMap.has(key)) {
          selectedAddOnItems.push(Object.assign({}, value, {
            customerSelected: true,
            isClientOptionalAddon: true,
            clientAddonId: key
          }));
        }
      });

      const mergedItems = normalizedBaseItems.concat(selectedAddOnItems);
      const subtotal = mergedItems
        .filter(function(it) { return !(it && it.isProcessingFee === true); })
        .reduce(function(sum, it) {
          return sum + (parseFloat(it.quantity || 0) * parseFloat(it.price || 0));
        }, 0);
      const taxRate = parseFloat(invoice.taxRate || 0);
      const taxAmount = subtotal * (taxRate / 100);
      const discount = parseFloat(invoice.discount || 0);
      const total = subtotal + taxAmount - discount;

      invoice.items = JSON.stringify(mergedItems);
      invoice.optionalAddOns = JSON.stringify(Array.from(optionalPoolMap.values()));
