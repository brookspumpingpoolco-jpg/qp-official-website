// ========================================
// INVOICE TO PROJECT & BUDGET GENERATION
// ========================================

/**
 * Generate a project and budget sheet from an invoice
 * This creates:
 * 1. A Project in the Projects sheet
 * 2. Project Items in the Project Items sheet (from invoice items)
 * 3. A Budget Sheet entry for tracking
 */
function generateProjectFromInvoice(invoiceId) {
  try {
    const spreadsheet = SpreadsheetApp.openById(SPREADSHEET_ID);
    const invoiceSheet = spreadsheet.getSheetByName(INVOICES_ESTIMATES_SHEET);
    
    if (!invoiceSheet) {
      return { success: false, error: 'Invoices sheet not found' };
    }
    
    // Get invoice data
    const dataRows = invoiceSheet.getDataRange().getValues();
    if (dataRows.length < 2) {
      return { success: false, error: 'No invoices found' };
    }
    
    const headers = dataRows[0];
    const idCol = headers.indexOf('ID');
    const typeCol = headers.indexOf('Type');
    const customerNameCol = headers.indexOf('Customer Name');
    const customerEmailCol = headers.indexOf('Customer Email');
    const customerPhoneCol = headers.indexOf('Customer Phone');
    const customerAddressCol = headers.indexOf('Customer Address');
    const invoiceNumberCol = headers.indexOf('Invoice Number');
    const itemsJsonCol = headers.indexOf('Items JSON');
    const totalCol = headers.indexOf('Total');
    const dateCol = headers.indexOf('Date');
    const notesCol = headers.indexOf('Notes');
    
    // Find invoice
    let invoiceRow = null;
    let invoiceRowIndex = -1;
    for (let i = 1; i < dataRows.length; i++) {
      if (dataRows[i][idCol] === invoiceId) {
        invoiceRow = dataRows[i];
        invoiceRowIndex = i;
        break;
      }
    }
    
    if (!invoiceRow) {
      return { success: false, error: 'Invoice not found' };
    }
    
    // Check if it's an invoice (not estimate)
    if (invoiceRow[typeCol] !== 'Invoice') {
      return { success: false, error: 'Can only generate projects from invoices' };
    }
    
    const customerEmail = invoiceRow[customerEmailCol] || '';
    const customerName = invoiceRow[customerNameCol] || '';
    const invoiceNumber = invoiceRow[invoiceNumberCol] || invoiceId;
    const invoiceTotal = parseFloat(invoiceRow[totalCol]) || 0;
    const invoiceDate = invoiceRow[dateCol] || new Date();
    const invoiceNotes = invoiceRow[notesCol] || '';
    const itemsJson = invoiceRow[itemsJsonCol] || '[]';
    const items = JSON.parse(itemsJson);
    
    // Generate Project ID
    const projectId = 'PROJ-' + invoiceNumber.replace(/[^0-9]/g, '') || 'PROJ-' + Utilities.getUuid().substring(0, 8).toUpperCase();
    
    // 1. Create/Update Project
    let projectsSheet = spreadsheet.getSheetByName(PROJECTS_SHEET_NAME);
    if (!projectsSheet) {
      projectsSheet = spreadsheet.insertSheet(PROJECTS_SHEET_NAME);
      projectsSheet.appendRow(['Project ID', 'Customer Email', 'Customer Name', 'Project Type', 'Status', 'Start Date', 'Estimated Completion Date', 'Current Phase', 'Notes', 'Created Date', 'Last Updated', 'Invoice ID', 'Invoice Number']);
      // Format header
      const headerRange = projectsSheet.getRange(1, 1, 1, 13);
      headerRange.setFontWeight('bold');
      headerRange.setBackground('#1a1a1a');
      headerRange.setFontColor('#3b82f6');
    }
    
    // Check if project already exists for this invoice
    const projectData = projectsSheet.getDataRange().getValues();
    const projectHeaders = projectData[0];
    const projectIdCol = projectHeaders.indexOf('Project ID');
    const invoiceIdCol = projectHeaders.indexOf('Invoice ID');
    
    let projectExists = false;
    let projectRowIndex = -1;
    for (let i = 1; i < projectData.length; i++) {
      if (projectData[i][invoiceIdCol] === invoiceId) {
        projectExists = true;
        projectRowIndex = i + 1;
        break;
      }
    }
    
    const now = new Date();
    const projectRow = [
      projectId,
      customerEmail,
      customerName,
      'Pool Build', // Default, can be changed
      'Planning',
      invoiceDate,
      '', // Estimated completion - can be set later
      'Project created from invoice',
      invoiceNotes || 'Generated from invoice ' + invoiceNumber,
      now,
      now,
      invoiceId,
      invoiceNumber
    ];
    
    if (projectExists) {
      projectsSheet.getRange(projectRowIndex, 1, 1, projectRow.length).setValues([projectRow]);
    } else {
      projectsSheet.appendRow(projectRow);
    }
    
    // 2. Create Project Items from Invoice Items
    let itemsSheet = spreadsheet.getSheetByName(PROJECT_ITEMS_SHEET_NAME);
    if (!itemsSheet) {
      itemsSheet = spreadsheet.insertSheet(PROJECT_ITEMS_SHEET_NAME);
      itemsSheet.appendRow(['Project ID', 'Item Name', 'Item Description', 'Quantity', 'Unit Price', 'Total Cost', 'Order Date', 'Delivery Date', 'Status', 'Vendor/Supplier', 'Tracking Number', 'Notes', 'Added Date', 'Invoice Item']);
      // Format header
      const headerRange = itemsSheet.getRange(1, 1, 1, 14);
      headerRange.setFontWeight('bold');
      headerRange.setBackground('#1a1a1a');
      headerRange.setFontColor('#3b82f6');
    }
    
    // Add each invoice item as a project item
    const itemsData = itemsSheet.getDataRange().getValues();
    const itemsHeaders = itemsData[0];
    const itemProjectIdCol = itemsHeaders.indexOf('Project ID');
    const itemInvoiceItemCol = itemsHeaders.indexOf('Invoice Item');
    
    // Remove existing items for this project (to avoid duplicates)
    const rowsToDelete = [];
    for (let i = itemsData.length - 1; i >= 1; i--) {
      if (itemsData[i][itemProjectIdCol] === projectId) {
        rowsToDelete.push(i + 1);
      }
    }
    // Delete from bottom to top to maintain indices
    for (let i = rowsToDelete.length - 1; i >= 0; i--) {
      itemsSheet.deleteRow(rowsToDelete[i]);
    }
    
    // Add new items
    items.forEach((item, index) => {
      const itemRow = [
        projectId,
        item.description || item.name || 'Item ' + (index + 1),
        item.description || '',
        parseFloat(item.quantity || 1),
        parseFloat(item.price || item.unitPrice || 0),
        parseFloat(item.quantity || 1) * parseFloat(item.price || item.unitPrice || 0),
        '', // Order Date - to be filled
        '', // Delivery Date - to be filled
        'Ordered', // Status
        '', // Vendor
        '', // Tracking Number
        '', // Notes
        now,
        JSON.stringify(item) // Store original invoice item
      ];
      itemsSheet.appendRow(itemRow);
    });
    
    // 3. Create/Update Budget Sheet
    let budgetSheet = spreadsheet.getSheetByName(BUDGET_SHEET_NAME);
    if (!budgetSheet) {
      budgetSheet = spreadsheet.insertSheet(BUDGET_SHEET_NAME);
      budgetSheet.appendRow([
        'Project ID', 'Invoice ID', 'Invoice Number', 'Customer Email', 'Customer Name',
        'Item Name', 'Item Description', 'Quantity', 'Budgeted Amount', 'Actual Cost',
        'Status', 'Order Date', 'Delivery Date', 'Tracking Number', 'Vendor',
        'Notes', 'Created Date', 'Last Updated'
      ]);
      // Format header
      const headerRange = budgetSheet.getRange(1, 1, 1, 18);
      headerRange.setFontWeight('bold');
      headerRange.setBackground('#1a1a1a');
      headerRange.setFontColor('#3b82f6');
      headerRange.setFontSize(11);
    }
    
    // Check if budget entry exists
    const budgetData = budgetSheet.getDataRange().getValues();
    const budgetHeaders = budgetData[0];
    const budgetProjectIdCol = budgetHeaders.indexOf('Project ID');
    const budgetInvoiceIdCol = budgetHeaders.indexOf('Invoice ID');
    
    // Remove existing budget entries for this project
    const budgetRowsToDelete = [];
    for (let i = budgetData.length - 1; i >= 1; i--) {
      if (budgetData[i][budgetInvoiceIdCol] === invoiceId) {
        budgetRowsToDelete.push(i + 1);
      }
    }
    for (let i = budgetRowsToDelete.length - 1; i >= 0; i--) {
      budgetSheet.deleteRow(budgetRowsToDelete[i]);
    }
    
    // Add budget entries for each item
    items.forEach((item, index) => {
      const budgetedAmount = parseFloat(item.quantity || 1) * parseFloat(item.price || item.unitPrice || 0);
      const budgetRow = [
        projectId,
        invoiceId,
        invoiceNumber,
        customerEmail,
        customerName,
        item.description || item.name || 'Item ' + (index + 1),
        item.description || '',
        parseFloat(item.quantity || 1),
        budgetedAmount,
        0, // Actual Cost - starts at 0
        'Ordered',
        '', // Order Date
        '', // Delivery Date
        '', // Tracking Number
        '', // Vendor
        '', // Notes
        now,
        now
      ];
      budgetSheet.appendRow(budgetRow);
    });
    
    return {
      success: true,
      projectId: projectId,
      message: 'Project and budget sheet created successfully',
      itemsCount: items.length
    };
    
  } catch (error) {
    Logger.log('Error generating project from invoice: ' + error.toString());
    return {
      success: false,
      error: error.toString()
    };
  }
}

