    var projectData = proj.project || proj.projectData || {};
    var linkedId = projectData.estimateId || projectData.invoiceId || projectData.linkedEstimateId || '';
    var breakdown = getProjectBalanceBreakdown(projectId, linkedId);
    if (!breakdown || !breakdown.success) {
      return { success: false, error: (breakdown && breakdown.error) ? breakdown.error : 'Unable to verify project balance' };
    }

    var openIssues = [];
    try {
      if (openIssuesJson) openIssues = JSON.parse(openIssuesJson);
    } catch (e) {}
    var photoUrls = [];
    try {
      if (photoUrlsJson) photoUrls = JSON.parse(photoUrlsJson);
    } catch (e) {}
    photoUrls = photoUrls || [];
    if ((!photoUrls || photoUrls.length === 0) && projectData) {
      var pd = projectData;
      if (pd.photos && Array.isArray(pd.photos)) photoUrls = pd.photos.slice();
      if (pd.invoicePhotos && Array.isArray(pd.invoicePhotos)) {
        photoUrls = photoUrls.concat(pd.invoicePhotos);
      }
    }
    var pdForDrive = projectData || {};
    if ((includeDrivePhotos === true) && photoUrls.length === 0 && pdForDrive.customerName) {
      try {
        var drivePhotos = searchCustomerPhotosInDriveFolder_(pdForDrive.customerName);
        if (drivePhotos && drivePhotos.length) photoUrls = drivePhotos;
      } catch (e) { /* ignore */ }
    }
    var custName = (projectData && projectData.customerName) ? projectData.customerName : 'Customer';
    var summary = String(summaryMessage || '').trim();
    var withReview = askReview === true;
    var unpaidMilestones = getUnpaidCloseoutMilestones_(projectData, breakdown);

    // If a consolidated final closeout invoice exists, prefer surfacing that link in drafts
    // so SMS/Telegram includes one clear payment path.
    var finalInvoice = getLatestFinalCloseoutInvoiceForProject_(projectId);
    if (finalInvoice && money2_(breakdown.totalOwed || 0) > 0.01) {
      unpaidMilestones = unpaidMilestones || [];
      var hasFinal = unpaidMilestones.some(function(m) {
        return String((m && m.id) || '').trim() === String(finalInvoice.id || '').trim();
      });
      if (!hasFinal) {
        unpaidMilestones.unshift({
          id: finalInvoice.id,
          name: 'Final Closeout Invoice',
          owed: money2_(breakdown.totalOwed || finalInvoice.total || 0),
          amount: money2_(breakdown.totalOwed || finalInvoice.total || 0),
          link: String(finalInvoice.paymentLink || finalInvoice.viewerLink || '').trim()
        });
      }
    }
    var html = generateProjectCloseoutEmailHtml(projectId, openIssues, photoUrls, custName, 'A Quality Pool Company', {
      summaryMessage: summary,
      askReview: withReview,
      reviewLinks: getCloseoutReviewLinks_(),
      balanceDue: money2_(breakdown.totalOwed || 0),
      unpaidMilestones: unpaidMilestones,
      mailingAddress: '111 Vescio Drive Richmond KY 40475'
    });
    return {
      success: true,
      html: html,
      openIssues: openIssues,
      photoUrls: photoUrls,
      customerName: custName,
      summaryMessage: summary,
      askReview: withReview,
      balanceDue: money2_(breakdown.totalOwed || 0),
      unpaidMilestones: unpaidMilestones,
      projectData: projectData,
      totalPaid: money2_(breakdown.totalPaid || 0),
      totalContract: money2_(breakdown.totalContract || 0)
    };
  } catch (e) {
    return { success: false, error: e.toString() };
  }
}

function closeProject(projectId, openIssuesJson, photoUrlsJson, sendEmail, notes, summaryMessage, askReview, sendTelegram, includeDrivePhotos) {
  try {
    var closeoutNotes = String(notes || '').trim();
    var summary = String(summaryMessage || '').trim();
    var withReview = askReview === true;
    var reviewPrompt = getCloseoutReviewPrompt_();
    var shouldTelegram = sendTelegram === true;
    var preview = getProjectCloseoutPreview(projectId, openIssuesJson, photoUrlsJson, summary, withReview, includeDrivePhotos === true);
    if (!preview.success) return preview;
    var openIssues = preview.openIssues || [];
    var photoUrls = preview.photoUrls || [];
    var tasksQueued = 0;
    var projectData = preview.projectData || {};
    var companyIdForTasks = 'CMP-AQUALITYPOOL';
    try {
      if (typeof resolveCompanyIdForTasks_ === 'function') {
        companyIdForTasks = resolveCompanyIdForTasks_(projectData.customerEmail || '', projectData.companyId || '') || 'CMP-AQUALITYPOOL';
      } else if (projectData.companyId) {
        companyIdForTasks = String(projectData.companyId);
      }
    } catch (cidErr) {
      Logger.log('closeProject company resolution warning: ' + cidErr.toString());
    }

    for (var i = 0; i < openIssues.length; i++) {
      var o = openIssues[i];
      var title = String(o.title || o || 'Follow-up').trim();
      var issueNotes = String(o.notes || '').trim();
      var t = null;
      if (typeof addPmTask === 'function') {
        t = addPmTask(companyIdForTasks, {
          title: title,
          projectId: String(projectId || ''),
          customerName: String(projectData.customerName || ''),
          customerEmail: String(projectData.customerEmail || ''),
          priority: 'Normal',
          notes: issueNotes,
          linkType: 'Project',
          linkId: String(projectId || '')
        });
      } else if (typeof addPmTaskLocal_ === 'function') {
        t = addPmTaskLocal_(projectId, title, issueNotes, 'normal', 'open');
      }
      if (t && t.success) tasksQueued++;
    }

    var spreadsheet = SpreadsheetApp.openById(SPREADSHEET_ID);
    var pmSheetName = (typeof PM_PROJECTS_SHEET !== 'undefined' && PM_PROJECTS_SHEET)
      ? PM_PROJECTS_SHEET
      : 'PM_Projects';
    var sheet = spreadsheet.getSheetByName(pmSheetName);
    if (!sheet) return { success: false, error: 'PM_Projects sheet not found' };
    var headers = sheet.getRange(1, 1, 1, sheet.getLastColumn()).getValues()[0];
    var idCol = headers.indexOf('Project ID') + 1;
    if (idCol <= 0) idCol = 2; // PM_Projects default Project ID column (B)
    var statusCol = 7; // Column G in PM_Projects
    var notesCol = headers.indexOf('Notes') + 1;
    var row = -1;
    for (var r = 2; r <= sheet.getLastRow(); r++) {
      if (String(sheet.getRange(r, idCol).getValue() || '').trim() === String(projectId).trim()) {
        row = r;
        break;
      }
    }
    if (row < 2) return { success: false, error: 'Project not found' };
    if (statusCol > 0) sheet.getRange(row, statusCol).setValue('Completed');
    if (notesCol > 0) {
      var prev = String(sheet.getRange(row, notesCol).getValue() || '');
      var closeNote = (closeoutNotes ? closeoutNotes + '\n' : '') + '[' + new Date().toISOString() + '] Closed. Follow-ups queued on dashboard: ' + tasksQueued;
      sheet.getRange(row, notesCol).setValue(prev + (prev ? '\n' : '') + closeNote);
    }
    SpreadsheetApp.flush();
    var emailSent = false;
    var telegramSent = false;
    var telegramError = '';
    if (sendEmail) {
      var pd = projectData;
      var email = pd.customerEmail || '';
      if (email) {
        try {
            MailApp.sendEmail({
            to: email,
            subject: 'Your project is complete — ' + projectId + (photoUrls && photoUrls.length ? ' (photos included)' : ''),
            htmlBody: preview.html
          });
          emailSent = true;
        } catch (mailErr) {
          Logger.log('Closeout email failed: ' + mailErr);
        }
      }
    }

    if (shouldTelegram) {
      try {
        var customerPhone = String(projectData.customerPhone || projectData.phone || '').trim();
        var customerName = String(projectData.customerName || preview.customerName || '').trim();
        var closeoutDraftText = buildCloseoutCustomerDraftText_(preview, summary, withReview);
        var closeoutDraftUrl = buildCloseoutDraftUrl_(customerPhone, customerName, closeoutDraftText);
        var teleMsg = '<b>✅ Project closed</b>\n'
          + '<b>Project:</b> ' + escapeTelegramHtml_(String(projectId || '')) + '\n'
          + '<b>Customer:</b> ' + escapeTelegramHtml_(String(projectData.customerName || '')) + '\n'
          + (projectData.customerEmail ? ('<b>Email:</b> ' + escapeTelegramHtml_(String(projectData.customerEmail)) + '\n') : '')
          + (customerPhone ? ('<b>Phone:</b> ' + escapeTelegramHtml_(customerPhone) + '\n') : '')
          + '<b>Total:</b> $' + money2_(preview.totalContract || 0).toFixed(2) + '\n'
          + '<b>Paid:</b> $' + money2_(preview.totalPaid || 0).toFixed(2) + '\n'
          + '<b>Follow-up tasks queued:</b> ' + String(tasksQueued);
        if (summary) {
          teleMsg += '\n\n<b>Summary:</b>\n' + escapeTelegramHtml_(summary);
        }
        if (withReview) {
          teleMsg += '\n\n⭐ <b>Review requested:</b> ' + escapeTelegramHtml_(reviewPrompt);
        }
        if (closeoutDraftText) {
          teleMsg += '\n\n<b>Suggested customer text:</b>\n<pre>' + escapeTelegramHtml_(closeoutDraftText) + '</pre>';
        }
        var teleButtons = [];
        if (closeoutDraftUrl) {
          teleButtons.push({ text: '💬 Open Draft Text', url: closeoutDraftUrl });
        }
        var reviewLinks = getCloseoutReviewLinks_();
        var googleReviewLink = String(reviewLinks.google || '').trim();
        var facebookReviewLink = String(reviewLinks.facebook || '').trim();
        if (withReview && googleReviewLink) {
          teleButtons.push({ text: '⭐ Google Review', url: googleReviewLink });
        }
        if (withReview && facebookReviewLink) {
          teleButtons.push({ text: '👍 Facebook Review', url: facebookReviewLink });
        }
        var teleRes = sendTelegramBotMessage_(teleMsg, teleButtons);
        telegramSent = !!(teleRes && teleRes.success);
        if (!telegramSent) telegramError = (teleRes && teleRes.error) ? String(teleRes.error) : 'Unknown Telegram error';
      } catch (teleErr) {
        telegramError = teleErr.toString();
        Logger.log('Closeout telegram failed: ' + telegramError);
      }
    }

    return {
      success: true,
      tasksQueued: tasksQueued,
      emailSent: emailSent,
      telegramSent: telegramSent,
      telegramError: telegramError,
      projectId: projectId
    };
  } catch (e) {
    return { success: false, error: e.toString() };
  }
}

/**
 * Build printable lien paperwork draft for non-paying customers.
 * Returns HTML + plain text body for copy/paste into formal state-specific forms.
 */
function generateLienPaperwork(projectId, notes, dueDate) {
  try {
    if (!projectId) return { success: false, error: 'Project ID required' };

    var proj = getProjectDetails(projectId);
    if (!proj || !proj.success) {
      return { success: false, error: (proj && proj.error) ? proj.error : 'Project not found' };
    }

    var projectData = proj.project || {};
    var linkedId = projectData.estimateId || projectData.invoiceId || projectData.linkedEstimateId || '';
    var breakdown = getProjectBalanceBreakdown(projectId, linkedId);
    if (!breakdown || !breakdown.success) {
      return { success: false, error: (breakdown && breakdown.error) ? breakdown.error : 'Could not calculate balance for lien paperwork' };
    }

    var totalOwed = money2_(breakdown.totalOwed || 0);
    if (totalOwed <= 0.01) {
      return { success: false, error: 'Project does not have an outstanding balance' };
    }

    var customerName = String(breakdown.customerName || projectData.customerName || '').trim();
    var customerEmail = String(breakdown.customerEmail || projectData.customerEmail || '').trim();
    var customerAddress = String(projectData.customerAddress || '').trim();
    var today = new Date();
    var due = dueDate ? new Date(dueDate) : new Date(today.getTime() + (15 * 24 * 60 * 60 * 1000));
    if (!(due instanceof Date) || isNaN(due.getTime())) {
      due = new Date(today.getTime() + (15 * 24 * 60 * 60 * 1000));
    }

    var subject = 'Lien Paperwork Draft — ' + String(projectId);
    var noteText = String(notes || '').trim();
    var dueFmt = Utilities.formatDate(due, Session.getScriptTimeZone(), 'MMMM d, yyyy');
    var todayFmt = Utilities.formatDate(today, Session.getScriptTimeZone(), 'MMMM d, yyyy');

    var milestones = Array.isArray(breakdown.rows) ? breakdown.rows.filter(function(r) {
      return money2_(r.owed || 0) > 0.009;
    }) : [];
    var owedRowsHtml = milestones.map(function(r) {
      return '<tr>'
        + '<td style="padding:8px;border-bottom:1px solid #e5e7eb;">' + escapeHtml(String(r.name || 'Milestone')) + '</td>'
        + '<td style="padding:8px;border-bottom:1px solid #e5e7eb;text-align:right;">$' + money2_(r.amount || 0).toFixed(2) + '</td>'
        + '<td style="padding:8px;border-bottom:1px solid #e5e7eb;text-align:right;color:#92400e;font-weight:700;">$' + money2_(r.owed || 0).toFixed(2) + '</td>'
        + '</tr>';
    }).join('');

    var htmlBody = ''
      + '<div style="font-family:Arial,sans-serif;max-width:800px;margin:0 auto;color:#111827;line-height:1.5;">'
      +   '<h2 style="margin:0 0 10px 0;">Notice of Intent to File Lien (Draft)</h2>'
      +   '<p style="margin:0 0 16px 0;color:#6b7280;">Generated ' + escapeHtml(todayFmt) + ' for project ' + escapeHtml(String(projectId)) + '</p>'
      +   '<div style="border:1px solid #d1d5db;border-radius:8px;padding:14px 16px;background:#f9fafb;margin-bottom:16px;">'
      +     '<p style="margin:0 0 6px 0;"><strong>Customer:</strong> ' + escapeHtml(customerName || 'N/A') + '</p>'
      +     '<p style="margin:0 0 6px 0;"><strong>Property Address:</strong> ' + escapeHtml(customerAddress || 'N/A') + '</p>'
      +     '<p style="margin:0;"><strong>Email:</strong> ' + escapeHtml(customerEmail || 'N/A') + '</p>'
      +   '</div>'
      +   '<p style="margin:0 0 10px 0;">This is a draft pre-lien notice for internal/legal review. The account currently has an outstanding balance of <strong>$' + totalOwed.toFixed(2) + '</strong>.</p>'
      +   '<p style="margin:0 0 16px 0;">Payment is requested no later than <strong>' + escapeHtml(dueFmt) + '</strong>.</p>'
      +   '<table style="width:100%;border-collapse:collapse;border:1px solid #e5e7eb;margin-bottom:16px;">'
      +     '<thead><tr style="background:#f3f4f6;"><th style="padding:8px;text-align:left;">Item</th><th style="padding:8px;text-align:right;">Amount</th><th style="padding:8px;text-align:right;">Outstanding</th></tr></thead>'
      +     '<tbody>' + owedRowsHtml + '</tbody>'
      +   '</table>'
      +   '<p style="margin:0 0 8px 0;"><strong>Project Total:</strong> $' + money2_(breakdown.totalContract || 0).toFixed(2) + '</p>'
      +   '<p style="margin:0 0 8px 0;"><strong>Total Paid:</strong> $' + money2_(breakdown.totalPaid || 0).toFixed(2) + '</p>'
      +   '<p style="margin:0 0 16px 0;"><strong>Balance Due:</strong> $' + totalOwed.toFixed(2) + '</p>'
      +   (noteText ? ('<div style="border-left:4px solid #f59e0b;padding:8px 12px;background:#fffbeb;"><strong>Internal Notes:</strong><br>' + escapeHtml(noteText) + '</div>') : '')
      +   '<p style="margin-top:18px;color:#6b7280;font-size:12px;">This template is not legal advice. Review jurisdiction-specific lien requirements before serving or filing.</p>'
      + '</div>';

    var textBody = ''
      + 'NOTICE OF INTENT TO FILE LIEN (DRAFT)\n'
      + 'Project: ' + String(projectId) + '\n'
      + 'Generated: ' + todayFmt + '\n\n'
      + 'Customer: ' + (customerName || 'N/A') + '\n'
      + 'Property Address: ' + (customerAddress || 'N/A') + '\n'
      + 'Email: ' + (customerEmail || 'N/A') + '\n\n'
      + 'Amount Outstanding: $' + totalOwed.toFixed(2) + '\n'
      + 'Payment Requested By: ' + dueFmt + '\n\n'
      + 'Project Total: $' + money2_(breakdown.totalContract || 0).toFixed(2) + '\n'
      + 'Total Paid: $' + money2_(breakdown.totalPaid || 0).toFixed(2) + '\n'
      + 'Balance Due: $' + totalOwed.toFixed(2) + '\n'
      + (noteText ? ('\nInternal Notes:\n' + noteText + '\n') : '')
      + '\nDISCLAIMER: This template is not legal advice. Review jurisdiction-specific lien requirements before serving or filing.';

    return {
      success: true,
      subject: subject,
      htmlBody: htmlBody,
      textBody: textBody,
      projectId: String(projectId),
      customerName: customerName,
      customerEmail: customerEmail,
      customerAddress: customerAddress,
      dueDate: due.toISOString(),
      totalContract: money2_(breakdown.totalContract || 0),
      totalPaid: money2_(breakdown.totalPaid || 0),
      balanceDue: totalOwed
    };
  } catch (e) {
    Logger.log('generateLienPaperwork: ' + e.toString());
    return { success: false, error: e.toString() };
  }
}

/**
 * Persist lien workflow state on a project record for Projects tab tracking.
 */
function setProjectLienStatus(projectId, inProgress, notes, dueDate) {
  try {
    var pid = String(projectId || '').trim();
    if (!pid) return { success: false, error: 'Project ID required' };

    if (typeof getProject !== 'function' || typeof updateProject !== 'function') {
      return { success: false, error: 'Project helpers unavailable (getProject/updateProject)' };
    }

    var existing = getProject(pid);
    if (!existing || !existing.success || !existing.project) {
      return { success: false, error: (existing && existing.error) ? existing.error : 'Project not found' };
    }

    var projectData = existing.project || {};
    var nowIso = new Date().toISOString();
    var noteText = String(notes || '').trim();
    var dueText = String(dueDate || '').trim();

    projectData.lienInProgress = inProgress === true;
    projectData.lienStatus = projectData.lienInProgress ? 'In Progress' : 'Resolved';
    projectData.lienUpdatedAt = nowIso;

    if (projectData.lienInProgress) {
      if (!projectData.lienStartedAt) projectData.lienStartedAt = nowIso;
      if (noteText) projectData.lienNotes = noteText;
      if (dueText) projectData.lienDueDate = dueText;
      projectData.lienResolvedAt = '';
    } else {
      projectData.lienResolvedAt = nowIso;
    }

    var save = updateProject(pid, projectData);
    if (!save || !save.success) {
      return { success: false, error: (save && save.error) ? save.error : 'Failed to update project lien status' };
    }

    return {
      success: true,
      projectId: pid,
      lienInProgress: projectData.lienInProgress === true,
      lienStatus: String(projectData.lienStatus || ''),
      lienNotes: String(projectData.lienNotes || ''),
      lienDueDate: String(projectData.lienDueDate || ''),
      lienStartedAt: String(projectData.lienStartedAt || ''),
      lienUpdatedAt: String(projectData.lienUpdatedAt || ''),
      lienResolvedAt: String(projectData.lienResolvedAt || '')
    };
  } catch (e) {
    Logger.log('setProjectLienStatus: ' + e.toString());
    return { success: false, error: e.toString() };
  }
}

// ========================================
// PAYMENT RECORDING & CONFIRMATION
// ========================================

/**
 * Record a one-off payment for an invoice and update its payment status
 * Searches by customer name (or invoiceId if provided)
 * If no invoice found, records with Invoice ID = "N/A"
 * Automatically sets Job Status to "Completed" if full balance is paid
 * Called from UI to record payments (Stripe or manual)
 */
function recordInvoiceEstimatePayment_(customerNameOrId, amount, paymentMethod, paymentDate, notes, jobStatus, suppressEmail) {
  try {
    const spreadsheet = SpreadsheetApp.openById(SPREADSHEET_ID);
    const sheet = spreadsheet.getSheetByName(INVOICES_ESTIMATES_SHEET);
    
    if (!sheet) {
      return { success: false, error: 'Invoices sheet not found' };
    }
    
    enforce8ColumnStructure(sheet);
    const lastRow = sheet.getLastRow();
    const sheetCols = sheet.getLastColumn();
    const is8Column = (sheetCols >= 8);
    const idCol = is8Column ? 2 : 1;
    const emailCol = is8Column ? 3 : 2;
    const json1Col = is8Column ? 4 : 3;
    const json2Col = is8Column ? 5 : 4;
    const json3Col = is8Column ? 6 : 5;
    const companyIdCol = is8Column ? 1 : 0;
    
    const parsedAmount = parseFloat(amount) || 0;
    const transactionId = 'PAY-' + Date.now() + '-' + Math.random().toString(36).substring(7);

    // Normalize lookup input (could be invoice ID, email, name, or phone)
    const rawLookup = String(customerNameOrId || '').trim();
    const lookupValue = rawLookup.toLowerCase();
    const lookupDigits = rawLookup.replace(/\D/g, ''); // digits-only for phone matching
    
    let foundMatch = false;
    let matchedRow = -1;
    let foundInvoiceId = 'N/A';
    let foundCompanyId = 'CMP-AQUALITYPOOL';
    
    // Search for invoice by customer name or ID
    for (let i = 1; i < lastRow; i++) {
      const rowId = String(sheet.getRange(i + 1, idCol).getValue() || '').trim();
      const rowEmail = String(sheet.getRange(i + 1, emailCol).getValue() || '').trim();
      
      // Try reading JSON to get customer name
      const jsonPart1 = sheet.getRange(i + 1, json1Col).getValue() || '';
      const jsonPart2 = sheet.getRange(i + 1, json2Col).getValue() || '';
      const jsonPart3 = sheet.getRange(i + 1, json3Col).getValue() || '';
      let jsonStr = concatenateJsonChunks(jsonPart1, jsonPart2, jsonPart3);
      
      if (!jsonStr || jsonStr.length === 0) {
        jsonStr = String(jsonPart1 || '').trim();
      }
      
      let customerName = '';
      let customerPhone = '';
      if (jsonStr && jsonStr.startsWith('{')) {
        try {
          const jsonData = JSON.parse(jsonStr);
          customerName = String(jsonData.customerName || '').toLowerCase();
          customerPhone = String(jsonData.customerPhone || '').trim();
        } catch (e) {
          // Skip if JSON parse fails
        }
      }
      // Normalize phone from JSON for comparison
      const rowPhoneDigits = (customerPhone || '').replace(/\D/g, '');

      // Check if this row matches: ID match OR customer name match OR email match OR phone match
      let nameMatch = false;
      if (customerName && lookupValue && lookupValue.length > 2) {
        // allow substring name matches
        nameMatch = customerName.indexOf(lookupValue) !== -1 || lookupValue.indexOf(customerName) !== -1;
      } else if (customerName && lookupValue) {
        nameMatch = customerName === lookupValue;
      }

      const emailMatch = rowEmail && rowEmail.toLowerCase() === lookupValue;
      const phoneMatch = lookupDigits && rowPhoneDigits && lookupDigits === rowPhoneDigits;

      if (rowId === String(customerNameOrId).trim() || nameMatch || emailMatch || phoneMatch) {
        foundMatch = true;
        matchedRow = i;
        foundInvoiceId = rowId;
        foundCompanyId = is8Column ? (sheet.getRange(i + 1, companyIdCol).getValue() || 'CMP-AQUALITYPOOL') : 'CMP-AQUALITYPOOL';
        break;
      }
    }
    
    // If no match found, still record payment with "N/A" invoice ID
    if (!foundMatch) {
      Logger.log('⚠️ No invoice found for: ' + customerNameOrId + '. Recording payment with Invoice ID = "N/A"');
      var payDateUnmatched = paymentDate ? (paymentDate instanceof Date ? paymentDate : new Date(paymentDate)) : new Date();
      var notesUnmatched = (notes || '').trim();
      if (jobStatus && String(jobStatus).trim() && jobStatus !== 'Not Started') {
        notesUnmatched = (notesUnmatched ? notesUnmatched + '\n' : '') + '[jobStatus:' + jobStatus + ']';
      }
      recordPaymentHistory(
        'N/A',
        parsedAmount,
        transactionId || ('MANUAL-' + new Date().getTime()),
        paymentMethod || 'Manual',
        foundCompanyId,
        payDateUnmatched,
        '',
        'Payment recorded (no matching invoice)',
        0,
        notesUnmatched
      );
      
      return {
        success: true,
        message: 'Payment recorded (no matching invoice found)',
        invoiceId: 'N/A',
        paymentAmount: parsedAmount,
        transactionId: transactionId,
        totalPaid: parsedAmount,
        invoiceTotal: 0,
        paymentStatus: 'Recorded',
        jobStatus: jobStatus || 'Not Started',
        remaining: 0,
        customerEmail: '',
        emailSent: false,
        warning: 'No invoice found - payment recorded with Invoice ID = "N/A"'
      };
    }
    
    // Invoice was found - process the payment
    const jsonPart1 = sheet.getRange(matchedRow + 1, json1Col).getValue() || '';
    const jsonPart2 = sheet.getRange(matchedRow + 1, json2Col).getValue() || '';
    const jsonPart3 = sheet.getRange(matchedRow + 1, json3Col).getValue() || '';
    let jsonStr = concatenateJsonChunks(jsonPart1, jsonPart2, jsonPart3);
    
    if (!jsonStr || jsonStr.length === 0) {
      jsonStr = String(jsonPart1 || '').trim();
    }
    
    if (jsonStr && jsonStr.startsWith('{')) {
      const jsonData = JSON.parse(jsonStr);
      const invoiceTotal = parseFloat(jsonData.total) || 0;
      
      // Initialize partial payments array if it doesn't exist
      if (!jsonData.partialPayments) {
        jsonData.partialPayments = [];
      }
      
      // Add the payment with transaction ID
      jsonData.partialPayments.push({
        amount: parsedAmount,
        paidDate: paymentDate || new Date().toISOString(),
        transactionId: transactionId,
        paymentMethod: paymentMethod || 'Manual',
        status: 'Completed',
        notes: notes || ''
      });
      
      // Calculate total paid amount
      const totalPaid = jsonData.partialPayments
        .filter(p => p.status === 'Completed')
        .reduce((sum, p) => sum + (parseFloat(p.amount) || 0), 0);
      
      // Update payment status
      const isFullyPaid = totalPaid >= invoiceTotal - 0.01;
      
      if (isFullyPaid) {
        // Fully paid (allow small rounding differences)
        jsonData.paymentStatus = 'Paid';
        jsonData.paidDate = new Date().toISOString();
        
        // AUTO-SET JOB STATUS TO COMPLETED IF FULL PAYMENT RECEIVED
        jsonData.jobStatus = 'Completed';
        Logger.log('✅ Full payment received - Job Status auto-set to: Completed');
      } else if (totalPaid > 0) {
        // Partially paid
        jsonData.paymentStatus = 'Partial';
        jsonData.totalPaid = totalPaid;
        jsonData.remainingBalance = invoiceTotal - totalPaid;
        
        // Update job status only if provided
        if (jobStatus && jobStatus !== 'Completed') {
          jsonData.jobStatus = jobStatus;
          Logger.log('📋 Job Status updated: ' + jobStatus);
        }
      } else {
        jsonData.paymentStatus = 'Pending';
        
        // Update job status only if provided
        if (jobStatus) {
          jsonData.jobStatus = jobStatus;
          Logger.log('📋 Job Status updated: ' + jobStatus);
        }
      }
      
      // Write updated JSON back to sheet
      const updatedJsonStr = JSON.stringify(jsonData);
      const updatedChunks = splitJsonString(updatedJsonStr);
      sheet.getRange(matchedRow + 1, json1Col, 1, 3).setValues([[updatedChunks[0] || '', updatedChunks[1] || '', updatedChunks[2] || '']]);
      SpreadsheetApp.flush();
      
      // Record in payment history sheet (paymentDate must be a Date — never pass job status here)
      const finalJobStatus = isFullyPaid ? 'Completed' : (jobStatus || 'Not Started');
      var payDateMatched = paymentDate ? (paymentDate instanceof Date ? paymentDate : new Date(paymentDate)) : new Date();
      var descMatched = 'Payment for Invoice ' + foundInvoiceId + (jsonData.customerName ? ' — ' + jsonData.customerName : '');
      var notesMatched = (notes || '').trim();
      if (finalJobStatus && finalJobStatus !== 'Completed') {
        notesMatched = (notesMatched ? notesMatched + '\n' : '') + '[jobStatus:' + finalJobStatus + ']';
      }
      recordPaymentHistory(
        foundInvoiceId,
        parsedAmount,
        transactionId,
        paymentMethod || 'Manual',
        foundCompanyId,
        payDateMatched,
        jsonData.customerEmail || '',
        descMatched,
        0,
        notesMatched
      );
      if (foundInvoiceId && foundInvoiceId !== 'N/A') {
        syncAppointmentsLinkedInvoiceForInvoice_(foundInvoiceId);
      }
      
      // Send confirmation email to customer (can be suppressed for bulk imports)
      const customerEmail = jsonData.customerEmail || '';
      const customerName = jsonData.customerName || '';
      let emailSent = false;
      if (customerEmail && !suppressEmail) {
        sendPaymentConfirmationEmailWithReviews(customerEmail, customerName, foundInvoiceId, parsedAmount, totalPaid, invoiceTotal);
        Logger.log('✅ Confirmation email sent to: ' + customerEmail);
        emailSent = true;
      } else if (customerEmail && suppressEmail) {
        Logger.log('🔕 Confirmation email suppressed for: ' + customerEmail);
      }
      
      Logger.log('✅ Payment recorded: $' + parsedAmount.toFixed(2) + ' for invoice ' + foundInvoiceId + '. Total paid: $' + totalPaid.toFixed(2) + '. Job Status: ' + finalJobStatus);
      
      return {
        success: true,
        message: isFullyPaid ? 'Payment recorded - INVOICE FULLY PAID & JOB MARKED COMPLETE' : 'Payment recorded',
        invoiceId: foundInvoiceId,
        paymentAmount: parsedAmount,
        transactionId: transactionId,
        totalPaid: totalPaid,
        invoiceTotal: invoiceTotal,
        paymentStatus: jsonData.paymentStatus,
        jobStatus: isFullyPaid ? 'Completed' : (jobStatus || 'Not Started'),
        remaining: Math.max(0, invoiceTotal - totalPaid),
        customerEmail: customerEmail,
        emailSent: emailSent,
        isFullyPaid: isFullyPaid
      };
    } else {
      return { success: false, error: 'Could not parse invoice data' };
    }
  } catch (error) {
    Logger.log('Error in recordInvoiceEstimatePayment_: ' + error.toString());
    return { success: false, error: error.toString() };
  }
}

