/**
 * Setup Payment Schedules sheet
 */
function setupPaymentSchedulesSheet() {
  try {
    const spreadsheet = SpreadsheetApp.openById(SPREADSHEET_ID);
    let sheet = spreadsheet.getSheetByName(PAYMENT_SCHEDULES_SHEET);
    
    if (!sheet) {
      sheet = spreadsheet.insertSheet(PAYMENT_SCHEDULES_SHEET);
      const headers = [
        'Payment Schedule ID',
        'Invoice ID',
        'Project ID',
        'Total Contract Amount',
        'Payment Milestones JSON',
        'Final Payment Percent',
        'Final Payment Amount',
        'Status',
        'Created Date',
        'Finalized Date'
      ];
      sheet.getRange(1, 1, 1, headers.length).setValues([headers]);
      sheet.getRange(1, 1, 1, headers.length).setFontWeight('bold');
      sheet.getRange(1, 1, 1, headers.length).setBackground('#0369a1');
      sheet.getRange(1, 1, 1, headers.length).setFontColor('#ffffff');
    }
    
    return { success: true };
  } catch (error) {
    Logger.log('Error setting up Payment Schedules sheet: ' + error.toString());
    return { success: false, error: error.toString() };
  }
}

/**
 * Validate payment schedule (flexible final payment)
 */
function validatePaymentSchedule(milestones, totalAmount) {
  try {
    if (!milestones || milestones.length === 0) {
      return { valid: false, error: 'Payment schedule must have at least one milestone' };
    }
    
    // Sum all percentages
    const totalPercent = milestones.reduce((sum, m) => sum + (parseFloat(m.percent) || 0), 0);
    
    // Check if exactly 100% (allow small rounding errors)
    if (Math.abs(totalPercent - 100) > 0.1) {
      return { valid: false, error: 'Payment schedule must total 100% (currently ' + totalPercent.toFixed(2) + '%)' };
    }
    
    // Validate amounts match percentages
    for (const milestone of milestones) {
      const expectedAmount = (totalAmount * parseFloat(milestone.percent)) / 100;
      const actualAmount = parseFloat(milestone.amount);
      if (Math.abs(actualAmount - expectedAmount) > 1) { // Allow $1 rounding error
        return { 
          valid: false, 
          error: `Amount for "${milestone.name}" does not match percentage. Expected $${expectedAmount.toFixed(2)}, got $${actualAmount.toFixed(2)}` 
        };
      }
    }
    
    return { valid: true };
  } catch (error) {
    return { valid: false, error: error.toString() };
  }
}

/**
 * Create payment schedule
 */
function createPaymentSchedule(invoiceId, milestones, totalAmount) {
  try {
    setupPaymentSchedulesSheet();
    
    // Validate payment schedule
    const validation = validatePaymentSchedule(milestones, totalAmount);
    if (!validation.valid) {
      return { success: false, error: validation.error };
    }
    
    const spreadsheet = SpreadsheetApp.openById(SPREADSHEET_ID);
    const sheet = spreadsheet.getSheetByName(PAYMENT_SCHEDULES_SHEET);
    
    // Generate Payment Schedule ID
    const year = new Date().getFullYear();
    const yearPrefix = 'PAY-' + year + '-';
    const dataRows = sheet.getDataRange().getValues();
    let maxNumber = 0;
    
    for (let i = 1; i < dataRows.length; i++) {
      const id = dataRows[i][0];
      if (id && typeof id === 'string' && id.startsWith(yearPrefix)) {
        const numPart = id.replace(yearPrefix, '');
        const num = parseInt(numPart);
        if (!isNaN(num) && num > maxNumber) {
          maxNumber = num;
        }
      }
    }
    
    const paymentScheduleId = yearPrefix + String(maxNumber + 1).padStart(3, '0');
    
    // Find final payment amount and percent
    const finalPayment = milestones.find(m => 
      m.name.toLowerCase().includes('final') || 
      m.milestoneId === 'MIL-FINAL'
    );
    const finalPaymentAmount = finalPayment ? parseFloat(finalPayment.amount) : 0;
    const finalPaymentPercent = finalPayment ? parseFloat(finalPayment.percent) : 0;
    
    const now = new Date();
    const rowData = [
      paymentScheduleId,
      invoiceId,
      '', // Project ID (will be filled when project created)
      totalAmount,
      JSON.stringify(milestones),
      finalPaymentPercent, // Final Payment Percent (flexible, whatever is needed)
      finalPaymentAmount,
      'Draft',
      now,
      '' // Finalized Date
    ];
    
    sheet.appendRow(rowData);
    
    return {
      success: true,
      paymentScheduleId: paymentScheduleId,
      message: 'Payment schedule created successfully'
    };
  } catch (error) {
    Logger.log('Error creating payment schedule: ' + error.toString());
    return { success: false, error: error.toString() };
  }
}

/**
 * Get payment schedule
 */
function getPaymentSchedule(paymentScheduleId) {
  try {
    const spreadsheet = SpreadsheetApp.openById(SPREADSHEET_ID);
    const sheet = spreadsheet.getSheetByName(PAYMENT_SCHEDULES_SHEET);
    
    if (!sheet) {
      return { success: false, error: 'Payment Schedules sheet not found' };
    }
    
    const dataRows = sheet.getDataRange().getValues();
    if (dataRows.length <= 1) {
      return { success: false, error: 'Payment schedule not found' };
    }
    
    const headers = dataRows[0];
    const idCol = headers.indexOf('Payment Schedule ID');
    
    for (let i = 1; i < dataRows.length; i++) {
      const row = dataRows[i];
      if (row[idCol] === paymentScheduleId) {
        const milestones = JSON.parse(row[headers.indexOf('Payment Milestones JSON')] || '[]');
        return {
          success: true,
          paymentSchedule: {
            paymentScheduleId: row[idCol],
            invoiceId: row[headers.indexOf('Invoice ID')],
            projectId: row[headers.indexOf('Project ID')],
            totalContractAmount: row[headers.indexOf('Total Contract Amount')],
            milestones: milestones,
            finalPaymentPercent: row[headers.indexOf('Final Payment Percent')],
            finalPaymentAmount: row[headers.indexOf('Final Payment Amount')],
            status: row[headers.indexOf('Status')],
            createdDate: row[headers.indexOf('Created Date')],
            finalizedDate: row[headers.indexOf('Finalized Date')]
          }
        };
      }
    }
    
    return { success: false, error: 'Payment schedule not found' };
  } catch (error) {
    Logger.log('Error getting payment schedule: ' + error.toString());
    return { success: false, error: error.toString() };
  }
}

