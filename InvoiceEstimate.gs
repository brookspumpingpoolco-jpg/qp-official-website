    }
    
    const signatureLineHtml = type === 'ESTIMATE' ? `
      <div style="margin-top: 36px; padding-top: 24px; border-top: 2px solid #e5e7eb;">
        <h3 style="font-size: 16px; font-weight: 700; color: #111827; margin-bottom: 12px;">Customer Acceptance</h3>
        <p style="font-size: 13px; color: #6b7280; margin-bottom: 20px;">
          By signing below, customer acknowledges acceptance of this estimate and terms.
        </p>
        <table style="width: 100%; border-collapse: collapse;">
          <tr>
            <td style="width: 60%; padding-right: 20px; vertical-align: top;">
              <div style="border-top: 1px solid #111827; margin-top: 36px;"></div>
