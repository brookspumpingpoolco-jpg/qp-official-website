                <strong style="font-size: 14px; color: #0f172a; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;">${isEstimateDoc ? (data.quoteNumber || data.id) : (data.invoiceNumber || data.id)}</strong>
              </td>
              <td width="50%" style="padding: 10px 0; border-bottom: 1px solid #e2e8f0; vertical-align: top;">
