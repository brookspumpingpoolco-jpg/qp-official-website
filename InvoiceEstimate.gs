        const emailResult = sendEnhancedInvoiceEmail(
          emailData,
          userSettings,
          customMessage,
          attachments
        );
        
        if (!emailResult || !emailResult.success) {
          const errorMsg = emailResult ? emailResult.error : 'No result returned from sendEnhancedInvoiceEmail';
