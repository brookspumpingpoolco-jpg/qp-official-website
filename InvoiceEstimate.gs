 */
function sendBrooksLinkNotification(shareLink, documentId, documentType, customerName, customerPhone, approvalToken, draftText) {
  Logger.log('🚀🚀🚀 sendBrooksLinkNotification CALLED - shareLink=' + shareLink + ' documentId=' + documentId + ' documentType=' + documentType);
  try {
    var docType = documentType || 'Invoice';
    var custName = customerName || '';
    var custPhone = customerPhone || '';
    var emailSent = false;
    var telegramSent = false;
    var telegramError = '';
    
    // Use provided shareLink, or build one from documentId + approvalToken
    var viewLink = shareLink || '';
    if (!viewLink && documentId) {
      // Build using getCustomerViewerWebflowUrl which handles token parameter correctly
      viewLink = getCustomerViewerWebflowUrl(docType, documentId, approvalToken);
    }
    
    Logger.log('📧📱 Sending Brooks notification (email + Telegram) - docType=' + docType + ' custName=' + custName + ' id=' + documentId);
    
    // === SEND EMAIL ===
    var emailSubject = '📱 ' + docType + ' Ready: ' + (custName || 'Customer') + ' — ' + documentId;
    var emailHtml = '<html><body style="font-family:Arial,sans-serif;line-height:1.6;color:#333;">'
      + '<h2 style="color:#0369a1;">✅ ' + docType + ' Ready to Send</h2>'
