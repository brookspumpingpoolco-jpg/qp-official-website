    if (!sheet) return { success: false, error: 'Invoices sheet not found' };
    
    // Resolve columns by header name (supports legacy and new sheet layouts)
    const sheetCols = sheet.getLastColumn();
    const headers = sheet.getRange(1, 1, 1, sheetCols).getValues()[0] || [];
    const is8Column = (sheetCols >= 8);
    const idCol = headers.indexOf('ID') !== -1 ? (headers.indexOf('ID') + 1) : (is8Column ? 2 : 1);
    const json1Col = headers.indexOf('JSON Part 1') !== -1 ? (headers.indexOf('JSON Part 1') + 1) : (is8Column ? 4 : 3);
    const json2Col = headers.indexOf('JSON Part 2') !== -1 ? (headers.indexOf('JSON Part 2') + 1) : (is8Column ? 5 : 4);
    const json3Col = headers.indexOf('JSON Part 3') !== -1 ? (headers.indexOf('JSON Part 3') + 1) : (is8Column ? 6 : 5);
    
    // Find row by estimate ID and update JSON with signature fields
    const lastRow = sheet.getLastRow();
    for (let rowNum = 2; rowNum <= lastRow; rowNum++) {
      const rowId = String(sheet.getRange(rowNum, idCol).getValue() || '').trim();
      if (rowId === String(id).trim()) {
        try {
          const jsonPart1 = sheet.getRange(rowNum, json1Col).getValue() || '';
          const jsonPart2 = sheet.getRange(rowNum, json2Col).getValue() || '';
          const jsonPart3 = sheet.getRange(rowNum, json3Col).getValue() || '';
          let jsonStr = concatenateJsonChunks(jsonPart1, jsonPart2, jsonPart3);
          if (!jsonStr || jsonStr.length === 0) {
            jsonStr = String(jsonPart1 || '').trim();
          }
          
          if (jsonStr && jsonStr.startsWith('{')) {
            const jsonData = JSON.parse(jsonStr);
            jsonData.approvalStatus = 'Approved';
            jsonData.status = 'Approved';
            jsonData.customerSigned = true;
            jsonData.adminSigned = true;
            jsonData.approvalDate = jsonData.approvalDate || new Date().toISOString();
            jsonData.adminSignedDate = new Date().toISOString();
            jsonData.signatureUrl = signatureUrl;
            jsonData.signatureData = signatureDataUrl || jsonData.signatureData || '';
            jsonData.printedName = customerName || jsonData.printedName || invoice.customerName || '';
            jsonData.adminSignatureData = adminSignatureData || jsonData.adminSignatureData || jsonData.adminSignature || '';
            jsonData.adminSignature = adminSignatureData || jsonData.adminSignature || jsonData.adminSignatureData || '';
            jsonData.adminPrintedName = adminPrintedName || jsonData.adminPrintedName || '';
            jsonData.contractFullyExecuted = true;
            jsonData.adminSignedNotificationSent = true;
            jsonData.contractExecutionStatus = 'Completed';
            jsonData.contractExecutionCompletedAt = new Date().toISOString();
            if (invoice.items) jsonData.items = invoice.items;
            if (invoice.optionalAddOns != null) jsonData.optionalAddOns = invoice.optionalAddOns;
            if (invoice.selectedAddOnIds != null) jsonData.selectedAddOnIds = invoice.selectedAddOnIds;
            if (invoice.subtotal != null) jsonData.subtotal = invoice.subtotal;
            if (invoice.taxAmount != null) jsonData.taxAmount = invoice.taxAmount;
            if (invoice.tax != null) jsonData.tax = invoice.tax;
            if (invoice.total != null) jsonData.total = invoice.total;
            if (contractPdfUrl) jsonData.contractPdfUrl = contractPdfUrl;
            
            // Write back JSON chunks
            const updatedJsonStr = JSON.stringify(jsonData);
            const updatedChunks = splitJsonString(updatedJsonStr);
            sheet.getRange(rowNum, json1Col, 1, 3).setValues([[updatedChunks[0] || '', updatedChunks[1] || '', updatedChunks[2] || '']]);
            SpreadsheetApp.flush();
          }
        } catch (e) {
          Logger.log('Error updating signature URLs in JSON: ' + e.toString());
        }
        break;
      }
    }
    
    return { 
      success: true, 
      message: 'Estimate approved and fully signed automatically',
      signatureUrl: signatureUrl,
      contractPdfUrl: contractPdfUrl
    };
  } catch (error) {
    Logger.log('Error approving estimate with signature: ' + error.toString());
    return { success: false, error: error.toString() };
  }
}

/**
 * Generate contract PDF with signature
 */
function generateContractPDF(invoice, signatureDataUrl, customerName) {
  try {
    const htmlContent = generateContractHTML(invoice, signatureDataUrl, customerName);
    const blob = Utilities.newBlob(htmlContent, 'text/html', 'contract.html');
    const pdf = blob.getAs('application/pdf');
    
    // Save to customer folder
    const customerFolder = getOrCreateCustomerFolder(customerName || invoice.customerName, invoice.customerAddress);
    let pdfFile;
    
    if (customerFolder) {
      pdfFile = customerFolder.createFile(pdf);
      pdfFile.setName('Contract - ' + (invoice.quoteNumber || invoice.invoiceNumber || invoice.id) + '.pdf');
    } else {
      pdfFile = DriveApp.createFile(pdf);
      pdfFile.setName('Contract - ' + (invoice.quoteNumber || invoice.invoiceNumber || invoice.id) + '.pdf');
    }
    
    pdfFile.setSharing(DriveApp.Access.ANYONE_WITH_LINK, DriveApp.Permission.VIEW);
    return pdfFile.getUrl();
  } catch (error) {
    Logger.log('Error generating contract PDF: ' + error.toString());
    return '';
  }
}

/**
 * Extract pool dimensions from invoice items or notes
 */
function extractPoolDimensions(invoice) {
  try {
    const items = JSON.parse(invoice.items || '[]');
    const notes = (invoice.notes || '').toLowerCase();
    
    // Try to find pool size in items
    for (let item of items) {
      const name = (item.name || '').toLowerCase();
      const desc = (item.description || '').toLowerCase();
      
      // Look for patterns like "16x32", "16' x 32'", "16 × 32", etc.
      const poolSizePattern = /(\d+)\s*['']?\s*[x×]\s*(\d+)\s*['']?/i;
      const nameMatch = name.match(poolSizePattern);
      const descMatch = desc.match(poolSizePattern);
      
      if (nameMatch) {
        return `${nameMatch[1]}' × ${nameMatch[2]}'`;
      }
      if (descMatch) {
        return `${descMatch[1]}' × ${descMatch[2]}'`;
      }
    }
    
    // Try notes
    const notesMatch = notes.match(/(\d+)\s*['']?\s*[x×]\s*(\d+)\s*['']?/i);
    if (notesMatch) {
      return `${notesMatch[1]}' × ${notesMatch[2]}'`;
    }
    
    // Default if not found
    return '___\' × ___\'';
  } catch (e) {
    Logger.log('Error extracting pool dimensions: ' + e.toString());
    return '___\' × ___\'';
  }
}

