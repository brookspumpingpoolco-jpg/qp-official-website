/**
 * Process signed contract - main function called from signature capture
 */
function processSignedContract(invoiceData, signatureDataUrl, customerName) {
  try {
    // Generate signed contract PDF
    const contractPdfUrl = generateContractPDF(invoiceData, signatureDataUrl, customerName);
    
    if (!contractPdfUrl) {
      return { success: false, error: 'Failed to generate contract PDF' };
    }
    
    // Update invoice with signature information
    const spreadsheet = SpreadsheetApp.openById(SPREADSHEET_ID);
    const sheet = spreadsheet.getSheetByName(INVOICES_ESTIMATES_SHEET);
    const dataRows = sheet.getDataRange().getValues();
    const headers = dataRows[0];
    
    // Find or create signature columns
    let signedCol = headers.indexOf('Signed Date');
    let signedByCol = headers.indexOf('Signed By');
    let contractUrlCol = headers.indexOf('Contract URL');
    
    if (signedCol === -1) {
      const lastCol = sheet.getLastColumn();
      sheet.getRange(1, lastCol + 1).setValue('Signed Date');
      sheet.getRange(1, lastCol + 2).setValue('Signed By');
      sheet.getRange(1, lastCol + 3).setValue('Contract URL');
      signedCol = lastCol;
      signedByCol = lastCol + 1;
      contractUrlCol = lastCol + 2;
    }
    
    // Update the invoice row
    const idCol = headers.indexOf('ID');
    for (let i = 1; i < dataRows.length; i++) {
      if (dataRows[i][idCol] === invoiceData.id) {
        sheet.getRange(i + 1, signedCol + 1).setValue(new Date().toISOString());
        sheet.getRange(i + 1, signedByCol + 1).setValue(customerName);
        sheet.getRange(i + 1, contractUrlCol + 1).setValue(contractPdfUrl);
        break;
      }
    }
    
    // Send confirmation email
    const emailResult = sendContractEmail(
      invoiceData, 
      '', 
      contractPdfUrl, 
      invoiceData.customerEmail || 'brookspumpingpoolco@gmail.com'
    );
    
    return {
      success: true,
      contractPdfUrl: contractPdfUrl,
      message: 'Contract signed successfully and confirmation email sent'
    };
  } catch (error) {
    Logger.log('Error processing signed contract: ' + error.toString());
    return { success: false, error: error.toString() };
  }
}

