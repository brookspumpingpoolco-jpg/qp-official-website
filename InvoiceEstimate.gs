    .header { background: #dc2626; color: white; padding: 20px; border-radius: 8px 8px 0 0; text-align: center; }
    .header h1 { margin: 0; font-size: 24px; }
    .content { background: #f9fafb; padding: 20px; border-radius: 0 0 8px 8px; border: 1px solid #e5e7eb; }
    .item-removed { background: #fee2e2; border: 2px solid #dc2626; padding: 12px; border-radius: 6px; margin: 15px 0; }
    .item-removed strong { color: #b91c1c; }
    .section { margin: 20px 0; }
    .section h3 { color: #1f2937; margin-bottom: 12px; border-bottom: 2px solid #e5e7eb; padding-bottom: 8px; }
    .milestone { background: white; padding: 12px; margin: 8px 0; border-left: 4px solid #3b82f6; }
    .balance { background: white; padding: 15px; border-radius: 6px; margin: 15px 0; border: 2px solid #fbbf24; }
    .balance-total { font-size: 18px; font-weight: 700; color: #b91c1c; }
    .footer { text-align: center; color: #6b7280; font-size: 12px; margin-top: 20px; padding-top: 20px; border-top: 1px solid #e5e7eb; }
    .contact { background: #dbeafe; padding: 12px; border-radius: 6px; margin: 15px 0; font-size: 13px; }
  </style>
</head>
<body>
  <div class="container">
    <div class="header">
      <h1>Invoice Item Cancelled</h1>
      <p style="margin: 5px 0 0 0; font-size: 14px;">Project: ${escapeHtml(projectData.projectName || 'Unnamed Project')}</p>
    </div>
    <div class="content">
      <p>Hi ${escapeHtml(customerName)},</p>
      
      <p>We wanted to let you know that we've cancelled the following add-on item from your project invoice:</p>
      
      <div class="item-removed">
        <strong style="color: #b91c1c;">❌ Cancelled Item</strong><br>
        <strong>${escapeHtml(itemName)}</strong><br>
        <strong>Amount:</strong> $${parseFloat(itemAmount || 0).toFixed(2)}
      </div>

      <div class="balance">
        <h3 style="margin: 0 0 12px 0; border: none; padding: 0;">Updated Project Balance</h3>
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 15px;">
          <div>
            <div style="color: #6b7280; font-size: 12px;">Total Project Value</div>
            <div style="font-size: 16px; font-weight: 700; color: #1f2937;">$${totalProjectValue.toFixed(2)}</div>
          </div>
          <div>
            <div style="color: #6b7280; font-size: 12px;">Total Paid to Date</div>
            <div style="font-size: 16px; font-weight: 700; color: #059669;">$${totalPaid.toFixed(2)}</div>
          </div>
        </div>
        <div style="border-top: 1px solid #fbbf24; padding-top: 12px; margin-top: 12px;">
          <div style="color: #6b7280; font-size: 12px;">Remaining Balance</div>
          <div class="balance-total">$${remainingBalance.toFixed(2)}</div>
        </div>
      </div>

      ${remainingMilestones.length > 0 ? `
      <div class="section">
        <h3>Remaining Payment Milestones</h3>
        ${remainingMilestones.map(function(m) {
          return `<div class="milestone">
            <strong>${escapeHtml(m.name)}</strong><br>
            <span style="color: #6b7280; font-size: 13px;">Amount: <strong>$${m.amount.toFixed(2)}</strong></span>
            ${m.type === 'one-off' ? '<br><span style="background: #ede9fe; color: #6d28d9; padding: 2px 6px; border-radius: 4px; font-size: 11px;">One-off</span>' : ''}
          </div>`;
        }).join('')}
      </div>
      ` : '<p style="color: #059669;">✓ All payment milestones have been paid in full!</p>'}

      <div class="contact">
        <strong>Questions?</strong><br>
        Please reach out to us at:<br>
        ${companyName}<br>
        ${companyEmail}<br>
        ${companyPhone}
      </div>

      <p style="margin-top: 20px;">Thank you for your business!</p>
      <p style="margin: 5px 0;">Best regards,<br><strong>${companyName}</strong></p>
    </div>
    <div class="footer">
      <p>This is an automated notification. Please do not reply to this email.</p>
    </div>
  </div>
</body>
</html>
    `;

    const emailSubject = `Invoice Item Cancelled - ${itemName}`;

    GmailApp.sendEmail(customerEmail, emailSubject, '', {
      htmlBody: emailHTML,
      from: companyEmail,
      replyTo: companyEmail
    });

    Logger.log('✅ Cancellation email sent to ' + customerEmail + ' for item: ' + itemName);
    return {
      success: true,
      message: 'Cancellation email sent to ' + customerEmail
    };

  } catch (error) {
    Logger.log('❌ Error sending cancellation email: ' + error.toString());
    return { success: false, error: error.toString() };
  }
}