/**
 * Deny estimate (with comment)
 */
function denyEstimate(id, token, comment) {
  try {
    const spreadsheet = SpreadsheetApp.openById(SPREADSHEET_ID);
    const sheet = spreadsheet.getSheetByName(INVOICES_ESTIMATES_SHEET);
    
    if (!sheet) {
      return { success: false, error: 'Sheet not found' };
    }
    
    const dataRows = sheet.getDataRange().getValues();
    
    for (let i = 1; i < dataRows.length; i++) {
      if (dataRows[i][0] === id && dataRows[i][19] === token) {
        // Update approval status
        sheet.getRange(i + 1, 21).setValue('Denied'); // Approval Status
        sheet.getRange(i + 1, 22).setValue(new Date()); // Approved Date
        
        // Add comment (required for denial)
        const commentCol = findColumnIndex(sheet, 'Approval Comment') + 1;
        if (commentCol === 0) {
          // Add column
          const lastCol = sheet.getLastColumn();
          sheet.getRange(1, lastCol + 1).setValue('Approval Comment');
          sheet.getRange(i + 1, lastCol + 1).setValue(comment || 'No comment provided');
        } else {
          sheet.getRange(i + 1, commentCol).setValue(comment || 'No comment provided');
        }
        
        return { success: true, message: 'Estimate denied' };
      }
    }
    
    return { success: false, error: 'Invalid token or estimate not found' };
  } catch (error) {
    Logger.log('Error denying estimate: ' + error.toString());
    return { success: false, error: error.toString() };
  }
}

/**
 * Add item to Price Book
 */
function addItemToPriceBook(itemData) {
  try {
    const spreadsheet = SpreadsheetApp.openById(SPREADSHEET_ID);
    const sheet = spreadsheet.getSheetByName(PRICE_BOOK_SHEET);
    
    if (!sheet) {
      return { success: false, error: 'Price Book sheet not found' };
    }
    
    if (!itemData.name) {
      return { success: false, error: 'Item name is required' };
    }
    
    // Find next empty row (data starts at row 7)
    const lastRow = sheet.getLastRow();
    const nextRow = lastRow < 6 ? 7 : lastRow + 1;
    
    // Set values: Brand, Code, Name, Category, Unit, Price, Description, Image, Active
    sheet.getRange(nextRow, 1).setValue(itemData.brand || '');
    sheet.getRange(nextRow, 2).setValue(itemData.code || '');
    sheet.getRange(nextRow, 3).setValue(itemData.name);
    sheet.getRange(nextRow, 4).setValue(itemData.category || 'Other');
    sheet.getRange(nextRow, 5).setValue(itemData.unit || 'Each');
    sheet.getRange(nextRow, 6).setValue(parseFloat(itemData.price) || 0);
    sheet.getRange(nextRow, 7).setValue(itemData.description || '');
    sheet.getRange(nextRow, 8).setValue(itemData.imageUrl || '');
    sheet.getRange(nextRow, 9).setValue(itemData.active !== false);
    
    return {
      success: true,
      message: 'Item added to Price Book',
      rowIndex: nextRow
    };
  } catch (error) {
    Logger.log('Error adding item to Price Book: ' + error.toString());
    return {
      success: false,
      error: error.toString()
    };
  }
}

